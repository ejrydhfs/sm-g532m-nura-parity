+
+	ret = regmap_read(regmap, S2MU005_FG_REG_MONOUT, &val);
+	if (ret < 0) {
+		dev_err(priv->dev, "failed to read the temperature (%d)\n", ret);
+		goto unlock;
+	}
+
+	temperature = (s16)val;
+	*value = ((temperature * 100) >> 8) / 10;
+
+unlock:
+	mutex_unlock(&priv->monout_mutex);
+
+	return ret;
