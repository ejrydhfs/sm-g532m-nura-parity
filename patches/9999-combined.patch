+	if (!(event & PSY_EVENT_PROP_CHANGED))
+		return NOTIFY_OK;
+	if (strcmp(psy->desc->name, S2MU005_CHG_PSY_NAME))
+		return NOTIFY_OK;
+
+	s2mu005_fg_sync_charger(priv, false);
+
+	return NOTIFY_OK;
+}
