+static int zinitix_write_flash_page(struct bt541_ts_data *bt541,
+				    const u8 *data, u32 size, u32 *addr)
+{
+	unsigned int i;
+
+	for (i = 0; i < bt541->page_size / ZINITIX_FW_SECTOR_SIZE; i++) {
+		if (*addr + ZINITIX_FW_SECTOR_SIZE > size)
+			return -EINVAL;
+
+		if (zinitix_write_data(bt541->client, ZINITIX_WRITE_FLASH,
+				       data + *addr,
+				       ZINITIX_FW_SECTOR_SIZE)) {
+			dev_err(&bt541->client->dev,
+				"Failed to write firmware at 0x%x\n", *addr);
+			return -EIO;
+		}
+
+		*addr += ZINITIX_FW_SECTOR_SIZE;
+		udelay(100);
+	}
+
+	msleep(30);
+
+	return 0;
+}
