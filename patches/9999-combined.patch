+static int bmc150_accel_range_to_g(unsigned int range)
+{
+	switch (range) {
+	case BMC150_ACCEL_DEF_RANGE_2G:
+		return 2;
+	case BMC150_ACCEL_DEF_RANGE_4G:
+		return 4;
+	case BMC150_ACCEL_DEF_RANGE_8G:
+		return 8;
+	case BMC150_ACCEL_DEF_RANGE_16G:
+		return 16;
+	default:
+		return 0;
+	}
