-	bmc150_accel_set_mode(data, BMC150_ACCEL_SLEEP_MODE_SUSPEND, 0);
+	/*
+	 * Keep the sensor measuring while the any-motion interrupt is armed,
+	 * so that it can wake the system up. The Samsung driver does the same
+	 * for its "reactive alert": bma2x2_suspend() skips the suspend mode
+	 * transition when reactive_enable is set, and the alert is armed with
+	 * the chip in low-power mode (bma2x2_reactive_enable_store() enters
+	 * BMA2X2_MODE_LOWPOWER1, PMU_LPW mode bits 2). BMC150_ACCEL_SLEEP_MODE_LPM
+	 * programs the same PMU_LPW mode bits.
+	 */
+	if (atomic_read(&data->interrupts[BMC150_ACCEL_INT_ANY_MOTION].users))
+		bmc150_accel_set_mode(data, BMC150_ACCEL_SLEEP_MODE_LPM, 0);
+	else
+		bmc150_accel_set_mode(data, BMC150_ACCEL_SLEEP_MODE_SUSPEND, 0);
 	mutex_unlock(&data->mutex);
 
 	return 0;
