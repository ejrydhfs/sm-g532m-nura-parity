+/*
+ * Read flash contents.  The controller needs a longer setup time for
+ * flash reads than for normal register reads (the downstream
+ * read_firmware_data() sleeps 1 ms between the address and the data
+ * transfer, bt541_ts.c).
+ */
+static int zinitix_read_flash(struct bt541_ts_data *bt541, void *values,
+			      size_t length)
+{
+	__le16 reg_le = cpu_to_le16(ZINITIX_READ_FLASH);
+	int ret;
+
+	ret = i2c_master_send(bt541->client, (u8 *)&reg_le, sizeof(reg_le));
+	if (ret != sizeof(reg_le))
+		return ret < 0 ? ret : -EIO;
+
+	usleep_range(1000, 1100);
+
+	ret = i2c_master_recv(bt541->client, values, length);
+	if (ret != length)
+		return ret < 0 ? ret : -EIO;
+
+	return 0;
+}
