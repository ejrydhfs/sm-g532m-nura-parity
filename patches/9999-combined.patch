+/*
+ * The BMA2x2 offset compensation registers (0x38..0x3a) contain a two's
+ * complement value which the chip subtracts from the raw acceleration data.
+ * Its resolution is fixed at 1/128 g per LSB [INFERENCE], while the raw data
+ * LSB size depends on the selected range and the chip resolution. Expose the
+ * offsets as calibbias expressed in raw sample units. The sign convention
+ * matches the Samsung BMA2x2 driver, which reports "value = acc - caldata"
+ * (bma2x2_work_func): a calibbias written here is subtracted from the raw
+ * samples.
+ */
+static int bmc150_accel_get_calibbias(struct bmc150_accel_data *data,
+				      struct iio_chan_spec const *chan,
+				      int *val)
+{
+	struct device *dev = regmap_get_device(data->regmap);
+	unsigned int reg_val;
+	int g, ret;
+
+	g = bmc150_accel_range_to_g(data->range);
+	if (!g) {
+		dev_err(dev, "Invalid range %u\n", data->range);
+		return -EINVAL;
+	}
+
+	mutex_lock(&data->mutex);
+	ret = regmap_read(data->regmap,
+			  BMC150_ACCEL_REG_OFFSET_X + chan->scan_index,
+			  &reg_val);
+	mutex_unlock(&data->mutex);
+	if (ret < 0) {
+		dev_err(dev, "Error reading offset register\n");
+		return ret;
+	}
+
+	*val = DIV_ROUND_CLOSEST((int)(s8)reg_val *
+				 (1 << (chan->scan_type.realbits - 8)), g);
+
+	return IIO_VAL_INT;
+}
