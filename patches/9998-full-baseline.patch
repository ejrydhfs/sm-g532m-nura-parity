+{
+}
+
+static inline void aed_combo_exception_api(const int *log, int log_size,
+					   const int *phy, int phy_size,
+					   const char *detail, const int db_opt)
+{
+}
+#endif /* CONFIG_MTK_AEE_FEATURE */
+
+#endif /* __LINUX_AEE_H */
