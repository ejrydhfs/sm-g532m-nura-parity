+		.symmetric_sample_bits = 1,
+	},
+	{
+		.name = "mt-soc-voice-md2-dai",
+		.id = MT6735_AFE_DAI_VOICE_MD2,
+		.ops = &mt6735_voice_ops,
+		.playback = {
