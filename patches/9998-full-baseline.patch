+	/* c2k only ports */
+	{ .tx_ch = CCCI_C2K_PPP_DATA, .rx_ch = CCCI_C2K_PPP_DATA, .txq = 2,
+	  .rxq = 2, .txq_exp = 0xFF, .rxq_exp = 0xFF,
+	  .ops = &ccci_char_port_ops, .minor = 19, .name = "ccci3_data" },
+	{ .tx_ch = CCCI_C2K_AT, .rx_ch = CCCI_C2K_AT, .txq = 5, .rxq = 5,
+	  .txq_exp = 0xF4, .rxq_exp = 0xFF, .ops = &ccci_char_port_ops,
+	  .minor = 20, .name = "ccci3_at" },
+	{ .tx_ch = CCCI_C2K_AT2, .rx_ch = CCCI_C2K_AT2, .txq = 5, .rxq = 5,
+	  .txq_exp = 0xFF, .rxq_exp = 0xFF, .ops = &ccci_char_port_ops,
+	  .minor = 21, .name = "ccci3_at2" },
+	{ .tx_ch = CCCI_C2K_AT3, .rx_ch = CCCI_C2K_AT3, .txq = 5, .rxq = 5,
+	  .txq_exp = 0xFF, .rxq_exp = 0xFF, .ops = &ccci_char_port_ops,
+	  .minor = 22, .name = "ccci3_at3" },
+	{ .tx_ch = CCCI_C2K_LB_DL, .rx_ch = CCCI_C2K_LB_DL, .txq = 5, .rxq = 5,
+	  .txq_exp = 0xFF, .rxq_exp = 0xFF, .ops = &ccci_char_port_ops,
+	  .minor = 23, .name = "ccci3_lb_dl" },
+	/* system ports */
+	{ .tx_ch = CCCI_CONTROL_TX, .rx_ch = CCCI_CONTROL_RX, .txq = 0, .rxq = 0,
+	  .txq_exp = 0, .rxq_exp = 0, .ops = &ccci_kernel_port_ops,
+	  .minor = 0, .name = "ccci3_ctrl" },
+	{ .tx_ch = CCCI_STATUS_TX, .rx_ch = CCCI_STATUS_RX, .txq = 0, .rxq = 0,
+	  .txq_exp = 0, .rxq_exp = 0, .ops = &ccci_kernel_port_ops,
+	  .minor = 0, .name = "ccci3_poll" },
+};
+
+int ccci_md_port_cfg(struct ccci_md *md)
+{
+	const struct ccci_port *table;
+	unsigned int count, i;
+	struct ccci_port *ports;
+
+	switch (md->id) {
+	case CCCI_MD_SYS1:
+		table = ccci_md1_ports;
+		count = ARRAY_SIZE(ccci_md1_ports);
+		break;
+	case CCCI_MD_SYS3:
+		table = ccci_md3_ports;
+		count = ARRAY_SIZE(ccci_md3_ports);
+		break;
+	default:
+		ccci_md_err(md, "no port table for this modem\n");
+		return -ENODEV;
+	}
+
+	ports = kmemdup(table, sizeof(*ports) * count, GFP_KERNEL);
+	if (!ports)
+		return -ENOMEM;
+
+	md->ports = ports;
+	md->port_count = count;
+
+	for (i = 0; i < count; i++) {
+		struct ccci_port *port = &ports[i];
+
+		port->md = md;
+		port->rx_len_th = CCCI_PORT_RX_LEN_TH;
+		skb_queue_head_init(&port->rx_q);
+		spin_lock_init(&port->rx_lock);
+		init_waitqueue_head(&port->rx_wq);
+		atomic_set(&port->open_count, 0);
+		INIT_LIST_HEAD(&port->node);
+		INIT_LIST_HEAD(&port->rx_node);
+		list_add_tail(&port->node, &md->ports_list);
+		if (port->rx_ch < CCCI_MAX_CH_NUM)
+			list_add_tail(&port->rx_node, &md->rx_ch_ports[port->rx_ch]);
+
+		if (port->ops && port->ops->init) {
+			int ret = port->ops->init(port);
+
+			if (ret)
+				ccci_md_warn(md, "port %s init failed %d\n",
+					     port->name, ret);
+		}
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* module init                                                         */
+/* ------------------------------------------------------------------ */
+static int __init ccci_init(void)
+{
+	int ret;
+
+	ccci_class = class_create(CCCI_DEV_NAME);
+	if (IS_ERR(ccci_class))
+		return PTR_ERR(ccci_class);
+
+	ret = ccci_sysfs_init();
+	if (ret)
+		goto err_class;
+
+	ret = ccci_util_init();
+	if (ret) {
+		pr_err("ccci: util init failed %d\n", ret);
+		goto err_sysfs;
+	}
+
+	/*
+	 * Kernel RPC services (GPIO/ADC/EINT, DSP MPU, queue remap), the
+	 * counterpart of downstream ccci_subsys_kernel_init(); registered
+	 * before the platform drivers probe so a booting modem can query
+	 * them immediately.
+	 */
+	ret = ccci_rpc_init();
+	if (ret) {
+		pr_err("ccci: rpc init failed %d\n", ret);
+		goto err_util;
+	}
+
+	ret = ccci_platform_register();
+	if (ret)
+		goto err_rpc;
+
+	pr_info("ccci: core initialised (driver ver 0x%08x)\n", CCCI_DRIVER_VER);
+	return 0;
+
+err_rpc:
+	ccci_rpc_exit();
+err_util:
+	ccci_util_exit();
+err_sysfs:
+	ccci_sysfs_exit();
+err_class:
+	class_destroy(ccci_class);
+	return ret;
+}
+
+static void __exit ccci_exit(void)
+{
+	ccci_platform_unregister();
+	ccci_rpc_exit();
+	ccci_util_exit();
+	ccci_sysfs_exit();
+	class_destroy(ccci_class);
+}
+
+module_init(ccci_init);
+module_exit(ccci_exit);
+
+MODULE_AUTHOR("MediaTek Inc.");
+MODULE_DESCRIPTION("MediaTek CCCI modem core (MT6735/MT6737T port)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/ccci/ccci_exception.c b/drivers/misc/mediatek/ccci/ccci_exception.c
new file mode 100644
index 000000000..93e7b8581
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_exception.c
@@ -0,0 +1,977 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI exception dump engine: collect the modem exception record and the
+ * shared-memory debug windows, decode them and expose the result in the
+ * kernel log, in the util dump ring, in debugfs files per modem and in a
+ * kernel-retrievable buffer.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_kernel.c (ccci_aed, ccci_md_exception,
+ * ccci_ee_info_dump, md_ex_monitor_func, md_ex_monitor2_func,
+ * md_bootup_timeout_func) and ccci_bm.c (ccci_mem_dump).
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ *
+ * The ROM hands the collected buffers to the AEE client
+ * (aed_md_exception_api, ROM 0xc0628298).  That client does not exist in this
+ * kernel tree, so the dump is delivered to the destinations above instead of
+ * pretending to call AEE.  The ROM ABI used by such a client,
+ * aee_dump_ccci_debug_info(), is implemented in ccci_core.c and exported.
+ *
+ * Layout of the AP<->MD shared-memory exception window, which is the base of
+ * the modem smem region (downstream ccci_core.c:262-293, ccci_core.h:580-619,
+ * mt6735/ccci_config.h:70-83):
+ *
+ *   smem+0x0000  2048  CCCI debug record       (aee_dump_ccci_debug_info())
+ *   smem+0x0800  2048  MDSS debug window       (CCCI_AED_DUMP_EX_MEM)
+ *   smem+0x0BF0    16  CCIF SRAM header copy   (CCCI_AED_DUMP_CCIF_REG)
+ *
+ * The MDSS debug window and the exception record (CCCI_SMEM_OFFSET_EXREC) are
+ * the same 2 KiB because on this platform both constants are 2048:
+ * ccci_config.h:75 and :82.  The modem fills either the legacy EX_LOG_T that
+ * arrives in the MD_EX_REC_OK packet or, after the boot handshake, a record
+ * at CCCI_SMEM_OFFSET_EXREC (port_kernel.c:3125-3135); the build has no
+ * MD_UMOLY_EE_SUPPORT, so the EX_LOG_T layout applies.
+ */
+#include <linux/aee.h>
+#include <linux/ccci.h>
+#include <linux/byteorder/generic.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+/*
+ * Text snapshot builder.  The buffer is allocated with kvmalloc() in
+ * ccci_ex_build() and swapped into md->ex.dump under dump_lock, so a debugfs
+ * reader always sees a complete snapshot.
+ */
+struct ccci_ex_text {
+	char *buf;
+	size_t size;
+	size_t len;
+};
+
+static void ccci_ex_printf(struct ccci_ex_text *t, const char *fmt, ...)
+	__printf(2, 3);
+static void ccci_ex_printf(struct ccci_ex_text *t, const char *fmt, ...)
+{
+	va_list args;
+	int n;
+
+	if (t->len >= t->size)
+		return;
+
+	va_start(args, fmt);
+	n = vscnprintf(t->buf + t->len, t->size - t->len, fmt, args);
+	va_end(args);
+	t->len += n;
+}
+
+static void ccci_ex_hex(struct ccci_ex_text *t, const void *data, size_t len)
+{
+	const u8 *p = data;
+	size_t off;
+	int i;
+
+	for (off = 0; off < len; off += 16) {
+		size_t n = min_t(size_t, 16, len - off);
+
+		ccci_ex_printf(t, "  %08zx:", off);
+		for (i = 0; i < n; i++)
+			ccci_ex_printf(t, " %02x", p[off + i]);
+		ccci_ex_printf(t, "\n");
+	}
+}
+
+static const char *ccci_ex_reason_name(unsigned int reason)
+{
+	switch (reason) {
+	case CCCI_EX_DUMP_MD_EX:
+		return "MD_EX";
+	case CCCI_EX_DUMP_MD_EX_REC_OK:
+		return "MD_EX_REC_OK";
+	case CCCI_EX_DUMP_WDT:
+		return "watchdog/reset";
+	case CCCI_EX_DUMP_NO_RESPONSE:
+		return "no-response/boot-timeout";
+	default:
+		return "unknown";
+	}
+}
+
+const char *ccci_exception_stage_name(unsigned int stage)
+{
+	switch (stage) {
+	case CCCI_EX_NONE:
+		return "none";
+	case CCCI_EX_INIT:
+		return "EX_INIT";
+	case CCCI_EX_DHL_DL_RDY:
+		return "EX_DHL_DL_RDY";
+	case CCCI_EX_INIT_DONE:
+		return "EX_INIT_DONE";
+	case CCCI_EX_NO_RESPONSE:
+		return "MD_NO_RESPONSE";
+	case CCCI_EX_WDT:
+		return "MD_WDT";
+	default:
+		return "unknown";
+	}
+}
+
+static void ccci_ex_aed_flags(struct ccci_ex_text *t, unsigned int flags)
+{
+	ccci_ex_printf(t, "  AED selection: 0x%x%s%s%s%s\n", flags,
+		       flags & CCCI_AED_DUMP_EX_MEM ? " EX_MEM" : "",
+		       flags & CCCI_AED_DUMP_MD_IMG_MEM ? " MD_IMG_MEM" : "",
+		       flags & CCCI_AED_DUMP_CCIF_REG ? " CCIF_REG" : "",
+		       flags & CCCI_AED_DUMP_EX_PKT ? " EX_PKT" : "");
+}
+
+/*
+ * EX_HEADER_T.ex_type names, verbatim from the non-MD_UMOLY decoder of
+ * downstream port_kernel.c:3128-3250 (the names the ROM prints), plus the
+ * MD_EX_CC_* values of ccci_core.h:230-246.
+ */
+static const char *ccci_ex_type_name(unsigned int type)
+{
+	switch (type) {
+	case CCCI_EX_TYPE_INVALID:
+		return "INVALID";
+	case CCCI_EX_TYPE_UNDEF:
+		return "Fatal error (undefine)";
+	case CCCI_EX_TYPE_SWI:
+		return "Fatal error (swi)";
+	case CCCI_EX_TYPE_PREF_ABT:
+		return "Fatal error (prefetch abort)";
+	case CCCI_EX_TYPE_DATA_ABT:
+		return "Fatal error (data abort)";
+	case CCCI_EX_TYPE_ASSERT:
+		return "ASSERT";
+	case CCCI_EX_TYPE_FATALERR_TASK:
+		return "Fatal error (task)";
+	case CCCI_EX_TYPE_FATALERR_BUF:
+		return "Fatal error (buff)";
+	case CCCI_EX_TYPE_LOCKUP:
+		return "Lockup";
+	case CCCI_EX_TYPE_ASSERT_DUMP:
+		return "ASSERT DUMP";
+	case CCCI_EX_TYPE_ASSERT_FAIL:
+		return "ASSERT FAIL";
+	case CCCI_EX_TYPE_DSP_ASSERT:
+		return "MD DMD ASSERT";
+	case CCCI_EX_TYPE_DSP_EXCEPTION:
+		return "MD DMD Exception";
+	case CCCI_EX_TYPE_DSP_FATAL_ERROR:
+		return "MD DMD FATAL ERROR";
+	case CCCI_EX_TYPE_CROSS_CORE:
+		return "Fatal error (LTE_EXP)";
+	case CCCI_EX_TYPE_EMI_MPU_VIOLATION:
+		return "Fatal error (rmpu violation)";
+	case CCCI_EX_TYPE_C2K_ERROR:
+		return "Fatal error (C2K_EXP)";
+	case CCCI_EX_TYPE_EMI_CHECK:
+		return "EMI_CHK";
+	default:
+		return "UNKNOWN Exception";
+	}
+}
+
+/*
+ * Copy a bounded, printable C string out of the modem record.  The modem
+ * writes raw bytes; anything outside printable ASCII is shown as '.'.
+ */
+static void ccci_ex_sanitize(char *dst, size_t dst_len, const u8 *src,
+			     size_t src_len)
+{
+	size_t i, n;
+
+	n = strnlen((const char *)src, src_len);
+	if (n >= dst_len)
+		n = dst_len - 1;
+	for (i = 0; i < n; i++)
+		dst[i] = (src[i] >= 0x20 && src[i] <= 0x7e) ? src[i] : '.';
+	dst[i] = '\0';
+}
+
+static bool ccci_ex_type_is_assert(u8 type)
+{
+	/*
+	 * port_kernel.c:3153-3175, 3200-3215: ASSERT, ASSERT DUMP and the
+	 * DSP/MD32 ASSERT all carry EX_ASSERTFAIL_T in the content union.
+	 */
+	switch (type) {
+	case CCCI_EX_TYPE_ASSERT:
+	case CCCI_EX_TYPE_ASSERT_DUMP:
+	case CCCI_EX_TYPE_ASSERT_FAIL:
+	case CCCI_EX_TYPE_DSP_ASSERT:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * Types whose content union is EX_FATALERR_T and therefore carries
+ * error_code.code1/code2 (port_kernel.c:3130-3205).  INVALID, LOCKUP and the
+ * EMI check have no error code in the ROM decoder.
+ */
+static bool ccci_ex_type_has_codes(u8 type)
+{
+	switch (type) {
+	case CCCI_EX_TYPE_UNDEF:
+	case CCCI_EX_TYPE_SWI:
+	case CCCI_EX_TYPE_PREF_ABT:
+	case CCCI_EX_TYPE_DATA_ABT:
+	case CCCI_EX_TYPE_FATALERR_TASK:
+	case CCCI_EX_TYPE_FATALERR_BUF:
+	case CCCI_EX_TYPE_DSP_EXCEPTION:
+	case CCCI_EX_TYPE_DSP_FATAL_ERROR:
+	case CCCI_EX_TYPE_CROSS_CORE:
+	case CCCI_EX_TYPE_EMI_MPU_VIOLATION:
+	case CCCI_EX_TYPE_C2K_ERROR:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * Decode one EX_LOG_T (downstream eccci/ccci_core.h:130-135).  The content
+ * union is an assert record or a fatal-error record depending on ex_type;
+ * the offender string sits at offset 288 of the record (port_kernel.h:29,
+ * port_kernel.c:3160-3168).
+ */
+static void ccci_ex_decode_record(struct ccci_md *md, struct ccci_ex_text *t,
+				  const char *source, const u8 *rec,
+				  size_t len)
+{
+	const struct ccci_ex_log *log = (const struct ccci_ex_log *)rec;
+	u32 code1, code2;
+	bool is_assert, has_codes;
+	char text[33];
+	char file[33];
+
+	ccci_ex_printf(t, "--- EX_LOG_T from %s (%zu of %zu bytes)\n", source,
+		       len, sizeof(*log));
+	if (len < sizeof(*log)) {
+		ccci_ex_printf(t, "  record truncated\n");
+		ccci_md_err(md, "exception record from %s truncated: %zu bytes\n",
+			    source, len);
+		return;
+	}
+
+	ccci_ex_printf(t,
+		       "  header: ex_type %u (%s), nvram %u, serial %u\n",
+		       log->header.ex_type,
+		       ccci_ex_type_name(log->header.ex_type),
+		       log->header.ex_nvram,
+		       le16_to_cpu(log->header.ex_serial_num));
+	ccci_ex_sanitize(text, sizeof(text), log->envinfo.execution_unit,
+			 sizeof(log->envinfo.execution_unit));
+	ccci_ex_printf(t,
+		       "  envinfo: boot_mode %u, unit \"%s\", status 0x%02x, ELM_status 0x%02x\n",
+		       log->envinfo.boot_mode, text, log->envinfo.status,
+		       log->envinfo.elm_status);
+
+	is_assert = ccci_ex_type_is_assert(log->header.ex_type);
+	has_codes = ccci_ex_type_has_codes(log->header.ex_type);
+	code1 = le32_to_cpu(log->content.fatalerr.error_code.code1);
+	code2 = le32_to_cpu(log->content.fatalerr.error_code.code2);
+
+	if (is_assert) {
+		ccci_ex_sanitize(file, sizeof(file), log->content.assert.filename,
+				 sizeof(log->content.assert.filename));
+		ccci_ex_printf(t,
+			       "  assert: file \"%s\", line %u, p1 0x%08x, p2 0x%08x, p3 0x%08x\n",
+			       file,
+			       le32_to_cpu(log->content.assert.linenumber),
+			       le32_to_cpu(log->content.assert.parameters[0]),
+			       le32_to_cpu(log->content.assert.parameters[1]),
+			       le32_to_cpu(log->content.assert.parameters[2]));
+	} else if (has_codes) {
+		ccci_ex_printf(t,
+			       "  fatal error: code1 0x%08x, code2 0x%08x\n",
+			       code1, code2);
+		/*
+		 * EMI MPU / RMPU fault: port_kernel.c:2752-2765 names this case
+		 * "Fatal error (rmpu violation)" and marks it as a fatal-error
+		 * record.  EX_LOG_T only carries two error codes (EX_PL_LOG_T
+		 * has a third); no other field is set by the modem for it.
+		 */
+		if (log->header.ex_type == CCCI_EX_TYPE_EMI_MPU_VIOLATION)
+			ccci_ex_printf(t,
+				       "  RMPU: the modem core violated an EMI MPU/RMPU region permission (ECT_SRC_RMPU, ccci_core.h:352)\n");
+		if (log->header.ex_type == CCCI_EX_TYPE_C2K_ERROR &&
+		    code1 == CCCI_EX_C2K_FATAL_ERR_CODE1)
+			ccci_ex_printf(t,
+				       "  C2K fatal error: no AEE DB trigger for this class (port_kernel.c:3100-3104)\n");
+	} else {
+		ccci_ex_printf(t, "  no error code for this exception type\n");
+	}
+
+	if (rec[CCCI_EXREC_OFFSET_OFFENDER] == CCCI_EX_OFFENDER_NONE) {
+		ccci_ex_printf(t, "  offender: none (0x%02x marker)\n",
+			       CCCI_EX_OFFENDER_NONE);
+		text[0] = '\0';
+	} else {
+		ccci_ex_sanitize(text, sizeof(text),
+				 rec + CCCI_EXREC_OFFSET_OFFENDER,
+				 sizeof(*log) - CCCI_EXREC_OFFSET_OFFENDER);
+		ccci_ex_printf(t, "  offender: \"%s\"\n", text);
+	}
+
+	if (is_assert)
+		ccci_md_err(md,
+			    "EX record from %s: type %u (%s), serial %u, boot_mode %u, status 0x%02x, assert file \"%s\" line %u, offender \"%s\"\n",
+			    source, log->header.ex_type,
+			    ccci_ex_type_name(log->header.ex_type),
+			    le16_to_cpu(log->header.ex_serial_num),
+			    log->envinfo.boot_mode, log->envinfo.status,
+			    file, le32_to_cpu(log->content.assert.linenumber),
+			    text);
+	else if (has_codes)
+		ccci_md_err(md,
+			    "EX record from %s: type %u (%s), nvram %u, serial %u, boot_mode %u, status 0x%02x, ELM 0x%02x, code1 0x%08x, code2 0x%08x, offender \"%s\"\n",
+			    source, log->header.ex_type,
+			    ccci_ex_type_name(log->header.ex_type),
+			    log->header.ex_nvram,
+			    le16_to_cpu(log->header.ex_serial_num),
+			    log->envinfo.boot_mode, log->envinfo.status,
+			    log->envinfo.elm_status, code1, code2, text);
+	else
+		ccci_md_err(md,
+			    "EX record from %s: type %u (%s), nvram %u, serial %u, boot_mode %u, status 0x%02x, ELM 0x%02x, offender \"%s\"\n",
+			    source, log->header.ex_type,
+			    ccci_ex_type_name(log->header.ex_type),
+			    log->header.ex_nvram,
+			    le16_to_cpu(log->header.ex_serial_num),
+			    log->envinfo.boot_mode, log->envinfo.status,
+			    log->envinfo.elm_status, text);
+}
+
+static bool ccci_ex_smem_range(struct ccci_md *md, size_t off, size_t len)
+{
+	return md->smem_vir && off <= md->smem_size &&
+	       len <= md->smem_size - off;
+}
+
+/*
+ * Dump one AP-visible shared-memory window.  The full window goes to the
+ * snapshot and to the util dump ring; the kernel log is bounded to @klog_len
+ * because it is the slowest destination.
+ */
+static void ccci_ex_dump_region(struct ccci_md *md, struct ccci_ex_text *t,
+				const char *name, size_t off, size_t len,
+				size_t klog_len)
+{
+	char prefix[64];
+	u8 *buf;
+
+	if (!ccci_ex_smem_range(md, off, len)) {
+		ccci_ex_printf(t,
+			       "--- %s: smem+0x%zx, 0x%zx bytes: unavailable (smem %s, size 0x%zx)\n",
+			       name, off, len,
+			       md->smem_vir ? "mapped" : "not mapped",
+			       md->smem_size);
+		ccci_md_warn(md, "dump %s unavailable (smem+0x%zx)\n", name,
+			     off);
+		return;
+	}
+
+	buf = kvmalloc(len, GFP_KERNEL);
+	if (!buf) {
+		ccci_ex_printf(t, "--- %s: kvmalloc(0x%zx) failed\n", name,
+			       len);
+		return;
+	}
+	memcpy_fromio(buf, md->smem_vir + off, len);
+
+	ccci_ex_printf(t, "--- %s: smem+0x%zx, 0x%zx bytes%s\n", name, off,
+		       len, len > klog_len ? " (kernel log truncated)" : "");
+	ccci_ex_hex(t, buf, len);
+
+	snprintf(prefix, sizeof(prefix), "ccci: md%u %s: ", md->id + 1, name);
+	print_hex_dump(KERN_ERR, prefix, DUMP_PREFIX_OFFSET, 16, 1, buf,
+		       min_t(size_t, len, klog_len), false);
+
+	/* persistent per-MD dump ring, downstream ccci_mem_dump() */
+	ccci_util_dump_mem(md->id, buf, len);
+	kvfree(buf);
+}
+
+/* MD image head, downstream MD_IMG_DUMP_SIZE == 256 (ccci_core.h:640) */
+static void ccci_ex_dump_image(struct ccci_md *md, struct ccci_ex_text *t)
+{
+	u8 buf[CCCI_MD_IMG_DUMP_SIZE];
+
+	if (!md->img_vir || md->img_size < sizeof(buf)) {
+		ccci_ex_printf(t,
+			       "--- MD image head: unavailable (image %s, size 0x%zx)\n",
+			       md->img_vir ? "mapped" : "not mapped",
+			       md->img_size);
+		return;
+	}
+
+	memcpy_fromio(buf, md->img_vir, sizeof(buf));
+	ccci_ex_printf(t, "--- MD image head: MD_IMG_DUMP_SIZE 0x%zx bytes\n",
+		       sizeof(buf));
+	ccci_ex_hex(t, buf, sizeof(buf));
+	print_hex_dump(KERN_ERR, "ccci: md image head: ", DUMP_PREFIX_OFFSET,
+		       16, 1, buf, sizeof(buf), false);
+	ccci_util_dump_mem(md->id, buf, sizeof(buf));
+}
+
+static bool ccci_ex_dhl_ctrl_open(struct ccci_md *md)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->rx_ch == CCCI_UART1_RX)
+			return atomic_read(&port->open_count) > 0;
+	}
+	return false;
+}
+
+static void ccci_ex_build(struct ccci_md *md, unsigned int reason,
+			  unsigned int flags)
+{
+	struct ccci_ex_text t;
+	struct ccci_exception *ex = &md->ex;
+	unsigned long lflags;
+	u8 packet[CCCI_EX_PACKET_MAX];
+	u8 smem_record[sizeof(struct ccci_ex_log)];
+	const u8 *record = NULL;
+	const char *record_src = NULL;
+	size_t record_len = 0;
+	size_t packet_len = 0;
+	bool packet_valid = false;
+	bool dhl_open;
+	char *buf;
+	char *old;
+	u32 count;
+
+	buf = kvmalloc(CCCI_EX_DUMP_MAX, GFP_KERNEL);
+	if (!buf) {
+		ccci_md_err(md, "exception dump: cannot allocate snapshot\n");
+		return;
+	}
+
+	t.buf = buf;
+	t.size = CCCI_EX_DUMP_MAX;
+	t.len = 0;
+	t.buf[0] = '\0';
+
+	spin_lock_irqsave(&ex->lock, lflags);
+	if (ex->packet_valid && ex->packet_len <= sizeof(packet)) {
+		packet_len = ex->packet_len;
+		memcpy(packet, ex->packet, packet_len);
+		packet_valid = true;
+	}
+	count = ex->dump_count + 1;
+	spin_unlock_irqrestore(&ex->lock, lflags);
+
+	dhl_open = ccci_ex_dhl_ctrl_open(md);
+
+	ccci_ex_printf(&t, "CCCI exception dump md%u #%u\n", md->id + 1,
+		       count);
+	ccci_ex_printf(&t, " reason: %s\n",
+		       ccci_ex_reason_name(reason));
+	ccci_ex_aed_flags(&t, flags);
+	ccci_ex_printf(&t,
+		       " state %d, boot stage %u, exception stage %s (%u), exception type %u (%s)\n",
+		       READ_ONCE(md->state), md->boot_stage,
+		       ccci_exception_stage_name(md->ex_stage), md->ex_stage,
+		       md->ex_type, ccci_ex_type_name(md->ex_type));
+	ccci_ex_printf(&t,
+		       " smem %pa+0x%zx, image %pa+0x%zx, transport %s\n",
+		       &md->smem_phy, md->smem_size, &md->img_phy,
+		       md->img_size,
+		       md->cldma ? "CLDMA" : "CCIF-ring");
+
+	/*
+	 * The modem stamps 0xBAEBAE10 at smem+0xC64 when it took the software
+	 * watchdog path; the ROM watchdog worker tests this word before it
+	 * decides to reset (modem_cldma.c:1862-1872).
+	 */
+	if (ccci_ex_smem_range(md, CCCI_SMEM_OFFSET_EPON, sizeof(u32))) {
+		u32 epon;
+
+		memcpy_fromio(&epon, md->smem_vir + CCCI_SMEM_OFFSET_EPON,
+			      sizeof(epon));
+		ccci_ex_printf(&t,
+			       " SW watchdog marker (smem+0x%x): 0x%08x%s\n",
+			       CCCI_SMEM_OFFSET_EPON, epon,
+			       epon == CCCI_SMEM_EPON_SW_WDT ?
+			       " (MD reported SW WDT)" : "");
+	}
+
+	/*
+	 * DHL: the ROM build leaves FEATURE_DHL_LOG_EN undefined (there is no
+	 * definition in the downstream tree), so port_kernel.c:215-219
+	 * publishes DHL_SHARE_MEMORY as CCCI_FEATURE_NOT_SUPPORT and no
+	 * shared-memory carve-out exists.  What does exist is the protocol-type
+	 * ioctl (port_char.c:571-582) and the META-mode close gate
+	 * (port_char.c:79-90).
+	 */
+	ccci_ex_printf(&t,
+		       " DHL: protocol \"DHL\", control port %s, md_boot_mode %u (%s), close gate %s\n",
+		       dhl_open ? "open" : "closed", md->md_boot_mode,
+		       md->md_boot_mode == CCCI_MD_BOOT_MODE_META ? "META" :
+		       "normal",
+		       (dhl_open && md->md_boot_mode == CCCI_MD_BOOT_MODE_META) ?
+		       "blocks modem reset" : "allows modem reset");
+	ccci_ex_printf(&t,
+		       " DHL shared memory: NOT_SUPPORT (FEATURE_DHL_LOG_EN undefined in the ROM build)\n");
+
+	/*
+	 * Record source, downstream ccci_md_exception() (port_kernel.c:
+	 * 3125-3135): the packet copy is used for MD3 and before the boot
+	 * handshake, the shared-memory record afterwards.
+	 */
+	if ((md->id == CCCI_MD_SYS3 || md->boot_stage == CCCI_BOOT_STAGE_0) &&
+	    packet_valid && packet_len > CCCI_HEADER_SIZE) {
+		record = packet + CCCI_HEADER_SIZE;
+		record_len = packet_len - CCCI_HEADER_SIZE;
+		record_src = "MD_EX_REC_OK packet";
+	} else if (ccci_ex_smem_range(md, CCCI_SMEM_OFFSET_EXREC,
+				      sizeof(smem_record))) {
+		memcpy_fromio(smem_record,
+			      md->smem_vir + CCCI_SMEM_OFFSET_EXREC,
+			      sizeof(smem_record));
+		record = smem_record;
+		record_len = sizeof(smem_record);
+		record_src = "shared memory EXREC (smem+0x800)";
+	} else if (packet_valid && packet_len > CCCI_HEADER_SIZE) {
+		record = packet + CCCI_HEADER_SIZE;
+		record_len = packet_len - CCCI_HEADER_SIZE;
+		record_src = "MD_EX_REC_OK packet (no smem window)";
+	}
+
+	if (packet_valid) {
+		ccci_ex_printf(&t,
+			       "--- MD_EX_REC_OK packet (ccci_header + EX_LOG_T), %zu bytes\n",
+			       packet_len);
+		ccci_ex_hex(&t, packet, packet_len);
+		print_hex_dump(KERN_ERR, "ccci: ex packet: ",
+			       DUMP_PREFIX_OFFSET, 16, 1, packet,
+			       min_t(size_t, packet_len, CCCI_EX_KLOG_BYTES),
+			       false);
+		ccci_util_dump_mem(md->id, packet, packet_len);
+	} else {
+		ccci_ex_printf(&t,
+			       "--- MD_EX_REC_OK packet: not received\n");
+	}
+
+	/*
+	 * Fixed-offset windows of the exception region, ccci_config.h:70-83.
+	 * The CCCI debug record and the MDSS debug window together are the
+	 * 4 KiB CCCI_SMEM_DUMP_SIZE window that md_ex_monitor_func() dumps
+	 * (port_kernel.c:3411-3413); they are printed separately because they
+	 * have different consumers.
+	 */
+	ccci_ex_dump_region(md, &t, "CCCI debug record (CCCI_SMEM_OFFSET_CCCI_DEBUG)",
+			    CCCI_SMEM_OFFSET_CCCI_DEBUG,
+			    CCCI_SMEM_CCCI_DEBUG_SIZE, CCCI_EX_KLOG_BYTES);
+	ccci_ex_dump_region(md, &t, "MDSS debug / exception record (CCCI_SMEM_OFFSET_EXREC)",
+			    CCCI_SMEM_OFFSET_MDSS_DEBUG,
+			    CCCI_SMEM_MDSS_DEBUG_SIZE, CCCI_EX_KLOG_BYTES);
+
+	/* CCIF SRAM header copy, only refreshed for the CCIF_REG selection */
+	if (flags & CCCI_AED_DUMP_CCIF_REG)
+		ccci_ex_dump_region(md, &t, "CCIF SRAM snapshot",
+				    CCCI_SMEM_OFFSET_CCIF_SRAM,
+				    CCCI_SMEM_CCIF_SRAM_SIZE,
+				    CCCI_SMEM_CCIF_SRAM_SIZE);
+
+	ccci_ex_dump_image(md, &t);
+
+	if (record)
+		ccci_ex_decode_record(md, &t, record_src, record, record_len);
+	else
+		ccci_ex_printf(&t,
+			       "--- EX_LOG_T: unavailable (no packet, no smem window)\n");
+
+	/* CCIF registers, existing core helper (prints to the kernel log) */
+	ccci_ex_printf(&t,
+		       "--- CCIF registers: dumped to the kernel log by md%u\n",
+		       md->id + 1);
+	ccci_ccif_dump_regs(md, NULL);
+
+	if (t.len >= t.size)
+		ccci_md_warn(md, "exception snapshot truncated at %zu bytes\n",
+			     t.size);
+
+	mutex_lock(&ex->dump_lock);
+	old = ex->dump;
+	ex->dump = buf;
+	ex->dump_len = t.len;
+	ex->dump_count = count;
+	ex->dump_reason = reason;
+	ex->dump_flags = flags;
+	ex->dump_ex_stage = md->ex_stage;
+	ex->dump_ex_type = md->ex_type;
+	mutex_unlock(&ex->dump_lock);
+	kvfree(old);
+
+#if IS_ENABLED(CONFIG_MTK_AEE_FEATURE)
+	/*
+	 * Hand the exception record to the AEE client, exactly where downstream
+	 * ccci_aed() does (port_kernel.c:2335-2336):
+	 *
+	 *  - the EX_LOG_T record selected above (MD_EX_REC_OK packet or the
+	 *    EXREC window), port_kernel.c:2318-2333;
+	 *  - the first MD_IMG_DUMP_SIZE bytes of the modem image,
+	 *    port_kernel.c:2329-2333 (CCCI_MD_IMG_DUMP_SIZE == 256,
+	 *    ccci_priv.h:852);
+	 *  - the "mdN:<module>" detail string, port_kernel.c:2304.  The image
+	 *    information suffix that downstream appends through
+	 *    ccci_get_md_info_str() (port_kernel.c:2295) has no equivalent in
+	 *    this tree, so the reason name is used as the module text;
+	 *  - DB_OPT_DEFAULT | DB_OPT_FTRACE, port_kernel.c:2347.
+	 */
+	{
+		u8 img[CCCI_MD_IMG_DUMP_SIZE];
+		const int *img_p = NULL;
+		int img_len = 0;
+		char detail[64];
+
+		if (md->img_vir && md->img_size >= sizeof(img)) {
+			memcpy_fromio(img, md->img_vir, sizeof(img));
+			img_p = (const int *)img;
+			img_len = sizeof(img);
+		}
+
+		snprintf(detail, sizeof(detail), "md%u:%s", md->id + 1,
+			 ccci_ex_reason_name(reason));
+
+		aed_md_exception_api((const int *)record, (int)record_len,
+				     img_p, img_len, detail,
+				     DB_OPT_DEFAULT | DB_OPT_FTRACE);
+	}
+#endif
+
+	ccci_md_err(md,
+		    "exception dump #%u ready (%zu bytes, reason %s), full hex in ccci_dump/debugfs\n",
+		    count, t.len, ccci_ex_reason_name(reason));
+}
+
+static void ccci_ex_work(struct work_struct *work)
+{
+	struct ccci_md *md = container_of(work, struct ccci_md, ex.work);
+	struct ccci_exception *ex = &md->ex;
+	unsigned long lflags;
+	unsigned int reason, flags;
+
+	for (;;) {
+		spin_lock_irqsave(&ex->lock, lflags);
+		if (!ex->ready || !ex->pending) {
+			ex->worker_active = false;
+			spin_unlock_irqrestore(&ex->lock, lflags);
+			break;
+		}
+		reason = ex->pending_reason;
+		flags = ex->pending_flags;
+		ex->pending = false;
+		spin_unlock_irqrestore(&ex->lock, lflags);
+
+		ccci_ex_build(md, reason, flags);
+	}
+}
+
+void ccci_exception_capture_packet(struct ccci_md *md, const void *data,
+				   size_t len)
+{
+	struct ccci_exception *ex;
+	unsigned long lflags;
+
+	if (!md || !data || !len)
+		return;
+
+	ex = &md->ex;
+	spin_lock_irqsave(&ex->lock, lflags);
+	if (ex->ready) {
+		ex->packet_len = min_t(size_t, len, sizeof(ex->packet));
+		memcpy(ex->packet, data, ex->packet_len);
+		ex->packet_valid = true;
+	}
+	spin_unlock_irqrestore(&ex->lock, lflags);
+}
+
+unsigned int ccci_exception_dump_flags(struct ccci_md *md)
+{
+	/*
+	 * Downstream ccci_ee_info_dump() prefers the MD_EX_REC_OK packet while
+	 * the modem is still in boot stage 0 and the shared-memory record
+	 * afterwards (port_kernel.c:3125-3135, ccci_aed() selection at
+	 * port_kernel.c:3079-3088).
+	 */
+	if (!md)
+		return 0;
+	return md->boot_stage == CCCI_BOOT_STAGE_0 ? CCCI_AED_DUMP_EX_PKT :
+						     CCCI_AED_DUMP_EX_MEM;
+}
+
+void ccci_exception_trigger(struct ccci_md *md, unsigned int reason,
+			    unsigned int flags)
+{
+	struct ccci_exception *ex;
+	unsigned long lflags;
+
+	if (!md)
+		return;
+
+	ex = &md->ex;
+	spin_lock_irqsave(&ex->lock, lflags);
+	if (ex->ready) {
+		ex->pending = true;
+		ex->pending_reason = reason;
+		ex->pending_flags = flags;
+		if (!ex->worker_active) {
+			ex->worker_active = true;
+			/* queued under the lock so exit's cancel_work_sync()
+			 * is ordered after any in-flight trigger
+			 */
+			schedule_work(&ex->work);
+		}
+	}
+	spin_unlock_irqrestore(&ex->lock, lflags);
+}
+
+void ccci_exception_trigger_sync(struct ccci_md *md, unsigned int reason,
+				 unsigned int flags)
+{
+	if (!md)
+		return;
+
+	ccci_exception_trigger(md, reason, flags);
+	/*
+	 * The worker loops over all pending requests, so one flush covers the
+	 * dump queued above.  No-op when the engine was never initialised.
+	 */
+	if (READ_ONCE(md->ex.ready))
+		flush_work(&md->ex.work);
+}
+
+static size_t ccci_exception_packet_copy(struct ccci_md *md, void *dst,
+					 size_t len)
+{
+	unsigned long lflags;
+	size_t n;
+
+	if (!md || !dst || !len)
+		return 0;
+
+	spin_lock_irqsave(&md->ex.lock, lflags);
+	if (!md->ex.packet_valid) {
+		n = 0;
+	} else {
+		n = min(len, md->ex.packet_len);
+		memcpy(dst, md->ex.packet, n);
+	}
+	spin_unlock_irqrestore(&md->ex.lock, lflags);
+	return n;
+}
+
+int ccci_exception_ccci_debug_window(struct ccci_md *md, void __iomem **vir,
+				     size_t *size)
+{
+	/*
+	 * downstream ccci_core.c:271-273 sets
+	 * ccci_exp_smem_ccci_debug_vir = exp_smem_base_vir +
+	 * CCCI_SMEM_OFFSET_CCCI_DEBUG (0) and
+	 * ccci_exp_smem_ccci_debug_size = CCCI_SMEM_CCCI_DEBUG_SIZE (2048);
+	 * aee_dump_ccci_debug_info() returns exactly those two values.
+	 */
+	if (!md || !vir || !size)
+		return -EINVAL;
+	if (!ccci_ex_smem_range(md, CCCI_SMEM_OFFSET_CCCI_DEBUG,
+				CCCI_SMEM_CCCI_DEBUG_SIZE))
+		return -ENODEV;
+
+	*vir = md->smem_vir + CCCI_SMEM_OFFSET_CCCI_DEBUG;
+	*size = CCCI_SMEM_CCCI_DEBUG_SIZE;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* debugfs per modem                                                   */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_ex_dbg_dump_read(struct file *file, char __user *buf,
+				     size_t count, loff_t *ppos)
+{
+	struct ccci_md *md = file->private_data;
+	ssize_t ret;
+
+	mutex_lock(&md->ex.dump_lock);
+	if (!md->ex.dump)
+		ret = 0;
+	else
+		ret = simple_read_from_buffer(buf, count, ppos, md->ex.dump,
+					      md->ex.dump_len);
+	mutex_unlock(&md->ex.dump_lock);
+	return ret;
+}
+
+static ssize_t ccci_ex_dbg_packet_read(struct file *file, char __user *buf,
+				       size_t count, loff_t *ppos)
+{
+	struct ccci_md *md = file->private_data;
+	u8 packet[CCCI_EX_PACKET_MAX];
+	size_t len;
+
+	len = ccci_exception_packet_copy(md, packet, sizeof(packet));
+	return simple_read_from_buffer(buf, count, ppos, packet, len);
+}
+
+static ssize_t ccci_ex_dbg_stage_read(struct file *file, char __user *buf,
+				      size_t count, loff_t *ppos)
+{
+	struct ccci_md *md = file->private_data;
+	char text[640];
+	bool dhl_open = ccci_ex_dhl_ctrl_open(md);
+	bool meta = md->md_boot_mode == CCCI_MD_BOOT_MODE_META;
+	int len;
+
+	len = scnprintf(text, sizeof(text),
+			"state %d, boot stage %u\n"
+			"exception stage %u (%s), exception type %u (%s)\n"
+			"md_boot_mode %u (%s), DHL control port %s\n"
+			"DHL META close gate: %s\n"
+			"dumps %u, last reason %s, AED flags 0x%x\n"
+			"last stage %s (%u), last type %u, packet %s\n",
+			READ_ONCE(md->state), md->boot_stage,
+			md->ex_stage, ccci_exception_stage_name(md->ex_stage),
+			md->ex_type, ccci_ex_type_name(md->ex_type),
+			md->md_boot_mode, meta ? "META" : "normal",
+			dhl_open ? "open" : "closed",
+			(dhl_open && meta) ?
+			"refuses modem reset" : "idle",
+			md->ex.dump_count,
+			ccci_ex_reason_name(md->ex.dump_reason),
+			md->ex.dump_flags,
+			ccci_exception_stage_name(md->ex.dump_ex_stage),
+			md->ex.dump_ex_stage, md->ex.dump_ex_type,
+			READ_ONCE(md->ex.packet_valid) ? "captured" : "absent");
+
+	return simple_read_from_buffer(buf, count, ppos, text, len);
+}
+
+static const struct file_operations ccci_ex_dbg_dump_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ccci_ex_dbg_dump_read,
+	.llseek = default_llseek,
+};
+
+static const struct file_operations ccci_ex_dbg_packet_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ccci_ex_dbg_packet_read,
+	.llseek = default_llseek,
+};
+
+static const struct file_operations ccci_ex_dbg_stage_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = ccci_ex_dbg_stage_read,
+	.llseek = default_llseek,
+};
+
+static struct dentry *ccci_ex_dbg_create(struct ccci_md *md, const char *name,
+					 const struct file_operations *fops)
+{
+	struct dentry *d;
+
+	d = debugfs_create_file(name, 0444, md->dbg_dir, md, fops);
+	if (IS_ERR_OR_NULL(d)) {
+		ccci_md_dbg(md, "cannot create debugfs %s (%ld)\n", name,
+			    IS_ERR(d) ? PTR_ERR(d) : 0);
+		return NULL;
+	}
+	return d;
+}
+
+int ccci_exception_init(struct ccci_md *md)
+{
+	struct ccci_exception *ex = &md->ex;
+
+	/*
+	 * The wire format must stay byte-identical to the modem's EX_LOG_T;
+	 * every offset above depends on it (ccci_core.h:130-135).
+	 */
+	BUILD_BUG_ON(sizeof(struct ccci_ex_log) != 512);
+	BUILD_BUG_ON(sizeof(struct ccci_ex_header) != 4);
+	BUILD_BUG_ON(sizeof(struct ccci_ex_env_info) != 164);
+	BUILD_BUG_ON(sizeof(union ccci_ex_content) != 296);
+	BUILD_BUG_ON(CCCI_EXREC_OFFSET_OFFENDER >= sizeof(struct ccci_ex_log));
+	/* downstream CCCI_SMEM_DUMP_SIZE (0x1000) covers both dump windows,
+	 * mt6735/ccci_config.h:70-83
+	 */
+	BUILD_BUG_ON(CCCI_SMEM_OFFSET_MDSS_DEBUG + CCCI_SMEM_MDSS_DEBUG_SIZE >
+		     CCCI_SMEM_DUMP_SIZE);
+
+	spin_lock_init(&ex->lock);
+	mutex_init(&ex->dump_lock);
+	INIT_WORK(&ex->work, ccci_ex_work);
+
+	ex->dump = kvmalloc(CCCI_EX_DUMP_MAX, GFP_KERNEL);
+	if (!ex->dump) {
+		mutex_destroy(&ex->dump_lock);
+		return -ENOMEM;
+	}
+	ex->dump[0] = '\0';
+	ex->dump_len = 0;
+
+	if (md->dbg_dir) {
+		ex->dbg_dump = ccci_ex_dbg_create(md, "exception_dump",
+						  &ccci_ex_dbg_dump_fops);
+		ex->dbg_packet = ccci_ex_dbg_create(md, "exception_packet",
+						    &ccci_ex_dbg_packet_fops);
+		ex->dbg_stage = ccci_ex_dbg_create(md, "exception_stage",
+						   &ccci_ex_dbg_stage_fops);
+	} else {
+		ccci_md_dbg(md, "debugfs unavailable, exception snapshot only in ccci_dump\n");
+	}
+
+	spin_lock_irq(&ex->lock);
+	ex->ready = true;
+	spin_unlock_irq(&ex->lock);
+	return 0;
+}
+
+void ccci_exception_exit(struct ccci_md *md)
+{
+	struct ccci_exception *ex = &md->ex;
+	unsigned long lflags;
+
+	if (!ex->ready && !ex->dump)
+		return;
+
+	spin_lock_irqsave(&ex->lock, lflags);
+	ex->ready = false;
+	ex->pending = false;
+	spin_unlock_irqrestore(&ex->lock, lflags);
+
+	cancel_work_sync(&ex->work);
+
+	debugfs_remove(ex->dbg_dump);
+	debugfs_remove(ex->dbg_packet);
+	debugfs_remove(ex->dbg_stage);
+	ex->dbg_dump = NULL;
+	ex->dbg_packet = NULL;
+	ex->dbg_stage = NULL;
+
+	mutex_lock(&ex->dump_lock);
+	kvfree(ex->dump);
+	ex->dump = NULL;
+	ex->dump_len = 0;
+	mutex_unlock(&ex->dump_lock);
+	mutex_destroy(&ex->dump_lock);
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_exception.h b/drivers/misc/mediatek/ccci/ccci_exception.h
new file mode 100644
index 000000000..2774f6d12
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_exception.h
@@ -0,0 +1,242 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CCCI exception / AEE dump engine: private state and the modem exception
+ * record wire format.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/eccci/ccci_core.h        (EX_HEADER_T, EX_ENVINFO_T,
+ *                                                   EX_LOG_T, MD_EX_TYPE_*)
+ *   drivers/misc/mediatek/eccci/port_kernel.h      (CCCI_AED_DUMP_*,
+ *                                                   AED_STR_LEN,
+ *                                                   CCCI_EXREC_OFFSET_OFFENDER)
+ *   drivers/misc/mediatek/eccci/port_kernel.c      (ccci_aed, EE dump flow)
+ *
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#ifndef __CCCI_EXCEPTION_H__
+#define __CCCI_EXCEPTION_H__
+
+#include <linux/bits.h>
+#include <linux/debugfs.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+struct ccci_md;
+
+/* ------------------------------------------------------------------ */
+/* Modem exception log, downstream eccci/ccci_core.h:60-135            */
+/* ------------------------------------------------------------------ */
+
+/* MODEM MAUI Exception header (4 bytes) */
+struct ccci_ex_header {
+	u8 ex_type;
+	u8 ex_nvram;
+	__le16 ex_serial_num;
+} __packed;
+
+/* MODEM MAUI Environment information (164 bytes) */
+struct ccci_ex_env_info {
+	u8 boot_mode;		/* offset: +0x10 */
+	u8 reserved1[8];
+	u8 execution_unit[8];
+	u8 status;		/* offset: +0x21 */
+	u8 elm_status;		/* offset: +0x22 */
+	u8 reserved2[145];
+} __packed;
+
+/* MODEM MAUI fatal error code (8 bytes) */
+struct ccci_ex_fatalerr_code {
+	__le32 code1;
+	__le32 code2;
+} __packed;
+
+/* MODEM MAUI fatal error (296 bytes) */
+struct ccci_ex_fatalerr {
+	struct ccci_ex_fatalerr_code error_code;
+	u8 reserved1[288];
+} __packed;
+
+/* MODEM MAUI assert fail (296 bytes) */
+struct ccci_ex_assert_fail {
+	u8 filename[24];
+	__le32 linenumber;
+	__le32 parameters[3];
+	u8 reserved1[256];
+} __packed;
+
+/* MODEM MAUI globally exported data structure (296 bytes) */
+union ccci_ex_content {
+	struct ccci_ex_fatalerr fatalerr;
+	struct ccci_ex_assert_fail assert;
+} __packed;
+
+/* MODEM MAUI standard exception log (512 bytes) */
+struct ccci_ex_log {
+	struct ccci_ex_header header;
+	u8 reserved1[12];
+	struct ccci_ex_env_info envinfo;
+	u8 reserved2[36];
+	union ccci_ex_content content;
+} __packed;
+
+/* downstream port_kernel.h:29: fatal-error "offender" string in the record */
+#define CCCI_EXREC_OFFSET_OFFENDER	288
+/* downstream port_kernel.c:3160-3168: a 0xCC lead byte means "no offender" */
+#define CCCI_EX_OFFENDER_NONE		0xCC
+
+/*
+ * EX_LOG_T.ex_type values.
+ *
+ * port_kernel.h:31-54 (the port_kernel.c:3152-3250 decoder uses exactly these)
+ * plus EMI_MPU_VIOLATION from ccci_core.h:246 (0x30).  The latter lives in the
+ * platform exception list because it is raised by the RMPU/EMI MPU, not by the
+ * modem software; the non-MD_UMOLY decoder (port_kernel.c:2899-3010) has no
+ * dedicated case for it and reports it as an unknown type, the
+ * MD_UMOLY_EE_SUPPORT decoder (port_kernel.c:2752-2765) names it
+ * "Fatal error (rmpu violation)".  This kernel has no MD_UMOLY build, so the
+ * record layout is EX_LOG_T and the type is decoded here.
+ */
+#define CCCI_EX_TYPE_INVALID		0
+#define CCCI_EX_TYPE_UNDEF		1
+#define CCCI_EX_TYPE_SWI		2
+#define CCCI_EX_TYPE_PREF_ABT		3
+#define CCCI_EX_TYPE_DATA_ABT		4
+#define CCCI_EX_TYPE_ASSERT		5
+#define CCCI_EX_TYPE_FATALERR_TASK	6
+#define CCCI_EX_TYPE_FATALERR_BUF	7
+#define CCCI_EX_TYPE_LOCKUP		8
+#define CCCI_EX_TYPE_ASSERT_DUMP	9
+#define CCCI_EX_TYPE_ASSERT_FAIL	10
+#define CCCI_EX_TYPE_DSP_ASSERT		11
+#define CCCI_EX_TYPE_DSP_EXCEPTION	12
+#define CCCI_EX_TYPE_DSP_FATAL_ERROR	13
+#define CCCI_EX_TYPE_CROSS_CORE		15
+#define CCCI_EX_TYPE_C2K_ERROR		0x25
+#define CCCI_EX_TYPE_EMI_MPU_VIOLATION	0x30	/* ccci_core.h:246 */
+#define CCCI_EX_TYPE_EMI_CHECK		99
+/*
+ * Not an ex_type: downstream port_kernel.h:58 MD_EX_C2K_FATAL_ERROR is the
+ * err_code1 value that marks a C2K fatal error inside a C2K_ERROR record
+ * (port_kernel.c:3100).
+ */
+#define CCCI_EX_C2K_FATAL_ERR_CODE1	0x3000
+
+/* ------------------------------------------------------------------ */
+/* AED dump selectors, downstream eccci/port_kernel.h:19-22            */
+/* ------------------------------------------------------------------ */
+#define CCCI_AED_DUMP_EX_MEM		BIT(0)
+#define CCCI_AED_DUMP_MD_IMG_MEM	BIT(1)
+#define CCCI_AED_DUMP_CCIF_REG		BIT(2)
+#define CCCI_AED_DUMP_EX_PKT		BIT(3)
+
+/* ------------------------------------------------------------------ */
+/* Dump engine limits and state                                        */
+/* ------------------------------------------------------------------ */
+/* ccci_header + the full exception log, as received on MD_EX_REC_OK */
+#define CCCI_EX_PACKET_MAX	(16 + sizeof(struct ccci_ex_log))
+/* text snapshot: header, hex of every region and the decoded record */
+#define CCCI_EX_DUMP_MAX	32768
+/* every region is also printed to the kernel log, bounded per region */
+#define CCCI_EX_KLOG_BYTES	512
+
+/* One entry of the dump, used by the engine internally */
+enum ccci_ex_dump_reason {
+	CCCI_EX_DUMP_MD_EX = 0,
+	CCCI_EX_DUMP_MD_EX_REC_OK,
+	CCCI_EX_DUMP_WDT,
+	CCCI_EX_DUMP_NO_RESPONSE,
+};
+
+/*
+ * Exception shared-memory window (downstream ccci_core.c:262-293):
+ *
+ *   exp_vir/exp_size               CCCI_SMEM_SIZE_EXCEPTION bytes at the base
+ *                                  of the reserved AP<->MD shared memory
+ *   ccci_debug_vir/ccci_debug_size record handed to AEE at
+ *                                  exp_vir + CCCI_SMEM_OFFSET_CCCI_DEBUG
+ *
+ * Downstream derives these from the smem region returned by the CCCI
+ * "smem_layout" tag (ccci_util_lib_fo.c:468-511) plus the MT6735 layout
+ * constants (mt6735/ccci_config.h:71-83).  The modem image CHECK_HEADER does
+ * not carry the exception window: v3/v4/v5 have no smem field at all and v6
+ * only adds the total AP<->MD smem size (ccci_util_lib_main.h:198-201), which
+ * downstream never uses for the exception window.
+ */
+struct ccci_exception {
+	/* packet capture and dump scheduling, taken from Rx/IRQ contexts */
+	spinlock_t lock;
+	bool ready;
+	bool pending;
+	bool worker_active;
+	unsigned int pending_reason;
+	unsigned int pending_flags;
+
+	void __iomem *exp_vir;
+	size_t exp_size;
+	void __iomem *ccci_debug_vir;
+	size_t ccci_debug_size;
+	bool window_resolved;
+
+	u8 packet[CCCI_EX_PACKET_MAX];
+	size_t packet_len;
+	bool packet_valid;
+
+	struct work_struct work;
+
+	/* text snapshot handed to debugfs and in-kernel consumers */
+	struct mutex dump_lock;
+	char *dump;
+	size_t dump_len;
+	u32 dump_count;
+	unsigned int dump_reason;
+	unsigned int dump_flags;
+	unsigned int dump_ex_stage;
+	unsigned int dump_ex_type;
+
+	struct dentry *dbg_dump;
+	struct dentry *dbg_packet;
+	struct dentry *dbg_stage;
+};
+
+/* ------------------------------------------------------------------ */
+/* API (implemented in ccci_exception.c, called from ccci_core.c)      */
+/* ------------------------------------------------------------------ */
+int ccci_exception_init(struct ccci_md *md);
+void ccci_exception_exit(struct ccci_md *md);
+
+/* store the MD_EX_REC_OK packet (ccci_header + EX_LOG_T) for the dump */
+void ccci_exception_capture_packet(struct ccci_md *md, const void *data,
+				   size_t len);
+
+/*
+ * AED selection the ROM uses for an exception dump: the MD_EX_REC_OK packet
+ * before the first boot handshake completes, the shared-memory window after
+ * it (downstream ccci_ee_info_dump(), port_kernel.c:3125-3135).
+ */
+unsigned int ccci_exception_dump_flags(struct ccci_md *md);
+
+/* queue one dump; @reason is enum ccci_ex_dump_reason, @flags CCCI_AED_DUMP_* */
+void ccci_exception_trigger(struct ccci_md *md, unsigned int reason,
+			    unsigned int flags);
+
+/*
+ * Same, but wait until the snapshot is built.  Only for process context and
+ * only where the dump must precede a modem reset (the MD watchdog path,
+ * downstream modem_cldma.c:1838-1897 dumps the RGU/smem before resetting).
+ */
+void ccci_exception_trigger_sync(struct ccci_md *md, unsigned int reason,
+				 unsigned int flags);
+
+/*
+ * CCCI debug record inside the exception window, for the ROM AEE ABI
+ * aee_dump_ccci_debug_info() (downstream ccci_core.c:580-599).  Returns 0 and
+ * fills @vir/@size, or -ENODEV when the modem has no shared-memory window.
+ */
+int ccci_exception_ccci_debug_window(struct ccci_md *md, void __iomem **vir,
+				     size_t *size);
+/* CCCI_EX_* stage name, also used by the debugfs stage file */
+const char *ccci_exception_stage_name(unsigned int stage);
+
+#endif /* __CCCI_EXCEPTION_H__ */
diff --git a/drivers/misc/mediatek/ccci/ccci_mpu.c b/drivers/misc/mediatek/ccci/ccci_mpu.c
new file mode 100644
index 000000000..01b0589b1
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_mpu.c
@@ -0,0 +1,870 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6735/MT6737T modem memory protection.
+ *
+ * Two independent pieces of the downstream CCCI platform code live here:
+ *
+ *  1. EMI MPU region programming.  On MT6735/MT6737T the MPU registers are
+ *     only reachable from the secure world, so every region update is an
+ *     ATF SMC (the same code path the shipping ROM uses):
+ *
+ *       mach/mt_secure_api.h:38   MTK_SIP_KERNEL_EMIMPU_SET = 0x82000209
+ *       mach/mt_secure_api.h:90-91
+ *             emi_mpu_smc_set(start, end, region_permission)
+ *             -> mt_secure_call(id, start, end, region_permission)
+ *       emi_reg_rw.c:74-82        mt_emi_mpu_set_region_protection()
+ *       emi_mpu.c:1138-1149       emi_mpu_set_region_protection(): packs
+ *             (permission & 0xFFFFFF) | ((region & 0xF) << 27)
+ *
+ *     ROM proof (ARM32 vmlinux.elf):
+ *       emi_mpu_set_region_protection @ 0xc064e448:
+ *         0xc064e470  and   r12, r12, #15        region &= 0xF
+ *         0xc064e478  bic   r10, r10, #0xFF000000
+ *         0xc064e480  orr   r10, r10, r12, lsl #27
+ *         0xc064e4a0  bl    mt_emi_mpu_set_region_protection
+ *       mt_emi_mpu_set_region_protection @ 0xc064c7c4:
+ *         0xc064c7d0  mov   r1, r0                start (low word)
+ *         0xc064c7d4  ldr   r3, [r11, #4]         permission (stack arg)
+ *         0xc064c7d8  movw  r0, #0x0209
+ *         0xc064c7dc  movt  r0, #0x8200           function id 0x82000209
+ *         0xc064c7e0  bl    mt_secure_call
+ *       mt_secure_call @ 0xc064c6f8: 0xc064c704  smc #0
+ *
+ *     Only the low 32 bits of start/end reach the monitor (the downstream
+ *     helper is a 4-register function), so addresses above 4 GiB are
+ *     rejected here instead of being silently truncated.
+ *
+ *  2. RMPU (memory remap) windows.  MD1 and MD2/MD3 see DRAM through BANK0
+ *     and BANK4 remap slots in the always-on INFRA window; without them the
+ *     modem cannot address its image or the shared memory at all.
+ *     mt6735/ccci_platform.c:130-148 (register offsets)
+ *     mt6735/ccci_platform.h:22    (KERN_EMI_BASE 0x40000000 = Bank4)
+ *     ROM proof of the offsets/stores:
+ *       set_md_smem_remap       @ 0xc053011c: str ..., [r3, #0x308/#0x30c]
+ *                                            str ..., [r3, #0x318/#0x31c]
+ *       set_md_rom_rw_mem_remap @ 0xc05303b4: str ..., [r3, #0x300/#0x304]
+ *                                            str ..., [r3, #0x310/#0x314]
+ *
+ *  3. Image-security state reporting (ROM ccci_init_security).
+ *
+ * Port from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/eccci/mt6735/ccci_platform.c
+ *   drivers/misc/mediatek/eccci/mt6735/ccci_platform.h
+ *   drivers/misc/mediatek/include/mt-plat/mt6735/include/mach/emi_mpu.h
+ *   drivers/misc/mediatek/include/mt-plat/mt6735/include/mach/mt_secure_api.h
+ *   drivers/misc/mediatek/emi_mpu/emi_reg_rw.c
+ *   drivers/misc/mediatek/emi_mpu/mt6735/emi_mpu.c
+ *   drivers/misc/mediatek/ccci_util/ccci_util_lib_load_img.c
+ *
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/ccci.h>
+#include <linux/io.h>
+#include <linux/kconfig.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/of.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+#include "ccci_mpu.h"
+
+/* ATF SIP function id, mach/mt_secure_api.h:38 */
+#define MTK_SIP_KERNEL_EMIMPU_SET	0x82000209
+
+/*
+ * Access permission encodings, mach/emi_mpu.h:81,85,86.
+ * The SET_ACCESS_PERMISSON() packing is mach/emi_mpu.h:195-197.
+ */
+#define MPU_NO_PROTECTION	0
+#define MPU_SEC_R_NSEC_R	4
+#define MPU_FORBIDDEN		5
+
+#define SET_ACCESS_PERMISSON(d7, d6, d5, d4, d3, d2, d1, d0) \
+	(((d7) << 21) | ((d6) << 18) | ((d5) << 15) | \
+	 ((d4) << 12) | ((d3) << 9) | ((d2) << 6) | ((d1) << 3) | (d0))
+
+/*
+ * Region ids for MT6735/MT6737T, i.e. the non-CONFIG_ARCH_MT6735M half of
+ * mt6735/ccci_platform.c:81-98.  arch/arm/configs/grandpplte_00_defconfig:296
+ * leaves CONFIG_ARCH_MT6735M unset.  (The two remaining ids of the table,
+ * WIFI EMI FW 12 and WMT 13, are not used by the modem.)
+ *
+ * The D-domain order of SET_ACCESS_PERMISSON is
+ * (D7, D6(MFG), D5(MD2), D4(MM), D3(MD32), D2(CONN), D1(MD1), D0(AP))
+ * per ccci_platform.c:99-100, so MD2 is D5 and MD1 is D1.
+ */
+#define MPU_REGION_ID_SEC_OS		0	/* ccci_platform.c:81 */
+#define MPU_REGION_ID_ATF		1	/* ccci_platform.c:82 */
+#define MPU_REGION_ID_MD1_SEC_SMEM	3	/* ccci_platform.c:84 */
+#define MPU_REGION_ID_MD2_SEC_SMEM	4	/* ccci_platform.c:85 */
+#define MPU_REGION_ID_MD1_ROM		5	/* ccci_platform.c:86 */
+#define MPU_REGION_ID_MD1_DSP		6	/* ccci_platform.c:87 */
+#define MPU_REGION_ID_MD2_ROM		7	/* ccci_platform.c:88 */
+#define MPU_REGION_ID_MD2_RW		8	/* ccci_platform.c:89 */
+#define MPU_REGION_ID_MD1_SMEM		9	/* ccci_platform.c:90 */
+/* MD2 and MD3 share ids and BANK registers (ccci_platform.c:91-94,143-148) */
+#define MPU_REGION_ID_MD3_ROM		7	/* ccci_platform.c:92 */
+#define MPU_REGION_ID_MD3_RW		8	/* ccci_platform.c:93 */
+#define MPU_REGION_ID_MD3_SMEM		10	/* ccci_platform.c:94 */
+#define MPU_REGION_ID_MD1_RW		14	/* ccci_platform.c:97 */
+#define MPU_REGION_ID_AP		15	/* ccci_platform.c:98 */
+
+/* mt6735/ccci_platform.c:101-102 */
+#define MPU_PERM_CLEAR \
+	SET_ACCESS_PERMISSON(MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION)
+
+/* mt6735/ccci_platform.c:103-104: MD1 may read the AP region while booting.
+ * Value 0x20; ROM ccci_set_mem_access_protection @ 0xc052fc70: mov lr, #32.
+ */
+#define MPU_PERM_AP_MD1_RO \
+	SET_ACCESS_PERMISSON(MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_SEC_R_NSEC_R, MPU_NO_PROTECTION)
+
+/* mt6735/ccci_platform.c:105-106.  Value 0x0A28B68;
+ * ROM ccci_set_ap_region_protection @ 0xc052f830/0xc052f834:
+ * movw r12, #0x8b68 / movt r12, #0xa2.
+ */
+#define MPU_PERM_AP \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_NO_PROTECTION, \
+			     MPU_FORBIDDEN, MPU_NO_PROTECTION, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_NO_PROTECTION)
+
+/* mt6735/ccci_platform.c:107-116.  MD1_ROM is 0xB6DB64 and MD1_RW 0xB6DB45
+ * in the ROM (ccci_set_mem_access_protection @ 0xc052fcb0..0xc052fcd0:
+ * movw/movt r10 = 0xdb64/0xb6, r7 = 0xdb45/0xb6, r8 = 0xdb40/0xb6).
+ */
+#define MPU_PERM_MD1_ROM \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_SEC_R_NSEC_R, MPU_SEC_R_NSEC_R)
+#define MPU_PERM_MD1_RW \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_NO_PROTECTION, MPU_FORBIDDEN)
+#define MPU_PERM_MD1_SMEM \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION)
+/* ccci_platform.c:113-114; also 0xB6DB64, ROM ccci_set_dsp_region_protection
+ * @ 0xc052f938/0xc052f950 (movw r0, #0xdb64 / movt r0, #0xb6)
+ */
+#define MPU_PERM_MD1_DSP \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_SEC_R_NSEC_R, MPU_SEC_R_NSEC_R)
+/* ccci_platform.c:115-116; 0xB6DB45, ROM 0xc052f940/0xc052f954
+ * (movw r3, #0xdb45 / movt r3, #0xb6)
+ */
+#define MPU_PERM_MD1_DSP_CL \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_NO_PROTECTION, MPU_FORBIDDEN)
+
+/* mt6735/ccci_platform.c:118-123; 0xB45B6C / 0xB45B6C / 0xB45B68 in the ROM
+ * (ccci_set_mem_access_protection @ 0xc052fabc..0xc052fad0:
+ * movw/movt r7 = 0x5b6c/0xb4, r8 = 0x5b68/0xb4).
+ */
+#define MPU_PERM_MD3_ROM \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_NO_PROTECTION, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_SEC_R_NSEC_R)
+#define MPU_PERM_MD3_RW \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_NO_PROTECTION, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_SEC_R_NSEC_R)
+#define MPU_PERM_MD3_SMEM \
+	SET_ACCESS_PERMISSON(MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_NO_PROTECTION, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_FORBIDDEN, \
+			     MPU_FORBIDDEN, MPU_NO_PROTECTION)
+
+/* RMPU windows, mt6735/ccci_platform.c:130-148 (offsets into INFRA_AO) */
+#define MD1_BANK0_MAP0		0x300
+#define MD1_BANK0_MAP1		0x304
+#define MD1_BANK4_MAP0		0x308
+#define MD1_BANK4_MAP1		0x30C
+#define MD2_BANK0_MAP0		0x310
+#define MD2_BANK0_MAP1		0x314
+#define MD2_BANK4_MAP0		0x318
+#define MD2_BANK4_MAP1		0x31C
+/* MD3 uses the same registers as MD2 (ccci_platform.c:143-148) */
+#define MD3_BANK0_MAP0		MD2_BANK0_MAP0
+#define MD3_BANK0_MAP1		MD2_BANK0_MAP1
+#define MD3_BANK4_MAP0		MD2_BANK4_MAP0
+#define MD3_BANK4_MAP1		MD2_BANK4_MAP1
+
+/* mt6735/ccci_platform.h:22 */
+#define KERN_EMI_BASE		0x40000000UL	/* Bank4 */
+/*
+ * RMPU slot stride.  Every slot of a BANKn_MAPx word covers one 32 MiB
+ * window; the constant is the literal 0x2000000 used by
+ * ccci_platform.c:497-504 (MD1), 512-519 (MD2 smem), 583-590 (MD2 rom).
+ */
+#define MD_REMAP_SLOT_SIZE	0x02000000UL
+
+/*
+ * Program one MPU region.  The permission word carries the region id in
+ * bits 27..30 exactly like emi_mpu_set_region_protection() (emi_mpu.c:1144).
+ * Returns 0 or the SIP status code (SIP_SVC_E_*, mt_secure_api.h:22-26).
+ *
+ * On MT6735/MT6737T the MPU registers live in the secure EMI block: the only
+ * kernel-side accessor downstream is mt_emi_mpu_set_region_protection() ->
+ * mt_secure_call(MTK_SIP_KERNEL_EMIMPU_SET) (emi_reg_rw.c:74-82), compiled
+ * for CONFIG_ARM_PSCI/CONFIG_MTK_PSCI; without such a conduit downstream
+ * returns 0 without touching hardware (emi_reg_rw.c:81).  There is no
+ * non-secure register path for the MT6735 MPU regions, so we do not invent
+ * one: a missing conduit is reported as an error instead of faking success.
+ */
+static int ccci_mpu_set_region(struct ccci_md *md, phys_addr_t start,
+			       phys_addr_t end, unsigned int region,
+			       u32 permission)
+{
+	struct arm_smccc_res res;
+	u32 perm;
+
+	if (!md->mpu_smc) {
+		ccci_md_err(md,
+			    "no EL3/ATF SMC conduit, EMI MPU region %u not programmed\n",
+			    region);
+		return -ENODEV;
+	}
+	if ((start >> 32) || (end >> 32)) {
+		ccci_md_err(md, "MPU region %u outside 32-bit space (%pa-%pa)\n",
+			    region, &start, &end);
+		return -ERANGE;
+	}
+
+	perm = (permission & 0xFFFFFF) | ((region & 0xF) << 27);
+	memset(&res, 0, sizeof(res));
+	arm_smccc_smc(MTK_SIP_KERNEL_EMIMPU_SET, (u32)start, (u32)end, perm,
+		      0, 0, 0, 0, &res);
+	return (int)res.a0;
+}
+
+static int ccci_mpu_program(struct ccci_md *md, const char *name,
+			    phys_addr_t start, phys_addr_t end,
+			    unsigned int region, u32 permission)
+{
+	int ret;
+
+	ret = ccci_mpu_set_region(md, start, end, region, permission);
+	if (ret)
+		ccci_md_err(md,
+			    "MPU %s region %u [0x%08llx-0x%08llx] perm 0x%08x failed: %d\n",
+			    name, region, (unsigned long long)start,
+			    (unsigned long long)end, permission, ret);
+	else
+		ccci_md_info(md,
+			     "MPU %s region %u [0x%08llx-0x%08llx] perm 0x%08x\n",
+			     name, region, (unsigned long long)start,
+			     (unsigned long long)end, permission);
+	return ret;
+}
+
+/*
+ * End address rounding used by the whole downstream CCCI MPU code:
+ *   end = ((start + size + 0xFFFF) & ~0xFFFF) - 1
+ * (ccci_platform.c:272, 391-392, 398; EMI MPU granule is 64 KiB,
+ * mach/emi_mpu.h:96-97.  ROM: ccci_set_mem_access_protection @ 0xc052fb34
+ * ..0xc052fb5c and ccci_set_dsp_region_protection @ 0xc052f93c..0xc052f96c.)
+ */
+static phys_addr_t ccci_mpu_region_end(phys_addr_t start, size_t size)
+{
+	return ((start + size + 0xFFFF) & ~(phys_addr_t)0xFFFF) - 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* image security state                                                */
+/* ------------------------------------------------------------------ */
+/*
+ * ROM ccci_init_security() (0xc0501e54) calls printk() once and returns 0
+ * ("mov r0, #0" at 0xc0501e6c); the downstream source
+ * (ccci_util/ccci_util_lib_load_img.c:934-942) does the same.
+ * ENABLE_MD_IMG_SECURITY_FEATURE only selects the text, and the ROM build
+ * had it on: vmlinux.strings:37195 "[ccci0/util]security is on!".
+ *
+ * No signature, hash or cipher verification runs in the kernel: the ROM
+ * ccci_load_firmware() only does request_firmware(), the check-header parse
+ * and the image copy.  The modem image is authenticated by LK/ATF/the MD
+ * boot ROM, and the kernel holds no data that would let it claim otherwise.
+ * Report the parsed header state and return the downstream status code (0)
+ * instead of fabricating a check.
+ */
+int ccci_init_security(struct ccci_md *md)
+{
+	struct ccci_boot *boot = &md->boot;
+
+	if (boot->fw_valid)
+		ccci_md_info(md,
+			     "security is on! (hdr v%u, image type %u, product %u, platform %s, build %s)\n",
+			     boot->hdr_verno, boot->image_type,
+			     boot->product_ver, boot->md_platform,
+			     boot->build_ver);
+	else
+		ccci_md_info(md,
+			     "security is on! (modem image header not parsed yet)\n");
+	ccci_md_info(md,
+		     "security: image authentication is not performed by the kernel (LK/ATF/MD boot ROM)\n");
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* DSP region (optional)                                               */
+/* ------------------------------------------------------------------ */
+/*
+ * The DSP sub-image lives inside the modem image at dsp_img_offset for
+ * dsp_img_size bytes (check header v3+, ccci_util_lib_load_img.c:238-253 and
+ * 454-468: dsp_offset+dsp_size must fit into the image, 0xCDCDCDAA means "no
+ * DSP on EMI").  downstream md_cd_start() (modem_cldma.c:2270-2286) then
+ * points mem_layout.dsp_region_phy at img.address + dsp_offset.
+ *
+ * The region only exists after a successful image load, which is why
+ * fw_valid is required (downstream tests mem_layout.dsp_region_phy != 0).
+ */
+static bool ccci_mpu_dsp_region(struct ccci_md *md, phys_addr_t *phy,
+				size_t *size)
+{
+	u32 off = md->boot.dsp_offset;
+	u32 len = md->boot.dsp_size;
+
+	if (!md->boot.fw_valid || !md->img_present || !off || !len)
+		return false;
+	if (off >= md->img_size || len > md->img_size - off) {
+		ccci_md_err(md, "DSP image 0x%x+0x%x outside MD region 0x%zx\n",
+			    off, len, md->img_size);
+		return false;
+	}
+	*phy = md->img_phy + off;
+	*size = len;
+	return true;
+}
+
+/*
+ * Resolve the MPU backend.  Downstream enables the EMI MPU SMC path for
+ * CONFIG_ARM_PSCI (emi_reg_rw.c:78-79), so the requirement is an EL3 monitor
+ * reachable over SMC.  The MT6735 DTS declares it as
+ *   psci { compatible = "arm,psci"; method = "smc"; };
+ * (arch/arm64/boot/dts/mediatek/mt6735.dtsi:34-40); a PSCI node whose method
+ * is "hvc" (a guest) has no SMC conduit and is rejected.
+ *
+ * The RMPU side (ccci_mpu_set_mem_remap) needs no monitor: its registers are
+ * in the non-secure INFRA_AO window and are written directly, exactly like
+ * downstream (ccci_plat_common_init() of_iomap("mediatek,INFRACFG_AO"),
+ * ccci_platform.c:748-757).
+ */
+static bool ccci_mpu_has_smc_conduit(void)
+{
+	static const char *const compat[] = {
+		"arm,psci", "arm,psci-0.2", "arm,psci-1.0",
+	};
+	struct device_node *np = NULL;
+	const char *method;
+	bool ok = false;
+	int i;
+
+	if (!IS_ENABLED(CONFIG_HAVE_ARM_SMCCC))
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(compat) && !np; i++)
+		np = of_find_compatible_node(NULL, NULL, compat[i]);
+	if (!np)
+		return false;
+	if (!of_property_read_string(np, "method", &method))
+		ok = !strcmp(method, "smc");
+	of_node_put(np);
+	return ok;
+}
+
+int ccci_mpu_init(struct ccci_md *md)
+{
+	md->mpu_smc = ccci_mpu_has_smc_conduit();
+	md->dsp_phy = 0;
+	md->dsp_size = 0;
+	ccci_md_info(md, "EMI MPU backend: %s\n",
+		     md->mpu_smc ? "ATF SMC (PSCI/EL3)" :
+				   "none (no EL3 conduit)");
+	return 0;
+}
+
+/*
+ * Program the MD1_DSP region; @loaded selects the DSP-image attribute
+ * (downstream ccci_set_dsp_region_protection(), ccci_platform.c:251-325).
+ * The region comes from the dsp_img_offset/dsp_img_size fields of the parsed
+ * image header, which is what downstream derives mem_layout.dsp_region_phy
+ * from.  Returns 0 when the image carries no DSP sub-image (the
+ * MT6735/MT6737T case, and the frozen RPC contract for op 0x400B).
+ */
+int ccci_mpu_dsp_protection(struct ccci_md *md, bool loaded)
+{
+	phys_addr_t phy;
+	size_t size;
+
+	if (md->id != CCCI_MD_SYS1) {
+		/* downstream ccci_set_dsp_region_protection() default case,
+		 * ccci_platform.c:266-268
+		 */
+		ccci_md_err(md, "DSP MPU protection is MD1-only\n");
+		return -EINVAL;
+	}
+	if (!ccci_mpu_dsp_region(md, &phy, &size)) {
+		/* The downstream caller only invokes this when
+		 * mem_layout.dsp_region_phy != 0 (modem_cldma.c:2320-2321),
+		 * so a missing DSP slot is a no-op, not an error.
+		 */
+		md->dsp_phy = 0;
+		md->dsp_size = 0;
+		ccci_md_info(md, "no DSP region, skip DSP MPU protection\n");
+		return 0;
+	}
+
+	md->dsp_phy = phy;
+	md->dsp_size = size;
+	return ccci_mpu_program(md, loaded ? "MD1_DSP(loaded)" : "MD1_DSP",
+				phy, ccci_mpu_region_end(phy, size),
+				MPU_REGION_ID_MD1_DSP,
+				loaded ? MPU_PERM_MD1_DSP_CL : MPU_PERM_MD1_DSP);
+}
+
+/*
+ * Frozen gap API (include/linux/ccci.h:313): called from the kernel RPC
+ * service for IPC_RPC_DSP_EMI_MPU_SETTING (op 0x400B, port_kernel.h:142;
+ * downstream handler port_kernel.c:1797-1826 calls
+ * ccci_set_dsp_region_protection(md, 1) when a DSP region exists).
+ * @md_id is the core's 0-based modem id (include/linux/ccci.h:23).
+ * Returns 0 when there is no DSP region.
+ */
+int ccci_md_set_dsp_mpu_protection(unsigned int md_id)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+
+	if (!md)
+		return -ENODEV;
+	return ccci_mpu_dsp_protection(md, true);
+}
+
+/* ------------------------------------------------------------------ */
+/* MD / AP EMI MPU regions                                             */
+/* ------------------------------------------------------------------ */
+/*
+ * Clear the MD ROM/RW regions and, for MD1, the DSP region.
+ * Downstream splits this over ccci_clear_md_region_protection()
+ * (ccci_platform.c:150-192, ROM 0xc052f3c4) and
+ * ccci_clear_dsp_region_protection() (ccci_platform.c:194-219, ROM
+ * 0xc052f684); md_cd_start() calls both back to back before loading the
+ * image (modem_cldma.c:2261-2263), so they are folded here.
+ *
+ * Both downstream functions start with a "modem_run_env_ready()" bypass for
+ * an image that LK already loaded and protected.  This driver always loads
+ * the image itself over request_firmware() (ccci_boot.c), so that state can
+ * never be true and the bypass is not reproduced.
+ */
+void ccci_mpu_clear_md_protection(struct ccci_md *md)
+{
+	unsigned int rom_id, rw_id;
+
+	switch (md->id) {
+	case CCCI_MD_SYS1:
+		rom_id = MPU_REGION_ID_MD1_ROM;
+		rw_id = MPU_REGION_ID_MD1_RW;
+		break;
+	case CCCI_MD_SYS2:
+		rom_id = MPU_REGION_ID_MD2_ROM;
+		rw_id = MPU_REGION_ID_MD2_RW;
+		break;
+	case CCCI_MD_SYS3:
+		rom_id = MPU_REGION_ID_MD3_ROM;
+		rw_id = MPU_REGION_ID_MD3_RW;
+		break;
+	default:
+		/* downstream ccci_clear_md_region_protection() default,
+		 * ccci_platform.c:175-179
+		 */
+		ccci_md_err(md, "invalid MD id for MPU clear\n");
+		return;
+	}
+
+	/* ccci_platform.c:181-190: start = end = 0 clears the region;
+	 * ROM 0xc052f478..0xc052f4d4 does the two calls with permission 0.
+	 */
+	ccci_mpu_program(md, "clear ROM", 0, 0, rom_id, MPU_PERM_CLEAR);
+	ccci_mpu_program(md, "clear RW", 0, 0, rw_id, MPU_PERM_CLEAR);
+
+	if (md->id == CCCI_MD_SYS1)
+		ccci_mpu_program(md, "clear DSP", 0, 0,
+				 MPU_REGION_ID_MD1_DSP, MPU_PERM_CLEAR);
+}
+
+/*
+ * Program the MD ROM/RW/SMEM regions plus the AP region as MD-read-only.
+ * Downstream ccci_set_mem_access_protection() (ccci_platform.c:327-432),
+ * ROM 0xc052fa48.  Region maths as in the ROM:
+ *
+ *   rom_end = ((md_region_phy + img_size + 0xFFFF) & ~0xFFFF) - 1
+ *   rw_start = rom_end + 1
+ *   rw_end   = md_region_phy + md_region_size - 1
+ *   smem_end = ((smem_phy + smem_size + 0xFFFF) & ~0xFFFF) - 1
+ *
+ * The rw_end expression comes from the ROM (0xc052fb84: "add lr, r9, r12"
+ * with r9 = md_region_phy and r12 = md_region_size, then 0xc052fbd0 uses
+ * that value as the region end).  The C source (ccci_platform.c:392-393)
+ * writes "rw_start + md_region_size - 1" instead; the shipped binary is
+ * authoritative and is followed here.
+ */
+int ccci_mpu_set_md_protection(struct ccci_md *md)
+{
+	phys_addr_t rom_end, rw_start, rw_end, ap_start;
+	size_t ap_size, img_size;
+	u32 rom_id, rw_id, shr_id;
+	u32 rom_perm, rw_perm, shr_perm;
+	int ret, first = 0;
+
+	if (!md->img_present || !md->img_vir) {
+		ccci_md_err(md, "no MD image region, skip MPU protection\n");
+		return -ENODEV;
+	}
+	if (!md->smem_vir) {
+		ccci_md_err(md, "no MD share memory, skip MPU protection\n");
+		return -ENODEV;
+	}
+
+	switch (md->id) {
+	case CCCI_MD_SYS1:
+		rom_id = MPU_REGION_ID_MD1_ROM;
+		rw_id = MPU_REGION_ID_MD1_RW;
+		shr_id = MPU_REGION_ID_MD1_SMEM;
+		rom_perm = MPU_PERM_MD1_ROM;
+		rw_perm = MPU_PERM_MD1_RW;
+		shr_perm = MPU_PERM_MD1_SMEM;
+		break;
+	case CCCI_MD_SYS3:
+		rom_id = MPU_REGION_ID_MD3_ROM;
+		rw_id = MPU_REGION_ID_MD3_RW;
+		shr_id = MPU_REGION_ID_MD3_SMEM;
+		rom_perm = MPU_PERM_MD3_ROM;
+		rw_perm = MPU_PERM_MD3_RW;
+		shr_perm = MPU_PERM_MD3_SMEM;
+		break;
+	default:
+		/* downstream ccci_set_mem_access_protection() only handles
+		 * MD_SYS1 and MD_SYS3 (ccci_platform.c:345-371); do not guess
+		 * region ids for MD2/MD4/MD5.
+		 */
+		ccci_md_err(md, "invalid MD id for MPU protection\n");
+		return -EINVAL;
+	}
+
+	/* img_info[IMG_MD].size in downstream terms: what was actually copied
+	 * into the reserved image region.
+	 */
+	img_size = md->boot.loaded_size;
+	if (!img_size)
+		img_size = md->boot.md_img_size;
+	if (!img_size)
+		img_size = md->img_size;
+	if (img_size > md->img_size) {
+		ccci_md_err(md, "image size 0x%zx exceeds region 0x%zx\n",
+			    img_size, md->img_size);
+		return -EINVAL;
+	}
+	rom_end = ccci_mpu_region_end(md->img_phy, img_size);
+	rw_start = rom_end + 1;
+	rw_end = md->img_phy + md->img_size - 1;
+	if (rw_end <= rom_end) {
+		ccci_md_err(md, "MD region 0x%zx too small for image 0x%zx\n",
+			    md->img_size, img_size);
+		return -ERANGE;
+	}
+
+	/*
+	 * While booting the modem may read AP memory, so the AP region is only
+	 * MD-read-only here (ccci_platform.c:373-381, 426-430); it is
+	 * re-protected by ccci_mpu_set_ap_region_protection() right before the
+	 * runtime handshake.  The AP window is [PHYS_OFFSET, PHYS_OFFSET + DRAM
+	 * size) downstream (get_phys_offset()/get_max_DRAM_size(),
+	 * ccci_platform.c:373-381); memblock mirrors both on this tree.
+	 */
+	ap_start = memblock_start_of_DRAM();
+	ap_size = memblock_end_of_DRAM() - ap_start;
+	if (!ap_size) {
+		ccci_md_err(md, "no DRAM, skip AP region protection\n");
+		return -ENODEV;
+	}
+
+	/* Downstream ignores the SMC status and programs all four regions;
+	 * keep that behaviour but report the first failure.
+	 */
+	ret = ccci_mpu_program(md, "MD ROM", md->img_phy, rom_end, rom_id,
+			       rom_perm);
+	if (ret && !first)
+		first = ret;
+	ret = ccci_mpu_program(md, "MD RW", rw_start, rw_end, rw_id, rw_perm);
+	if (ret && !first)
+		first = ret;
+	ret = ccci_mpu_program(md, "MD SMEM", md->smem_phy,
+			       ccci_mpu_region_end(md->smem_phy,
+						   md->smem_size),
+			       shr_id, shr_perm);
+	if (ret && !first)
+		first = ret;
+	ret = ccci_mpu_program(md, "AP", ap_start, ap_start + ap_size - 1,
+			       MPU_REGION_ID_AP, MPU_PERM_AP_MD1_RO);
+	if (ret && !first)
+		first = ret;
+
+	return first;
+}
+
+/*
+ * Re-protect the whole AP DRAM window as MD-forbidden.
+ * Downstream ccci_set_ap_region_protection() (ccci_platform.c:221-249, ROM
+ * 0xc052f7cc): [kernel_base, kernel_base + dram_size - 1], region 15,
+ * permission MPU_ACCESS_PERMISSON_AP_ATTR (0x0A28B68).  Called right before
+ * the runtime data is sent (modem_cldma.c:3226 and 3275), when the modem no
+ * longer needs to read AP memory.
+ */
+int ccci_mpu_set_ap_region_protection(struct ccci_md *md)
+{
+	phys_addr_t start = memblock_start_of_DRAM();
+	size_t size = memblock_end_of_DRAM() - start;
+
+	if (!size) {
+		ccci_md_err(md, "no DRAM, skip AP region protection\n");
+		return -ENODEV;
+	}
+	return ccci_mpu_program(md, "AP", start, start + size - 1,
+				MPU_REGION_ID_AP, MPU_PERM_AP);
+}
+
+/* ------------------------------------------------------------------ */
+/* RMPU memory remap windows                                           */
+/* ------------------------------------------------------------------ */
+/*
+ * Each 32-bit BANKn_MAPx register holds four remap slots; a slot is one byte
+ * carrying bits 31..24 of the 32 MiB-aligned target address, with bit 0 of
+ * the byte as the "slot valid" flag.  The packing below is a literal
+ * transcription of ccci_platform.c:497-504 (and of the ROM, e.g.
+ * 0xc0530160-0xc05301c4 for the MD2/MD3 share-memory window).
+ */
+static u32 ccci_mpu_pack0(u32 addr) /* byte 0: addr[31:24] */
+{
+	return ((addr >> 24) | 0x1) & 0xFF;
+}
+
+static u32 ccci_mpu_pack1(u32 addr) /* byte 1: addr[31:24] << 8 */
+{
+	return (((addr >> 16) | (1 << 8)) & 0xFF00);
+}
+
+static u32 ccci_mpu_pack2(u32 addr) /* byte 2: addr[31:24] << 16 */
+{
+	return (((addr >> 8) | (1 << 16)) & 0xFF0000);
+}
+
+static u32 ccci_mpu_pack3(u32 addr) /* byte 3: addr[31:24] << 24 */
+{
+	return (((addr >> 0) | (1 << 24)) & 0xFF000000);
+}
+
+/* MD1 share-memory/ROM window: 8 consecutive 32 MiB slots from @des
+ * (ccci_platform.c:496-509, 567-580; ROM 0xc053028c-0xc0530330 for BANK4 and
+ * 0xc05305c4-0xc0530660 for BANK0).
+ */
+static void ccci_mpu_md1_words(u32 des, u32 *w0, u32 *w1)
+{
+	*w0 = ccci_mpu_pack0(des) +
+	      ccci_mpu_pack1(des + MD_REMAP_SLOT_SIZE * 1) +
+	      ccci_mpu_pack2(des + MD_REMAP_SLOT_SIZE * 2) +
+	      ccci_mpu_pack3(des + MD_REMAP_SLOT_SIZE * 3);
+	*w1 = ccci_mpu_pack0(des + MD_REMAP_SLOT_SIZE * 4) +
+	      ccci_mpu_pack1(des + MD_REMAP_SLOT_SIZE * 5) +
+	      ccci_mpu_pack2(des + MD_REMAP_SLOT_SIZE * 6) +
+	      ccci_mpu_pack3(des + MD_REMAP_SLOT_SIZE * 7);
+}
+
+/* MD2/MD3 share-memory window: slot 0 is the smem, the rest is invalid
+ * memory (ccci_platform.c:511-539).
+ */
+static void ccci_mpu_md2md3_smem_words(u32 des, u32 invalid, u32 *w0, u32 *w1)
+{
+	*w0 = ccci_mpu_pack0(des) +
+	      ccci_mpu_pack1(invalid + MD_REMAP_SLOT_SIZE * 0) +
+	      ccci_mpu_pack2(invalid + MD_REMAP_SLOT_SIZE * 1) +
+	      ccci_mpu_pack3(invalid + MD_REMAP_SLOT_SIZE * 2);
+	*w1 = ccci_mpu_pack0(invalid + MD_REMAP_SLOT_SIZE * 3) +
+	      ccci_mpu_pack1(invalid + MD_REMAP_SLOT_SIZE * 4) +
+	      ccci_mpu_pack2(invalid + MD_REMAP_SLOT_SIZE * 5) +
+	      ccci_mpu_pack3(invalid + MD_REMAP_SLOT_SIZE * 6);
+}
+
+/* MD2/MD3 image window: 3 image slots, the rest is invalid memory
+ * (ccci_platform.c:582-618).
+ */
+static void ccci_mpu_md2md3_rom_words(u32 des, u32 invalid, u32 *w0, u32 *w1)
+{
+	*w0 = ccci_mpu_pack0(des) +
+	      ccci_mpu_pack1(des + MD_REMAP_SLOT_SIZE * 1) +
+	      ccci_mpu_pack2(des + MD_REMAP_SLOT_SIZE * 2) +
+	      ccci_mpu_pack3(invalid + MD_REMAP_SLOT_SIZE * 7);
+	*w1 = ccci_mpu_pack0(invalid + MD_REMAP_SLOT_SIZE * 8) +
+	      ccci_mpu_pack1(invalid + MD_REMAP_SLOT_SIZE * 9) +
+	      ccci_mpu_pack2(invalid + MD_REMAP_SLOT_SIZE * 10) +
+	      ccci_mpu_pack3(invalid + MD_REMAP_SLOT_SIZE * 11);
+}
+
+static void ccci_mpu_write_window(struct ccci_md *md, u32 reg, u32 val)
+{
+	/* downstream mt_reg_sync_writel(): write + mb() (sync_write.h) */
+	writel(val, md->infra_ao + reg);
+	mb();
+}
+
+/*
+ * Program the MD1/MD2/MD3 BANK0 and BANK4 remap windows and publish the
+ * AP->MD share-memory offset, as downstream ccci_set_mem_remap()
+ * (ccci_platform.c:622-649, ROM 0xc05306cc) does:
+ *
+ *   remainder   = smem_offset % 32 MiB
+ *   smem_offset_AP_to_MD = smem_region_phy - (remainder + KERN_EMI_BASE)
+ *   des_smem    = md_region_phy + smem_offset - remainder (- KERN_EMI_BASE)
+ *   des_rom     = md_region_phy                             (- KERN_EMI_BASE)
+ *   invalid     = ALIGN(md_region_phy + md_region_size + smem_region_size,
+ *                       32 MiB) - KERN_EMI_BASE
+ *
+ * with smem_offset = smem_region_phy - md_region_phy (downstream caller
+ * ccci_core.c:311).  The "- KERN_EMI_BASE" branches are the non-4G path:
+ * downstream only takes the other one with FEATURE_USING_4G_MEMORY_API,
+ * which requires CONFIG_MTK_LM_MODE (ccci_config.h:49-51) and that is off in
+ * arch/arm/configs/grandpplte_00_defconfig:1261.
+ *
+ * ROM proof of the published offset and of the argument order:
+ *   0xc05306e4  bic   r2, r1, #0xFE000000      r2 = remainder
+ *   0xc05306e8  add   r1, r1, r3               r1 = smem_offset + md_phy
+ *   0xc05306f0  add   r12, r12, #-0x40000000   smem_phy - KERN_EMI_BASE
+ *   0xc05306f8  rsb   r12, r2, r12             - remainder
+ *   0xc0530700  str   r12, [r0, #0x814]        smem_offset_AP_to_MD
+ *   0xc05306fc  rsb   r2, r2, r1               des_smem
+ *   0xc0530704  mov   r1, #0x40000000          src
+ *   0xc053070c  bl    set_md_smem_remap
+ *   0xc0530740  ldr   r2, [r4, #0x7f4]         des_rom = md_region_phy
+ *   0xc0530744  mov   r1, #0               0    src
+ *   0xc0530748  bl    set_md_rom_rw_mem_remap
+ */
+int ccci_mpu_set_mem_remap(struct ccci_md *md)
+{
+	phys_addr_t layout_end, off;
+	unsigned long smem_offset, remainder;
+	u32 invalid, smem_des, img_des, w0, w1;
+
+	/* publish "no remap" until the windows are actually written */
+	md->smem_offset_ap_to_md = 0;
+	if (!md->infra_ao) {
+		ccci_md_err(md, "no INFRA_AO window, skip memory remap\n");
+		return -ENODEV;
+	}
+	if (!md->img_present || !md->smem_vir) {
+		ccci_md_err(md, "no image/smem region, skip memory remap\n");
+		return -ENODEV;
+	}
+	if (md->smem_phy < md->img_phy) {
+		ccci_md_err(md, "smem %pa below image %pa\n", &md->smem_phy,
+			    &md->img_phy);
+		return -EINVAL;
+	}
+	if (md->img_phy < KERN_EMI_BASE) {
+		ccci_md_err(md, "image %pa below KERN_EMI_BASE\n", &md->img_phy);
+		return -EINVAL;
+	}
+
+	smem_offset = md->smem_phy - md->img_phy;
+	remainder = smem_offset % MD_REMAP_SLOT_SIZE;
+	layout_end = md->img_phy + md->img_size + md->smem_size;
+	off = md->smem_phy - remainder - KERN_EMI_BASE;
+	if ((layout_end >> 32) ||
+	    ALIGN(layout_end, MD_REMAP_SLOT_SIZE) <= KERN_EMI_BASE ||
+	    (off >> 32)) {
+		ccci_md_err(md, "cannot build MD view for layout 0x%llx\n",
+			    (unsigned long long)layout_end);
+		return -ERANGE;
+	}
+
+	invalid = (u32)(ALIGN(layout_end, MD_REMAP_SLOT_SIZE) - KERN_EMI_BASE);
+	smem_des = (u32)off;
+	img_des = (u32)(md->img_phy - KERN_EMI_BASE);
+
+	switch (md->id) {
+	case CCCI_MD_SYS1:
+		ccci_mpu_md1_words(smem_des, &w0, &w1);
+		ccci_mpu_write_window(md, MD1_BANK4_MAP0, w0);
+		ccci_mpu_write_window(md, MD1_BANK4_MAP1, w1);
+
+		ccci_mpu_md1_words(img_des, &w0, &w1);
+		ccci_mpu_write_window(md, MD1_BANK0_MAP0, w0);
+		ccci_mpu_write_window(md, MD1_BANK0_MAP1, w1);
+		break;
+	case CCCI_MD_SYS2:
+		ccci_mpu_md2md3_smem_words(smem_des, invalid, &w0, &w1);
+		ccci_mpu_write_window(md, MD2_BANK4_MAP0, w0);
+		ccci_mpu_write_window(md, MD2_BANK4_MAP1, w1);
+
+		ccci_mpu_md2md3_rom_words(img_des, invalid, &w0, &w1);
+		ccci_mpu_write_window(md, MD2_BANK0_MAP0, w0);
+		ccci_mpu_write_window(md, MD2_BANK0_MAP1, w1);
+		break;
+	case CCCI_MD_SYS3:
+		ccci_mpu_md2md3_smem_words(smem_des, invalid, &w0, &w1);
+		ccci_mpu_write_window(md, MD3_BANK4_MAP0, w0);
+		ccci_mpu_write_window(md, MD3_BANK4_MAP1, w1);
+
+		ccci_mpu_md2md3_rom_words(img_des, invalid, &w0, &w1);
+		ccci_mpu_write_window(md, MD3_BANK0_MAP0, w0);
+		ccci_mpu_write_window(md, MD3_BANK0_MAP1, w1);
+		break;
+	default:
+		ccci_md_err(md, "invalid MD id for memory remap\n");
+		return -EINVAL;
+	}
+	mb();
+
+	md->smem_offset_ap_to_md = (u32)off;
+	ccci_md_info(md,
+		     "remap smem_offset 0x%lx remainder 0x%lx AP->MD 0x%x invalid 0x%08x\n",
+		     smem_offset, remainder, md->smem_offset_ap_to_md, invalid);
+	return 0;
+}
+
+/*
+ * Convert an AP-view physical address into the modem's view, i.e. subtract
+ * mem_layout.smem_offset_AP_to_MD (downstream
+ * modem_cldma.c:3201, 3205, 3319-3327, 3410).  Returns @addr unchanged when
+ * no remap was programmed or when the offset would underflow, so a caller
+ * never publishes a wrapped address.
+ */
+u32 ccci_mpu_ap_to_md(struct ccci_md *md, phys_addr_t addr)
+{
+	phys_addr_t off = md->smem_offset_ap_to_md;
+
+	if (!off)
+		return (u32)addr;
+	if (off > addr) {
+		ccci_md_err(md, "AP->MD offset 0x%llx above 0x%llx, keep AP view\n",
+			    (unsigned long long)off,
+			    (unsigned long long)addr);
+		return (u32)addr;
+	}
+	return (u32)(addr - off);
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_mpu.h b/drivers/misc/mediatek/ccci/ccci_mpu.h
new file mode 100644
index 000000000..3f7371f2d
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_mpu.h
@@ -0,0 +1,69 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MT6735/MT6737T modem memory protection: EMI MPU (programmed through ATF
+ * SMC), RMPU (MD memory remap windows) and the modem image-security state.
+ *
+ * The public entry point used by other CCCI users, ccci_md_set_dsp_mpu_protection(),
+ * is declared in include/linux/ccci.h (frozen gap API); everything else here is
+ * private to drivers/misc/mediatek/ccci.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/eccci/mt6735/ccci_platform.c
+ *   drivers/misc/mediatek/include/mt-plat/mt6735/include/mach/emi_mpu.h
+ *   drivers/misc/mediatek/include/mt-plat/mt6735/include/mach/mt_secure_api.h
+ *   drivers/misc/mediatek/ccci_util/ccci_util_lib_load_img.c
+ *
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#ifndef __CCCI_MPU_H__
+#define __CCCI_MPU_H__
+
+#include <linux/types.h>
+
+struct ccci_md;
+
+/* Resolve the MPU backend (EL3/ATF SMC conduit) and reset the DSP region.
+ * Called once from ccci_md_register(), i.e. before the INFRA_AO-dependent
+ * paths can run and before any ccci_md_start().
+ */
+int ccci_mpu_init(struct ccci_md *md);
+
+/* Clear the MD ROM/RW regions and, for MD1, the DSP region: downstream
+ * ccci_clear_md_region_protection() + ccci_clear_dsp_region_protection().
+ */
+void ccci_mpu_clear_md_protection(struct ccci_md *md);
+
+/* Program the MD ROM/RW/SMEM regions plus the AP region as MD-read-only.
+ * Must run after the image is in DRAM and before the modem is released
+ * (downstream md_cd_start() step 3).
+ */
+int ccci_mpu_set_md_protection(struct ccci_md *md);
+
+/* Program the MD1_DSP region from the image header's DSP slot; @loaded
+ * selects the post-DSP-load attribute.  Returns 0 when the image has no DSP
+ * sub-image (the MT6735/MT6737T case).
+ */
+int ccci_mpu_dsp_protection(struct ccci_md *md, bool loaded);
+
+/* Re-protect the whole AP DRAM window as MD-forbidden; called right before
+ * runtime data is sent (downstream ccci_set_ap_region_protection()).
+ */
+int ccci_mpu_set_ap_region_protection(struct ccci_md *md);
+
+/* Program the RMPU BANK0/BANK4 windows and publish the AP->MD shared-memory
+ * offset in md->smem_offset_ap_to_md (0 when nothing was programmed).
+ */
+int ccci_mpu_set_mem_remap(struct ccci_md *md);
+
+/* Convert an AP-view address to the modem's view using
+ * md->smem_offset_ap_to_md (no-op before the remap windows are programmed).
+ */
+u32 ccci_mpu_ap_to_md(struct ccci_md *md, phys_addr_t addr);
+
+/* Report the modem image-security state (ROM ccci_init_security()).
+ * Downstream returns 0 unconditionally; the kernel performs no image
+ * authentication, LK/ATF/the MD boot ROM do.
+ */
+int ccci_init_security(struct ccci_md *md);
+
+#endif /* __CCCI_MPU_H__ */
diff --git a/drivers/misc/mediatek/ccci/ccci_platform.c b/drivers/misc/mediatek/ccci/ccci_platform.c
new file mode 100644
index 000000000..b3e7f75b8
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_platform.c
@@ -0,0 +1,368 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI platform driver for the MT6735/MT6737T mdcldma block.
+ *
+ * DT node (downstream arch/arm64/boot/dts/mt6735.dtsi, node
+ * "mdcldma@1000A000"): reg order AP_CLDMA_AO, MD_CLDMA_AO, AP_CLDMA_PDN,
+ * MD_CLDMA_PDN, AP_CCIF, MD_CCIF; interrupts CLDMA, CCIF, MDWDT.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/mt6735/cldma_platform.c and
+ * drivers/misc/mediatek/eccci/modem_cldma.c (probe/remove/PM).
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#include <linux/ccci.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_MD1_RES_NAME	"md1"
+
+/* Downstream mt6735/modem_reg_base.h: MD1 boot slave + RGU. */
+#define CCCI_MD1_BOOT_VECTOR	0x20190000
+#define CCCI_MD1_BOOT_VECTOR_KEY 0x2019379C
+#define CCCI_MD1_BOOT_VECTOR_EN	0x20195488
+#define CCCI_MD1_RGU_BASE	0x20050000
+
+struct ccci_plat {
+	struct ccci_md *md;
+	struct ccci_ccif *ccif;
+	struct ccci_cldma *cldma;
+	struct clk *clk;
+	void __iomem *cldma_ao;
+	void __iomem *cldma_pdn;
+	void __iomem *ccif_ap;
+	unsigned int cldma_irq;
+	unsigned int md_wdt_irq;
+};
+
+static int ccci_plat_parse_dt(struct platform_device *pdev,
+			      struct ccci_md_cfg *cfg, phys_addr_t *rgu,
+			      phys_addr_t *bv, phys_addr_t *bv_key,
+			      phys_addr_t *bv_en)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct resource *res;
+	const char *fw;
+	u32 val;
+	int nreg = 0, ret;
+
+	ret = of_property_read_u32(np, "mediatek,md_id", &val);
+	if (ret)
+		val = 0;
+	if (val >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+
+	cfg->md_id = val;
+	cfg->name = CCCI_MD1_RES_NAME;
+	cfg->irat_md_id = CCCI_MAX_MD_NUM;
+
+	if (!of_property_read_string(np, "firmware-name", &fw))
+		cfg->firmware_name = fw;
+	else
+		cfg->firmware_name = "md1img";
+
+	if (!of_property_read_u32(np, "mediatek,cldma_capability", &val))
+		cfg->capability = val;
+
+	/* boot slave / RGU addresses: DT overrides, otherwise the fixed MT6735
+	 * values from downstream mt6735/modem_reg_base.h
+	 */
+	*bv = CCCI_MD1_BOOT_VECTOR;
+	*bv_key = CCCI_MD1_BOOT_VECTOR_KEY;
+	*bv_en = CCCI_MD1_BOOT_VECTOR_EN;
+	*rgu = CCCI_MD1_RGU_BASE;
+	of_property_read_u32(np, "mediatek,md-boot-vector", &val);
+	if (val)
+		*bv = val;
+	of_property_read_u32(np, "mediatek,md-boot-vector-key", &val);
+	if (val)
+		*bv_key = val;
+	of_property_read_u32(np, "mediatek,md-boot-vector-en", &val);
+	if (val)
+		*bv_en = val;
+	if (!of_property_read_u32(np, "mediatek,rgu-base", &val) && val)
+		*rgu = val;
+
+	while (platform_get_resource(pdev, IORESOURCE_MEM, nreg))
+		nreg++;
+
+	if (nreg < 2)
+		return -ENODEV;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, nreg >= 6 ? 4 : 0);
+	cfg->ccif_phys = res->start;
+	cfg->ccif_size = resource_size(res);
+
+	cfg->md_boot_vector_phys = *bv;
+	cfg->md_boot_vector_key_phys = *bv_key;
+	cfg->md_boot_vector_en_phys = *bv_en;
+	cfg->rgu_phys = *rgu;
+	cfg->sram_size = CCIF_SRAM_SIZE;
+
+	return 0;
+}
+
+static int ccci_plat_hw_get(struct platform_device *pdev, struct ccci_plat *pl,
+			    struct ccci_md_cfg *cfg, bool *has_cldma)
+{
+	int nreg = 0, irq;
+
+	while (platform_get_resource(pdev, IORESOURCE_MEM, nreg))
+		nreg++;
+
+	*has_cldma = nreg >= 6;
+	if (*has_cldma) {
+		pl->cldma_ao = devm_platform_ioremap_resource(pdev, 0);
+		if (IS_ERR(pl->cldma_ao))
+			return PTR_ERR(pl->cldma_ao);
+		/* MD side registers are mapped by the CLDMA engine owner; keep
+		 * only AP_CLDMA_PDN here for suspend/resume book-keeping.
+		 */
+		pl->cldma_pdn = devm_platform_ioremap_resource(pdev, 2);
+		if (IS_ERR(pl->cldma_pdn))
+			return PTR_ERR(pl->cldma_pdn);
+		pl->ccif_ap = devm_platform_ioremap_resource(pdev, 4);
+		if (IS_ERR(pl->ccif_ap))
+			return PTR_ERR(pl->ccif_ap);
+
+		pl->cldma_irq = platform_get_irq(pdev, 0);
+		cfg->ccif_irq = platform_get_irq(pdev, 1);
+	} else {
+		pl->ccif_ap = devm_platform_ioremap_resource(pdev, 0);
+		if (IS_ERR(pl->ccif_ap))
+			return PTR_ERR(pl->ccif_ap);
+		cfg->ccif_irq = platform_get_irq(pdev, 0);
+	}
+	irq = platform_get_irq_optional(pdev, *has_cldma ? 2 : 1);
+	pl->md_wdt_irq = irq > 0 ? irq : 0;
+
+	if ((int)cfg->ccif_irq < 0) {
+		dev_err(&pdev->dev, "no CCIF interrupt in DT\n");
+		return -ENODEV;
+	}
+	return 0;
+}
+
+static const struct of_device_id ccci_mdcldma_of_match[] = {
+	{ .compatible = "mediatek,mdcldma" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ccci_mdcldma_of_match);
+
+static int ccci_mdcldma_probe(struct platform_device *pdev)
+{
+	struct ccci_plat *pl;
+	struct ccci_md_cfg cfg = {};
+	struct ccci_cldma_cfg ccfg = {};
+	phys_addr_t rgu = 0, bv = 0, bv_key = 0, bv_en = 0;
+	struct device *dev = &pdev->dev;
+	void __iomem *md_ccif;
+	bool has_cldma = false;
+	int ret;
+
+	if (!dev->of_node) {
+		dev_err(dev, "missing DT node\n");
+		return -ENODEV;
+	}
+
+	pl = devm_kzalloc(dev, sizeof(*pl), GFP_KERNEL);
+	if (!pl)
+		return -ENOMEM;
+
+	ret = ccci_plat_parse_dt(pdev, &cfg, &rgu, &bv, &bv_key, &bv_en);
+	if (ret) {
+		dev_err(dev, "DT parse failed %d\n", ret);
+		return ret;
+	}
+
+	ret = ccci_plat_hw_get(pdev, pl, &cfg, &has_cldma);
+	if (ret) {
+		dev_err(dev, "resource mapping failed %d\n", ret);
+		return ret;
+	}
+
+	/* MD side CCIF view, used for register dumps only */
+	md_ccif = devm_platform_ioremap_resource(pdev, has_cldma ? 5 : 1);
+	if (IS_ERR(md_ccif))
+		md_ccif = NULL;
+
+	pl->clk = devm_clk_get_optional(dev, "scp-sys-md1-main");
+	if (IS_ERR(pl->clk)) {
+		dev_err(dev, "cannot get scp-sys-md1-main: %ld\n",
+			PTR_ERR(pl->clk));
+		return PTR_ERR(pl->clk);
+	}
+	if (!pl->clk)
+		dev_warn(dev, "no scp-sys-md1-main clock, relying on power domain\n");
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = ccci_md_register(&cfg, dev);
+	if (ret) {
+		dev_err(dev, "modem registration failed %d\n", ret);
+		return ret;
+	}
+
+	pl->md = ccci_md_get(cfg.md_id);
+	if (!pl->md) {
+		ccci_unregister_modem(cfg.md_id);
+		return -ENODEV;
+	}
+	pl->md->pdev = pdev;
+	pl->md->boot.clk = pl->clk;
+
+	pl->ccif = ccci_ccif_create(pl->md, dev, pl->ccif_ap, md_ccif,
+				    devm_ioremap(dev, rgu, 0x40),
+				    bv, bv_key, bv_en, cfg.ccif_irq,
+				    pl->md_wdt_irq, cfg.sram_size, !has_cldma);
+	if (IS_ERR(pl->ccif)) {
+		ret = PTR_ERR(pl->ccif);
+		pl->ccif = NULL;
+		dev_err(dev, "CCIF init failed %d\n", ret);
+		goto err_unregister;
+	}
+	ret = ccci_md_attach_ccif(pl->md, pl->ccif);
+	if (ret)
+		goto err_ccif;
+
+	if (has_cldma) {
+		ccfg.dev = dev;
+		ccfg.ap_base = pl->cldma_ao;
+		ccfg.ap_pdn_base = pl->cldma_pdn;
+		ccfg.irq = pl->cldma_irq;
+		ccfg.smem_phys = pl->md->smem_phy;
+		ccfg.smem_size = pl->md->smem_size;
+		pl->cldma = ccci_cldma_create(&ccfg);
+		if (!pl->cldma) {
+			dev_err(dev, "CLDMA engine create failed\n");
+			ret = -ENOMEM;
+			goto err_ccif;
+		}
+		ccci_cldma_set_rx_cb(pl->cldma, ccci_md_rx_cb, pl->md);
+		/* Gap closure: INFRA_AO window for the RGU CLDMA reset. */
+		ccci_cldma_set_infra_ao(pl->cldma, pl->md->infra_ao);
+		ccci_md_attach_cldma(pl->md, pl->cldma);
+	}
+
+	platform_set_drvdata(pdev, pl);
+	dev_info(dev, "md%u probed (%s data path, fw %s)\n", cfg.md_id + 1,
+		 has_cldma ? "CLDMA" : "CCIF-ring", cfg.firmware_name);
+	return 0;
+
+err_ccif:
+	ccci_ccif_destroy(pl->ccif);
+err_unregister:
+	ccci_unregister_modem(cfg.md_id);
+	return ret;
+}
+
+static void ccci_mdcldma_remove(struct platform_device *pdev)
+{
+	struct ccci_plat *pl = platform_get_drvdata(pdev);
+	unsigned int md_id;
+
+	if (!pl || !pl->md)
+		return;
+
+	md_id = pl->md->id;
+	if (pl->cldma) {
+		ccci_cldma_destroy(pl->cldma);
+		pl->cldma = NULL;
+	}
+	if (pl->ccif) {
+		ccci_ccif_destroy(pl->ccif);
+		pl->ccif = NULL;
+	}
+	ccci_unregister_modem(md_id);
+	platform_set_drvdata(pdev, NULL);
+}
+
+static void ccci_mdcldma_shutdown(struct platform_device *pdev)
+{
+	struct ccci_plat *pl = platform_get_drvdata(pdev);
+
+	if (pl && pl->md)
+		ccci_md_stop(pl->md, 0);
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int ccci_mdcldma_suspend(struct device *dev)
+{
+	struct ccci_plat *pl = dev_get_drvdata(dev);
+
+	if (!pl || !pl->md)
+		return 0;
+	/* the modem keeps running; only the AP side is quiesced */
+	dev_dbg(dev, "suspend, md state %d\n", pl->md->state);
+	return 0;
+}
+
+static int ccci_mdcldma_resume(struct device *dev)
+{
+	struct ccci_plat *pl = dev_get_drvdata(dev);
+
+	if (!pl || !pl->md || !pl->ccif)
+		return 0;
+	/* downstream md_ccif_resume(): restore CCIF arbitration */
+	if (pl->ccif->ap_base)
+		writel(0x01, pl->ccif->ap_base + APCCIF_CON);
+	return 0;
+}
+
+static int ccci_mdcldma_restore_noirq(struct device *dev)
+{
+	struct ccci_plat *pl = dev_get_drvdata(dev);
+
+	if (!pl || !pl->md)
+		return 0;
+	/* IPO-H: the modem lost power, force a full reload on next start */
+	pl->md->boot.fw_valid = false;
+	pl->md->boot_stage = CCCI_BOOT_STAGE_0;
+	return 0;
+}
+#endif /* CONFIG_PM_SLEEP */
+
+static const struct dev_pm_ops ccci_modem_pm_ops = {
+#ifdef CONFIG_PM_SLEEP
+	.suspend = ccci_mdcldma_suspend,
+	.resume = ccci_mdcldma_resume,
+	.freeze = ccci_mdcldma_suspend,
+	.thaw = ccci_mdcldma_resume,
+	.poweroff = ccci_mdcldma_suspend,
+	.restore = ccci_mdcldma_resume,
+	.restore_noirq = ccci_mdcldma_restore_noirq,
+#endif
+};
+
+static struct platform_driver ccci_mdcldma_driver = {
+	.probe = ccci_mdcldma_probe,
+	.remove = ccci_mdcldma_remove,
+	.shutdown = ccci_mdcldma_shutdown,
+	.driver = {
+		.name = "ccci_mdcldma",
+		.of_match_table = ccci_mdcldma_of_match,
+		.pm = &ccci_modem_pm_ops,
+	},
+};
+
+int ccci_platform_register(void)
+{
+	return platform_driver_register(&ccci_mdcldma_driver);
+}
+
+void ccci_platform_unregister(void)
+{
+	platform_driver_unregister(&ccci_mdcldma_driver);
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_port_char.c b/drivers/misc/mediatek/ccci/ccci_port_char.c
new file mode 100644
index 000000000..f11303db5
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_port_char.c
@@ -0,0 +1,609 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI character ports (/dev/ccci_monitor, /dev/ttyC0, /dev/ccci_fs, ...).
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_char.c (read/write/poll/ioctl and the
+ * critical-user bookkeeping) and port_cfg.c (port table, see ccci_core.c).
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#include <linux/cdev.h>
+#include <linux/ccci.h>
+#include <linux/compat.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/kdev_t.h>
+#include <linux/module.h>
+#include <linux/poll.h>
+#include <linux/sched.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "ccci_priv.h"
+
+/*
+ * Downstream keeps four "critical user" flags so the modem is only reset from
+ * userspace when no important client is attached (port_char.c:50-89).
+ */
+static void ccci_char_open_check(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+
+	if (port->rx_ch == CCCI_FS_RX)
+		md->critical_user[0] = 1;
+	if (port->rx_ch == CCCI_UART2_RX)
+		md->critical_user[1] = 1;
+	if (port->rx_ch == CCCI_MD_LOG_RX)
+		md->critical_user[2] = 0;
+	if (port->rx_ch == CCCI_UART1_RX)
+		md->critical_user[3] = 0;
+}
+
+static int ccci_char_close_check(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+
+	if (port->rx_ch == CCCI_FS_RX && !atomic_read(&port->open_count))
+		md->critical_user[0] = 0;
+	if (port->rx_ch == CCCI_UART2_RX && !atomic_read(&port->open_count))
+		md->critical_user[1] = 0;
+	if (port->rx_ch == CCCI_MD_LOG_RX && !atomic_read(&port->open_count))
+		md->critical_user[2] = 0;
+	if (port->rx_ch == CCCI_UART1_RX && !atomic_read(&port->open_count))
+		md->critical_user[3] = 0;
+
+	if (md->critical_user[0] || md->critical_user[1])
+		return 1;
+	/*
+	 * downstream dev_char_close_check() (port_char.c:65-96): in META mode
+	 * only the DHL control port (CCCI_UART1_RX, /dev/ccci_md_log_ctrl)
+	 * must be closed before the modem may be reset; the MD logger port is
+	 * not part of a META session.
+	 */
+	if (md->md_boot_mode == CCCI_MD_BOOT_MODE_META) {
+		if (md->critical_user[3]) {
+			ccci_md_err(md, "DHL ctrl is still open in META mode\n");
+			return 1;
+		}
+		ccci_md_info(md, "ready to reset MD in META mode\n");
+		return 0;
+	}
+	if (md->critical_user[2] || md->critical_user[3])
+		return 1;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* open / release                                                      */
+/* ------------------------------------------------------------------ */
+static int ccci_char_open(struct inode *inode, struct file *file)
+{
+	struct ccci_port *port = ccci_get_port_for_node(inode->i_rdev);
+
+	if (!port)
+		return -ENODEV;
+
+	if (atomic_inc_return(&port->open_count) > 1) {
+		atomic_dec(&port->open_count);
+		ccci_md_err(port->md, "port %s already open\n", port->name);
+		return -EBUSY;
+	}
+
+	file->private_data = port;
+	nonseekable_open(inode, file);
+	ccci_char_open_check(port);
+	ccci_md_dbg(port->md, "port %s opened by %s\n", port->name,
+		    current->comm);
+	return 0;
+}
+
+static int ccci_char_release(struct inode *inode, struct file *file)
+{
+	struct ccci_port *port = file->private_data;
+	unsigned long flags;
+	struct sk_buff *skb;
+
+	atomic_dec(&port->open_count);
+
+	spin_lock_irqsave(&port->rx_lock, flags);
+	while ((skb = __skb_dequeue(&port->rx_q)) != NULL) {
+		if (port->rx_len)
+			port->rx_len--;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		dev_kfree_skb_any(skb);
+		spin_lock_irqsave(&port->rx_lock, flags);
+	}
+	if (port->rx_current) {
+		dev_kfree_skb_any(port->rx_current);
+		port->rx_current = NULL;
+	}
+	port->rx_len = 0;
+	port->rx_full = false;
+	spin_unlock_irqrestore(&port->rx_lock, flags);
+
+	/* let a pending modem reset proceed if no critical user is left */
+	if (ccci_char_close_check(port) == 0 &&
+	    port->md->state == CCCI_MD_STOPPED)
+		ccci_send_virtual_md_msg(port->md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_READY_TO_RESET, 0);
+
+	ccci_port_ask_more(port);
+	ccci_md_dbg(port->md, "port %s closed\n", port->name);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* read                                                                */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_char_read(struct file *file, char __user *buf,
+			      size_t count, loff_t *ppos)
+{
+	struct ccci_port *port = file->private_data;
+	struct sk_buff *skb;
+	struct ccci_header *ccci_h;
+	size_t read_len;
+	unsigned long flags;
+	int ret;
+
+	if (!count)
+		return 0;
+
+	if (!port->rx_current) {
+		if (skb_queue_empty(&port->rx_q)) {
+			if (file->f_flags & O_NONBLOCK)
+				return -EAGAIN;
+			ret = wait_event_interruptible(port->rx_wq,
+						       !skb_queue_empty(&port->rx_q));
+			if (ret)
+				return -ERESTARTSYS;
+		}
+
+		spin_lock_irqsave(&port->rx_lock, flags);
+		skb = __skb_dequeue(&port->rx_q);
+		if (skb && port->rx_len)
+			port->rx_len--;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		if (!skb)
+			return -EAGAIN;
+
+		port->rx_current = skb;
+		port->rx_current_user_header = false;
+
+		if (port->flags & PORT_F_USER_HEADER) {
+			/* monitor channel: hand the header to md_init and tag it
+			 * with the legacy CCCI_MONITOR_CH_ID (port_char.c:205)
+			 */
+			ccci_h = (struct ccci_header *)skb->data;
+			if (ccci_h->data[0] == CCCI_MAGIC_NUM &&
+			    ccci_h->channel == CCCI_MONITOR_CH) {
+				*(((u32 *)ccci_h) + 2) = CCCI_MONITOR_CH_ID;
+				port->rx_current_user_header = true;
+			}
+		} else {
+			skb_pull(skb, CCCI_HEADER_SIZE);
+		}
+	}
+
+	skb = port->rx_current;
+	read_len = min(count, (size_t)skb->len);
+	if (copy_to_user(buf, skb->data, read_len)) {
+		ccci_md_err(port->md, "read on %s: copy_to_user failed\n",
+			    port->name);
+		return -EFAULT;
+	}
+	skb_pull(skb, read_len);
+	if (!skb->len) {
+		dev_kfree_skb_any(skb);
+		port->rx_current = NULL;
+		ccci_port_ask_more(port);
+	}
+	return read_len;
+}
+
+/* ------------------------------------------------------------------ */
+/* write                                                               */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_char_write(struct file *file, const char __user *buf,
+			       size_t count, loff_t *ppos)
+{
+	struct ccci_port *port = file->private_data;
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	size_t limit, actual;
+	bool user_header = port->flags & PORT_F_USER_HEADER;
+	unsigned int qno, retries = 0;
+	int ret;
+
+	if (port->tx_ch == CCCI_MONITOR_CH)
+		return -EPERM;
+
+	if (md->state == CCCI_MD_BOOTING && port->tx_ch != CCCI_FS_TX &&
+	    port->tx_ch != CCCI_RPC_TX)
+		return -ENODEV;
+	if (md->state == CCCI_MD_EXCEPTION && port->tx_ch != CCCI_MD_LOG_TX &&
+	    port->tx_ch != CCCI_UART1_TX && port->tx_ch != CCCI_FS_TX)
+		return -ETXTBSY;
+	if (md->state == CCCI_MD_STOPPED || md->state == CCCI_MD_INVALID)
+		return -ENODEV;
+
+	limit = user_header ? CCCI_MTU + CCCI_HEADER_SIZE : CCCI_MTU;
+	if (!count)
+		return -EINVAL;
+	actual = min(count, limit);
+
+	qno = ccci_port_txq(port);
+	if (qno >= CCCI_MAX_QUEUES)
+		return -ENODEV;
+
+	skb = alloc_skb(CCCI_HEADER_SIZE + actual, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	if (!user_header) {
+		ccci_h = (struct ccci_header *)skb_put(skb, CCCI_HEADER_SIZE);
+		memset(ccci_h, 0, CCCI_HEADER_SIZE);
+		ccci_h->data[0] = 0;
+		ccci_h->data[1] = actual + CCCI_HEADER_SIZE;
+		ccci_h->channel = port->tx_ch;
+		ccci_h->reserved = 0;
+	}
+
+	if (copy_from_user(skb_put(skb, actual), buf, actual)) {
+		dev_kfree_skb_any(skb);
+		return -EFAULT;
+	}
+
+	if (user_header) {
+		/* the CCCI header came from the user, only patch what the ROM
+		 * patches (port_char.c:492-502)
+		 */
+		ccci_h = (struct ccci_header *)skb->data;
+		if (actual == CCCI_HEADER_SIZE)
+			ccci_h->data[0] = CCCI_MAGIC_NUM;
+		else
+			ccci_h->data[1] = actual;
+		ccci_h->channel = port->tx_ch;
+	}
+
+	port->tx_pkts++;
+	for (;;) {
+		ret = ccci_md_send_skb(md, qno, skb);
+		if (!ret)
+			return actual;
+		if (ret != -EBUSY)
+			break;
+		port->tx_busy_cnt++;
+		/* a blocking writer waits for room, like downstream's blocking
+		 * request allocation
+		 */
+		if ((file->f_flags & O_NONBLOCK) || ++retries > 2000)
+			break;
+		usleep_range(1000, 2000);
+	}
+	dev_kfree_skb_any(skb);
+	return ret == -EBUSY ? -EAGAIN : ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* poll                                                                */
+/* ------------------------------------------------------------------ */
+static __poll_t ccci_char_poll(struct file *file, poll_table *wait)
+{
+	struct ccci_port *port = file->private_data;
+	__poll_t mask = 0;
+
+	poll_wait(file, &port->rx_wq, wait);
+	if (port->rx_current || !skb_queue_empty(&port->rx_q))
+		mask |= EPOLLIN | EPOLLRDNORM;
+	if (ccci_md_write_room(port->md, ccci_port_txq(port)) > 0)
+		mask |= EPOLLOUT | EPOLLWRNORM;
+	/* mdlogger polls to learn that the modem is going away */
+	if (port->rx_ch == CCCI_UART1_RX &&
+	    port->md->state != CCCI_MD_READY &&
+	    port->md->state != CCCI_MD_EXCEPTION)
+		mask |= EPOLLERR;
+	return mask;
+}
+
+/* ------------------------------------------------------------------ */
+/* ioctl                                                               */
+/* ------------------------------------------------------------------ */
+static long ccci_char_ioctl(struct file *file, unsigned int cmd,
+			    unsigned long arg)
+{
+	struct ccci_port *port = file->private_data;
+	struct ccci_md *md = port->md;
+	unsigned int val;
+	long ret = 0;
+
+	switch (cmd) {
+	case CCCI_IOC_GET_MD_STATE:
+		ret = put_user((unsigned int)md->boot_stage,
+			       (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_MD_RESET:
+		ccci_md_info(md, "MD reset requested by %s\n", current->comm);
+		ret = ccci_md_reset(md);
+		if (!ret)
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_RESET, 0);
+		break;
+
+	case CCCI_IOC_DO_MD_RST:
+		ret = ccci_md_reset(md);
+		break;
+
+	/* downstream CCCI_IOC_GET_MD_INFO returns the image version, this is
+	 * the closest ROM ioctl to a "get boot info" request
+	 */
+	case CCCI_IOC_GET_MD_INFO:
+		ret = put_user(md->boot.product_ver, (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_GET_MD_EX_TYPE:
+		ret = put_user(md->ex_type, (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_FORCE_MD_ASSERT:
+		ccci_md_info(md, "force MD assert by %s\n", current->comm);
+		ret = ccci_md_force_assert(md,
+					   md->id == CCCI_MD_SYS3 ? 1 : 0);
+		break;
+
+	case CCCI_IOC_SEND_RUN_TIME_DATA:
+		if (port->rx_ch != CCCI_MONITOR_CH) {
+			ret = -EPERM;
+			break;
+		}
+		ret = ccci_boot_send_runtime_data(md, md->sbp_code);
+		break;
+
+	case CCCI_IOC_ENTER_DEEP_FLIGHT:
+		ccci_md_info(md, "enter flight mode by %s\n", current->comm);
+		ret = ccci_md_reset(md);
+		if (!ret) {
+			ccci_md_stop(md, 1000);
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_ENTER_FLIGHT_MODE,
+						       0);
+		}
+		break;
+
+	case CCCI_IOC_LEAVE_DEEP_FLIGHT:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_LEAVE_FLIGHT_MODE,
+					       0);
+		break;
+
+	case CCCI_IOC_DO_START_MD:
+		ret = ccci_md_start(md);
+		break;
+
+	case CCCI_IOC_DO_STOP_MD:
+		ret = ccci_md_stop(md, 0);
+		break;
+
+	case CCCI_IOC_SEND_STOP_MD_REQUEST:
+		ret = ccci_md_reset(md);
+		if (!ret) {
+			ccci_md_stop(md, 0);
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_STOP_MD_REQUEST,
+						       0);
+		}
+		break;
+
+	case CCCI_IOC_SEND_START_MD_REQUEST:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_START_MD_REQUEST, 0);
+		break;
+
+	case CCCI_IOC_POWER_ON_MD_REQUEST:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_POWER_ON_REQUEST, 0);
+		break;
+
+	case CCCI_IOC_POWER_OFF_MD_REQUEST:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_POWER_OFF_REQUEST, 0);
+		break;
+
+	case CCCI_IOC_POWER_ON_MD:
+	case CCCI_IOC_POWER_OFF_MD:
+		/* downstream marks these abandoned but returns -1 */
+		ret = -EPERM;
+		break;
+
+	case CCCI_IOC_GET_MD_PROTOCOL_TYPE:
+		/* { "DHL", 0 } as char[16] buffer, downstream port_char.c:574 */
+		ret = copy_to_user((void __user *)arg, "DHL", 4) ? -EFAULT : 0;
+		break;
+
+	case CCCI_IOC_SEND_BATTERY_INFO:
+		/* needs the MT6328 battery driver, absent from this tree */
+		ccci_md_info(md, "battery info request without battery driver\n");
+		ret = -EOPNOTSUPP;
+		break;
+
+	case CCCI_IOC_SET_MD_BOOT_MODE:
+		if (copy_from_user(&val, (void __user *)arg, sizeof(val))) {
+			ret = -EFAULT;
+			break;
+		}
+		if (val > 0 && val < 3)	/* NORMAL / META */
+			md->md_boot_mode = val;
+		else
+			ret = -EINVAL;
+		break;
+
+	case CCCI_IOC_GET_MD_BOOT_MODE:
+		ret = put_user(md->md_boot_mode, (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_GET_MD_SBP_CFG:
+		/* default resolved from CONFIG_MTK_MD[_2]_SBP_CUSTOM_VALUE at
+		 * modem creation, downstream port_char.c:914-947
+		 */
+		ret = put_user(md->sbp_code_default,
+			       (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_SET_MD_SBP_CFG:
+		if (copy_from_user(&val, (void __user *)arg, sizeof(val))) {
+			ret = -EFAULT;
+			break;
+		}
+		md->sbp_code = val;
+		ccci_md_info(md, "SBP code set to 0x%x by %s\n", val,
+			     current->comm);
+		break;
+
+	case CCCI_IOC_GET_MD_MEM_SIZE:
+		ret = put_user((unsigned int)md->img_size,
+			       (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_PCM_BASE_ADDR:
+	case CCCI_IOC_PCM_LEN:
+	case CCCI_IOC_ALLOC_MD_LOG_MEM:
+		/* deprecated shared-memory operations, downstream ignores them */
+		break;
+
+	default:
+		ccci_md_dbg(md, "unsupported ioctl 0x%x on %s\n", cmd,
+			    port->name);
+		ret = -ENOTTY;
+		break;
+	}
+	return ret;
+}
+
+#ifdef CONFIG_COMPAT
+static long ccci_char_compat_ioctl(struct file *file, unsigned int cmd,
+				   unsigned long arg)
+{
+	return ccci_char_ioctl(file, cmd, (unsigned long)compat_ptr(arg));
+}
+#endif
+
+static const struct file_operations ccci_char_fops = {
+	.owner = THIS_MODULE,
+	.open = ccci_char_open,
+	.release = ccci_char_release,
+	.read = ccci_char_read,
+	.write = ccci_char_write,
+	.poll = ccci_char_poll,
+	.unlocked_ioctl = ccci_char_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = ccci_char_compat_ioctl,
+#endif
+};
+
+/* ------------------------------------------------------------------ */
+/* port ops                                                            */
+/* ------------------------------------------------------------------ */
+static int ccci_char_port_recv_skb(struct ccci_port *port, struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+
+	/* nobody is listening: keep the modem alive, count the drop */
+	if (!atomic_read(&port->open_count) && port->rx_ch != CCCI_UART2_RX &&
+	    port->rx_ch != CCCI_PCM_RX && port->rx_ch != CCCI_FS_RX &&
+	    port->rx_ch != CCCI_RPC_RX) {
+		port->rx_drops++;
+		dev_kfree_skb_any(skb);
+		return 0;
+	}
+
+	md->wakeup_src = 0;
+	return ccci_port_recv_skb(port, skb);
+}
+
+static void ccci_char_md_state_notice(struct ccci_port *port, int event)
+{
+	if (port->rx_ch == CCCI_UART1_RX && event == CCCI_MD_STOPPED)
+		wake_up_interruptible(&port->rx_wq);
+}
+
+const struct ccci_port_ops ccci_char_port_ops = {
+	.recv_skb = ccci_char_port_recv_skb,
+	.md_state_notice = ccci_char_md_state_notice,
+};
+
+/* ------------------------------------------------------------------ */
+/* device node management                                              */
+/* ------------------------------------------------------------------ */
+static int ccci_char_add_port(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+	dev_t devt = MKDEV(md->major, port->minor);
+	int ret;
+
+	cdev_init(&port->cdev, &ccci_char_fops);
+	port->cdev.owner = THIS_MODULE;
+	ret = cdev_add(&port->cdev, devt, 1);
+	if (ret) {
+		ccci_md_err(md, "cdev_add(%s, %u:%u) failed %d\n", port->name,
+			    md->major, port->minor, ret);
+		return ret;
+	}
+	port->cdev_added = true;
+
+	port->dev = device_create(ccci_class, md->dev, devt, port, "%s",
+				  port->name);
+	if (IS_ERR(port->dev)) {
+		ret = PTR_ERR(port->dev);
+		port->dev = NULL;
+		cdev_del(&port->cdev);
+		port->cdev_added = false;
+		ccci_md_err(md, "device_create(%s) failed %d\n", port->name,
+			    ret);
+		return ret;
+	}
+	ccci_md_info(md, "port %s at %u:%u\n", port->name, md->major,
+		     port->minor);
+	return 0;
+}
+
+int ccci_port_char_init(struct ccci_md *md)
+{
+	struct ccci_port *port;
+	int ret;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops != &ccci_char_port_ops)
+			continue;
+		ret = ccci_char_add_port(port);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+void ccci_port_char_exit(struct ccci_md *md)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (!port->cdev_added)
+			continue;
+		if (port->dev) {
+			device_destroy(ccci_class,
+				       MKDEV(md->major, port->minor));
+			port->dev = NULL;
+		}
+		cdev_del(&port->cdev);
+		port->cdev_added = false;
+		skb_queue_purge(&port->rx_q);
+		if (port->rx_current) {
+			dev_kfree_skb_any(port->rx_current);
+			port->rx_current = NULL;
+		}
+		port->rx_len = 0;
+	}
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_port_kernel.c b/drivers/misc/mediatek/ccci/ccci_port_kernel.c
new file mode 100644
index 000000000..9ab9672a5
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_port_kernel.c
@@ -0,0 +1,437 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI kernel ports: control, system, status and RPC channels handled inside
+ * the kernel, plus the kernel service API used by other subsystems.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_kernel.c.  Original copyright
+ * (C) 2015 MediaTek Inc., GPL-2.0.
+ *
+ * Deviations from the ROM, all because the corresponding provider does not
+ * exist in this kernel tree (documented in the leaf report):
+ *   - ID_GET_TXPOWER needs the thermal/DVFS clients; the service still
+ *     forwards the system message, and unknown ids return -EOPNOTSUPP.
+ *
+ * Kernel RPC requests are handed to the RPC engine in ccci_rpc.c, the
+ * counterpart of downstream port_kernel_thread() calling rpc_msg_handler()
+ * (port_kernel.c:2108-2113).
+ */
+#include <linux/ccci.h>
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/wait.h>
+
+#include "ccci_priv.h"
+#include "ccci_rpc.h"
+
+#define CCCI_MAX_KERN_API	35
+
+struct ccci_md;
+
+struct ccci_sys_cb {
+	unsigned int id;
+	int (*func)(int md_id, int data);
+};
+
+static struct ccci_sys_cb ccci_sys_cb_100[CCCI_MAX_MD_NUM][CCCI_MAX_KERN_API];
+static struct ccci_sys_cb ccci_sys_cb_1000[CCCI_MAX_MD_NUM][CCCI_MAX_KERN_API];
+static DEFINE_MUTEX(ccci_sys_cb_lock);
+
+/* ------------------------------------------------------------------ */
+/* system callback dispatch                                            */
+/* ------------------------------------------------------------------ */
+static void ccci_exec_sys_cb(struct ccci_md *md, unsigned int id, int data)
+{
+	struct ccci_sys_cb *slot = NULL;
+
+	if (id >= 0x1000 && id - 0x1000 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_1000[md->id][id - 0x1000];
+	else if (id >= 0x100 && id - 0x100 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_100[md->id][id - 0x100];
+	if (!slot || !slot->func) {
+		ccci_md_dbg(md, "no kernel callback for message 0x%x\n", id);
+		return;
+	}
+	slot->func(md->id, data);
+}
+
+int register_ccci_sys_call_back(int md_id, unsigned int id,
+				int (*func)(int md_id, int data))
+{
+	struct ccci_sys_cb *slot = NULL;
+	int ret = 0;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM || !func)
+		return -EINVAL;
+
+	mutex_lock(&ccci_sys_cb_lock);
+	if (id >= 0x1000 && id - 0x1000 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_1000[md_id][id - 0x1000];
+	else if (id >= 0x100 && id - 0x100 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_100[md_id][id - 0x100];
+	else
+		ret = -EINVAL;
+
+	if (!ret) {
+		if (slot->func) {
+			pr_err("ccci: sys callback 0x%x already registered\n", id);
+			ret = -EBUSY;
+		} else {
+			slot->id = id;
+			slot->func = func;
+		}
+	}
+	mutex_unlock(&ccci_sys_cb_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(register_ccci_sys_call_back);
+
+/* ------------------------------------------------------------------ */
+/* boot count (throttling feature, ROM ccci_get_md_boot_count)         */
+/* ------------------------------------------------------------------ */
+unsigned long ccci_get_md_boot_count(int md_id)
+{
+	struct ccci_md *md;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return 0;
+	md = ccci_md_get(md_id);
+	return md ? md->boot_count : 0;
+}
+EXPORT_SYMBOL_GPL(ccci_get_md_boot_count);
+
+/* ------------------------------------------------------------------ */
+/* kernel service API (ROM exec_ccci_kern_func_by_md_id)               */
+/* ------------------------------------------------------------------ */
+int exec_ccci_kern_func_by_md_id(int md_id, unsigned int id, char *buf,
+				 unsigned int len)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	int val = 0;
+	int ret = 0;
+
+	if (!md)
+		return -ENODEV;
+
+	if (buf && len >= sizeof(int))
+		memcpy(&val, buf, sizeof(int));
+
+	switch (id) {
+	case ID_GET_MD_WAKEUP_SRC:
+		/* SPM asks who woke the AP; the CCIF Rx path marks it */
+		md->wakeup_src = 1;
+		break;
+	case ID_GET_MD_STATE:
+		ret = md->boot_stage;
+		break;
+	case ID_RESET_MD:
+		ret = ccci_md_reset(md);
+		if (!ret)
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_RESET, 0);
+		break;
+	case ID_PAUSE_LTE:
+		/* DVFS: >0 means "modem not available", 0 delivered */
+		if (md->state != CCCI_MD_READY) {
+			ret = 1;
+			break;
+		}
+		ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX, MD_PAUSE_LTE,
+					  val, true);
+		if (ret == -CCCI_ERR_MD_NOT_READY ||
+		    ret == -CCCI_ERR_HIF_NOT_POWER_ON)
+			ret = 1;
+		break;
+	case ID_GET_TXPOWER:
+		if (!buf)
+			return -EINVAL;
+		if (val == 0)
+			ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX,
+						  MD_TX_POWER, 0, false);
+		else if (val == 1)
+			ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX,
+						  MD_RF_TEMPERATURE, 0, false);
+		else if (val == 2)
+			ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX,
+						  MD_RF_TEMPERATURE_3G, 0,
+						  false);
+		else
+			ret = -EINVAL;
+		break;
+	case ID_STORE_SIM_SWITCH_MODE:
+		/* no SIM switch driver in this tree: keep the value locally */
+		md->sim_switch_mode = val;
+		break;
+	case ID_GET_SIM_SWITCH_MODE:
+		if (!buf)
+			return -EINVAL;
+		memcpy(buf, &md->sim_switch_mode, sizeof(int));
+		break;
+	case ID_THROTTLING_CFG:
+		/* no MD throughput throttling client in this tree */
+		ret = -EOPNOTSUPP;
+		break;
+	case ID_DUMP_MD_SLEEP_MODE:
+		if (md->smem_vir) {
+			ccci_md_info(md, "MD sleep debug at smem+0x%x\n",
+				     CCCI_SMEM_SIZE_EXCEPTION -
+				     CCCI_SMEM_SLEEP_MODE_DBG_SIZE);
+		}
+		break;
+	case ID_DUMP_MD_REG:
+		ccci_ccif_dump_regs(md, NULL);
+		break;
+	case ID_UPDATE_MD_BOOT_MODE:
+		if (val > 0 && val < 3)
+			md->md_boot_mode = val;
+		else
+			ret = -EINVAL;
+		break;
+	case MD_THERMAL_LOW_POWER:
+	case MD_THROTTLING:
+		ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX, id, val, false);
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+		break;
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(exec_ccci_kern_func_by_md_id);
+
+/* ------------------------------------------------------------------ */
+/* message handlers                                                    */
+/* ------------------------------------------------------------------ */
+static void ccci_kernel_drop(struct ccci_md *md, const char *what,
+			     struct sk_buff *skb)
+{
+	ccci_md_dbg(md, "%s: unsupported request, dropped (%u bytes)\n", what,
+		    skb->len);
+	dev_kfree_skb_any(skb);
+}
+
+static void ccci_control_msg_handler(struct ccci_port *port,
+				     struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h = (struct ccci_header *)skb->data;
+	u32 msg = ccci_h->data[1];
+	u32 check = ccci_h->reserved;
+
+	ccci_md_dbg(md, "control msg 0x%x/0x%x\n", msg, check);
+
+	if (msg == MD_INIT_START_BOOT && check == MD_INIT_CHK_ID &&
+	    md->boot_stage == CCCI_BOOT_STAGE_0) {
+		ccci_boot_disarm_timer(md);
+		md->boot_stage = CCCI_BOOT_STAGE_1;
+		if (skb->len == CCCI_HEADER_SIZE + sizeof(struct md_query_ap_feature)) {
+			if (ccci_boot_prepare_runtime_data(md, skb))
+				ccci_md_err(md, "runtime data prep failed\n");
+		} else if (skb->len == CCCI_HEADER_SIZE) {
+			ccci_md_info(md, "legacy handshake message\n");
+		} else {
+			ccci_md_err(md, "invalid MD_QUERY_MSG length %u\n",
+				    skb->len);
+		}
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_BOOT_UP, 0);
+	} else if (msg == MD_NORMAL_BOOT && md->boot_stage == CCCI_BOOT_STAGE_1) {
+		ccci_boot_disarm_timer(md);
+		md->boot_stage = CCCI_BOOT_STAGE_2;
+		ccci_md_set_state(md, CCCI_MD_READY);
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_BOOT_READY, 0);
+	} else if (msg == MD_EX) {
+		if (check != MD_EX_CHK_ID) {
+			ccci_md_err(md, "invalid MD_EX check id 0x%x\n", check);
+		} else {
+			ccci_boot_disarm_timer(md);
+			md->ex_stage = CCCI_EX_INIT;
+			ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+			ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						 CCCI_MD_MSG_EXCEPTION, 0);
+			/* downstream disables the MD watchdog on exception
+			 * entry (port_kernel.c:562 ee_callback)
+			 */
+			ccif_wdt_irq(md, false);
+			ccci_send_msg_to_md(md, CCCI_CONTROL_TX, MD_EX,
+					    MD_EX_CHK_ID, true);
+		}
+	} else if (msg == MD_EX_REC_OK) {
+		if (check != MD_EX_REC_OK_CHK_ID ||
+		    skb->len < CCCI_HEADER_SIZE + 4) {
+			ccci_md_err(md, "invalid MD_EX_REC_OK resv 0x%x len %u\n",
+				    check, skb->len);
+		} else {
+			/* exception log: first byte is EX_HEADER_T.ex_type */
+			md->ex_type = skb->data[CCCI_HEADER_SIZE];
+			md->ex_stage = CCCI_EX_DHL_DL_RDY;
+			ccci_md_err(md, "MD exception type %u, rec ok (%u bytes)\n",
+				    md->ex_type, skb->len);
+			ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+		}
+	} else if (msg == MD_EX_PASS) {
+		md->ex_stage = CCCI_EX_INIT_DONE;
+		ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+	} else if (msg == MD_INIT_START_BOOT && check == MD_INIT_CHK_ID) {
+		/* second boot attempt: userspace has to restart the modem */
+		md->boot_stage = CCCI_BOOT_STAGE_0;
+		ccci_md_err(md, "MD second boot detected\n");
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_RESET, 0);
+	} else if (msg == MD_EX_RESUME) {
+		md->ex_type = 0;	/* MD_EX_TYPE_EMI_CHECK is 0 in ROM */
+		ccci_md_err(md, "MD EMI check resume\n");
+		ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+	} else if (msg == CCCI_DRV_VER_ERROR) {
+		ccci_md_err(md, "AP/MD CCCI version mismatch\n");
+	} else if (msg == C2K_HB_MSG && md->id == CCCI_MD_SYS3) {
+		md->heartbeat++;
+	} else if ((msg == C2K_STATUS_IND_MSG ||
+		    msg == C2K_STATUS_QUERY_MSG) && md->id == CCCI_MD_SYS3) {
+		/* struct c2k_ctrl_port_msg option byte lives in reserved[3] */
+		md->dtr_state = !!(ccci_h->reserved & 0x80000000);
+	} else {
+		ccci_md_err(md, "unknown control message 0x%x\n", msg);
+	}
+	dev_kfree_skb_any(skb);
+}
+
+static void ccci_system_msg_handler(struct ccci_port *port,
+				    struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h = (struct ccci_header *)skb->data;
+
+	switch (ccci_h->data[1]) {
+	case MD_GET_BATTERY_INFO:
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_SEND_BATTERY_INFO, 0);
+		break;
+	case MD_WDT_MONITOR:
+		/* heartbeat, the WDT IRQ is the real watchdog */
+		md->heartbeat++;
+		break;
+	case MD_SIM_TYPE:
+		md->sim_type = ccci_h->reserved;
+		break;
+	case MD_TX_POWER:
+	case MD_RF_TEMPERATURE:
+	case MD_RF_TEMPERATURE_3G:
+	case MD_THROTTLING:
+	case MD_THERMAL_LOW_POWER:
+		ccci_exec_sys_cb(md, ccci_h->data[1], ccci_h->reserved);
+		break;
+	default:
+		ccci_md_dbg(md, "unhandled system message 0x%x\n",
+			    ccci_h->data[1]);
+		break;
+	}
+	dev_kfree_skb_any(skb);
+}
+
+static void ccci_status_msg_handler(struct ccci_port *port,
+				    struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+
+	md->heartbeat++;
+	ccci_md_dbg(md, "status message 0x%x\n",
+		    ((struct ccci_header *)skb->data)->data[1]);
+	dev_kfree_skb_any(skb);
+}
+
+/* ------------------------------------------------------------------ */
+/* kernel port thread                                                  */
+/* ------------------------------------------------------------------ */
+static int ccci_kernel_port_thread(void *arg)
+{
+	struct ccci_port *port = arg;
+	struct ccci_md *md = port->md;
+	struct sk_buff *skb;
+	unsigned long flags;
+
+	while (!kthread_should_stop()) {
+		wait_event_interruptible(port->rx_wq,
+					 !skb_queue_empty(&port->rx_q) ||
+					 kthread_should_stop());
+		if (kthread_should_stop())
+			break;
+
+		spin_lock_irqsave(&port->rx_lock, flags);
+		skb = __skb_dequeue(&port->rx_q);
+		if (skb && port->rx_len)
+			port->rx_len--;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		if (!skb)
+			continue;
+
+		switch (((struct ccci_header *)skb->data)->channel) {
+		case CCCI_CONTROL_RX:
+			ccci_control_msg_handler(port, skb);
+			break;
+		case CCCI_SYSTEM_RX:
+			ccci_system_msg_handler(port, skb);
+			break;
+		case CCCI_STATUS_RX:
+			ccci_status_msg_handler(port, skb);
+			break;
+		case CCCI_RPC_RX:
+			/* downstream rpc_msg_handler() (port_kernel.c:2108),
+			 * always consumes the skb
+			 */
+			ccci_rpc_handle(port, skb);
+			break;
+		default:
+			ccci_kernel_drop(md, "kernel port", skb);
+			break;
+		}
+		ccci_port_ask_more(port);
+	}
+	return 0;
+}
+
+static int ccci_kernel_port_init(struct ccci_port *port)
+{
+	struct task_struct *task;
+
+	port->rx_len_th = CCCI_PORT_RX_LEN_TH;
+	task = kthread_run(ccci_kernel_port_thread, port, "%s", port->name);
+	if (IS_ERR(task)) {
+		ccci_md_err(port->md, "cannot start thread for %s\n",
+			    port->name);
+		return PTR_ERR(task);
+	}
+	port->priv = task;
+	return 0;
+}
+
+static int ccci_kernel_port_recv_skb(struct ccci_port *port,
+				     struct sk_buff *skb)
+{
+	return ccci_port_recv_skb(port, skb);
+}
+
+const struct ccci_port_ops ccci_kernel_port_ops = {
+	.init = ccci_kernel_port_init,
+	.recv_skb = ccci_kernel_port_recv_skb,
+};
+
+void ccci_port_kernel_exit(struct ccci_md *md)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops != &ccci_kernel_port_ops || !port->priv)
+			continue;
+		wake_up_interruptible(&port->rx_wq);
+		kthread_stop(port->priv);
+		port->priv = NULL;
+		skb_queue_purge(&port->rx_q);
+	}
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_port_net.c b/drivers/misc/mediatek/ccci/ccci_port_net.c
new file mode 100644
index 000000000..71baab01d
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_port_net.c
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI network ports: bind the logical CCMNI channels to the CCMNI netdev
+ * driver through struct ccmni_ccci_ops.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_net.c.  Original copyright
+ * (C) 2015 MediaTek Inc., GPL-2.0.
+ */
+#include <linux/ccci.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_CCMNI_IDX(port)	(((port)->minor & 0xF) - 1)
+
+/* downstream ccmni.h:121-124 */
+#define CCMNI_ERR_TX_OK		0
+#define CCMNI_ERR_TX_BUSY	(-1)
+#define CCMNI_ERR_MD_NO_READY	(-2)
+#define CCMNI_ERR_TX_INVAL	(-3)
+
+#define CCMNI_NAME_MD1		"ccmni"
+#define CCMNI_NAME_MD3		"cc3mni"
+
+/* ------------------------------------------------------------------ */
+/* channel mapping                                                     */
+/* ------------------------------------------------------------------ */
+static void ccci_ccmni_default_channel(int md_id, int idx,
+				       struct ccmni_ch *channel)
+{
+	/* downstream port_net.c:56 ccmni_get_default_channel() */
+	switch (idx) {
+	case 0:
+		channel->rx = CCCI_CCMNI1_RX;
+		channel->tx = CCCI_CCMNI1_TX;
+		channel->dl_ack = CCCI_CCMNI1_DL_ACK;
+		break;
+	case 1:
+		channel->rx = CCCI_CCMNI2_RX;
+		channel->tx = CCCI_CCMNI2_TX;
+		channel->dl_ack = CCCI_CCMNI2_DL_ACK;
+		break;
+	case 2:
+		channel->rx = CCCI_CCMNI3_RX;
+		channel->tx = CCCI_CCMNI3_TX;
+		channel->dl_ack = CCCI_CCMNI3_DL_ACK;
+		break;
+	case 3:
+		channel->rx = CCCI_CCMNI4_RX;
+		channel->tx = CCCI_CCMNI4_TX;
+		channel->dl_ack = CCCI_CCMNI4_DLACK_RX;
+		break;
+	case 4:
+		channel->rx = CCCI_CCMNI5_RX;
+		channel->tx = CCCI_CCMNI5_TX;
+		channel->dl_ack = CCCI_CCMNI5_DLACK_RX;
+		break;
+	case 5:
+		channel->rx = CCCI_CCMNI6_RX;
+		channel->tx = CCCI_CCMNI6_TX;
+		channel->dl_ack = CCCI_CCMNI6_DLACK_RX;
+		break;
+	case 6:
+		channel->rx = CCCI_CCMNI7_RX;
+		channel->tx = CCCI_CCMNI7_TX;
+		channel->dl_ack = CCCI_CCMNI7_DLACK_RX;
+		break;
+	case 7:
+		channel->rx = CCCI_CCMNI8_RX;
+		channel->tx = CCCI_CCMNI8_TX;
+		channel->dl_ack = CCCI_CCMNI8_DLACK_RX;
+		break;
+	default:
+		pr_err("ccci: invalid ccmni index %d for md%d\n", idx,
+		       md_id + 1);
+		channel->rx = CCCI_MAX_CH_NUM;
+		channel->tx = CCCI_MAX_CH_NUM;
+		channel->dl_ack = CCCI_MAX_CH_NUM;
+	}
+
+	channel->rx_ack = 0xFF;
+	channel->tx_ack = 0xFF;
+	channel->multiq = 0;
+}
+
+static int ccci_ccmni_dl_ack(int idx)
+{
+	static const int dl_ack[8] = {
+		CCCI_CCMNI1_DL_ACK, CCCI_CCMNI2_DL_ACK, CCCI_CCMNI3_DL_ACK,
+		CCCI_CCMNI4_DLACK_RX, CCCI_CCMNI5_DLACK_RX,
+		CCCI_CCMNI6_DLACK_RX, CCCI_CCMNI7_DLACK_RX,
+		CCCI_CCMNI8_DLACK_RX,
+	};
+
+	return idx >= 0 && idx < 8 ? dl_ack[idx] : CCCI_MAX_CH_NUM;
+}
+
+int ccci_get_ccmni_channel(int md_id, int ccmni_idx,
+			   struct ccmni_ch *channel)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	struct ccci_port *port;
+
+	if (!channel)
+		return -EINVAL;
+
+	if (!md) {
+		ccci_ccmni_default_channel(md_id, ccmni_idx, channel);
+		return 0;
+	}
+
+	/* the ccmni ports carry different minors (0xF1..0xF8) than their index */
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops != &ccci_net_port_ops)
+			continue;
+		if (port->minor != (0xF0 | (ccmni_idx + 1)))
+			continue;
+		channel->rx = port->rx_ch;
+		channel->rx_ack = 0xFF;
+		channel->tx = port->tx_ch;
+		channel->tx_ack = 0xFF;
+		channel->dl_ack = ccci_ccmni_dl_ack(ccmni_idx);
+		channel->multiq = md_id == CCCI_MD_SYS1 ? 1 : 0;
+		return 0;
+	}
+
+	ccci_ccmni_default_channel(md_id, ccmni_idx, channel);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ccci_get_ccmni_channel);
+
+/* ------------------------------------------------------------------ */
+/* Tx                                                                  */
+/* ------------------------------------------------------------------ */
+static bool ccci_net_ack_channel(unsigned int tx_ch, unsigned int *port_ch)
+{
+	switch (tx_ch) {
+	case CCCI_CCMNI1_DL_ACK:
+		*port_ch = CCCI_CCMNI1_TX;
+		return true;
+	case CCCI_CCMNI2_DL_ACK:
+		*port_ch = CCCI_CCMNI2_TX;
+		return true;
+	case CCCI_CCMNI3_DL_ACK:
+		*port_ch = CCCI_CCMNI3_TX;
+		return true;
+	case CCCI_CCMNI4_DLACK_RX:
+		*port_ch = CCCI_CCMNI4_TX;
+		return true;
+	case CCCI_CCMNI5_DLACK_RX:
+		*port_ch = CCCI_CCMNI5_TX;
+		return true;
+	case CCCI_CCMNI6_DLACK_RX:
+		*port_ch = CCCI_CCMNI6_TX;
+		return true;
+	case CCCI_CCMNI7_DLACK_RX:
+		*port_ch = CCCI_CCMNI7_TX;
+		return true;
+	case CCCI_CCMNI8_DLACK_RX:
+		*port_ch = CCCI_CCMNI8_TX;
+		return true;
+	default:
+		*port_ch = tx_ch;
+		return false;
+	}
+}
+
+/*
+ * ccmni_send_pkt - CCMNI -> modem packet path
+ *
+ * The skb arrives with the L3 payload at skb->data and at least
+ * sizeof(struct ccci_header) of headroom; the CCCI header is pushed here.
+ * On success (0) the skb is consumed.  On -CCMNI_ERR_TX_BUSY the header is
+ * pulled again so CCMNI can retry with the same skb.
+ */
+static int ccci_ccmni_send_pkt(int md_id, int tx_ch, void *data)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	struct ccci_port *port;
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb = data;
+	unsigned int port_ch, qno;
+	bool is_ack;
+	int ret;
+
+	if (!md || !skb)
+		return CCMNI_ERR_TX_INVAL;
+	if (md->state != CCCI_MD_READY)
+		return CCMNI_ERR_MD_NO_READY;
+
+	is_ack = ccci_net_ack_channel(tx_ch, &port_ch);
+	port = ccci_md_get_port_by_channel(md, port_ch);
+	if (!port)
+		return CCMNI_ERR_TX_INVAL;
+
+	if (skb_headroom(skb) < CCCI_HEADER_SIZE)
+		return CCMNI_ERR_TX_INVAL;
+
+	/* downstream NET_ACK_TXQ_INDEX(): ack packets share the lower nibble
+	 * of the exception queue index
+	 */
+	if (is_ack)
+		qno = port->txq_exp == 0xFF ? port->txq :
+		      (port->txq_exp & 0x0F);
+	else
+		qno = ccci_port_txq(port);
+	if (qno >= CCCI_MAX_QUEUES)
+		return CCMNI_ERR_TX_INVAL;
+
+	ccci_h = (struct ccci_header *)skb_push(skb, CCCI_HEADER_SIZE);
+	memset(ccci_h, 0, CCCI_HEADER_SIZE);
+	ccci_h->data[0] = 0;
+	ccci_h->data[1] = skb->len;
+	ccci_h->channel = tx_ch;
+	ccci_h->reserved = 0;
+
+	port->tx_pkts++;
+	ret = ccci_md_send_skb(md, qno, skb);
+	if (ret == 0)
+		return CCMNI_ERR_TX_OK;
+
+	skb_pull(skb, CCCI_HEADER_SIZE);
+	if (ret == -EBUSY) {
+		port->tx_busy_cnt++;
+		return CCMNI_ERR_TX_BUSY;
+	}
+	return CCMNI_ERR_TX_INVAL;
+}
+
+/*
+ * Downstream ccmni_napi_poll() returns 0: the ECCCI/CCMNI split delivers Rx
+ * straight through ccmni_rx_callback(), the CCMNI napi is not the Rx path.
+ */
+static int ccci_ccmni_napi_poll(int md_id, int rx_ch, struct napi_struct *napi,
+				int weight)
+{
+	return 0;
+}
+
+static int ccci_net_port_init(struct ccci_port *port);
+
+/* ------------------------------------------------------------------ */
+/* Rx                                                                  */
+/* ------------------------------------------------------------------ */
+static int ccci_net_recv_skb(struct ccci_port *port, struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h = (struct ccci_header *)skb->data;
+	int idx = CCCI_CCMNI_IDX(port);
+
+	ccci_md_dbg(md, "rx net ch%u len%u idx%d\n", ccci_h->channel, skb->len,
+		    idx);
+
+	if (idx < 0 || idx >= 8) {
+		ccci_md_err(md, "bad ccmni index for port %s (minor 0x%x)\n",
+			    port->name, port->minor);
+		dev_kfree_skb_any(skb);
+		return -CCCI_ERR_DROP_PACKET;
+	}
+
+	/* CCMNI expects the L3 payload at skb->data; the 16 byte ccci header
+	 * leaves exactly the headroom it needs for the Ethernet header.
+	 */
+	skb_pull(skb, CCCI_HEADER_SIZE);
+	port->rx_pkts++;
+
+	/* consumes the skb in every path */
+	ccmni_rx_callback(md->id, idx, skb);
+	return 0;
+}
+
+static void ccci_net_md_state_notice(struct ccci_port *port, int event)
+{
+	struct ccci_md *md = port->md;
+	int idx = CCCI_CCMNI_IDX(port);
+
+	switch (event) {
+	case CCCI_MD_READY:
+	case CCCI_MD_EXCEPTION:
+	case CCCI_MD_STOPPED:
+		if (idx >= 0 && idx < 8)
+			ccmni_md_state_callback(md->id, idx, event);
+		break;
+	case CCCI_EV_TX_FULL:
+		port->rx_full = true;
+		break;
+	case CCCI_EV_TX_IRQ:
+		port->rx_full = false;
+		break;
+	default:
+		break;
+	}
+}
+
+const struct ccci_port_ops ccci_net_port_ops = {
+	.init = ccci_net_port_init,
+	.recv_skb = ccci_net_recv_skb,
+	.md_state_notice = ccci_net_md_state_notice,
+};
+
+/* ------------------------------------------------------------------ */
+/* per modem binding                                                   */
+/* ------------------------------------------------------------------ */
+int ccci_port_net_init(struct ccci_md *md)
+{
+	struct ccmni_ccci_ops *ops;
+	bool has_net = false;
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops == &ccci_net_port_ops) {
+			has_net = true;
+			break;
+		}
+	}
+	if (!has_net)
+		return 0;
+	if (md->ccmni_inited)
+		return 0;
+
+	ops = kzalloc(sizeof(*ops), GFP_KERNEL);
+	if (!ops)
+		return -ENOMEM;
+
+	ops->ccmni_ver = CCMNI_DRV_V0;
+	ops->ccmni_num = md->id == CCCI_MD_SYS1 ? 8 : 3;
+	strscpy(ops->name, md->id == CCCI_MD_SYS1 ? CCMNI_NAME_MD1 :
+		CCMNI_NAME_MD3, sizeof(ops->name));
+	ops->md_ability = md->capability | CCCI_MD_CAP_DATA_ACK_DVD;
+	ops->irat_md_id = md->irat_md_id;
+	ops->napi_poll_weigh = NAPI_POLL_WEIGHT;
+	ops->send_pkt = ccci_ccmni_send_pkt;
+	ops->napi_poll = ccci_ccmni_napi_poll;
+	ops->get_ccmni_ch = ccci_get_ccmni_channel;
+
+	md->ccmni_ops = ops;
+	if (ccmni_init(md->id, ops)) {
+		ccci_md_err(md, "ccmni_init failed\n");
+		md->ccmni_ops = NULL;
+		kfree(ops);
+		return -EINVAL;
+	}
+	md->ccmni_inited = true;
+	ccci_md_info(md, "%s bound (%u devices, ability 0x%x)\n", ops->name,
+		     ops->ccmni_num, ops->md_ability);
+	return 0;
+}
+
+void ccci_port_net_exit(struct ccci_md *md)
+{
+	if (!md->ccmni_inited)
+		return;
+	ccmni_exit(md->id);
+	md->ccmni_inited = false;
+	kfree(md->ccmni_ops);
+	md->ccmni_ops = NULL;
+}
+
+/* used by the net port init hook in the port table walk */
+static int ccci_net_port_init(struct ccci_port *port)
+{
+	return ccci_port_net_init(port->md);
+}
