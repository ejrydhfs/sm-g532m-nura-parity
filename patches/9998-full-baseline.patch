+static int aed_proc_init(void)
+{
+	aed_proc_dir = proc_mkdir("aed", NULL);
+	if (!aed_proc_dir)
+		return -ENOMEM;
+
+	aed_ee_coredump = proc_create(CURRENT_EE_COREDUMP, 0400, aed_proc_dir,
+				      &aed_ee_coredump_ops);
+	if (!aed_ee_coredump) {
+		remove_proc_entry("aed", NULL);
+		aed_proc_dir = NULL;
+		return -ENOMEM;
+	}
+
+	return 0;
+}
