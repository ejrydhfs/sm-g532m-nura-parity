+/* ------------------------------------------------------------------ */
+/* request/response framing: downstream rpc_msg_handler() 1927-2008    */
+/* ------------------------------------------------------------------ */
+static void ccci_rpc_reply_error(struct ccci_rpc_msg *rsp, int code)
+{
+	rsp->arg_count = 0;
+	ccci_rpc_rsp_u32(rsp, 0, code);
+}
+
+/*
+ * Build the response in a fresh skb: the request header is copied (op id,
+ * channel map, reserved request index are echoed), op_id gets the
+ * RPC_API_RESP_ID marker, channel becomes CCCI_RPC_TX and data[1] carries the
+ * new packet length, exactly as rpc_msg_handler() rewrites the request skb
+ * (port_kernel.c:1962-1995).
+ */
+static int ccci_rpc_send(struct ccci_port *port, struct sk_buff *req_skb,
+			 const struct ccci_rpc_msg *rsp)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *req_h = (struct ccci_header *)req_skb->data;
+	struct ccci_header *h;
+	struct sk_buff *skb;
+	unsigned int i, payload = 2 * sizeof(u32), total;
+	u32 op_id, count, len;
+	unsigned int retries;
+	u8 *ptr;
+	int ret;
+
+	for (i = 0; i < rsp->arg_count; i++)
+		payload += sizeof(u32) + ALIGN(rsp->args[i].len, 4);
+	if (payload > RPC_MAX_BUF_SIZE)
+		return -EMSGSIZE;
+
+	total = CCCI_HEADER_SIZE + payload;
+	skb = ccci_alloc_skb(total, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	h = skb_put(skb, CCCI_HEADER_SIZE);
+	memcpy(h, req_h, CCCI_HEADER_SIZE);
+	h->channel = CCCI_RPC_TX;
+	h->data[1] = total;
+
+	ptr = skb_put(skb, payload);
+	/* downstream ORs the marker into the request op id (port_kernel.c:1964) */
+	op_id = ((struct rpc_buffer *)req_skb->data)->op_id | RPC_API_RESP_ID;
+	count = rsp->arg_count;
+	memcpy(ptr, &op_id, sizeof(op_id));
+	ptr += sizeof(op_id);
+	memcpy(ptr, &count, sizeof(count));
+	ptr += sizeof(count);
+
+	for (i = 0; i < rsp->arg_count; i++) {
+		len = rsp->args[i].len;
+		memcpy(ptr, &len, sizeof(len));
+		ptr += sizeof(len);
+		if (len) {
+			memcpy(ptr, rsp->args[i].buf, len);
+			memset(ptr + len, 0, ALIGN(len, 4) - len);
+		}
+		ptr += ALIGN(len, 4);
+	}
+
+	port->tx_pkts++;
+	ret = ccci_md_send_skb(md, ccci_port_txq(port), skb);
+	if (ret == -EBUSY) {
+		/*
+		 * Downstream sends the response as a blocking request
+		 * (rpc_msg_handler() sets req->blocking = 1,
+		 * port_kernel.c:1998).  The kernel port thread may sleep, so
+		 * wait for room exactly as the char port does
+		 * (ccci_port_char.c:256-267).
+		 */
+		for (retries = 0; ret == -EBUSY && retries < 1000; retries++) {
+			usleep_range(1000, 2000);
+			ret = ccci_md_send_skb(md, ccci_port_txq(port), skb);
+		}
+	}
+	if (ret) {
+		port->tx_pkts--;
+		dev_kfree_skb_any(skb);
+	}
+	return ret;
+}
+
+void ccci_rpc_handle(struct ccci_port *port, struct sk_buff *skb)
+{
+	struct ccci_md *md;
+	struct rpc_buffer *rpc;
+	struct rpc_pkt pkt[RPC_MAX_ARG_NUM];
+	struct ccci_rpc_msg req, rsp;
+	struct ccci_rpc_service *svc;
+	unsigned int i, para_num, payload;
+	u32 op_id, len;
+	u8 *ptr, *end, *arena;
+	int ret;
+
+	if (!skb)
+		return;
+	if (!port || !port->md) {
+		dev_kfree_skb_any(skb);
+		return;
+	}
+	md = port->md;
+
+	if (skb->len < sizeof(struct rpc_buffer)) {
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	rpc = (struct rpc_buffer *)skb->data;
+	if (rpc->header.channel != CCCI_RPC_RX) {
+		ccci_md_err(md, "RPC packet on channel %u\n",
+			    rpc->header.channel);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	op_id = rpc->op_id;
+	para_num = rpc->para_num;
+	/* downstream sanity check (port_kernel.c:1942-1948) */
+	if (rpc->header.reserved > RPC_REQ_BUFFER_NUM ||
+	    para_num > RPC_MAX_ARG_NUM) {
+		ccci_md_err(md, "invalid RPC index %u/%u\n",
+			    rpc->header.reserved, para_num);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	ptr = rpc->buffer;
+	end = skb->data + skb->len;
+	for (i = 0; i < para_num; i++) {
+		if ((size_t)(end - ptr) < sizeof(u32))
+			goto malformed;
+		memcpy(&len, ptr, sizeof(len));
+		ptr += sizeof(len);
+		if (len > RPC_MAX_BUF_SIZE || (u32)(end - ptr) < len)
+			goto malformed;
+		pkt[i].len = len;
+		pkt[i].buf = ptr;
+		ptr += ALIGN(len, 4);
+		if (ptr > end)
+			goto malformed;
+	}
+	if (ptr - rpc->buffer > RPC_MAX_BUF_SIZE)
+		goto malformed;
+
+	arena = kmalloc(CCCI_RPC_ARENA_SIZE, GFP_KERNEL);
+	if (!arena) {
+		ccci_md_err(md, "RPC arena allocation failed\n");
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	memset(&req, 0, sizeof(req));
+	memset(&rsp, 0, sizeof(rsp));
+	req.op_id = op_id;
+	req.arg_count = para_num;
+	for (i = 0; i < para_num; i++) {
+		req.args[i].buf = pkt[i].buf;
+		req.args[i].len = pkt[i].len;
+	}
+	rsp.op_id = op_id;
+	for (i = 0; i < CCCI_RPC_MAX_ARGS; i++)
+		rsp.args[i].buf = arena + i * CCCI_RPC_ARG_SLOT;
+
+	svc = ccci_rpc_lookup(op_id);
+	if (svc) {
+		ret = svc->handler(md->id, &req, &rsp);
+		ccci_rpc_put(svc);
+		if (ret < 0)
+			ccci_rpc_reply_error(&rsp, ccci_rpc_errno_to_fs(ret));
+	} else {
+		ccci_md_dbg(md, "unknown RPC op 0x%08x\n", op_id);
+		ccci_rpc_reply_error(&rsp, FS_NO_OP);
+	}
+
+	if (rsp.arg_count > RPC_MAX_ARG_NUM) {
+		ccci_md_err(md, "invalid RPC response for 0x%08x\n", op_id);
+		ccci_rpc_reply_error(&rsp, FS_ERROR_RESERVED);
+	}
+
+	payload = 2 * sizeof(u32);
+	for (i = 0; i < rsp.arg_count; i++) {
+		if (rsp.args[i].len > RPC_MAX_BUF_SIZE ||
+		    (rsp.args[i].len && !rsp.args[i].buf))
+			break;
+		payload += sizeof(u32) + ALIGN(rsp.args[i].len, 4);
+	}
+	if (i != rsp.arg_count || payload > RPC_MAX_BUF_SIZE) {
+		ccci_md_err(md, "RPC response 0x%08x overflow\n", op_id);
+		ccci_rpc_reply_error(&rsp, FS_MEM_OVERFLOW);
+	}
+
+	ret = ccci_rpc_send(port, skb, &rsp);
+	if (ret)
+		ccci_md_err(md, "RPC response 0x%08x send failed %d\n",
+			    op_id, ret);
+
+	kfree(arena);
+	dev_kfree_skb_any(skb);
+	return;
+
+malformed:
+	ccci_md_err(md, "malformed RPC request 0x%08x\n", op_id);
+	dev_kfree_skb_any(skb);
+}
+
+/* ------------------------------------------------------------------ */
+/* init/exit                                                           */
+/* ------------------------------------------------------------------ */
+int ccci_rpc_init(void)
+{
+	unsigned int i;
+	int ret;
+
+	/* the largest built-in response is the 10-pin GPIO/ADC block */
+	BUILD_BUG_ON(sizeof(struct ccci_rpc_gpio_adc_output_v2) >
+		     CCCI_RPC_ARG_SLOT);
+
+	mutex_lock(&ccci_rpc_lock);
+	if (ccci_rpc_ready) {
+		mutex_unlock(&ccci_rpc_lock);
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(ccci_rpc_builtins); i++) {
+		ret = __ccci_rpc_register(ccci_rpc_builtins[i].op_id,
+					  ccci_rpc_builtins[i].name,
+					  ccci_rpc_builtins[i].handler);
+		if (ret)
+			goto err;
+	}
+	ccci_rpc_ready = true;
+	mutex_unlock(&ccci_rpc_lock);
+
+	/* downstream ccci_subsys_kernel_init() (port_kernel.c:2255-2259) */
+	ccci_rpc_eint_load();
+	return 0;
+
+err:
+	while (!list_empty(&ccci_rpc_services)) {
+		struct ccci_rpc_service *svc;
+
+		svc = list_first_entry(&ccci_rpc_services,
+				       struct ccci_rpc_service, node);
+		list_del(&svc->node);
+		kfree(svc->name);
+		kfree(svc);
+	}
+	mutex_unlock(&ccci_rpc_lock);
+	return ret;
+}
+
+void ccci_rpc_exit(void)
+{
+	struct ccci_rpc_service *svc, *tmp;
+
+	mutex_lock(&ccci_rpc_lock);
+	if (!ccci_rpc_ready) {
+		mutex_unlock(&ccci_rpc_lock);
+		return;
+	}
+	ccci_rpc_ready = false;
+	list_for_each_entry_safe(svc, tmp, &ccci_rpc_services, node) {
+		list_del(&svc->node);
+		ccci_rpc_put(svc);
+	}
+	mutex_unlock(&ccci_rpc_lock);
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_rpc.h b/drivers/misc/mediatek/ccci/ccci_rpc.h
new file mode 100644
index 000000000..201454ae3
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_rpc.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CCCI kernel RPC: wire format and engine internals.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_kernel.h and port_kernel.c.  Original
+ * copyright (C) 2015 MediaTek Inc., GPL-2.0.
+ *
+ * The op ids, argument layouts and result codes below are the modem
+ * firmware ABI and are copied verbatim from the downstream header; they must
+ * not be changed.  The registration API itself is the frozen scaffold API in
+ * include/linux/ccci.h.
+ */
+#ifndef __CCCI_RPC_H__
+#define __CCCI_RPC_H__
+
+#include <linux/ccci.h>
+#include <linux/skbuff.h>
+#include <linux/types.h>
+
+struct ccci_port;
+
+/* ------------------------------------------------------------------ */
+/* RPC op ids (downstream eccci/port_kernel.h:107-146 RPC_OP_ID)       */
+/* ------------------------------------------------------------------ */
+enum ccci_rpc_op_id {
+	IPC_RPC_CPSVC_SECURE_ALGO_OP	= 0x2001,
+	IPC_RPC_GET_SECRO_OP		= 0x2002,
+
+	IPC_RPC_GET_TDD_EINT_NUM_OP	= 0x4001,
+	IPC_RPC_GET_GPIO_NUM_OP		= 0x4002,
+	IPC_RPC_GET_ADC_NUM_OP		= 0x4003,
+	IPC_RPC_GET_EMI_CLK_TYPE_OP	= 0x4004,
+	IPC_RPC_GET_EINT_ATTR_OP	= 0x4005,
+	IPC_RPC_GET_GPIO_VAL_OP		= 0x4006,
+	IPC_RPC_GET_ADC_VAL_OP		= 0x4007,
+	IPC_RPC_GET_RF_CLK_BUF_OP	= 0x4008,
+	IPC_RPC_GET_GPIO_ADC_OP		= 0x4009,
+	IPC_RPC_USIM2NFC_OP		= 0x400A,
+	IPC_RPC_DSP_EMI_MPU_SETTING	= 0x400B,
+	IPC_RPC_CCCI_QUEUE_MAPPING	= 0x400C,
+
+	IPC_RPC_IT_OP			= 0x4321,
+};
+
+/* ------------------------------------------------------------------ */
+/* Wire format (downstream port_kernel.h:147-242)                      */
+/* ------------------------------------------------------------------ */
+struct rpc_pkt {
+	unsigned int len;
+	void *buf;
+} __packed;
+
+struct rpc_buffer {
+	struct ccci_header header;
+	u32 op_id;
+	u32 para_num;
+	u8 buffer[];
+} __packed;
+
+#define RPC_REQ_BUFFER_NUM	2	/* concurrent requests the MD may have */
+#define RPC_MAX_ARG_NUM		6	/* arguments per request */
+#define RPC_MAX_BUF_SIZE	2048
+#define RPC_API_RESP_ID		0xFFFF0000
+
+/* Result codes, downstream FS_* */
+#define FS_NO_ERROR		0
+#define FS_NO_OP		(-1)
+#define FS_PARAM_ERROR		(-2)
+#define FS_NO_FEATURE		(-3)
+#define FS_NO_MATCH		(-4)
+#define FS_FUNC_FAIL		(-5)
+#define FS_ERROR_RESERVED	(-6)
+#define FS_MEM_OVERFLOW		(-7)
+
+/* ------------------------------------------------------------------ */
+/* GPIO / ADC / clock buffer payloads                                  */
+/* ------------------------------------------------------------------ */
+/* CONFIG_MTK_TC1_FEATURE is not set in this ROM build (no LGE op ids),
+ * therefore the v1 GPIO count is 3 as in downstream port_kernel.h:173.
+ */
+#define GPIO_MAX_COUNT			3
+#define GPIO_MAX_COUNT_V2		10
+#define GPIO_PIN_NAME_STR_MAX_LEN	34
+#define ADC_CH_NAME_STR_MAX_LEN		33
+
+enum ccci_rpc_req_mask {
+	RPC_REQ_GPIO_PIN	= BIT(0),
+	RPC_REQ_GPIO_VALUE	= BIT(1),
+	RPC_REQ_ADC_PIN		= BIT(4),
+	RPC_REQ_ADC_VALUE	= BIT(5),
+};
+
+struct ccci_rpc_gpio_adc_input {
+	u8 reqMask;
+	u8 gpioValidPinMask;
+	char gpioPinName[GPIO_MAX_COUNT][GPIO_PIN_NAME_STR_MAX_LEN];
+	u32 gpioPinNum[GPIO_MAX_COUNT];
+	char adcChName[ADC_CH_NAME_STR_MAX_LEN];
+	u32 adcChNum;
+	u32 adcChMeasCount;
+} __packed;
+
+struct ccci_rpc_gpio_adc_output {
+	u32 gpioPinNum[GPIO_MAX_COUNT];
+	u32 gpioPinValue[GPIO_MAX_COUNT];
+	u32 adcChNum;
+	u32 adcChMeasSum;
+} __packed;
+
+struct ccci_rpc_gpio_adc_input_v2 {
+	u16 reqMask;
+	u16 gpioValidPinMask;
+	char gpioPinName[GPIO_MAX_COUNT_V2][GPIO_PIN_NAME_STR_MAX_LEN];
+	u32 gpioPinNum[GPIO_MAX_COUNT_V2];
+	char adcChName[ADC_CH_NAME_STR_MAX_LEN];
+	u32 adcChNum;
+	u32 adcChMeasCount;
+} __packed;
+
+struct ccci_rpc_gpio_adc_output_v2 {
+	u32 gpioPinNum[GPIO_MAX_COUNT_V2];
+	u32 gpioPinValue[GPIO_MAX_COUNT_V2];
+	u32 adcChNum;
+	u32 adcChMeasSum;
+} __packed;
+
+struct ccci_rpc_dsp_emi_mpu_input {
+	u32 request;
+} __packed;
+
+struct ccci_rpc_usim2nfs {
+	u8 lock_vsim1;
+} __packed;
+
+#define MAX_CHANNEL_QUEUE_MAPPING	10
+struct ccci_rpc_queue_mapping {
+	u32 ch_cnt;
+	struct {
+		u32 channel;
+		union {
+			u32 queue_type;
+			u32 hif_q_type;
+		};
+	} ch_queue_mapping[MAX_CHANNEL_QUEUE_MAPPING];
+} __packed;
+
+#define CLKBUF_MAX_COUNT	4
+struct ccci_rpc_clkbuf_result {
+	u16 CLKBuf_Count;
+	u8 CLKBuf_Status[CLKBUF_MAX_COUNT];
+	u8 CLKBuf_SWCtrl_Status[CLKBUF_MAX_COUNT];
+} __packed;
+
+/* ------------------------------------------------------------------ */
+/* SIM hot plug EINT attribute query                                   */
+/* (downstream port_kernel.h:265-300, FEATURE_GET_MD_EINT_ATTR_DTS)    */
+/* ------------------------------------------------------------------ */
+#define CCCI_RPC_MD_SIM_MAX	16
+
+enum sim_hot_plug_eint_query_type {
+	SIM_HOT_PLUG_EINT_NUMBER,
+	SIM_HOT_PLUG_EINT_DEBOUNCETIME,
+	SIM_HOT_PLUG_EINT_POLARITY,
+	SIM_HOT_PLUG_EINT_SENSITIVITY,
+	SIM_HOT_PLUG_EINT_SOCKETTYPE,
+	SIM_HOT_PLUG_EINT_DEDICATEDEN,
+	SIM_HOT_PLUG_EINT_SRCPIN,
+
+	SIM_HOT_PLUG_EINT_MAX,
+};
+
+enum sim_hot_plug_eint_query_err {
+	ERR_SIM_HOT_PLUG_NULL_POINTER = -13,
+	ERR_SIM_HOT_PLUG_QUERY_TYPE,
+	ERR_SIM_HOT_PLUG_QUERY_STRING,
+};
+
+/* ------------------------------------------------------------------ */
+/* Engine                                                              */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Response staging arena.  Before a handler is called the engine sets every
+ * rsp->args[i].buf to this arena (rsp->args[i].len stays 0).  A handler may
+ * lay its results out inside the arena and point the args at them; it may
+ * also point an argument at any other buffer that remains valid until the
+ * handler returns.  The engine copies the arguments into the Rx skb and
+ * sends it back on CCCI_RPC_TX.
+ */
+#define CCCI_RPC_ARENA_SIZE	RPC_MAX_BUF_SIZE
+
+/*
+ * Longest modem-supplied name (GPIO/ADC/EINT) the engine copies out of a
+ * request: the downstream buffers are 64 bytes (port_kernel.c:1492,1509) and
+ * the wire names are at most 34 bytes (GPIO_PIN_NAME_STR_MAX_LEN).
+ */
+#define CCCI_RPC_NAME_MAX	64
+
+int ccci_rpc_init(void);
+void ccci_rpc_exit(void);
+
+/*
+ * ccci_rpc_handle - answer one CCCI_RPC_RX request
+ *
+ * Always consumes @skb (either sends it back with the response or frees it)
+ * and must be called from process context (the kernel port thread).
+ */
+void ccci_rpc_handle(struct ccci_port *port, struct sk_buff *skb);
+
+#endif /* __CCCI_RPC_H__ */
diff --git a/drivers/misc/mediatek/ccci/ccci_sysfs.c b/drivers/misc/mediatek/ccci/ccci_sysfs.c
new file mode 100644
index 000000000..ddd43d431
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_sysfs.c
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI per-modem sysfs attributes and debugfs views.
+ *
+ * Attribute names follow the Samsung/MTK ROM service set
+ * (md_enable/version/md_state/dump/boot_info/md_exception, see downstream
+ * ccci_util_lib_sys.c for the global /sys/kernel/ccci variant).  Here they are
+ * attached to the per-modem device /sys/class/ccci_node/mdN and duplicated in
+ * debugfs ccci/mdN, which the ccci_util log driver also populates.
+ */
+#include <linux/ccci.h>
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "ccci_priv.h"
+
+static struct dentry *ccci_debugfs_root;
+
+/* ------------------------------------------------------------------ */
+/* text helpers                                                        */
+/* ------------------------------------------------------------------ */
+static const char *ccci_state_name(enum ccci_md_state state)
+{
+	switch (state) {
+	case CCCI_MD_BOOTING:
+		return "boot";
+	case CCCI_MD_READY:
+		return "ready";
+	case CCCI_MD_EXCEPTION:
+		return "exception";
+	case CCCI_MD_STOPPED:
+		return "stop";
+	case CCCI_MD_INVALID:
+	default:
+		return "invalid";
+	}
+}
+
+static int ccci_show_version(struct ccci_md *md, char *buf, size_t len)
+{
+	return scnprintf(buf, len, "%u\n", CCCI_DRIVER_VER);
+}
+
+static int ccci_show_state(struct ccci_md *md, char *buf, size_t len)
+{
+	return scnprintf(buf, len, "%s, boot stage %u, ex stage %u\n",
+			 ccci_state_name(md->state), md->boot_stage,
+			 md->ex_stage);
+}
+
+static int ccci_show_boot_info(struct ccci_md *md, char *buf, size_t len)
+{
+	if (!md->boot_info[0])
+		return scnprintf(buf, len, "not loaded\n");
+	return scnprintf(buf, len, "%s", md->boot_info);
+}
+
+static int ccci_show_exception(struct ccci_md *md, char *buf, size_t len)
+{
+	return scnprintf(buf, len, "type %u, stage %u, state %s\n", md->ex_type,
+			 md->ex_stage, ccci_state_name(md->state));
+}
+
+static int ccci_show_enable(struct ccci_md *md, char *buf, size_t len)
+{
+	bool up = md->state != CCCI_MD_STOPPED && md->state != CCCI_MD_INVALID;
+
+	return scnprintf(buf, len, "%d\n", up);
+}
+
+static int ccci_store_enable(struct ccci_md *md, const char *buf, size_t len)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	if (enable)
+		ret = ccci_md_start(md);
+	else
+		ret = ccci_md_stop(md, 0);
+	return ret ? ret : len;
+}
+
+static int ccci_store_dump(struct ccci_md *md, const char *buf, size_t len)
+{
+	struct ccci_port *port;
+
+	ccci_md_info(md, "state %s, boot %u, ex %u, fw %s\n",
+		     ccci_state_name(md->state), md->boot_stage, md->ex_stage,
+		     md->boot.file_name[0] ? md->boot.file_name : "none");
+	ccci_ccif_dump_regs(md, NULL);
+	list_for_each_entry(port, &md->ports_list, node)
+		ccci_md_info(md, "port %-18s ch %3u/%-3u q %2u/%-3u rx %llu tx %llu drop %llu busy %llu\n",
+			     port->name, port->tx_ch, port->rx_ch, port->txq,
+			     port->rxq, port->rx_pkts, port->tx_pkts,
+			     port->rx_drops, port->tx_busy_cnt);
+	return len;
+}
+
+/* ------------------------------------------------------------------ */
+/* sysfs                                                               */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_md_enable_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	return ccci_show_enable(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+
+static ssize_t ccci_md_enable_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	return ccci_store_enable(dev_get_drvdata(dev), buf, count);
+}
+static DEVICE_ATTR_RW(ccci_md_enable);
+
+static ssize_t ccci_version_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	return ccci_show_version(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_version);
+
+static ssize_t ccci_md_state_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	return ccci_show_state(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_md_state);
+
+static ssize_t ccci_boot_info_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	return ccci_show_boot_info(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_boot_info);
+
+static ssize_t ccci_md_exception_show(struct device *dev,
+				      struct device_attribute *attr,
+				      char *buf)
+{
+	return ccci_show_exception(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_md_exception);
+
+static ssize_t ccci_dump_store(struct device *dev,
+			       struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	return ccci_store_dump(dev_get_drvdata(dev), buf, count);
+}
+static DEVICE_ATTR_WO(ccci_dump);
+
+static struct attribute *ccci_md_attrs[] = {
+	&dev_attr_ccci_md_enable.attr,
+	&dev_attr_ccci_version.attr,
+	&dev_attr_ccci_md_state.attr,
+	&dev_attr_ccci_dump.attr,
+	&dev_attr_ccci_boot_info.attr,
+	&dev_attr_ccci_md_exception.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(ccci_md);
+
+/* ------------------------------------------------------------------ */
+/* debugfs                                                             */
+/* ------------------------------------------------------------------ */
+static int ccci_dbg_version_show(struct seq_file *s, void *unused)
+{
+	char buf[32];
+
+	ccci_show_version(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static int ccci_dbg_state_show(struct seq_file *s, void *unused)
+{
+	struct ccci_md *md = s->private;
+	struct ccci_port *port;
+
+	seq_printf(s, "md%u: %s\n", md->id + 1, ccci_state_name(md->state));
+	seq_printf(s, "transport: %s\n",
+		   md->cldma ? "cldma" : (md->ring_mode ? "ccif-ring" : "none"));
+	seq_printf(s, "fw: %s (%u bytes)\n",
+		   md->boot.file_name[0] ? md->boot.file_name : "none",
+		   md->boot.md_img_size);
+	seq_printf(s, "smem: %pa + 0x%zx\n", &md->smem_phy, md->smem_size);
+	list_for_each_entry(port, &md->ports_list, node)
+		seq_printf(s, "  %-18s ch %3u/%-3u q %2u/%-3u rx %llu tx %llu\n",
+			   port->name, port->tx_ch, port->rx_ch, port->txq,
+			   port->rxq, port->rx_pkts, port->tx_pkts);
+	return 0;
+}
+
+static int ccci_dbg_ccif_show(struct seq_file *s, void *unused)
+{
+	ccci_ccif_dump_regs(s->private, s);
+	return 0;
+}
+
+static int ccci_dbg_boot_show(struct seq_file *s, void *unused)
+{
+	char buf[256];
+
+	ccci_show_boot_info(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static int ccci_dbg_exception_show(struct seq_file *s, void *unused)
+{
+	char buf[128];
+
+	ccci_show_exception(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static int ccci_dbg_enable_show(struct seq_file *s, void *unused)
+{
+	char buf[16];
+
+	ccci_show_enable(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static ssize_t ccci_dbg_enable_write(struct file *file,
+				     const char __user *ubuf, size_t len,
+				     loff_t *ppos)
+{
+	struct ccci_md *md = file_inode(file)->i_private;
+	char buf[16];
+	size_t n = min(len, sizeof(buf) - 1);
+	int ret;
+
+	if (copy_from_user(buf, ubuf, n))
+		return -EFAULT;
+	buf[n] = 0;
+	ret = ccci_store_enable(md, buf, n);
+	return ret < 0 ? ret : n;
+}
+
+static int ccci_dbg_enable_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ccci_dbg_enable_show, inode->i_private);
+}
+
+static const struct file_operations ccci_dbg_enable_fops = {
+	.owner = THIS_MODULE,
+	.open = ccci_dbg_enable_open,
+	.read = seq_read,
+	.write = ccci_dbg_enable_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+#define CCCI_DBG_SEQ_FOPS(_name, _showfn)				\
+static int _name##_open(struct inode *inode, struct file *file)		\
+{									\
+	return single_open(file, _showfn, inode->i_private);		\
+}									\
+static const struct file_operations _name##_fops = {			\
+	.owner = THIS_MODULE,						\
+	.open = _name##_open,						\
+	.read = seq_read,						\
+	.llseek = seq_lseek,						\
+	.release = single_release,					\
+}
+
+CCCI_DBG_SEQ_FOPS(ccci_dbg_version, ccci_dbg_version_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_state, ccci_dbg_state_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_ccif, ccci_dbg_ccif_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_boot, ccci_dbg_boot_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_exception, ccci_dbg_exception_show);
+
+static struct dentry *ccci_dbg_dir_get(struct ccci_md *md)
+{
+	struct dentry *dir;
+	char name[16];
+
+	if (!ccci_debugfs_root)
+		return NULL;
+
+	snprintf(name, sizeof(name), "md%u", md->id + 1);
+	dir = debugfs_lookup(name, ccci_debugfs_root);
+	if (IS_ERR_OR_NULL(dir)) {
+		dir = debugfs_create_dir(name, ccci_debugfs_root);
+		if (IS_ERR(dir))
+			return NULL;
+	}
+	return dir;
+}
+
+int ccci_sysfs_md_init(struct ccci_md *md)
+{
+	int ret;
+
+	ret = sysfs_create_groups(&md->dev->kobj, ccci_md_groups);
+	if (ret)
+		return ret;
+
+	md->dbg_dir = ccci_dbg_dir_get(md);
+	if (!md->dbg_dir)
+		return 0;	/* debugfs is optional */
+
+	debugfs_create_file("ccci_version", 0444, md->dbg_dir, md,
+			    &ccci_dbg_version_fops);
+	debugfs_create_file("ccci_md_state", 0444, md->dbg_dir, md,
+			    &ccci_dbg_state_fops);
+	debugfs_create_file("ccci_md_enable", 0644, md->dbg_dir, md,
+			    &ccci_dbg_enable_fops);
+	debugfs_create_file("ccci_boot_info", 0444, md->dbg_dir, md,
+			    &ccci_dbg_boot_fops);
+	debugfs_create_file("ccci_md_exception", 0444, md->dbg_dir, md,
+			    &ccci_dbg_exception_fops);
+	debugfs_create_file("ccif", 0444, md->dbg_dir, md, &ccci_dbg_ccif_fops);
+	return 0;
+}
+
+void ccci_sysfs_md_exit(struct ccci_md *md)
+{
+	if (!md->dev)
+		return;
+	sysfs_remove_groups(&md->dev->kobj, ccci_md_groups);
+	md->dbg_dir = NULL;	/* the util log driver owns the directory */
+}
+
+int ccci_sysfs_init(void)
+{
+	ccci_debugfs_root = debugfs_create_dir("ccci", NULL);
+	if (IS_ERR(ccci_debugfs_root)) {
+		pr_warn("ccci: debugfs unavailable (%ld)\n",
+			PTR_ERR(ccci_debugfs_root));
+		ccci_debugfs_root = NULL;
+	}
+	return 0;
+}
+
+void ccci_sysfs_exit(void)
+{
+	if (ccci_debugfs_root)
+		debugfs_remove(ccci_debugfs_root);
+	ccci_debugfs_root = NULL;
+}
diff --git a/drivers/misc/mediatek/ccci_c2k/Kconfig b/drivers/misc/mediatek/ccci_c2k/Kconfig
