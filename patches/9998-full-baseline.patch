+		ret = simple_read_from_buffer(buf, count, pos,
+					      aed_dev.eerec->ee_phy,
+					      aed_dev.eerec->ee_phy_size);
+	}
+	mutex_unlock(&aed_dev.msg_lock);
+
+	return ret;
+}
