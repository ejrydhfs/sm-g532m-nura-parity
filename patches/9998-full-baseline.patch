+				      ISP_IRQ_P1_AF_DON | ISP_IRQ_P1_AF_DON;
+	p->flush_v1[ISP_IRQ_USER_EIS] = ISP_IRQ_P1_VS1 | ISP_IRQ_P1_VS1 |
