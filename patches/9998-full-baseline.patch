+#define S2MU005_VBUS_STATUS_OVP		2
+#define S2MU005_VBUS_STATUS_GOOD_1	3
+#define S2MU005_VBUS_STATUS_GOOD_2	5
+
+/* SC_CTRL0 */
+#define S2MU005_CHG_MODE_MASK		GENMASK(2, 0)
