+	memset(p->dma_err, 0, sizeof(p->dma_err));
+	memset(p->int_err, 0, sizeof(p->int_err));
+	memset(p->sof_count, 0, sizeof(p->sof_count));
+	memset(p->start_time, 0, sizeof(p->start_time));
