+/* mt6627_pwrdown(), mt6627_fm_cmd.c:512-551 */
+static int mtk_wcn_fm_send_pwrdown(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_pkt pkt;
+	int i;
+	int ret;
+
+	mutex_lock(&fm->cmd_lock);
+	mtk_wcn_fm_pkt_init(&pkt, fm->cmd_buf, sizeof(fm->cmd_buf),
+			    FM_ENABLE_OPCODE);
+	/* audio output to I2S TX mode off */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_REG_AUDIO_CTRL0,
+						       0xfff8, 0x0000,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* disable HW clock control */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_CLK_CTRL,
+							   0x0000330f,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	/* reset ASIP */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_write(FM_MAIN_CG2_CTRL, 0x0001,
+						      pkt.buf + pkt.len,
+						      pkt.cap - pkt.len));
+	/* digital core + register file reset */
+	for (i = 0; i < 4; i++)
+		mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_RESET,
+							       0xfff8, 0x0000,
+							       pkt.buf + pkt.len,
+							       pkt.cap - pkt.len));
+	/* disable all clocks */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_CLK_CTRL,
+							   0x00000000,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	/* reset the RF register file */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_CLK_CTRL,
+							   0x00004000,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_CLK_CTRL,
+							   0x00000000,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	/* MTCMOS power off */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_MTCMOS,
+							   0x00000005,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_MTCMOS,
+							   0x00000015,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_MTCMOS,
+							   0x00000035,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_write(FM_TOP_REG_MTCMOS,
+							   0x00000030,
+							   pkt.buf + pkt.len,
+							   pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_top_rd_until(FM_TOP_REG_MTCMOS,
+							     0x0000000a, 0x0,
+							     pkt.buf + pkt.len,
+							     pkt.cap - pkt.len));
+	ret = mtk_wcn_fm_send(fm, &pkt, FM_EVT_BIT(FM_ENABLE_OPCODE),
+			      FM_EN_TIMEOUT);
+	mutex_unlock(&fm->cmd_lock);
+
+	return ret;
+}
+
+/* mt6627_get_rom_version(), mt6627_fm_lib.c:447-485 */
+static int mtk_wcn_fm_get_rom_version(struct mtk_wcn_fm_dev *fm)
+{
+	unsigned long deadline = jiffies + 10 * HZ;
+	u16 tmp = 0;
+	int ret;
+
+	/* DSP ROM code version request enable (0x61 b15 = 1) */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_MAIN_CG2_CTRL, 0x8000, 0x7fff);
+	if (ret)
+		return ret;
+	/* release ASIP reset (0x61 b1 = 1) */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_MAIN_CG2_CTRL, 0x0002, 0xfffd);
+	if (ret)
+		return ret;
+	/* enable ASIP power (0x61 b0 = 0) */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_MAIN_CG2_CTRL, 0x0000, 0xfffe);
+	if (ret)
+		return ret;
+
+	do {
+		usleep_range(1000, 1500);
+		ret = mtk_wcn_fm_reg_read(fm, FM_REG_DSP_ROM_READY, &tmp);
+		if (ret)
+			return ret;
+	} while (tmp != 0x0001 && time_before(jiffies, deadline));
+
+	if (tmp != 0x0001) {
+		dev_err(fm->dev, "DSP ROM version never became ready\n");
+		return -ETIMEDOUT;
+	}
+
+	/* DSP code version is reported in 0x83[15:8] */
+	ret = mtk_wcn_fm_reg_read(fm, FM_REG_DSP_ROM_VERSION, &tmp);
+	if (ret)
+		return ret;
+	tmp >>= 8;
+
+	/* request disable (0x61 b15 = 0) */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_MAIN_CG2_CTRL, 0x0000, 0x7fff);
+	if (ret)
+		return ret;
+	/* reset ASIP (0x61[1:0] = 1) */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_MAIN_CG2_CTRL, 0x0001, 0xfffc);
+	if (ret)
+		return ret;
+
+	return tmp;
+}
+
+/*
+ * Load a DSP image for the running DSP ROM version.  Downstream's patch
+ * lookup requires an exact match (mt6627_get_patch_path() returns 1 on the
+ * fallback and mt6627_PowerUp() treats that as an error,
+ * mt6627_fm_lib.c:487-513, 775-784), while the coefficient lookup falls back
+ * to the newest file and then disables the patch selector
+ * (mt6627_fm_lib.c:515-547, 806-809).
+ */
+static int mtk_wcn_fm_fw_request(struct mtk_wcn_fm_dev *fm,
+				 const char *const *names, int rom_ver,
+				 bool allow_fallback,
+				 const struct firmware **fw, bool *exact)
+{
+	int i, ret;
+
+	*exact = false;
+	if (rom_ver >= FM_MT6627_ROM_VER_MIN &&
+	    rom_ver <= FM_MT6627_ROM_VER_MAX) {
+		ret = request_firmware(fw, names[rom_ver - 1], fm->dev);
+		if (!ret) {
+			*exact = true;
+			return 0;
+		}
+	}
+
+	if (!allow_fallback)
+		return -ENOENT;
+
+	for (i = FM_MT6627_ROM_VER_MAX - 1; i >= 0; i--) {
+		ret = request_firmware(fw, names[i], fm->dev);
+		if (!ret) {
+			dev_warn(fm->dev,
+				 "no image for DSP ROM v%d, using %s\n",
+				 rom_ver, names[i]);
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+/* mt6627_DspPatch(), mt6627_fm_lib.c:549-662 */
+static int mtk_wcn_fm_dsp_patch(struct mtk_wcn_fm_dev *fm, const u8 *img,
+				size_t len, bool is_patch)
+{
+	u8 opcode = is_patch ? FM_PATCH_DOWNLOAD_OPCODE :
+			       FM_COEFF_DOWNLOAD_OPCODE;
+	u64 mask = FM_EVT_BIT(opcode);
+	unsigned int timeout = is_patch ? FM_PATCH_TIMEOUT : FM_COEFF_TIMEOUT;
+	u8 seg_num, seg_id;
+	int seg_len, ret;
+	u16 pkt_len;
+
+	if (!img || !len)
+		return -EINVAL;
+	if (len > U8_MAX * FM_MT6627_PATCH_SEG_LEN)
+		return -EFBIG;
+
+	seg_num = len / FM_MT6627_PATCH_SEG_LEN + 1;
+
+	for (seg_id = 0; seg_id < seg_num; seg_id++) {
+		seg_len = ((seg_id + 1) < seg_num) ? FM_MT6627_PATCH_SEG_LEN :
+						     (len % FM_MT6627_PATCH_SEG_LEN);
+
+		mutex_lock(&fm->cmd_lock);
+		fm->cmd_buf[0] = FM_PKT_TYPE_CMD;
+		fm->cmd_buf[1] = opcode;
+		fm->cmd_buf[4] = seg_num;
+		fm->cmd_buf[5] = seg_id;
+		if (seg_len > (sizeof(fm->cmd_buf) - 6)) {
+			mutex_unlock(&fm->cmd_lock);
+			return -ENOSPC;
+		}
+		memcpy(&fm->cmd_buf[6], img + seg_id * FM_MT6627_PATCH_SEG_LEN,
+		       seg_len);
+		pkt_len = 6 + seg_len;
+		fm->cmd_buf[2] = (pkt_len - 4) & 0xff;
+		fm->cmd_buf[3] = ((pkt_len - 4) >> 8) & 0xff;
+		ret = mtk_wcn_fm_cmd_tx(fm, fm->cmd_buf, pkt_len, mask, timeout);
+		mutex_unlock(&fm->cmd_lock);
+		if (ret) {
+			dev_err(fm->dev, "DSP image segment %d/%d failed (%d)\n",
+				seg_id + 1, seg_num, ret);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * Full power up.  Sequence order and every value come from
+ * mt6627_PowerUp(), mt6627_fm_lib.c:664-863.
+ */
+static int mtk_wcn_fm_power_up_seq(struct mtk_wcn_fm_dev *fm)
+{
+	const struct firmware *patch = NULL, *coeff = NULL;
+	bool exact = false;
+	u8 *img = NULL;
+	size_t len;
+	u16 chip_id = 0;
+	int rom_ver, ret;
+
+	/* step 1: common SPI parameter */
+	ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_CSPI_CFG, 0x0000801f);
+	if (ret) {
+		dev_err(fm->dev, "cannot configure CSPI (%d)\n", ret);
+		return ret;
+	}
+
+	/* step 2: FM digital clock on */
+	ret = mtk_wcn_fm_send_pwrup_clock_on(fm);
+	if (ret) {
+		dev_err(fm->dev, "clock on sequence failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* read back the chip id */
+	ret = mtk_wcn_fm_reg_read(fm, FM_MAIN_HWVER, &chip_id);
+	if (ret) {
+		dev_err(fm->dev, "cannot read chip id (%d)\n", ret);
+		return ret;
+	}
+	if (chip_id != FM_MT6627_CHIP_ID && chip_id != FM_MT6625_CHIP_ID) {
+		dev_err(fm->dev, "unexpected FM chip id 0x%04x\n", chip_id);
+		return -EIO;
+	}
+	fm->hw.chip_id = chip_id;
+	fm->hw.eco_ver = mtk_wcn_wmt_hwver_get() + 1;
+	dev_info(fm->dev, "MT6627 FM: chip 0x%04x, ECO %d\n", chip_id,
+		 fm->hw.eco_ver);
+
+	rom_ver = mtk_wcn_fm_get_rom_version(fm);
+	if (rom_ver < 0) {
+		dev_err(fm->dev, "cannot read DSP ROM version (%d)\n", rom_ver);
+		return rom_ver;
+	}
+	fm->hw.rom_ver = rom_ver;
+
+	/* step 3: download the DSP patch (exact ROM version required) */
+	ret = mtk_wcn_fm_fw_request(fm, mtk_wcn_fm_patch_names, rom_ver, false,
+				    &patch, &exact);
+	if (ret) {
+		dev_err(fm->dev,
+			"DSP patch mt6627/mt6627_fm_v%d_patch.bin not available\n",
+			rom_ver);
+		return ret;
+	}
+	ret = mtk_wcn_fm_dsp_patch(fm, patch->data, patch->size, true);
+	release_firmware(patch);
+	if (ret)
+		return ret;
+
+	/* ... and the DSP coefficients (fallback allowed) */
+	ret = mtk_wcn_fm_fw_request(fm, mtk_wcn_fm_coeff_names, rom_ver, true,
+				    &coeff, &exact);
+	if (ret) {
+		dev_err(fm->dev,
+			"DSP coefficient mt6627/mt6627_fm_v%d_coeff.bin not available\n",
+			rom_ver);
+		return ret;
+	}
+
+	img = kmalloc(FM_MT6627_PATCH_BUF_SIZE, GFP_KERNEL);
+	if (!img) {
+		release_firmware(coeff);
+		return -ENOMEM;
+	}
+	len = min_t(size_t, coeff->size, FM_MT6627_PATCH_BUF_SIZE);
+	memcpy(img, coeff->data, len);
+	release_firmware(coeff);
+
+	if (!exact) {
+		/* Unknown ROM version: the downstream driver clears the patch
+		 * selector words so the DSP keeps running on its ROM code
+		 * (mt6627_fm_lib.c:807-809).
+		 */
+		if (len > 5) {
+			img[4] = 0x00;
+			img[5] = 0x00;
+		}
+	}
+	if (len >= 40)
+		fm->hw.patch_ver = img[38] | (img[39] << 8);
+
+	ret = mtk_wcn_fm_dsp_patch(fm, img, len, false);
+	kfree(img);
+	if (ret)
+		return ret;
+
+	/* Downstream reports the ROM version incremented by one after the
+	 * coefficient download (mt6627_fm_lib.c:800).
+	 */
+	fm->hw.rom_ver = rom_ver + 1;
+	dev_info(fm->dev, "MT6627 FM: ROM v%d, patch 0x%04x\n", fm->hw.rom_ver,
+		 fm->hw.patch_ver);
+
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_DSP_PATCH_DATA, 0x0000);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_DSP_PATCH_CTRL, 0x0040);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_DSP_PATCH_CTRL, 0x0000);
+	if (ret)
+		return ret;
+
+	/* step 4: FM digital init */
+	ret = mtk_wcn_fm_send_pwrup_digital_init(fm);
+	if (ret) {
+		dev_err(fm->dev, "digital init failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* step 5: RF fine tune */
+	ret = mtk_wcn_fm_send_pwrup_fine_tune(fm);
+	if (ret) {
+		dev_err(fm->dev, "RF fine tune failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* enable the connectivity SoC FM 2-wire RX audio path */
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_AUDIO_CTRL0, 0xf9ab);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL, 0x00003f35);
+	if (ret)
+		return ret;
+
+	/* The power up sequence leaves the I2S port enabled. */
+	fm->i2s_on = true;
+
+	return 0;
+}
+
+int mtk_wcn_fm_chip_power_up(struct mtk_wcn_fm_dev *fm)
+{
+	int ret;
+
+	if (fm->powered)
+		return 0;
+
+	/* mt6627_pwron(), mt6627_fm_lib.c:98-115 */
+	if (!mtk_wcn_wmt_func_on(WMTDRV_FM)) {
+		dev_err(fm->dev, "WMT cannot power on the FM function\n");
+		return -EIO;
+	}
+
+	if (!mtk_wcn_stp_is_ready()) {
+		dev_err(fm->dev, "STP is not ready after powering on FM\n");
+		ret = -ENODEV;
+		goto err_func_off;
+	}
+
+	ret = mtk_wcn_fm_power_up_seq(fm);
+	if (ret)
+		goto err_func_off;
+
+	fm->powered = true;
+
+	return 0;
+
+err_func_off:
+	mtk_wcn_wmt_func_off(WMTDRV_FM);
+	return ret;
+}
+
+/* mt6627_PowerDown(), mt6627_fm_lib.c:865-940 */
+int mtk_wcn_fm_chip_power_down(struct mtk_wcn_fm_dev *fm)
+{
+	u32 host_reg;
+	u16 intr;
+	int ret = 0, err;
+
+	if (!fm->powered)
+		return 0;
+
+	/*
+	 * SW workaround for MCUFA: clear a pending STC interrupt before the
+	 * ramp down, otherwise the DSP cannot switch MCUFA back.
+	 */
+	err = mtk_wcn_fm_reg_read(fm, FM_MAIN_INTR, &intr);
+	if (!err && (intr & FM_INTR_STC_DONE))
+		mtk_wcn_fm_reg_write(fm, FM_MAIN_INTR, intr);
+
+	/* set the audio output to I2S RX mode */
+	err = mtk_wcn_fm_host_read(fm, FM_HOST_REG_AUDIO_CTRL, &host_reg);
+	if (!err) {
+		host_reg &= 0xffff9fff;
+		err = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL,
+					    host_reg);
+	}
+	if (err) {
+		dev_warn(fm->dev, "audio path shutdown failed (%d)\n", err);
+		ret = err;
+	}
+
+	err = mtk_wcn_fm_send_pwrdown(fm);
+	if (err) {
+		dev_warn(fm->dev, "power down sequence failed (%d)\n", err);
+		if (!ret)
+			ret = err;
+	} else {
+		err = mtk_wcn_fm_reg_write(fm, FM_MAIN_EXTINTRMASK, 0x0000);
+		if (err && !ret)
+			ret = err;
+	}
+
+	/* mt6627_pwroff(), mt6627_fm_lib.c:117-126 */
+	if (!mtk_wcn_wmt_func_off(WMTDRV_FM)) {
+		dev_err(fm->dev, "WMT cannot power off the FM function\n");
+		if (!ret)
+			ret = -EIO;
+	}
+
+	fm->powered = false;
+	fm->rds_on = false;
+	/* The power down sequence turned the I2S port off (mt6627_fm_lib.c:
+	 * 892-894, mt6627_fm_cmd.c:523) and the registers are gone.
+	 */
+	fm->i2s_on = false;
+
+	return ret;
+}
+
+/*
+ * Tune / seek (mt6627_fm_lib.c:953-1136 and 1146-1179)
+ */
+/* mt6627_tune(), mt6627_fm_cmd.c:595-630 */
+static int mtk_wcn_fm_send_tune(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_pkt pkt;
+	int ret;
+
+	mutex_lock(&fm->cmd_lock);
+	mtk_wcn_fm_pkt_init(&pkt, fm->cmd_buf, sizeof(fm->cmd_buf),
+			    FM_TUNE_OPCODE);
+	/* start the hardware tune and wait for the STC interrupt */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CTRL, 0xfff8,
+						       FM_MAIN_CTRL_TUNE,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	ret = mtk_wcn_fm_send(fm, &pkt,
+			      FM_EVT_BIT(FM_TUNE_OPCODE) | FM_EVT_TUNE_DONE,
+			      FM_TUNE_TIMEOUT);
+	mutex_unlock(&fm->cmd_lock);
+
+	return ret;
+}
+
+int mtk_wcn_fm_chip_rampdown(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_pkt pkt;
+	int ret;
+
+	/* mt6627_RampDown(), mt6627_fm_lib.c:384-445 */
+	ret = mtk_wcn_fm_top_write(fm, FM_TOP_REG_CLK_CTRL, 0x00000007);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_0F_RF_MODE, 0x0000, 0xf800);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_top_write(fm, FM_TOP_REG_CLK_CTRL, 0x0000000f);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_write(fm, FM_MAIN_INTRMASK, 0x0000);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_write(fm, FM_MAIN_EXTINTRMASK, 0x0000);
+	if (ret)
+		return ret;
+
+	mutex_lock(&fm->cmd_lock);
+	mtk_wcn_fm_pkt_init(&pkt, fm->cmd_buf, sizeof(fm->cmd_buf),
+			    FM_RAMPDOWN_OPCODE);
+	/* clear the DSP state */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CTRL, 0xfff0,
+						       0x0000,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* enter ramp down, the firmware waits for STC_DONE */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CTRL, 0xffff,
+						       FM_MAIN_CTRL_RAMP_DOWN,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_rd_until(FM_MAIN_INTR,
+							 FM_INTR_STC_DONE,
+							 FM_INTR_STC_DONE,
+							 pkt.buf + pkt.len,
+							 pkt.cap - pkt.len));
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CTRL,
+						       (u16)~FM_MAIN_CTRL_RAMP_DOWN,
+						       0x0000, pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* write 1 to clear the STC_DONE status flag */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_INTR, 0xffff,
+						       FM_INTR_STC_DONE,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	ret = mtk_wcn_fm_send(fm, &pkt, FM_EVT_BIT(FM_RAMPDOWN_OPCODE),
+			      FM_RAMPDOWN_TIMEOUT);
+	mutex_unlock(&fm->cmd_lock);
+	if (ret)
+		return ret;
+
+	ret = mtk_wcn_fm_reg_write(fm, FM_MAIN_EXTINTRMASK, 0x0021);
+	if (ret)
+		return ret;
+
+	return mtk_wcn_fm_reg_write(fm, FM_MAIN_INTRMASK, 0x0021);
+}
+
+int mtk_wcn_fm_chip_tune(struct mtk_wcn_fm_dev *fm, u16 freq)
+{
+	u16 chan_para, freq_reg;
+	int ret;
+
+	if (freq < 6500 || freq > 10800)
+		return -EINVAL;
+
+	/* mt6627_SetFreq(), mt6627_fm_lib.c:953-1136 */
+	ret = mtk_wcn_fm_top_write(fm, FM_TOP_REG_CLK_CTRL, 0x00000007);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_0F_RF_MODE, 0x0455, 0xf800);
+	if (ret)
+		return ret;
+
+	if (mtk_wcn_fm_tdd_chan_check(freq))
+		ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_RF_30, 0x0008, 0xfff3);
+	else
+		ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_RF_30, 0x0000, 0xfff3);
+	if (ret)
+		return ret;
+
+	ret = mtk_wcn_fm_top_write(fm, FM_TOP_REG_CLK_CTRL, 0x0000000f);
+	if (ret)
+		return ret;
+
+	chan_para = mtk_wcn_fm_chan_para_get(freq);
+	freq_reg = (freq - 6400) * 2 / 10;
+
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_CHANNEL_SET, freq_reg, 0xfc00);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_CHANNEL_SET, chan_para << 12,
+				      0x0fff);
+	if (ret)
+		return ret;
+
+	/* enable the connectivity SoC FM 2-wire RX audio path */
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_AUDIO_CTRL0, 0xf9ab);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL, 0x00003f35);
+	if (ret)
+		return ret;
+	/* Every retune re-enables the I2S port (mt6627_fm_lib.c:1023-1024). */
+	fm->i2s_on = true;
+
+	ret = mtk_wcn_fm_send_tune(fm);
+	if (ret) {
+		dev_err(fm->dev, "tune to %u failed (%d)\n", freq, ret);
+		return ret;
+	}
+
+	fm->cur_freq = freq;
+
+	/*
+	 * Re-apply the user soft mute gain / blending settings after the tune;
+	 * the DSP reloads its coefficient memory (mt6627_fm_lib.c:1073-1118).
+	 */
+	if (fm->smg != FM_MT6627_SMG_DEFAULT) {
+		ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_SMG, fm->smg);
+		if (ret)
+			return ret;
+	}
+	if (!fm->blend) {
+		ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_BLEND_RSSI, 0);
+		if (ret)
+			return ret;
+		ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_BLEND_PAMD, 0);
+		if (ret)
+			return ret;
+		ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_BLEND_VALUE, 0);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+/* mt6627_seek(), mt6627_fm_cmd.c:696-746 */
+static int mtk_wcn_fm_send_seek(struct mtk_wcn_fm_dev *fm, u16 min_freq,
+				u16 max_freq, u16 space, u8 dir, bool wrap)
+{
+	struct mtk_wcn_fm_pkt pkt;
+	u16 max_reg, min_reg, spacing;
+	int ret;
+
+	max_reg = (max_freq - 6400) * 2 / 10;
+	min_reg = (min_freq - 6400) * 2 / 10;
+
+	switch (space) {
+	case FM_SPACE_50K:
+		spacing = 0x1000;
+		break;
+	case FM_SPACE_200K:
+		spacing = 0x4000;
+		break;
+	case FM_SPACE_100K:
+	default:
+		spacing = 0x2000;
+		break;
+	}
+
+	mutex_lock(&fm->cmd_lock);
+	mtk_wcn_fm_pkt_init(&pkt, fm->cmd_buf, sizeof(fm->cmd_buf),
+			    FM_SEEK_OPCODE);
+	/* seek direction: 0x66[10] = 1 for seek down */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CFG1, 0xfbff,
+						       dir ? 0x0400 : 0x0000,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* channel spacing: 0x66[14:12] */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CFG1, 0x8fff,
+						       spacing,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* 0x66[11]: wrap around at the band edge.  Downstream seek always sets
+	 * this bit (mt6627_fm_cmd.c:728) while the scan variant clears it
+	 * (mt6627_fm_cmd.c:795); the requested V4L2 wrap flag selects which.
+	 */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CFG1, 0xf7ff,
+						       wrap ? 0x0800 : 0x0000,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* 0x66[9:0] upper bound */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CFG1, 0xfc00,
+						       max_reg,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* 0x67[9:0] lower bound */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CFG2, 0xfc00,
+						       min_reg,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	/* enable the hardware controlled seek sequence */
+	mtk_wcn_fm_pkt_add(&pkt, mtk_wcn_fm_bop_modify(FM_MAIN_CTRL, 0xfff8,
+						       FM_MAIN_CTRL_SEEK,
+						       pkt.buf + pkt.len,
+						       pkt.cap - pkt.len));
+	ret = mtk_wcn_fm_send(fm, &pkt,
+			      FM_EVT_BIT(FM_SEEK_OPCODE) | FM_EVT_SEEK_DONE,
+			      FM_SEEK_TIMEOUT);
+	mutex_unlock(&fm->cmd_lock);
+
+	return ret;
+}
+
+/*
+ * mt6627_Seek(), mt6627_fm_lib.c:1146-1179.  Downstream never wired this
+ * helper into the basic interface (the assignment is inside #if 0), so the
+ * post-seek ramp down / unmute below is ported from the disabled code and is
+ * unverified on hardware.
+ */
+int mtk_wcn_fm_chip_seek(struct mtk_wcn_fm_dev *fm, u16 min_freq,
+			 u16 max_freq, u16 space, u8 dir, bool wrap,
+			 u16 *result)
+{
+	u16 ctrl = 0;
+	int ret;
+
+	if (min_freq >= max_freq)
+		return -EINVAL;
+
+	ret = mtk_wcn_fm_chip_rampdown(fm);
+	if (ret)
+		return ret;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_MAIN_CTRL, &ctrl);
+	if (ret)
+		return ret;
+
+	ret = mtk_wcn_fm_chip_mute(fm, true);
+	if (ret)
+		return ret;
+
+	ret = mtk_wcn_fm_send_seek(fm, min_freq, max_freq, space, dir, wrap);
+	if (ret)
+		return ret;
+
+	if (fm->seek_result < min_freq || fm->seek_result > max_freq) {
+		dev_warn(fm->dev, "seek returned out of range frequency %u\n",
+			 fm->seek_result);
+		return -ERANGE;
+	}
+
+	*result = fm->seek_result;
+	fm->cur_freq = fm->seek_result;
+
+	ret = mtk_wcn_fm_chip_rampdown(fm);
+	if (ret)
+		dev_warn(fm->dev, "post-seek ramp down failed (%d)\n", ret);
+
+	/* restore the mute state the caller had before the seek */
+	if (!(ctrl & FM_MAIN_CTRL_MUTE))
+		ret = mtk_wcn_fm_chip_mute(fm, false);
+
+	return ret;
+}
+
+/*
+ * Status / audio controls
+ */
+/* mt6627_GetCurRSSI() and mt6627_GetMonoStereo(), mt6627_fm_lib.c:1277-1294,
+ * 1364-1379.
+ */
+int mtk_wcn_fm_chip_status(struct mtk_wcn_fm_dev *fm, s32 *dbm, bool *stereo)
+{
+	u16 reg;
+	int ret;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_RSSI_IND, &reg);
+	if (ret)
+		return ret;
+
+	if (dbm) {
+		u16 rssi = reg & 0x03ff;
+
+		*dbm = (rssi > 511) ? (((rssi - 1024) * 6) >> 4) :
+				      ((rssi * 6) >> 4);
+	}
+	if (stereo)
+		*stereo = !!(reg & FM_RSSI_IND_STEREO);
+
+	return 0;
+}
+
+/* mt6627_Mute(), mt6627_fm_lib.c:333-351 */
+int mtk_wcn_fm_chip_mute(struct mtk_wcn_fm_dev *fm, bool mute)
+{
+	u16 reg;
+	int ret;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_REG_AUDIO_CTRL1, &reg);
+	if (ret)
+		return ret;
+
+	reg &= 0xfffc;
+	if (mute)
+		reg |= 0x0003;
+
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_AUDIO_CTRL1, reg);
+	if (!ret)
+		fm->mute = mute;
+
+	return ret;
+}
+
+/* mt6627_SetVol(), mt6627_fm_lib.c:1301-1320 */
+int mtk_wcn_fm_chip_vol_set(struct mtk_wcn_fm_dev *fm, u8 vol)
+{
+	int ret;
+
+	vol = min_t(u8, vol, 15);
+	ret = mtk_wcn_fm_reg_write(fm, FM_REG_VOLUME, mtk_wcn_fm_vol_tbl[vol]);
+	if (!ret)
+		fm->vol = vol;
+
+	return ret;
+}
+
+/* mt6627_GetVol(), mt6627_fm_lib.c:1321-1349 */
+int mtk_wcn_fm_chip_vol_get(struct mtk_wcn_fm_dev *fm, u8 *vol)
+{
+	u16 reg;
+	int i, ret;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_REG_VOLUME, &reg);
+	if (ret)
+		return ret;
+
+	*vol = 0;
+	for (i = 0; i < ARRAY_SIZE(mtk_wcn_fm_vol_tbl); i++) {
+		if (mtk_wcn_fm_vol_tbl[i] == reg) {
+			*vol = i;
+			break;
+		}
+	}
+
+	return 0;
+}
+
+/* mt6627_SetAntennaType(), mt6627_fm_lib.c:303-318 */
+int mtk_wcn_fm_chip_antenna(struct mtk_wcn_fm_dev *fm, u8 type)
+{
+	u16 reg;
+	int ret;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_MAIN_CG2_CTRL, &reg);
+	if (ret)
+		return ret;
+
+	if (type)
+		reg |= FM_CG2_ANTENNA_TYPE;
+	else
+		reg &= ~FM_CG2_ANTENNA_TYPE;
+
+	ret = mtk_wcn_fm_reg_write(fm, FM_MAIN_CG2_CTRL, reg);
+	if (!ret)
+		fm->antenna = type ? 1 : 0;
+
+	return ret;
+}
+
+/*
+ * De-emphasis.  Downstream programs 0x61[12] while powering up
+ * (mt6627_fm_cmd.c:213) and exposes the value through the search threshold
+ * ioctl (mt6627_fm_lib.c:1740-1747); the chip accepts the same modify
+ * operation at run time.
+ */
+int mtk_wcn_fm_chip_deemphasis(struct mtk_wcn_fm_dev *fm, u8 deemphasis)
+{
+	int ret;
+
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_MAIN_CG2_CTRL,
+				      (deemphasis ? 1 : 0) << 12,
+				      (u16)~FM_CG2_DE_EMPHASIS);
+	if (!ret)
+		fm->deemphasis = deemphasis ? 1 : 0;
+
+	return ret;
+}
+
+/*
+ * mt6627_SetMonoStereo(), mt6627_fm_lib.c:1380-1395.  @mono forces mono,
+ * otherwise the chip decides automatically.
+ */
+int mtk_wcn_fm_chip_mono(struct mtk_wcn_fm_dev *fm, bool mono)
+{
+	int ret;
+
+	ret = mtk_wcn_fm_top_write(fm, FM_TOP_REG_CLK_CTRL, 0x00000007);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_AUDIO_MONO,
+				      mono ? 0x0008 : 0x0000,
+				      (u16)~0x0008);
+	if (ret)
+		return ret;
+
+	return mtk_wcn_fm_top_write(fm, FM_TOP_REG_CLK_CTRL, 0x0000000f);
+}
+
+/* mt6627_soft_mute_control(), mt6627_fm_lib.c:1597-1628 */
+int mtk_wcn_fm_chip_smg(struct mtk_wcn_fm_dev *fm, u8 value)
+{
+	int ret;
+
+	if (value > FM_MT6627_SMG_MAX)
+		return -EINVAL;
+
+	/* 0 disables the soft mute gain, 0x15 restores the default level */
+	ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_SMG, value ? value : 0x1);
+	if (!ret)
+		fm->smg = value;
+
+	return ret;
+}
+
+/* mt6627_blending_control(), mt6627_fm_lib.c:1630-1718 */
+int mtk_wcn_fm_chip_blend(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	u16 rssi = on ? FM_MT6627_BLEND_RSSI_DEFAULT : 0;
+	u16 pamd = on ? FM_MT6627_BLEND_PAMD_DEFAULT : 0;
+	u16 blend = on ? FM_MT6627_BLEND_VALUE_DEFAULT : 0;
+	int ret;
+
+	ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_BLEND_RSSI, rssi);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_BLEND_PAMD, pamd);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_coeff_write(fm, FM_COEFF_BLEND_VALUE, blend);
+	if (!ret)
+		fm->blend = on;
+
+	return ret;
+}
+
+/* mt6627_RDS_enable() / mt6627_RDS_disable(), mt6627_fm_rds.c:45-93 */
+int mtk_wcn_fm_chip_rds(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	u16 ctrl;
+	int ret;
+
+	if (on)
+		ret = mtk_wcn_fm_reg_write(fm, FM_RDS_CFG0, 6);
+	else
+		ret = 0;
+	if (ret)
+		return ret;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_MAIN_CTRL, &ctrl);
+	if (ret)
+		return ret;
+
+	if (on)
+		ctrl |= FM_MAIN_CTRL_RDS_MASK;
+	else
+		ctrl &= ~FM_MAIN_CTRL_RDS_MASK;
+
+	ret = mtk_wcn_fm_reg_write(fm, FM_MAIN_CTRL, ctrl);
+	if (!ret)
+		fm->rds_on = on;
+
+	return ret;
+}
+/*
+ * MT6627 FM I2S audio port.
+ *
+ * The port is enabled by two register writes that the downstream driver
+ * issues on every power up and on every retune:
+ *
+ *	mt6627_write(0x9B, 0xF9AB);  -- FM_REG_AUDIO_CTRL0
+ *	mt6627_host_write(0x80101054, 0x00003f35);  -- host audio ctrl
+ *
+ * (mt6627_fm_lib.c:1023-1024 after a retune, :850-851 in the power up
+ * sequence, :1511,1513 after a soft-mute scan).  The matching disable is what
+ * mt6627_PowerDown()/mt6627_pwrdown() do before the DSP clocks are gated: host
+ * bits 13:14 are cleared (mt6627_fm_lib.c:892-894) and FM_REG_AUDIO_CTRL0 bits
+ * 15:3 are cleared (mt6627_fm_cmd.c:523).  There is no downstream or ROM
+ * register sequence that changes the MT6627 I2S clock mode or sample rate
+ * (mt6627_I2s_Setting() has no body, mt6627_fm_lib.c:88-90,1825-1827), so this
+ * file only ever enables or disables the port.
+ */
+#define FM_MT6627_I2S_CTRL0_ON		0xf9ab	/* mt6627_fm_lib.c:1023 */
+#define FM_MT6627_HOST_AUDIO_ON		0x00003f35 /* mt6627_fm_lib.c:851 */
+/* Bits 13:14: cleared by mt6627_PowerDown(), mt6627_fm_lib.c:893. */
+#define FM_HOST_AUDIO_I2S_MASK		0x00006000
+/* Bits 15:3: cleared by mt6627_pwrdown(), mt6627_fm_cmd.c:523. */
+#define FM_AUDIO_CTRL0_I2S_MASK		0xfff8
+/*
+ * The enable value only sets bit 13 of that field, so the read back comparison
+ * has to use the pattern of the ON value rather than the whole mask.
+ */
+#define FM_HOST_AUDIO_I2S_ON_BITS \
+	(FM_MT6627_HOST_AUDIO_ON & FM_HOST_AUDIO_I2S_MASK)
+
+int mtk_wcn_fm_chip_i2s_set(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	u32 host;
+	int ret;
+
+	if (!fm->powered)
+		return -EAGAIN;
+
+	if (on) {
+		ret = mtk_wcn_fm_reg_write(fm, FM_REG_AUDIO_CTRL0,
+					   FM_MT6627_I2S_CTRL0_ON);
+		if (ret)
+			return ret;
+		ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL,
+					    FM_MT6627_HOST_AUDIO_ON);
+		if (ret)
+			return ret;
+		fm->i2s_on = true;
+		return 0;
+	}
+
+	/* mt6627_PowerDown(), mt6627_fm_lib.c:892-894 */
+	ret = mtk_wcn_fm_host_read(fm, FM_HOST_REG_AUDIO_CTRL, &host);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL,
+				    host & ~FM_HOST_AUDIO_I2S_MASK);
+	if (ret)
+		return ret;
+
+	/* mt6627_pwrdown(), mt6627_fm_cmd.c:523 */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_AUDIO_CTRL0, 0x0000,
+				      FM_AUDIO_CTRL0_I2S_MASK);
+	if (ret)
+		return ret;
+
+	fm->i2s_on = false;
+
+	return 0;
+}
+
+int mtk_wcn_fm_chip_i2s_get(struct mtk_wcn_fm_dev *fm, bool *on)
+{
+	u16 ctrl0;
+	u32 host;
+	int ret;
+
+	if (!on)
+		return -EINVAL;
+	if (!fm->powered)
+		return -EAGAIN;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_REG_AUDIO_CTRL0, &ctrl0);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_host_read(fm, FM_HOST_REG_AUDIO_CTRL, &host);
+	if (ret)
+		return ret;
+
+	*on = (ctrl0 & FM_AUDIO_CTRL0_I2S_MASK) != 0 &&
+	      (host & FM_HOST_AUDIO_I2S_MASK) == FM_HOST_AUDIO_I2S_ON_BITS;
+	fm->i2s_on = *on;
+
+	return 0;
+}
+
+int mtk_wcn_fm_chip_i2s_info(struct mtk_wcn_fm_dev *fm,
+			     struct fm_i2s_info *info)
+{
+	bool on;
+	int ret;
+
+	if (!info)
+		return -EINVAL;
+
+	/* mt6627_fm_config.c:116-118: fixed master / 32 kHz configuration. */
+	info->mode = FM_I2S_MASTER;
+	info->rate = FM_I2S_32K;
+
+	if (!fm->powered) {
+		/*
+		 * The port cannot be on while the FM function is off, and the
+		 * registers are not reachable, so report the known state.
+		 */
+		info->status = FM_I2S_OFF;
+		return 0;
+	}
+
+	ret = mtk_wcn_fm_chip_i2s_get(fm, &on);
+	if (ret) {
+		info->status = FM_I2S_STATE_ERR;
+		return ret;
+	}
+
+	info->status = on ? FM_I2S_ON : FM_I2S_OFF;
+
+	return 0;
+}
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.c b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.c
new file mode 100644
index 000000000..87928e4c6
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.c
@@ -0,0 +1,560 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN FM radio - MT6627 FM I2S audio path (ALSA SoC codec).
+ *
+ * Port from Samsung/MTK downstream:
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_machine.c:1068-1086
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_pcm_fm_i2s.c:279-323
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_afe_control.c:2214-2296
+ *   sound/soc/mediatek/mt_soc_audio_v3/AudDrv_Def.h:230-231,302-307,325-343
+ *
+ * Downstream wires the FM I2S port into the single machine card ("mt-snd-card")
+ * with the DAI links "FM_I2S_RX_Playback"/"FM_I2S_RX_Capture", the CPU DAI
+ * "mt-soc-fmi2S-driver" and the codec DAIs "mt-soc-fm-i2s-dai-codec" /
+ * "mt-soc-fm-i2s-dummy-dai-codec".  The data path is the AFE "2nd I2S in"
+ * block, programmed from mtk_pcm_fm_i2s_prepare() as a consumer of the
+ * connectivity I2S clocks (mI2S_SLAVE = Soc_Aud_I2S_SRC_SLAVE_MODE), at a fixed
+ * 32000 Hz, 16 bit words, I2S framing, LRCK not inverted and the input pads
+ * taken from CONNSYS (mI2S_IN_PAD_SEL = false), mt_soc_pcm_fm_i2s.c:303-320,
+ * mt_soc_afe_control.c:2214-2248.
+ *
+ * This file owns the *chip* side of that port: a codec component named
+ * "mt6627-fm-i2s" carrying the DAI "mt-soc-fm-i2s-dai-codec" that enforces the
+ * real MT6627 constraints (master mode, a fixed 32 kHz, 16 bit, stereo I2S
+ * frame) and enables/disables the port through mtk_wcn_fm_chip_i2s_set().
+ * The AP side - the AFE 2nd I2S input, its
+ * connections and the ASRC that downstream used to reach 44.1/48 kHz - belongs
+ * to the audio subsystem and is specified in
+ * $M/logs/rem-wcn-fm-i2s.md ("AUDIO-FRAGMENT"), because this kernel's
+ * mt6735 AFE implements I2S0 only (sound/soc/mediatek/mt6735/mt6735-dai-i2s.c)
+ * and remapping AFE registers from the FM driver would be a second, competing
+ * audio driver.
+ *
+ * This driver registers no sound card.  A card can only be owned by the board
+ * machine driver (mt6735-mt6331-sound), and ASoC binds a component to exactly
+ * one card (soc_probe_component(), soc-core.c:1602-1622), so a second card
+ * that shares the AFE would always fail.  Instead the machine driver references
+ * "mt6627-fm-i2s" as the codec of the FM link; until it does, the component
+ * stays unbound and FM_IOCTL_I2S_SETTING reports -ENODEV.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mtk_wcn_fm.h"
+
+/*
+ * Codec/DAI name and stream names.  The stream names follow downstream
+ * MT_SOC_FM_I2S_PLAYBACK_STREAM_NAME / MT_SOC_FM_I2S_CAPTURE_STREAM_NAME
+ * (AudDrv_Def.h:342-343) and the DAI name is downstream
+ * MT_SOC_CODEC_FM_I2S_DAI_NAME (AudDrv_Def.h:307), which is the name the
+ * machine link in mt_soc_machine.c:1068-1086 binds.  The component name is new
+ * because this kernel has no MT63xx codec driver: ASoC binds a component by
+ * name, and "mt6627-fm-i2s" is the name the board machine driver has to put in
+ * its FM DAI link (COMP_CODEC("mt6627-fm-i2s", "mt-soc-fm-i2s-dai-codec")).
+ */
+#define MTK_WCN_FM_I2S_CODEC_NAME	"mt6627-fm-i2s"
+#define MTK_WCN_FM_I2S_DAI_NAME		"mt-soc-fm-i2s-dai-codec"
+#define MTK_WCN_FM_I2S_PB_STREAM	"FM_I2S_Playback"
+#define MTK_WCN_FM_I2S_CAP_STREAM	"FM_I2S_Capture"
+
+/*
+ * The MT6627 I2S port is fixed at master mode with a 32000 Hz frame:
+ * mt6627_fm_config.c:116-118 initialises the audio path to FM_AUD_I2S with
+ * i2s_info = {FM_I2S_OFF, FM_I2S_MASTER, FM_I2S_32K}, and the AP side is
+ * configured for mI2S_SAMPLERATE = 32000 with 16 bit words
+ * (mt_soc_pcm_fm_i2s.c:308-312).  No downstream or ROM sequence changes either
+ * (mt6627_I2s_Setting() has no implementation, mt6627_fm_lib.c:88-90,1825-1827).
+ * The port is a stereo I2S frame (mI2S_IN_PAD_SEL = false feeds both pads from
+ * CONNSYS, mt_soc_pcm_fm_i2s.c:306-307); FM mono content is carried inside it
+ * and selected by the chip's mono/stereo control (FM_REG_AUDIO_MONO).
+ */
+#define MTK_WCN_FM_I2S_RATE		32000
+#define MTK_WCN_FM_I2S_CHANNELS		2
+
+/*
+ * The only DAI format the FM link can carry: I2S framing, no BCLK/LRCK
+ * inversion, and the AP side as the bit clock/frame clock consumer while the
+ * MT6627 drives BCLK/LRCK (downstream mI2S_SLAVE = Soc_Aud_I2S_SRC_SLAVE_MODE,
+ * mt_soc_pcm_fm_i2s.c:309).  This kernel's AFE DAI maps
+ * SND_SOC_DAIFMT_CBC_CFC to AFE_I2S_CON_SLAVE (mt6735-dai-i2s.c:79-89) and the
+ * audio machine card spells the same interface the same way
+ * (mt6735-mt6331.c:152-155); the machine link must therefore use this value.
+ */
+#define MTK_WCN_FM_I2S_DAIFMT \
+	(SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC)
+
+struct mtk_wcn_fm_i2s {
+	struct mtk_wcn_fm_dev *fm;
+	/* Serialises the state below and every chip access of this file. */
+	struct mutex lock;
+	/* A card bound the component: a machine link uses this DAI. */
+	bool bound;
+	/* The FM function is powered (mirror of fm->powered). */
+	bool powered;
+	/* Userspace enabled the audio path (FM_IOCTL_I2S_SETTING). */
+	bool route;
+	/* Bitmask of substreams set up with hw_params(). */
+	unsigned int armed;
+	/* Port state last written to the chip. */
+	bool chip_on;
+};
+
+static struct mtk_wcn_fm_i2s *mtk_wcn_fm_i2s_from_component(
+					struct snd_soc_component *component)
+{
+	struct mtk_wcn_fm_dev *fm = snd_soc_component_get_drvdata(component);
+
+	return fm ? fm->i2s : NULL;
+}
+
+/*
+ * The port has to be on while the chip is powered and either userspace asked
+ * for audio or a PCM is set up.  The chip power up sequence enables it anyway
+ * (mtk_wcn_fm_chip.c, mt6627_fm_lib.c:849-851), so the state only has to be
+ * written when it actually differs.  Called with i2s->lock held.
+ */
+static bool mtk_wcn_fm_i2s_wanted(struct mtk_wcn_fm_i2s *i2s)
+{
+	return i2s->powered && (i2s->route || i2s->armed);
+}
+
+/*
+ * Bring the chip port in line with the wanted state.  Called with i2s->lock
+ * held from the sleepable ASoC callbacks (component probe/remove, startup,
+ * hw_params, hw_free, mute) and from the V4L2 paths; never from an atomic
+ * context - the register access goes over STP and sleeps.
+ */
+static int mtk_wcn_fm_i2s_apply_locked(struct mtk_wcn_fm_i2s *i2s, bool force)
+{
+	struct mtk_wcn_fm_dev *fm = i2s->fm;
+	bool on;
+	int ret;
+
+	on = mtk_wcn_fm_i2s_wanted(i2s);
+
+	/*
+	 * fm->i2s_on is the last port state known to the chip layer; the power
+	 * up, retune and power down sequences update it too, which is how a
+	 * retune that re-enabled the port behind our back is caught.
+	 */
+	if (!force && on == i2s->chip_on && on == READ_ONCE(fm->i2s_on))
+		return 0;
+
+	if (!i2s->powered) {
+		/* The chip is off: its registers are gone, nothing to write. */
+		i2s->chip_on = false;
+		return 0;
+	}
+
+	ret = mtk_wcn_fm_chip_i2s_set(fm, on);
+	if (ret) {
+		dev_warn(fm->dev, "FM I2S port %s failed (%d)\n",
+			 on ? "enable" : "disable", ret);
+		return ret;
+	}
+
+	i2s->chip_on = on;
+
+	return 0;
+}
+
+static int mtk_wcn_fm_i2s_apply(struct mtk_wcn_fm_i2s *i2s, bool force)
+{
+	int ret;
+
+	mutex_lock(&i2s->lock);
+	ret = mtk_wcn_fm_i2s_apply_locked(i2s, force);
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+/*
+ * Codec DAI
+ */
+static int mtk_wcn_fm_i2s_dai_startup(struct snd_pcm_substream *substream,
+				      struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	int ret = 0;
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	if (!i2s->powered)
+		ret = -ENODEV;
+	mutex_unlock(&i2s->lock);
+
+	if (ret)
+		dev_dbg(i2s->fm->dev,
+			"FM I2S stream opened while the FM function is off\n");
+
+	return ret;
+}
+
+static int mtk_wcn_fm_i2s_dai_hw_params(struct snd_pcm_substream *substream,
+					struct snd_pcm_hw_params *params,
+					struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	int ret = 0;
+
+	if (!i2s)
+		return -ENODEV;
+
+	if (rate != MTK_WCN_FM_I2S_RATE) {
+		dev_err(i2s->fm->dev,
+			"MT6627 I2S is fixed at %u Hz, %u Hz rejected\n",
+			MTK_WCN_FM_I2S_RATE, rate);
+		return -EINVAL;
+	}
+	if (channels != MTK_WCN_FM_I2S_CHANNELS) {
+		dev_err(i2s->fm->dev,
+			"MT6627 I2S is a stereo frame, %u channels rejected\n",
+			channels);
+		return -EINVAL;
+	}
+	if (params_format(params) != SNDRV_PCM_FORMAT_S16_LE) {
+		dev_err(i2s->fm->dev,
+			"MT6627 I2S is 16 bit, format %u rejected\n",
+			params_format(params));
+		return -EINVAL;
+	}
+
+	mutex_lock(&i2s->lock);
+	if (!i2s->powered) {
+		ret = -ENODEV;
+	} else {
+		i2s->armed |= BIT(substream->stream);
+		ret = mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	}
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+static int mtk_wcn_fm_i2s_dai_hw_free(struct snd_pcm_substream *substream,
+				      struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	int ret;
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	i2s->armed &= ~BIT(substream->stream);
+	ret = mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+/*
+ * shutdown() is the safety net for a stream that was closed without hw_free();
+ * it is idempotent with hw_free().
+ */
+static void mtk_wcn_fm_i2s_dai_shutdown(struct snd_pcm_substream *substream,
+					struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+
+	if (!i2s)
+		return;
+
+	mutex_lock(&i2s->lock);
+	i2s->armed &= ~BIT(substream->stream);
+	mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	mutex_unlock(&i2s->lock);
+}
+
+/*
+ * trigger() runs with the PCM stream lock held (Documentation/sound/kernel-api/
+ * writing-an-alsa-driver.rst:1870-1874: "the trigger callback is atomic"), so
+ * it must not touch the chip.  It only refuses to start a stream on a chip that
+ * has been powered down under it; the port itself is programmed in hw_params().
+ */
+static int mtk_wcn_fm_i2s_dai_trigger(struct snd_pcm_substream *substream,
+				      int cmd, struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+
+	if (!i2s)
+		return -ENODEV;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		if (!READ_ONCE(i2s->powered))
+			return -ENODEV;
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int mtk_wcn_fm_i2s_dai_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+
+	if (!i2s)
+		return -ENODEV;
+
+	/*
+	 * Only the fixed MT6627 configuration can be carried: I2S framing, no
+	 * BCLK/LRCK inversion, and the AFE as clock consumer while the chip
+	 * drives the clocks.  Anything else is rejected instead of being
+	 * accepted and ignored, because there is no register that could change
+	 * the chip's I2S mode (see the file header).
+	 */
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S)
+		return -EOPNOTSUPP;
+	if ((fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF)
+		return -EOPNOTSUPP;
+	if ((fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) !=
+	    SND_SOC_DAIFMT_CBC_CFC)
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static int mtk_wcn_fm_i2s_dai_mute(struct snd_soc_dai *dai, int mute,
+				   int stream)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	int ret = 0;
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	if (i2s->powered)
+		ret = mtk_wcn_fm_chip_mute(i2s->fm, mute);
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+static const struct snd_soc_dai_ops mtk_wcn_fm_i2s_dai_ops = {
+	.startup = mtk_wcn_fm_i2s_dai_startup,
+	.shutdown = mtk_wcn_fm_i2s_dai_shutdown,
+	.hw_params = mtk_wcn_fm_i2s_dai_hw_params,
+	.hw_free = mtk_wcn_fm_i2s_dai_hw_free,
+	.trigger = mtk_wcn_fm_i2s_dai_trigger,
+	.set_fmt = mtk_wcn_fm_i2s_dai_set_fmt,
+	.mute_stream = mtk_wcn_fm_i2s_dai_mute,
+};
+
+static struct snd_soc_dai_driver mtk_wcn_fm_i2s_dai = {
+	.name = MTK_WCN_FM_I2S_DAI_NAME,
+	.id = 0,
+	.ops = &mtk_wcn_fm_i2s_dai_ops,
+	.playback = {
+		.stream_name = MTK_WCN_FM_I2S_PB_STREAM,
+		.channels_min = MTK_WCN_FM_I2S_CHANNELS,
+		.channels_max = MTK_WCN_FM_I2S_CHANNELS,
+		.rates = SNDRV_PCM_RATE_32000,
+		.rate_min = MTK_WCN_FM_I2S_RATE,
+		.rate_max = MTK_WCN_FM_I2S_RATE,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name = MTK_WCN_FM_I2S_CAP_STREAM,
+		.channels_min = MTK_WCN_FM_I2S_CHANNELS,
+		.channels_max = MTK_WCN_FM_I2S_CHANNELS,
+		.rates = SNDRV_PCM_RATE_32000,
+		.rate_min = MTK_WCN_FM_I2S_RATE,
+		.rate_max = MTK_WCN_FM_I2S_RATE,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.symmetric_rate = 1,
+	.symmetric_channels = 1,
+	.symmetric_sample_bits = 1,
+};
+
+/*
+ * Component.  No DAPM widgets: the codec holds no analog switch, the whole FM
+ * audio path is the AFE's 2nd I2S input, so the routing the DAI widgets of this
+ * component would drive is empty.
+ */
+static int mtk_wcn_fm_i2s_component_probe(struct snd_soc_component *component)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(component);
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	i2s->bound = true;
+	mutex_unlock(&i2s->lock);
+
+	dev_info(i2s->fm->dev,
+		 "FM I2S codec bound to sound card \"%s\"\n",
+		 component->card->name);
+
+	return 0;
+}
+
+static void mtk_wcn_fm_i2s_component_remove(struct snd_soc_component *component)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(component);
+
+	if (!i2s)
+		return;
+
+	mutex_lock(&i2s->lock);
+	i2s->bound = false;
+	i2s->route = false;
+	i2s->armed = 0;
+	mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	mutex_unlock(&i2s->lock);
+}
+
+static const struct snd_soc_component_driver mtk_wcn_fm_i2s_component = {
+	.name = MTK_WCN_FM_I2S_CODEC_NAME,
+	.probe = mtk_wcn_fm_i2s_component_probe,
+	.remove = mtk_wcn_fm_i2s_component_remove,
+};
+
+/*
+ * FM driver interface
+ */
+int mtk_wcn_fm_i2s_init(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_i2s *i2s;
+	int ret;
+
+	i2s = devm_kzalloc(fm->dev, sizeof(*i2s), GFP_KERNEL);
+	if (!i2s)
+		return -ENOMEM;
+
+	i2s->fm = fm;
+	mutex_init(&i2s->lock);
+	i2s->chip_on = READ_ONCE(fm->i2s_on);
+	fm->i2s = i2s;
+
+	ret = snd_soc_register_component(fm->dev, &mtk_wcn_fm_i2s_component,
+					 &mtk_wcn_fm_i2s_dai, 1);
+	if (ret) {
+		dev_err(fm->dev, "cannot register the FM I2S codec (%d)\n", ret);
+		fm->i2s = NULL;
+		return ret;
+	}
+
+	dev_dbg(fm->dev, "FM I2S codec \"%s\" registered\n",
+		MTK_WCN_FM_I2S_CODEC_NAME);
+
+	return 0;
+}
+
+void mtk_wcn_fm_i2s_exit(struct mtk_wcn_fm_dev *fm)
+{
+	if (!fm->i2s)
+		return;
+
+	/*
+	 * A card that bound this component holds a module reference on this
+	 * driver (snd_soc_component_module_get_when_probe()), so the codec can
+	 * only disappear once that card released it - or when the component was
+	 * never bound, in which case removing it is trivially safe.
+	 */
+	snd_soc_unregister_component_by_driver(fm->dev, &mtk_wcn_fm_i2s_component);
+	fm->i2s = NULL;
+}
+
+/*
+ * mtk_wcn_fm_i2s_power - chip power transition notification.
+ *
+ * Ordering (mtk_wcn_fm_v4l2.c): power_on calls this after
+ * mtk_wcn_fm_chip_power_up() succeeded, power_off calls it before
+ * mtk_wcn_fm_chip_power_down().  The chip layer owns the register sequence in
+ * both directions (the power up sequence enables the port, mt6627_fm_lib.c:
+ * 849-851; the power down sequence clears it, mt6627_fm_lib.c:877-880 and
+ * mt6627_fm_cmd.c:512-517), so this callback only has to keep the ASoC view in
+ * step.  Taking i2s->lock means a stream callback that is already inside
+ * mtk_wcn_fm_i2s_apply_locked() completes before the chip starts powering
+ * down, and no later callback issues a chip access for the dead function.
+ */
+void mtk_wcn_fm_i2s_power(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	struct mtk_wcn_fm_i2s *i2s = fm->i2s;
+
+	if (!i2s)
+		return;
+
+	mutex_lock(&i2s->lock);
+	if (on) {
+		i2s->powered = true;
+		/*
+		 * The power up sequence leaves the port enabled, which is what
+		 * downstream userspace expects; FM_IOCTL_I2S_SETTING(OFF) turns
+		 * it off again.
+		 */
+		i2s->route = true;
+		i2s->armed = 0;
+		i2s->chip_on = true;
+	} else {
+		i2s->powered = false;
+		i2s->route = false;
+		i2s->armed = 0;
+		i2s->chip_on = false;
+	}
+	mutex_unlock(&i2s->lock);
+}
+
+/*
+ * The chip re-enables the I2S port on every retune (mtk_wcn_fm_chip_tune()),
+ * so re-apply the wanted state afterwards.
+ */
+void mtk_wcn_fm_i2s_resync(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_i2s *i2s = fm->i2s;
+
+	if (!i2s)
+		return;
+
+	mtk_wcn_fm_i2s_apply(i2s, false);
+}
+
+int mtk_wcn_fm_i2s_route(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	struct mtk_wcn_fm_i2s *i2s = fm->i2s;
+	int ret = 0;
+
+	if (!i2s)
+		/* Registration failed: the chip side still works. */
+		return mtk_wcn_fm_chip_i2s_set(fm, on);
+
+	mutex_lock(&i2s->lock);
+	if (!i2s->powered) {
+		ret = -EAGAIN;
+	} else if (on && !i2s->bound) {
+		/*
+		 * No machine link uses this codec, so enabling the chip port
+		 * could not produce audio: report the missing link instead of
+		 * succeeding silently.
+		 */
+		ret = -ENODEV;
+	} else {
+		i2s->route = on;
+		ret = mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	}
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.h b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.h
new file mode 100644
index 000000000..3eec2aa11
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WCN FM radio - MT6627 FM I2S audio path (ALSA SoC codec).
+ *
+ * The MT6627 FM receiver outputs its demodulated audio on the connectivity
+ * "2 wire" I2S port.  Downstream exposes that port as the DAI links
+ * "FM_I2S_RX_Playback"/"FM_I2S_RX_Capture" of the mt-snd-card machine driver
+ * and as the codec DAIs "mt-soc-fm-i2s-dai-codec"/"mt-soc-fm-i2s-dummy-dai-
+ * codec" of the MT63xx codec driver (sound/soc/mediatek/mt_soc_audio_v3/
+ * AudDrv_Def.h:230-231,302-307,325-343, mt_soc_machine.c:1068-1086).  The FM
+ * register sequences only ever enable or disable that port; neither the
+ * downstream source nor the ROM image contains a sequence that changes the
+ * MT6627 I2S clock mode or sample rate (mt6627_I2s_Setting() has no
+ * implementation: declaration and use are both inside #if 0,
+ * mt6627_fm_lib.c:88-90,1825-1827).
+ *
+ * This file declares the kernel-internal interface of the ASoC glue.  When
+ * CONFIG_SND_SOC is disabled the glue is compiled out (see the Makefile) and
+ * the inline fallbacks below keep the FM driver building and running with the
+ * chip level I2S hooks only.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#ifndef _MTK_WCN_FM_I2S_H_
+#define _MTK_WCN_FM_I2S_H_
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct mtk_wcn_fm_dev;
+
+/*
+ * Opaque FM I2S/ASoC state.  One instance per FM device, allocated by
+ * mtk_wcn_fm_i2s_init() and reachable through mtk_wcn_fm_dev.i2s.
+ */
+struct mtk_wcn_fm_i2s;
+
+/*
+ * The ASoC glue can only be used when the sound core is present and linkable
+ * from this driver: built-in code cannot reference the symbols of a modular
+ * snd-soc-core, so a built-in FM driver with SND_SOC=m falls back to the chip
+ * level hooks.  The Makefile implements the same rule for the object list.
+ */
+#define MTK_WCN_FM_ASOC_ENABLED						\
+	(IS_ENABLED(CONFIG_SND_SOC) &&					\
+	 !(IS_BUILTIN(CONFIG_MTK_WCN_FM) && IS_MODULE(CONFIG_SND_SOC)))
+
+#if MTK_WCN_FM_ASOC_ENABLED
+
+/*
+ * mtk_wcn_fm_i2s_init - register the MT6627 FM I2S codec component
+ * @fm: FM device
+ *
+ * Registers a codec component named "mt6627-fm-i2s" carrying the DAI
+ * "mt-soc-fm-i2s-dai-codec" (downstream MT_SOC_CODEC_FM_I2S_DAI_NAME,
+ * AudDrv_Def.h:307).  No sound card is registered: the board machine driver
+ * owns the card, and has to reference this codec in its FM DAI link (see
+ * $M/logs/rem-wcn-fm-i2s.md, "AUDIO-FRAGMENT").  Until it does, the component
+ * stays unbound and FM_IOCTL_I2S_SETTING reports -ENODEV.
+ *
+ * Returns 0 on success, a negative errno otherwise.
+ */
+int mtk_wcn_fm_i2s_init(struct mtk_wcn_fm_dev *fm);
+
+/*
+ * mtk_wcn_fm_i2s_exit - unregister the codec component
+ * @fm: FM device
+ */
+void mtk_wcn_fm_i2s_exit(struct mtk_wcn_fm_dev *fm);
+
+/*
+ * mtk_wcn_fm_i2s_power - notify the ASoC glue about an FM power transition
+ * @on: true after a successful chip power up, false before a chip power down
+ *
+ * Only bookkeeping: the chip layer programs the port in both directions.  Call
+ * with @on == true after mtk_wcn_fm_chip_power_up() and with @on == false
+ * before mtk_wcn_fm_chip_power_down() so that no stream callback can reach the
+ * chip while it is powering down.
+ */
+void mtk_wcn_fm_i2s_power(struct mtk_wcn_fm_dev *fm, bool on);
+
+/*
+ * mtk_wcn_fm_i2s_resync - re-apply the wanted port state
+ * @fm: FM device
+ *
+ * Called after mtk_wcn_fm_chip_tune(), which re-enables the chip I2S port.
+ */
+void mtk_wcn_fm_i2s_resync(struct mtk_wcn_fm_dev *fm);
+
+/*
+ * mtk_wcn_fm_i2s_route - apply an FM_IOCTL_I2S_SETTING request
+ * @fm: FM device
+ * @on: true for FM_I2S_ON, false for FM_I2S_OFF
+ *
+ * Programs the chip port through mtk_wcn_fm_chip_i2s_set() and keeps the
+ * route state used by the stream callbacks in step.  Returns 0 on success,
+ * -ENODEV when @on is requested but no machine link bound the codec (the
+ * request is then rejected instead of enabling a port that cannot produce
+ * audio) and the negative errno of the chip access otherwise.
+ */
+int mtk_wcn_fm_i2s_route(struct mtk_wcn_fm_dev *fm, bool on);
+
+#else /* !MTK_WCN_FM_ASOC_ENABLED */
+
+/* Provided by mtk_wcn_fm_chip.c; also declared by mtk_wcn_fm.h. */
+int mtk_wcn_fm_chip_i2s_set(struct mtk_wcn_fm_dev *fm, bool on);
+
+static inline int mtk_wcn_fm_i2s_init(struct mtk_wcn_fm_dev *fm)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline void mtk_wcn_fm_i2s_exit(struct mtk_wcn_fm_dev *fm)
+{
+}
+
+static inline void mtk_wcn_fm_i2s_power(struct mtk_wcn_fm_dev *fm, bool on)
+{
+}
+
+static inline void mtk_wcn_fm_i2s_resync(struct mtk_wcn_fm_dev *fm)
+{
+}
+
+/*
+ * Without ASoC there is no route to keep in step, but the chip port itself is
+ * still controllable: the ioctl keeps programming the real registers.
+ */
+static inline int mtk_wcn_fm_i2s_route(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	return mtk_wcn_fm_chip_i2s_set(fm, on);
+}
+
+#endif /* MTK_WCN_FM_ASOC_ENABLED */
+
+#endif /* _MTK_WCN_FM_I2S_H_ */
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_link.c b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_link.c
new file mode 100644
index 000000000..14075f7f4
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_link.c
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN FM radio - STP link layer.
+ *
+ * Port from Samsung/MTK downstream drivers/misc/mediatek/fmradio/core/fm_link.c
+ * and drivers/misc/mediatek/fmradio/core/fm_eint.c.
+ *
+ * The FM function of the connectivity SoC is driven over the STP FM channel
+ * (FM_TASK_INDX): commands are framed as
+ *
+ *	[0x01][opcode][length:le16][payload]
+ *
+ * and firmware events as
+ *
+ *	[0x04][opcode][length:le16][payload].
+ *
+ * Every command waits for the event carrying the matching opcode (or a
+ * derived completion bit such as FLAG_TUNE_DONE), retrying once like the
+ * downstream driver does.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/kfifo.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "mtk_wcn_fm.h"
+
+/* Single FM instance, as downstream g_fm_struct (core/fm_main.c:26). */
+static struct mtk_wcn_fm_dev *mtk_wcn_fm_instance;
+
+enum mtk_wcn_fm_parser_state {
+	FM_RX_PKT_TYPE = 0,
+	FM_RX_OPCODE,
+	FM_RX_LEN_LO,
+	FM_RX_LEN_HI,
+	FM_RX_PAYLOAD,
+};
+
+static void mtk_wcn_fm_evt_set(struct mtk_wcn_fm_dev *fm, u64 bits)
+{
+	spin_lock(&fm->evt_lock);
+	fm->evt_bits |= bits;
+	spin_unlock(&fm->evt_lock);
+	wake_up_interruptible(&fm->evt_wq);
+}
+
+static int mtk_wcn_fm_wait_event(struct mtk_wcn_fm_dev *fm, u64 mask,
+				 unsigned int timeout_s)
+{
+	long left;
+
+	left = wait_event_interruptible_timeout(fm->evt_wq,
+						(READ_ONCE(fm->evt_bits) & mask) != 0,
+						msecs_to_jiffies(timeout_s * 1000));
+	if (left > 0) {
+		spin_lock(&fm->evt_lock);
+		fm->evt_bits &= ~mask;
+		spin_unlock(&fm->evt_lock);
+		return 0;
+	}
+
+	return left ? -ERESTARTSYS : -ETIMEDOUT;
+}
+
+/**
+ * mtk_wcn_fm_cmd_tx - hand a command packet to the FM firmware and wait
+ * @fm: driver state
+ * @buf: command packet, built with the header already filled in
+ * @len: packet length including the 4 byte header
+ * @mask: event bits that complete the command
+ * @timeout_s: per-attempt timeout in seconds
+ *
+ * The caller must hold fm->cmd_lock, which protects the single outstanding
+ * command (downstream cmd_buf_lock in mt6627_fm_lib.c:158).
+ *
+ * Return: 0 on completion, negative errno on failure.
+ */
+int mtk_wcn_fm_cmd_tx(struct mtk_wcn_fm_dev *fm, const u8 *buf, u16 len,
+		      u64 mask, unsigned int timeout_s)
+{
+	int ret;
+	int retry = FM_SW_RETRY_CNT;
+
+	if (!fm->link_ready)
+		return -ENODEV;
+	if (!buf || !len || !mask)
+		return -EINVAL;
+
+	spin_lock(&fm->evt_lock);
+	fm->evt_bits &= ~mask;
+	spin_unlock(&fm->evt_lock);
+
+	do {
+		ret = mtk_wcn_stp_send_data(buf, len, FM_TASK_INDX);
+		if (ret <= 0) {
+			dev_err(fm->dev, "STP send failed (%d)\n", ret);
+			return -EIO;
+		}
+
+		ret = mtk_wcn_fm_wait_event(fm, mask, timeout_s);
+		if (ret != -ETIMEDOUT)
+			return ret;
+
+		dev_warn(fm->dev, "event 0x%02x timed out (%us)\n", buf[1],
+			 timeout_s);
+	} while (retry-- > 0);
+
+	return ret;
+}
+
+static void mtk_wcn_fm_rds_push(struct mtk_wcn_fm_dev *fm, const u8 *payload,
+				u16 len)
+{
+	struct mtk_wcn_fm_rds_data data;
+
+	if (len > sizeof(data)) {
+		dev_warn_ratelimited(fm->dev,
+				     "oversized RDS event (%u bytes)\n", len);
+		return;
+	}
+
+	memset(&data, 0, sizeof(data));
+	memcpy(&data, payload, len);
+
+	if (kfifo_in(&fm->rds_fifo, &data, sizeof(data)) != sizeof(data))
+		dev_warn_ratelimited(fm->dev, "RDS fifo overrun\n");
+
+	wake_up_interruptible(&fm->rds_wq);
+}
+
+/*
+ * Event payload handling, downstream fm_event_parser() switch on opcode
+ * (core/fm_link.c:304-408).
+ */
+static void mtk_wcn_fm_dispatch(struct mtk_wcn_fm_dev *fm, const u8 *payload,
+				u16 len)
+{
+	u8 opcode = fm->parser_opcode;
+	u64 bits = 0;
+
+	if (!len) {
+		/* core/fm_link.c:294-300 */
+		if (opcode == CSPI_WRITE_OPCODE)
+			bits = FM_EVT_CSPI_WRITE;
+		else if (opcode < 32)
+			bits = FM_EVT_BIT(opcode);
+		goto out;
+	}
+
+	switch (opcode) {
+	case FM_TUNE_OPCODE:
+		/* core/fm_link.c:307-312: payload[0] == 1 means tuned */
+		if (len == 1 && payload[0] == 1)
+			bits = FM_EVT_TUNE_DONE;
+		break;
+	case FM_SEEK_OPCODE:
+		/* core/fm_link.c:323-329 */
+		if (len >= 2)
+			fm->seek_result = payload[0] | (payload[1] << 8);
+		bits = FM_EVT_SEEK_DONE;
+		break;
+	case FSPI_READ_OPCODE:
+		/* core/fm_link.c:353-358 */
+		if (len >= 2)
+			fm->fspi_rd = payload[0] | (payload[1] << 8);
+		bits = FM_EVT_BIT(opcode);
+		break;
+	case CSPI_READ_OPCODE:
+	case FM_HOST_READ_OPCODE:
+		/* core/fm_link.c:360-381 */
+		if (len >= 4)
+			fm->cspi_rd = payload[0] | (payload[1] << 8) |
+				      (payload[2] << 16) |
+				      ((u32)payload[3] << 24);
+		bits = (opcode == CSPI_READ_OPCODE) ? FM_EVT_CSPI_READ :
+						      FM_EVT_HOST_READ;
+		break;
+	case RDS_RX_DATA_OPCODE:
+		/* core/fm_link.c:383-403 */
+		mtk_wcn_fm_rds_push(fm, payload, len);
+		bits = FM_EVT_BIT(opcode);
+		break;
+	default:
+		/* core/fm_link.c:405-407 */
+		if (opcode < 32)
+			bits = FM_EVT_BIT(opcode);
+		break;
+	}
+
+out:
+	if (bits)
+		mtk_wcn_fm_evt_set(fm, bits);
+}
+
+/*
+ * Packet parser.  The state is kept across calls because the STP transport
+ * may deliver a frame in several chunks (downstream kept it in a function
+ * static, core/fm_link.c:231).
+ */
+static void mtk_wcn_fm_parse(struct mtk_wcn_fm_dev *fm, const u8 *buf, int len)
+{
+	int i;
+
+	for (i = 0; i < len; i++) {
+		u8 ch = buf[i];
+
+		switch (fm->parser_state) {
+		case FM_RX_PKT_TYPE:
+			if (ch == FM_PKT_TYPE_EVENT)
+				fm->parser_state = FM_RX_OPCODE;
+			else
+				dev_warn_ratelimited(fm->dev,
+						     "bad event packet type 0x%02x\n",
+						     ch);
+			break;
+		case FM_RX_OPCODE:
+			fm->parser_opcode = ch;
+			fm->parser_state = FM_RX_LEN_LO;
+			break;
+		case FM_RX_LEN_LO:
+			fm->parser_len = ch;
+			fm->parser_state = FM_RX_LEN_HI;
+			break;
+		case FM_RX_LEN_HI:
+			fm->parser_len |= (u16)ch << 8;
+			fm->parser_pos = 0;
+			if (fm->parser_len > sizeof(fm->rx_payload)) {
+				dev_warn_ratelimited(fm->dev,
+						     "oversized event 0x%02x (%u bytes)\n",
+						     fm->parser_opcode,
+						     fm->parser_len);
+				fm->parser_state = FM_RX_PKT_TYPE;
+			} else if (!fm->parser_len) {
+				mtk_wcn_fm_dispatch(fm, NULL, 0);
+				fm->parser_state = FM_RX_PKT_TYPE;
+			} else {
+				fm->parser_state = FM_RX_PAYLOAD;
+			}
+			break;
+		case FM_RX_PAYLOAD:
+			fm->rx_payload[fm->parser_pos++] = ch;
+			if (fm->parser_pos == fm->parser_len) {
+				mtk_wcn_fm_dispatch(fm, fm->rx_payload,
+						    fm->parser_len);
+				fm->parser_state = FM_RX_PKT_TYPE;
+			}
+			break;
+		}
+	}
+}
+
+static void mtk_wcn_fm_rx_work(struct work_struct *work)
+{
+	struct mtk_wcn_fm_dev *fm = container_of(work, struct mtk_wcn_fm_dev,
+						 rx_work);
+	int len;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		len = mtk_wcn_stp_receive_data(fm->rx_buf, sizeof(fm->rx_buf),
+					       FM_TASK_INDX);
+		if (len <= 0)
+			break;
+
+		mtk_wcn_fm_parse(fm, fm->rx_buf, len);
+	}
+}
+
+/*
+ * STP channel callback (downstream fm_request_eint() registers
+ * fm_eint_handler(), core/fm_eint.c:34-39; the handler only schedules work,
+ * core/fm_main.c:2267-2275).
+ */
+static void mtk_wcn_fm_stp_event_cb(void)
+{
+	struct mtk_wcn_fm_dev *fm = mtk_wcn_fm_instance;
+
+	if (fm && fm->link_ready)
+		schedule_work(&fm->rx_work);
+}
+
+/*
+ * WMT message callback (downstream WCNfm_wholechip_rst_cb(),
+ * core/fm_link.c:34-63).  The connectivity SoC reset destroys the FM
+ * firmware state, so the driver has to re-run the power up sequence and
+ * restore the user visible state.
+ */
+static void mtk_wcn_fm_wmt_msgcb(enum mtk_wcn_wmt_drv src,
+				 enum mtk_wcn_wmt_drv dst,
+				 enum mtk_wcn_wmt_msg msg, void *data, u32 len)
+{
+	struct mtk_wcn_fm_dev *fm = mtk_wcn_fm_instance;
+	u32 rst;
+
+	if (!fm || src != WMTDRV_WMT || dst != WMTDRV_FM ||
+	    msg != WMTMSG_RESET)
+		return;
+
+	if (!data || len < sizeof(rst)) {
+		dev_warn(fm->dev, "malformed WMT reset message\n");
+		return;
+	}
+	memcpy(&rst, data, sizeof(rst));
+
+	switch (rst) {
+	case FM_WMTRSTMSG_RESET_START:
+		fm->resetting = true;
+		break;
+	case FM_WMTRSTMSG_RESET_END:
+		fm->resetting = false;
+		schedule_work(&fm->rst_work);
+		break;
+	default:
+		break;
+	}
+}
+
+int mtk_wcn_fm_link_init(struct mtk_wcn_fm_dev *fm)
+{
+	int ret;
+
+	if (mtk_wcn_fm_instance)
+		return -EBUSY;
+
+	mtk_wcn_fm_instance = fm;
+	fm->parser_state = FM_RX_PKT_TYPE;
+	INIT_WORK(&fm->rx_work, mtk_wcn_fm_rx_work);
+
+	ret = mtk_wcn_stp_register_event_cb(FM_TASK_INDX,
+					    mtk_wcn_fm_stp_event_cb);
+	if (ret) {
+		dev_err(fm->dev, "cannot register STP event callback (%d)\n",
+			ret);
+		mtk_wcn_fm_instance = NULL;
+		return ret;
+	}
+
+	ret = mtk_wcn_wmt_msgcb_reg(WMTDRV_FM, mtk_wcn_fm_wmt_msgcb);
+	if (ret) {
+		dev_err(fm->dev, "cannot register WMT callback (%d)\n", ret);
+		mtk_wcn_stp_register_event_cb(FM_TASK_INDX, NULL);
+		mtk_wcn_fm_instance = NULL;
+		return ret;
+	}
+
+	fm->link_ready = true;
+	dev_dbg(fm->dev, "FM link established\n");
+
+	return 0;
+}
+
+void mtk_wcn_fm_link_exit(struct mtk_wcn_fm_dev *fm)
+{
+	if (!fm->link_ready)
+		return;
+
+	fm->link_ready = false;
+	mtk_wcn_wmt_msgcb_unreg(WMTDRV_FM);
+	/* The STP API has no dedicated unregister call: registering a NULL
+	 * callback clears the slot (downstream stp_exp.c:173-186 does exactly
+	 * that, see also gps/stp_chrdev_gps.c:449).
+	 */
+	mtk_wcn_stp_register_event_cb(FM_TASK_INDX, NULL);
+	cancel_work_sync(&fm->rx_work);
+	mtk_wcn_fm_instance = NULL;
+
+	dev_dbg(fm->dev, "FM link released\n");
+}
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_v4l2.c b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_v4l2.c
new file mode 100644
index 000000000..164a3f774
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_v4l2.c
@@ -0,0 +1,921 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN FM radio - V4L2 radio device, power management, rfkill.
+ *
+ * Port from Samsung/MTK downstream drivers/misc/mediatek/fmradio/core/
+ * fm_module.c (char device, ioctl semantics, antenna switch GPIO) and
+ * fm_main.c (power up/down and control flows).  The downstream character
+ * device is replaced by a V4L2 radio device exporting the same hardware
+ * operations.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#include <linux/gpio.h>
+#include <linux/kfifo.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_gpio.h>
+#include <linux/platform_device.h>
+#include <linux/rfkill.h>
+#include <linux/slab.h>
+
+#include <media/v4l2-event.h>
+#include <media/v4l2-ioctl.h>
+
+#include "mtk_wcn_fm.h"
+
+#define MTK_WCN_FM_RDS_FIFO_SIZE \
+	(sizeof(struct mtk_wcn_fm_rds_data) * MTK_WCN_FM_RDS_FIFO_RECORDS)
+
+/* Downstream FM_UE_FREQ_MIN / FM_UE_FREQ_MAX etc., in 10 kHz units. */
+static void mtk_wcn_fm_band_range(u8 band, u16 *min, u16 *max)
+{
+	switch (band) {
+	case FM_BAND_JAPAN:
+		*min = FM_JP_FREQ_MIN;
+		*max = FM_JP_FREQ_MAX;
+		break;
+	case FM_BAND_JAPANW:
+		*min = FM_JP_FREQ_MIN;
+		*max = FM_UE_FREQ_MAX;
+		break;
+	case FM_BAND_SPECIAL:
+		*min = FM_SPECIAL_FREQ_MIN;
+		*max = FM_SPECIAL_FREQ_MAX;
+		break;
+	case FM_BAND_UE:
+	default:
+		*min = FM_UE_FREQ_MIN;
+		*max = FM_UE_FREQ_MAX;
+		break;
+	}
+}
+
+/*
+ * Power management
+ */
+/*
+ * Bring the FM function up: WMT function on, MT6627 power up sequence and
+ * the initial tune.  Downstream does the same on FM_IOCTL_POWERUP, which
+ * calls fm_powerup() and then fm_tune() (core/fm_module.c:131-158).
+ */
+static int mtk_wcn_fm_power_on(struct mtk_wcn_fm_dev *fm)
+{
+	u16 min, max;
+	int ret;
+
+	if (fm->powered)
+		return 0;
+
+	/* Drop RDS records left over from a previous session
+	 * (mt6627_RDS_Init_Data(), mt6627_fm_rds.c:231-240).
+	 */
+	kfifo_reset(&fm->rds_fifo);
+
+	ret = mtk_wcn_fm_chip_power_up(fm);
+	if (ret)
+		return ret;
+
+	mtk_wcn_fm_band_range(fm->band, &min, &max);
+	if (fm->cur_freq < min || fm->cur_freq > max)
+		fm->cur_freq = min;
+
+	ret = mtk_wcn_fm_chip_tune(fm, fm->cur_freq);
+	if (ret) {
+		mtk_wcn_fm_chip_power_down(fm);
+		return ret;
+	}
+
+	/* FM antenna switch: downstream drives it high while powered
+	 * (core/fm_module.c:151-152).
+	 */
+	if (fm->ant_sel_valid)
+		gpio_set_value_cansleep(fm->ant_sel_gpio, 1);
+
+	/*
+	 * The chip power up sequence leaves the I2S port enabled; let the ASoC
+	 * glue close it again unless the route and a PCM ask for it.
+	 */
+	mtk_wcn_fm_i2s_power(fm, true);
+
+	return 0;
+}
+
+/* fm_powerdown(), core/fm_main.c:612-636. */
+static void mtk_wcn_fm_power_off(struct mtk_wcn_fm_dev *fm)
+{
+	if (!fm->powered)
+		return;
+
+	/* pwrdown_flow() disables RDS before the chip power down sequence
+	 * (core/fm_main.c:592-601).
+	 */
+	if (fm->rds_on)
+		mtk_wcn_fm_chip_rds(fm, false);
+
+	/* core/fm_module.c:164-165 */
+	if (fm->ant_sel_valid)
+		gpio_set_value_cansleep(fm->ant_sel_gpio, 0);
+
+	/* Disable the I2S port while its registers are still reachable. */
+	mtk_wcn_fm_i2s_power(fm, false);
+
+	mtk_wcn_fm_chip_power_down(fm);
+
+	/* Wake up readers blocked in read()/poll(). */
+	wake_up_interruptible_all(&fm->rds_wq);
+}
+
+/*
+ * Restore the FM function after a connectivity SoC reset
+ * (fm_subsys_reset_work_func(), core/fm_main.c:2188-2265).  The WMT reset
+ * notification is only generated for whole chip resets, where the FM function
+ * has already been switched off by WMT, so the chip is brought up again from
+ * scratch and the user visible state is re-applied from the control values.
+ */
+static void mtk_wcn_fm_reset_work(struct work_struct *work)
+{
+	struct mtk_wcn_fm_dev *fm = container_of(work, struct mtk_wcn_fm_dev,
+						 rst_work);
+	bool restored = false;
+
+	mutex_lock(&fm->lock);
+	if (fm->powered) {
+		dev_warn(fm->dev, "connectivity reset, restoring FM state\n");
+		fm->powered = false;
+		mtk_wcn_fm_i2s_power(fm, false);
+		if (!mtk_wcn_fm_chip_power_up(fm) &&
+		    !mtk_wcn_fm_chip_tune(fm, fm->cur_freq)) {
+			restored = true;
+			mtk_wcn_fm_i2s_power(fm, true);
+		} else {
+			dev_err(fm->dev, "FM restore after reset failed\n");
+		}
+	}
+	mutex_unlock(&fm->lock);
+
+	/* Re-apply volume, mute, RDS, de-emphasis, antenna and DSP settings. */
+	if (restored)
+		v4l2_ctrl_handler_setup(&fm->ctrl_handler);
+}
+
+/*
+ * rfkill
+ */
+static int mtk_wcn_fm_rfkill_set_block(void *data, bool blocked)
+{
+	struct mtk_wcn_fm_dev *fm = data;
+	bool apply = false;
+
+	mutex_lock(&fm->lock);
+	if (blocked) {
+		if (fm->opened)
+			mtk_wcn_fm_power_off(fm);
+	} else if (fm->opened && !fm->powered) {
+		if (!mtk_wcn_fm_power_on(fm))
+			apply = true;
+	}
+	mutex_unlock(&fm->lock);
+
+	if (apply)
+		v4l2_ctrl_handler_setup(&fm->ctrl_handler);
+
+	return 0;
+}
+
+static const struct rfkill_ops mtk_wcn_fm_rfkill_ops = {
+	.set_block = mtk_wcn_fm_rfkill_set_block,
+};
+
+/*
+ * V4L2 controls
+ */
+static int mtk_wcn_fm_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct mtk_wcn_fm_dev *fm = container_of(ctrl->handler,
+						 struct mtk_wcn_fm_dev,
+						 ctrl_handler);
+	u16 min, max;
+	int ret = 0;
+
+	/*
+	 * Values programmed while the chip is off are stored by the control
+	 * framework and written by v4l2_ctrl_handler_setup() after the next
+	 * power up.
+	 */
+	if (!fm->powered)
+		return 0;
+
+	mutex_lock(&fm->lock);
+	switch (ctrl->id) {
+	case V4L2_CID_AUDIO_MUTE:
+		ret = mtk_wcn_fm_chip_mute(fm, ctrl->val);
+		break;
+	case V4L2_CID_AUDIO_VOLUME:
+		ret = mtk_wcn_fm_chip_vol_set(fm, ctrl->val);
+		break;
+	case V4L2_CID_TUNE_DEEMPHASIS:
+		ret = mtk_wcn_fm_chip_deemphasis(fm,
+						 ctrl->val == V4L2_DEEMPHASIS_75_uS);
+		break;
+	case V4L2_CID_RDS_RECEPTION:
+		ret = mtk_wcn_fm_chip_rds(fm, ctrl->val);
+		break;
+	case V4L2_CID_MTK_WCN_FM_BAND:
+		if (ctrl->val == fm->band)
+			break;
+		fm->band = ctrl->val;
+		mtk_wcn_fm_band_range(fm->band, &min, &max);
+		if (fm->cur_freq < min || fm->cur_freq > max) {
+			fm->cur_freq = min;
+			ret = mtk_wcn_fm_chip_tune(fm, fm->cur_freq);
+			/* The retune re-enabled the chip I2S port. */
+			if (!ret)
+				mtk_wcn_fm_i2s_resync(fm);
+		}
+		break;
+	case V4L2_CID_MTK_WCN_FM_ANTENNA:
+		ret = mtk_wcn_fm_chip_antenna(fm, ctrl->val);
+		break;
+	case V4L2_CID_MTK_WCN_FM_SOFTMUTE_GAIN:
+		ret = mtk_wcn_fm_chip_smg(fm, ctrl->val);
+		break;
+	case V4L2_CID_MTK_WCN_FM_BLEND:
+		ret = mtk_wcn_fm_chip_blend(fm, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+	mutex_unlock(&fm->lock);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops mtk_wcn_fm_ctrl_ops = {
+	.s_ctrl = mtk_wcn_fm_s_ctrl,
+};
