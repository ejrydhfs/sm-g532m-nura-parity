+/* ------------------------------------------------------------------ */
+/* Controls                                                           */
+/* ------------------------------------------------------------------ */
+/*
+ * Headphone / earpiece gain: vendor DAC_DL_PGA_Headset_GAIN[]
+ * (vendor:2846-2849), 0 = +8 dB down to 18 = -10 dB in 1 dB steps;
+ * 0x1f is the -40 dB hard mute used internally by the power sequences.
+ * Microphone preamp: vendor ADC_UL_PGA_GAIN[] (vendor:3927), 6 dB steps.
+ */
+static const DECLARE_TLV_DB_SCALE(mt6331_hp_vol_tlv, 800, -100, 0);
+static const DECLARE_TLV_DB_SCALE(mt6331_mic_amp_tlv, 0, 600, 0);
+
+/* vendor:2635-2636 speaker_PGA_function[] */
+static const char *const mt6331_spk_pga_texts[] = {
+	"MUTE", "0Db", "4Db", "5Db", "6Db", "7Db", "8Db",
+	"9Db", "10Db", "11Db", "12Db", "13Db", "14Db", "15Db", "16Db", "17Db",
+};
