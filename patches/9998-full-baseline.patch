+/* spk:200-215 GetSpeakerOcFlag: enable the speaker clock group before
+ * reading the deglitch status bits of SPK_CON6.
+ */
+static int mt6331_spk_oc_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct mt6331_priv *priv =
+		snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+	unsigned int val;
+	int ret;
+
+	mutex_lock(&priv->ana_lock);
+	mt6331_ana_write(priv, MT6328_TOP_CKPDN_CON2_CLR, RG_SPK_CK_GRP,
+			 0xffff);
+	ret = regmap_read(priv->regmap, MT6328_SPK_CON6, &val);
+	mutex_unlock(&priv->ana_lock);
+	if (ret)
+		return ret;
+
+	ucontrol->value.integer.value[0] =
+		!!(val & (RG_SPK_D_OC_L_DEG | RG_SPK_AB_OC_L_DEG));
+	dev_dbg(priv->dev,
+		"speaker OC: status 0x%04x, latched D=%d AB=%d\n",
+		val, priv->spk_d_oc, priv->spk_ab_oc);
+
+	return 0;
+}
