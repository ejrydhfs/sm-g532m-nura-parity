+/* spk:133-168 Speaker_ClassAB_Open */
+static int mt6331_speaker_classab_up(struct mt6331_priv *priv)
+{
+	unsigned int val;
+
+	/* spk:138-148 trim window and -6 dB class-AB amplifier */
+	mt6331_ana_write(priv, MT6328_SPK_CON7, 0x4531, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x1008, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON13, 0x1800, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON2, 0x02a4, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON0, 0x0800, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON9, 0x2000, 0xffff);
+	/* spk:147-148 speaker on, Vcm high-PSRR mode */
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x1009, 0xffff);
