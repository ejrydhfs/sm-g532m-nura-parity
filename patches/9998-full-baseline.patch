+/* vendor:3359-3391: uplink digital part of TurnOnADcPowerACC */
+static int mt6331_adc_power_up(struct mt6331_priv *priv)
+{
+	int ret;
+
+	ret = mt6331_topck_enable(priv, true);
+	if (ret)
+		return ret;
+
+	/* vendor:3365-3369 */
+	mt6331_ana_write(priv, MT6328_AFE_AUDIO_TOP_CON0,
+			 (priv->state & MT6331_ST_DAC) ? 0x0000 : 0x005a,
+			 0xffff);
+	mt6331_ana_write(priv, MT6328_PMIC_AFE_TOP_CON0, 0x0000, 0xffff);
+	/* vendor:3373 AFE enable */
+	mt6331_ana_write(priv, MT6328_AFE_UL_DL_CON0, 0x0001, 0xffff);
+	/* vendor:3386-3391 UL sample rate + UL turn on */
+	mt6331_ana_write(priv, MT6328_AFE_UL_SRC0_CON0_H,
+			 (mt6331_ul_rate_sel(priv->ul_rate) << 3) |
+			 (mt6331_ul_rate_sel(priv->ul_rate) << 1),
+			 RG_UL_RATE_MASK);
+	mt6331_ana_write(priv, MT6328_AFE_UL_SRC0_CON0_L, 0x0001, 0xffff);
+
+	priv->state |= MT6331_ST_ADC;
+
+	return 0;
+}
+
+static int mt6331_adc_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_ADC;
+
+	/* vendor:3395-3397 */
+	mt6331_ana_write(priv, MT6328_AFE_UL_SRC0_CON0_L, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFE_AUDIO_TOP_CON0, 0x0020, 0x0020);
+
+	if (!(priv->state & MT6331_ST_DAC)) {
+		/* vendor:3477-3480 */
+		mt6331_ana_write(priv, MT6328_AFE_UL_DL_CON0, 0x0000, 0xffff);
+		mt6331_ana_write(priv, MT6328_AFE_AUDIO_TOP_CON0, 0x0084,
+				 0x0084);
+	}
+
+	return 0;
+}
+
+/*
+ * Microphone bias.  AUDENC_ANA_CON9 bit 0 enables bias 0, bit 4 enables
+ * bias 1 and bits 8-10 select the shared reference (upmu:7091-7123).
+ * The vendor driver saves the reference programmed by the accessory
+ * detection before it takes the block over (vendor:3234-3239) and restores
+ * it when the last ADC goes away (vendor:3433-3439).
+ */
+static int mt6331_micbias_set(struct mt6331_priv *priv, bool second, bool on)
+{
+	unsigned int bit = second ? RG_AUDPWDBMICBIAS1 : RG_AUDPWDBMICBIAS0;
+	unsigned int vref;
+	int ret;
+
+	if (on) {
+		if (!priv->micbias_ref_saved) {
+			ret = regmap_read(priv->regmap, MT6328_AUDENC_ANA_CON9,
+					  &priv->micbias_ref);
+			if (ret)
+				return ret;
+			priv->micbias_ref &= RG_AUDMICBIASVREF_MASK;
+			priv->micbias_ref_saved = true;
+			vref = priv->micbias_ref;
+			/* The vendor always programs its own reference
+			 * (vendor:3280/3287); keep one already set by
+			 * the accessory detection otherwise.
+			 */
+			if (!vref)
+				vref = MT6331_MICBIAS_VREF_DEFAULT <<
+					RG_AUDMICBIASVREF_SHIFT;
+			ret = mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9,
+					       vref, RG_AUDMICBIASVREF_MASK);
+			if (ret)
+				return ret;
+		}
+		ret = mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, bit,
+				       bit);
+		if (ret)
+			return ret;
+		priv->state |= second ? MT6331_ST_MICBIAS2 :
+					MT6331_ST_MICBIAS1;
+	} else {
+		ret = mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0, bit);
+		if (ret)
+			return ret;
+		priv->state &= ~(second ? MT6331_ST_MICBIAS2 :
+				 MT6331_ST_MICBIAS1);
+
+		if (!(priv->state & (MT6331_ST_MICBIAS1 |
+				     MT6331_ST_MICBIAS2)) &&
+		    priv->micbias_ref_saved) {
+			ret = mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9,
+					       priv->micbias_ref,
+					       RG_AUDMICBIASVREF_MASK);
+			if (ret)
+				return ret;
+			priv->micbias_ref_saved = false;
+		}
+	}
+
+	return 0;
+}
+
+/*
+ * The vendor driver re-applies mAudio_Ana_Volume[MICAMP1/2] on every ADC
+ * power-up (mt_soc_codec_63xx.c:3183-3194 SetMicPGAGain) because the power
+ * down path resets RG_AUDPREAMPL/PRGAIN.  Keep the user setting here.
+ */
+static unsigned int mt6331_mic_gain_save(struct mt6331_priv *priv)
+{
+	unsigned int val;
+
+	if (!regmap_read(priv->regmap, MT6328_AUDENC_ANA_CON10, &val))
+		priv->mic_gain = val & (RG_AUDPREAMPLGAIN_MASK |
+					RG_AUDPREAMPRGAIN_MASK);
+
+	return priv->mic_gain;
+}
+
+static void mt6331_mic_gain_restore(struct mt6331_priv *priv)
+{
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON10, priv->mic_gain,
+			 RG_AUDPREAMPLGAIN_MASK | RG_AUDPREAMPRGAIN_MASK);
+}
+
+/* vendor:3273-3341 (left / main or headset mic), 3295-3354 (right / ref mic) */
+static int mt6331_pga_l_power_up(struct mt6331_priv *priv)
+{
+	/* vendor:3276 DC coupling mode of bias 0 (ACC/DCC: no ECM mode) */
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0x0000,
+			 RG_AUDMICBIAS0DCC_MASK);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0x0000,
+			 RG_AUDMICBIAS1DCC_MASK);
+
+	/* vendor:3325/3343 preamplifier input select + ADC input select */
+	if (priv->headset_mic) {
+		/* vendor:3335-3337 headset microphone on AIN1 */
+		mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0, 0x0500, 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0, 0x0581, 0xffff);
+	} else {
+		/* vendor:3329-3331 main microphone on AIN0 */
+		mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0, 0x0041, 0x00c1);
+		mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0, 0x0541, 0xffff);
+	}
+
+	mt6331_mic_gain_restore(priv);
+
+	priv->state |= MT6331_ST_PGA_L;
+
+	return 0;
+}
+
+static int mt6331_pga_l_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_PGA_L;
+
+	mt6331_mic_gain_save(priv);
+
+	/* vendor:3404-3429 */
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0, 0x0041, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON3, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON10, 0x0000,
+			 RG_AUDPREAMPLGAIN_MASK);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON4, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON6, 0x2020, 0xffff);
+
+	return 0;
+}
+
+static int mt6331_pga_r_power_up(struct mt6331_priv *priv)
+{
+	/* vendor:3295-3305 reference microphone on AIN2, bias 0 */
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0x0000,
+			 RG_AUDMICBIAS0DCC_MASK);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON10, 0x0033, 0x00ff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON3, 0x0800, 0xf900);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON1, 0x00c1, 0x00c1);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON1, 0x05c1, 0xffff);
+
+	mt6331_mic_gain_restore(priv);
+
+	priv->state |= MT6331_ST_PGA_R;
+
+	return 0;
+}
+
+static int mt6331_pga_r_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_PGA_R;
+
+	mt6331_mic_gain_save(priv);
+
+	/* vendor:3444-3467 */
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON1, 0x00c1, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON3, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON10, 0x0000,
+			 RG_AUDPREAMPRGAIN_MASK);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON1, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON4, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON6, 0x2020, 0xffff);
+
+	return 0;
+}
