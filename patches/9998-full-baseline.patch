+#define MTK_U2_HS_VRT_HOST		2
+#define MTK_U2_HS_VRT_DEVICE		7
+#define MTK_U2_HS_TERM_HOST		2
+#define MTK_U2_HS_TERM_DEVICE		7
+#define MTK_U2_HS_SQTH			1
 
 #define U3P_U2PHYBC12C		0x080
 #define P2C_RG_CHGDT_EN		BIT(0)
@@ -286,12 +334,14 @@ enum mtk_phy_version {
  *                            that is pointed at in the device tree node for this PHY
  * @slew_ref_clk_mhz:         Default reference clock (in MHz) for slew rate calibration
  * @slew_rate_coefficient:    Coefficient for slew rate calibration
+ * @mt6735_u2_quirk:          Apply the MT6735 USB2 PHY bus-force and HS eye tuning
  * @version:                  PHY IP Version
