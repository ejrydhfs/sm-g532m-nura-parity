+int mt6735_afe_rate_to_fs(unsigned int rate)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(mt6735_afe_rates); i++)
+		if (mt6735_afe_rates[i].rate == rate)
+			return mt6735_afe_rates[i].fs;
+
+	return -EINVAL;
