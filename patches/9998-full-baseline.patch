+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/ahb.c
+ *     (HifAhbProbe / HifAhbRemove / HifAhbBusCntGet / mtk_wcn_wmt_wlan_reg)
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/gl_rst.c
+ *     (whole-chip reset callback)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/rfkill.h>
+#include <linux/workqueue.h>
+
+#include "mtk_wcn_wmt.h"
+#include "wlan_hif.h"
+#include "wlan_mac.h"
+
+/* Exactly one connectivity subsystem instance. */
+static struct mtk_wlan_hif *mtk_wlan_hif;
+
+/* WMTRSTMSG_*, gl_rst.h:60-66. */
+enum mtk_wlan_reset_msg {
+	MTK_WLAN_RESET_START = 0,
+	MTK_WLAN_RESET_END = 1,
+	MTK_WLAN_RESET_END_FAIL = 2,
+};
+
+static void mtk_wlan_reset_work(struct work_struct *work)
+{
+	struct mtk_wlan_hif *hif = container_of(work, struct mtk_wlan_hif,
+						reset_work);
+
+	if (hif->reset_failed) {
+		dev_err(hif->dev, "chip reset failed, WLAN stays down\n");
+		return;
+	}
+
+	/*
+	 * Same recovery as wifi_reset_end(): let WMT power the connectivity
+	 * subsystem again, which calls the probe callback below.
+	 */
+	if (!hif->was_up)
+		return;
+
+	if (!mtk_wcn_wmt_func_on(WMTDRV_WIFI))
+		dev_err(hif->dev, "cannot re-open WLAN after chip reset\n");
+}
+
+/*
+ * Whole-chip reset notifier, ABI of glResetCallback() gl_rst.c:148-189.
+ * WMT sends WMTRSTMSG_RESET_START before pulling the subsystem reset and
+ * RESET_END once it is powered again; the re-open is deferred because it
+ * would re-enter the WMT operation thread.
+ */
+static void mtk_wlan_reset_cb(enum mtk_wcn_wmt_drv src,
+			      enum mtk_wcn_wmt_drv dst,
+			      enum mtk_wcn_wmt_msg msg, void *data, u32 len)
+{
+	struct mtk_wlan_hif *hif = READ_ONCE(mtk_wlan_hif);
+	u32 rst;
+
+	if (!hif || msg != WMTMSG_RESET || !data || len < sizeof(rst))
+		return;
+
+	rst = *(u32 *)data;
+	switch (rst) {
+	case MTK_WLAN_RESET_START:
+		dev_warn(hif->dev, "whole chip reset start\n");
+		hif->was_up = READ_ONCE(hif->up);
+		WRITE_ONCE(hif->up, false);
+		WRITE_ONCE(hif->resetting, true);
+		if (hif->was_up)
+			mtk_wlan_hif_set_int_enable(hif, false);
+		/*
+		 * Same user visible effect as wifi_reset_start(): the media
+		 * is disconnected and the interface stops pretending to be
+		 * up while the connectivity chip is reset.
+		 */
+		mtk_wlan_mac_fw_down(hif);
+		break;
+	case MTK_WLAN_RESET_END:
+	case MTK_WLAN_RESET_END_FAIL:
+		dev_warn(hif->dev, "whole chip reset %s\n",
+			 rst == MTK_WLAN_RESET_END ? "done" : "failed");
+		hif->reset_failed = rst == MTK_WLAN_RESET_END_FAIL;
+		WRITE_ONCE(hif->resetting, false);
+		schedule_work(&hif->reset_work);
+		break;
+	default:
+		break;
+	}
+}
+
+/* WMT WIFI function on callback: power up the firmware. */
+static int mtk_wlan_wmt_probe(void)
+{
+	struct mtk_wlan_hif *hif = READ_ONCE(mtk_wlan_hif);
+	int ret;
+
+	if (!hif)
+		return -ENODEV;
+
+	mutex_lock(&hif->state_lock);
+	if (READ_ONCE(hif->up)) {
+		/* Duplicate function-on, firmware is already running. */
+		ret = 0;
+	} else {
+		ret = mtk_wlan_fw_bringup(hif);
+	}
+	mutex_unlock(&hif->state_lock);
+
+	/*
+	 * Publish or withdraw the netdev.  Done outside &hif->state_lock and
+	 * from a work item because registering and unregistering a netdev
+	 * takes the RTNL.
+	 */
+	if (ret)
+		mtk_wlan_mac_fw_down(hif);
+	else
+		mtk_wlan_mac_fw_up(hif);
+
+	return ret;
+}
+
+/* WMT WIFI function off callback: quiesce the HIF. */
+static int mtk_wlan_wmt_remove(void)
+{
+	struct mtk_wlan_hif *hif = READ_ONCE(mtk_wlan_hif);
+
+	if (!hif)
+		return 0;
+
+	mutex_lock(&hif->state_lock);
+	mtk_wlan_hif_stop(hif);
+	mutex_unlock(&hif->state_lock);
+
+	mtk_wlan_mac_fw_down(hif);
+
+	return 0;
+}
+
+/* Frames handed to the HIF, reported to WMT (ahb.c:1418-1438). */
+static int mtk_wlan_wmt_bus_tx_cnt(void)
+{
+	struct mtk_wlan_hif *hif = READ_ONCE(mtk_wlan_hif);
+
+	return hif ? atomic_read(&hif->tx_count) : 0;
+}
+
+static int mtk_wlan_wmt_bus_tx_cnt_clr(void)
+{
+	struct mtk_wlan_hif *hif = READ_ONCE(mtk_wlan_hif);
+
+	if (hif)
+		atomic_set(&hif->tx_count, 0);
+	return 0;
+}
+
+static const struct mtk_wcn_wmt_wlan_cb mtk_wlan_wmt_cb = {
+	.probe = mtk_wlan_wmt_probe,
+	.remove = mtk_wlan_wmt_remove,
+	.bus_tx_cnt = mtk_wlan_wmt_bus_tx_cnt,
+	.bus_tx_cnt_clr = mtk_wlan_wmt_bus_tx_cnt_clr,
+};
+
+/*
+ * rfkill drives the WMT WIFI function.  Blocking it powers the connectivity
+ * subsystem down, which calls mtk_wlan_wmt_remove() and therefore withdraws
+ * the netdev as well, so a blocked switch can never leave an interface that
+ * looks up while the firmware is gone.  The ROM has no rfkill integration
+ * (neither gl_init.c nor gl_kal.c register one); the control channel there is
+ * /dev/wmtWifi (wmt_chrdev_wifi.c).  The switch is optional: without
+ * CONFIG_RFKILL, WMT remains the only control path, exactly as on the ROM.
+ */
+#if IS_ENABLED(CONFIG_RFKILL)
+static int mtk_wlan_rfkill_set_block(void *data, bool blocked)
+{
+	struct mtk_wlan_hif *hif = data;
+
+	if (READ_ONCE(hif->resetting))
+		return 0;
+
+	if (blocked) {
+		if (READ_ONCE(hif->up))
+			mtk_wcn_wmt_func_off(WMTDRV_WIFI);
+		/* Make sure no interface survives a failed power-off. */
+		mtk_wlan_mac_fw_down(hif);
+	} else if (!READ_ONCE(hif->up)) {
+		if (!mtk_wcn_wmt_func_on(WMTDRV_WIFI)) {
+			dev_err(hif->dev, "cannot power WLAN on\n");
+			return -EIO;
+		}
+	}
+
+	return 0;
+}
+
+static const struct rfkill_ops mtk_wlan_rfkill_ops = {
+	.set_block = mtk_wlan_rfkill_set_block,
+};
+#endif /* CONFIG_RFKILL */
+
+int mtk_wlan_main_attach(struct mtk_wlan_hif *hif)
+{
+	int ret;
+
+	WRITE_ONCE(mtk_wlan_hif, hif);
+
+	INIT_WORK(&hif->reset_work, mtk_wlan_reset_work);
+
+	/*
+	 * Create the wiphy and the netdev first: the WMT callbacks registered
+	 * below may power the firmware up before this function returns.
+	 */
+	ret = mtk_wlan_mac_attach(hif);
+	if (ret) {
+		dev_err(hif->dev, "cannot create the 802.11 interface: %d\n",
+			ret);
+		WRITE_ONCE(mtk_wlan_hif, NULL);
+		return ret;
+	}
+
+	/* Register the reset notifier first so it covers bring-up failures. */
+	ret = mtk_wcn_wmt_msgcb_reg(WMTDRV_WIFI, mtk_wlan_reset_cb);
+	if (ret)
+		dev_err(hif->dev, "cannot register reset callback: %d\n", ret);
+	else
+		hif->msgcb_registered = true;
+
+#if IS_ENABLED(CONFIG_RFKILL)
+	hif->rfkill = rfkill_alloc("mtk-wlan", hif->dev, RFKILL_TYPE_WLAN,
+				   &mtk_wlan_rfkill_ops, hif);
+	if (IS_ERR(hif->rfkill)) {
+		dev_warn(hif->dev, "cannot allocate rfkill\n");
+		hif->rfkill = NULL;
+	} else {
+		ret = rfkill_register(hif->rfkill);
+		if (ret) {
+			dev_err(hif->dev, "cannot register rfkill: %d\n", ret);
+			rfkill_destroy(hif->rfkill);
+			hif->rfkill = NULL;
+		}
+	}
+#endif /* CONFIG_RFKILL */
+
+	if (mtk_wcn_wmt_wlan_reg(&mtk_wlan_wmt_cb)) {
+		dev_err(hif->dev, "cannot register with WMT\n");
+		if (hif->rfkill) {
+			rfkill_unregister(hif->rfkill);
+			rfkill_destroy(hif->rfkill);
+			hif->rfkill = NULL;
+		}
+		if (hif->msgcb_registered) {
+			mtk_wcn_wmt_msgcb_unreg(WMTDRV_WIFI);
+			hif->msgcb_registered = false;
+		}
+		mtk_wlan_mac_detach(hif);
+		WRITE_ONCE(mtk_wlan_hif, NULL);
+		return -EIO;
+	}
+
+	hif->wmt_registered = true;
+	return 0;
+}
+
+void mtk_wlan_main_detach(struct mtk_wlan_hif *hif)
+{
+	/* Stop reset recovery before the callbacks it would use go away. */
+	if (hif->msgcb_registered) {
+		mtk_wcn_wmt_msgcb_unreg(WMTDRV_WIFI);
+		hif->msgcb_registered = false;
+	}
+	cancel_work_sync(&hif->reset_work);
+
+	if (hif->wmt_registered) {
+		/* Drop the function while the connectivity subsystem is alive. */
+		if (READ_ONCE(hif->up))
+			mtk_wcn_wmt_func_off(WMTDRV_WIFI);
+		mtk_wcn_wmt_wlan_unreg();
+		hif->wmt_registered = false;
+	}
+
+	if (hif->rfkill) {
+		rfkill_unregister(hif->rfkill);
+		rfkill_destroy(hif->rfkill);
+		hif->rfkill = NULL;
+	}
+
+	mtk_wlan_mac_detach(hif);
+
+	WRITE_ONCE(mtk_wlan_hif, NULL);
+}
+
+/**
+ * mtk_wcn_wlan_gen2_init() - load the MediaTek WLAN driver
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int mtk_wcn_wlan_gen2_init(void)
+{
+	int ret = mtk_wlan_ahb_driver_register();
+
+	if (ret)
+		pr_err("mtk_wcn_wlan: cannot register AHB driver: %d\n", ret);
+
+	return ret;
+}
+EXPORT_SYMBOL(mtk_wcn_wlan_gen2_init);
+
+void mtk_wcn_wlan_gen2_exit(void)
+{
+	mtk_wlan_ahb_driver_unregister();
+}
+EXPORT_SYMBOL(mtk_wcn_wlan_gen2_exit);
+
+module_init(mtk_wcn_wlan_gen2_init);
+module_exit(mtk_wcn_wlan_gen2_exit);
+
+MODULE_DESCRIPTION("MediaTek WLAN (CONSYS gen2) AHB host interface");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_mgmt.c b/drivers/misc/mediatek/connectivity/wlan/wlan_mgmt.c
new file mode 100644
index 000000000..ffd75a9cb
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_mgmt.c
@@ -0,0 +1,1185 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 STA management: software scan and open-system
+ * authentication/association.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   mgmt/auth.c          (authComposeAuthFrameHeaderAndFF, authSendAuthFrame,
+ *                         authSendDeauthFrame)
+ *   mgmt/assoc.c         (assocComposeReAssocReqFrameHeaderAndFF,
+ *                         assocBuildReAssocReqFrameCommonIEs,
+ *                         assocBuildCapabilityInfo)
+ *   mgmt/ais_fsm.c       (AIS auth/assoc state machine, deauth on disconnect)
+ *   mgmt/scan.c          (BSS result parsing from beacons/probe responses,
+ *                         scanUpdateBssDesc(): trust the DS/HT channel IE)
+ *   mgmt/scan_fsm.c      (scan request handling; downstream sends
+ *                         CMD_ID_SCAN_REQ to the firmware, which this port
+ *                         cannot do)
+ *   os/linux/gl_kal.c    (kalIndicateStatusAndComplete: connect/disconnect
+ *                         notifications to cfg80211)
+ *
+ * The downstream driver lets the firmware run the scan and keeps the
+ * firmware STA record in sync over CMD_ID_UPDATE_STA_RECORD and
+ * CMD_ID_SET_BSS_INFO; this port drives the same management frames from the
+ * host and has no firmware command queue, see the report for the resulting
+ * boundary.
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/ieee80211.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/timekeeping.h>
+
+#include "wlan_cmd.h"
+#include "wlan_mac.h"
+
+/* 2.4 GHz basic rate set advertised in probe/assoc requests (500 kb/s). */
+static const u8 mtk_wlan_basic_rates[] = {
+	MTK_WLAN_RATE_1M | MTK_WLAN_RATE_BASIC_BIT,
+	MTK_WLAN_RATE_2M | MTK_WLAN_RATE_BASIC_BIT,
+	MTK_WLAN_RATE_5_5M | MTK_WLAN_RATE_BASIC_BIT,
+	MTK_WLAN_RATE_11M | MTK_WLAN_RATE_BASIC_BIT,
+};
+
+/* OFDM rates moved to the Extended Supported Rates element (8 octets). */
+static const u8 mtk_wlan_ofdm_rates[] = {
+	MTK_WLAN_RATE_6M,
+	MTK_WLAN_RATE_9M,
+	MTK_WLAN_RATE_12M,
+	MTK_WLAN_RATE_18M,
+	MTK_WLAN_RATE_24M,
+	MTK_WLAN_RATE_36M,
+	MTK_WLAN_RATE_48M,
+	MTK_WLAN_RATE_54M,
+};
+
+/* Append one information element, returns the number of bytes written. */
+static size_t mtk_wlan_ie_put(u8 *buf, size_t off, u8 id, const void *data,
+			      size_t len)
+{
+	buf[off] = id;
+	buf[off + 1] = (u8)len;
+	if (len)
+		memcpy(buf + off + 2, data, len);
+	return len + 2;
+}
+
+/*
+ * Build a probe request for one channel and one SSID.  The element set
+ * (SSID, supported rates, DS parameter set, extended supported rates,
+ * followed by the IEs requested by cfg80211) follows 802.11-2016 9.3.3.9;
+ * the DS element is mandatory in a probe request and tells the AP which
+ * channel the STA is probing (ELEM_ID_DS_PARAMS, mac.h:760).
+ */
+static int mtk_wlan_build_probe_req(struct mtk_wlan_mac *mac, u8 channel,
+				    const u8 *ssid, size_t ssid_len,
+				    const u8 *extra_ie, size_t extra_ie_len,
+				    u8 *buf, size_t bufsz)
+{
+	struct ieee80211_mgmt *mgmt = (struct ieee80211_mgmt *)buf;
+	size_t len = MTK_WLAN_MAC_HDR_LEN;
+	u8 ds = channel;
+
+	if (MTK_WLAN_MAC_HDR_LEN + 2 + ssid_len + 2 + sizeof(mtk_wlan_basic_rates) +
+	    2 + 1 + 2 + sizeof(mtk_wlan_ofdm_rates) + extra_ie_len > bufsz)
+		return -EMSGSIZE;
+	if (ssid_len > IEEE80211_MAX_SSID_LEN)
+		return -EINVAL;
+
+	mgmt->frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					  IEEE80211_STYPE_PROBE_REQ);
+	mgmt->duration = 0;
+	eth_broadcast_addr(mgmt->da);
+	ether_addr_copy(mgmt->sa, mac->mac_addr);
+	eth_broadcast_addr(mgmt->bssid);
+	mgmt->seq_ctrl = 0;
+
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_SSID, ssid, ssid_len);
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_SUPP_RATES,
+			       mtk_wlan_basic_rates,
+			       sizeof(mtk_wlan_basic_rates));
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_DS_PARAMS, &ds, sizeof(ds));
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_EXT_SUPP_RATES,
+			       mtk_wlan_ofdm_rates,
+			       sizeof(mtk_wlan_ofdm_rates));
+	if (extra_ie_len) {
+		memcpy(buf + len, extra_ie, extra_ie_len);
+		len += extra_ie_len;
+	}
+
+	return len;
+}
+
+/* Scan channels are restricted to the 2.4 GHz band this chip supports. */
+static bool mtk_wlan_channel_usable(const struct ieee80211_channel *chan)
+{
+	return chan->band == NL80211_BAND_2GHZ &&
+	       !(chan->flags & IEEE80211_CHAN_DISABLED);
+}
+
+/*
+ * Dwell time for one channel.  cfg80211 reports it in TUs (1 TU = 1024 us,
+ * cfg80211.h:2860-2864) when the scan request sets it.  The value is bounded
+ * so a malformed request cannot park a scan for minutes; the bound is a
+ * driver policy, not a hardware limit.
+ */
+static unsigned int mtk_wlan_scan_dwell_ms(const struct cfg80211_scan_request *req)
+{
+	u64 us;
+
+	if (!req->duration)
+		return MTK_WLAN_SCAN_DWELL_MS;
+
+	us = (u64)req->duration * 1024;
+	return clamp_t(u64, DIV_ROUND_UP_ULL(us, 1000), 1,
+		       MTK_WLAN_SCAN_DWELL_MAX_MS);
+}
+
+/*
+ * Wait for the dwell time, polling the abort flag and the firmware state.
+ * Return: %false when the scan was cancelled or the firmware went away.
+ */
+static bool mtk_wlan_scan_wait(struct mtk_wlan_mac *mac, unsigned int ms)
+{
+	unsigned long end = jiffies + msecs_to_jiffies(ms);
+
+	do {
+		if (READ_ONCE(mac->scan_aborted) || !READ_ONCE(mac->fw_up))
+			return false;
+		msleep(MTK_WLAN_SCAN_POLL_MS);
+	} while (time_before(jiffies, end));
+
+	return !READ_ONCE(mac->scan_aborted) && READ_ONCE(mac->fw_up);
+}
+
+/**
+ * mtk_wlan_mgmt_scan - start a software scan
+ * @mac: MAC instance
+ * @req: cfg80211 scan request, valid until cfg80211_scan_done()
+ *
+ * Return: 0 when the scan was started, negative errno otherwise.
+ */
+int mtk_wlan_mgmt_scan(struct mtk_wlan_mac *mac,
+		       struct cfg80211_scan_request *req)
+{
+	if (!READ_ONCE(mac->fw_up))
+		return -ENETDOWN;
+	if (READ_ONCE(mac->state) == MTK_WLAN_STATE_CONNECTING)
+		return -EBUSY;
+	if (!req->n_channels)
+		return -EINVAL;
+	if (READ_ONCE(mac->scan_req))
+		return -EBUSY;
+
+	WRITE_ONCE(mac->scan_aborted, false);
+	WRITE_ONCE(mac->scan_req, req);
+	WRITE_ONCE(mac->state, MTK_WLAN_STATE_SCANNING);
+	schedule_work(&mac->scan_work);
+
+	return 0;
+}
+
+/**
+ * mtk_wlan_mgmt_abort_scan - cancel a running scan
+ * @mac: MAC instance
+ *
+ * The worker notices the flag within one dwell poll, stops probing and
+ * reports the scan as aborted through cfg80211_scan_done(), as the cfg80211
+ * abort_scan callback requires.  Completion is always done by the worker, so
+ * the request is signalled exactly once.
+ */
+void mtk_wlan_mgmt_abort_scan(struct mtk_wlan_mac *mac)
+{
+	WRITE_ONCE(mac->scan_aborted, true);
+}
+
+/* Report a scan completion exactly once, from the worker or its fallback. */
+static void mtk_wlan_scan_complete(struct mtk_wlan_mac *mac,
+				   struct cfg80211_scan_request *req,
+				   bool aborted)
+{
+	struct cfg80211_scan_info info = {
+		.aborted = aborted,
+	};
+
+	WRITE_ONCE(mac->scan_req, NULL);
+	if (READ_ONCE(mac->state) == MTK_WLAN_STATE_SCANNING)
+		WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+			   (READ_ONCE(mac->connected) ?
+			    MTK_WLAN_STATE_CONNECTED : MTK_WLAN_STATE_IDLE) :
+			   MTK_WLAN_STATE_DOWN);
+
+	cfg80211_scan_done(req, &info);
+}
+
+/**
+ * mtk_wlan_mgmt_scan_work - transmit probe requests on every requested channel
+ * @work: &struct mtk_wlan_mac.scan_work
+ *
+ * The firmware owns the RF channel; without a firmware channel-switch or
+ * scan command the host can only transmit probe requests and collect the
+ * responses that the firmware receives on its current channel.  Passive
+ * scans (no SSID in the request) send nothing and only collect beacons.
+ * See the report for this hardware-scan boundary.
+ */
+void mtk_wlan_mgmt_scan_work(struct work_struct *work)
+{
+	struct mtk_wlan_mac *mac = container_of(work, struct mtk_wlan_mac,
+						scan_work);
+	struct cfg80211_scan_request *req = READ_ONCE(mac->scan_req);
+	u8 frame[MTK_WLAN_MGMT_FRAME_MAX];
+	bool aborted = false;
+	unsigned int i, s;
+
+	if (!req)
+		return;
+
+	for (i = 0; i < req->n_channels; i++) {
+		const struct ieee80211_channel *chan = req->channels[i];
+		u8 number;
+
+		if (READ_ONCE(mac->scan_aborted) || !READ_ONCE(mac->fw_up)) {
+			aborted = true;
+			break;
+		}
+		if (!mtk_wlan_channel_usable(chan))
+			continue;
+
+		number = ieee80211_frequency_to_channel(chan->center_freq);
+
+		/*
+		 * No probe request on a no-IR channel (regulatory rule) and
+		 * none at all for a passive scan, which cfg80211 expresses by
+		 * n_ssids == 0.
+		 */
+		if (req->n_ssids && !(chan->flags & IEEE80211_CHAN_NO_IR)) {
+			for (s = 0; s < req->n_ssids; s++) {
+				const u8 *ssid = req->ssids[s].ssid;
+				size_t ssid_len = req->ssids[s].ssid_len;
+				int len;
+
+				len = mtk_wlan_build_probe_req(mac, number, ssid,
+							       ssid_len, req->ie,
+							       req->ie_len, frame,
+							       sizeof(frame));
+				if (len < 0) {
+					dev_warn_ratelimited(mac->dev,
+							     "cannot build probe request: %d\n",
+							     len);
+					continue;
+				}
+
+				if (mtk_wlan_mgmt_tx(mac, frame, len)) {
+					dev_warn_ratelimited(mac->dev,
+							     "probe request TX failed on channel %u\n",
+							     number);
+					if (!READ_ONCE(mac->fw_up)) {
+						aborted = true;
+						break;
+					}
+				}
+			}
+		}
+
+		if (aborted)
+			break;
+		if (!mtk_wlan_scan_wait(mac, mtk_wlan_scan_dwell_ms(req))) {
+			aborted = true;
+			break;
+		}
+	}
+
+	mtk_wlan_scan_complete(mac, req, aborted);
+}
+
+/*
+ * Compose an authentication frame, authComposeAuthFrameHeaderAndFF()
+ * auth.c:258-325: address 1 is the BSSID, address 2 our MAC and address 3
+ * the BSSID for the first transaction; the body carries algorithm,
+ * transaction sequence number and status code.
+ */
+static size_t mtk_wlan_build_auth(struct mtk_wlan_mac *mac,
+				  const u8 *peer, u16 seq, u16 status,
+				  u8 *buf, size_t bufsz)
+{
+	struct ieee80211_mgmt *mgmt = (struct ieee80211_mgmt *)buf;
+
+	if (bufsz < MTK_WLAN_MAC_HDR_LEN + 6)
+		return 0;
+
+	mgmt->frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					  IEEE80211_STYPE_AUTH);
+	mgmt->duration = 0;
+	ether_addr_copy(mgmt->da, peer);
+	ether_addr_copy(mgmt->sa, mac->mac_addr);
+	ether_addr_copy(mgmt->bssid, peer);
+	mgmt->seq_ctrl = 0;
+	mgmt->u.auth.auth_alg = cpu_to_le16(WLAN_AUTH_OPEN);
+	mgmt->u.auth.auth_transaction = cpu_to_le16(seq);
+	mgmt->u.auth.status_code = cpu_to_le16(status);
+
+	return MTK_WLAN_MAC_HDR_LEN + 6;
+}
+
+/*
+ * Compose an association request, assocComposeReAssocReqFrameHeaderAndFF()
+ * assoc.c:747-823 and assocBuildReAssocReqFrameCommonIEs() assoc.c:587-731:
+ * capability information (ESS only, no privacy, assocBuildCapabilityInfo()
+ * assoc.c:505-575), listen interval, SSID, supported rates, extended
+ * supported rates and the IEs requested by cfg80211.
+ *
+ * @ies receives the IEs starting at the SSID element for
+ * cfg80211_connect_result().
+ */
+static int mtk_wlan_build_assoc_req(struct mtk_wlan_mac *mac, const u8 *peer,
+				    const u8 *extra_ie, size_t extra_ie_len,
+				    u8 *buf, size_t bufsz,
+				    u8 *ies, size_t ies_sz, size_t *ies_len)
+{
+	struct ieee80211_mgmt *mgmt = (struct ieee80211_mgmt *)buf;
+	size_t len = MTK_WLAN_MAC_HDR_LEN + 4;
+	size_t ie_start = len, ie_out_len;
+
+	if (MTK_WLAN_MAC_HDR_LEN + 4 + 2 + mac->ssid_len +
+	    2 + sizeof(mtk_wlan_basic_rates) + 2 +
+	    sizeof(mtk_wlan_ofdm_rates) + extra_ie_len > bufsz)
+		return -EMSGSIZE;
+
+	mgmt->frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					  IEEE80211_STYPE_ASSOC_REQ);
+	mgmt->duration = 0;
+	ether_addr_copy(mgmt->da, peer);
+	ether_addr_copy(mgmt->sa, mac->mac_addr);
+	ether_addr_copy(mgmt->bssid, peer);
+	mgmt->seq_ctrl = 0;
+
+	/* CAP_INFO_ESS, station not CF-pollable, no privacy (open only). */
+	mgmt->u.assoc_req.capab_info = cpu_to_le16(WLAN_CAPABILITY_ESS);
+	mgmt->u.assoc_req.listen_interval =
+		cpu_to_le16(MTK_WLAN_LISTEN_INTERVAL);
+
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_SSID, mac->ssid,
+			       mac->ssid_len);
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_SUPP_RATES,
+			       mtk_wlan_basic_rates,
+			       sizeof(mtk_wlan_basic_rates));
+	len += mtk_wlan_ie_put(buf, len, WLAN_EID_EXT_SUPP_RATES,
+			       mtk_wlan_ofdm_rates,
+			       sizeof(mtk_wlan_ofdm_rates));
+	if (extra_ie_len) {
+		memcpy(buf + len, extra_ie, extra_ie_len);
+		len += extra_ie_len;
+	}
+
+	ie_out_len = min(len - ie_start, ies_sz);
+	memcpy(ies, buf + ie_start, ie_out_len);
+	*ies_len = ie_out_len;
+
+	return len;
+}
+
+/* Compose a deauthentication frame, authSendDeauthFrame() auth.c:932-1139. */
+static size_t mtk_wlan_build_deauth(struct mtk_wlan_mac *mac, const u8 *peer,
+				    u16 reason, u8 *buf, size_t bufsz)
+{
+	struct ieee80211_mgmt *mgmt = (struct ieee80211_mgmt *)buf;
+
+	if (bufsz < MTK_WLAN_MAC_HDR_LEN + 2)
+		return 0;
+
+	mgmt->frame_control = cpu_to_le16(IEEE80211_FTYPE_MGMT |
+					  IEEE80211_STYPE_DEAUTH);
+	mgmt->duration = 0;
+	ether_addr_copy(mgmt->da, peer);
+	ether_addr_copy(mgmt->sa, mac->mac_addr);
+	ether_addr_copy(mgmt->bssid, peer);
+	mgmt->seq_ctrl = 0;
+	mgmt->u.deauth.reason_code = cpu_to_le16(reason);
+
+	return MTK_WLAN_MAC_HDR_LEN + 2;
+}
+
+/*
+ * Transmit one management frame and wait for the matching response.  The RX
+ * path stores the response and completes &mac->mgmt_done.  A firmware-down
+ * or a locally requested disconnect releases the wait with an error, so the
+ * caller never sleeps longer than one timeout after the exchange is over.
+ */
+static int mtk_wlan_mgmt_exchange(struct mtk_wlan_mac *mac, u16 stype,
+				  const u8 *peer, const u8 *frame, size_t len,
+				  struct mtk_wlan_mgmt_rsp *rsp)
+{
+	unsigned long timeout = msecs_to_jiffies(MTK_WLAN_MGMT_TIMEOUT_MS);
+	int tries;
+
+	for (tries = 0; tries < MTK_WLAN_MGMT_RETRIES; tries++) {
+		int ret;
+
+		if (!READ_ONCE(mac->fw_up))
+			return -ENETDOWN;
+		if (READ_ONCE(mac->connect_aborted))
+			return -ECANCELED;
+		if (READ_ONCE(mac->state) != MTK_WLAN_STATE_CONNECTING)
+			return -ECANCELED;
+
+		reinit_completion(&mac->mgmt_done);
+		spin_lock_bh(&mac->rx_lock);
+		mac->mgmt_stype = stype;
+		ether_addr_copy(mac->mgmt_peer, peer);
+		mac->mgmt_err = 0;
+		mac->mgmt_rsp.ies_len = 0;
+		spin_unlock_bh(&mac->rx_lock);
+
+		ret = mtk_wlan_mgmt_tx(mac, frame, len);
+		if (ret) {
+			spin_lock_bh(&mac->rx_lock);
+			mac->mgmt_stype = 0;
+			spin_unlock_bh(&mac->rx_lock);
+			return ret;
+		}
+
+		if (!wait_for_completion_timeout(&mac->mgmt_done, timeout)) {
+			dev_dbg(mac->dev, "no response to subtype %#x, retry %d\n",
+				stype, tries);
+			spin_lock_bh(&mac->rx_lock);
+			mac->mgmt_stype = 0;
+			spin_unlock_bh(&mac->rx_lock);
+			continue;
+		}
+
+		spin_lock_bh(&mac->rx_lock);
+		mac->mgmt_stype = 0;
+		ret = mac->mgmt_err;
+		if (!ret)
+			*rsp = mac->mgmt_rsp;
+		spin_unlock_bh(&mac->rx_lock);
+
+		return ret;
+	}
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * Release the BSS reference taken by mtk_wlan_mgmt_connect() when no result
+ * is going to be reported to cfg80211.  Called with &mac->lock held.
+ */
+static void mtk_wlan_connect_release(struct mtk_wlan_mac *mac)
+{
+	struct cfg80211_bss *bss = mac->connect_bss;
+
+	mac->connect_bss = NULL;
+	if (bss)
+		cfg80211_put_bss(mac->wiphy, bss);
+}
+
+/*
+ * Report a failed connection attempt.  cfg80211 expects either an explicit
+ * status code from the peer or a timeout notification, never silence.  The
+ * BSS reference from connect() is handed over to cfg80211, which consumes it
+ * on every path (sme.c:837-848).  Called with &mac->lock held.
+ *
+ * @status: peer status code, or -1 for a failure without a status code
+ */
+static void mtk_wlan_connect_report_fail(struct mtk_wlan_mac *mac, int status,
+					 enum nl80211_timeout_reason reason)
+{
+	struct cfg80211_bss *bss = mac->connect_bss;
+
+	mac->connect_bss = NULL;
+	if (mac->registered)
+		cfg80211_connect_bss(mac->ndev, mac->bssid, bss, mac->req_ie,
+				     mac->req_ie_len, NULL, 0, status,
+				     GFP_KERNEL, reason);
+	else if (bss)
+		cfg80211_put_bss(mac->wiphy, bss);
+}
+
+/* Release the firmware association state after a failed or cancelled attempt. */
+static void mtk_wlan_connect_fw_teardown(struct mtk_wlan_mac *mac)
+{
+	mtk_wlan_cmd_teardown(mac);
+	mac->sta_valid = false;
+	mac->aid = 0;
+}
+
+/**
+ * mtk_wlan_mgmt_connect_work - open-system auth/assoc state machine
+ * @work: &struct mtk_wlan_mac.connect_work
+ *
+ * Mirrors aaaFsmRunEventRxAuth()/aisFsmRunEventJoinComplete(): activate the
+ * AIS network and create the AP peer record, send the authentication request,
+ * wait for the authentication response carrying transaction sequence 2 and
+ * status 0, send the association request, wait for an association response,
+ * then update the peer record to associated and sync the BSS state before
+ * cfg80211 is told about the connection.  Only open-system authentication is
+ * advertised, so a challenge-text exchange never happens.
+ */
+void mtk_wlan_mgmt_connect_work(struct work_struct *work)
+{
+	struct mtk_wlan_mac *mac = container_of(work, struct mtk_wlan_mac,
+						connect_work);
+	struct mtk_wlan_mgmt_rsp rsp;
+	u8 frame[MTK_WLAN_MGMT_FRAME_MAX];
+	u8 req_ies[MTK_WLAN_ASSOC_IES_MAX];
+	size_t req_ies_len = 0;
+	size_t len;
+	int ret;
+
+	mutex_lock(&mac->lock);
+
+	if (READ_ONCE(mac->state) != MTK_WLAN_STATE_CONNECTING ||
+	    READ_ONCE(mac->connect_aborted)) {
+		/* Cancelled before the worker ran: nothing to report. */
+		mtk_wlan_connect_release(mac);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	if (!READ_ONCE(mac->fw_up)) {
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_DOWN);
+		mtk_wlan_connect_report_fail(mac, -1,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+
+	/*
+	 * Firmware bring-up for the join: activate the AIS network
+	 * (nicActivateNetwork(), ais_fsm.c:1873) and install the AP peer
+	 * record in its initial state (ais_fsm.c:1372-1384).
+	 */
+	ret = mtk_wlan_cmd_bss_activate(mac, true);
+	if (ret) {
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_DOWN);
+		mtk_wlan_connect_report_fail(mac, -1,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	ret = mtk_wlan_cmd_update_sta(mac, MTK_WLAN_STA_STATE_1, 0, false);
+	if (ret) {
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, -1,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	mac->sta_valid = true;
+
+	/* Step 1: open-system authentication, transaction sequence 1. */
+	len = mtk_wlan_build_auth(mac, mac->bssid, 1, 0, frame, sizeof(frame));
+	if (!len) {
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, -1, NL80211_TIMEOUT_AUTH);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+
+	ret = mtk_wlan_mgmt_exchange(mac, IEEE80211_STYPE_AUTH, mac->bssid,
+				     frame, len, &rsp);
+	if (ret) {
+		bool cancelled = READ_ONCE(mac->connect_aborted) ||
+				 READ_ONCE(mac->state) !=
+				 MTK_WLAN_STATE_CONNECTING;
+		bool down = ret == -ENETDOWN || !READ_ONCE(mac->fw_up);
+
+		mtk_wlan_connect_fw_teardown(mac);
+		if (cancelled) {
+			mtk_wlan_connect_release(mac);
+			mutex_unlock(&mac->lock);
+			return;
+		}
+		WRITE_ONCE(mac->state, down ? MTK_WLAN_STATE_DOWN :
+			   MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, -1, NL80211_TIMEOUT_AUTH);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	if (rsp.status != WLAN_STATUS_SUCCESS) {
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, rsp.status,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+
+	/* Step 2: association request. */
+	ret = mtk_wlan_build_assoc_req(mac, mac->bssid, mac->assoc_ie,
+				       mac->assoc_ie_len, frame, sizeof(frame),
+				       req_ies, sizeof(req_ies), &req_ies_len);
+	if (ret < 0) {
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, WLAN_STATUS_UNSPECIFIED_FAILURE,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	len = ret;
+
+	ret = mtk_wlan_mgmt_exchange(mac, IEEE80211_STYPE_ASSOC_RESP,
+				     mac->bssid, frame, len, &rsp);
+	if (ret) {
+		bool cancelled = READ_ONCE(mac->connect_aborted) ||
+				 READ_ONCE(mac->state) !=
+				 MTK_WLAN_STATE_CONNECTING;
+		bool down = ret == -ENETDOWN || !READ_ONCE(mac->fw_up);
+
+		mtk_wlan_connect_fw_teardown(mac);
+		if (cancelled) {
+			mtk_wlan_connect_release(mac);
+			mutex_unlock(&mac->lock);
+			return;
+		}
+		WRITE_ONCE(mac->state, down ? MTK_WLAN_STATE_DOWN :
+			   MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, -1, NL80211_TIMEOUT_ASSOC);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	if (rsp.status != WLAN_STATUS_SUCCESS) {
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, MTK_WLAN_STATE_IDLE);
+		mtk_wlan_connect_report_fail(mac, rsp.status,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+
+	/*
+	 * Step 3: the AP accepted us.  Move the peer record to class 3 with
+	 * the assigned AID (cnmStaRecChangeState() with STA_STATE_3 sends the
+	 * update and waits for the result, cnm_mem.c:1032-1056), then sync the
+	 * BSS state; downstream does exactly this before indicating the media
+	 * state to the host (ais_fsm.c:3353-3358).
+	 */
+	mac->aid = rsp.aid;
+	ret = mtk_wlan_cmd_update_sta(mac, MTK_WLAN_STA_STATE_3, mac->aid, true);
+	if (ret) {
+		dev_warn(mac->dev, "cannot update the STA record: %d\n", ret);
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+			   MTK_WLAN_STATE_IDLE : MTK_WLAN_STATE_DOWN);
+		mtk_wlan_connect_report_fail(mac, -1,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+	ret = mtk_wlan_cmd_set_bss_info(mac, true);
+	if (ret) {
+		dev_warn(mac->dev, "cannot set the BSS info: %d\n", ret);
+		mtk_wlan_connect_fw_teardown(mac);
+		WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+			   MTK_WLAN_STATE_IDLE : MTK_WLAN_STATE_DOWN);
+		mtk_wlan_connect_report_fail(mac, -1,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		mutex_unlock(&mac->lock);
+		return;
+	}
+
+	ether_addr_copy(mac->req_ie, req_ies);
+	mac->req_ie_len = req_ies_len;
+	WRITE_ONCE(mac->connected, true);
+	mac->assoc_ts = jiffies;
+	WRITE_ONCE(mac->state, MTK_WLAN_STATE_CONNECTED);
+	mtk_wlan_netdev_link_changed(mac, true);
+
+	{
+		struct cfg80211_bss *bss = mac->connect_bss;
+
+		mac->connect_bss = NULL;
+		if (mac->registered)
+			cfg80211_connect_bss(mac->ndev, mac->bssid, bss,
+					     mac->req_ie, mac->req_ie_len,
+					     rsp.ies, rsp.ies_len,
+					     WLAN_STATUS_SUCCESS, GFP_KERNEL,
+					     NL80211_TIMEOUT_UNSPECIFIED);
+		else if (bss)
+			cfg80211_put_bss(mac->wiphy, bss);
+	}
+	mutex_unlock(&mac->lock);
+
+	dev_info(mac->dev, "associated to %pM on channel %u\n", mac->bssid,
+		 mac->channel);
+}
+
+/*
+ * Tear down the association state, report it to cfg80211 and stop the TX
+ * path.  Takes &mac->lock itself.
+ */
+static void mtk_wlan_link_down(struct mtk_wlan_mac *mac, u16 reason,
+			       bool locally)
+{
+	bool was_connected;
+	struct sk_buff *skb;
+
+	mutex_lock(&mac->lock);
+	was_connected = READ_ONCE(mac->connected);
+	WRITE_ONCE(mac->connected, false);
+	if (READ_ONCE(mac->state) != MTK_WLAN_STATE_DOWN)
+		WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+			   MTK_WLAN_STATE_IDLE : MTK_WLAN_STATE_DOWN);
+	mtk_wlan_netdev_link_changed(mac, false);
+	mutex_unlock(&mac->lock);
+
+	/*
+	 * Release the firmware peer/BSS state: SET_BSS_INFO disconnected, the
+	 * STA record remove command and network deactivation.  Skipped when
+	 * the firmware is already gone.
+	 */
+	if (was_connected || mac->sta_valid)
+		mtk_wlan_cmd_teardown(mac);
+
+	while ((skb = skb_dequeue(&mac->txq)))
+		dev_kfree_skb(skb);
+
+	if (was_connected && mac->registered)
+		cfg80211_disconnected(mac->ndev, reason, NULL, 0, locally,
+				      GFP_KERNEL);
+}
+
+/**
+ * mtk_wlan_mgmt_deauth_rx - handle a deauthentication/disassociation frame
+ * @mac: MAC instance
+ * @reason: reason code from the frame
+ * @locally: %true when the driver itself initiated the teardown
+ */
+void mtk_wlan_mgmt_deauth_rx(struct mtk_wlan_mac *mac, u16 reason,
+			     bool locally)
+{
+	if (!READ_ONCE(mac->connected))
+		return;
+
+	dev_info(mac->dev, "%s by %pM, reason %u\n",
+		 locally ? "disconnected" : "disassociated", mac->bssid,
+		 reason);
+	mtk_wlan_link_down(mac, reason, locally);
+}
+
+/**
+ * mtk_wlan_mgmt_disconnect - locally requested disconnect
+ * @mac: MAC instance
+ * @reason: reason code to send in the deauthentication frame
+ *
+ * Handles both states cfg80211 can ask about: an established association is
+ * deauthenticated and reported; an association attempt in progress is
+ * aborted and the worker releases the frame/bss state without reporting a
+ * result, because cfg80211 already abandoned the request.
+ *
+ * Return: 0 on success, -ENOTCONN when not associated or connecting.
+ */
+int mtk_wlan_mgmt_disconnect(struct mtk_wlan_mac *mac, u16 reason)
+{
+	u8 frame[MTK_WLAN_MAC_HDR_LEN + 2];
+	bool connecting = READ_ONCE(mac->state) == MTK_WLAN_STATE_CONNECTING;
+	bool fw_up;
+	size_t len;
+
+	/*
+	 * Cancel an association attempt before taking &mac->lock: the connect
+	 * worker holds that lock while it waits for a management response, so
+	 * the exchange must be released first.
+	 */
+	if (connecting) {
+		WRITE_ONCE(mac->connect_aborted, true);
+		mtk_wlan_cmd_cancel(mac);
+		spin_lock_bh(&mac->rx_lock);
+		if (mac->mgmt_stype) {
+			mac->mgmt_err = -ECANCELED;
+			complete(&mac->mgmt_done);
+		}
+		spin_unlock_bh(&mac->rx_lock);
+		flush_work(&mac->connect_work);
+	}
+
+	mutex_lock(&mac->lock);
+	if (!READ_ONCE(mac->connected)) {
+		if (READ_ONCE(mac->state) == MTK_WLAN_STATE_CONNECTING)
+			WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+				   MTK_WLAN_STATE_IDLE : MTK_WLAN_STATE_DOWN);
+		mutex_unlock(&mac->lock);
+		return connecting ? 0 : -ENOTCONN;
+	}
+
+	/* aisFsmDisconnect() deauthenticates the current AP, auth.c:932. */
+	len = mtk_wlan_build_deauth(mac, mac->bssid, reason, frame,
+				    sizeof(frame));
+	fw_up = READ_ONCE(mac->fw_up);
+	mutex_unlock(&mac->lock);
+
+	if (len && fw_up)
+		mtk_wlan_mgmt_tx(mac, frame, len);
+
+	mtk_wlan_link_down(mac, reason, true);
+	return 0;
+}
+
+/**
+ * mtk_wlan_mgmt_connect - validate and start an open-system connection
+ * @mac: MAC instance
+ * @sme: cfg80211 connect parameters, only valid during this call
+ *
+ * Only open networks with open-system authentication are supported; the
+ * wiphy advertises no cipher suites at all.  Everything else is rejected
+ * with a real error instead of a fabricated success.  The BSS reference is
+ * kept until the connect worker reports the result.
+ *
+ * Return: 0 when the connection was started, negative errno otherwise.
+ */
+int mtk_wlan_mgmt_connect(struct mtk_wlan_mac *mac,
+			  struct cfg80211_connect_params *sme)
+{
+	struct cfg80211_bss *bss;
+	struct ieee80211_channel *chan;
+	const u8 *bssid = sme->bssid;
+	int ret = 0;
+
+	if (!READ_ONCE(mac->fw_up))
+		return -ENETDOWN;
+	if (READ_ONCE(mac->state) == MTK_WLAN_STATE_CONNECTING ||
+	    READ_ONCE(mac->connected))
+		return -EALREADY;
+	if (sme->auth_type != NL80211_AUTHTYPE_OPEN_SYSTEM &&
+	    sme->auth_type != NL80211_AUTHTYPE_AUTOMATIC)
+		return -EOPNOTSUPP;
+	if (!sme->ssid || sme->ssid_len > IEEE80211_MAX_SSID_LEN)
+		return -EINVAL;
+	if (sme->ie_len > MTK_WLAN_ASSOC_IES_MAX)
+		return -E2BIG;
+
+	/*
+	 * No key offload: reject every form of encryption material, whether
+	 * it arrives in the crypto parameters, as a key, or as a WPA/RSN IE
+	 * inside the association IEs.
+	 */
+	if (sme->privacy || sme->key || sme->key_len || sme->mfp ||
+	    sme->crypto.wpa_versions || sme->crypto.n_ciphers_pairwise ||
+	    sme->crypto.n_akm_suites ||
+	    (sme->ie_len &&
+	     (cfg80211_find_ie(WLAN_EID_RSN, sme->ie, sme->ie_len) ||
+	      cfg80211_find_vendor_ie(WLAN_OUI_MICROSOFT,
+				      WLAN_OUI_TYPE_MICROSOFT_WPA,
+				      sme->ie, sme->ie_len)))) {
+		dev_info(mac->dev,
+			 "connect: encryption is not supported (no key offload)\n");
+		return -EOPNOTSUPP;
+	}
+
+	bss = cfg80211_get_bss(mac->wiphy, sme->channel, bssid, sme->ssid,
+			       sme->ssid_len, IEEE80211_BSS_TYPE_ESS,
+			       IEEE80211_PRIVACY_ANY);
+	if (!bss) {
+		dev_dbg(mac->dev, "connect: requested BSS not in scan results\n");
+		return -ENOENT;
+	}
+
+	chan = bss->channel;
+	if (!bssid)
+		bssid = bss->bssid;
+
+	if (bss->capability & WLAN_CAPABILITY_PRIVACY) {
+		/* Documented boundary: no key offload, so no WPA/RSN. */
+		dev_info(mac->dev, "connect: %pM requires encryption, unsupported\n",
+			 bssid);
+		ret = -EOPNOTSUPP;
+		goto out_put;
+	}
+	if (!chan || chan->band != NL80211_BAND_2GHZ) {
+		ret = -EOPNOTSUPP;
+		goto out_put;
+	}
+
+	/*
+	 * Derive the firmware AP parameters (rate sets, PHY types, protection)
+	 * from the BSS IEs before committing to the attempt.
+	 */
+	ret = mtk_wlan_cmd_prepare_ap(mac, bss);
+	if (ret)
+		goto out_put;
+
+	/* Stop a software scan that is still running. */
+	mtk_wlan_mgmt_abort_scan(mac);
+
+	mutex_lock(&mac->lock);
+	if (READ_ONCE(mac->state) == MTK_WLAN_STATE_CONNECTING ||
+	    READ_ONCE(mac->connected)) {
+		mutex_unlock(&mac->lock);
+		ret = -EALREADY;
+		goto out_put;
+	}
+
+	ether_addr_copy(mac->bssid, bssid);
+	mac->channel = ieee80211_frequency_to_channel(chan->center_freq);
+	memcpy(mac->ssid, sme->ssid, sme->ssid_len);
+	mac->ssid_len = sme->ssid_len;
+	if (sme->ie_len)
+		memcpy(mac->assoc_ie, sme->ie, sme->ie_len);
+	mac->assoc_ie_len = sme->ie_len;
+	mac->req_ie_len = 0;
+	mac->sta_valid = false;
+	mac->aid = 0;
+	mac->connect_bss = bss;	/* ownership moves to the worker/cfg80211 */
+	WRITE_ONCE(mac->connect_aborted, false);
+	WRITE_ONCE(mac->state, MTK_WLAN_STATE_CONNECTING);
+	mutex_unlock(&mac->lock);
+
+	schedule_work(&mac->connect_work);
+	return 0;
+
+out_put:
+	cfg80211_put_bss(mac->wiphy, bss);
+	return ret;
+}
+
+/**
+ * mtk_wlan_mgmt_quiesce - abort scan/connect after the firmware went away
+ * @mac: MAC instance
+ *
+ * Called from the firmware-down and teardown paths.  A running scan reports
+ * itself aborted, a waiting management exchange is released with -ENETDOWN
+ * so the connect worker reports a timeout, and an established connection is
+ * reported as disconnected.  Every cfg80211 notification is emitted by the
+ * worker or by mtk_wlan_link_down(), exactly once.
+ */
+void mtk_wlan_mgmt_quiesce(struct mtk_wlan_mac *mac)
+{
+	struct cfg80211_scan_request *req;
+
+	/* Release a command wait first: the transport is gone. */
+	mtk_wlan_cmd_abort(mac);
+
+	WRITE_ONCE(mac->scan_aborted, true);
+	flush_work(&mac->scan_work);
+
+	/*
+	 * The worker clears scan_req before calling cfg80211_scan_done(), so a
+	 * request still present here was queued but never executed.  Report it
+	 * rather than leaking it.
+	 */
+	req = READ_ONCE(mac->scan_req);
+	if (req)
+		mtk_wlan_scan_complete(mac, req, true);
+
+	spin_lock_bh(&mac->rx_lock);
+	if (mac->mgmt_stype) {
+		mac->mgmt_err = -ENETDOWN;
+		complete(&mac->mgmt_done);
+	}
+	spin_unlock_bh(&mac->rx_lock);
+	flush_work(&mac->connect_work);
+
+	if (READ_ONCE(mac->state) == MTK_WLAN_STATE_SCANNING)
+		WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+			   (READ_ONCE(mac->connected) ?
+			    MTK_WLAN_STATE_CONNECTED : MTK_WLAN_STATE_IDLE) :
+			   MTK_WLAN_STATE_DOWN);
+	if (READ_ONCE(mac->state) == MTK_WLAN_STATE_CONNECTING)
+		WRITE_ONCE(mac->state, READ_ONCE(mac->fw_up) ?
+			   MTK_WLAN_STATE_IDLE : MTK_WLAN_STATE_DOWN);
+
+	if (READ_ONCE(mac->connected))
+		mtk_wlan_link_down(mac, 0, false);
+}
+
+/* Report a beacon/probe response to cfg80211 scan results. */
+static void mtk_wlan_rx_bss(struct mtk_wlan_mac *mac,
+			    struct ieee80211_mgmt *mgmt, size_t len,
+			    u8 channel, u8 rcpi)
+{
+	struct cfg80211_inform_bss data = { };
+	struct cfg80211_bss *bss;
+	struct ieee80211_channel *chan;
+	const u8 *ie;
+	size_t fixed = offsetof(struct ieee80211_mgmt, u.beacon.variable);
+	u32 freq;
+
+	/*
+	 * Trust the DS parameter set like scanUpdateBssDesc()
+	 * (scan.c:1975-1987); fall back to the channel reported by the HIF RX
+	 * header.  Only 2.4 GHz exists in this port.
+	 */
+	if (len >= fixed) {
+		ie = cfg80211_find_ie(WLAN_EID_DS_PARAMS,
+				      mgmt->u.beacon.variable, len - fixed);
+		if (ie && ie[1] == 1 && ie[2] >= 1 && ie[2] <= 14)
+			channel = ie[2];
+	}
+
+	freq = ieee80211_channel_to_frequency(channel, NL80211_BAND_2GHZ);
+	chan = ieee80211_get_channel(mac->wiphy, freq);
+	if (!chan) {
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+
+	data.chan = chan;
+	data.signal = mtk_wlan_rcpi_to_dbm(rcpi) * 100;
+	data.boottime_ns = ktime_get_boottime_ns();
+
+	bss = cfg80211_inform_bss_frame_data(mac->wiphy, &data, mgmt, len,
+					     GFP_KERNEL);
+	if (!bss)
+		return;
+
+	cfg80211_put_bss(mac->wiphy, bss);
+}
+
+/*
+ * Association id from an association response, assoc.c:1183-1200: the AID is
+ * the low 14 bits, with the downstream workaround for APs that raise bits 6
+ * and 7 instead of bits 14 and 15.
+ */
+static u16 mtk_wlan_assoc_id(u16 aid)
+{
+	if ((aid & BIT(6)) && (aid & BIT(7)) && !(aid & GENMASK(15, 8)))
+		return aid & ~GENMASK(7, 6);
+	return aid & GENMASK(13, 0);
+}
+
+/*
+ * Deliver a management response to a waiting exchange.  The waiter checks
+ * the subtype and the transmitter address, so a stale frame can never
+ * complete a newer request.
+ */
+static void mtk_wlan_mgmt_complete(struct mtk_wlan_mac *mac, u16 stype,
+				   const u8 *sa, u16 status, u16 aid,
+				   const u8 *ies, size_t ies_len, u8 rcpi)
+{
+	spin_lock_bh(&mac->rx_lock);
+
+	if (mac->mgmt_stype != stype ||
+	    !ether_addr_equal(mac->mgmt_peer, sa)) {
+		spin_unlock_bh(&mac->rx_lock);
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+
+	mac->mgmt_rsp.status = status;
+	mac->mgmt_rsp.aid = aid;
+	mac->mgmt_rsp.ies_len = min(ies_len, sizeof(mac->mgmt_rsp.ies));
+	if (mac->mgmt_rsp.ies_len)
+		memcpy(mac->mgmt_rsp.ies, ies, mac->mgmt_rsp.ies_len);
+	mac->last_signal = rcpi;
+	mac->have_signal = true;
+	mac->mgmt_stype = 0;
+
+	spin_unlock_bh(&mac->rx_lock);
+	complete(&mac->mgmt_done);
+}
+
+/* Update the RCPI reported for the AP the station is associated with. */
+static void mtk_wlan_update_signal(struct mtk_wlan_mac *mac, const u8 *sa,
+				   u8 rcpi)
+{
+	spin_lock_bh(&mac->rx_lock);
+	if (READ_ONCE(mac->connected) &&
+	    ether_addr_equal(sa, mac->bssid)) {
+		mac->last_signal = rcpi;
+		mac->have_signal = true;
+	}
+	spin_unlock_bh(&mac->rx_lock);
+}
+
+/**
+ * mtk_wlan_rx_mgmt - dispatch one received 802.11 management frame
+ * @mac: MAC instance
+ * @frame: frame including the MAC header
+ * @len: frame length
+ * @channel: channel reported by the HIF RX header
+ * @rcpi: RCPI reported by the HIF RX header
+ */
+void mtk_wlan_rx_mgmt(struct mtk_wlan_mac *mac, const u8 *frame, size_t len,
+		      u8 channel, u8 rcpi)
+{
+	struct ieee80211_mgmt *mgmt = (struct ieee80211_mgmt *)frame;
+	__le16 fc;
+
+	if (len < MTK_WLAN_MAC_HDR_LEN) {
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+
+	fc = mgmt->frame_control;
+
+	/*
+	 * Scan results are only collected while cfg80211 is waiting for them;
+	 * a beacon received while idle is of no use to this driver (it has no
+	 * roaming implementation).
+	 */
+	if (ieee80211_is_beacon(fc) || ieee80211_is_probe_resp(fc)) {
+		if (len < MTK_WLAN_MAC_HDR_LEN + 12) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		mtk_wlan_update_signal(mac, mgmt->sa, rcpi);
+		if (READ_ONCE(mac->scan_req))
+			mtk_wlan_rx_bss(mac, mgmt, len, channel, rcpi);
+		return;
+	}
+
+	if (ieee80211_is_auth(fc)) {
+		if (len < MTK_WLAN_MAC_HDR_LEN + 6) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		/*
+		 * Only the second transaction of an open-system exchange is a
+		 * response: algorithm 0, sequence 2 (aaa_fsm.c:415-430).
+		 */
+		if (le16_to_cpu(mgmt->u.auth.auth_transaction) != 2 ||
+		    le16_to_cpu(mgmt->u.auth.auth_alg) != WLAN_AUTH_OPEN) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		mtk_wlan_mgmt_complete(mac, IEEE80211_STYPE_AUTH, mgmt->sa,
+				       le16_to_cpu(mgmt->u.auth.status_code), 0,
+				       mgmt->u.auth.variable,
+				       len - MTK_WLAN_MAC_HDR_LEN - 6, rcpi);
+		return;
+	}
+
+	if (ieee80211_is_assoc_resp(fc)) {
+		if (len < MTK_WLAN_MAC_HDR_LEN + 6) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		mtk_wlan_mgmt_complete(mac, IEEE80211_STYPE_ASSOC_RESP,
+				       mgmt->sa,
+				       le16_to_cpu(mgmt->u.assoc_resp.status_code),
+				       mtk_wlan_assoc_id(
+					       le16_to_cpu(mgmt->u.assoc_resp.aid)),
+				       mgmt->u.assoc_resp.variable,
+				       len - MTK_WLAN_MAC_HDR_LEN - 6, rcpi);
+		return;
+	}
+
+	if (ieee80211_is_deauth(fc) || ieee80211_is_disassoc(fc)) {
+		u16 reason;
+
+		if (len < MTK_WLAN_MAC_HDR_LEN + 2) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		reason = le16_to_cpu(mgmt->u.deauth.reason_code);
+		if (!ether_addr_equal(mgmt->sa, mac->bssid)) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		mtk_wlan_mgmt_deauth_rx(mac, reason, false);
+		return;
+	}
+
+	/*
+	 * Association requests, probes, action frames and anything else are
+	 * not part of the STA-only interface built here.
+	 */
+	atomic_inc(&mac->rx_dropped);
+}
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_netdev.c b/drivers/misc/mediatek/connectivity/wlan/wlan_netdev.c
new file mode 100644
index 000000000..71192442b
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_netdev.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 Ethernet netdev.
+ *
+ * The WLAN function presents itself as a plain Ethernet interface.  RX: the
+ * firmware normally decapsulates data frames to 802.3 and the buffer is fed
+ * straight to eth_type_trans() (os/linux/gl_kal.c:1509-1612
+ * kalRxIndicatePkts); 802.11 format buffers are converted in wlan_txrx.c.
+ * TX: the driver builds the 802.11 data frame itself (wlan_txrx.c), because
+ * this port has no firmware STA record and therefore cannot ask the
+ * firmware to convert an 802.3 frame.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   os/linux/gl_init.c        (netdev allocation, registration, netdev ops)
+ *   os/linux/gl_kal.c         (kalRxIndicatePkts)
+ *   os/linux/gl_hook_api.c    (interface state glue)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/if_arp.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+
+#include "wlan_mac.h"
+
+/**
+ * mtk_wlan_netdev_rx - hand a received Ethernet frame to the stack
+ * @mac: MAC instance
+ * @skb: Ethernet frame starting at the destination address
+ *
+ * Frames are delivered with netif_rx() because the HIF drain runs in a
+ * workqueue (process context), not in the interrupt handler.
+ */
+void mtk_wlan_netdev_rx(struct mtk_wlan_mac *mac, struct sk_buff *skb)
+{
+	struct net_device *ndev = mac->ndev;
+	unsigned int len = skb->len;
+
+	if (!ndev || !READ_ONCE(mac->registered) || !netif_running(ndev)) {
+		atomic_inc(&mac->rx_dropped);
+		dev_kfree_skb(skb);
+		return;
+	}
+
+	skb->dev = ndev;
+	skb->protocol = eth_type_trans(skb, ndev);
+	ndev->stats.rx_packets++;
+	ndev->stats.rx_bytes += len;
+
+	if (netif_rx(skb) == NET_RX_DROP) {
+		ndev->stats.rx_dropped++;
+		atomic_inc(&mac->rx_dropped);
+	}
+}
+
+/*
+ * Transmit.  The frame cannot be written to the HIF from this context
+ * because the PDMA path takes a mutex, so it is queued and drained by
+ * &mtk_wlan_mac.tx_work (the downstream driver has a dedicated TX thread for
+ * the same reason, nic_tx.c:916-960 nicTxMsduInfoList).
+ */
+static netdev_tx_t mtk_wlan_netdev_start_xmit(struct sk_buff *skb,
+					      struct net_device *ndev)
+{
+	struct mtk_wlan_mac *mac = netdev_priv(ndev);
+
+	if (!READ_ONCE(mac->fw_up) || !READ_ONCE(mac->connected)) {
+		atomic_inc(&mac->tx_dropped);
+		ndev->stats.tx_dropped++;
+		dev_kfree_skb_any(skb);
+		return NETDEV_TX_OK;
+	}
+
+	skb_queue_tail(&mac->txq, skb);
+	schedule_work(&mac->tx_work);
+
+	if (skb_queue_len(&mac->txq) >= MTK_WLAN_TXQ_DEPTH)
+		netif_tx_stop_all_queues(ndev);
+
+	return NETDEV_TX_OK;
+}
+
+static int mtk_wlan_netdev_open(struct net_device *ndev)
+{
+	struct mtk_wlan_mac *mac = netdev_priv(ndev);
+
+	if (!READ_ONCE(mac->fw_up))
+		return -ENETDOWN;
+
+	if (READ_ONCE(mac->connected)) {
+		netif_carrier_on(ndev);
+		netif_tx_start_all_queues(ndev);
+	} else {
+		netif_carrier_off(ndev);
+		netif_tx_stop_all_queues(ndev);
+	}
+
+	return 0;
+}
+
+static int mtk_wlan_netdev_stop(struct net_device *ndev)
+{
+	struct mtk_wlan_mac *mac = netdev_priv(ndev);
+	struct sk_buff *skb;
+
+	netif_tx_stop_all_queues(ndev);
+	netif_carrier_off(ndev);
+
+	/* Frames still queued belong to this interface: drop them. */
+	while ((skb = skb_dequeue(&mac->txq)))
+		dev_kfree_skb(skb);
+
+	return 0;
+}
+
+static void mtk_wlan_netdev_set_multicast(struct net_device *ndev)
+{
+	/*
+	 * The firmware has no host-visible multicast filter register in this
+	 * HIF (the MCR set in mtreg.h:81-143 has none) and the packet filter
+	 * OID that downstream uses here (wlanoidSetCurrentPacketFilter() from
+	 * wlanSetMulticastList(), gl_init.c:1698-1770) needs the firmware
+	 * command queue this port does not implement.  The receiver keeps its
+	 * firmware default, so there is nothing to program; the list is
+	 * accepted for the interface to come up.
+	 */
+}
+
+static const struct net_device_ops mtk_wlan_netdev_ops = {
+	.ndo_open		= mtk_wlan_netdev_open,
+	.ndo_stop		= mtk_wlan_netdev_stop,
+	.ndo_start_xmit		= mtk_wlan_netdev_start_xmit,
+	.ndo_set_rx_mode	= mtk_wlan_netdev_set_multicast,
+};
+
+/**
+ * mtk_wlan_netdev_create - allocate the Ethernet netdev and its wireless_dev
+ * @mac: MAC instance
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int mtk_wlan_netdev_create(struct mtk_wlan_mac *mac)
+{
+	struct wireless_dev *wdev;
+	struct net_device *ndev;
+
+	ndev = alloc_netdev(sizeof(*wdev), "wlan%d", NET_NAME_ENUM, ether_setup);
+	if (!ndev)
+		return -ENOMEM;
+
+	ndev->netdev_ops = &mtk_wlan_netdev_ops;
+	SET_NETDEV_DEV(ndev, mac->dev);
+
+	eth_hw_addr_set(ndev, mac->mac_addr);
+	ndev->addr_len = ETH_ALEN;
+	if (!is_valid_ether_addr(ndev->dev_addr)) {
+		eth_hw_addr_random(ndev);
+		ether_addr_copy(mac->mac_addr, ndev->dev_addr);
+		dev_info(mac->dev,
+			 "no MAC address in the device tree, using random %pM\n",
+			 ndev->dev_addr);
+	}
+
+	netif_carrier_off(ndev);
+	netif_tx_stop_all_queues(ndev);
+
+	wdev = netdev_priv(ndev);
+	wdev->wiphy = mac->wiphy;
+	wdev->iftype = NL80211_IFTYPE_STATION;
+	wdev->netdev = ndev;
+	ndev->ieee80211_ptr = wdev;
+
+	mac->ndev = ndev;
+	mac->wdev = wdev;
+
+	return 0;
+}
+
+/**
+ * mtk_wlan_netdev_register - publish the netdev while the firmware runs
+ * @mac: MAC instance
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int mtk_wlan_netdev_register(struct mtk_wlan_mac *mac)
+{
+	int ret;
+
+	if (READ_ONCE(mac->registered))
+		return 0;
+
+	/* cfg80211 picks the wireless_dev up from NETDEV_REGISTER. */
+	ret = register_netdevice(mac->ndev);
+	if (ret) {
+		dev_err(mac->dev, "cannot register %s: %d\n",
+			mac->ndev->name, ret);
+		return ret;
+	}
+
+	WRITE_ONCE(mac->registered, true);
+	dev_info(mac->dev, "%s registered, address %pM\n", mac->ndev->name,
+		 mac->ndev->dev_addr);
+
+	return 0;
+}
+
+/*
+ * Drop the netdev.  unregister_netdevice() closes it first, i.e. ndo_stop()
+ * runs while the cfg80211 wdev is still registered.
+ */
+void mtk_wlan_netdev_unregister(struct mtk_wlan_mac *mac)
+{
+	if (!READ_ONCE(mac->registered))
+		return;
+
+	unregister_netdevice(mac->ndev);
+	WRITE_ONCE(mac->registered, false);
+}
+
+void mtk_wlan_netdev_destroy(struct mtk_wlan_mac *mac)
+{
+	if (!mac->ndev)
+		return;
+
+	free_netdev(mac->ndev);
+	mac->ndev = NULL;
+	mac->wdev = NULL;
+}
+
+/**
+ * mtk_wlan_netdev_link_changed - reflect the connection state on the netdev
+ * @mac: MAC instance
+ * @up: %true when the STA is associated
+ */
+void mtk_wlan_netdev_link_changed(struct mtk_wlan_mac *mac, bool up)
+{
+	struct net_device *ndev = mac->ndev;
+
+	if (!ndev || !READ_ONCE(mac->registered))
+		return;
+
+	if (up) {
+		netif_carrier_on(ndev);
+		if (netif_running(ndev))
+			netif_tx_wake_all_queues(ndev);
+	} else {
+		netif_tx_stop_all_queues(ndev);
+		netif_carrier_off(ndev);
+	}
+}
+
+/* Wake the TX queue after the firmware returned buffers. */
+void mtk_wlan_netdev_wake_tx(struct mtk_wlan_mac *mac)
+{
+	struct net_device *ndev = mac->ndev;
+
+	if (!ndev || !READ_ONCE(mac->registered) ||
+	    !READ_ONCE(mac->connected))
+		return;
+
+	if (!netif_running(ndev))
+		return;
+
+	netif_tx_wake_all_queues(ndev);
+}
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_txrx.c b/drivers/misc/mediatek/connectivity/wlan/wlan_txrx.c
new file mode 100644
index 000000000..1354c8d27
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_txrx.c
@@ -0,0 +1,501 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 HIF TX framing, TX queueing and data conversion.
+ *
+ * Data frames travel in 802.3 format and the firmware builds their 802.11
+ * header (nic_tx.c:1400-1480, 2000-2018).  Management frames are built by
+ * wlan_mgmt.c and travel as complete 802.11 frames on TC4.  Received 802.11
+ * format data frames (HIF RX header format bit) are converted back to 802.3
+ * before they reach the stack.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   nic/nic_tx.c              (nicTxMsduQueue header fill, TC resource
+ *                              accounting, TX port selection)
+ *   include/nic/hif_tx.h      (HIF_TX_HEADER_T and its flag bit fields)
+ *   include/nic/hif_rx.h      (HIF_RX_HEADER_T)
+ *   nic/nic_rx.c              (port read length with the appended DW)
+ *   nic/que_mgt.c             (TC per access category, no-STA fallback)
+ *   os/linux/gl_kal.c         (kalRxIndicatePkts: 802.3 frames to the stack)
+ *   include/nic/mac.h         (margins, RCPI)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/etherdevice.h>
+#include <linux/ieee80211.h>
+#include <linux/jiffies.h>
+#include <linux/skbuff.h>
+#include <linux/unaligned.h>
+
+#include "wlan_mac.h"
+
+/*
+ * Firmware TX buffer credits.  WTSR0 holds one released-buffer count per
+ * byte for TC0..TC3, WTSR1 does the same for TC4..TC5; the driver adds the
+ * released counts to its own per-TC counters (nicTxReleaseResource(),
+ * nic_tx.c:698-738, and HAL_READ_TX_RELEASED_COUNT(), hal.h:511-521).
+ */
+void mtk_wlan_tc_release(struct mtk_wlan_mac *mac, unsigned int tc,
+			 unsigned int count)
+{
+	spin_lock_bh(&mac->txq_lock);
+	if (mac->tc_credits[tc] + count > mac->tc_max[tc])
+		mac->tc_credits[tc] = mac->tc_max[tc];
+	else
+		mac->tc_credits[tc] += count;
+	spin_unlock_bh(&mac->txq_lock);
+}
+
+/**
+ * mtk_wlan_tc_acquire - reserve one firmware TX buffer of @tc
+ * @mac: MAC instance
+ * @tc: traffic class, %MTK_WLAN_TC0 .. %MTK_WLAN_TC5
+ *
+ * Return: %true when a buffer was reserved.
+ */
+bool mtk_wlan_tc_acquire(struct mtk_wlan_mac *mac, unsigned int tc)
+{
+	bool ok = false;
+
+	spin_lock_bh(&mac->txq_lock);
+	if (mac->tc_credits[tc]) {
+		mac->tc_credits[tc]--;
+		ok = true;
+	}
+	spin_unlock_bh(&mac->txq_lock);
+
+	return ok;
+}
+
+/*
+ * Reserve one buffer of @tc only when at least @min buffers are free.  The
+ * management path uses a two-buffer watermark for TC4, exactly like
+ * nicTxAcquireResource() does for security/management frames
+ * (nic_tx.c:559-571); one buffer is then consumed.
+ */
+static bool mtk_wlan_tc_acquire_min(struct mtk_wlan_mac *mac, unsigned int tc,
+				    u8 min)
+{
+	bool ok = false;
+
+	spin_lock_bh(&mac->txq_lock);
+	if (mac->tc_credits[tc] >= min) {
+		mac->tc_credits[tc]--;
+		ok = true;
+	}
+	spin_unlock_bh(&mac->txq_lock);
+
+	return ok;
+}
+
+/**
+ * mtk_wlan_mac_tx_done - account TX buffers released by the firmware
+ * @hif: host interface
+ * @wtsr0: MCR_WTSR0 contents
+ * @wtsr1: MCR_WTSR1 contents
+ *
+ * Called from the HIF interrupt bottom half while the firmware is up.  Each
+ * byte of the two status registers is the number of TX buffers the firmware
+ * released for the corresponding traffic class (nic_tx.c:712-716).
+ */
+void mtk_wlan_mac_tx_done(struct mtk_wlan_hif *hif, u32 wtsr0, u32 wtsr1)
+{
+	struct mtk_wlan_mac *mac = hif->mac;
+	unsigned int tc;
+
+	if (!mac || !READ_ONCE(mac->fw_up))
+		return;
+
+	for (tc = 0; tc < 4; tc++)
+		mtk_wlan_tc_release(mac, tc, (wtsr0 >> (tc * 8)) & 0xff);
+	mtk_wlan_tc_release(mac, MTK_WLAN_TC4, wtsr1 & 0xff);
+	mtk_wlan_tc_release(mac, MTK_WLAN_TC5, (wtsr1 >> 8) & 0xff);
+
+	mtk_wlan_netdev_wake_tx(mac);
+	if (READ_ONCE(mac->connected))
+		schedule_work(&mac->tx_work);
+}
+
+/* EtherType is two octets (802.11-2016 9.2.2); the offset is measured from
+ * the HIF TX header like the downstream ETHER_TYPE_LEN use at nic_tx.c:1414.
+ */
+#define MTK_WLAN_ETH_TYPE_LEN		2
+
+/*
+ * Everything the HIF TX header needs for one frame.  Management frames carry
+ * a complete 802.11 header (nic_tx.c:1660-1700); data frames carry an 802.3
+ * frame and the firmware builds the 802.11 header itself (nic_tx.c:1400-1460,
+ * fgIs802_11 = FALSE, ucMacHeaderLength = ETH_HLEN from nicTxMsduInfoList
+ * nic_tx.c:2000-2018).
+ */
+struct mtk_wlan_tx_params {
+	unsigned int tc;
+	unsigned int pkt_type;
+	u8 wlan_hdr_len;
+	u8 ether_off;
+	u8 sta_idx;
+	u8 user_priority;
+	bool is_80211;
+	bool ack;
+	bool basic_rate;
+	size_t total;
+};
+
+/*
+ * Fill the 16-byte HIF TX header in @mac->tx_buf.  The caller holds
+ * &mac->tx_lock and has already placed the frame right behind the header.
+ *
+ * The flag set follows nic_tx.c:1400-1480: @is_80211 selects
+ * HIF_TX_HDR_FLAG_802_11_FORMAT, @ack and @basic_rate are HIF_TX_HDR_NEED_ACK
+ * and HIF_TX_HDR_BASIC_RATE (management sets both, auth.c:442 and
+ * assoc.c:934; data sets neither, nic_tx.c:1461-1474 and 1940).  @ether_off
+ * is the EtherType offset in 16-bit words counted from the HIF header.
+ */
+static void mtk_wlan_tx_hdr_fill(struct mtk_wlan_mac *mac,
+				 const struct mtk_wlan_tx_params *p)
+{
+	struct mtk_wlan_hif_tx_header *hdr =
+		(struct mtk_wlan_hif_tx_header *)mac->tx_buf;
+
+	memset(hdr, 0, MTK_WLAN_HIF_TX_HDR_LEN);
+	hdr->tx_byte_count_user_priority =
+		cpu_to_le16(((u16)p->total & HIF_TX_HDR_TX_BYTE_COUNT_MASK) |
+			    ((u16)p->user_priority <<
+			     HIF_TX_HDR_USER_PRIORITY_OFFSET));
+	hdr->ether_type_offset = p->ether_off & HIF_TX_HDR_ETHER_TYPE_OFFSET_MASK;
+	hdr->resource_pkttype_csflags =
+		FIELD_PREP(HIF_TX_HDR_RESOURCE_MASK, p->tc) |
+		FIELD_PREP(HIF_TX_HDR_PACKET_TYPE_MASK, p->pkt_type);
+	hdr->wlan_header_length = p->wlan_hdr_len &
+				  HIF_TX_HDR_WLAN_HEADER_LEN_MASK;
+	hdr->pktfmtid_flags =
+		FIELD_PREP(HIF_TX_HDR_NETWORK_TYPE_MASK,
+			   MTK_WLAN_NETWORK_TYPE_AIS) |
+		(p->is_80211 ? HIF_TX_HDR_FLAG_802_11_FORMAT : 0);
+	hdr->sta_rec_idx = p->sta_idx;
+	hdr->forwarding_type_sessionid = 0;	/* PS_FORWARDING_TYPE_NON_PS */
+	hdr->ack_bip_basicrate =
+		(p->ack ? HIF_TX_HDR_NEED_ACK : 0) |
+		(p->basic_rate ? HIF_TX_HDR_BASIC_RATE : 0);
+}
+
+/*
+ * Push the prepared buffer through the data port.  Called with &mac->tx_lock
+ * held and one TC buffer already reserved.
+ */
+static int mtk_wlan_tx_flush(struct mtk_wlan_mac *mac, unsigned int tc,
+			     size_t total, size_t frame_len)
+{
+	struct mtk_wlan_hif *hif = mac->hif;
+	u16 port;
+	int ret;
+
+	/* TC4 is the only class that uses HIF TX port 1 (nic_tx.c:872-880). */
+	port = (tc == MTK_WLAN_TC4) ? MCR_WTDR1 : MCR_WTDR0;
+
+	ret = mtk_wlan_hif_port_write(hif, port, total, mac->tx_buf, total);
+	if (ret) {
+		/* Give the buffer back, the firmware never saw it. */
+		mtk_wlan_tc_release(mac, tc, 1);
+		atomic_inc(&mac->tx_dropped);
+		if (mac->registered)
+			mac->ndev->stats.tx_errors++;
+		return ret;
+	}
+
+	if (mac->registered) {
+		mac->ndev->stats.tx_packets++;
+		mac->ndev->stats.tx_bytes += frame_len;
+	}
+	return 0;
+}
+
+/**
+ * mtk_wlan_mgmt_tx - transmit one 802.11 management frame
+ * @mac: MAC instance
+ * @frame: complete 802.11 management frame including the MAC header
+ * @len: frame length
+ *
+ * Management frames travel in 802.11 format on TC4 (auth.c:430-442), with
+ * the WLAN header length and the EtherType offset filled in exactly like
+ * nicTxMsduQueue() does for TX_PACKET_MGMT (nic_tx.c:1409-1420).
+ *
+ * Return: 0, -EBUSY when no TX buffer is free, or another negative errno.
+ */
+int mtk_wlan_mgmt_tx(struct mtk_wlan_mac *mac, const u8 *frame, size_t len)
+{
+	struct mtk_wlan_tx_params p = {
+		.tc = MTK_WLAN_TC4,
+		.pkt_type = HIF_TX_PKT_TYPE_MANAGEMENT,
+		.wlan_hdr_len = MTK_WLAN_MAC_HDR_LEN,
+		.ether_off = (MTK_WLAN_HIF_TX_HDR_LEN +
+			      MTK_WLAN_MAC_HDR_LEN) >> 1,
+		.sta_idx = mac->sta_valid ? mac->sta_index :
+			   MTK_WLAN_STA_REC_NOT_FOUND,
+		.is_80211 = true,
+		.ack = true,
+		.basic_rate = true,
+	};
+	size_t total;
+	unsigned int tries;
+	int ret;
+
+	if (!READ_ONCE(mac->fw_up))
+		return -ENETDOWN;
+	if (len > MTK_WLAN_MGMT_FRAME_MAX)
+		return -EMSGSIZE;
+
+	total = ALIGN(MTK_WLAN_HIF_TX_HDR_LEN + len, 4);
+
+	/*
+	 * TC4 only has four buffers in this configuration; the firmware
+	 * returns them with the TX-done interrupt, so poll briefly like
+	 * nicTxPollingResource() (nic_tx.c:633-697) instead of failing the
+	 * management exchange on a transient shortage.  Two buffers must be
+	 * free before one is taken, the same watermark nicTxAcquireResource()
+	 * applies to management/802.1x frames (nic_tx.c:559-571).
+	 */
+	for (tries = 0; tries < 100; tries++) {
+		if (mtk_wlan_tc_acquire_min(mac, MTK_WLAN_TC4, 2))
+			break;
+		msleep(2);
+	}
+	if (tries == 100)
+		return -EBUSY;
+
+	mutex_lock(&mac->tx_lock);
+	memset(mac->tx_buf, 0, total);
+	p.total = total;
+	mtk_wlan_tx_hdr_fill(mac, &p);
+	memcpy(mac->tx_buf + MTK_WLAN_HIF_TX_HDR_LEN, frame, len);
+	ret = mtk_wlan_tx_flush(mac, MTK_WLAN_TC4, total, len);
+	mutex_unlock(&mac->tx_lock);
+
+	return ret;
+}
+
+/**
+ * mtk_wlan_data_tx - hand one Ethernet frame to the firmware data path
+ * @mac: MAC instance
+ * @skb: Ethernet frame
+ *
+ * Data frames are written in 802.3 format; the firmware builds the 802.11
+ * header, which is downstream's default data path (nic_tx.c:2000-2018 sets
+ * fgIs802_11 = FALSE and ucMacHeaderLength = ETH_HLEN; the EtherType offset
+ * comes from the 802.3 branch at nic_tx.c:1404-1416).  The peer record index
+ * from CMD_UPDATE_STA_RECORD is carried in the HIF header, so the firmware
+ * can find the station instead of using STA_REC_INDEX_NOT_FOUND.
+ *
+ * Ownership: the frame is consumed on every return value except -EBUSY; on
+ * -EBUSY no firmware TX buffer was available and the caller keeps the skb
+ * (the data path has 36 TC1 buffers, nic_tx.h:298-303, and the firmware
+ * returns them from the TX-done interrupt).
+ *
+ * Return: 0 on success, -EBUSY when no TX buffer was free, another negative
+ * errno when the frame was dropped.
+ */
+int mtk_wlan_data_tx(struct mtk_wlan_mac *mac, struct sk_buff *skb)
+{
+	struct mtk_wlan_tx_params p = {
+		.tc = MTK_WLAN_TC1,
+		.pkt_type = HIF_TX_PKT_TYPE_DATA,
+		.wlan_hdr_len = MTK_WLAN_ETH_HDR_LEN,
+		.ether_off = (MTK_WLAN_ETH_HDR_LEN - MTK_WLAN_ETH_TYPE_LEN +
+			      MTK_WLAN_HIF_TX_HDR_LEN) >> 1,
+		.sta_idx = mac->sta_valid ? mac->sta_index :
+			   MTK_WLAN_STA_REC_NOT_FOUND,
+		.is_80211 = false,
+		.ack = false,
+		.basic_rate = false,
+	};
+	size_t total;
+	int ret;
+
+	if (skb->len < MTK_WLAN_ETH_HDR_LEN ||
+	    skb->len > MTK_WLAN_TX_FRAME_MAX) {
+		atomic_inc(&mac->tx_dropped);
+		if (mac->registered)
+			mac->ndev->stats.tx_dropped++;
+		consume_skb(skb);
+		return -EMSGSIZE;
+	}
+
+	if (!mtk_wlan_tc_acquire(mac, MTK_WLAN_TC1))
+		return -EBUSY;
+
+	total = ALIGN(MTK_WLAN_HIF_TX_HDR_LEN + skb->len, 4);
+	mutex_lock(&mac->tx_lock);
+	memset(mac->tx_buf, 0, total);
+	memcpy(mac->tx_buf + MTK_WLAN_HIF_TX_HDR_LEN, skb->data, skb->len);
+	p.total = total;
+	mtk_wlan_tx_hdr_fill(mac, &p);
+	ret = mtk_wlan_tx_flush(mac, MTK_WLAN_TC1, total, skb->len);
+	mutex_unlock(&mac->tx_lock);
+
+	consume_skb(skb);
+	return ret;
+}
+
+/**
+ * mtk_wlan_tx_work - drain the netdev TX queue into the HIF
+ * @work: &struct mtk_wlan_mac.tx_work
+ */
+void mtk_wlan_tx_work(struct work_struct *work)
+{
+	struct mtk_wlan_mac *mac = container_of(work, struct mtk_wlan_mac,
+						tx_work);
+	struct sk_buff *skb;
+
+	while (READ_ONCE(mac->fw_up) && READ_ONCE(mac->connected)) {
+		skb = skb_dequeue(&mac->txq);
+		if (!skb)
+			break;
+
+		/*
+		 * The HIF write reads skb->data linearly.  Linearising here
+		 * (process context) rather than in ndo_start_xmit keeps the
+		 * atomic transmit path cheap.
+		 */
+		if (skb_is_nonlinear(skb) && skb_linearize(skb)) {
+			atomic_inc(&mac->tx_dropped);
+			if (mac->registered)
+				mac->ndev->stats.tx_dropped++;
+			dev_kfree_skb(skb);
+			continue;
+		}
+
+		if (mtk_wlan_data_tx(mac, skb) == -EBUSY) {
+			/* No TC1 buffer left: keep the frame for the next round. */
+			skb_queue_head(&mac->txq, skb);
+			if (mac->registered)
+				netif_tx_stop_all_queues(mac->ndev);
+			return;
+		}
+	}
+
+	if (mac->registered && READ_ONCE(mac->fw_up) && mac->connected)
+		netif_tx_wake_all_queues(mac->ndev);
+}
+
+/**
+ * mtk_wlan_rx_80211_to_8023 - convert a received 802.11 data frame
+ * @mac: MAC instance
+ * @frame: 802.11 frame including the MAC header
+ * @len: frame length
+ *
+ * The firmware normally decapsulates data frames and hands up 802.3
+ * (kalRxIndicatePkts() feeds the skb straight to eth_type_trans(),
+ * gl_kal.c:1583-1612), but the HIF RX header can announce 802.11 format.
+ * Then the driver strips the header itself: FromDS frames reverse the ToDS
+ * address mapping and carry the EtherType in an RFC 1042 LLC/SNAP header.
+ *
+ * Return: new skb holding the Ethernet frame, %NULL when it cannot be used.
+ */
+struct sk_buff *mtk_wlan_rx_80211_to_8023(struct mtk_wlan_mac *mac,
+					  const u8 *frame, size_t len)
+{
+	const struct ieee80211_hdr *hdr = (const struct ieee80211_hdr *)frame;
+	const u8 *da, *sa, *snap;
+	struct sk_buff *skb;
+	size_t hdr_len, payload_len;
+	__le16 fc;
+
+	if (len < MTK_WLAN_MAC_HDR_LEN)
+		return NULL;
+
+	fc = hdr->frame_control;
+	if (!ieee80211_is_data(fc))
+		return NULL;
+
+	/* No key offload, so encrypted frames are unusable here. */
+	if (ieee80211_has_protected(fc)) {
+		atomic_inc(&mac->rx_dropped);
+		return NULL;
+	}
+
+	if (!ieee80211_has_fromds(fc)) {
+		/*
+		 * An infrastructure STA receives only FromDS data.  ToDS and
+		 * IBSS frames belong to paths this driver does not implement.
+		 */
+		atomic_inc(&mac->rx_dropped);
+		return NULL;
+	}
+
+	hdr_len = MTK_WLAN_MAC_HDR_LEN;
+	if (ieee80211_is_data_qos(fc)) {
+		__le16 qos;
+
+		if (len < hdr_len + MTK_WLAN_QOS_CTRL_LEN)
+			return NULL;
+		qos = get_unaligned_le16(frame + hdr_len);
+		/* An A-MSDU payload is not an LLC/SNAP frame; drop it. */
+		if (le16_to_cpu(qos) & IEEE80211_QOS_CTL_A_MSDU_PRESENT) {
+			atomic_inc(&mac->rx_dropped);
+			return NULL;
+		}
+		hdr_len += MTK_WLAN_QOS_CTRL_LEN;
+	}
+	if (ieee80211_has_a4(fc))
+		hdr_len += 2 * ETH_ALEN;
+	if (len < hdr_len + MTK_WLAN_LLC_LEN)
+		return NULL;
+
+	snap = frame + hdr_len;
+	if (snap[0] != 0xaa || snap[1] != 0xaa || snap[2] != 0x03)
+		return NULL;
+
+	da = (const u8 *)ieee80211_get_DA((struct ieee80211_hdr *)frame);
+	sa = (const u8 *)ieee80211_get_SA((struct ieee80211_hdr *)frame);
+	payload_len = len - hdr_len - MTK_WLAN_LLC_LEN;
+
+	skb = dev_alloc_skb(MTK_WLAN_ETH_HDR_LEN + payload_len + NET_IP_ALIGN);
+	if (!skb) {
+		atomic_inc(&mac->rx_dropped);
+		return NULL;
+	}
+	skb_reserve(skb, NET_IP_ALIGN);
+
+	skb_put(skb, MTK_WLAN_ETH_HDR_LEN);
+	ether_addr_copy(skb->data, da);
+	ether_addr_copy(skb->data + ETH_ALEN, sa);
+	memcpy(skb->data + 2 * ETH_ALEN, snap + 6, 2);
+	skb_put_data(skb, frame + hdr_len + MTK_WLAN_LLC_LEN, payload_len);
+
+	return skb;
+}
+
+/**
+ * mtk_wlan_rx_data - deliver one firmware data frame to the netdev
+ * @mac: MAC instance
+ * @frame: payload after the HIF RX header
+ * @len: payload length
+ * @is_80211: HIF RX header announced 802.11 format
+ */
+void mtk_wlan_rx_data(struct mtk_wlan_mac *mac, const u8 *frame, size_t len,
+		      bool is_80211)
+{
+	struct sk_buff *skb;
+
+	if (is_80211) {
+		skb = mtk_wlan_rx_80211_to_8023(mac, frame, len);
+		if (!skb)
+			return;
+	} else {
+		/* Already an Ethernet frame (kalProcessRxPacket()). */
+		if (len < MTK_WLAN_ETH_HDR_LEN) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		skb = dev_alloc_skb(len + NET_IP_ALIGN);
+		if (!skb) {
+			atomic_inc(&mac->rx_dropped);
+			return;
+		}
+		skb_reserve(skb, NET_IP_ALIGN);
+		skb_put_data(skb, frame, len);
+	}
+
+	mtk_wlan_netdev_rx(mac, skb);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/Kconfig b/drivers/misc/mediatek/connectivity/wmt/Kconfig
new file mode 100644
index 000000000..da00ee48b
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/Kconfig
@@ -0,0 +1,16 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# WMT/CONSYS core: STP transport, WMT control protocol and the MT6735
+# connectivity-subsystem power/clock/GPIO glue.
+
+config MTK_WCN_WMT
+	tristate "MediaTek WMT/CONSYS core"
+	depends on MTK_BTIF
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	help
+	  Core driver for the MediaTek connectivity subsystem (CONSYS).  It
+	  owns the STP serial transport, the WMT control protocol, firmware
+	  patch download and the power/clock/reset sequence used by the
+	  WLAN, Bluetooth, GPS and FM functions.
+
+	  The module is called mtk_wcn_wmt.
diff --git a/drivers/misc/mediatek/connectivity/wmt/Makefile b/drivers/misc/mediatek/connectivity/wmt/Makefile
new file mode 100644
index 000000000..8e3d979ed
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/Makefile
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# The object list is maintained by the WMT/CONSYS core driver.
+#
+ccflags-y += -I$(srctree)/drivers/misc/mediatek/connectivity/include
+ccflags-y += -I$(srctree)/drivers/misc/mediatek/btif/include
+
