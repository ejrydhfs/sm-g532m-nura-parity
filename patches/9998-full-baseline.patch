+static ssize_t aed_ee_coredump_read(struct file *filp, char __user *buf,
+				    size_t count, loff_t *pos)
+{
+	ssize_t ret;
+
+	mutex_lock(&aed_dev.msg_lock);
+	if (!aed_dev.eerec || !aed_dev.eerec->ee_phy) {
+		ret = 0;
