+static int __init aed_init(void)
+{
+	int ret;
+
+	/* the uapi numbers must match the ioctl encodings of aed.h:151-161 */
+	BUILD_BUG_ON(AEEIOCTL_GET_THREAD_REG !=
+		     _IOW('p', 0x07, struct aee_thread_reg));
+	BUILD_BUG_ON(AEEIOCTL_GET_THREAD_REG64 !=
+		     _IOW('p', 0x07, struct aee_thread_reg64));
+	BUILD_BUG_ON(AEEIOCTL_GET_PROCESS_BT !=
+		     _IOW('p', 0x04, struct aee_ioctl));
+	BUILD_BUG_ON(AEEIOCTL_CHECK_SUID_DUMPABLE != _IOR('p', 0x08, int));
+	BUILD_BUG_ON(AEEIOCTL_SET_AEE_MODE != _IOR('p', 0x06, int));
+	BUILD_BUG_ON(sizeof(struct AE_Msg) != 24);
+	BUILD_BUG_ON(sizeof(struct aee_ioctl) != 32);
+	BUILD_BUG_ON(sizeof(struct aee_thread_reg) != 76);
+	BUILD_BUG_ON(sizeof(struct aee_thread_reg64) != 296);
+	BUILD_BUG_ON(sizeof(struct aee_bt_frame) != 256);
+
+	ret = aed_proc_init();
+	if (ret)
+		return ret;
+
+	mutex_init(&aed_dev.msg_lock);
+	spin_lock_init(&ee_queue.lock);
+	INIT_LIST_HEAD(&ee_queue.list);
+	init_waitqueue_head(&aed_dev.eewait);
+	init_waitqueue_head(&aed_dev.kewait);
+	INIT_WORK(&ee_work, ee_worker);
+
+	aed_ee_dev.fops = &aed_ee_fops;
+	ret = misc_register(&aed_ee_dev);
+	if (ret) {
+		pr_err("AED: failed to register aed0(ee) device!\n");
+		aed_proc_done();
+		return ret;
+	}
+
+	aed_ke_dev.fops = &aed_ke_fops;
+	ret = misc_register(&aed_ke_dev);
+	if (ret) {
+		pr_err("AED: failed to register aed1(ke) device!\n");
+		misc_deregister(&aed_ee_dev);
+		aed_proc_done();
+		return ret;
+	}
+
+	pr_info("AED: /dev/aed0 (ee) and /dev/aed1 (ke) registered\n");
+	return 0;
+}
+
+static void __exit aed_exit(void)
+{
+	cancel_work_sync(&ee_work);
+	ee_destroy_log();
+
+	misc_deregister(&aed_ke_dev);
+	misc_deregister(&aed_ee_dev);
+
+	mutex_lock(&aed_dev.msg_lock);
+	msg_destroy(&aed_dev.kerec.msg);
+	mutex_unlock(&aed_dev.msg_lock);
+
+	aed_proc_done();
+}
+module_init(aed_init);
+module_exit(aed_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("MediaTek AED (AEE exception dump) driver");
+MODULE_AUTHOR("MediaTek Inc.");
diff --git a/drivers/misc/mediatek/aee/aed-process.c b/drivers/misc/mediatek/aee/aed-process.c
new file mode 100644
index 000000000..d327026ae
--- /dev/null
+++ b/drivers/misc/mediatek/aee/aed-process.c
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Per-process backtrace for the AEEIOCTL_GET_PROCESS_BT dump ioctl.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/aee/aed/aed-process.c:35-204 (aed_get_process_bt,
+ * aed_get_bt, aed_save_trace and the cross-CPU barrier).  Original
+ * copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ *
+ * The result is the aee_process_bt frame array of
+ * include/mt-plat/aee.h:65-84: for every PC a 64-bit address plus a %pS
+ * symbol.  The downstream ARM32 code also fills frame->lr; its arm64 build
+ * leaves lr/lr_symbol zero (aed-process.c:88-91), which is what this port
+ * does as well.
+ *
+ * DEVIATION: the upstream walker (walk_stackframe() with a task stackframe)
+ * is replaced by stack_trace_save_tsk(), the architected arm64 unwinder, and
+ * the cross-CPU "stop the other CPUs" barrier of aed-process.c:139-166 is not
+ * reproduced: it only made the dump more atomic on a 32-bit kernel and needs
+ * the downstream arch/stacktrace.h internals.
+ */
+#include <linux/kernel.h>
+#include <linux/ptrace.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/stacktrace.h>
+#include <linux/string.h>
+
+#include "aed.h"
+
+int aed_get_process_bt(struct aee_process_bt *bt)
+{
+	struct aee_bt_frame *frames;
+	struct task_struct *task;
+	unsigned long *pcs;
+	bool allowed;
+	unsigned int nr, i;
+	int ret = 0;
+
+	if (!bt || !bt->entries || (int)bt->pid <= 0)
+		return -EINVAL;
+
+	frames = bt->entries;
+	memset(frames, 0, sizeof(*frames) * AEE_NR_FRAME);
+	bt->nr_entries = 0;
+
+	task = aed_find_task(bt->pid);
+	if (!task)
+		return -EINVAL;
+
+	pcs = kcalloc(AEE_NR_FRAME, sizeof(*pcs), GFP_KERNEL);
+	if (!pcs) {
+		ret = -ENOMEM;
+		goto out_put_task;
+	}
+
+	/* aed-process.c:181-190 */
+	ret = mutex_lock_killable(&task->signal->cred_guard_mutex);
+	if (ret)
+		goto out_free;
+
+	allowed = ptrace_may_access(task, PTRACE_MODE_ATTACH_REALCREDS);
+	mutex_unlock(&task->signal->cred_guard_mutex);
+	if (!allowed) {
+		ret = -EPERM;
+		goto out_free;
+	}
+
+	nr = stack_trace_save_tsk(task, pcs, AEE_NR_FRAME, 0);
+	for (i = 0; i < nr; i++) {
+		frames[i].pc = pcs[i];
+		snprintf(frames[i].pc_symbol, AEE_SZ_SYMBOL_S, "%pS",
+			 (void *)pcs[i]);
+	}
+	bt->nr_entries = nr;
+
+out_free:
+	kfree(pcs);
+out_put_task:
+	put_task_struct(task);
+	return ret;
+}
diff --git a/drivers/misc/mediatek/aee/aed.h b/drivers/misc/mediatek/aee/aed.h
new file mode 100644
index 000000000..f2316bd25
--- /dev/null
+++ b/drivers/misc/mediatek/aee/aed.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek AED (Android Exception Device) driver private definitions.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/aee/aed/aed-main.c:155-200
+ *     (struct aed_eerec, struct aed_kerec, struct aed_dev)
+ *   drivers/misc/mediatek/include/mt-plat/aee.h:80-84 (struct aee_process_bt)
+ *
+ * Original copyright: Copyright (C) 2010/2015 MediaTek Inc. GPL-2.0.
+ */
+#ifndef __MTK_AED_H
+#define __MTK_AED_H
+
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+#include <uapi/linux/aee.h>
+
+/*
+ * aed-main.c:155-167.  exp_linenum/fatal1/fatal2 of the downstream record are
+ * only used by the legacy aed_md_exception1()/aed_md32_exception1() entry
+ * points, which this tree does not have; the remaining fields are the ones the
+ * AE_Msg response generators and the /proc coredump reader use.
+ */
+struct aed_eerec {		/* external exception record */
+	struct list_head list;
+	char assert_type[32];
+	char exp_filename[512];
+
+	int *ee_log;
+	int ee_log_size;
+	int *ee_phy;
+	int ee_phy_size;
+	char *msg;
+	int db_opt;
+};
+
+/* include/mt-plat/aee.h:80-84 */
+struct aee_process_bt {
+	__u32 pid;
+	__u32 nr_entries;
+	struct aee_bt_frame *entries;
+};
+
+int aed_get_process_bt(struct aee_process_bt *bt);
+
+/* look up a process by pid in the caller's pid namespace, with a reference */
+static inline struct task_struct *aed_find_task(u32 vpid)
+{
+	struct task_struct *task;
+
+	rcu_read_lock();
+	task = find_task_by_vpid((pid_t)vpid);
+	if (task)
+		get_task_struct(task);
+	rcu_read_unlock();
+
+	return task;
+}
+
+#endif /* __MTK_AED_H */
