diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6735-vcodec.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6735-vcodec.yaml
new file mode 100644
index 000000000..becc5dcf1
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6735-vcodec.yaml
@@ -0,0 +1,199 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6735-vcodec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6735 video codec engines
+
+maintainers:
+  - MediaTek SoC maintainers <linux-mediatek@lists.infradead.org>
+
+description: |
+  The MT6735 contains two independent video codec engines, a decoder (VDEC)
+  and an encoder (VENC).  Neither engine runs firmware and neither is driven
+  by a kernel-side bitstream parser: the vendor codec libraries program the
+  register windows from userspace through the mmap() interface of the
+  "Vcodec" character device.  The kernel owns the clock trees, the power
+  domains, the engine interrupts, the hardware ownership lock, the interrupt
+  wait and the register-window mappings.
+
+  Both nodes are consumed by the shared MT6735 video codec hardware service;
+  the encoder and the decoder are separate devices that register themselves
+  with that service.
+
+properties:
+  compatible:
+    enum:
+      - mediatek,mt6735-vdec
+      - mediatek,mt6735-venc
+
+  reg:
+    minItems: 1
+    maxItems: 2
+
+  reg-names:
+    minItems: 1
+    maxItems: 2
+    items:
+      enum: [vdec, gcon]
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 3
+    maxItems: 6
+    description: |
+      Clock tree of the engine, in the order the driver enables it during
+      power-on.  The driver takes the first three clocks in device tree
+      order and disables them in reverse order, so the list must follow the
+      enable sequence of the hardware: the SMI common clock of the mmsys
+      first, then the engine clock and its SMI LARB clock.
+
+      The decoder may additionally describe the topckgen VDEC clock mux and
+      its two DVFS parent clocks (syspll1_d2 and syspll1_d4) so that the
+      driver can scale the decoder between 273 MHz and 136.5 MHz.  Those
+      three are optional; without them the decoder keeps the clock parent
+      selected at boot.
+
+  clock-names:
+    minItems: 3
+    maxItems: 6
+    items:
+      enum: [smi_common, smi_larb1, smi_larb3, vdec, venc, vdec_sel,
+             vdec_sel_high, vdec_sel_low]
+    description:
+      Names of the clocks above.  The decoder driver looks its clocks up by
+      name, so its first three entries must be "smi_common", "vdec" and
+      "smi_larb1"; "vdec_sel", "vdec_sel_high" and "vdec_sel_low" name the
+      optional DVFS trio.  The encoder driver takes all clocks in device
+      tree order and does not look them up by name.
+
+  power-domains:
+    minItems: 2
+    maxItems: 2
+    description:
+      The display subsystem power domain (DIS) followed by the power domain
+      of the engine itself (VDE for the decoder, VEN for the encoder).  The
+      order is the order in which they are powered on.
+
+  resets:
+    maxItems: 1
+    description:
+      Optional block reset of the engine.
+
+  reset-names:
+    const: vdec
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - power-domains
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6735-vdec
+    then:
+      properties:
+        reg:
+          items:
+            - description: VDEC decoder register window
+            - description: VDEC general control (gcon) register window
+        reg-names:
+          items:
+            - const: vdec
+            - const: gcon
+        clocks:
+          minItems: 3
+          maxItems: 6
+          items:
+            - description: mmsys SMI common clock
+            - description: vdecsys VDEC clock
+            - description: vdecsys SMI LARB1 clock
+            - description: topckgen VDEC clock mux (optional, DVFS)
+            - description: topckgen syspll1_d2 parent (optional, DVFS)
+            - description: topckgen syspll1_d4 parent (optional, DVFS)
+        clock-names:
+          minItems: 3
+          maxItems: 6
+          items:
+            - const: smi_common
+            - const: vdec
+            - const: smi_larb1
+            - const: vdec_sel
+            - const: vdec_sel_high
+            - const: vdec_sel_low
+      required:
+        - reg-names
+        - clock-names
+    else:
+      properties:
+        reg:
+          items:
+            - description: VENC encoder register window
+        reg-names:
+          items:
+            - const: venc
+        clocks:
+          items:
+            - description: mmsys SMI common clock
+            - description: vencsys VENC clock
+            - description: vencsys SMI LARB3 clock
+        clock-names:
+          items:
+            - const: smi_common
+            - const: venc
+            - const: smi_larb3
+        resets: false
+        reset-names: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6735-mmsys.h>
+    #include <dt-bindings/clock/mediatek,mt6735-topckgen.h>
+    #include <dt-bindings/clock/mediatek,mt6735-vdecsys.h>
+    #include <dt-bindings/clock/mediatek,mt6735-vencsys.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/power/mt6735-power.h>
+    #include <dt-bindings/reset/mediatek,mt6735-vdecsys.h>
+
+    vdec: vcodec@16020000 {
+        compatible = "mediatek,mt6735-vdec";
+        reg = <0x16020000 0x10000>, <0x16000000 0x1000>;
+        reg-names = "vdec", "gcon";
+        interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_LOW>;
+        clocks = <&mmsys CLK_MM_SMI_COMMON>,
+                 <&vdecsys CLK_VDEC_VDEC>,
+                 <&vdecsys CLK_VDEC_SMI_LARB1>,
+                 <&topckgen CLK_TOP_VDEC_SEL>,
+                 <&topckgen CLK_TOP_SYSPLL1_D2>,
+                 <&topckgen CLK_TOP_SYSPLL1_D4>;
+        clock-names = "smi_common", "vdec", "smi_larb1",
+                      "vdec_sel", "vdec_sel_high", "vdec_sel_low";
+        power-domains = <&spm MT6735_POWER_DOMAIN_DIS>,
+                        <&spm MT6735_POWER_DOMAIN_VDE>;
+        resets = <&vdecsys MT6735_VDEC_RST0_VDEC>;
+        reset-names = "vdec";
+    };
+
+    venc: vcodec@17002000 {
+        compatible = "mediatek,mt6735-venc";
+        reg = <0x17002000 0x1000>;
+        reg-names = "venc";
+        interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_LOW>;
+        clocks = <&mmsys CLK_MM_SMI_COMMON>,
+                 <&vencsys CLK_VENC_VENC>,
+                 <&vencsys CLK_VENC_SMI_LARB3>;
+        clock-names = "smi_common", "venc", "smi_larb3";
+        power-domains = <&spm MT6735_POWER_DOMAIN_DIS>,
+                        <&spm MT6735_POWER_DOMAIN_VEN>;
+    };
