+/* vendor:626-644 SetHplTrimOffset/SetHprTrimOffset range check */
+static unsigned int mt6331_dc_trim_value(struct mt6331_priv *priv,
+					 unsigned int offset)
+{
+	if (offset > MT6331_DC_OFFSET_TRIM_MAX ||
+	    offset < MT6331_DC_OFFSET_TRIM_MIN) {
+		dev_err(priv->dev,
+			"HP DC offset %u out of range, using %u\n",
+			offset, MT6331_DC_OFFSET_TRIM_DEFAULT);
+		return MT6331_DC_OFFSET_TRIM_DEFAULT;
+	}
+
+	return offset;
+}
