+	S2MU005_CABLE_JIG_USB_OFF,
+	S2MU005_CABLE_JIG_USB_ON,
+	S2MU005_CABLE_JIG_UART,
+	S2MU005_CABLE_JIG_UART_VBUS,
+	S2MU005_CABLE_OTG,
+	S2MU005_CABLE_DESKDOCK,
+	S2MU005_CABLE_DESKDOCK_VBUS,
+};
