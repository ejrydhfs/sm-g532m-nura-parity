 }
 
+/*
+ * Maximum run time reached: stop the motor and hold it off until all
+ * effects have finished.  The SM-G532M ROM driver (Samsung sec_vib,
+ * drivers/motor/sec_vib.c) clamps every timed_output enable request to its
+ * DT "sec_vib,max_timeout" (10000 ms in the shipped ROM DTB).  Force
+ * feedback does not pass the effect duration down to the driver (the
+ * ff-memless core only reports the combined magnitude), so the same limit
+ * is applied to the continuous regulator-on time instead.
+ */
+static enum hrtimer_restart regulator_haptic_stop_timer(struct hrtimer *timer)
+{
+	struct regulator_haptic *haptic = container_of(timer,
+					struct regulator_haptic, stop_timer);
+
+	haptic->capped = true;
+	schedule_work(&haptic->work);
+
+	return HRTIMER_NORESTART;
+}
+
 static void regulator_haptic_work(struct work_struct *work)
 {
 	struct regulator_haptic *haptic = container_of(work,
 					struct regulator_haptic, work);
+	unsigned int magnitude;
+	bool was_active;
 
 	guard(mutex)(&haptic->mutex);
 
-	if (!haptic->suspended)
-		regulator_haptic_set_voltage(haptic, haptic->magnitude);
+	magnitude = haptic->magnitude;
+	if (!magnitude) {
+		/* Quiet again: the run time limit is re-armed on next start. */
+		hrtimer_cancel(&haptic->stop_timer);
+		haptic->capped = false;
+	} else if (haptic->capped) {
+		magnitude = 0;
+	}
+
+	if (haptic->suspended)
+		return;
+
+	was_active = haptic->active;
+	regulator_haptic_set_voltage(haptic, magnitude);
+
+	if (magnitude && !was_active && haptic->max_timeout)
+		hrtimer_start(&haptic->stop_timer,
+			      ms_to_ktime(haptic->max_timeout),
+			      HRTIMER_MODE_REL);
 }
 
 static int regulator_haptic_play_effect(struct input_dev *input, void *data,
@@ -108,7 +151,9 @@ static void regulator_haptic_close(struct input_dev *input)
 {
 	struct regulator_haptic *haptic = input_get_drvdata(input);
 
+	hrtimer_cancel(&haptic->stop_timer);
 	cancel_work_sync(&haptic->work);
+	haptic->capped = false;
 	regulator_haptic_set_voltage(haptic, 0);
 }
 
@@ -136,6 +181,13 @@ regulator_haptic_parse_dt(struct device *dev, struct regulator_haptic *haptic)
 		return error;
 	}
 
+	/*
+	 * Optional cap on the continuous run time in milliseconds, matching
+	 * the Samsung sec_vib driver of the SM-G532M ROM ("sec_vib,max_timeout",
+	 * 10000 ms in the shipped ROM DTB).  Leave unset for no limit.
+	 */
+	of_property_read_u32(node, "max-timeout-ms", &haptic->max_timeout);
+
 	return 0;
 }
 
@@ -154,6 +206,8 @@ static int regulator_haptic_probe(struct platform_device *pdev)
 	haptic->dev = &pdev->dev;
 	mutex_init(&haptic->mutex);
 	INIT_WORK(&haptic->work, regulator_haptic_work);
+	hrtimer_setup(&haptic->stop_timer, regulator_haptic_stop_timer,
+		      CLOCK_MONOTONIC, HRTIMER_MODE_REL);
 
 	if (pdata) {
 		haptic->max_volt = pdata->max_volt;
@@ -200,6 +254,15 @@ static int regulator_haptic_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static void regulator_haptic_remove(struct platform_device *pdev)
+{
+	struct regulator_haptic *haptic = platform_get_drvdata(pdev);
+
+	hrtimer_cancel(&haptic->stop_timer);
+	cancel_work_sync(&haptic->work);
+	regulator_haptic_set_voltage(haptic, 0);
+}
+
 static int regulator_haptic_suspend(struct device *dev)
 {
 	struct platform_device *pdev = to_platform_device(dev);
