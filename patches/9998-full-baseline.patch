diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-fm-i2s.c b/sound/soc/mediatek/mt6735/mt6735-dai-fm-i2s.c
new file mode 100644
index 000000000..85b00ba25
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-fm-i2s.c
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC AFE FM I2S back-end DAI.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/:
+ *   mt_soc_pcm_fm_i2s.c     - mtk_pcm_fm_i2s_open()/close()/prepare(),
+ *                             mtk_fm_i2s_hardware, mfm_i2s_Volume
+ *   mt_soc_afe_control.c    - Set2ndI2SIn(), Set2ndI2SInEnable(),
+ *                             SetI2SASRCConfig(), SetHwDigitalGainMode(),
+ *                             SetHwDigitalGainEnable(), SetHwDigitalGain(),
+ *                             SetI2SDacOut(), SetMemoryPathEnable()
+ *   mt_soc_afe_connection.c - mConnectionReg[]/mConnectionbits[] FM routes
+ *
+ * The FM audio path has no AP memory interface: the MT6627 tuner feeds the AFE
+ * through the 2nd I2S input from CONNSYS (I2S_IN_2, digital block 17), through
+ * hardware digital gain 1, to the PMIC codec DAC (I2S_OUT_DAC, digital block
+ * 12).  The stream therefore never advances its ALSA pointer, exactly like the
+ * I2S0 and voice back ends.
+ *
+ * AFE_I2S_CON (0x0018) is shared with the I2S0 four wire path: this DAI and
+ * mt6735-dai-i2s.c refuse to run at the same time (-EBUSY) so neither can
+ * overwrite the other's register programming.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/* mfm_i2s_Volume, mt_soc_pcm_fm_i2s.c:73 */
+#define MT6735_AFE_FM_I2S_GAIN		0x10000
+/* SamplePerStep handed to SetHwDigitalGainMode(), mt_soc_pcm_fm_i2s.c:288-289 */
+#define MT6735_AFE_FM_I2S_GAIN_STEP	0x40
+
+/*
+ * soc_fm_supported_sample_rates[] is { 32000, 44100, 48000 }
+ * (mt_soc_pcm_common.h:210-212).  Downstream uses 44.1/48 kHz for the stream
+ * and resamples the fixed 32 kHz 2nd I2S input with SetI2SASRCConfig()
+ * (mt_soc_pcm_fm_i2s.c:316-321).  This port keeps the whole path - 2nd I2S
+ * input, ASRC bypass and PMIC DAC out - at the 32 kHz input rate, which is the
+ * only rate the FM I2S link carries, so no resampling is required.
+ */
+static const unsigned int mt6735_afe_fm_i2s_rates[] = {
+	MT6735_AFE_FM_I2S_RATE,
+};
+
+static const struct snd_pcm_hw_constraint_list mt6735_afe_fm_i2s_rate_constraint = {
+	.count = ARRAY_SIZE(mt6735_afe_fm_i2s_rates),
+	.list = mt6735_afe_fm_i2s_rates,
+	.mask = 0,
+};
+
+static int mt6735_afe_fm_i2s_startup(struct snd_pcm_substream *substream,
+				     struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int ret;
+
+	/*
+	 * Two shared interfaces have to be free before the FM path may run:
+	 *
+	 * - AFE_I2S_CON (0x0018) belongs to the I2S0 four wire path while
+	 *   that PCM is open (Enable4pin_I2S0_I2S3(),
+	 *   mt_soc_afe_control.c:3749-3761 writes the same register).
+	 *   mt6735-dai-i2s.c has the symmetric check.
+	 * - The PMIC codec DAC (AFE_I2S_CON1, I2S_OUT_DAC block 12) is shared
+	 *   with the modem voice paths, which program it at their own 8/16 kHz
+	 *   rates (mt6735-dai-voice.c, SetI2SDacOut() :1637-1655).  Starting
+	 *   the 32 kHz FM stream underneath a call would reprogram it.
+	 */
+	mutex_lock(&priv->i2s_con_lock);
+	if (priv->i2s0_active || priv->voice_afe_users) {
+		mutex_unlock(&priv->i2s_con_lock);
+		return -EBUSY;
+	}
+	priv->fm_i2s_active = true;
+	mutex_unlock(&priv->i2s_con_lock);
+
+	/* AudDrv_Clk_On()/AudDrv_I2S_Clk_On(), mt_soc_pcm_fm_i2s.c:196-197 */
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		goto err_release;
+	}
+
+	/* runtime->hw = mtk_fm_i2s_hardware (:134-150), mt_soc_pcm_fm_i2s.c:200 */
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	/* snd_pcm_hw_constraint_list() for the FM rates, :204-205 */
+	ret = snd_pcm_hw_constraint_list(runtime, 0, SNDRV_PCM_HW_PARAM_RATE,
+					 &mt6735_afe_fm_i2s_rate_constraint);
+	if (ret < 0)
+		goto err_put;
+
+	ret = snd_pcm_hw_constraint_minmax(runtime,
+					   SNDRV_PCM_HW_PARAM_CHANNELS,
+					   MT6735_AFE_FM_I2S_CHANNELS,
+					   MT6735_AFE_FM_I2S_CHANNELS);
+	if (ret < 0)
+		goto err_put;
+
+	ret = snd_pcm_hw_constraint_mask64(runtime, SNDRV_PCM_HW_PARAM_FORMAT,
+					   MT6735_AFE_FM_I2S_FORMATS);
+	if (ret < 0)
+		goto err_put;
+
+	/* snd_pcm_hw_constraint_integer(), :206 */
+	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		goto err_put;
+
+	return 0;
+
+err_put:
+	pm_runtime_put_noidle(afe->dev);
+err_release:
+	mutex_lock(&priv->i2s_con_lock);
+	priv->fm_i2s_active = false;
+	mutex_unlock(&priv->i2s_con_lock);
+
+	return ret;
+}
+
+/*
+ * Set2ndI2SIn()/Set2ndI2SInEnable(false) + mtk_pcm_fm_i2s_close(),
+ * mt_soc_pcm_fm_i2s.c:227-264 and mt_soc_afe_control.c:2214-2249.
+ * Idempotent so that a failed prepare or a double shutdown is harmless.
+ */
+static void mt6735_afe_fm_i2s_teardown(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	/* Set2ndI2SInEnable(false) */
+	regmap_update_bits(afe->regmap, AFE_I2S_CON, AFE_I2S_CON_EN, 0);
+	priv->fm_i2s_on = false;
+
+	/* SetMemoryPathEnable(I2S_IN_2, false) */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+			   AFE_DAC_CON0_I2S_IN_2_EN, 0);
+
+	/*
+	 * SetMemoryPathEnable(I2S_OUT_DAC, false) followed by
+	 * SetI2SDacEnable(false), mt_soc_pcm_fm_i2s.c:242-244.  The
+	 * I2S_OUT_DAC block is also enabled by the modem voice paths, so it is
+	 * only released once no call is running, and AFE_I2S_CON1 is only
+	 * returned when this DAI programmed it (fm_i2s_dac_owner) and no
+	 * multimedia stream holds the PMIC codec DAC.
+	 */
+	if (!priv->voice_afe_users) {
+		regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+				   AFE_DAC_CON0_I2S_OUT_DAC_EN, 0);
+		if (priv->fm_i2s_dac_owner &&
+		    !mt6735_afe_playback_enabled(afe)) {
+			mt6735_afe_dac_disable(afe);
+			priv->fm_i2s_dac_owner = false;
+		}
+	}
+
+	/*
+	 * Disconnect the four FM routes, mt_soc_pcm_fm_i2s.c:246-254.  The
+	 * hardware gain block itself is left programmed, as downstream does;
+	 * the next prepare() resets its current gain value.
+	 */
+	regmap_update_bits(afe->regmap, AFE_GAIN1_CONN2,
+			   AFE_CONN_FM_I2S_I00_TO_O13 |
+			   AFE_CONN_FM_I2S_I01_TO_O14, 0);
+	regmap_update_bits(afe->regmap, AFE_GAIN1_CONN,
+			   AFE_CONN_FM_I2S_I10_TO_O03 |
+			   AFE_CONN_FM_I2S_I11_TO_O04, 0);
+
+	priv->fm_i2s_prepared = false;
+
+	/* EnableAfe(false), mt_soc_pcm_fm_i2s.c:257 */
+	mt6735_afe_update_power(afe);
+
+	/*
+	 * EnableAfe(false) also returns the PMIC audio bus pins to GPIO mode
+	 * once no audio path is running (AudDrv_Gpio.c:215-236).
+	 */
+	if (!mt6735_afe_playback_enabled(afe) && !priv->adc_path_on &&
+	    !priv->voice_afe_users)
+		mt6735_afe_select_pmic_pins(afe, false);
+}
+
+static void mt6735_afe_fm_i2s_shutdown(struct snd_pcm_substream *substream,
+				       struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	mt6735_afe_fm_i2s_teardown(afe);
+
+	mutex_lock(&priv->i2s_con_lock);
+	priv->fm_i2s_active = false;
+	mutex_unlock(&priv->i2s_con_lock);
+
+	/* AudDrv_I2S_Clk_Off()/AudDrv_Clk_Off(), mt_soc_pcm_fm_i2s.c:259-260 */
+	pm_runtime_put(afe->dev);
+}
+
+static int mt6735_afe_fm_i2s_hw_params(struct snd_pcm_substream *substream,
+				       struct snd_pcm_hw_params *params,
+				       struct snd_soc_dai *dai)
+{
+	/*
+	 * The 2nd I2S input is a fixed link: Set2ndI2SIn() is always called
+	 * with 32000 Hz, 16 bit stereo (mt_soc_pcm_fm_i2s.c:305-313) and the
+	 * FM codec DAI configures the same format.  Anything else would
+	 * silently play at the wrong rate, so reject it.
+	 */
+	if (params_rate(params) != MT6735_AFE_FM_I2S_RATE)
+		return -EINVAL;
+	if (params_channels(params) != MT6735_AFE_FM_I2S_CHANNELS)
+		return -EINVAL;
+	if (params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+
+	return 0;
+}
+
+/*
+ * mtk_pcm_fm_i2s_prepare(), mt_soc_pcm_fm_i2s.c:267-329.  The final enable
+ * (Set2ndI2SInEnable(true) and EnableAfe(true)) is left to the trigger so the
+ * data path only starts when the PCM actually runs; mPrepareDone becomes
+ * fm_i2s_prepared and short circuits a repeated prepare.
+ */
+static int mt6735_afe_fm_i2s_prepare(struct snd_pcm_substream *substream,
+				     struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int con;
+	int fs, ret;
+
+	if (priv->fm_i2s_prepared)
+		return 0;
+
+	fs = mt6735_afe_rate_to_fs(MT6735_AFE_FM_I2S_RATE);
+	if (fs < 0)
+		return fs;
+
+	/* EnableAfe(true) muxes the PMIC audio bus, mt_soc_afe_control.c:993 */
+	mt6735_afe_select_pmic_pins(afe, true);
+
+	/* Interconnection: I00->O13, I01->O14, I10->O03, I11->O04 (:278-285) */
+	regmap_update_bits(afe->regmap, AFE_GAIN1_CONN2,
+			   AFE_CONN_FM_I2S_I00_TO_O13 |
+			   AFE_CONN_FM_I2S_I01_TO_O14,
+			   AFE_CONN_FM_I2S_I00_TO_O13 |
+			   AFE_CONN_FM_I2S_I01_TO_O14);
+	regmap_update_bits(afe->regmap, AFE_GAIN1_CONN,
+			   AFE_CONN_FM_I2S_I10_TO_O03 |
+			   AFE_CONN_FM_I2S_I11_TO_O04,
+			   AFE_CONN_FM_I2S_I10_TO_O03 |
+			   AFE_CONN_FM_I2S_I11_TO_O04);
+
+	/*
+	 * SetHwDigitalGainMode(GAIN1, runtime->rate, 0x40), :288-289:
+	 * the 0xfff0 mode field is (sample per step << 8) | (fs << 4).
+	 */
+	regmap_update_bits(afe->regmap, AFE_GAIN1_CON0,
+			   AFE_GAIN1_CON0_MODE_MASK,
+			   (MT6735_AFE_FM_I2S_GAIN_STEP << 8) | (fs << 4));
+
+	/* SetHwDigitalGainEnable(GAIN1, true): ramp up from a zero gain, :290 */
+	regmap_write(afe->regmap, AFE_GAIN1_CUR, 0);
+	regmap_update_bits(afe->regmap, AFE_GAIN1_CON0, AFE_GAIN1_CON0_EN,
+			   AFE_GAIN1_CON0_EN);
+
+	/* SetHwDigitalGain(mfm_i2s_Volume, GAIN1), :291 */
+	regmap_write(afe->regmap, AFE_GAIN1_CON1, MT6735_AFE_FM_I2S_GAIN);
+
+	/*
+	 * Start the I2S DAC out: SetI2SDacOut(rate, false, 16 bit) followed by
+	 * SetMemoryPathEnable(I2S_OUT_DAC) and SetI2SDacEnable(true), :294-299.
+	 * When another stream already owns the PMIC codec DAC, keep its rate
+	 * and only take the memory path, as downstream does (:298-299).
+	 */
+	if (!priv->dac_path_on) {
+		ret = mt6735_afe_dac_prepare(afe, MT6735_AFE_FM_I2S_RATE, false);
+		if (ret)
+			return ret;
+		priv->fm_i2s_dac_owner = true;
+	}
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+			   AFE_DAC_CON0_I2S_OUT_DAC_EN,
+			   AFE_DAC_CON0_I2S_OUT_DAC_EN);
+
+	/* SetMemoryPathEnable(I2S_IN_2, true), :302 */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+			   AFE_DAC_CON0_I2S_IN_2_EN, AFE_DAC_CON0_I2S_IN_2_EN);
+
+	/*
+	 * Set2ndI2SIn(), mt_soc_afe_control.c:2224-2231:
+	 *	bit  1 = 0	16 bit samples
+	 *	bit  2 = 1	I2S slave (clock comes from CONNSYS)
+	 *	bit  3 = 1	I2S framing
+	 *	bit  5 = 0	LRCK not inverted
+	 *	bit 28 = 0	I2S input pad select: from CONNSYS, not the IO mux
+	 *	bit 31 = 1	phase shift fix
+	 * Bit 0 (enable) is set by the trigger, and the register carries no
+	 * low jitter or LR swap bit for this path.  Downstream masks the write
+	 * with 0xfffffffe, i.e. every bit except the enable is overwritten.
+	 */
+	con = AFE_I2S_CON_PHASE_SHIFT_FIX |
+	      (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT) |
+	      AFE_I2S_CON_SLAVE |
+	      (AFE_I2S_WLEN_16BIT << AFE_I2S_CON_WLEN_SHIFT);
+	regmap_write(afe->regmap, AFE_I2S_CON, con);
+
+	/*
+	 * SetI2SASRCConfig(false, 0): bypass the ASRC.  Downstream only uses
+	 * it to convert the fixed 32 kHz input to a 44.1/48 kHz stream
+	 * (mt_soc_pcm_fm_i2s.c:316-321); everything runs at 32 kHz here, so
+	 * the ASRC block stays out of the path (mt_soc_afe_control.c:2274).
+	 */
+	regmap_update_bits(afe->regmap, AFE_CONN4, AFE_CONN4_ASRC_BYPASS,
+			   AFE_CONN4_ASRC_BYPASS);
+
+	priv->fm_i2s_prepared = true;
+
+	return 0;
+}
+
+static int mt6735_afe_fm_i2s_trigger(struct snd_pcm_substream *substream,
+				     int cmd, struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	int ret;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/* Set2ndI2SInEnable(true), mt_soc_afe_control.c:2241-2248 */
+		ret = regmap_update_bits(afe->regmap, AFE_I2S_CON,
+					 AFE_I2S_CON_EN, AFE_I2S_CON_EN);
+		if (ret)
+			return ret;
+
+		/* EnableAfe(true), mt_soc_pcm_fm_i2s.c:326 */
+		priv->fm_i2s_on = true;
+		mt6735_afe_update_power(afe);
+
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		ret = regmap_update_bits(afe->regmap, AFE_I2S_CON,
+					 AFE_I2S_CON_EN, 0);
+		if (ret)
+			return ret;
+
+		/* EnableAfe(false): the FM path no longer needs the AFE clock */
+		priv->fm_i2s_on = false;
+		mt6735_afe_update_power(afe);
+
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_afe_fm_i2s_ops = {
+	.startup = mt6735_afe_fm_i2s_startup,
+	.shutdown = mt6735_afe_fm_i2s_shutdown,
+	.hw_params = mt6735_afe_fm_i2s_hw_params,
+	.prepare = mt6735_afe_fm_i2s_prepare,
+	.trigger = mt6735_afe_fm_i2s_trigger,
+};
+
+const struct snd_soc_dai_driver mt6735_afe_fm_i2s_dai = {
+	.name = MT6735_AFE_FM_I2S_DAI_NAME,
+	.id = MT6735_AFE_DAI_FM_I2S,
+	.ops = &mt6735_afe_fm_i2s_ops,
+	.playback = {
+		.stream_name = "FM_I2S Playback",
+		.channels_min = MT6735_AFE_FM_I2S_CHANNELS,
+		.channels_max = MT6735_AFE_FM_I2S_CHANNELS,
+		.rates = SNDRV_PCM_RATE_32000,
+		.rate_min = MT6735_AFE_FM_I2S_RATE,
+		.rate_max = MT6735_AFE_FM_I2S_RATE,
+		.formats = MT6735_AFE_FM_I2S_FORMATS,
+	},
+};
diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-hpimp.c b/sound/soc/mediatek/mt6735/mt6735-dai-hpimp.c
new file mode 100644
index 000000000..25b300411
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-hpimp.c
@@ -0,0 +1,269 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC HP impedance front-end DAI.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/mt_soc_pcm_hp_impedance.c and the DL1
+ * pieces it calls in mt_soc_afe_control.c.
+ *
+ * The HP impedance measurement plays a constant DC level out of the AFE and
+ * reads the resulting voltage on PMIC AUXADC channel 9.  The DC level comes
+ * from the AFE component control "HP Impedance DC Value"
+ * (mt6735-afe-pcm.c), which fills the AFE internal SRAM; this DAI points the
+ * DL1 memory interface at that SRAM and enables the normal AFE downlink
+ * (DL1 -> I05/I06 -> O03/O04 -> I2S DAC -> PMIC codec) so the value is
+ * actually clocked out.
+ *
+ * Why the internal SRAM and not the ALSA ring buffer: the downstream build
+ * defines AUDIO_MEMORY_SRAM (AudDrv_Def.h:45), so AudDrv_Allocate_DL1_Buffer()
+ * hands the DL1 memory interface AFE_INTERNAL_SRAM_PHY_BASE (0x11221000,
+ * AFE_INTERNAL_SRAM_SIZE 0x8000) and the ioremapped SRAM pointer
+ * (mt_soc_afe_control.c:2563-2584, AudDrv_Afe.h:375-377,
+ * AudDrv_Afe.c:118-129).  The same buffer address is what
+ * mtk_pcm_dl1_params() installs into runtime->dma_addr in the SRAM state
+ * (mt_soc_pcm_dl1.c:265-273).  The vendor HP impedance PCM instead rebinds
+ * its ALSA buffer, but the DC value it is given is written to the SRAM by
+ * Audio_HP_ImpeDance_Set() (mt_soc_pcm_hp_impedance.c:361-362, 377-378), so
+ * the SRAM is the buffer this port must play.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/* AFE_INTERNAL_SRAM_PHY_BASE (AudDrv_Afe.h:375) inside the AFE mapping. */
+#define MT6735_AFE_HPIMP_SRAM_PHYS	(MT6735_AFE_PHYS_BASE + \
+					 MT6735_AFE_INTERNAL_SRAM_OFFSET)
+
+static int mt6735_afe_hpimp_startup(struct snd_pcm_substream *substream,
+				    struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	int ret;
+
+	/*
+	 * DL1 is shared with the normal MultiMedia1 playback.  Refuse to take
+	 * it over while another stream owns it.  afe->memif[].substream is set
+	 * by the generic DL1 DAI at startup, so a merely opened DL1 stream is
+	 * rejected as well as a running one.
+	 */
+	mutex_lock(&priv->hp_imp_lock);
+	if (priv->hp_imp_open || afe->memif[MT6735_AFE_MEMIF_DL1].substream) {
+		mutex_unlock(&priv->hp_imp_lock);
+		return -EBUSY;
+	}
+	priv->hp_imp_open = true;
+	mutex_unlock(&priv->hp_imp_lock);
+
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		mutex_lock(&priv->hp_imp_lock);
+		priv->hp_imp_open = false;
+		mutex_unlock(&priv->hp_imp_lock);
+		return ret;
+	}
+
+	/* mtk_pcm_hp_impedance_hardware, mt_soc_pcm_hp_impedance.c:100-116 */
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	return 0;
+}
+
+static void mt6735_afe_hpimp_shutdown(struct snd_pcm_substream *substream,
+				      struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	mutex_lock(&priv->hp_imp_lock);
+	priv->hp_imp_open = false;
+	mutex_unlock(&priv->hp_imp_lock);
+
+	/*
+	 * EnableAfe(false) returns the PMIC audio pins to GPIO mode once no
+	 * memory interface is running (AudDrv_Gpio.c:215-236).
+	 */
+	if (!mt6735_afe_playback_enabled(afe) &&
+	    !priv->memif_enabled[MT6735_AFE_MEMIF_VUL])
+		mt6735_afe_select_pmic_pins(afe, false);
+
+	pm_runtime_put(afe->dev);
+}
+
+static int mt6735_afe_hpimp_hw_params(struct snd_pcm_substream *substream,
+				      struct snd_pcm_hw_params *params,
+				      struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mtk_base_afe_memif *memif = &afe->memif[MT6735_AFE_MEMIF_DL1];
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	int fs;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return -EINVAL;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return -EINVAL;
+	if (channels < MT6735_AFE_CHANNELS_MIN ||
+	    channels > MT6735_AFE_CHANNELS_MAX)
+		return -EINVAL;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+	case SNDRV_PCM_FORMAT_S24_LE:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * SetDL1Buffer(), mt_soc_pcm_hp_impedance.c:137-160, with the buffer
+	 * address forced to the AFE internal SRAM instead of the ALSA ring
+	 * buffer (see the file header).  The vendor writes
+	 * base .. base + size - 1 to AFE_DL1_BASE/END.
+	 */
+	regmap_write(afe->regmap, AFE_DL1_BASE, MT6735_AFE_HPIMP_SRAM_PHYS);
+	regmap_write(afe->regmap, AFE_DL1_END,
+		     MT6735_AFE_HPIMP_SRAM_PHYS +
+		     MT6735_AFE_INTERNAL_SRAM_SIZE - 1);
+
+	memif->phys_buf_addr = MT6735_AFE_HPIMP_SRAM_PHYS;
+	memif->buffer_size = MT6735_AFE_INTERNAL_SRAM_SIZE;
+
+	return 0;
+}
+
+static int mt6735_afe_hpimp_prepare(struct snd_pcm_substream *substream,
+				    struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	const struct mtk_base_memif_data *data =
+		afe->memif[MT6735_AFE_MEMIF_DL1].data;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	bool wlen24 = (runtime->format == SNDRV_PCM_FORMAT_S24_LE);
+	unsigned int wlen, mono;
+	int fs, ret;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return -EINVAL;
+
+	fs = mt6735_afe_rate_to_fs(runtime->rate);
+	if (fs < 0)
+		return fs;
+
+	/*
+	 * EnableAfe(true) also switches the PMIC audio bus pins to their audio
+	 * function (AudDrv_Gpio.c:215-236, AudDrv_GPIO_PMIC_Select()).
+	 */
+	mt6735_afe_select_pmic_pins(afe, true);
+
+	/*
+	 * SetMemIfFetchFormatPerSample(DL1, ...), mt_soc_pcm_hp_impedance.c:
+	 * 239-250: AFE_WLEN_32_BIT_ALIGN_8BIT_0_24BIT_DATA for a 32/24 bit
+	 * stream (the port supports S24_LE) and AFE_WLEN_16_BIT otherwise.
+	 */
+	wlen = wlen24 ? AFE_WLEN_24_BIT : AFE_WLEN_16_BIT;
+	regmap_update_bits(afe->regmap, data->hd_reg,
+			   AFE_MEMIF_PBUF_FMT_MASK << data->hd_shift,
+			   wlen << data->hd_shift);
+
+	/* SetoutputConnectionFormat() for O03/O04, :243-253 */
+	mt6735_afe_set_conn_width(afe, MT6735_AFE_MEMIF_DL1, wlen24);
+
+	/* SetI2SDacOut()/SetI2SDacEnable(), :257-263 and 2010-2026 */
+	if (!priv->dac_path_on) {
+		ret = mt6735_afe_dac_prepare(afe, runtime->rate, wlen24);
+		if (ret)
+			return ret;
+	}
+
+	/* SetSampleRate(DL1)/SetChannels(DL1), :270-271 */
+	regmap_update_bits(afe->regmap, data->fs_reg,
+			   data->fs_maskbit << data->fs_shift,
+			   fs << data->fs_shift);
+	mono = (runtime->channels == 1) ? 1 : 0;
+	regmap_update_bits(afe->regmap, data->mono_reg,
+			   BIT(data->mono_shift), mono << data->mono_shift);
+
+	/*
+	 * SetConnection(I05 -> O03) and SetConnection(I06 -> O04),
+	 * mt_soc_pcm_hp_impedance.c:265-268.
+	 */
+	return mt6735_afe_connect(afe, MT6735_AFE_MEMIF_DL1, true);
+}
+
+static int mt6735_afe_hpimp_trigger(struct snd_pcm_substream *substream,
+				    int cmd, struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	int ret;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/*
+		 * SetMemoryPathEnable(MEM_DL1, true) plus EnableAfe(true),
+		 * mt_soc_pcm_hp_impedance.c:272-274.  The vendor enables both
+		 * in prepare; the port keeps ALSA's prepare/trigger split.
+		 */
+		return mt6735_afe_memif_enable(afe, MT6735_AFE_MEMIF_DL1, true);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		/* mtk_soc_pcm_hp_impedance_close(), :281-290 */
+		ret = mt6735_afe_memif_enable(afe, MT6735_AFE_MEMIF_DL1,
+					      false);
+		if (ret)
+			return ret;
+		mt6735_afe_connect(afe, MT6735_AFE_MEMIF_DL1, false);
+
+		if (!mt6735_afe_playback_enabled(afe) &&
+		    !priv->memif_enabled[MT6735_AFE_MEMIF_VUL])
+			mt6735_afe_dac_disable(afe);
+
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_afe_hpimp_ops = {
+	.startup = mt6735_afe_hpimp_startup,
+	.shutdown = mt6735_afe_hpimp_shutdown,
+	.hw_params = mt6735_afe_hpimp_hw_params,
+	.prepare = mt6735_afe_hpimp_prepare,
+	.trigger = mt6735_afe_hpimp_trigger,
+};
+
+/*
+ * MT_SOC_HP_IMPEDANCE_NAME (AudDrv_Def.h:229) and
+ * MT_SOC_HP_IMPEDANCE_STREAM_NAME (AudDrv_Def.h:336).
+ */
+const struct snd_soc_dai_driver mt6735_afe_hp_imp_dai = {
+	.name = "mt-soc-hpimpedancedai-driver",
+	.id = MT6735_AFE_DAI_HPIMP,
+	.ops = &mt6735_afe_hpimp_ops,
+	.playback = {
+		.stream_name = "HP_IMPEDANCE_Playback",
+		.channels_min = MT6735_AFE_CHANNELS_MIN,
+		.channels_max = MT6735_AFE_CHANNELS_MAX,
+		.rates = MT6735_AFE_RATES,
+		.rate_min = MT6735_AFE_RATE_MIN,
+		.rate_max = MT6735_AFE_RATE_MAX,
+		.formats = MT6735_AFE_FORMATS,
+	},
+};
diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-i2s.c b/sound/soc/mediatek/mt6735/mt6735-dai-i2s.c
new file mode 100644
index 000000000..e80f63bec
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-i2s.c
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC AFE I2S0 back-end DAI.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/:
+ *   mt_soc_afe_control.c  - Enable4pin_I2S0_I2S3(), SetCLkMclk()
+ *   mt_soc_pcm_dl1_i2s0.c - I2S0 register programming
+ *   AudDrv_Gpio.c         - audi2s1-mode0/mode1 pin muxing
+ *
+ * The MCLK/BCLK dividers live in the audiosys clock controller
+ * (AUDIO_CLK_AUDDIV_0/1 at 0x1021xxxx, SetCLkMclk()/SetCLkBclk(),
+ * mt_soc_afe_control.c:751-813) and are therefore programmed by the clock
+ * provider, not by this driver.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/* Default MCLK/sample rate ratio, MCLKFS in mt_soc_afe_control.c:137 */
+#define MT6735_AFE_I2S_MCLK_FS	128
+
+static int mt6735_afe_i2s_startup(struct snd_pcm_substream *substream,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	int ret;
+
+	/*
+	 * AFE_I2S_CON (0x0018) is shared with the FM I2S back end, which takes
+	 * the same register for the 2nd I2S input (Set2ndI2SIn(),
+	 * mt_soc_afe_control.c:2231).  Refuse the I2S0 stream while the FM
+	 * path owns it instead of overwriting its programming;
+	 * mt6735-dai-fm-i2s.c has the symmetric check.
+	 */
+	mutex_lock(&priv->i2s_con_lock);
+	if (priv->fm_i2s_active) {
+		mutex_unlock(&priv->i2s_con_lock);
+		return -EBUSY;
+	}
+	priv->i2s0_active = true;
+	mutex_unlock(&priv->i2s_con_lock);
+
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		goto err_release;
+	}
+
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	ret = snd_pcm_hw_constraint_integer(substream->runtime,
+					    SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		goto err_release;
+	}
+
+	return 0;
+
+err_release:
+	mutex_lock(&priv->i2s_con_lock);
+	priv->i2s0_active = false;
+	mutex_unlock(&priv->i2s_con_lock);
+
+	return ret;
+}
+
+static void mt6735_afe_i2s_shutdown(struct snd_pcm_substream *substream,
+				    struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	mt6735_afe_select_i2s_pins(afe, false);
+	pm_runtime_put(afe->dev);
+
+	mutex_lock(&priv->i2s_con_lock);
+	priv->i2s0_active = false;
+	mutex_unlock(&priv->i2s_con_lock);
+}
+
+/*
+ * Translate the ASoC DAI format into the AFE_I2S_CON format fields.
+ * AFE_I2S_CON bit 2 selects slave mode ("clock from : slave mode",
+ * mt_soc_pcm_hdmi.c:889), bit 5 inverts LRCK and bit 3 selects the I2S
+ * (rather than EIAJ) framing (mt_soc_afe_control.c:3758-3763).
+ */
+static int mt6735_afe_i2s_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int con;
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBP_CFP:
+		priv->i2s_slave = false;
+		break;
+	case SND_SOC_DAIFMT_CBC_CFC:
+		priv->i2s_slave = true;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		con = 0;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		con = AFE_I2S_CON_LRCK_INV;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * Fixed settings for the four wire I2S0 interface, from
+	 * Enable4pin_I2S0_I2S3() (mt_soc_afe_control.c:3749-3763): phase
+	 * shift fix, data taken from the IO mux, low jitter clock and I2S
+	 * framing.
+	 */
+	con |= AFE_I2S_CON_PHASE_SHIFT_FIX |
+	       AFE_I2S_CON_PAD_SEL_IO_MUX |
+	       AFE_I2S_CON_LOW_JITTER |
+	       (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT);
+	if (priv->i2s_slave)
+		con |= AFE_I2S_CON_SLAVE;
+
+	priv->i2s_con = con;
+
+	return 0;
+}
+
+/*
+ * MCLK is routed through the audiosys clock mux; only its value is validated
+ * here so that hw_params can check it against the stream rate the same way
+ * SetCLkMclk() derives the divider (mt_soc_afe_control.c:751-786).
+ */
+static int mt6735_afe_i2s_set_sysclk(struct snd_soc_dai *dai, int clk_id,
+				     unsigned int freq, int dir)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	if (clk_id != 0)
+		return -EINVAL;
+	if (dir != SND_SOC_CLOCK_OUT)
+		return -EINVAL;
+
+	priv->i2s_sysclk = freq;
+
+	return 0;
+}
+
+static int mt6735_afe_i2s_hw_params(struct snd_pcm_substream *substream,
+				    struct snd_pcm_hw_params *params,
+				    struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	unsigned int con, wlen;
+	int fs, ret;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return -EINVAL;
+
+	if (channels < MT6735_AFE_CHANNELS_MIN ||
+	    channels > MT6735_AFE_CHANNELS_MAX)
+		return -EINVAL;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		wlen = AFE_I2S_WLEN_16BIT;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		wlen = AFE_I2S_WLEN_32BIT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (priv->i2s_sysclk) {
+		if (priv->i2s_sysclk % rate)
+			return -EINVAL;
+		if (priv->i2s_sysclk < MT6735_AFE_I2S_MCLK_FS * rate)
+			dev_dbg(afe->dev,
+				"I2S0 MCLK %u Hz below %u x %u Hz\n",
+				priv->i2s_sysclk, MT6735_AFE_I2S_MCLK_FS, rate);
+	}
+
+	con = priv->i2s_con;
+	if (!con)
+		con = AFE_I2S_CON_PHASE_SHIFT_FIX |
+		      AFE_I2S_CON_PAD_SEL_IO_MUX |
+		      AFE_I2S_CON_LOW_JITTER |
+		      (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT);
+
+	con |= (fs << AFE_I2S_CON_FS_SHIFT) |
+	       (wlen << AFE_I2S_CON_WLEN_SHIFT);
+
+	/* AudDrv_GPIO_I2S_Select(true), AudDrv_Gpio.c:238-259 */
+	ret = mt6735_afe_select_i2s_pins(afe, true);
+	if (ret)
+		return ret;
+
+	/*
+	 * Bring-up sequence of Enable4pin_I2S0_I2S3(),
+	 * mt_soc_afe_control.c:3749-3782: soft reset, gate the I2S0 clock,
+	 * program the interface, ungate, release the reset.
+	 */
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1,
+			   AUDIO_TOP_CON1_I2S_SOFT_RST,
+			   AUDIO_TOP_CON1_I2S_SOFT_RST);
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1, AUDIO_TOP_CON1_I2S0_CG,
+			   AUDIO_TOP_CON1_I2S0_CG);
+	regmap_write(afe->regmap, AFE_I2S_CON, con);
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1, AUDIO_TOP_CON1_I2S0_CG,
+			   0);
+	udelay(200);
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1,
+			   AUDIO_TOP_CON1_I2S_SOFT_RST, 0);
+
+	return 0;
+}
+
+static int mt6735_afe_i2s_trigger(struct snd_pcm_substream *substream, int cmd,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/*
+		 * When DL1 feeds I2S0 (I2S0DL1 link) the DL1 samples are also
+		 * routed to the physical O00/O01 ports
+		 * (mt_soc_pcm_dl1_i2s0Dl1.c:514-518).
+		 */
+		if (priv->memif_enabled[MT6735_AFE_MEMIF_DL1])
+			regmap_update_bits(afe->regmap, AFE_CONN0,
+					   AFE_CONN_DL1_L_TO_O00 |
+					   AFE_CONN_DL1_R_TO_O01,
+					   AFE_CONN_DL1_L_TO_O00 |
+					   AFE_CONN_DL1_R_TO_O01);
+
+		return regmap_update_bits(afe->regmap, AFE_I2S_CON,
+					  AFE_I2S_CON_EN, AFE_I2S_CON_EN);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		regmap_update_bits(afe->regmap, AFE_I2S_CON, AFE_I2S_CON_EN, 0);
+		regmap_update_bits(afe->regmap, AFE_CONN0,
+				   AFE_CONN_DL1_L_TO_O00 |
+				   AFE_CONN_DL1_R_TO_O01, 0);
+
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_afe_i2s_ops = {
+	.startup = mt6735_afe_i2s_startup,
+	.shutdown = mt6735_afe_i2s_shutdown,
+	.set_fmt = mt6735_afe_i2s_set_fmt,
+	.set_sysclk = mt6735_afe_i2s_set_sysclk,
+	.hw_params = mt6735_afe_i2s_hw_params,
+	.trigger = mt6735_afe_i2s_trigger,
+};
+
+const struct snd_soc_dai_driver mt6735_afe_i2s_dai = {
+	.name = "mt-soc-i2s0dai-driver",
+	.id = MT6735_AFE_DAI_I2S0,
+	.ops = &mt6735_afe_i2s_ops,
+	.playback = {
+		.stream_name = "I2S0 Playback",
+		.channels_min = MT6735_AFE_CHANNELS_MIN,
+		.channels_max = MT6735_AFE_CHANNELS_MAX,
+		.rates = MT6735_AFE_RATES,
+		.rate_min = MT6735_AFE_RATE_MIN,
+		.rate_max = MT6735_AFE_RATE_MAX,
+		.formats = MT6735_AFE_FORMATS,
+	},
+	.capture = {
+		.stream_name = "I2S0 Capture",
+		.channels_min = MT6735_AFE_CHANNELS_MIN,
+		.channels_max = MT6735_AFE_CHANNELS_MAX,
+		.rates = MT6735_AFE_RATES,
+		.rate_min = MT6735_AFE_RATE_MIN,
+		.rate_max = MT6735_AFE_RATE_MAX,
+		.formats = MT6735_AFE_FORMATS,
+	},
+};
diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-pcm.c b/sound/soc/mediatek/mt6735/mt6735-dai-pcm.c
new file mode 100644
index 000000000..2202f2e3b
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-pcm.c
@@ -0,0 +1,573 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC AFE front-end DAIs (DL1, DL2, VUL).
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/:
+ *   mt_soc_pcm_dl1.c      - DL1 playback (codec path)
+ *   mt_soc_pcm_dl2.c      - DL2 playback (codec path)
+ *   mt_soc_pcm_capture.c  - VUL capture
+ *   mt_soc_afe_control.c  - memif/IRQ/rate/channel programming
+ */
+
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/*
+ * SetDLSrc2() sample rate table, mt_soc_afe_control.c:1596-1616.  Note that
+ * this field uses a dense 0..8 encoding, unlike the AFE_DAC_CON1 / I2S fields
+ * which use the sparse mt_soc_digital_type.h encoding.
+ */
+static const unsigned int mt6735_afe_dlsrc2_rates[] = {
+	8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000,
+};
+
+bool mt6735_afe_playback_enabled(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	return priv->memif_enabled[MT6735_AFE_MEMIF_DL1] ||
+	       priv->memif_enabled[MT6735_AFE_MEMIF_DL2];
+}
+
+static bool mt6735_afe_capture_enabled(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	return priv->memif_enabled[MT6735_AFE_MEMIF_VUL];
+}
+
+/*
+ * SetMemoryPathEnable(), mt_soc_afe_control.c:1968-2000: the memory
+ * interface enable bit is AFE_DAC_CON0 bit (interface + 1).
+ */
+int mt6735_afe_memif_enable(struct mtk_base_afe *afe, int id,
+			    bool enable)
+{
+	const struct mtk_base_memif_data *data = afe->memif[id].data;
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int bit = BIT(data->enable_shift);
+
+	regmap_update_bits(afe->regmap, data->enable_reg, bit,
+			   enable ? bit : 0);
+	priv->memif_enabled[id] = enable;
+	mt6735_afe_update_power(afe);
+
+	return 0;
+}
+
+/*
+ * SetConnection(), mt_soc_afe_connection.c:433-500.  Only the four routes
+ * used by this driver are implemented; see the table entries cited in
+ * mt6735-afe-regs.h.
+ */
+int mt6735_afe_connect(struct mtk_base_afe *afe, int id, bool connect)
+{
+	unsigned int reg, bits;
+
+	switch (id) {
+	case MT6735_AFE_MEMIF_DL1:
+		reg = AFE_CONN1;
+		bits = AFE_CONN_DL1_L_TO_O03;
+		regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+		reg = AFE_CONN2;
+		bits = AFE_CONN_DL1_R_TO_O04;
+		break;
+	case MT6735_AFE_MEMIF_DL2:
+		reg = AFE_CONN1;
+		bits = AFE_CONN_DL2_L_TO_O03;
+		regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+		reg = AFE_CONN2;
+		bits = AFE_CONN_DL2_R_TO_O04;
+		break;
+	case MT6735_AFE_MEMIF_VUL:
+		reg = AFE_CONN3;
+		bits = AFE_CONN_ADC_L_TO_O09 | AFE_CONN_ADC_R_TO_O10;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+
+	return 0;
+}
+
+/* SetoutputConnectionFormat(), mt_soc_afe_control.c:2371-2377 */
+void mt6735_afe_set_conn_width(struct mtk_base_afe *afe, int id, bool wlen24)
+{
+	unsigned int bits;
+
+	switch (id) {
+	case MT6735_AFE_MEMIF_DL1:
+	case MT6735_AFE_MEMIF_DL2:
+		bits = AFE_CONN_24BIT_O03 | AFE_CONN_24BIT_O04;
+		break;
+	case MT6735_AFE_MEMIF_VUL:
+		bits = AFE_CONN_24BIT_O09 | AFE_CONN_24BIT_O10;
+		break;
+	default:
+		return;
+	}
+
+	regmap_update_bits(afe->regmap, AFE_CONN_24BIT, bits,
+			   wlen24 ? bits : 0);
+}
+
+/*
+ * Downstream codec playback interface: SetI2SDacOut()/SetDLSrc2()/
+ * SetI2SDacEnable() from mt_soc_afe_control.c:1592-1655 and 2010-2034.
+ * AFE_I2S_CON1 is the I2S-style bus between the AFE and the PMIC codec.
+ */
+int mt6735_afe_dac_prepare(struct mtk_base_afe *afe, unsigned int rate,
+			   bool wlen32)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int val;
+	int fs, idx;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return fs;
+
+	for (idx = 0; idx < ARRAY_SIZE(mt6735_afe_dlsrc2_rates); idx++)
+		if (mt6735_afe_dlsrc2_rates[idx] == rate)
+			break;
+	if (idx == ARRAY_SIZE(mt6735_afe_dlsrc2_rates))
+		return -EINVAL;
+
+	/* CleanPreDistortion(), mt_soc_afe_control.c:1583-1590 */
+	regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON0, 0);
+	regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON1, 0);
+
+	/*
+	 * SetDLSrc2(), mt_soc_afe_control.c:1592-1635.  8k and 16k use the
+	 * voice mode configuration; the final 0x1 << 1 applies the -0.3 dB
+	 * speech gain MediaTek recommends for every rate.
+	 */
+	val = (idx << 28) | (0x3 << 24) | (0x3 << 11);
+	if (idx == 0 || idx == 3)
+		val |= (0x1 << 5);
+	val |= (0x1 << 1);
+	regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON0, val);
+	regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON1, 0xf74f0000);
+
+	/* SetI2SDacOut(), mt_soc_afe_control.c:1637-1655 */
+	val = (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT) |
+	      ((wlen32 ? AFE_I2S_WLEN_32BIT : AFE_I2S_WLEN_16BIT) <<
+	       AFE_I2S_CON_WLEN_SHIFT) |
+	      (fs << AFE_I2S_CON_FS_SHIFT);
+	regmap_write(afe->regmap, AFE_I2S_CON1, val);
+
+	/* SetSampleRate(MEM_I2S, rate), mt_soc_pcm_dl1.c:337 */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON1,
+			   AFE_DAC_CON1_FS_MASK << AFE_DAC_CON1_I2S_FS_SHIFT,
+			   fs << AFE_DAC_CON1_I2S_FS_SHIFT);
+
+	/* SetI2SDacEnable(true), mt_soc_afe_control.c:2010-2026 */
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+			   AFE_ADDA_UL_DL_CON0_EN, AFE_ADDA_UL_DL_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+			   AFE_ADDA_DL_SRC2_CON0_EN,
+			   AFE_ADDA_DL_SRC2_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_I2S_CON1, AFE_I2S_CON1_EN,
+			   AFE_I2S_CON1_EN);
+
+	priv->dac_path_on = true;
+
+	return 0;
+}
+
+/* SetI2SDacEnable(false), mt_soc_afe_control.c:2010-2034 */
+void mt6735_afe_dac_disable(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+			   AFE_ADDA_DL_SRC2_CON0_EN, 0);
+	regmap_update_bits(afe->regmap, AFE_I2S_CON1, AFE_I2S_CON1_EN, 0);
+
+	if (!priv->adc_path_on)
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+				   AFE_ADDA_UL_DL_CON0_EN, 0);
+
+	priv->dac_path_on = false;
+}
+
+/*
+ * PMIC codec capture interface: SetI2SAdcIn() internal ADC path and
+ * SetI2SAdcEnable(), mt_soc_afe_control.c:1346-1370 and 1553-1572.
+ */
+static int mt6735_afe_adc_prepare(struct mtk_base_afe *afe, unsigned int rate)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int voice_mode;
+	int fs;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return fs;
+
+	/*
+	 * The downstream driver leaves the voice mode selection at 0 for any
+	 * rate that is not 8k/16k/32k/48k (mt_soc_afe_control.c:1352-1366).
+	 */
+	switch (rate) {
+	case 8000:
+		voice_mode = 0;
+		break;
+	case 16000:
+		voice_mode = 1;
+		break;
+	case 32000:
+		voice_mode = 2;
+		break;
+	case 48000:
+		voice_mode = 3;
+		break;
+	default:
+		voice_mode = 0;
+		break;
+	}
+
+	/* SetI2SAdcIn(), mt_soc_afe_control.c:1346-1370 */
+	regmap_update_bits(afe->regmap, AFE_ADDA_TOP_CON0,
+			   AFE_ADDA_TOP_CON0_EXT_ADC, 0);
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0, 0x001e0000,
+			   (voice_mode << 19) | (voice_mode << 17));
+	regmap_write(afe->regmap, AFE_ADDA_NEWIF_CFG0, 0x03f87201);
+	regmap_update_bits(afe->regmap, AFE_ADDA_NEWIF_CFG1, 0x00000c00,
+			   ((voice_mode < 3) ? 1 : 3) << 10);
+
+	/* SetI2SAdcEnable(true), mt_soc_afe_control.c:1553-1566 */
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+			   AFE_ADDA_UL_DL_CON0_EN, AFE_ADDA_UL_DL_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+			   AFE_ADDA_UL_SRC_CON0_EN, AFE_ADDA_UL_SRC_CON0_EN);
+
+	priv->adc_path_on = true;
+
+	return 0;
+}
+
+static void mt6735_afe_adc_disable(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+			   AFE_ADDA_UL_SRC_CON0_EN, 0);
+
+	if (!priv->dac_path_on)
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+				   AFE_ADDA_UL_DL_CON0_EN, 0);
+
+	priv->adc_path_on = false;
+}
+
+static int mt6735_afe_fe_startup(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int id = dai->id;
+	int ret;
+
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		return ret;
+	}
+
+	/*
+	 * The HP impedance FE stream rebases the DL1 memory interface onto the
+	 * AFE internal SRAM.  Refuse a second DL1 user while it is held; the
+	 * HP impedance DAI likewise refuses to start while DL1 is playing.
+	 * Both reservations happen under hp_imp_lock, so the two DAIs cannot
+	 * slip past each other's check.
+	 */
+	mutex_lock(&priv->hp_imp_lock);
+	if (id == MT6735_AFE_DAI_DL1 && priv->hp_imp_open) {
+		mutex_unlock(&priv->hp_imp_lock);
+		pm_runtime_put(afe->dev);
+		return -EBUSY;
+	}
+	afe->memif[id].substream = substream;
+	mutex_unlock(&priv->hp_imp_lock);
+
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	/*
+	 * The memory interface consumes whole 64 byte blocks
+	 * (Align64ByteSize(), mt_soc_afe_control.c:3702-3710) and the DL1
+	 * buffer index is masked with 0xffffffc0 in the interrupt handler
+	 * (mt_soc_afe_control.c:3025,3065).
+	 */
+	ret = snd_pcm_hw_constraint_step(runtime, 0,
+					 SNDRV_PCM_HW_PARAM_BUFFER_BYTES, 64);
+	if (ret < 0)
+		goto err_put;
+
+	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		goto err_put;
+
+	/*
+	 * Capture keeps a ping-pong buffer in the AFE, so the reported read
+	 * pointer can trail the interrupt point by up to a period.
+	 */
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		ret = snd_pcm_hw_constraint_minmax(runtime,
+						   SNDRV_PCM_HW_PARAM_PERIODS, 3,
+						   runtime->hw.periods_max);
+		if (ret < 0)
+			goto err_put;
+	}
+
+	return 0;
+
+err_put:
+	mutex_lock(&priv->hp_imp_lock);
+	afe->memif[id].substream = NULL;
+	mutex_unlock(&priv->hp_imp_lock);
+	pm_runtime_put_noidle(afe->dev);
+	return ret;
+}
+
+static void mt6735_afe_fe_shutdown(struct snd_pcm_substream *substream,
+				   struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	mutex_lock(&priv->hp_imp_lock);
+	afe->memif[dai->id].substream = NULL;
+	mutex_unlock(&priv->hp_imp_lock);
+
+	/*
+	 * EnableAfe(false) returns the PMIC audio pins to GPIO mode once no
+	 * memory interface is running (AudDrv_Gpio.c:215-236).
+	 */
+	if (!mt6735_afe_playback_enabled(afe) && !mt6735_afe_capture_enabled(afe))
+		mt6735_afe_select_pmic_pins(afe, false);
+
+	pm_runtime_put(afe->dev);
+}
+
+static int mt6735_afe_fe_hw_params(struct snd_pcm_substream *substream,
+				   struct snd_pcm_hw_params *params,
+				   struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mtk_base_afe_memif *memif = &afe->memif[dai->id];
+	const struct mtk_base_memif_data *data = memif->data;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	unsigned int mono;
+	int fs;
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	    dai->id == MT6735_AFE_DAI_VUL)
+		return -EINVAL;
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE &&
+	    dai->id != MT6735_AFE_DAI_VUL)
+		return -EINVAL;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return -EINVAL;
+	if (channels < MT6735_AFE_CHANNELS_MIN ||
+	    channels > MT6735_AFE_CHANNELS_MAX)
+		return -EINVAL;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+	case SNDRV_PCM_FORMAT_S24_LE:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!runtime->dma_bytes || !runtime->dma_addr)
+		return -EINVAL;
+
+	/*
+	 * The AFE memory interfaces only decode 32 bit addresses.  A 33 bit
+	 * address would need AFE_MEMIF_MSB (AudDrv_Afe.h:470), which the
+	 * downstream driver never programs.
+	 */
+	if (upper_32_bits(runtime->dma_addr))
+		return -EINVAL;
+
+	/* SetDL1Buffer()/SetDL2Buffer(), mt_soc_pcm_dl1.c:234-255 */
+	regmap_write(afe->regmap, data->reg_ofs_base,
+		     lower_32_bits(runtime->dma_addr));
+	regmap_write(afe->regmap, data->reg_ofs_end,
+		     lower_32_bits(runtime->dma_addr) + runtime->dma_bytes - 1);
+
+	memif->phys_buf_addr = lower_32_bits(runtime->dma_addr);
+	memif->buffer_size = runtime->dma_bytes;
+	memif->dma_area = runtime->dma_area;
+	memif->dma_addr = runtime->dma_addr;
+	memif->dma_bytes = runtime->dma_bytes;
+
+	/* SetSampleRate(), mt_soc_afe_control.c:1073-1128 */
+	regmap_update_bits(afe->regmap, data->fs_reg,
+			   data->fs_maskbit << data->fs_shift,
+			   fs << data->fs_shift);
+
+	/* SetChannels(), mt_soc_afe_control.c:1129-1160 */
+	mono = (channels == 1) ? 1 : 0;
+	regmap_update_bits(afe->regmap, data->mono_reg,
+			   BIT(data->mono_shift), mono << data->mono_shift);
+
+	return 0;
+}
+
+static int mt6735_afe_fe_prepare(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	const struct mtk_base_memif_data *data = afe->memif[dai->id].data;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	bool wlen24 = (runtime->format == SNDRV_PCM_FORMAT_S24_LE);
+	unsigned int wlen;
+
+	/*
+	 * EnableAfe(true) also switches the PMIC audio bus pins to their
+	 * audio function (AudDrv_Gpio.c:215-236, AudDrv_GPIO_PMIC_Select()).
+	 * This runs from prepare because trigger is atomic.
+	 */
+	mt6735_afe_select_pmic_pins(afe, true);
+
+	/* SetMemIfFetchFormatPerSample(), mt_soc_afe_control.c:2294-2369 */
+	wlen = wlen24 ? AFE_WLEN_24_BIT : AFE_WLEN_16_BIT;
+	regmap_update_bits(afe->regmap, data->hd_reg,
+			   AFE_MEMIF_PBUF_FMT_MASK << data->hd_shift,
+			   wlen << data->hd_shift);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		mt6735_afe_set_conn_width(afe, dai->id, wlen24);
+		if (priv->dac_path_on)
+			return 0;
+		return mt6735_afe_dac_prepare(afe, runtime->rate, wlen24);
+	}
+
+	mt6735_afe_set_conn_width(afe, dai->id, wlen24);
+	if (priv->adc_path_on)
+		return 0;
+	return mt6735_afe_adc_prepare(afe, runtime->rate);
+}
+
+static int mt6735_afe_fe_trigger(struct snd_pcm_substream *substream, int cmd,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	int id = dai->id;
+	int ret;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		ret = mt6735_afe_connect(afe, id, true);
+		if (ret)
+			return ret;
+
+		ret = mt6735_afe_memif_enable(afe, id, true);
+		if (ret)
+			return ret;
+
+		/*
+		 * irq_add_user(), mt_soc_afe_control.c:4013-4062: program the
+		 * sample rate and counter, then enable the interrupt.
+		 */
+		return mt6735_afe_irq_update(afe, afe->memif[id].irq_usage);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		mt6735_afe_memif_enable(afe, id, false);
+		mt6735_afe_irq_update(afe, afe->memif[id].irq_usage);
+		mt6735_afe_connect(afe, id, false);
+
+		/* mt_soc_pcm_dl1.c:347-358 / mt_soc_pcm_capture.c:101-116 */
+		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+			if (!mt6735_afe_playback_enabled(afe))
+				mt6735_afe_dac_disable(afe);
+		} else {
+			if (!mt6735_afe_capture_enabled(afe))
+				mt6735_afe_adc_disable(afe);
+		}
+
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_afe_fe_ops = {
+	.startup = mt6735_afe_fe_startup,
+	.shutdown = mt6735_afe_fe_shutdown,
+	.hw_params = mt6735_afe_fe_hw_params,
+	.prepare = mt6735_afe_fe_prepare,
+	.trigger = mt6735_afe_fe_trigger,
+};
+
+/*
+ * The PCM DAI id doubles as the memory interface index.  DL1 must stay the
+ * first entry: ASoC assigns id 0 to the first DAI of an array when its
+ * driver id is 0 (snd_soc_register_dai(), soc-core.c:2728-2735).
+ */
+const struct snd_soc_dai_driver mt6735_afe_pcm_dais[MT6735_AFE_PCM_DAI_NUM] = {
+	[MT6735_AFE_DAI_DL1] = {
+		.name = "mt-soc-dl1dai-driver",
+		.id = MT6735_AFE_DAI_DL1,
+		.ops = &mt6735_afe_fe_ops,
+		.playback = {
+			.stream_name = "DL1 Playback",
+			.channels_min = MT6735_AFE_CHANNELS_MIN,
+			.channels_max = MT6735_AFE_CHANNELS_MAX,
+			.rates = MT6735_AFE_RATES,
+			.rate_min = MT6735_AFE_RATE_MIN,
+			.rate_max = MT6735_AFE_RATE_MAX,
+			.formats = MT6735_AFE_FORMATS,
+		},
+	},
+	[MT6735_AFE_DAI_DL2] = {
+		.name = "mt-soc-dl2dai-driver",
+		.id = MT6735_AFE_DAI_DL2,
+		.ops = &mt6735_afe_fe_ops,
+		.playback = {
+			.stream_name = "DL2 Playback",
+			.channels_min = MT6735_AFE_CHANNELS_MIN,
+			.channels_max = MT6735_AFE_CHANNELS_MAX,
+			.rates = MT6735_AFE_RATES,
+			.rate_min = MT6735_AFE_RATE_MIN,
+			.rate_max = MT6735_AFE_RATE_MAX,
+			.formats = MT6735_AFE_FORMATS,
+		},
+	},
+	[MT6735_AFE_DAI_VUL] = {
+		.name = "mt-soc-ul1dai-driver",
+		.id = MT6735_AFE_DAI_VUL,
+		.ops = &mt6735_afe_fe_ops,
+		.capture = {
+			.stream_name = "UL1 Capture",
+			.channels_min = MT6735_AFE_CHANNELS_MIN,
+			.channels_max = MT6735_AFE_CHANNELS_MAX,
+			.rates = MT6735_AFE_RATES,
+			.rate_min = MT6735_AFE_RATE_MIN,
+			.rate_max = MT6735_AFE_RATE_MAX,
+			.formats = MT6735_AFE_FORMATS,
+		},
+	},
+};
diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-voice.c b/sound/soc/mediatek/mt6735/mt6735-dai-voice.c
new file mode 100644
index 000000000..df15dd295
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-voice.c
@@ -0,0 +1,1105 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC AFE voice and BT SCO front-end DAIs.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/:
+ *   mt_soc_pcm_voice_md1.c     - internal modem voice (PCM2_INTF_CON)
+ *   mt_soc_pcm_voice_md2.c     - external modem voice (PCM_INTF_CON)
+ *   mt_soc_pcm_voice_md1_bt.c  - internal modem <-> BT SCO
+ *   mt_soc_pcm_voice_md2_bt.c  - external modem <-> BT SCO
+ *   mt_soc_pcm_bt_dai.c        - BT SCO capture into the DAI memory interface
+ *   mt_soc_afe_control.c       - SetModemPcmConfig/SetModemPcmEnable,
+ *                                SetDaiBt/SetDaiBtEnable, codec path setup
+ *   mt_soc_afe_connection.c    - AFE_CONNx routing used by the voice PCMs
+ *
+ * The downstream voice PCMs have no AP-side DMA: the modem PCM interface
+ * (or the DAI_BT block for BT SCO) moves the samples between the modem / BT
+ * controller and the AFE, and the AP stream only configures the hardware.
+ * mtk_voice_pcm_copy() and mtk_voice1_prepare() in mt_soc_pcm_voice_md1.c
+ * therefore never touch the ALSA buffer, which is why the stream position of
+ * these DAIs does not advance (see mt6735_afe_dai_memif_id() in
+ * mt6735-afe-pcm.c).  The BT SCO DAI is the exception: it is a real memory
+ * interface (MEM_DAI), so its pointer tracks AFE_DAI_CUR.
+ *
+ * Not implemented, with the downstream input that is missing:
+ *   - MRG/HDMI/FM/TDM/AWB/offload PCMs (out of scope).
+ *   - BT SCO playback: the downstream DAI memory interface has no documented
+ *     route towards DAI_BT (mConnectionReg[I10..I13][O02] are all -1); the
+ *     AP -> BT direction exists only as DL1 -> O02 in mt_soc_pcm_dl1_bt.c,
+ *     which is the separate VOIP_CALL_BT PCM, not this DAI.
+ *   - BT -> external-modem second uplink channel: mConnectionReg[I02][O08] is
+ *     -1, the downstream SetConnection() call is a no-op.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/* Voice DAI kind, selected from the DAI id. */
+enum mt6735_voice_kind {
+	MT6735_VOICE_MD1 = 0,	/* internal modem, PCM2_INTF_CON (0x53c) */
+	MT6735_VOICE_MD2,	/* external modem, PCM_INTF_CON (0x530) */
+	MT6735_VOICE_MD1_BT,	/* internal modem <-> DAI_BT */
+	MT6735_VOICE_MD2_BT,	/* external modem <-> DAI_BT */
+	MT6735_VOICE_DAIBT,	/* BT SCO <-> MEM_DAI */
+};
+
+/*
+ * Voice hardware parameters, mt_soc_pcm_voice_md1.c:102-118: MAX_BUFFER_SIZE
+ * and MAX_PERIOD_SIZE are 36 KiB (mt_soc_pcm_common.h:132-134) and the period
+ * count runs 1..4096.  The internal modem PCMs and the two BT variants use
+ * that set; the external modem PCM (mt_soc_pcm_voice_md2.c:123-138) uses
+ * MAX_BUFFER_SIZE_MD2 = 16 KiB instead (mt_soc_pcm_voice_md2.c:74).
+ *
+ * 8 kHz (narrow band) and 16 kHz (wide band) mono S16_LE are the PCM modes
+ * the AFE implements.  Downstream also lists 32000
+ * (soc_voice_supported_sample_rates, mt_soc_pcm_common.h:214-216), but its
+ * prepare path programs any rate other than 8 kHz as 16 kHz PCM mode
+ * (mt_soc_pcm_voice_md1.c:303-304, mt_soc_pcm_voice_md2.c:296-297), so 32 kHz
+ * is rejected here instead of running at half the requested rate.
+ */
+static const struct snd_pcm_hardware mt6735_voice_hardware = {
+	.info = SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_INTERLEAVED |
+		SNDRV_PCM_INFO_RESUME |
+		SNDRV_PCM_INFO_MMAP_VALID,
+	.formats = MT6735_VOICE_FORMATS,
+	.rates = MT6735_VOICE_RATES,
+	.rate_min = MT6735_VOICE_RATE_MIN,
+	.rate_max = MT6735_VOICE_RATE_MAX,
+	.channels_min = 1,
+	.channels_max = 1,
+	.buffer_bytes_max = MT6735_VOICE_BUFFER_MAX,
+	.period_bytes_min = 64,
+	.period_bytes_max = MT6735_VOICE_BUFFER_MAX,
+	.periods_min = 1,
+	.periods_max = 4096,
+	.fifo_size = 0,
+};
+
+/* External modem PCM, mt_soc_pcm_voice_md2.c:123-138. */
+static const struct snd_pcm_hardware mt6735_voice_md2_hardware = {
+	.info = SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_INTERLEAVED |
+		SNDRV_PCM_INFO_RESUME |
+		SNDRV_PCM_INFO_MMAP_VALID,
+	.formats = MT6735_VOICE_FORMATS,
+	.rates = MT6735_VOICE_RATES,
+	.rate_min = MT6735_VOICE_RATE_MIN,
+	.rate_max = MT6735_VOICE_RATE_MAX,
+	.channels_min = 1,
+	.channels_max = 1,
+	.buffer_bytes_max = MT6735_VOICE_MD2_BUFFER_MAX,
+	.period_bytes_min = 64,
+	.period_bytes_max = MT6735_VOICE_MD2_BUFFER_MAX,
+	.periods_min = 1,
+	.periods_max = 4096,
+	.fifo_size = 0,
+};
+
+/*
+ * BT SCO hardware parameters, mt_soc_pcm_bt_dai.c:69-78 with
+ * BT_DAI_MAX_BUFFER_SIZE = 16 KiB (mt_soc_pcm_common.h:119) and 1..4 periods
+ * (SOC_NORMAL_USE_PERIODS_MIN/MAX, mt_soc_pcm_common.h:193-194).
+ *
+ * SNDRV_PCM_INFO_MMAP/MMAP_VALID are added to the downstream flags
+ * (INTERLEAVED only): this DAI has no custom .copy callback, the AFE writes
+ * the managed DMA buffer directly, so the standard mmap path is used.
+ */
+static const struct snd_pcm_hardware mt6735_btcvsd_hardware = {
+	.info = SNDRV_PCM_INFO_MMAP |
+		SNDRV_PCM_INFO_INTERLEAVED |
+		SNDRV_PCM_INFO_MMAP_VALID,
+	.formats = MT6735_VOICE_FORMATS,
+	.rates = MT6735_VOICE_RATES,
+	.rate_min = MT6735_VOICE_RATE_MIN,
+	.rate_max = MT6735_VOICE_RATE_MAX,
+	.channels_min = 1,
+	.channels_max = 1,
+	.buffer_bytes_max = MT6735_BTCVSD_BUFFER_MAX,
+	.period_bytes_min = 64,
+	.period_bytes_max = MT6735_BTCVSD_BUFFER_MAX,
+	.periods_min = 1,
+	.periods_max = MT6735_BTCVSD_PERIODS_MAX,
+	.fifo_size = 0,
+};
+
+static const struct snd_pcm_hardware *
+mt6735_voice_pcm_hardware(enum mt6735_voice_kind kind)
+{
+	switch (kind) {
+	case MT6735_VOICE_MD2:
+		return &mt6735_voice_md2_hardware;
+	case MT6735_VOICE_DAIBT:
+		return &mt6735_btcvsd_hardware;
+	default:
+		return &mt6735_voice_hardware;
+	}
+}
+
+/*
+ * MRG I2S sample rate field used by the merge interface the DAI_BT block is
+ * fed from.  SetDaiBtEnable() (mt_soc_afe_control.c:1231-1234) programs it
+ * from mAudioMrg->Mrg_I2S_SampleRate, which mt_soc_afe_control.c:501
+ * initialises to SampleRateTransform(44100) = 9; the voice-BT and DAI_BT
+ * paths never change that value.
+ */
+#define MT6735_MRGIF_FS_44K	9
+
+static enum mt6735_voice_kind mt6735_voice_kind(int dai_id)
+{
+	switch (dai_id) {
+	case MT6735_AFE_DAI_VOICE_MD1:
+		return MT6735_VOICE_MD1;
+	case MT6735_AFE_DAI_VOICE_MD2:
+		return MT6735_VOICE_MD2;
+	case MT6735_AFE_DAI_VOICE_MD1_BT:
+		return MT6735_VOICE_MD1_BT;
+	case MT6735_AFE_DAI_VOICE_MD2_BT:
+		return MT6735_VOICE_MD2_BT;
+	default:
+		return MT6735_VOICE_DAIBT;
+	}
+}
+
+static struct mt6735_voice_state *mt6735_voice_state(struct mtk_base_afe *afe,
+						    int dai_id)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	return &priv->voice[MT6735_AFE_VOICE_DAI_IDX(dai_id)];
+}
+
+/* SetConnection(), one AFE_CONNx bit (mt_soc_afe_connection.c:415-504). */
+static void mt6735_voice_conn(struct mtk_base_afe *afe, unsigned int reg,
+			      unsigned int bits, bool connect)
+{
+	regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+}
+
+/*
+ * AFE interconnection for each voice PCM, from the prepare/close sequences of
+ * the downstream PCMs.  Register and bit for every route are in
+ * mt6735-afe-regs.h.
+ *
+ *   MD1    : mt_soc_pcm_voice_md1.c:219-222, 287-290
+ *   MD2    : mt_soc_pcm_voice_md2.c:212-215, 280-283
+ *   MD1_BT : mt_soc_pcm_voice_md1_bt.c:192-194, 278-280
+ *   MD2_BT : mt_soc_pcm_voice_md2_bt.c:176-178, 262-264
+ *   DAIBT  : mt_soc_pcm_bt_dai.c:92,134
+ */
+static void mt6735_voice_connect(struct mtk_base_afe *afe,
+				 enum mt6735_voice_kind kind, bool on)
+{
+	switch (kind) {
+	case MT6735_VOICE_MD1:
+		/* modem PCM1 downlink -> codec DAC */
+		mt6735_voice_conn(afe, AFE_CONN3, AFE_CONN3_I14_TO_O03, on);
+		mt6735_voice_conn(afe, AFE_CONN4, AFE_CONN4_I14_TO_O04, on);
+		/* codec ADC -> modem PCM1 uplink */
+		mt6735_voice_conn(afe, AFE_CONN4, AFE_CONN4_I03_TO_O17, on);
+		mt6735_voice_conn(afe, AFE_CONN4, AFE_CONN4_I04_TO_O18, on);
+		break;
+	case MT6735_VOICE_MD2:
+		/* codec ADC -> external modem uplink */
+		mt6735_voice_conn(afe, AFE_CONN2, AFE_CONN2_I03_TO_O07, on);
+		mt6735_voice_conn(afe, AFE_CONN2, AFE_CONN2_I04_TO_O08, on);
+		/* external modem downlink -> codec DAC */
+		mt6735_voice_conn(afe, AFE_CONN1, AFE_CONN1_I09_TO_O03, on);
+		mt6735_voice_conn(afe, AFE_CONN2, AFE_CONN2_I09_TO_O04, on);
+		break;
+	case MT6735_VOICE_MD1_BT:
+		/* BT SCO -> modem PCM1 uplink */
+		mt6735_voice_conn(afe, AFE_CONN4, AFE_CONN4_I02_TO_O17, on);
+		mt6735_voice_conn(afe, AFE_CONN4, AFE_CONN4_I02_TO_O18, on);
+		/* modem PCM1 downlink -> BT SCO */
+		mt6735_voice_conn(afe, AFE_CONN3, AFE_CONN3_I14_TO_O02, on);
+		break;
+	case MT6735_VOICE_MD2_BT:
+		/* BT SCO -> external modem uplink (ch2 has no register) */
+		mt6735_voice_conn(afe, AFE_CONN4, AFE_CONN4_I02_TO_O07, on);
+		/* external modem downlink -> BT SCO */
+		mt6735_voice_conn(afe, AFE_CONN1, AFE_CONN1_I09_TO_O02, on);
+		break;
+	case MT6735_VOICE_DAIBT:
+		/* BT SCO -> MEM_DAI capture buffer */
+		mt6735_voice_conn(afe, AFE_CONN3, AFE_CONN3_I02_TO_O11, on);
+		break;
+	}
+}
+
+/*
+ * EnableAfe(), mt_soc_afe_control.c:949-1032: the modem PCM and DAI_BT paths
+ * have no memory interface, so they are counted separately and OR-ed into
+ * the AFE_DAC_CON0 power bit by mt6735_afe_update_power().  The PMIC audio
+ * pins follow the AFE state (AudDrv_GPIO_PMIC_Select(),
+ * AudDrv_Gpio.c:215-236), but EnableAfe() only returns them to GPIO when
+ * CheckMemIfEnable() reports no memory interface left
+ * (mt_soc_afe_control.c:903-916, 980-993), hence the memif check below.
+ */
+static bool mt6735_voice_memif_busy(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	int i;
+
+	for (i = 0; i < MT6735_AFE_MEMIF_NUM; i++)
+		if (priv->memif_enabled[i])
+			return true;
+
+	return false;
+}
+
+static void mt6735_voice_afe_enable(struct mtk_base_afe *afe, bool enable)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	if (enable) {
+		if (!priv->voice_afe_users)
+			mt6735_afe_select_pmic_pins(afe, true);
+		priv->voice_afe_users++;
+		mt6735_afe_update_power(afe);
+		return;
+	}
+
+	if (!priv->voice_afe_users)
+		return;
+
+	if (!--priv->voice_afe_users) {
+		mt6735_afe_update_power(afe);
+		if (!mt6735_voice_memif_busy(afe))
+			mt6735_afe_select_pmic_pins(afe, false);
+	}
+}
+
+/* SetDLSrc2(), mt_soc_afe_control.c:1592-1635 (dense 8k..48k index). */
+static int mt6735_voice_dlsrc2_index(unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return 0;
+	case 16000:
+		return 3;
+	default:
+		return -EINVAL;
+	}
+}
+
+/*
+ * SetI2SDacOut()/SetI2SDacEnable() for the voice rates,
+ * mt_soc_afe_control.c:1637-1655 and :2010-2026.  The voice PCMs only use
+ * the 16 bit I2S format (Soc_Aud_I2S_WLEN_WLEN_16BITS).
+ */
+static int mt6735_voice_dac_on(struct mtk_base_afe *afe, unsigned int rate)
+{
+	int fs, idx;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return fs;
+
+	idx = mt6735_voice_dlsrc2_index(rate);
+	if (idx < 0)
+		return idx;
+
+	/* CleanPreDistortion(), mt_soc_afe_control.c:1582-1590 */
+	regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON0, 0);
+	regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON1, 0);
+
+	/* SetDLSrc2(): voice mode and the -0.3 dB speech gain */
+	regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+		     (idx << 28) | (0x3 << 24) | (0x3 << 11) |
+		     (0x1 << 5) | (0x1 << 1));
+	regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON1, 0xf74f0000);
+
+	/* SetI2SDacOut(): I2S format, 16 bit, no LRCK inversion, no LR swap */
+	regmap_write(afe->regmap, AFE_I2S_CON1,
+		     (fs << AFE_I2S_CON_FS_SHIFT) |
+		     (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT) |
+		     (AFE_I2S_WLEN_16BIT << AFE_I2S_CON_WLEN_SHIFT));
+
+	/* SetMemoryPathEnable(I2S_OUT_DAC, true) */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+			   AFE_DAC_CON0_I2S_OUT_DAC_EN,
+			   AFE_DAC_CON0_I2S_OUT_DAC_EN);
+
+	/* SetI2SDacEnable(true) */
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+			   AFE_ADDA_UL_DL_CON0_EN, AFE_ADDA_UL_DL_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+			   AFE_ADDA_DL_SRC2_CON0_EN, AFE_ADDA_DL_SRC2_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_I2S_CON1, AFE_I2S_CON1_EN,
+			   AFE_I2S_CON1_EN);
+
+	return 0;
+}
+
+/*
+ * SetI2SAdcIn()/SetI2SAdcEnable() with the internal ADC,
+ * mt_soc_afe_control.c:1346-1370 and :1553-1572.  AudioAdcI2SStatus is false
+ * unless an external ADC is selected (mt_soc_afe_control.c:497), so the
+ * internal ADC branch is the one the voice PCMs use.
+ */
+static int mt6735_voice_adc_on(struct mtk_base_afe *afe, unsigned int rate)
+{
+	unsigned int voice_mode;
+
+	switch (rate) {
+	case 8000:
+		voice_mode = 0;
+		break;
+	case 16000:
+		voice_mode = 1;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	regmap_update_bits(afe->regmap, AFE_ADDA_TOP_CON0,
+			   AFE_ADDA_TOP_CON0_EXT_ADC, 0);
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0, 0x001e0000,
+			   (voice_mode << 19) | (voice_mode << 17));
+	regmap_write(afe->regmap, AFE_ADDA_NEWIF_CFG0, 0x03f87201);
+	/* dVoiceModeSelect is 0 or 1 for the two voice rates */
+	regmap_update_bits(afe->regmap, AFE_ADDA_NEWIF_CFG1, 0x00000c00,
+			   1 << 10);
+
+	/* SetMemoryPathEnable(I2S_IN_ADC, true) */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+			   AFE_DAC_CON0_I2S_IN_ADC_EN,
+			   AFE_DAC_CON0_I2S_IN_ADC_EN);
+
+	/* SetI2SAdcEnable(true) */
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+			   AFE_ADDA_UL_DL_CON0_EN, AFE_ADDA_UL_DL_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+			   AFE_ADDA_UL_SRC_CON0_EN, AFE_ADDA_UL_SRC_CON0_EN);
+
+	return 0;
+}
+
+/*
+ * SetI2SDacEnable(false)/SetI2SAdcEnable(false),
+ * mt_soc_afe_control.c:2010-2034 and :1553-1572.  The downstream driver
+ * gates these on the I2S_OUT_DAC / I2S_IN_ADC user counts; the multimedia
+ * path keeps its state in priv->dac_path_on / adc_path_on and in the memory
+ * interfaces, so those are honoured here as well.
+ */
+static void mt6735_voice_codec_off(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	bool dac_used = priv->dac_path_on ||
+			priv->memif_enabled[MT6735_AFE_MEMIF_DL1] ||
+			priv->memif_enabled[MT6735_AFE_MEMIF_DL2];
+	bool adc_used = priv->adc_path_on ||
+			priv->memif_enabled[MT6735_AFE_MEMIF_VUL];
+
+	if (!dac_used) {
+		regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+				   AFE_ADDA_DL_SRC2_CON0_EN, 0);
+		regmap_update_bits(afe->regmap, AFE_I2S_CON1,
+				   AFE_I2S_CON1_EN, 0);
+		regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+				   AFE_DAC_CON0_I2S_OUT_DAC_EN, 0);
+	}
+
+	if (!adc_used) {
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+				   AFE_ADDA_UL_SRC_CON0_EN, 0);
+		regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+				   AFE_DAC_CON0_I2S_IN_ADC_EN, 0);
+	}
+
+	if (!dac_used && !adc_used)
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+				   AFE_ADDA_UL_DL_CON0_EN, 0);
+}
+
+/*
+ * SetModemPcmConfig() for the internal modem, mt_soc_afe_control.c:1732-1785:
+ * PCM2_INTF_CON plus the ASRC2/ASRC3 ratio registers.  Values are the
+ * Voice1Pcm attributes of mt_soc_pcm_voice_md1.c:81-96 with
+ * mAsyncFifoSel = Soc_Aud_BYPASS_SRC_SLAVE_USE_ASYNC_FIFO and
+ * mPcmModeWidebandSel from the stream rate (mt_soc_pcm_voice_md1.c:303-304).
+ */
+static int mt6735_voice_md1_config(struct mtk_base_afe *afe, unsigned int rate)
+{
+	unsigned int wideband, val;
+
+	if (rate == 8000) {
+		wideband = PCM_MODE_8K;
+		regmap_write(afe->regmap, AFE_ASRC2_CON1, 0x00098580);
+		regmap_write(afe->regmap, AFE_ASRC2_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC2_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC2_CON4, 0x00098580);
+		regmap_write(afe->regmap, AFE_ASRC2_CON7, 0x0004c2c0);
+		regmap_write(afe->regmap, AFE_ASRC3_CON1, 0x00098580);
+		regmap_write(afe->regmap, AFE_ASRC3_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC3_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC3_CON4, 0x00098580);
+		regmap_write(afe->regmap, AFE_ASRC3_CON7, 0x0004c2c0);
+	} else if (rate == 16000) {
+		wideband = PCM_MODE_16K;
+		regmap_write(afe->regmap, AFE_ASRC2_CON1, 0x0004c2c0);
+		regmap_write(afe->regmap, AFE_ASRC2_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC2_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC2_CON4, 0x0004c2c0);
+		regmap_write(afe->regmap, AFE_ASRC2_CON7, 0x00026160);
+		regmap_write(afe->regmap, AFE_ASRC3_CON1, 0x0004c2c0);
+		regmap_write(afe->regmap, AFE_ASRC3_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC3_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC3_CON4, 0x0004c2c0);
+		regmap_write(afe->regmap, AFE_ASRC3_CON7, 0x00026160);
+	} else {
+		return -EINVAL;
+	}
+
+	val = (PCM_TX_LCH_RPT_NO_REPEAT << 13) |
+	      (PCM_VBT_16K_DISABLE << 12) |
+	      (PCM_BT_MODE_DUAL_MIC_ON_TX << 7) |
+	      (PCM_AFIFO_ASYNC_FIFO << 6) |
+	      (PCM_WLEN_16BIT << 5) |
+	      (wideband << 3) |
+	      (PCM_FMT_MODE_B << 1);
+
+	/* Afe_Set_Reg(PCM2_INTF_CON, val, MASK_ALL), :1742 */
+	regmap_write(afe->regmap, PCM2_INTF_CON, val);
+
+	return 0;
+}
+
+/*
+ * SetModemPcmConfig() for the external modem, mt_soc_afe_control.c:1786-1838:
+ * PCM_INTF_CON plus the ASRC/ASRC4 ratio registers.  Values are the
+ * Voice2IntPcm attributes of mt_soc_pcm_voice_md2.c:87-106 (mAsyncFifoSel
+ * stays Soc_Aud_BYPASS_SRC_SLAVE_USE_ASRC, the async FIFO assignment is
+ * commented out at mt_soc_pcm_voice_md2.c:298).
+ */
+static int mt6735_voice_md2_config(struct mtk_base_afe *afe, unsigned int rate)
+{
+	unsigned int wideband, val;
+
+	if (rate == 8000) {
+		wideband = PCM_MODE_8K;
+		regmap_write(afe->regmap, AFE_ASRC_CON1, 0x00065900);
+		regmap_write(afe->regmap, AFE_ASRC_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC_CON4, 0x00065900);
+		regmap_write(afe->regmap, AFE_ASRC_CON6, 0x007f188f);
+		regmap_write(afe->regmap, AFE_ASRC_CON7, 0x00032c80);
+		regmap_write(afe->regmap, AFE_ASRC4_CON1, 0x00065900);
+		regmap_write(afe->regmap, AFE_ASRC4_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC4_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC4_CON4, 0x00065900);
+		regmap_write(afe->regmap, AFE_ASRC4_CON6, 0x007f188f);
+		regmap_write(afe->regmap, AFE_ASRC4_CON7, 0x00032c80);
+	} else if (rate == 16000) {
+		wideband = PCM_MODE_16K;
+		regmap_write(afe->regmap, AFE_ASRC_CON1, 0x00032c80);
+		regmap_write(afe->regmap, AFE_ASRC_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC_CON4, 0x00032c80);
+		regmap_write(afe->regmap, AFE_ASRC_CON6, 0x007f188f);
+		regmap_write(afe->regmap, AFE_ASRC_CON7, 0x00019640);
+		regmap_write(afe->regmap, AFE_ASRC4_CON1, 0x00032c80);
+		regmap_write(afe->regmap, AFE_ASRC4_CON2, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC4_CON3, 0x00400000);
+		regmap_write(afe->regmap, AFE_ASRC4_CON4, 0x00032c80);
+		regmap_write(afe->regmap, AFE_ASRC4_CON6, 0x007f188f);
+		regmap_write(afe->regmap, AFE_ASRC4_CON7, 0x00019640);
+	} else {
+		return -EINVAL;
+	}
+
+	val = (0 << 22) |				/* mBclkOutInv = false */
+	      (PCM_TX_LCH_RPT_NO_REPEAT << 19) |
+	      (PCM_VBT_16K_DISABLE << 18) |
+	      (PCM_EXT_MODEM_INTERNAL << 17) |
+	      (0 << 9) |				/* mExtendBckSyncLength = 0 */
+	      (PCM_SYNC_ONE_BCK_CYCLE << 8) |
+	      (PCM_BT_MODE_DUAL_MIC_ON_TX << 7) |
+	      (PCM_AFIFO_ASRC << 6) |
+	      (PCM_CLOCK_SLAVE << 5) |
+	      (wideband << 3) |
+	      (PCM_FMT_MODE_B << 1);
+
+	/* Afe_Set_Reg(PCM_INTF_CON, val, MASK_ALL), :1838 */
+	regmap_write(afe->regmap, PCM_INTF_CON, val);
+
+	return 0;
+}
+
+/*
+ * SetModemPcmEnable(), mt_soc_afe_control.c:1845-1886.  MODEM_1 only flips
+ * PCM2_INTF_CON bit 0; the external modem also enables the ASRC blocks on
+ * start and tears them down on stop.
+ */
+static int mt6735_voice_modem_enable(struct mtk_base_afe *afe,
+				     enum mt6735_voice_kind kind, bool enable)
+{
+	unsigned int pcm1_afifo;
+
+	if (kind == MT6735_VOICE_MD1 || kind == MT6735_VOICE_MD1_BT) {
+		regmap_update_bits(afe->regmap, PCM2_INTF_CON, PCM2_INTF_CON_EN,
+				   enable ? PCM2_INTF_CON_EN : 0);
+		return 0;
+	}
+
+	if (enable) {
+		int ret;
+
+		regmap_update_bits(afe->regmap, PCM_INTF_CON2,
+				   PCM_INTF_CON2_MD3_SEL,
+				   PCM_INTF_CON2_MD3_SEL);
+		/*
+		 * The external modem PCM runs through the ASRC unless the
+		 * interface was configured for the async FIFO; the voice path
+		 * sets mAsyncFifoSel = ASRC, so this is the branch taken.
+		 */
+		ret = regmap_read(afe->regmap, PCM_INTF_CON, &pcm1_afifo);
+		if (ret)
+			return ret;
+		if (!(pcm1_afifo & PCM_INTF_CON_BYP_ASRC)) {
+			regmap_write(afe->regmap, AFE_ASRC_CON0, 0x86083031);
+			regmap_write(afe->regmap, AFE_ASRC4_CON0, 0x06003031);
+		}
+		regmap_update_bits(afe->regmap, PCM_INTF_CON, PCM_INTF_CON_EN,
+				   PCM_INTF_CON_EN);
+		return 0;
+	}
+
+	regmap_update_bits(afe->regmap, PCM_INTF_CON, PCM_INTF_CON_EN, 0);
+	regmap_write(afe->regmap, AFE_ASRC_CON6, 0);
+	regmap_update_bits(afe->regmap, AFE_ASRC_CON0,
+			   BIT(4) | BIT(5) | BIT(0), 0);
+	regmap_update_bits(afe->regmap, AFE_ASRC_CON0, BIT(0), 0);
+	regmap_write(afe->regmap, AFE_ASRC4_CON6, 0);
+	regmap_update_bits(afe->regmap, AFE_ASRC4_CON0, BIT(4) | BIT(5), 0);
+	regmap_update_bits(afe->regmap, AFE_ASRC4_CON0, BIT(0), 0);
+
+	return 0;
+}
+
+/*
+ * SetDaiBt()/SetDaiBtEnable(), mt_soc_afe_control.c:1207-1258.  The merge
+ * interface is brought up once (this port has no other MRGIF user) and the
+ * DAI_BT block is fed from it; the BT mode comes from the stream rate
+ * (mt_soc_pcm_voice_md1_bt.c:265-276, mt_soc_pcm_bt_dai.c:104-115).
+ */
+static int mt6735_voice_daibt_config(struct mtk_base_afe *afe,
+				     unsigned int rate)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int mode;
+
+	if (rate == 8000)
+		mode = AFE_DAIBT_MODE_8K;
+	else if (rate == 16000)
+		mode = AFE_DAIBT_MODE_16K;
+	else
+		return -EINVAL;
+
+	if (!priv->daibt_merge_on) {
+		regmap_update_bits(afe->regmap, AFE_MRGIF_CON,
+				   AFE_MRGIF_CON_FS_MASK <<
+				   AFE_MRGIF_CON_FS_SHIFT,
+				   MT6735_MRGIF_FS_44K <<
+				   AFE_MRGIF_CON_FS_SHIFT);
+		regmap_update_bits(afe->regmap, AFE_MRGIF_CON,
+				   AFE_MRGIF_CON_I2S_EN, AFE_MRGIF_CON_I2S_EN);
+		regmap_update_bits(afe->regmap, AFE_MRGIF_CON,
+				   AFE_MRGIF_CON_EN, AFE_MRGIF_CON_EN);
+		udelay(100);
+		priv->daibt_merge_on = true;
+	}
+
+	regmap_update_bits(afe->regmap, AFE_DAIBT_CON0,
+			   BIT(AFE_DAIBT_CON0_MODE_SHIFT) |
+			   AFE_DAIBT_CON0_USE_MERGE |
+			   AFE_DAIBT_CON0_DATA_READY,
+			   (mode << AFE_DAIBT_CON0_MODE_SHIFT) |
+			   AFE_DAIBT_CON0_USE_MERGE |
+			   AFE_DAIBT_CON0_DATA_READY);
+
+	return 0;
+}
+
+/*
+ * The DAI_BT / BT SCO "on" state is AFE_DAIBT_CON0 bits 1:0,
+ * mt_soc_afe_control.c:1229,1238.  Tearing down the merge interface when the
+ * last DAI_BT user stops mirrors mt_soc_afe_control.c:1244-1252.
+ */
+static void mt6735_voice_daibt_enable(struct mtk_base_afe *afe, bool enable)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	if (enable) {
+		regmap_update_bits(afe->regmap, AFE_DAIBT_CON0,
+				   AFE_DAIBT_CON0_EN, AFE_DAIBT_CON0_EN);
+		priv->daibt_users++;
+		return;
+	}
+
+	if (!priv->daibt_users)
+		return;
+
+	if (--priv->daibt_users)
+		return;
+
+	regmap_update_bits(afe->regmap, AFE_DAIBT_CON0, AFE_DAIBT_CON0_EN, 0);
+	udelay(100);
+	regmap_update_bits(afe->regmap, AFE_MRGIF_CON, AFE_MRGIF_CON_I2S_EN, 0);
+	regmap_update_bits(afe->regmap, AFE_MRGIF_CON, AFE_MRGIF_CON_EN, 0);
+	priv->daibt_merge_on = false;
+}
+
+/*
+ * SetMemoryPathEnable(MEM_DAI, ...), mt_soc_afe_control.c:1968-2000.  This is
+ * the same register bit the memory interface descriptors use
+ * (mt6735-afe-pcm.c), the helper exists because mt6735_afe_memif_enable() is
+ * private to mt6735-dai-pcm.c.
+ */
+static void mt6735_voice_memif_dai_enable(struct mtk_base_afe *afe, bool enable)
+{
+	const struct mtk_base_memif_data *data =
+		afe->memif[MT6735_AFE_MEMIF_DAI].data;
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int bit = BIT(data->enable_shift);
+
+	regmap_update_bits(afe->regmap, data->enable_reg, bit,
+			   enable ? bit : 0);
+	priv->memif_enabled[MT6735_AFE_MEMIF_DAI] = enable;
+	mt6735_afe_update_power(afe);
+}
+
+static int mt6735_voice_startup(struct snd_pcm_substream *substream,
+				struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_voice_state *st = mt6735_voice_state(afe, dai->id);
+	enum mt6735_voice_kind kind = mt6735_voice_kind(dai->id);
+	const struct snd_pcm_hardware *hw;
+	int ret;
+
+	hw = mt6735_voice_pcm_hardware(kind);
+
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		return ret;
+	}
+
+	if (!st->users) {
+		st->rate = 0;
+		st->prepared = false;
+		st->running = false;
+	}
+	st->users++;
+
+	snd_soc_set_runtime_hwparams(substream, hw);
+
+	ret = snd_pcm_hw_constraint_integer(substream->runtime,
+					    SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		goto err_put;
+
+	if (kind == MT6735_VOICE_DAIBT) {
+		/*
+		 * The memory interface consumes whole 64 byte blocks
+		 * (Align64ByteSize(), mt_soc_afe_control.c:3702-3710).
+		 */
+		ret = snd_pcm_hw_constraint_step(substream->runtime, 0,
+						 SNDRV_PCM_HW_PARAM_BUFFER_BYTES,
+						 64);
+		if (ret < 0)
+			goto err_put;
+
+		afe->memif[MT6735_AFE_MEMIF_DAI].substream = substream;
+	}
+
+	return 0;
+
+err_put:
+	st->users--;
+	pm_runtime_put_noidle(afe->dev);
+	return ret;
+}
+
+static void mt6735_voice_shutdown(struct snd_pcm_substream *substream,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_voice_state *st = mt6735_voice_state(afe, dai->id);
+	enum mt6735_voice_kind kind = mt6735_voice_kind(dai->id);
+
+	if (!st->users)
+		return;
+
+	if (!--st->users) {
+		if (kind == MT6735_VOICE_DAIBT ||
+		    kind == MT6735_VOICE_MD1_BT ||
+		    kind == MT6735_VOICE_MD2_BT) {
+			mt6735_voice_daibt_enable(afe, false);
+		}
+		if (kind != MT6735_VOICE_DAIBT)
+			mt6735_voice_modem_enable(afe, kind, false);
+
+		/* mtk_voice_close()/mtk_voice_md2_close() :219-236 / :212-229 */
+		mt6735_voice_connect(afe, kind, false);
+
+		if (kind == MT6735_VOICE_MD1 || kind == MT6735_VOICE_MD2)
+			mt6735_voice_codec_off(afe);
+
+		if (kind == MT6735_VOICE_DAIBT) {
+			mt6735_voice_memif_dai_enable(afe, false);
+			afe->memif[MT6735_AFE_MEMIF_DAI].substream = NULL;
+			mt6735_afe_irq_update(afe, MT6735_AFE_IRQ2);
+		}
+
+		mt6735_voice_afe_enable(afe, false);
+
+		st->rate = 0;
+		st->prepared = false;
+		st->running = false;
+	}
+
+	pm_runtime_put(afe->dev);
+}
+
+/* Reject everything the voice / BT SCO interfaces cannot represent. */
+static int mt6735_voice_check_params(struct snd_pcm_hw_params *params)
+{
+	unsigned int rate = params_rate(params);
+
+	if (rate != 8000 && rate != 16000)
+		return -EINVAL;
+
+	if (params_channels(params) != 1)
+		return -EINVAL;
+
+	if (params_format(params) != SNDRV_PCM_FORMAT_S16_LE)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int mt6735_voice_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_voice_state *st = mt6735_voice_state(afe, dai->id);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int ret;
+
+	ret = mt6735_voice_check_params(params);
+	if (ret)
+		return ret;
+
+	st->rate = params_rate(params);
+
+	if (mt6735_voice_kind(dai->id) != MT6735_VOICE_DAIBT)
+		return 0;
+
+	if (!runtime->dma_bytes || !runtime->dma_addr)
+		return -EINVAL;
+
+	/* The memory interfaces only decode 32 bit addresses, AudDrv_Afe.h:470 */
+	if (upper_32_bits(runtime->dma_addr))
+		return -EINVAL;
+
+	/* SetDAIBuffer(), mt_soc_pcm_bt_dai.c:228-240 */
+	regmap_write(afe->regmap, AFE_DAI_BASE,
+		     lower_32_bits(runtime->dma_addr));
+	regmap_write(afe->regmap, AFE_DAI_END,
+		     lower_32_bits(runtime->dma_addr) + runtime->dma_bytes - 1);
+
+	/* SetSampleRate(MEM_DAI), mt_soc_afe_control.c:1099-1112 */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0,
+			   AFE_DAC_CON0_DAI_FS_MASK << AFE_DAC_CON0_DAI_FS_SHIFT,
+			   ((st->rate == 8000 ? AFE_DAI_FS_8K : AFE_DAI_FS_16K)
+			    << AFE_DAC_CON0_DAI_FS_SHIFT));
+
+	/* SetMemIfFetchFormatPerSample(MEM_DAI, 16 bit), :2343-2346 */
+	regmap_update_bits(afe->regmap, AFE_MEMIF_PBUF_SIZE,
+			   AFE_MEMIF_PBUF_FMT_MASK << AFE_MEMIF_PBUF_DAI_FMT_SHIFT,
+			   AFE_WLEN_16_BIT << AFE_MEMIF_PBUF_DAI_FMT_SHIFT);
+
+	return 0;
+}
+
+static int mt6735_voice_prepare(struct snd_pcm_substream *substream,
+				struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_voice_state *st = mt6735_voice_state(afe, dai->id);
+	enum mt6735_voice_kind kind = mt6735_voice_kind(dai->id);
+	bool codec_path = (kind == MT6735_VOICE_MD1 || kind == MT6735_VOICE_MD2);
+	bool afe_on = false;
+	int ret;
+
+	if (st->prepared && st->prepared_rate == st->rate)
+		return 0;
+
+	if (!st->rate)
+		return -EINVAL;
+
+	if (st->prepared) {
+		/* The rate changed while the DAI stayed open: reprogram. */
+		mt6735_voice_connect(afe, kind, false);
+		if (codec_path)
+			mt6735_voice_codec_off(afe);
+		mt6735_voice_afe_enable(afe, false);
+		st->prepared = false;
+	}
+
+	mt6735_voice_connect(afe, kind, true);
+
+	/*
+	 * Order of mtk_voice1_prepare()/mtk_voice_md2_prepare(),
+	 * mt_soc_pcm_voice_md1.c:284-300 / mt_soc_pcm_voice_md2.c:268-300:
+	 * codec downlink/uplink, EnableAfe(), then the modem PCM attributes.
+	 * The BT variants (mt_soc_pcm_voice_md1_bt.c:257-284) configure the
+	 * DAI_BT block instead of the codec, and the DAI_BT PCM
+	 * (mt_soc_pcm_bt_dai.c:119-147) has no AFE power call of its own.
+	 */
+	if (codec_path) {
+		ret = mt6735_voice_dac_on(afe, st->rate);
+		if (ret)
+			goto err_disconnect;
+		ret = mt6735_voice_adc_on(afe, st->rate);
+		if (ret)
+			goto err_disconnect;
+	} else
+		ret = mt6735_voice_daibt_config(afe, st->rate);
+
+	if (ret)
+		goto err_disconnect;
+
+	if (kind != MT6735_VOICE_DAIBT) {
+		mt6735_voice_afe_enable(afe, true);
+		afe_on = true;
+	}
+
+	if (kind != MT6735_VOICE_DAIBT) {
+		if (kind == MT6735_VOICE_MD2)
+			ret = mt6735_voice_md2_config(afe, st->rate);
+		else
+			ret = mt6735_voice_md1_config(afe, st->rate);
+		if (ret)
+			goto err_afe;
+	}
+
+	st->prepared_rate = st->rate;
+	st->prepared = true;
+
+	return 0;
+
+err_afe:
+	if (afe_on)
+		mt6735_voice_afe_enable(afe, false);
+err_disconnect:
+	mt6735_voice_connect(afe, kind, false);
+	return ret;
+}
+
+static int mt6735_voice_trigger(struct snd_pcm_substream *substream, int cmd,
+				struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_voice_state *st = mt6735_voice_state(afe, dai->id);
+	enum mt6735_voice_kind kind = mt6735_voice_kind(dai->id);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (!st->prepared)
+			return -EINVAL;
+		if (st->running)
+			return 0;
+
+		if (kind == MT6735_VOICE_DAIBT) {
+			mt6735_voice_memif_dai_enable(afe, true);
+			mt6735_voice_daibt_enable(afe, true);
+			mt6735_afe_irq_update(afe, MT6735_AFE_IRQ2);
+		} else if (kind == MT6735_VOICE_MD1_BT ||
+			   kind == MT6735_VOICE_MD2_BT) {
+			mt6735_voice_daibt_enable(afe, true);
+			mt6735_voice_modem_enable(afe, kind, true);
+		} else {
+			mt6735_voice_modem_enable(afe, kind, true);
+		}
+
+		st->running = true;
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		if (!st->running)
+			return 0;
+
+		if (kind == MT6735_VOICE_DAIBT) {
+			mt6735_voice_daibt_enable(afe, false);
+			mt6735_voice_memif_dai_enable(afe, false);
+			mt6735_afe_irq_update(afe, MT6735_AFE_IRQ2);
+		} else if (kind == MT6735_VOICE_MD1_BT ||
+			   kind == MT6735_VOICE_MD2_BT) {
+			mt6735_voice_modem_enable(afe, kind, false);
+			mt6735_voice_daibt_enable(afe, false);
+		} else {
+			mt6735_voice_modem_enable(afe, kind, false);
+		}
+
+		st->running = false;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_voice_ops = {
+	.startup = mt6735_voice_startup,
+	.shutdown = mt6735_voice_shutdown,
+	.hw_params = mt6735_voice_hw_params,
+	.prepare = mt6735_voice_prepare,
+	.trigger = mt6735_voice_trigger,
+};
+
+/*
+ * Voice / BT SCO DAI drivers.  The array order and the .id values must match
+ * the id block in mt6735-afe-common.h, mt6735-afe-pcm.c copies it right after
+ * MT6735_AFE_DAI_I2S0.
+ *
+ * The modem PCM interface is shared by both directions, so the rate, channel
+ * count and sample width are symmetric.  8 kHz is narrow band and 16 kHz is
+ * wide band; both are mono S16_LE.
+ */
+const struct snd_soc_dai_driver mt6735_afe_voice_dais[MT6735_AFE_VOICE_DAI_NUM] = {
+	{
+		.name = "mt-soc-btcvsd-dai",
