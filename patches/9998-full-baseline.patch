diff --git a/include/uapi/linux/aee.h b/include/uapi/linux/aee.h
new file mode 100644
index 000000000..6a25ee58c
--- /dev/null
+++ b/include/uapi/linux/aee.h
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * MediaTek AEE/AED exception ("DB") client ABI.
+ *
+ * The values, message layout and ioctl numbers are copied from the
+ * Samsung/MTK 3.18 downstream GPL tree that matches the SM-G532M ROM:
+ *
+ *   drivers/misc/mediatek/aee/aed/aed.h:39-167
+ *     - AE_INVALID/AE_NOT_AVAILABLE/AE_DEFAULT : :39-41
+ *     - enum AEE_MODE                          : :43-49
+ *     - enum AE_PASS_METHOD                    : :58-61
+ *     - enum AE_CMD_TYPE                       : :63
+ *     - enum AE_CMD_ID                         : :65-108
+ *     - struct AE_Msg                          : :110-125
+ *     - struct aee_ioctl                       : :141-148
+ *     - AEEIOCTL_*                             : :151-161
+ *   drivers/misc/mediatek/aee/aed/aed.h:147-149 (AEE_NR_FRAME)
+ *   drivers/misc/mediatek/include/mt-plat/aee.h:65-107 (aee_bt_frame,
+ *     aee_process_bt, aee_thread_reg)
+ *
+ * Original copyright: Copyright (C) 2015 MediaTek Inc., GPL-2.0.
+ *
+ * The client library shipped in the ROM (/lib/libaed.so, ELF32 ARM) talks
+ * to the AED daemon over the abstract socket "com.mtk.aee.aed" and uses
+ * exactly one ioctl on /dev/aed0: AEEIOCTL_GET_THREAD_REG, requested with
+ * both the 296-byte (64-bit pt_regs) and the 76-byte (32-bit pt_regs)
+ * command encoding (libaed.so: aee_ioctl_get_reg, file offset 0x4674).
+ */
+#ifndef _UAPI_LINUX_AEE_H
+#define _UAPI_LINUX_AEE_H
+
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+typedef uint32_t __u32;
+typedef uint64_t __u64;
+typedef int32_t __s32;
+#endif
+
+/* aed.h:39-41 */
+#define AE_INVALID		0xAEEFF000
+#define AE_NOT_AVAILABLE	0xAEE00000
+#define AE_DEFAULT		0xAEE00001
+
+/* aed.h:43-49 */
+enum AEE_MODE {
+	AEE_MODE_MTK_ENG = 1,
+	AEE_MODE_MTK_USER,
+	AEE_MODE_CUSTOMER_ENG,
+	AEE_MODE_CUSTOMER_USER,
+	AEE_MODE_NOT_INIT
+};
+
+/* aed.h:58-61 */
+enum AE_PASS_METHOD {
+	AE_PASS_BY_MEM,
+	AE_PASS_BY_FILE,
+	AE_PASS_METHOD_END
+};
+
+/* aed.h:63 */
+enum AE_CMD_TYPE { AE_REQ, AE_RSP, AE_IND, AE_CMD_TYPE_END };
+
+/*
+ * aed.h:65-108.  The numeric values are the ABI; keep the downstream names
+ * and order so the encoder used by the AED daemon/libaed stays compatible.
+ */
+enum AE_CMD_ID {
+	AE_REQ_IDX,
+
+	AE_REQ_CLASS,
+	AE_REQ_TYPE,
+	AE_REQ_PROCESS,
+	AE_REQ_MODULE,
+	AE_REQ_BACKTRACE,
+	AE_REQ_DETAIL,		/* Content of response message rule:
+				 *   if msg.arg1==AE_PASS_BY_FILE => msg->data=file path
+				 */
+
+	AE_REQ_ROOT_LOG_DIR,
+	AE_REQ_CURR_LOG_DIR,
+	AE_REQ_DFLT_LOG_DIR,
+	AE_REQ_MAIN_LOG_FILE_PATH,
+
+	AE_IND_FATAL_RAISED,	/* fatal event raised, indicate AED to notify users */
+	AE_IND_EXP_RAISED,	/* exception event raised, indicate AED to notify users */
+	AE_IND_WRN_RAISED,	/* warning event raised, indicate AED to notify users */
+	AE_IND_REM_RAISED,	/* reminding event raised, indicate AED to notify users */
+
+	AE_IND_LOG_STATUS,	/* arg = AE_ERR */
+	AE_IND_LOG_CLOSE,	/* arg = AE_ERR */
+
+	AE_REQ_SWITCH_DAL_BEEP,	/* arg: dal on|off, seq: beep on|off */
+	AE_REQ_DB_COUNT,	/* arg: db count */
+	AE_REQ_DB_FORCE_PATH,	/* arg: force db path yes\no */
+	AE_REQ_SWITCH_EXP_LEVEL,
+	AE_REQ_IS_AED_READY,	/* query if AED is ready for service */
+	AE_REQ_COREDUMP,	/* msg->data=file path */
+	AE_REQ_SET_READFLAG,	/* set read flag msg */
+	AE_REQ_E2S_INIT,	/* Init notification of client side(application layer) of Exp2Server */
+	AE_REQ_USERSPACEBACKTRACE = 40,
+	AE_REQ_USER_REG,
+	AE_REQ_USER_MAPS,
+	AE_CMD_ID_END
+};
+
+/* aed.h:110-125 (24 bytes on both ABIs) */
+struct AE_Msg {
+	__u32 cmdType;		/* enum AE_CMD_TYPE */
+	__u32 cmdId;		/* enum AE_CMD_ID */
+	union {
+		__u32 seq;	/* sequence number for error checking */
+		__s32 pid;	/* process id */
+	};
+	union {
+		__u32 arg;	/* simple argument */
+		__u32 cls;	/* enum AE_EXP_CLASS (int-plat/aee.h:33-53) */
+	};
+	union {
+		__u32 len;	/* dynamic length argument */
+		__s32 id;	/* desired id */
+	};
+	__u32 dbOption;		/* DB dump option, int-plat/aee.h:186-218 */
+};
+
+/* aed.h:130-140 -- kernel ioctl argument, aed.h:141-148 */
+struct aee_ioctl {
+	__u32 pid;
+	__u32 detail;
+	__u32 size;
+	__u32 pad;
+	__u64 in;
+	__u64 out;
+};
+
+/*
+ * aed.h:87-90 (32-bit kernel ABI: pid_t is 4 bytes) and
+ * include/mt-plat/aee.h:65-85 (struct aee_bt_frame is 256 bytes: two u64,
+ * five u32 of padding and two symbol strings).
+ */
+#define AEE_NR_FRAME		32
+#define AEE_SZ_SYMBOL_S		80
+#define AEE_SZ_SYMBOL_L		140
+
+struct aee_bt_frame {
+	__u64 pc;
+	__u64 lr;
+	__u32 pad[5];
+	char pc_symbol[AEE_SZ_SYMBOL_S];
+	char lr_symbol[AEE_SZ_SYMBOL_L];
+};
+
+/*
+ * include/mt-plat/aee.h:87-90: pid_t tid + struct pt_regs.  The client library
+ * requests the 32-bit view as a 76-byte payload (_IOW('p', 0x07, 76), see
+ * libaed.so aee_ioctl_get_reg) and the 64-bit view as a 296-byte payload
+ * (_IOW('p', 0x07, 296); 4-byte tid + 4 bytes padding + a 288-byte 3.18/4.x
+ * arm64 pt_regs: 34 u64 of user_pt_regs, orig_x0, syscallno).
+ */
+struct aee_thread_reg {
+	__s32 tid;
+	__u32 regs[18];		/* arm32 struct pt_regs: uregs[0..17] */
+};
+
+struct aee_thread_reg64 {
+	__s32 tid;
+	__u32 pad;
+	__u64 regs[36];
+};
+
+/*
+ * aed.h:151-161, expanded with the uapi struct sizes above.  The literal
+ * values are asserted against _IOW()/_IOR() in the kernel driver
+ * (drivers/misc/mediatek/aee/aed-main.c) because this header must not
+ * depend on <linux/ioctl.h> when it is compiled for the host tool.
+ */
+#define AEEIOCTL_DAL_SHOW		0x44007001	/* _IOW('p', 0x01, struct aee_dal_show[1024]) */
+#define AEEIOCTL_DAL_CLEAN		0x00007002	/* _IO('p', 0x02) */
+#define AEEIOCTL_SETCOLOR		0x400c7003	/* _IOW('p', 0x03, struct aee_dal_setcolor[12]) */
+#define AEEIOCTL_GET_PROCESS_BT		0x40207004	/* _IOW('p', 0x04, struct aee_ioctl[32]) */
+#define AEEIOCTL_GET_SMP_INFO		0x80047005	/* _IOR('p', 0x05, int) */
+#define AEEIOCTL_SET_AEE_MODE		0x80047006	/* _IOR('p', 0x06, int) */
+#define AEEIOCTL_GET_THREAD_REG		0x404c7007	/* _IOW('p', 0x07, struct aee_thread_reg[76]) */
+#define AEEIOCTL_GET_THREAD_REG64	0x41287007	/* _IOW('p', 0x07, struct aee_thread_reg64[296]) */
+#define AEEIOCTL_CHECK_SUID_DUMPABLE	0x80047008	/* _IOR('p', 0x08, int) */
+#define AEEIOCTL_WDT_KICK_POWERKEY	0x80047009	/* _IOR('p', 0x09, int) */
+#define AEEIOCTL_RT_MON_Kick		0x8004700a	/* _IOR('p', 0x0A, int) */
+#define AEEIOCTL_SET_FORECE_RED_SCREEN	0x8004700b	/* _IOR('p', 0x0B, int) */
+#define AEEIOCTL_SET_SF_STATE		0x8008700c	/* _IOR('p', 0x0C, long long[8]) */
+#define AEEIOCTL_GET_SF_STATE		0x4008700d	/* _IOW('p', 0x0D, long long[8]) */
+#define AEEIOCTL_USER_IOCTL_TO_KERNEL_WANING 0x8004700e	/* _IOR('p', 0x0E, int) */
+
+#endif /* _UAPI_LINUX_AEE_H */
diff --git a/include/uapi/linux/mtk_fm_i2s.h b/include/uapi/linux/mtk_fm_i2s.h
new file mode 100644
index 000000000..31c0bac4b
--- /dev/null
+++ b/include/uapi/linux/mtk_fm_i2s.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * MediaTek WCN FM radio - MT6627 I2S control ABI.
+ *
+ * Port from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/fmradio/inc/fm_interface.h:59-90
+ *   drivers/misc/mediatek/fmradio/inc/fm_ioctl.h:19-20,70,81
+ *   drivers/misc/mediatek/fmradio/core/fm_module.c:294-315,735-757
+ *
+ * The two ioctls carry a 12 byte payload made of three little endian 32 bit
+ * words.  Downstream declares the command with a pointer type in _IOWR()
+ * ("struct fm_i2s_setting *"), so its 32-bit command word encodes
+ * _IOC_SIZE == 4 even though twelve bytes are transferred; the kernel driver
+ * copies the full structure itself.  The __u32 payload type below reproduces
+ * that command word on both 32-bit and 64-bit builds, which keeps the ABI of
+ * the shipped 32-bit ROM.
+ */
+
+#ifndef _UAPI_LINUX_MTK_FM_I2S_H
+#define _UAPI_LINUX_MTK_FM_I2S_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* fm_interface.h:59-63 */
+struct fm_i2s_setting {
+	__s32 onoff;		/* fm_i2s_state_e */
+	__s32 mode;		/* fm_i2s_mode_e */
+	__s32 sample;		/* fm_i2s_sample_e */
+};
+
+/* fm_interface.h:82-87 */
+struct fm_i2s_info {
+	__s32 status;		/* fm_i2s_state_e, FM_I2S_STATE_ERR on error */
+	__s32 mode;		/* fm_i2s_mode_e, FM_I2S_MODE_ERR on error */
+	__s32 rate;		/* fm_i2s_sample_e, FM_I2S_SR_ERR on error */
+};
+
+/* fm_interface.h:64-68 */
+#define FM_I2S_ON		0
+#define FM_I2S_OFF		1
+#define FM_I2S_STATE_ERR	2
+
+/* fm_interface.h:70-74 */
+#define FM_I2S_MASTER		0
+#define FM_I2S_SLAVE		1
+#define FM_I2S_MODE_ERR		2
+
+/* fm_interface.h:76-80 */
+#define FM_I2S_32K		0
+#define FM_I2S_44K		1
+#define FM_I2S_48K		2
+#define FM_I2S_SR_ERR		3
+
+/* fm_ioctl.h:19-20,70,81 */
+#define FM_IOC_MAGIC		0xf5
+#define FM_IOCTL_I2S_SETTING	_IOWR(FM_IOC_MAGIC, 33, __u32)
+#define FM_IOCTL_GET_I2S_INFO	_IOWR(FM_IOC_MAGIC, 41, __u32)
+
+#endif /* _UAPI_LINUX_MTK_FM_I2S_H */
diff --git a/include/uapi/linux/mtk_fm_rds.h b/include/uapi/linux/mtk_fm_rds.h
new file mode 100644
index 000000000..81151cc8a
--- /dev/null
+++ b/include/uapi/linux/mtk_fm_rds.h
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * MediaTek WCN FM radio - raw RDS record ABI.
+ *
+ * The driver exposes the raw RDS group stream of the MT6627 firmware through
+ * read() on the V4L2 radio device (VFL_TYPE_RADIO, /dev/radio0).  This header
+ * is the single source of truth for that byte layout; the driver uses the
+ * same definitions, so the ABI cannot drift from the implementation.
+ *
+ * Record stream
+ * -------------
+ * Every read() returns one or more whole records of
+ * sizeof(struct mtk_wcn_fm_rds_data), which is MTK_FM_RDS_RECORD_SIZE bytes.
+ * The read size must therefore be at least one record and should be a
+ * multiple of it:
+ *
+ *   - count < sizeof(struct mtk_wcn_fm_rds_data)	-> -EINVAL
+ *   - count >= sizeof(struct mtk_wcn_fm_rds_data)	-> 0 < n*148 <= count
+ *
+ * A short read never happens for a partial record: the driver always copies
+ * a whole number of records.  A read() on an empty FIFO blocks until an RDS
+ * record arrives, unless the file was opened with O_NONBLOCK, in which case
+ * it returns -EWOULDBLOCK.  poll() reports EPOLLIN | EPOLLRDNORM when at
+ * least one record is queued; when the chip is powered down, blocked readers
+ * wake up and read() returns -EIO (poll() sets EPOLLHUP).
+ *
+ * Record contents
+ * ---------------
+ * Each record starts with the two demodulator samples (sin, cos), which the
+ * firmware emits for every RDS event and which carry no RDS data.  They are
+ * followed by MTK_FM_RDS_GROUP_COUNT group slots filled from the firmware
+ * event payload in order.  The event payload may hold fewer groups than the
+ * fixed record size: the driver zero-fills the rest of the record, so unused
+ * slots hold all-zero blocks with crc == 0.  Because a received group always
+ * has at least its B block marked good (see below), a slot with crc == 0 can
+ * be recognised as "no group here" and skipped.
+ *
+ * RDS data arrives with one record per firmware RDS_RX_DATA event; the
+ * sequence number of the record inside the stream is not part of the ABI.
+ *
+ * Validity
+ * --------
+ * The firmware does not deliver a separate validity flag.  Instead the crc
+ * word is a good-block bitmap, one bit per block, set when the block passed
+ * the RDS checkword check (and, for corrected blocks, was repaired):
+ *
+ *	bit 3 (0x08)	block A (PI)
+ *	bit 2 (0x04)	block B (group type, TP, PTY, ...)
+ *	bit 1 (0x02)	block C
+ *	bit 0 (0x01)	block D
+ *
+ * Only groups whose B block is marked good carry a usable group type; the
+ * other blocks are optional depending on the group version.  The cbc word is
+ * the firmware's count of corrected bits for the group.  These semantics are
+ * the ones the downstream driver relies on (fm_rds_parser.c:122-143,
+ * 209-243); this interface passes them through unchanged.
+ *
+ * Note that group 0B/1B/2B/... repeat the PI code in block C (offset C'),
+ * which is an ordinary block C value on the wire.
+ */
+
+#ifndef _UAPI_LINUX_MTK_FM_RDS_H
+#define _UAPI_LINUX_MTK_FM_RDS_H
+
+#include <linux/types.h>
+
+/** Number of RDS group slots in one record. */
+#define MTK_FM_RDS_GROUP_COUNT		12
+
+/** Size of one raw RDS record as returned by read(). */
+#define MTK_FM_RDS_RECORD_SIZE		148
+
+/** Good-block bits in &struct mtk_wcn_fm_rds_block.crc. */
+#define MTK_FM_RDS_BLOCK_A_OK		0x0008
+#define MTK_FM_RDS_BLOCK_B_OK		0x0004
+#define MTK_FM_RDS_BLOCK_C_OK		0x0002
+#define MTK_FM_RDS_BLOCK_D_OK		0x0001
+
+/**
+ * struct mtk_wcn_fm_rds_block - one RDS group as delivered by the firmware
+ * @blk_a: block A, the programme identification (PI) code
+ * @blk_b: block B, group type/version, TP, PTY and group specific bits
+ * @blk_c: block C, group specific (PI in version B groups, offset C')
+ * @blk_d: block D, group specific
+ * @cbc: firmware count of corrected bits for the group
+ * @crc: good-block bitmap, see MTK_FM_RDS_BLOCK_*_OK
+ *
+ * Mirrors downstream rds_packet_t (inc/fm_rds.h:32-39).
+ */
+struct mtk_wcn_fm_rds_block {
+	__u16 blk_a;
+	__u16 blk_b;
+	__u16 blk_c;
+	__u16 blk_d;
+	__u16 cbc;
+	__u16 crc;
+};
+
+/**
+ * struct mtk_wcn_fm_rds_data - one raw RDS record returned by read()
+ * @sin: demodulator sample, not RDS data
+ * @cos: demodulator sample, not RDS data
+ * @group: group slots, filled in firmware order and zero-filled when unused
+ *
+ * Mirrors downstream rds_rx_t (inc/fm_rds.h:41-45).  The record is exactly
+ * MTK_FM_RDS_RECORD_SIZE (148) bytes.
+ */
+struct mtk_wcn_fm_rds_data {
+	__u16 sin;
+	__u16 cos;
+	struct mtk_wcn_fm_rds_block group[MTK_FM_RDS_GROUP_COUNT];
+};
+
+#endif /* _UAPI_LINUX_MTK_FM_RDS_H */
diff --git a/include/uapi/linux/mtk_isp.h b/include/uapi/linux/mtk_isp.h
new file mode 100644
index 000000000..4a0586ddb
--- /dev/null
+++ b/include/uapi/linux/mtk_isp.h
@@ -0,0 +1,705 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * MediaTek MT6735 camera ISP userspace ABI.
+ *
+ * Ported from the Samsung/MediaTek downstream GPL kernel header
+ * drivers/misc/mediatek/cameraisp/src/mt6735/inc/camera_isp_D1.h
+ * (MTK proprietary notice: Copyright (C) 2015 MediaTek Inc., GPL-2.0).
+ *
+ * The ioctl command numbers, enumeration values, structure layouts and
+ * semantics are kept identical to the downstream "libcamdrv" ABI so that a
+ * ported camera userspace stack keeps working.  The only deliberate change
+ * is that user-space pointers inside the structures are declared as __u64
+ * instead of "pointer" types.  This makes the ABI independent of the
+ * userspace pointer size: the kernel this header targets is arm64, while the
+ * downstream ABI was compiled for 32-bit ARM.  A 32-bit client may still use
+ * this header because the pointer fields keep their 8-byte layout.
+ *
+ * The kernel side of the ABI is delivered by
+ * drivers/media/platform/mediatek/isp/mtk-isp.c, which registers the
+ * misc character device documented by MTK_ISP_DEV_NAME below.
+ */
+
+#ifndef _UAPI_LINUX_MTK_ISP_H
+#define _UAPI_LINUX_MTK_ISP_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* Downstream ISP_DEV_NAME, camera_isp_D1.c:116 */
+#define MTK_ISP_DEV_NAME		"camera-isp"
+
+/* Downstream ISP_MAGIC, camera_isp_D1.h */
+#define MTK_ISP_MAGIC			'k'
+
+/*
+ * mmap(2): the page offset is the physical base address of one of the
+ * register windows below.  This is the downstream ISP_mmap() contract
+ * (camera_isp_D1.c:11263-11335).  Only these windows and their exact lengths
+ * are accepted.
+ */
+#define MTK_ISP_MMAP_IMGSYS		0x15000000
+#define MTK_ISP_MMAP_IMGSYS_SIZE	0x10000
+#define MTK_ISP_MMAP_ISP		0x15004000
+#define MTK_ISP_MMAP_ISP_SIZE		0x4000		/* ISP base 0x15004000..0x15007fff */
+#define MTK_ISP_MMAP_SENINF		0x15008000
+#define MTK_ISP_MMAP_SENINF_SIZE	0x4000
+#define MTK_ISP_MMAP_MIPIRX_CFG		0x1500c000
+#define MTK_ISP_MMAP_MIPIRX_CFG_SIZE	0x1000
+#define MTK_ISP_MMAP_ISP_INNER		0x1500d000
+#define MTK_ISP_MMAP_ISP_INNER_SIZE	0x1000
+#define MTK_ISP_MMAP_PLL		0x10000000
+#define MTK_ISP_MMAP_PLL_SIZE		0x1000
+#define MTK_ISP_MMAP_GPIO		0x10211000
+#define MTK_ISP_MMAP_GPIO_SIZE		0x1000
+#define MTK_ISP_MMAP_MIPIRX_ANA		0x10215000
+#define MTK_ISP_MMAP_MIPIRX_ANA_SIZE	0x3000
+
+/* ------------------------------------------------------------------ */
+/* Interrupt status bits (camera_isp_D1.h)                            */
+/* ------------------------------------------------------------------ */
+
+/* CAM_CTL_INT_P1_STATUS */
+#define ISP_IRQ_P1_STATUS_VS1_INT_ST			(1U << 0)
+#define ISP_IRQ_P1_STATUS_TG1_INT1_ST			(1U << 1)
+#define ISP_IRQ_P1_STATUS_TG1_INT2_ST			(1U << 2)
+#define ISP_IRQ_P1_STATUS_EXPDON1_ST			(1U << 3)
+#define ISP_IRQ_P1_STATUS_TG1_ERR_ST			(1U << 4)
+#define ISP_IRQ_P1_STATUS_TG1_GBERR			(1U << 5)
+#define ISP_IRQ_P1_STATUS_CQ0_ERR			(1U << 6)
+#define ISP_IRQ_P1_STATUS_CQ0_VS_ERR_ST			(1U << 7)
+#define ISP_IRQ_P1_STATUS_IMGO_DROP_FRAME_ST		(1U << 8)
+#define ISP_IRQ_P1_STATUS_RRZO_DROP_FRAME_ST		(1U << 9)
+#define ISP_IRQ_P1_STATUS_PASS1_DON_ST			(1U << 10)
+#define ISP_IRQ_P1_STATUS_SOF1_INT_ST			(1U << 12)
+#define ISP_IRQ_P1_STATUS_PESUDO_P1_DON_ST		(1U << 15)
+#define ISP_IRQ_P1_STATUS_AF_DON_ST			(1U << 16)
+#define ISP_IRQ_P1_STATUS_FLK_DON_ST			(1U << 17)
+#define ISP_IRQ_P1_STATUS_IMGO_ERR_ST			(1U << 20)
+#define ISP_IRQ_P1_STATUS_AAO_ERR_ST			(1U << 21)
+#define ISP_IRQ_P1_STATUS_LCSO_ERR_ST			(1U << 22)
+#define ISP_IRQ_P1_STATUS_RRZO_ERR_ST			(1U << 23)
+#define ISP_IRQ_P1_STATUS_ESFKO_ERR_ST			(1U << 24)
+#define ISP_IRQ_P1_STATUS_FLK_ERR_ST			(1U << 25)
+#define ISP_IRQ_P1_STATUS_LSC_ERR_ST			(1U << 26)
+#define ISP_IRQ_P1_STATUS_FBC_RRZO_DON_ST		(1U << 27)
+#define ISP_IRQ_P1_STATUS_FBC_IMGO_DON_ST		(1U << 28)
+#define ISP_IRQ_P1_STATUS_DMA_ERR_ST			(1U << 30)
+
+/* CAM_CTL_INT_P1_STATUS2 */
+#define ISP_IRQ_P1_STATUS2_IMGO_DONE_ST			(1U << 0)
+#define ISP_IRQ_P1_STATUS2_UFEO_DONE_ST			(1U << 1)
+#define ISP_IRQ_P1_STATUS2_RRZO_DONE_ST			(1U << 2)
+#define ISP_IRQ_P1_STATUS2_ESFKO_DONE_ST		(1U << 3)
+#define ISP_IRQ_P1_STATUS2_LCSO_DONE_ST			(1U << 4)
+#define ISP_IRQ_P1_STATUS2_AAO_DONE_ST			(1U << 5)
+#define ISP_IRQ_P1_STATUS2_BPCI_DONE_ST			(1U << 6)
+#define ISP_IRQ_P1_STATUS2_LSCI_DONE_ST			(1U << 7)
+#define ISP_IRQ_P1_STATUS2_AF_TAR_DONE_ST		(1U << 8)
+#define ISP_IRQ_P1_STATUS2_AF_FLO1_DONE_ST		(1U << 9)
+#define ISP_IRQ_P1_STATUS2_AF_FLO2_DONE_ST		(1U << 10)
+#define ISP_IRQ_P1_STATUS2_AF_FLO3_DONE_ST		(1U << 11)
+
+/* CAM_CTL_INT_P1_STATUS_D (Pass-1 "D"/second TG, same bit layout as P1) */
+#define ISP_IRQ_P1_STATUS_D_VS1_INT_ST			(1U << 0)
+#define ISP_IRQ_P1_STATUS_D_TG1_INT1_ST			(1U << 1)
+#define ISP_IRQ_P1_STATUS_D_TG1_INT2_ST			(1U << 2)
+#define ISP_IRQ_P1_STATUS_D_EXPDON1_ST			(1U << 3)
+#define ISP_IRQ_P1_STATUS_D_TG1_ERR_ST			(1U << 4)
+#define ISP_IRQ_P1_STATUS_D_TG1_GBERR			(1U << 5)
+#define ISP_IRQ_P1_STATUS_D_CQ0_ERR			(1U << 6)
+#define ISP_IRQ_P1_STATUS_D_CQ0_VS_ERR_ST		(1U << 7)
+#define ISP_IRQ_P1_STATUS_D_IMGO_DROP_FRAME_ST		(1U << 8)
+#define ISP_IRQ_P1_STATUS_D_RRZO_DROP_FRAME_ST		(1U << 9)
+#define ISP_IRQ_P1_STATUS_D_PASS1_DON_ST		(1U << 10)
+#define ISP_IRQ_P1_STATUS_D_SOF1_INT_ST			(1U << 12)
+#define ISP_IRQ_P1_STATUS_D_PESUDO_P1_DON_ST		(1U << 15)
+#define ISP_IRQ_P1_STATUS_D_AF_DON_ST			(1U << 16)
+#define ISP_IRQ_P1_STATUS_D_IMGO_ERR_ST			(1U << 20)
+#define ISP_IRQ_P1_STATUS_D_AAO_ERR_ST			(1U << 21)
+#define ISP_IRQ_P1_STATUS_D_LCSO_ERR_ST			(1U << 22)
+#define ISP_IRQ_P1_STATUS_D_RRZO_ERR_ST			(1U << 23)
+#define ISP_IRQ_P1_STATUS_D_AFO_ERR_ST			(1U << 24)
