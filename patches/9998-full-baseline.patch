diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_chrdev_wifi.c b/drivers/misc/mediatek/connectivity/wmt/wmt_chrdev_wifi.c
new file mode 100644
index 000000000..0b3000d04
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_chrdev_wifi.c
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN /dev/wmtWifi power control channel.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pub/wmt_chrdev_wifi.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The Wi-Fi HAL powers the WCN Wi-Fi function by writing '1' (on) or '0'
+ * (off) to /dev/wmtWifi.  The downstream driver also forwarded 'D<n>' debug
+ * level changes and P2P/AP mode reconfiguration to the WLAN driver; neither
+ * is part of the frozen WMT interface, so Wi-Fi recovery after a WCN reset is
+ * left to the WLAN driver's WMTMSG_RESET callback.
+ */
+
+#include <linux/cdev.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "wmt_local.h"
+
+/* wmt_chrdev_wifi.c:39-41 */
+#define WIFI_DRIVER_NAME	"wmtWifi"
+#define WIFI_DEV_MAJOR		153
+
+/* wmt_chrdev_wifi.c:170-180 */
+static int wifi_major = WIFI_DEV_MAJOR;
+module_param(wifi_major, uint, 0444);
+
+static struct cdev wifi_cdev;
+static struct class *wifi_class;
+
+enum wifi_power_state {
+	WIFI_POWER_OFF,
+	WIFI_POWER_ON,
+};
+
+static enum wifi_power_state wifi_powered = WIFI_POWER_OFF;
+static DEFINE_MUTEX(wifi_mutex);
+
+/* wmt_chrdev_wifi.c:185-196 */
+#define WMT_CHECK_DO_CHIP_RESET()					\
+	do {								\
+		wmt_err("Wi-Fi power control failed, asserting CONNSYS\n"); \
+		mtk_wcn_wmt_assert(WMTDRV_WIFI, 0x40);			\
+	} while (0)
+
+static int wifi_open(struct inode *inode, struct file *file)
+{
+	wmt_dbg("wmtWifi open by pid %d\n", current->pid);
+	return 0;
+}
+
+static int wifi_release(struct inode *inode, struct file *file)
+{
+	wmt_dbg("wmtWifi release by pid %d\n", current->pid);
+	return 0;
+}
+
+/* wmt_chrdev_wifi.c:349-470 */
+static ssize_t wifi_write(struct file *file, const char __user *buf,
+			  size_t count, loff_t *ppos)
+{
+	char cmd[16] = { };
+	size_t len = min(count, sizeof(cmd) - 1);
+	ssize_t ret = count;
+
+	if (!len)
+		return -EINVAL;
+
+	if (copy_from_user(cmd, buf, len))
+		return -EFAULT;
+
+	mutex_lock(&wifi_mutex);
+
+	switch (cmd[0]) {
+	case '0':
+		if (wifi_powered == WIFI_POWER_OFF) {
+			wmt_dbg("Wi-Fi already off\n");
+			break;
+		}
+
+		if (!mtk_wcn_wmt_func_off(WMTDRV_WIFI)) {
+			WMT_CHECK_DO_CHIP_RESET();
+			ret = -EIO;
+			break;
+		}
+
+		wifi_powered = WIFI_POWER_OFF;
+		wmt_info("Wi-Fi powered off\n");
+		break;
+
+	case '1':
+		if (wifi_powered == WIFI_POWER_ON) {
+			wmt_dbg("Wi-Fi already on\n");
+			break;
+		}
+
+		if (!mtk_wcn_wmt_func_on(WMTDRV_WIFI)) {
+			WMT_CHECK_DO_CHIP_RESET();
+			ret = -EIO;
+			break;
+		}
+
+		wifi_powered = WIFI_POWER_ON;
+		wmt_info("Wi-Fi powered on\n");
+		break;
+
+	case 'D':
+		/* Dynamic WLAN debug levels are not part of the frozen WMT
+		 * interface.
+		 */
+		ret = -EOPNOTSUPP;
+		break;
+
+	default:
+		wmt_warn("invalid wmtWifi command '%c'\n", cmd[0]);
+		ret = -EINVAL;
+		break;
+	}
+
+	mutex_unlock(&wifi_mutex);
+	return ret;
+}
+
+static const struct file_operations wifi_fops = {
+	.owner = THIS_MODULE,
+	.open = wifi_open,
+	.release = wifi_release,
+	.write = wifi_write,
+};
+
+int mtk_wcn_wmt_wifi_init(void)
+{
+	dev_t dev = MKDEV(wifi_major, 0);
+	int ret;
+
+	ret = register_chrdev_region(dev, 1, WIFI_DRIVER_NAME);
+	if (ret) {
+		wmt_err("failed to register the wmtWifi device (%d)\n", ret);
+		return ret;
+	}
+
+	cdev_init(&wifi_cdev, &wifi_fops);
+	wifi_cdev.owner = THIS_MODULE;
+
+	ret = cdev_add(&wifi_cdev, dev, 1);
+	if (ret)
+		goto err_region;
+
+	wifi_class = class_create("wmtWifi");
+	if (IS_ERR(wifi_class)) {
+		ret = PTR_ERR(wifi_class);
+		wifi_class = NULL;
+		goto err_cdev;
+	}
+
+	if (IS_ERR(device_create(wifi_class, NULL, dev, NULL, "wmtWifi"))) {
+		ret = -ENODEV;
+		goto err_class;
+	}
+
+	wifi_powered = WIFI_POWER_OFF;
+	wmt_info("/dev/wmtWifi registered (major %d)\n", wifi_major);
+	return 0;
+
+err_class:
+	class_destroy(wifi_class);
+	wifi_class = NULL;
+err_cdev:
+	cdev_del(&wifi_cdev);
+err_region:
+	unregister_chrdev_region(dev, 1);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wifi_init);
+
+void mtk_wcn_wmt_wifi_exit(void)
+{
+	dev_t dev = MKDEV(wifi_major, 0);
+
+	device_destroy(wifi_class, dev);
+	class_destroy(wifi_class);
+	wifi_class = NULL;
+	cdev_del(&wifi_cdev);
+	unregister_chrdev_region(dev, 1);
+	wifi_powered = WIFI_POWER_OFF;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wifi_exit);
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_coex.c b/drivers/misc/mediatek/connectivity/wmt/wmt_coex.c
new file mode 100644
index 000000000..7bebd8e22
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_coex.c
@@ -0,0 +1,480 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN coexistence engine: firmware debug commands, BGW desense
+ * notifications and the BT/Wi-Fi <-> LTE IDC bridge.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_core.c
+ *     (opfunc_cmd_test coexistence branch, wmt_core.c:1560-1680;
+ *      opfunc_bgw_ds, wmt_core.c:1962-2025;
+ *      opfunc_idc_msg_handling, wmt_core.c:2170-2230)
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pub/bgw_desense.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pub/wmt_idc.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/include/wmt_idc.h
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * WMT coexistence protocol (all PDUs live on the WMT STP channel, opcode
+ * 0x10):
+ *   - COEXDBG: 01 10 02 00 08 <idx>  ->  02 10 <len> 00 00 <payload...>
+ *   - BGW DS : 01 0e 0f 00 02 <14 B> ->  02 0e 01 00 00
+ *   - IDC TX : 01 10 <u16 len> 00 <opcode> <payload> -> 02 10 01 00 00
+ *   - IDC RX : WMT frame with sub-type 0x16 routed to COEX_TASK_INDX
+ *
+ * The modem side of the IDC path is the MTK conn_md IPC service, which is
+ * not present in this kernel.  mtk_wcn_wmt_idc_register() is the explicit
+ * boundary: until a CCCI/modem bridge registers, LTE->firmware frames are
+ * rejected with -ENODEV and firmware->LTE frames are dropped without
+ * fabricating any data (the COEX channel is not even enabled).
+ */
+
+#include <linux/module.h>
+#include <linux/netlink.h>
+#include <linux/skbuff.h>
+#include <net/netlink.h>
+#include <net/sock.h>
+
+#include "wmt_local.h"
+
+#include <mtk_wcn_stp.h>
+
+/* Downstream bgw_desense.h:31-44.  Protocol 17 is the value the vendor daemon
+ * uses (the uapi header reserves it without naming it); the downstream header
+ * defined NETLINK_TEST to 17.
+ */
+#define WMT_BGW_NETLINK_PROTO	17
+#define WMT_BGW_MAX_MSG_LEN	1024
+
+#define IDC_RX_BUFFER_SIZE	1024
+/* wmt_idc.h:26-30 */
+#define WMT_IDC_RX_OPCODE_DEBUG_MONITOR	0x02
+#define WMT_IDC_HEADER_LEN		5
+
+struct wmt_idc {
+	struct mutex lock;
+	const struct mtk_wcn_wmt_idc_ops *ops;
+	struct work_struct work;
+	u8 buffer[IDC_RX_BUFFER_SIZE];
+	unsigned long pending;
+};
+
+static struct wmt_idc idc;
+static struct sock *bgw_nl_sk;
+static int bgw_daemon_pid;
+static bool coex_ready;
+
+#define COEX_ERR(fmt, ...)	pr_err("[WMT-COEX][E]%s: " fmt, __func__, ##__VA_ARGS__)
+#define COEX_WRN(fmt, ...)	pr_warn("[WMT-COEX][W]%s: " fmt, __func__, ##__VA_ARGS__)
+#define COEX_INF(fmt, ...)	pr_info("[WMT-COEX][I]%s: " fmt, __func__, ##__VA_ARGS__)
+#define COEX_DBG(fmt, ...)	pr_debug("[WMT-COEX][D]%s: " fmt, __func__, ##__VA_ARGS__)
+
+/*
+ * BGW desense netlink daemon (bgw_desense.c)
+ */
+
+static int bgw_nl_send_cmd_locked(int command)
+{
+	struct nlmsghdr *nlh;
+	struct sk_buff *skb;
+	int ret;
+
+	if (!bgw_nl_sk) {
+		COEX_DBG("no netlink socket\n");
+		return -ENODEV;
+	}
+	if (!bgw_daemon_pid) {
+		COEX_DBG("BGW daemon not bound\n");
+		return -ENOTCONN;
+	}
+
+	skb = alloc_skb(NLMSG_SPACE(sizeof(u8)), GFP_ATOMIC);
+	if (!skb)
+		return -ENOMEM;
+
+	nlh = nlmsg_put(skb, 0, 0, 0, sizeof(u8), 0);
+	if (!nlh) {
+		kfree_skb(skb);
+		return -EMSGSIZE;
+	}
+
+	*(u8 *)NLMSG_DATA(nlh) = (u8)command;
+	NETLINK_CB(skb).portid = 0;
+
+	/* Downstream checked "res == 0" as an error, but netlink_unicast()
+	 * returns the number of bytes delivered; only a negative value is a
+	 * failure.
+	 */
+	ret = netlink_unicast(bgw_nl_sk, skb, bgw_daemon_pid, MSG_DONTWAIT);
+	if (ret < 0) {
+		COEX_WRN("unicast command %d failed (%d)\n", command, ret);
+		return ret;
+	}
+
+	COEX_DBG("command %d sent\n", command);
+	return 0;
+}
+
+void wmt_bgw_send_cmd(int command)
+{
+	if (!coex_ready)
+		return;
+
+	bgw_nl_send_cmd_locked(command);
+}
+
+static void bgw_nl_input(struct sk_buff *skb)
+{
+	struct nlmsghdr *nlh;
+	const char *payload;
+	u32 len;
+
+	if (!bgw_nl_sk || !pskb_may_pull(skb, NLMSG_HDRLEN + 3)) {
+		kfree_skb(skb);
+		return;
+	}
+
+	nlh = nlmsg_hdr(skb);
+	len = nlh->nlmsg_len - NLMSG_HDRLEN;
+	if (len < 3 || !pskb_may_pull(skb, NLMSG_HDRLEN + 3)) {
+		kfree_skb(skb);
+		return;
+	}
+
+	payload = NLMSG_DATA(nlh);
+	if (memcmp(payload, "BGW", 3)) {
+		COEX_DBG("ignoring non-BGW netlink message\n");
+		kfree_skb(skb);
+		return;
+	}
+
+	bgw_daemon_pid = nlh->nlmsg_pid;
+	COEX_INF("BGW daemon bound, pid %d\n", bgw_daemon_pid);
+	kfree_skb(skb);
+
+	bgw_nl_send_cmd_locked(WMT_BGW_DS_CMD_ACK);
+}
+
+int wmt_bgw_init(void)
+{
+	struct netlink_kernel_cfg cfg = {
+		.input = bgw_nl_input,
+	};
+
+	bgw_daemon_pid = 0;
+	bgw_nl_sk = netlink_kernel_create(&init_net, WMT_BGW_NETLINK_PROTO,
+					  &cfg);
+	if (!bgw_nl_sk) {
+		COEX_ERR("failed to create the BGW netlink socket\n");
+		return -ENOMEM;
+	}
+
+	COEX_INF("BGW desense netlink ready (protocol %d)\n",
+		 WMT_BGW_NETLINK_PROTO);
+	return 0;
+}
+
+void wmt_bgw_deinit(void)
+{
+	if (bgw_nl_sk) {
+		netlink_kernel_release(bgw_nl_sk);
+		bgw_nl_sk = NULL;
+	}
+	bgw_daemon_pid = 0;
+}
+
+/*
+ * Coexistence debug commands (WMTDRV_CMD_COEXDBG_00..15)
+ */
+
+int mtk_wcn_wmt_coex_dbg(u32 cmd, struct wmt_coex_buf *out)
+{
+	u32 len = 0;
+	int ret;
+
+	if (!out)
+		return -EINVAL;
+	if (cmd >= WMTDRV_CMD_COEXDBG_MAX)
+		return -EINVAL;
+
+	out->avail_size = 0;
+
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready())
+		return -ENODEV;
+
+	ret = wmt_core_cmd_test(WMT_TEST_CMD_COEXDBG, (u8)cmd,
+				out->buffer, sizeof(out->buffer), &len);
+	if (ret)
+		return ret;
+
+	out->avail_size = len;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_coex_dbg);
+
+int mtk_wcn_wmt_bgw_desense_ctrl(bool enable)
+{
+	if (!coex_ready)
+		return -ENODEV;
+	if (!g_wmt.ready)
+		return -ENODEV;
+
+	COEX_INF("BGW desense %s\n", enable ? "enable" : "disable");
+	return bgw_nl_send_cmd_locked(enable ? WMT_BGW_DS_CMD_ON :
+					       WMT_BGW_DS_CMD_OFF);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_bgw_desense_ctrl);
+
+int mtk_wcn_wmt_bgw_ds_send(const u8 *payload, u32 len)
+{
+	if (!payload || len != WMT_BGW_DS_PAYLOAD_SIZE)
+		return -EINVAL;
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready())
+		return -ENODEV;
+
+	return wmt_core_bgw_ds(payload, len);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_bgw_ds_send);
+
+/*
+ * LTE IDC
+ */
+
+static int wmt_idc_opcode_to_msg(u8 opcode, enum mtk_wcn_wmt_idc_msg *msg)
+{
+	switch (opcode) {
+	case 0x00:
+		*msg = MTK_WCN_WMT_IDC_MSG_BTWF_DEF_PARA;
+		return 0;
+	case 0x01:
+		*msg = MTK_WCN_WMT_IDC_MSG_BTWF_CHAN_RAN;
+		return 0;
+	case 0x03:
+		*msg = MTK_WCN_WMT_IDC_MSG_LTE_FREQ_IDX_TABLE;
+		return 0;
+	case 0x04:
+		*msg = MTK_WCN_WMT_IDC_MSG_BTWF_PROFILE_IND;
+		return 0;
+	case 0x05:
+		*msg = MTK_WCN_WMT_IDC_MSG_UART_PIN_SEL;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* wmt_idc.c:118-200: walk the concatenated frames of one COEX packet. */
+static void wmt_idc_parse_frames(u8 *data, u32 len)
+{
+	u32 handled = 0;
+
+	while (handled + WMT_IDC_HEADER_LEN <= len) {
+		u8 *frame = data + handled;
+		u16 payload_len;
+		u8 opcode;
+		enum mtk_wcn_wmt_idc_msg msg;
+
+		/* frame[0..1] direction/opcode, frame[2..3] length, frame[4]
+		 * flag/opcode byte, then payload_len - 1 payload bytes.
+		 */
+		memcpy(&payload_len, frame + 2, sizeof(payload_len));
+		if (!payload_len) {
+			COEX_WRN("zero length IDC frame, resync\n");
+			break;
+		}
+		payload_len -= 1;
+
+		if (handled + WMT_IDC_HEADER_LEN + payload_len > len) {
+			COEX_ERR("truncated IDC frame (%u/%u)\n",
+				 handled + WMT_IDC_HEADER_LEN + payload_len,
+				 len);
+			break;
+		}
+
+		opcode = frame[4];
+		if (opcode == WMT_IDC_RX_OPCODE_DEBUG_MONITOR) {
+			COEX_DBG("firmware monitor frame, %u bytes\n",
+				 payload_len);
+		} else if (!wmt_idc_opcode_to_msg(opcode, &msg)) {
+			if (idc.ops && idc.ops->send_to_modem) {
+				int ret = idc.ops->send_to_modem(
+					msg, frame + WMT_IDC_HEADER_LEN,
+					payload_len);
+
+				if (ret)
+					COEX_WRN("modem delivery of %u failed (%d)\n",
+						 msg, ret);
+			} else {
+				COEX_WRN("no modem bridge, dropping msg %u\n",
+					 msg);
+			}
+		} else {
+			COEX_WRN("unknown firmware IDC opcode 0x%02x\n", opcode);
+		}
+
+		handled += WMT_IDC_HEADER_LEN + payload_len;
+	}
+}
+
+static void wmt_idc_work_fn(struct work_struct *work)
+{
+	int read_len;
+
+	mutex_lock(&idc.lock);
+	clear_bit(0, &idc.pending);
+
+	read_len = mtk_wcn_stp_receive_data(idc.buffer, sizeof(idc.buffer),
+					    COEX_TASK_INDX);
+	if (read_len < 0) {
+		mutex_unlock(&idc.lock);
+		COEX_ERR("COEX queue read failed (%d)\n", read_len);
+		return;
+	}
+
+	if (read_len > 0) {
+		COEX_DBG("%d bytes from the firmware\n", read_len);
+		wmt_idc_parse_frames(idc.buffer, read_len);
+	}
+	mutex_unlock(&idc.lock);
+}
+
+/* STP channel callback (registered only while a modem bridge exists). */
+void wmt_idc_channel_data(void)
+{
+	if (!coex_ready || !idc.ops)
+		return;
+
+	if (test_and_set_bit(0, &idc.pending))
+		return;
+
+	schedule_work(&idc.work);
+}
+
+bool wmt_idc_channel_enabled(void)
+{
+	return coex_ready && idc.ops != NULL;
+}
+
+int mtk_wcn_wmt_idc_register(const struct mtk_wcn_wmt_idc_ops *ops)
+{
+	int ret;
+
+	if (!ops || !ops->send_to_modem)
+		return -EINVAL;
+	if (!coex_ready)
+		return -ENODEV;
+
+	mutex_lock(&idc.lock);
+	if (idc.ops) {
+		mutex_unlock(&idc.lock);
+		return -EBUSY;
+	}
+	idc.ops = ops;
+	mutex_unlock(&idc.lock);
+
+	/* Activate the COEX channel only now: without a consumer the STP
+	 * parser keeps dropping LTE coex frames as before.
+	 */
+	ret = mtk_wcn_stp_register_event_cb(COEX_TASK_INDX,
+					    wmt_idc_channel_data);
+	if (ret) {
+		mutex_lock(&idc.lock);
+		idc.ops = NULL;
+		mutex_unlock(&idc.lock);
+		return ret;
+	}
+
+	COEX_INF("modem bridge registered\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_idc_register);
+
+void mtk_wcn_wmt_idc_unregister(void)
+{
+	if (!coex_ready)
+		return;
+
+	mutex_lock(&idc.lock);
+	if (!idc.ops) {
+		mutex_unlock(&idc.lock);
+		return;
+	}
+	idc.ops = NULL;
+	mutex_unlock(&idc.lock);
+
+	mtk_wcn_stp_register_event_cb(COEX_TASK_INDX, NULL);
+	flush_work(&idc.work);
+	COEX_INF("modem bridge unregistered\n");
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_idc_unregister);
+
+bool mtk_wcn_wmt_idc_is_registered(void)
+{
+	return coex_ready && idc.ops != NULL;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_idc_is_registered);
+
+int mtk_wcn_wmt_idc_send(u8 opcode, const u8 *data, u32 len)
+{
+	if (!data || !len)
+		return -EINVAL;
+	if (!coex_ready || !idc.ops)
+		return -ENODEV;
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready())
+		return -ENODEV;
+
+	switch (opcode) {
+	case MTK_WCN_WMT_IDC_TX_LTE_PARA:
+	case MTK_WCN_WMT_IDC_TX_LTE_FREQ:
+	case MTK_WCN_WMT_IDC_TX_WIFI_MAX_POWER:
+	case MTK_WCN_WMT_IDC_TX_DEBUG_MONITOR:
+	case MTK_WCN_WMT_IDC_TX_SPLIT_FILTER:
+	case MTK_WCN_WMT_IDC_TX_LTE_CONNECTION_STATUS:
+	case MTK_WCN_WMT_IDC_TX_LTE_HW_IF_INDICATION:
+	case MTK_WCN_WMT_IDC_TX_LTE_INDICATION:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return wmt_core_idc_tx(opcode, data, len);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_idc_send);
+
+int wmt_coex_init(void)
+{
+	int ret;
+
+	if (coex_ready)
+		return 0;
+
+	mutex_init(&idc.lock);
+	INIT_WORK(&idc.work, wmt_idc_work_fn);
+	idc.ops = NULL;
+	idc.pending = 0;
+
+	ret = wmt_bgw_init();
+	if (ret)
+		COEX_WRN("BGW desense daemon socket unavailable (%d)\n", ret);
+
+	coex_ready = true;
+	return 0;
+}
+
+void wmt_coex_deinit(void)
+{
+	if (!coex_ready)
+		return;
+
+	if (idc.ops) {
+		/* The bridge must unregister first; force it here so that the
+		 * module can always be unloaded.
+		 */
+		COEX_WRN("modem bridge still registered, forcing unregister\n");
+		mtk_wcn_wmt_idc_unregister();
+	}
+
+	cancel_work_sync(&idc.work);
+	wmt_bgw_deinit();
+	mutex_destroy(&idc.lock);
+	coex_ready = false;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_conf.c b/drivers/misc/mediatek/connectivity/wmt/wmt_conf.c
new file mode 100644
index 000000000..bd097e785
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_conf.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT_SOC.cfg parser.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_conf.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The configuration file is a plain "key=value" list in
+ * /system/etc/firmware/WMT_SOC.cfg.  Only the keys used by the ported
+ * functionality are consumed; the coexistence keys of the downstream parser
+ * are accepted and ignored because the coexistence engine is not ported.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "wmt_local.h"
+
+static int wmt_conf_parse_u8(const char *val, u8 *dst)
+{
+	unsigned int tmp;
+	int ret;
+
+	ret = kstrtouint(val, 0, &tmp);
+	if (ret || tmp > 0xff)
+		return -EINVAL;
+
+	*dst = tmp;
+	return 0;
+}
+
+static int wmt_conf_parse_u16(const char *val, u16 *dst)
+{
+	unsigned int tmp;
+	int ret;
+
+	ret = kstrtouint(val, 0, &tmp);
+	if (ret || tmp > 0xffff)
+		return -EINVAL;
+
+	*dst = tmp;
+	return 0;
+}
+
+/* wmt_conf.c:520-560 */
+static int wmt_conf_parse_pair(const char *key, const char *val)
+{
+	struct wmt_gen_conf *conf = &g_wmt.gen_conf;
+	int ret;
+
+	if (!strcmp(key, "co_clock_flag"))
+		ret = wmt_conf_parse_u8(val, &conf->co_clock_flag);
+	else if (!strcmp(key, "wmt_gps_lna_pin"))
+		ret = wmt_conf_parse_u8(val, &conf->wmt_gps_lna_pin);
+	else if (!strcmp(key, "wmt_gps_lna_enable"))
+		ret = wmt_conf_parse_u8(val, &conf->wmt_gps_lna_enable);
+	else if (!strcmp(key, "bt_tssi_from_wifi"))
+		ret = wmt_conf_parse_u8(val, &conf->bt_tssi_from_wifi);
+	else if (!strcmp(key, "bt_tssi_target"))
+		ret = wmt_conf_parse_u16(val, &conf->bt_tssi_target);
+	else
+		return -ENOENT;	/* coexistence/debug key, not ported */
+
+	if (ret)
+		wmt_warn("invalid value '%s' for %s\n", val, key);
+
+	return ret;
+}
+
+/* wmt_conf.c:330-470 */
+static int wmt_conf_parse(const u8 *buf, size_t size)
+{
+	char *line, *next, *eq, *key, *val;
+	char *copy;
+	int ret = 0;
+
+	copy = kmemdup_nul((const char *)buf, size, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+
+	for (line = copy; line && *line; line = next) {
+		next = strchr(line, '\n');
+		if (next)
+			*next++ = '\0';
+
+		line = strim(line);
+		if (!*line)
+			continue;
+
+		eq = strchr(line, '=');
+		if (!eq) {
+			wmt_dbg("malformed config line '%s'\n", line);
+			continue;
+		}
+
+		*eq = '\0';
+		key = strim(line);
+		val = strim(eq + 1);
+
+		if (wmt_conf_parse_pair(key, val) == -EINVAL)
+			ret = -EINVAL;
+	}
+
+	kfree(copy);
+	return ret;
+}
+
+int wmt_conf_read_file(void)
+{
+	struct wmt_gen_conf *conf = &g_wmt.gen_conf;
+	u8 *buf = NULL;
+	size_t size = 0;
+	int ret;
+
+	memset(conf, 0, sizeof(*conf));
+
+	ret = wmt_dev_read_file(g_wmt.cfg_name, &buf, &size);
+	if (ret) {
+		wmt_dbg("cannot read %s (%d)\n", g_wmt.cfg_name, ret);
+		return ret;
+	}
+
+	ret = wmt_conf_parse(buf, size);
+	kfree(buf);
+	if (ret) {
+		wmt_err("failed to parse %s\n", g_wmt.cfg_name);
+		return ret;
+	}
+
+	conf->co_clock_flag &= 0x0f;
+	conf->cfg_exist = true;
+
+	wmt_info("%s: co-clock %u, gps lna pin %u enable %u, bt tssi %u/%u\n",
+		 g_wmt.cfg_name, conf->co_clock_flag, conf->wmt_gps_lna_pin,
+		 conf->wmt_gps_lna_enable, conf->bt_tssi_from_wifi,
+		 conf->bt_tssi_target);
+	return 0;
+}
+
+int wmt_conf_set_cfg_file(const char *name)
+{
+	if (!name || !name[0])
+		return -EINVAL;
+
+	strscpy(g_wmt.cfg_name, name, sizeof(g_wmt.cfg_name));
+	wmt_info("WMT config file set to %s\n", g_wmt.cfg_name);
+	return 0;
+}
+
+const struct wmt_gen_conf *wmt_conf_get(void)
+{
+	return g_wmt.gen_conf.cfg_exist ? &g_wmt.gen_conf : NULL;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_core.c b/drivers/misc/mediatek/connectivity/wmt/wmt_core.c
new file mode 100644
index 000000000..41569bdbf
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_core.c
@@ -0,0 +1,1170 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT control protocol engine.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_core.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_func.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * WMT is the management protocol spoken with the connectivity firmware over
+ * the STP WMT channel.  Every exchange is a command PDU followed by an event
+ * PDU:
+ *
+ *	command: type=1, opcode, len, params...
+ *	event:   type=2, opcode, len, status, params...
+ *
+ * All exchanges are serialised by wmt_lib_run_op() and complete when the
+ * event has been received (or the 2000 ms receive timeout expires).
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+
+/* WMT command/event PDUs (wmt_core.c:203-259, wmt_ic_soc.c:100-160). */
+static const u8 wmt_therm_cmd[] = { 0x01, 0x11, 0x01, 0x00, 0x00 };
+static const u8 wmt_therm_ctrl_evt[] = { 0x02, 0x11, 0x01, 0x00, 0x00 };
+static const u8 wmt_therm_read_evt[] = { 0x02, 0x11, 0x02, 0x00, 0x00, 0x00 };
+static const u8 wmt_dsns_evt[] = { 0x02, 0x0e, 0x01, 0x00, 0x00 };
+static const u8 wmt_assert_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x08 };
+
+/* Power-saving PDUs (wmt_core.c:143-150).  WMT_WAKEUP_CMD is the BTIF
+ * out-of-band wakeup, issued through WMT_CTRL_SOC_WAKEUP_CONSYS, so only the
+ * event is compared.
+ */
+static const u8 wmt_sleep_cmd[] = { 0x01, 0x03, 0x01, 0x00, 0x01 };
+static const u8 wmt_sleep_evt[] = { 0x02, 0x03, 0x02, 0x00, 0x00, 0x01 };
+static const u8 wmt_host_awake_cmd[] = { 0x01, 0x03, 0x01, 0x00, 0x02 };
+static const u8 wmt_host_awake_evt[] = {
+	0x02, 0x03, 0x02, 0x00, 0x00, 0x02,
+};
+static const u8 wmt_wakeup_evt[] = { 0x02, 0x03, 0x02, 0x00, 0x00, 0x03 };
+
+/* Test command PDUs (wmt_core.c:1565-1600).  The assert, exception and
+ * no-ack triggers are fire-and-forget: the firmware never answers them
+ * (wmt_core.c:1660-1670), so no expected event is defined for them.
+ */
+static const u8 wmt_test_assert_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x08 };
+static const u8 wmt_test_exception_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x09 };
+static const u8 wmt_test_noack_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x0a };
+static const u8 wmt_test_warnrst_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x0b };
+static const u8 wmt_test_warnrst_evt[] = { 0x02, 0x02, 0x00, 0x00, 0x00 };
+static const u8 wmt_test_fwlog_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x0c };
+static const u8 wmt_test_fwlog_evt[] = { 0x02, 0x02, 0x00, 0x00, 0x00 };
+static const u8 wmt_test_coexdbg_cmd[] = {
+	0x01, 0x10, 0x02, 0x00, 0x08, 0x00,
+};
+
+/* BGW desense forward (wmt_core.c:1972-1979). */
+static const u8 wmt_bgw_ds_cmd[] = {
+	0x01, 0x0e, 0x0f, 0x00,
+	0x02, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00,
+};
+static const u8 wmt_bgw_ds_evt[] = { 0x02, 0x0e, 0x01, 0x00, 0x00 };
+
+/* LTE IDC command/event (wmt_core.c:2174-2177). */
+static const u8 wmt_idc_evt[] = { 0x02, 0x10, 0x01, 0x00, 0x00 };
+#define WMT_IDC_MAX_PAYLOAD	1200
+
+/* WMT_SET_REG_CMD / WR_EVT / RD_EVT (wmt_core.c:236-258) */
+static u8 wmt_set_reg_cmd[] = {
+	0x01, 0x08, 0x10, 0x00,	/* length */
+	0x00,			/* op: w(1) & r(2) */
+	0x01,			/* type: reg */
+	0x00,			/* reserved */
+	0x01,			/* one register */
+	0x00, 0x00, 0x00, 0x00,	/* address */
+	0x00, 0x00, 0x00, 0x00,	/* value */
+	0xff, 0xff, 0xff, 0xff,	/* mask */
+};
+static const u8 wmt_set_reg_wr_evt[] = {
+	0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01,
+};
+static const u8 wmt_set_reg_rd_evt[] = {
+	0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01,
+	0x00, 0x00, 0x00, 0x00,	/* address */
+	0x00, 0x00, 0x00, 0x00,	/* value */
+};
+
+static int opfunc_pwr_sv(struct wmt_op *op);
+static int opfunc_cmd_test(struct wmt_op *op);
+static int opfunc_bgw_ds(struct wmt_op *op);
+static int opfunc_idc_msg_handling(struct wmt_op *op);
+static int wmt_core_stp_init(void);
+static int wmt_core_stp_deinit(void);
+static int wmt_core_hw_check(void);
+static void wmt_core_bgw_desense_update(void);
+
+/*
+ * Low level WMT transport helpers
+ */
+
+int wmt_core_tx(const u8 *data, u32 size, u32 *written)
+{
+	u32 retry = 0;
+	int ret;
+
+	*written = 0;
+
+	ret = wmt_ctrl_tx_ex(data, size, written, false);
+	while (ret == -EAGAIN && retry < 3) {
+		wmt_warn("no STP window space, retry %u\n", retry + 1);
+		msleep(360);
+		ret = wmt_ctrl_tx_ex(data, size, written, false);
+		retry++;
+	}
+
+	return ret;
+}
+
+int wmt_core_rx(u8 *buf, u32 len, u32 *read_size)
+{
+	struct wmt_ctrl_data data = { };
+
+	if (read_size)
+		*read_size = 0;
+
+	data.ctrl_id = WMT_CTRL_RX;
+	data.data[0] = (unsigned long)buf;
+	data.data[1] = len;
+	data.data[2] = (unsigned long)read_size;
+
+	return wmt_ctrl(&data);
+}
+
+/* wmt_core.c:428-472 */
+int wmt_core_ctrl(enum wmt_ctrl_id id, unsigned long *pa1, unsigned long *pa2)
+{
+	struct wmt_ctrl_data data = { };
+	int ret;
+
+	data.ctrl_id = id;
+	data.data[0] = pa1 ? *pa1 : 0;
+	data.data[1] = pa2 ? *pa2 : 0;
+
+	ret = wmt_ctrl(&data);
+	if (ret) {
+		wmt_err("ctrl %d failed (%d)\n", id, ret);
+		return ret;
+	}
+
+	if (pa1)
+		*pa1 = data.data[0];
+	if (pa2)
+		*pa2 = data.data[1];
+
+	return 0;
+}
+
+/* wmt_core.c:376-426 */
+int wmt_core_func_ctrl_cmd(enum mtk_wcn_wmt_drv type, bool enable)
+{
+	u8 cmd[WMT_HDR_LEN + WMT_FLAG_LEN + WMT_FUNC_CTRL_PARAM_LEN];
+	u8 evt[WMT_HDR_LEN + WMT_STS_LEN];
+	u32 cmd_len = sizeof(cmd);
+	u32 evt_len = sizeof(evt);
+	u32 written = 0, read = 0;
+	int ret;
+
+	cmd[0] = 0x01;			/* PKT_TYPE_CMD */
+	cmd[1] = 0x06;			/* OPCODE_FUNC_CTRL */
+	cmd[2] = WMT_FLAG_LEN + WMT_FUNC_CTRL_PARAM_LEN;
+	cmd[3] = 0x00;
+	cmd[4] = (u8)type;
+	cmd[5] = enable ? 1 : 0;
+
+	ret = wmt_core_tx(cmd, cmd_len, &written);
+	if (ret || written != cmd_len) {
+		wmt_err("func ctrl tx failed (%d, %u/%u)\n", ret, written,
+			cmd_len);
+		return -EIO;
+	}
+
+	ret = wmt_core_rx(evt, evt_len, &read);
+	if (ret || read != evt_len) {
+		wmt_err("func ctrl rx failed (%d, %u/%u)\n", ret, read, evt_len);
+		return -EIO;
+	}
+
+	if (evt[0] != 0x02 /* PKT_TYPE_EVENT */ ||
+	    evt[1] != cmd[1] || evt[4] != 0) {
+		wmt_err("bad func ctrl event %02x %02x %02x %02x %02x\n",
+			evt[0], evt[1], evt[2], evt[3], evt[4]);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/* wmt_core.c:500-562 */
+int wmt_core_reg_rw_raw(u32 is_write, u32 offset, u32 *val, u32 mask)
+{
+	u8 evt[16] = { };
+	u32 evt_len, written = 0, read = 0;
+	const u8 *exp;
+	u32 tx_addr, rx_addr;
+	int ret;
+
+	wmt_set_reg_cmd[4] = is_write ? 0x1 : 0x2;
+	memcpy(&wmt_set_reg_cmd[8], &offset, 4);
+	memcpy(&wmt_set_reg_cmd[12], val, 4);
+	memcpy(&wmt_set_reg_cmd[16], &mask, 4);
+
+	ret = wmt_core_tx(wmt_set_reg_cmd, sizeof(wmt_set_reg_cmd), &written);
+	if (ret || written != sizeof(wmt_set_reg_cmd)) {
+		wmt_err("reg rw tx failed (%d, %u)\n", ret, written);
+		return -EIO;
+	}
+
+	if (is_write) {
+		exp = wmt_set_reg_wr_evt;
+		evt_len = sizeof(wmt_set_reg_wr_evt);
+	} else {
+		exp = wmt_set_reg_rd_evt;
+		evt_len = sizeof(wmt_set_reg_rd_evt);
+	}
+
+	ret = wmt_core_rx(evt, evt_len, &read);
+	if (ret || read != evt_len) {
+		wmt_err("reg rw rx failed (%d, %u/%u)\n", ret, read, evt_len);
+		return -EIO;
+	}
+
+	/* Event type/opcode must echo the command. */
+	if (evt[0] != exp[0] || evt[1] != exp[1]) {
+		wmt_err("bad register event %02x %02x\n", evt[0], evt[1]);
+		return -EIO;
+	}
+
+	if (is_write)
+		return 0;
+
+	memcpy(&tx_addr, &wmt_set_reg_cmd[8], 4);
+	memcpy(&rx_addr, &evt[8], 4);
+	if (tx_addr != rx_addr) {
+		wmt_err("read address mismatch 0x%08x/0x%08x\n",
+			rx_addr, tx_addr);
+		return -EIO;
+	}
+
+	memcpy(val, &evt[12], 4);
+	return 0;
+}
+
+/* wmt_core.c:598-644 */
+int wmt_core_init_script(const struct wmt_init_script *script, int count)
+{
+	u8 evt[256];
+	u32 written = 0, read = 0;
+	int i, ret;
+
+	for (i = 0; i < count; i++) {
+		ret = wmt_core_tx(script[i].cmd, script[i].cmd_sz, &written);
+		if (ret || written != script[i].cmd_sz) {
+			wmt_err("init script %s tx failed (%d, %u/%u)\n",
+				script[i].str, ret, written, script[i].cmd_sz);
+			return -EIO;
+		}
+
+		memset(evt, 0, sizeof(evt));
+		ret = wmt_core_rx(evt, script[i].evt_sz, &read);
+		if (ret || read != script[i].evt_sz) {
+			wmt_err("init script %s rx failed (%d, %u/%u)\n",
+				script[i].str, ret, read, script[i].evt_sz);
+			return -EIO;
+		}
+
+		/* RF calibration events carry chip data; their contents are
+		 * not compared (wmt_core.c:629-640).
+		 */
+		if (script[i].evt_sz > 1 && evt[1] == 0x14)
+			continue;
+
+		if (memcmp(evt, script[i].evt, script[i].evt_sz)) {
+			wmt_err("init script %s unexpected event\n",
+				script[i].str);
+			return -EIO;
+		}
+	}
+
+	return 0;
+}
+
+/* wmt_core.c:660-667 */
+bool wmt_core_patch_check(u32 patch_ver, u32 hw_ver)
+{
+	if (MAJORNUM(hw_ver) != MAJORNUM(patch_ver)) {
+		wmt_err("hw version 0x%x does not match patch 0x%x\n",
+			hw_ver, patch_ver);
+		return false;
+	}
+
+	return true;
+}
+
+/*
+ * STP bring-up / tear-down around the WMT protocol
+ */
+
+/* wmt_core.c:700-790 */
+static int wmt_core_stp_init(void)
+{
+	struct wmt_hif_conf *hif = wmt_lib_hif();
+	unsigned long pa1 = 0, pa2 = 0;
+	int ret;
+
+	if (!wmt_conf_get())
+		wmt_dbg("no WMT_SOC.cfg, using defaults\n");
+
+	if (!(g_wmt.state & WMT_STAT_STP_OPEN)) {
+		ret = wmt_core_ctrl(WMT_CTRL_STP_OPEN, &pa1, &pa2);
+		if (ret)
+			return ret;
+	}
+
+	/* Disable and un-ready STP while the firmware is reconfigured. */
+	pa1 = WMT_STP_CONF_EN;
+	pa2 = 0;
+	ret = wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	pa1 = WMT_STP_CONF_RDY;
+	pa2 = 0;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+
+	/* The firmware always starts in mandatory mode. */
+	pa1 = WMT_STP_CONF_MODE;
+	pa2 = MTKSTP_BTIF_MAND_MODE;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+
+	pa1 = WMT_STP_CONF_EN;
+	pa2 = 1;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	if (ret)
+		return -EIO;
+
+	ret = wmt_core_hw_check();
+	if (ret)
+		return ret;
+
+	wmt_ic_soc_co_clock_ctrl(wmt_lib_co_clock());
+
+	ret = wmt_ic_soc_sw_init(hif);
+	if (ret) {
+		wmt_err("SOC software init failed (%d)\n", ret);
+		return ret;
+	}
+
+	pa1 = WMT_STP_CONF_RDY;
+	pa2 = 1;
+	return wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+}
+
+/* wmt_core.c:792-845 */
+static int wmt_core_stp_deinit(void)
+{
+	struct wmt_hif_conf *hif = wmt_lib_hif();
+	unsigned long pa1, pa2;
+	int ret;
+
+	wmt_ic_soc_sw_deinit(hif);
+
+	pa1 = WMT_STP_CONF_RDY;
+	pa2 = 0;
+	ret = wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	pa1 = WMT_STP_CONF_EN;
+	pa2 = 0;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	pa1 = 0;
+	pa2 = 0;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CLOSE, &pa1, &pa2);
+
+	return ret;
+}
+
+/*
+ * Chip identification (wmt_core.c:861-940)
+ */
+static int wmt_core_hw_check(void)
+{
+	u32 chip_id = 0;
+	int ret;
+
+	ret = wmt_core_reg_rw_raw(false, GEN_HCR, &chip_id, GEN_HCR_MASK);
+	if (ret) {
+		wmt_err("failed to read chip id (%d)\n", ret);
+		return ret;
+	}
+
+	wmt_info("chip id 0x%x\n", chip_id);
+
+	switch (chip_id) {
+	case 0x6572:
+	case 0x6582:
+	case 0x6592:
+	case 0x8127:
+	case 0x6571:
+	case 0x6752:
+	case 0x0279:
+	case 0x0326:
+	case 0x0321:
+	case 0x0335:
+	case 0x0337:
+	case 0x8163:
+	case 0x6580:
+		break;
+	default:
+		wmt_err("unsupported chip id 0x%x\n", chip_id);
+		return -ENODEV;
+	}
+
+	g_wmt.chip_id = chip_id;
+
+	ret = wmt_ic_soc_ver_check();
+	if (ret) {
+		wmt_err("chip 0x%x version check failed (%d)\n", chip_id, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Operation handlers
+ */
+
+static int opfunc_hif_conf(struct wmt_op *op)
+{
+	if (!(op->info_bit & BIT(0)))
+		return -EINVAL;
+
+	memcpy(&g_wmt.hif, &op->data[0], sizeof(g_wmt.hif));
+	return 0;
+}
+
+/* wmt_core.c:947-1029 */
+static int opfunc_pwr_on(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+	int attempt, ret;
+
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_POWER_OFF) {
+		wmt_err("WMT already powered on (status %d)\n",
+			g_wmt.drv_status[WMTDRV_WMT]);
+		return -EALREADY;
+	}
+
+	if (op->info_bit & BIT(0))
+		opfunc_hif_conf(op);
+
+	for (attempt = 0; attempt <= WMT_PWRON_RTY_DFT; attempt++) {
+		ret = wmt_core_ctrl(WMT_CTRL_HW_PWR_ON, &pa1, &pa2);
+		if (ret) {
+			wmt_err("CONSYS power on failed (%d)\n", ret);
+			continue;
+		}
+
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+
+		ret = wmt_core_stp_init();
+		if (!ret) {
+			g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_FUNC_ON;
+			return 0;
+		}
+
+		wmt_err("STP init failed (%d), retry %d\n", ret, attempt);
+		wmt_core_stp_deinit();
+		pa1 = 0;
+		pa2 = 0;
+		wmt_core_ctrl(WMT_CTRL_HW_PWR_OFF, &pa1, &pa2);
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+	}
+
+	return ret;
+}
+
+/* wmt_core.c:1031-1075 */
+static int opfunc_pwr_off(struct wmt_op *op)
+{
+	unsigned long pa1, pa2;
+	int ret = 0;
+
+	if (g_wmt.drv_status[WMTDRV_WMT] == DRV_STS_POWER_OFF) {
+		wmt_warn("WMT already powered off\n");
+		return -EALREADY;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WMT] == DRV_STS_FUNC_ON)
+		ret = wmt_core_stp_deinit();
+
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+	pa1 = 0;
+	pa2 = 0;
+	ret |= wmt_core_ctrl(WMT_CTRL_HW_PWR_OFF, &pa1, &pa2);
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+
+	return ret;
+}
+
+static bool wmt_all_funcs_off(void)
+{
+	int i;
+
+	for (i = 0; i < WMTDRV_WMT; i++)
+		if (g_wmt.drv_status[i] != DRV_STS_POWER_OFF)
+			return false;
+
+	return true;
+}
+
+/* wmt_core.c:1077-1170 */
+/* Downstream wmt_func.c:302-340, 510-545 and 668-710: the BGW desense
+ * daemon is asked to start streaming desense commands while GPS coexists
+ * with BT or Wi-Fi, and to stop when that pairing disappears.
+ */
+static void wmt_core_bgw_desense_update(void)
+{
+	bool gps = g_wmt.drv_status[WMTDRV_GPS] == DRV_STS_FUNC_ON;
+	bool bt_wifi = g_wmt.drv_status[WMTDRV_BT] == DRV_STS_FUNC_ON ||
+		       g_wmt.drv_status[WMTDRV_WIFI] == DRV_STS_FUNC_ON;
+
+	wmt_bgw_send_cmd((gps && bt_wifi) ? WMT_BGW_DS_CMD_ON :
+					   WMT_BGW_DS_CMD_OFF);
+}
+
+static int opfunc_func_on(struct wmt_op *op)
+{
+	unsigned int type = op->data[0];
+	int ret;
+
+	if (type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	if (g_wmt.drv_status[type] == DRV_STS_FUNC_ON) {
+		wmt_warn("function %u already on\n", type);
+		return 0;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_FUNC_ON) {
+		ret = opfunc_pwr_on(op);
+		if (ret)
+			return ret;
+	}
+
+	if (type < WMTDRV_WMT) {
+		ret = wmt_func_on(type);
+		if (ret) {
+			wmt_err("function %u on failed (%d)\n", type, ret);
+			g_wmt.drv_status[type] = DRV_STS_POWER_OFF;
+			if (wmt_all_funcs_off()) {
+				mtk_wcn_wmt_system_state_reset();
+				opfunc_pwr_off(op);
+			}
+			return ret;
+		}
+	}
+
+	g_wmt.drv_status[type] = DRV_STS_FUNC_ON;
+	if (type == WMTDRV_BT || type == WMTDRV_GPS ||
+	    type == WMTDRV_WIFI)
+		wmt_core_bgw_desense_update();
+	return 0;
+}
+
+/* wmt_core.c:1172-1265 */
+static int opfunc_func_off(struct wmt_op *op)
+{
+	unsigned int type = op->data[0];
+	int ret = 0;
+
+	if (type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	if (g_wmt.drv_status[type] != DRV_STS_FUNC_ON) {
+		wmt_warn("function %u is not on\n", type);
+		return 0;
+	}
+
+	if (type < WMTDRV_WMT)
+		ret = wmt_func_off(type);
+
+	g_wmt.drv_status[type] = DRV_STS_POWER_OFF;
+	if (type == WMTDRV_BT || type == WMTDRV_GPS ||
+	    type == WMTDRV_WIFI)
+		wmt_core_bgw_desense_update();
+
+	if (wmt_all_funcs_off())
+		ret |= opfunc_pwr_off(op);
+
+	return ret;
+}
+
+static int opfunc_reg_rw(struct wmt_op *op)
+{
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_FUNC_ON)
+		return -EPERM;
+
+	return wmt_core_reg_rw_raw(op->data[0], op->data[1],
+				   (u32 *)op->data[2], op->data[3]);
+}
+
+/* wmt_core.c:1420-1520 */
+static int opfunc_hw_rst(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+	int ret;
+
+	g_wmt.drv_status[WMTDRV_FM] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_GPS] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_LPBK] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_STP] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_COREDUMP] = DRV_STS_POWER_OFF;
+
+	if (g_wmt.drv_status[WMTDRV_WMT] == DRV_STS_POWER_OFF) {
+		ret = wmt_core_ctrl(WMT_CTRL_HW_PWR_ON, &pa1, &pa2);
+		if (ret)
+			return ret;
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_BT] == DRV_STS_FUNC_ON) {
+		pa1 = BT_PALDO;
+		pa2 = PALDO_OFF;
+		wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+		g_wmt.drv_status[WMTDRV_BT] = DRV_STS_POWER_OFF;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WIFI] == DRV_STS_FUNC_ON) {
+		wmt_func_off(WMTDRV_WIFI);
+		g_wmt.drv_status[WMTDRV_WIFI] = DRV_STS_POWER_OFF;
+	}
+
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+
+	ret = wmt_core_ctrl(WMT_CTRL_HW_RST, &pa1, &pa2);
+	if (ret)
+		wmt_err("hardware reset failed (%d)\n", ret);
+
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+
+	ret = wmt_core_ctrl(WMT_CTRL_STP_CLOSE, &pa1, &pa2);
+	if (ret)
+		wmt_err("STP close after reset failed (%d)\n", ret);
+
+	return ret;
+}
+
+/* wmt_core.c:1522-1531 */
+static int opfunc_sw_rst(struct wmt_op *op)
+{
+	int ret;
+
+	ret = wmt_core_stp_init();
+	if (!ret)
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_FUNC_ON;
+
+	return ret;
+}
+
+/* wmt_core.c:1533-1537 */
+static int opfunc_stp_rst(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+
+	return wmt_core_ctrl(WMT_CTRL_STP_RST, &pa1, &pa2);
+}
+
+/* wmt_core.c:1539-1590 */
+static int opfunc_therm_ctrl(struct wmt_op *op)
+{
+	u8 cmd[sizeof(wmt_therm_cmd)];
+	u8 evt[16] = { };
+	u32 written = 0, read = 0;
+	int ret;
+
+	memcpy(cmd, wmt_therm_cmd, sizeof(cmd));
+	cmd[4] = op->data[0];
+
+	ret = wmt_core_tx(cmd, sizeof(cmd), &written);
+	if (ret || written != sizeof(cmd))
+		return -EIO;
+
+	ret = wmt_core_rx(evt, sizeof(evt), &read);
+	if (ret || (read != sizeof(wmt_therm_ctrl_evt) &&
+		    read != sizeof(wmt_therm_read_evt)))
+		return -EIO;
+
+	if (read == sizeof(wmt_therm_ctrl_evt)) {
+		op->data[1] = memcmp(evt, wmt_therm_ctrl_evt,
+				     sizeof(wmt_therm_ctrl_evt)) ? 0 : 1;
+	} else {
+		op->data[1] = memcmp(evt, wmt_therm_read_evt,
+				     sizeof(wmt_therm_read_evt) - 1) ?
+			      0xff : evt[5];
+	}
+
+	return 0;
+}
