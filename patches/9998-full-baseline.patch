diff --git a/drivers/misc/mediatek/connectivity/wmt/consys_mt6735.c b/drivers/misc/mediatek/connectivity/wmt/consys_mt6735.c
new file mode 100644
index 000000000..5cf2b7c9a
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/consys_mt6735.c
@@ -0,0 +1,962 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6735/MT6737T CONSYS platform glue.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/mt6735/mtk_wcn_consys_hw.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/mt6735/wmt_plat_alps.c
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * The connectivity subsystem is a separate MCU with its own power domain,
+ * clock gates and LDOs.  Register layout (see the DT binding of
+ * "mediatek,mt6735-consys"):
+ *
+ *	reg[0] CONN_MCU_CONFIG_BASE	chip id, MBIST control, CPUPCR
+ *	reg[1] AP_RGU_BASE		CPU software reset
+ *	reg[2] TOPCKGEN_BASE		EMI remapping window
+ *	reg[3] SPM_BASE			power-on configuration
+ *
+ * The SPM power gate and AXI bus protection of the downstream sequence
+ * (CONSYS_TOP1_PWR_CTRL_REG / CONSYS_TOPAXI_PROT_*) are handled by the
+ * MT6735 power-domain controller declared through "power-domains"; this
+ * driver asserts the reset, powers the rails, gates the clocks and polls the
+ * chip id exactly like the downstream driver does around those steps.
+ */
+
+#include <linux/clk.h>
+#include <linux/clkbuf.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include "wmt_local.h"
+
+/* mtk_wcn_consys_hw.h:57-86 */
+#define CONSYS_CPU_SW_RST_OFFSET	0x00000018
+#define CONSYS_CPU_SW_RST_BIT		BIT(12)
+#define CONSYS_CPU_SW_RST_CTRL_KEY	(0x88 << 24)
+
+#define CONSYS_PWRON_CONFG_EN_OFFSET	0x00000000
+#define CONSYS_PWRON_CONFG_EN_VALUE	0x0b160001
+
+#define CONSYS_EMI_MAPPING_OFFSET	0x00000320
+#define CONSYS_CHIP_ID_OFFSET		0x00000008
+#define CONSYS_MCU_CFG_ACR_OFFSET	0x00000110
+#define CONSYS_MCU_CFG_ACR_MBIST_BIT	BIT(18)
+#define CONSYS_CPUPCR_OFFSET		0x00000160
+
+/* mtk_wcn_consys_hw.h:171-181 */
+#define CONSYS_EMI_AP_PHY_OFFSET	0x80000
+#define CONSYS_EMI_MEM_SIZE		(343 * 1024)
+#define CONSYS_EMI_MAPPING_EN		BIT(12)
+#define CONSYS_EMI_ADDR_MASK		0xfff00000
+
+/* Accepted CONSYS chip ids (mtk_wcn_consys_hw.c:487-489). */
+#define CONSYS_CHIP_ID_MT6735		0x0321
+#define CONSYS_CHIP_ID_MT6735M		0x0335
+#define CONSYS_CHIP_ID_MT6753		0x0337
+
+/* PMIC LDO voltages, downstream VOL_1800 / VOL_2800 / VOL_3300. */
+#define CONSYS_VCN18_UV			1800000
+#define CONSYS_VCN28_UV			2800000
+#define CONSYS_VCN33_UV			3300000
+
+/* mtk_wcn_consys_hw.c:481-490 (10 retries, 20 ms apart). */
+#define CONSYS_CHIPID_RETRY		10
+#define CONSYS_CHIPID_DELAY_MS		20
+
+struct mtk_consys {
+	struct device *dev;
+	void __iomem *mcu;
+	void __iomem *ap_rgu;
+	void __iomem *topckgen;
+	void __iomem *spm;
+
+	struct clk *clk_conn;
+	struct clk *clk_bus;		/* optional, ROM DT has a second gate */
+
+	struct regulator *vcn18;
+	struct regulator *vcn28;
+	struct regulator *vcn33_bt;
+	struct regulator *vcn33_wifi;
+
+	struct pinctrl *pinctrl;
+
+	int irq_bgf;
+	bool bgf_irq_requested;
+	bool bgf_irq_enabled;
+	bool powered;
+	bool probed;
+
+	/* Resources currently enabled by this driver. */
+	bool pm_on;
+	bool clk_conn_on;
+	bool clk_bus_on;
+	bool vcn18_on;
+	bool vcn28_on;
+	bool clk_buf_on;	/* CONN RF clock buffer, co-clock mode only */
+
+	phys_addr_t emi_phys;
+	void __iomem *emi_virt;
+
+	struct mutex wake_lock;
+	int wake_count;
+};
+
+static struct mtk_consys consys;
+
+static inline u32 consys_read(void __iomem *base, u32 off)
+{
+	return readl(base + off);
+}
+
+static inline void consys_write(void __iomem *base, u32 off, u32 val)
+{
+	writel(val, base + off);
+}
+
+static void consys_read_modify_write(void __iomem *base, u32 off, u32 set,
+				     u32 clr)
+{
+	u32 val = consys_read(base, off);
+
+	val &= ~clr;
+	val |= set;
+	consys_write(base, off, val);
+}
+
+static bool consys_chipid_valid(u32 id)
+{
+	return id == CONSYS_CHIP_ID_MT6735 || id == CONSYS_CHIP_ID_MT6735M ||
+	       id == CONSYS_CHIP_ID_MT6753;
+}
+
+/*
+ * Regulators (mtk_wcn_consys_hw.c:349-410, 900-1050)
+ */
+
+static int consys_regulator_enable(struct regulator *reg, u32 uv,
+				   const char *name)
+{
+	int ret;
+
+	if (!reg)
+		return -ENODEV;
+
+	ret = regulator_set_voltage(reg, uv, uv);
+	if (ret) {
+		wmt_err("failed to set %s to %u uV (%d)\n", name, uv, ret);
+		return ret;
+	}
+
+	ret = regulator_enable(reg);
+	if (ret) {
+		wmt_err("failed to enable %s (%d)\n", name, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void consys_regulator_disable(struct regulator *reg, const char *name)
+{
+	if (reg &&
+	    regulator_disable(reg))
+		wmt_err("failed to disable %s\n", name);
+}
+
+int wmt_plat_soc_paldo_ctrl(enum wmt_paldo_type type, enum wmt_paldo_op op)
+{
+	bool on = op == PALDO_ON;
+	int ret;
+
+	switch (type) {
+	case BT_PALDO:
+		if (on)
+			ret = consys_regulator_enable(consys.vcn33_bt,
+						      CONSYS_VCN33_UV,
+						      "vcn33_bt");
+		else {
+			consys_regulator_disable(consys.vcn33_bt, "vcn33_bt");
+			ret = 0;
+		}
+		break;
+	case WIFI_PALDO:
+		if (on)
+			ret = consys_regulator_enable(consys.vcn33_wifi,
+						      CONSYS_VCN33_UV,
+						      "vcn33_wifi");
+		else {
+			consys_regulator_disable(consys.vcn33_wifi,
+						 "vcn33_wifi");
+			ret = 0;
+		}
+		break;
+	case FM_PALDO:
+	case GPS_PALDO:
+		/* In co-clock mode FM/GPS power VCN28 explicitly
+		 * (mtk_wcn_consys_hw.c:1084-1110).
+		 */
+		if (on)
+			ret = consys_regulator_enable(consys.vcn28,
+						      CONSYS_VCN28_UV,
+						      "vcn28");
+		else {
+			consys_regulator_disable(consys.vcn28, "vcn28");
+			ret = 0;
+		}
+		break;
+	case PMIC_CHIPID_PALDO:
+	case WIFI_5G_PALDO:
+	default:
+		wmt_warn("PALDO %d is not supported\n", type);
+		ret = -EOPNOTSUPP;
+		break;
+	}
+
+	return ret;
+}
+
+/*
+ * Power on / off (mtk_wcn_consys_hw.c:335-845)
+ */
+
+static int consys_reg_ctrl(bool on)
+{
+	u32 chip_id = 0;
+	int retry = CONSYS_CHIPID_RETRY;
+	int ret;
+
+	wmt_dbg("CONSYS register control (%d)\n", on);
+
+	if (on) {
+		/* 1. VCN18 always on (mtk_wcn_consys_hw.c:356-370) */
+		ret = consys_regulator_enable(consys.vcn18, CONSYS_VCN18_UV,
+					      "vcn18");
+		if (ret)
+			return ret;
+		consys.vcn18_on = true;
+		udelay(150);
+
+		/* 2. VCN28: software controlled in co-clock mode, powered
+		 * here otherwise (mtk_wcn_consys_hw.c:372-400).
+		 */
+		if (!wmt_lib_co_clock()) {
+			ret = consys_regulator_enable(consys.vcn28,
+						      CONSYS_VCN28_UV,
+						      "vcn28");
+			if (ret)
+				goto err_vcn18;
+			consys.vcn28_on = true;
+		} else {
+			/* Co-clock mode turns on the CONN RF clock buffer and
+			 * leaves VCN28 to software control
+			 * (mtk_wcn_consys_hw.c:353-358, CONSYS_CLOCK_BUF_CTRL).
+			 */
+			if (clk_buf_ctrl(CLK_BUF_CONN, 1)) {
+				consys.clk_buf_on = true;
+			} else {
+				wmt_warn("failed to enable the CONN clock buffer\n");
+			}
+		}
+
+		/* 3. assert the CONNSYS CPU software reset */
+		consys_write(consys.ap_rgu, CONSYS_CPU_SW_RST_OFFSET,
+			     consys_read(consys.ap_rgu,
+					 CONSYS_CPU_SW_RST_OFFSET) |
+			     CONSYS_CPU_SW_RST_BIT |
+			     CONSYS_CPU_SW_RST_CTRL_KEY);
+
+		/* 4. SPM clock gating for the power-on configuration */
+		consys_write(consys.spm, CONSYS_PWRON_CONFG_EN_OFFSET,
+			     CONSYS_PWRON_CONFG_EN_VALUE);
+
+		/* 5. power up the CONN power domain */
+		ret = pm_runtime_get_sync(consys.dev);
+		if (ret < 0) {
+			wmt_err("failed to power on the CONN domain (%d)\n",
+				ret);
+			goto err_vcn28;
+		}
+		consys.pm_on = true;
+
+		/* 6. CONN bus clock.  The downstream driver waits 10 us
+		 * after the domain is powered before enabling it
+		 * (mtk_wcn_consys_hw.c:487-501).
+		 */
+		udelay(10);
+		ret = clk_prepare_enable(consys.clk_conn);
+		if (ret) {
+			wmt_err("failed to enable the conn clock (%d)\n", ret);
+			goto err_pm;
+		}
+		consys.clk_conn_on = true;
+
+		if (consys.clk_bus) {
+			ret = clk_prepare_enable(consys.clk_bus);
+			if (ret) {
+				wmt_err("failed to enable the bus clock (%d)\n",
+					ret);
+				goto err_clk;
+			}
+			consys.clk_bus_on = true;
+		}
+
+		/* 7. wait until the MCU reports its chip id */
+		while (retry-- > 0) {
+			chip_id = consys_read(consys.mcu, CONSYS_CHIP_ID_OFFSET);
+			if (consys_chipid_valid(chip_id)) {
+				wmt_info("CONSYS chip id 0x%08x\n", chip_id);
+				break;
+			}
+			wmt_dbg("CONSYS chip id 0x%08x, retrying\n", chip_id);
+			msleep(CONSYS_CHIPID_DELAY_MS);
+		}
+
+		if (!consys_chipid_valid(chip_id)) {
+			wmt_err("CONSYS did not report a valid chip id (0x%08x)\n",
+				chip_id);
+			wmt_err("RGU 0x%08x SPM 0x%08x\n",
+				consys_read(consys.ap_rgu,
+					    CONSYS_CPU_SW_RST_OFFSET),
+				consys_read(consys.spm,
+					    CONSYS_PWRON_CONFG_EN_OFFSET));
+			ret = -ENODEV;
+			goto err_bus_clk;
+		}
+
+		/* 8. run the memory MBIST at full MCU speed */
+		consys_read_modify_write(consys.mcu,
+					 CONSYS_MCU_CFG_ACR_OFFSET,
+					 CONSYS_MCU_CFG_ACR_MBIST_BIT, 0);
+
+		/* 9. release the CPU software reset */
+		consys_write(consys.ap_rgu, CONSYS_CPU_SW_RST_OFFSET,
+			     (consys_read(consys.ap_rgu,
+					  CONSYS_CPU_SW_RST_OFFSET) &
+			      ~CONSYS_CPU_SW_RST_BIT) |
+			     CONSYS_CPU_SW_RST_CTRL_KEY);
+
+		/* 10. give the firmware time to boot (msleep < 20 ms can
+		 * sleep up to 20 ms, mtk_wcn_consys_hw.c:845).
+		 */
+		msleep(20);
+		return 0;
+	}
+
+	/* Power off in the reverse order (mtk_wcn_consys_hw.c:640-720). */
+	if (consys.clk_bus_on) {
+		clk_disable_unprepare(consys.clk_bus);
+		consys.clk_bus_on = false;
+	}
+	if (consys.clk_conn_on) {
+		clk_disable_unprepare(consys.clk_conn);
+		consys.clk_conn_on = false;
+	}
+	if (consys.pm_on) {
+		pm_runtime_put_sync(consys.dev);
+		consys.pm_on = false;
+	}
+
+	if (consys.clk_buf_on) {
+		/* Co-clock mode releases the CONN RF clock buffer instead of
+		 * powering VCN28 (mtk_wcn_consys_hw.c:729-734).
+		 */
+		if (!clk_buf_ctrl(CLK_BUF_CONN, 0))
+			wmt_warn("failed to disable the CONN clock buffer\n");
+		consys.clk_buf_on = false;
+	}
+
+	if (consys.vcn28_on) {
+		consys_regulator_disable(consys.vcn28, "vcn28");
+		consys.vcn28_on = false;
+	}
+	if (consys.vcn18_on) {
+		consys_regulator_disable(consys.vcn18, "vcn18");
+		consys.vcn18_on = false;
+	}
+
+	return 0;
+
+err_bus_clk:
+	if (consys.clk_bus_on) {
+		clk_disable_unprepare(consys.clk_bus);
+		consys.clk_bus_on = false;
+	}
+err_clk:
+	if (consys.clk_conn_on) {
+		clk_disable_unprepare(consys.clk_conn);
+		consys.clk_conn_on = false;
+	}
+err_pm:
+	if (consys.pm_on) {
+		pm_runtime_put_sync(consys.dev);
+		consys.pm_on = false;
+	}
+err_vcn28:
+	/* Undo the co-clock CONN clock buffer enable of power-on step 2. */
+	if (consys.clk_buf_on) {
+		clk_buf_ctrl(CLK_BUF_CONN, 0);
+		consys.clk_buf_on = false;
+	}
+	if (consys.vcn28_on) {
+		consys_regulator_disable(consys.vcn28, "vcn28");
+		consys.vcn28_on = false;
+	}
+err_vcn18:
+	if (consys.vcn18_on) {
+		consys_regulator_disable(consys.vcn18, "vcn18");
+		consys.vcn18_on = false;
+	}
+	return ret;
+}
+
+/*
+ * BGF (BTIF wakeup) interrupt, mtk_wcn_consys_hw.c:800-845 and
+ * wmt_plat_alps.c:224-270.
+ */
+static irqreturn_t consys_bgf_irq(int irq, void *data)
+{
+	/* Downstream wmt_plat_alps.c:225-239 routes the BGF edge to
+	 * wmt_lib_ps_irq_cb(), which becomes a PSM HOST_AWAKE handshake
+	 * (psm_core.c:1037-1135).  The line is level triggered, so it is
+	 * masked here and re-armed by the PSM engine on the next SLEEP.
+	 */
+	if (consys.bgf_irq_enabled) {
+		disable_irq_nosync(irq);
+		consys.bgf_irq_enabled = false;
+	}
+
+	wmt_lib_ps_irq_cb();
+	return IRQ_HANDLED;
+}
+
+/* Downstream wmt_plat_eirq_ctrl(PIN_BGF_EINT, ...) (wmt_plat_alps.c:460-520):
+ * the STP power-saving engine arms the wakeup line just before the MCU is
+ * allowed to sleep and masks it again as soon as the MCU is awake.
+ */
+int wmt_plat_eirq_ctrl(bool enable)
+{
+	if (consys.irq_bgf <= 0 || !consys.bgf_irq_requested)
+		return -ENODEV;
+
+	if (enable == consys.bgf_irq_enabled)
+		return 0;
+
+	if (enable) {
+		enable_irq(consys.irq_bgf);
+		consys.bgf_irq_enabled = true;
+	} else {
+		disable_irq_nosync(consys.irq_bgf);
+		consys.bgf_irq_enabled = false;
+	}
+
+	return 0;
+}
+
+static int consys_irq_init(bool on)
+{
+	int ret;
+
+	if (on) {
+		if (consys.irq_bgf > 0 && !consys.bgf_irq_requested) {
+			ret = request_irq(consys.irq_bgf, consys_bgf_irq,
+					  irq_get_trigger_type(consys.irq_bgf),
+					  "BTIF_WAKEUP_IRQ", NULL);
+			if (ret) {
+				wmt_err("failed to request BGF IRQ %d (%d)\n",
+					consys.irq_bgf, ret);
+				return ret;
+			}
+			consys.bgf_irq_requested = true;
+		}
+
+		/* The wakeup interrupt starts masked; the PSM engine arms it
+		 * from wmt_plat_eirq_ctrl() just before the MCU sleeps.
+		 */
+		disable_irq_nosync(consys.irq_bgf);
+		consys.bgf_irq_enabled = false;
+		wmt_dbg("BGF IRQ registered and disabled\n");
+		return 0;
+	}
+
+	if (consys.bgf_irq_requested) {
+		if (consys.bgf_irq_enabled) {
+			disable_irq_nosync(consys.irq_bgf);
+			consys.bgf_irq_enabled = false;
+		}
+		free_irq(consys.irq_bgf, NULL);
+		consys.bgf_irq_requested = false;
+	}
+
+	return 0;
+}
+
+int mtk_wcn_consys_hw_pwr_on(void)
+{
+	int ret;
+
+	if (!consys.probed)
+		return -ENODEV;
+
+	if (consys.powered)
+		return -EALREADY;
+
+	wmt_info("CONSYS power on\n");
+	ret = consys_reg_ctrl(true);
+	if (ret) {
+		wmt_err("CONSYS register control failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = consys_irq_init(true);
+	consys.powered = true;
+	wmt_info("CONSYS power on done (%d)\n", ret);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_pwr_on);
+
+
+int mtk_wcn_consys_hw_pwr_off(void)
+{
+	if (!consys.probed)
+		return -ENODEV;
+
+	if (!consys.powered)
+		return -EALREADY;
+
+	wmt_info("CONSYS power off\n");
+	consys_irq_init(false);
+	consys.powered = false;
+	return consys_reg_ctrl(false);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_pwr_off);
+
+
+/* mtk_wcn_consys_hw.c:825-845 */
+int mtk_wcn_consys_hw_rst(void)
+{
+	int ret;
+
+	wmt_info("CONSYS hardware reset\n");
+
+	if (!consys.probed)
+		return -ENODEV;
+
+	consys_irq_init(false);
+	ret = consys_reg_ctrl(false);
+	if (ret)
+		wmt_err("CONSYS power off during reset failed (%d)\n", ret);
+
+	consys.powered = false;
+	ret = consys_reg_ctrl(true);
+	if (ret) {
+		wmt_err("CONSYS power on during reset failed (%d)\n", ret);
+		return ret;
+	}
+
+	consys.powered = true;
+	ret = consys_irq_init(true);
+	wmt_info("CONSYS hardware reset done (%d)\n", ret);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_rst);
+
+
+/* mtk_wcn_consys_hw.c:1190-1233 */
+phys_addr_t mtk_wcn_consys_emi_phys_get(void)
+{
+	return consys.emi_phys;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_emi_phys_get);
+
+
+void __iomem *mtk_wcn_consys_emi_virt_get(void)
+{
+	return consys.emi_virt;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_emi_virt_get);
+
+/*
+ * CONSYS shared-memory control block accessors.
+ *
+ * Downstream wmt_plat_alps.c:887-1053 (wmt_plat_get_emi_virt_add(),
+ * wmt_plat_get_dump_info(), wmt_plat_set_host_dump_state(),
+ * wmt_plat_update_host_sync_num()).  Offsets are the EXP_APMEM_CTRL_*
+ * values from mt6735/include/mtk_wcn_consys_hw.h:218-233.
+ *
+ * All accesses are bounds checked against the mapped window: the coredump
+ * collector runs on values read back from an asserting firmware, so a
+ * corrupt register must not be able to walk outside the reserved region.
+ */
+u32 wmt_plat_get_dump_info(u32 offset)
+{
+	if (!consys.emi_virt || offset >= WMT_EMI_MEM_SIZE ||
+	    offset + sizeof(u32) > WMT_EMI_MEM_SIZE)
+		return 0;
+
+	return consys_read(consys.emi_virt, offset);
+}
+
+int wmt_plat_set_host_dump_state(enum wmt_host_dump_state state)
+{
+	if (!consys.emi_virt)
+		return -ENODEV;
+
+	consys_write(consys.emi_virt, WMT_EMI_CTRL_HOST_SYNC_STATE, state);
+	return 0;
+}
+
+int wmt_plat_update_host_sync_num(void)
+{
+	u32 num;
+
+	if (!consys.emi_virt)
+		return -ENODEV;
+
+	num = consys_read(consys.emi_virt, WMT_EMI_CTRL_HOST_SYNC_NUM);
+	consys_write(consys.emi_virt, WMT_EMI_CTRL_HOST_SYNC_NUM, num + 1);
+	return 0;
+}
+
+void __iomem *wmt_plat_emi_virt(u32 offset)
+{
+	if (!consys.emi_virt || offset >= WMT_EMI_MEM_SIZE)
+		return NULL;
+
+	return consys.emi_virt + offset;
+}
+
+
+/* mtk_wcn_consys_hw.c:1235-1240 */
+u32 mtk_wcn_consys_soc_chipid_get(void)
+{
+	/* Never touch the CONNSYS register window while the power domain is
+	 * off: such an access can stall the AP bus.
+	 */
+	if (!consys.probed || !consys.powered)
+		return 0;
+
+	return consys_read(consys.mcu, CONSYS_CHIP_ID_OFFSET) & 0xffff;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_soc_chipid_get);
+
+
+int mtk_wcn_consys_hw_init(void)
+{
+	struct reserved_mem *rmem;
+	struct device_node *np;
+	u32 addr_phy;
+
+	if (!consys.probed) {
+		wmt_err("CONSYS device not probed\n");
+		return -ENODEV;
+	}
+
+	if (consys.emi_virt)
+		return 0;
+
+	np = of_parse_phandle(consys.dev->of_node, "memory-region", 0);
+	if (!np) {
+		wmt_err("no memory-region for CONSYS\n");
+		return -ENODEV;
+	}
+
+	rmem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!rmem || !rmem->size) {
+		wmt_err("CONSYS reserved memory is invalid\n");
+		return -ENODEV;
+	}
+
+	consys.emi_phys = rmem->base;
+	wmt_info("CONSYS shared memory at 0x%pa (0x%llx bytes)\n",
+		 &consys.emi_phys, (unsigned long long)rmem->size);
+
+	/* Enable the CONSYS -> AP EMI remapping window
+	 * (mtk_wcn_consys_hw.c:1140-1150).
+	 */
+	addr_phy = ((u32)consys.emi_phys & CONSYS_EMI_ADDR_MASK) >> 20;
+	addr_phy |= CONSYS_EMI_MAPPING_EN;
+	consys_write(consys.topckgen, CONSYS_EMI_MAPPING_OFFSET,
+		     consys_read(consys.topckgen, CONSYS_EMI_MAPPING_OFFSET) |
+		     addr_phy);
+	wmt_info("EMI mapping register 0x%08x\n",
+		 consys_read(consys.topckgen, CONSYS_EMI_MAPPING_OFFSET));
+
+	/* The firmware uses the upper half of the reserved 512 KiB region. */
+	consys.emi_virt = ioremap(consys.emi_phys + CONSYS_EMI_AP_PHY_OFFSET,
+				  CONSYS_EMI_MEM_SIZE);
+	if (!consys.emi_virt) {
+		wmt_err("failed to map the CONSYS shared memory\n");
+		return -ENOMEM;
+	}
+
+	memset_io(consys.emi_virt, 0, CONSYS_EMI_MEM_SIZE);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_init);
+
+
+void mtk_wcn_consys_hw_deinit(void)
+{
+	if (consys.emi_virt) {
+		iounmap(consys.emi_virt);
+		consys.emi_virt = NULL;
+	}
+
+	if (consys.powered)
+		mtk_wcn_consys_hw_pwr_off();
+}
+
+/*
+ * Platform glue
+ */
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_deinit);
+
+
+int wmt_plat_pwr_ctrl(enum wmt_func_state state)
+{
+	switch (state) {
+	case FUNC_ON:
+		return mtk_wcn_consys_hw_pwr_on();
+	case FUNC_OFF:
+		return mtk_wcn_consys_hw_pwr_off();
+	case FUNC_RST:
+		return mtk_wcn_consys_hw_rst();
+	case FUNC_STAT:
+		wmt_info("CONSYS %s, chip id 0x%04x\n",
+			 consys.powered ? "on" : "off",
+			 mtk_wcn_consys_soc_chipid_get());
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/*
+ * The GPS_SYNC/I2S pins of the connectivity SoC are configured through
+ * wmt_ic_soc_pin_ctrl(); the host side only drives the GPS LNA enable pin
+ * through its pinctrl states (wmt_plat_alps.c:700-780).
+ */
+int wmt_plat_gpio_ctrl(enum wmt_pin_id id, enum wmt_pin_state state)
+{
+	static const char * const state_name[] = {
+		[PIN_STA_INIT] = "gps_lna_state_init",
+		[PIN_STA_OUT_H] = "gps_lna_state_oh",
+		[PIN_STA_OUT_L] = "gps_lna_state_ol",
+	};
+	struct pinctrl_state *pstate;
+	const char *name;
+	int ret;
+
+	if (id == PIN_GPS_SYNC || id == PIN_I2S_GRP)
+		return 0;
+
+	if (id != PIN_GPS_LNA)
+		return -EINVAL;
+
+	if (state == PIN_STA_DEINIT)
+		state = PIN_STA_INIT;
+
+	name = state_name[state];
+	if (!name)
+		return -EINVAL;
+
+	if (!consys.pinctrl) {
+		wmt_dbg("no pinctrl for the GPS LNA pin\n");
+		return 0;
+	}
+
+	pstate = pinctrl_lookup_state(consys.pinctrl, name);
+	if (IS_ERR(pstate)) {
+		wmt_err("missing pinctrl state %s\n", name);
+		return PTR_ERR(pstate);
+	}
+
+	ret = pinctrl_select_state(consys.pinctrl, pstate);
+	if (ret)
+		wmt_err("failed to select %s (%d)\n", name, ret);
+
+	return ret;
+}
+
+int wmt_plat_wake_lock_ctrl(enum wmt_wl_op op)
+{
+	int ret = 0;
+
+	mutex_lock(&consys.wake_lock);
+
+	if (op == WL_OP_GET) {
+		if (consys.wake_count++ == 0)
+			pm_stay_awake(consys.dev);
+	} else if (op == WL_OP_PUT) {
+		if (consys.wake_count == 0) {
+			wmt_warn("unbalanced wake lock release\n");
+			ret = -EINVAL;
+		} else if (--consys.wake_count == 0) {
+			pm_relax(consys.dev);
+		}
+	} else {
+		ret = -EINVAL;
+	}
+
+	mutex_unlock(&consys.wake_lock);
+	return ret;
+}
+
+int wmt_plat_init(void)
+{
+	int ret;
+
+	if (!consys.probed)
+		return -ENODEV;
+
+	ret = mtk_wcn_consys_hw_init();
+	wmt_dbg("platform init (%d)\n", ret);
+	return ret;
+}
+
+void wmt_plat_deinit(void)
+{
+	mtk_wcn_consys_hw_deinit();
+}
+
+/*
+ * Platform driver
+ */
+
+static int mtk_consys_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	memset(&consys, 0, sizeof(consys));
+	consys.dev = dev;
+	mutex_init(&consys.wake_lock);
+
+	consys.mcu = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(consys.mcu))
+		return PTR_ERR(consys.mcu);
+
+	consys.ap_rgu = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(consys.ap_rgu))
+		return PTR_ERR(consys.ap_rgu);
+
+	consys.topckgen = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(consys.topckgen))
+		return PTR_ERR(consys.topckgen);
+
+	consys.spm = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(consys.spm))
+		return PTR_ERR(consys.spm);
+
+	consys.clk_conn = devm_clk_get(dev, "conn");
+	if (IS_ERR(consys.clk_conn)) {
+		wmt_err("failed to get the conn clock (%ld)\n",
+			PTR_ERR(consys.clk_conn));
+		return PTR_ERR(consys.clk_conn);
+	}
+
+	consys.clk_bus = devm_clk_get_optional(dev, "bus");
+	if (IS_ERR(consys.clk_bus)) {
+		wmt_err("failed to get the bus clock (%ld)\n",
+			PTR_ERR(consys.clk_bus));
+		return PTR_ERR(consys.clk_bus);
+	}
+
+	consys.vcn18 = devm_regulator_get_optional(dev, "vcn18");
+	if (IS_ERR(consys.vcn18))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn18),
+				     "failed to get vcn18\n");
+	if (!consys.vcn18)
+		wmt_warn("no vcn18 supply, CONSYS may not power up\n");
+
+	consys.vcn28 = devm_regulator_get_optional(dev, "vcn28");
+	if (IS_ERR(consys.vcn28))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn28),
+				     "failed to get vcn28\n");
+
+	consys.vcn33_bt = devm_regulator_get_optional(dev, "vcn33_bt");
+	if (IS_ERR(consys.vcn33_bt))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn33_bt),
+				     "failed to get vcn33_bt\n");
+
+	consys.vcn33_wifi = devm_regulator_get_optional(dev, "vcn33_wifi");
+	if (IS_ERR(consys.vcn33_wifi))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn33_wifi),
+				     "failed to get vcn33_wifi\n");
+
+	consys.pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(consys.pinctrl)) {
+		ret = PTR_ERR(consys.pinctrl);
+		if (ret != -ENODEV) {
+			wmt_err("failed to get pinctrl (%d)\n", ret);
+			return ret;
+		}
+		consys.pinctrl = NULL;
+	}
+
+	consys.irq_bgf = platform_get_irq(pdev, 0);
+	if (consys.irq_bgf < 0) {
+		wmt_err("failed to get the BGF interrupt (%d)\n",
+			consys.irq_bgf);
+		return consys.irq_bgf;
+	}
+
+	pm_runtime_enable(dev);
+	platform_set_drvdata(pdev, &consys);
+	consys.probed = true;
+
+	wmt_info("CONSYS platform probed (irq %d)\n", consys.irq_bgf);
+	return 0;
+}
+
+static void mtk_consys_remove(struct platform_device *pdev)
+{
+	if (consys.powered)
+		mtk_wcn_consys_hw_pwr_off();
+
+	consys_irq_init(false);
+	pm_runtime_disable(&pdev->dev);
+	mutex_destroy(&consys.wake_lock);
+	consys.probed = false;
+}
+
+static const struct of_device_id mtk_consys_of_ids[] = {
+	{ .compatible = "mediatek,mt6735-consys" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_consys_of_ids);
+
+static struct platform_driver mtk_consys_driver = {
+	.probe = mtk_consys_probe,
+	.remove = mtk_consys_remove,
+	.driver = {
+		.name = "mtk-wcn-consys",
+		.of_match_table = mtk_consys_of_ids,
+	},
+};
+
+int wmt_plat_consys_driver_register(void)
+{
+	return platform_driver_register(&mtk_consys_driver);
+}
+
+void wmt_plat_consys_driver_unregister(void)
+{
+	platform_driver_unregister(&mtk_consys_driver);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_btif.c b/drivers/misc/mediatek/connectivity/wmt/stp_btif.c
new file mode 100644
index 000000000..98fa7af63
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_btif.c
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN STP transport binding for BTIF.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/stp_btif.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The connectivity SoC is attached to the application processor through the
+ * BTIF DMA controller on MT6735/MC6737T.  This file owns the BTIF channel
+ * used by STP ("CONSYS_STP"), registers the STP transmit path with the STP
+ * engine and forwards received bytes to the STP parser.
+ *
+ * The channel is opened lazily by WMT_CTRL_STP_OPEN and closed by
+ * WMT_CTRL_STP_CLOSE, matching the downstream power-on/off ordering.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+
+#include <mtk_btif.h>
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+
+#define BTIF_OWNER_NAME		"CONSYS_STP"
+
+/* stp_btif.c:43-46 */
+#define STP_MAX_PACKAGE_ALLOWED	2000
+#define STP_BTIF_TX_RTY_LMT	10
+#define STP_BTIF_TX_RTY_DLY	5	/* ms */
+
+static unsigned long stp_btif_id;
+
+/* stp_btif.c:129-200 */
+static int stp_btif_tx(const u8 *buf, u32 len, u32 *written_len)
+{
+	int retry_left = STP_BTIF_TX_RTY_LMT;
+	int wr_count, written;
+
+	*written_len = 0;
+
+	if (!stp_btif_id) {
+		wmt_warn("no BTIF channel\n");
+		return -ENODEV;
+	}
+
+	if (len == 0)
+		return 0;
+
+	if (len > STP_MAX_PACKAGE_ALLOWED) {
+		wmt_warn("abnormal packet length %u\n", len);
+		return -EMSGSIZE;
+	}
+
+	wr_count = mtk_wcn_btif_write(stp_btif_id, buf, len);
+	if (wr_count < 0) {
+		wmt_err("btif write failed (%d)\n", wr_count);
+		return -EIO;
+	}
+	if (wr_count == len) {
+		*written_len = wr_count;
+		return 0;
+	}
+
+	while (retry_left-- && wr_count < len) {
+		msleep(STP_BTIF_TX_RTY_DLY);
+		written = mtk_wcn_btif_write(stp_btif_id, buf + wr_count,
+					     len - wr_count);
+		if (written < 0) {
+			wmt_err("btif write failed (%d) while recovering\n",
+				written);
+			break;
+		}
+		wr_count += written;
+	}
+
+	if (wr_count == len) {
+		wmt_info("btif write recovered, len %u, retries left %d\n",
+			 len, retry_left);
+		*written_len = wr_count;
+		return 0;
+	}
+
+	wmt_err("btif write %u/%d, retries left %d\n", len, wr_count,
+		retry_left);
+	return -EIO;
+}
+
+static int stp_btif_parser(const unsigned char *buf, unsigned int len)
+{
+	mtk_wcn_stp_parser_data((u8 *)(uintptr_t)buf, len);
+	return len;
+}
+
+int stp_btif_open(void)
+{
+	int ret;
+
+	if (stp_btif_id)
+		return -EALREADY;
+
+	ret = mtk_wcn_btif_open(BTIF_OWNER_NAME, &stp_btif_id);
+	if (ret) {
+		wmt_err("btif open failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = mtk_wcn_stp_register_if_tx(STP_TX_IF_BTIF, stp_btif_tx);
+	if (ret) {
+		mtk_wcn_btif_close(stp_btif_id);
+		stp_btif_id = 0;
+		return ret;
+	}
+
+	mtk_wcn_stp_set_if_tx_type(STP_TX_IF_BTIF);
+	wmt_dbg("STP BTIF channel opened\n");
+	return 0;
+}
+
+int stp_btif_close(void)
+{
+	int ret;
+
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	ret = mtk_wcn_btif_close(stp_btif_id);
+	if (ret) {
+		wmt_err("btif close failed (%d)\n", ret);
+		return ret;
+	}
+
+	stp_btif_id = 0;
+	return 0;
+}
+
+int stp_btif_rx_register(void)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_rx_cb_register(stp_btif_id, stp_btif_parser);
+}
+
+int stp_btif_rx_unregister(void)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_rx_cb_register(stp_btif_id, NULL);
+}
+
+int stp_btif_wakeup(void)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_wakeup_consys(stp_btif_id);
+}
+
+/* Downstream psm_core.c:895-905 calls mt_combo_plt_enter_deep_idle() /
+ * mt_combo_plt_exit_deep_idle() with COMBO_IF_BTIF once the MCU acknowledges
+ * the SLEEP handshake (and on the way out of it).  On this platform that is
+ * the BTIF controller's deep-idle state machine.
+ */
+int stp_btif_dpidle_ctrl(bool enable)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_dpidle_ctrl(stp_btif_id,
+					enable ? BTIF_DPIDLE_ENABLE :
+						 BTIF_DPIDLE_DISABLE);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_btm.c b/drivers/misc/mediatek/connectivity/wmt/stp_btm.c
new file mode 100644
index 000000000..d22c6dff1
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_btm.c
@@ -0,0 +1,457 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN firmware coredump / assert collector.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/btm_core.c
+ *     (STP_OPID_BTM_PAGED_DUMP handler, btm_core.c:492-670, and the netlink
+ *      forwarder btm_core.c:189-242)
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/stp_core.c
+ *     (MTKSTP_FW_MSG assert path, stp_core.c:1670-1780;
+ *      mtk_wcn_stp_coredump_start_ctrl, stp_core.c:2342-2375)
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * When the firmware asserts it sends an STP_TASK_INDX firmware message.  The
+ * STP layer blocks all further TX (f_coredump) and calls stp_btm_assert().
+ * The collector then walks the CONSYS paged-dump protocol in the shared EMI
+ * window:
+ *
+ *	host_sync_state = GET	-> chip_sync_state must be PUT_DONE
+ *	read chip_sync_addr / chip_sync_len
+ *	copy the page through the AP mapping of the EMI window
+ *	host_sync_num++ ; host_sync_state = GET_DONE
+ *	wait chip_sync_state == END, repeat until counter > page_num and
+ *	chip_paged_dump_end is set
+ *
+ * Each page is streamed to userspace with the downstream STP_DBG framing
+ * ('[M]' | u16 len | data) and the whole-chip WMT reset/recovery is requested
+ * when the collection finishes, times out (STP_CORE_DUMP_TIMEOUT) or cannot
+ * run because the EMI window is unavailable.
+ *
+ * The proprietary MTK AEE backend is absent from this kernel: the netlink
+ * stream is the only sink.  dev_coredump is not used because the WMT core has
+ * no struct device of its own (downstream also delivered through its own
+ * userspace ABI, stp_dbg_aee_send()/stp_dbg_nl_send()).
+ */
+
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+
+#include "wmt_local.h"
+#include "stp_psm.h"
+
+/* stp_dbg.h:127 */
+#define STP_CORE_DUMP_TIMEOUT		(5 * 60 * 1000)
+/* btm_core.c:186-187 */
+#define STP_BTM_SUB_PKT_SIZE		1024
+#define STP_BTM_SUB_PKT_HEADER		5	/* '[', 'M', ']', u16 len */
+#define STP_BTM_PAGE_BUF_SIZE		(32 * 1024)
+/* btm_core.c:504: default page count when the register reads back zero. */
+#define STP_BTM_DEFAULT_PACKET_NUM	35
+/* btm_core.c:546-670 polling budget (10 x 10 ms / 10 x 5 ms). */
+#define STP_BTM_STATE_RETRY		10
+#define STP_BTM_STATE_DELAY_MS		10
+#define STP_BTM_SETTLE_MS		100
+
+struct stp_btm {
+	struct mutex lock;		/* serialises collectors */
+	spinlock_t state_lock;		/* active/abort flags */
+	struct work_struct work;
+	struct timer_list timer;
+	wait_queue_head_t wq;
+
+	u8 *page_buf;
+
+	/* Assert context captured by the parser. */
+	char assert_info[256];
+	u32 assert_len;
+	u32 chip_id;
+	u32 page_count;
+	u32 dump_len;
+
+	bool initialized;
+	bool active;			/* collection queued/running */
+	bool abort;
+	bool reset_done;
+};
+
+static struct stp_btm btm;
+
+#define BTM_ERR(fmt, ...)	pr_err("[STP-BTM][E]%s: " fmt, __func__, ##__VA_ARGS__)
+#define BTM_WRN(fmt, ...)	pr_warn("[STP-BTM][W]%s: " fmt, __func__, ##__VA_ARGS__)
+#define BTM_INF(fmt, ...)	pr_info("[STP-BTM][I]%s: " fmt, __func__, ##__VA_ARGS__)
+#define BTM_DBG(fmt, ...)	pr_debug("[STP-BTM][D]%s: " fmt, __func__, ##__VA_ARGS__)
+
+static void stp_btm_schedule_reset(void)
+{
+	unsigned long flags;
+	bool first = false;
+
+	spin_lock_irqsave(&btm.state_lock, flags);
+	if (!btm.reset_done) {
+		btm.reset_done = true;
+		first = true;
+	}
+	spin_unlock_irqrestore(&btm.state_lock, flags);
+
+	if (first) {
+		BTM_INF("requesting whole-chip recovery\n");
+		wmt_lib_schedule_reset(WMTRSTSRC_RESET_STP);
+	}
+}
+
+/* One '[' 'M' ']' | u16 len | payload record (btm_core.c:189-242). */
+static int stp_btm_send_record(const u8 *data, u32 len)
+{
+	u8 frame[STP_BTM_SUB_PKT_SIZE + STP_BTM_SUB_PKT_HEADER];
+	u32 remain = len;
+	u32 offset = 0;
+
+	while (remain) {
+		u32 chunk = min(remain, (u32)STP_BTM_SUB_PKT_SIZE);
+		u16 wire_len = chunk;
+
+		frame[0] = '[';
+		frame[1] = 'M';
+		frame[2] = ']';
+		memcpy(&frame[3], &wire_len, sizeof(wire_len));
+		memcpy(&frame[STP_BTM_SUB_PKT_HEADER], data + offset, chunk);
+
+		stp_dbg_nl_send(frame, STP_DBG_NL_CMD_DUMP,
+				STP_BTM_SUB_PKT_HEADER + chunk);
+
+		offset += chunk;
+		remain -= chunk;
+	}
+
+	return 0;
+}
+
+static u32 stp_btm_read_ctrl(u32 offset)
+{
+	return wmt_plat_get_dump_info(offset);
+}
+
+static bool stp_btm_wait_chip_state(enum wmt_chip_dump_state want)
+{
+	int i;
+
+	for (i = 0; i < STP_BTM_STATE_RETRY; i++) {
+		if (btm.abort)
+			return false;
+		if ((enum wmt_chip_dump_state)stp_btm_read_ctrl(
+			    WMT_EMI_CTRL_CHIP_SYNC_STATE) == want)
+			return true;
+		msleep(STP_BTM_STATE_DELAY_MS);
+	}
+
+	return false;
+}
+
+/* btm_core.c:520-600 */
+static void stp_btm_collect(void)
+{
+	enum wmt_chip_dump_state chip_state;
+	u32 packet_num, counter = 0;
+	int ret;
+
+	btm.abort = false;
+
+	/* Let the firmware settle after the assert message (btm_core.c:530). */
+	msleep(STP_BTM_SETTLE_MS);
+
+	packet_num = stp_btm_read_ctrl(WMT_EMI_CTRL_CHIP_PAGE_DUMP_NUM);
+	if (!packet_num) {
+		packet_num = STP_BTM_DEFAULT_PACKET_NUM;
+		BTM_WRN("page dump count unavailable, assuming %u\n",
+			packet_num);
+	} else {
+		BTM_INF("page dump count %u\n", packet_num);
+	}
+
+	wmt_plat_set_host_dump_state(WMT_HOST_DUMP_NOT_START);
+
+	for (;;) {
+		u32 dump_addr, dump_len, offset;
+		void __iomem *virt;
+
+		if (btm.abort) {
+			BTM_WRN("collection aborted\n");
+			break;
+		}
+
+		chip_state = (enum wmt_chip_dump_state)stp_btm_read_ctrl(
+			WMT_EMI_CTRL_CHIP_SYNC_STATE);
+		if (chip_state != WMT_CHIP_DUMP_PUT_DONE &&
+		    !stp_btm_wait_chip_state(WMT_CHIP_DUMP_PUT_DONE)) {
+			BTM_ERR("chip did not provide page %u (state %d)\n",
+				counter, chip_state);
+			break;
+		}
+
+		wmt_plat_set_host_dump_state(WMT_HOST_DUMP_GET);
+
+		dump_addr = stp_btm_read_ctrl(WMT_EMI_CTRL_CHIP_SYNC_ADDR);
+		dump_len = stp_btm_read_ctrl(WMT_EMI_CTRL_CHIP_SYNC_LEN);
+
+		/* Validate against the mapped window before touching memory:
+		 * a corrupt assert-time register must not walk the kernel out
+		 * of the reserved region.
+		 */
+		if (dump_addr < WMT_EMI_FW_PHY_BASE ||
+		    dump_addr - WMT_EMI_FW_PHY_BASE >= WMT_EMI_MEM_SIZE) {
+			BTM_ERR("page %u address 0x%08x outside the EMI window\n",
+				counter, dump_addr);
+			break;
+		}
+		offset = dump_addr - WMT_EMI_FW_PHY_BASE;
+
+		if (!dump_len || dump_len > STP_BTM_PAGE_BUF_SIZE ||
+		    offset + dump_len > WMT_EMI_MEM_SIZE) {
+			BTM_ERR("page %u length %u invalid (offset 0x%x)\n",
+				counter, dump_len, offset);
+			break;
+		}
+
+		virt = wmt_plat_emi_virt(offset);
+		if (!virt) {
+			BTM_ERR("EMI window not mapped\n");
+			break;
+		}
+
+		memcpy_fromio(btm.page_buf, virt, dump_len);
+		BTM_INF("page %u: addr 0x%08x len %u\n", counter, dump_addr,
+			dump_len);
+
+		ret = stp_btm_send_record(btm.page_buf, dump_len);
+		if (ret)
+			BTM_WRN("userspace delivery failed (%d)\n", ret);
+
+		btm.dump_len += dump_len;
+		btm.page_count++;
+
+		wmt_plat_update_host_sync_num();
+		wmt_plat_set_host_dump_state(WMT_HOST_DUMP_GET_DONE);
+
+		/* Wait for the chip to mark this page consumed (btm_core.c:625). */
+		if (!stp_btm_wait_chip_state(WMT_CHIP_DUMP_END)) {
+			chip_state = (enum wmt_chip_dump_state)stp_btm_read_ctrl(
+				WMT_EMI_CTRL_CHIP_SYNC_STATE);
+			if (chip_state != WMT_CHIP_DUMP_END) {
+				BTM_WRN("chip did not finish page %u\n",
+					counter);
+				wmt_plat_set_host_dump_state(
+					WMT_HOST_DUMP_NOT_START);
+				break;
+			}
+		}
+
+		wmt_plat_set_host_dump_state(WMT_HOST_DUMP_NOT_START);
+		counter++;
+
+		if (counter > packet_num) {
+			if (stp_btm_read_ctrl(
+				    WMT_EMI_CTRL_CHIP_PAGED_DUMP_END)) {
+				BTM_INF("paged dump complete: %u pages, %u bytes\n",
+					btm.page_count, btm.dump_len);
+				wmt_plat_set_host_dump_state(
+					WMT_HOST_DUMP_END);
+			} else {
+				BTM_ERR("paged dump not terminated by the chip\n");
+			}
+			break;
+		}
+
+	}
+
+	if (!btm.page_count)
+		BTM_ERR("no dump page collected (%u bytes)\n", btm.dump_len);
+}
+
+static void stp_btm_work_fn(struct work_struct *work)
+{
+	mutex_lock(&btm.lock);
+	stp_btm_collect();
+	btm.active = false;
+	timer_delete_sync(&btm.timer);
+	mutex_unlock(&btm.lock);
+
+	wake_up_all(&btm.wq);
+	stp_btm_schedule_reset();
+}
+
+static void stp_btm_timeout_cb(struct timer_list *timer)
+{
+	if (!READ_ONCE(btm.active))
+		return;
+
+	BTM_ERR("coredump timed out after %u ms, flushing\n",
+		STP_CORE_DUMP_TIMEOUT);
+	btm.abort = true;
+	wake_up_all(&btm.wq);
+	stp_btm_schedule_reset();
+}
+
+static void stp_btm_log_assert(void)
+{
+	char line[65];
+	u32 i, n = 0;
+
+	BTM_ERR("firmware assert: %u bytes\n", btm.assert_len);
+
+	if (!btm.assert_len)
+		return;
+
+	/* Keep the printable part in one line for logcat/ramoops users and
+	 * dump the raw bytes at debug level.
+	 */
+	for (i = 0; i < btm.assert_len && n < sizeof(line) - 1; i++) {
+		char c = btm.assert_info[i];
+
+		line[n++] = (c >= 0x20 && c < 0x7f) ? c : '.';
+	}
+	line[n] = '\0';
+	pr_err("[STP-BTM] %s\n", line);
+	print_hex_dump(KERN_DEBUG, "[STP-BTM] ", DUMP_PREFIX_OFFSET, 16, 1,
+		       btm.assert_info, btm.assert_len, false);
+}
+
+/*
+ * API
+ */
+
+bool stp_btm_active(void)
+{
+	return btm.initialized && btm.active;
+}
+
+void stp_btm_assert(const u8 *info, u32 len)
+{
+	unsigned long flags;
+
+	if (!btm.initialized || !btm.page_buf)
+		return;
+
+	spin_lock_irqsave(&btm.state_lock, flags);
+	if (btm.active) {
+		spin_unlock_irqrestore(&btm.state_lock, flags);
+		BTM_WRN("assert already being collected\n");
+		return;
+	}
+	btm.active = true;
+	btm.abort = false;
+	btm.reset_done = false;
+	btm.page_count = 0;
+	btm.dump_len = 0;
+	btm.assert_len = min_t(u32, len, sizeof(btm.assert_info) - 1);
+	if (info && btm.assert_len)
+		memcpy(btm.assert_info, info, btm.assert_len);
+	btm.assert_info[btm.assert_len] = '\0';
+	spin_unlock_irqrestore(&btm.state_lock, flags);
+
+	stp_btm_log_assert();
+
+	/* Downstream also forwards the firmware message itself as an FW DMP
+	 * packet (stp_dbg.c:1187-1206 stp_dbg_log_pkt(STP_DBG_FW_DMP, ...),
+	 * btm_core.c:150-185).  Send it before the paged dump so that the
+	 * daemon can print the assert reason.
+	 */
+	if (btm.assert_len)
+		stp_btm_send_record((const u8 *)btm.assert_info, btm.assert_len);
+
+	if (!mtk_wcn_stp_coredump_flag_get()) {
+		BTM_WRN("coredump collection disabled by userspace\n");
+		goto no_dump;
+	}
+
+	if (!wmt_plat_emi_virt(0)) {
+		BTM_ERR("no CONSYS shared memory window, cannot collect the dump\n");
+		goto no_dump;
+	}
+
+	mod_timer(&btm.timer,
+		  jiffies + msecs_to_jiffies(STP_CORE_DUMP_TIMEOUT));
+	schedule_work(&btm.work);
+	return;
+
+no_dump:
+	spin_lock_irqsave(&btm.state_lock, flags);
+	btm.active = false;
+	spin_unlock_irqrestore(&btm.state_lock, flags);
+	stp_btm_schedule_reset();
+}
+
+void stp_btm_reset(void)
+{
+	unsigned long flags;
+
+	if (!btm.initialized)
+		return;
+
+	spin_lock_irqsave(&btm.state_lock, flags);
+	btm.abort = true;
+	btm.active = false;
+	btm.reset_done = false;
+	btm.page_count = 0;
+	btm.dump_len = 0;
+	btm.assert_len = 0;
+	spin_unlock_irqrestore(&btm.state_lock, flags);
+
+	timer_delete_sync(&btm.timer);
+
+	/* mtk_wcn_stp_ctx_restore() (stp_core.c:3312-3322): the dump is over,
+	 * allow the MCU to sleep again.
+	 */
+	stp_psm_set_sleep_enable();
+}
+
+int stp_btm_init(void)
+{
+	int ret;
+
+	memset(&btm, 0, sizeof(btm));
+	mutex_init(&btm.lock);
+	spin_lock_init(&btm.state_lock);
+	init_waitqueue_head(&btm.wq);
+	INIT_WORK(&btm.work, stp_btm_work_fn);
+	timer_setup(&btm.timer, stp_btm_timeout_cb, 0);
+
+	btm.page_buf = kmalloc(STP_BTM_PAGE_BUF_SIZE, GFP_KERNEL);
+	if (!btm.page_buf) {
+		mutex_destroy(&btm.lock);
+		return -ENOMEM;
+	}
+
+	ret = stp_dbg_nl_init();
+	if (ret) {
+		kfree(btm.page_buf);
+		btm.page_buf = NULL;
+		mutex_destroy(&btm.lock);
+		return ret;
+	}
+
+	btm.initialized = true;
+	BTM_INF("coredump collector ready (timeout %u ms)\n",
+		STP_CORE_DUMP_TIMEOUT);
+	return 0;
+}
+
+void stp_btm_deinit(void)
+{
+	if (!btm.initialized)
+		return;
+
+	btm.initialized = false;
+	btm.abort = true;
+	timer_delete_sync(&btm.timer);
+	cancel_work_sync(&btm.work);
+	stp_dbg_nl_deinit();
+	kfree(btm.page_buf);
+	btm.page_buf = NULL;
+	mutex_destroy(&btm.lock);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_core.c b/drivers/misc/mediatek/connectivity/wmt/stp_core.c
new file mode 100644
index 000000000..ee134ebba
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_core.c
@@ -0,0 +1,1435 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN STP (Serial Transport Protocol) engine.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/stp_core.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/stp_exp.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * STP is a sliding-window protocol carried over the BTIF serial link.  Each
+ * frame is
+ *
+ *	seq/ack | type/len_hi | len_lo | header checksum | payload | crc16
+ *
+ * with an optional 0x55 0x55 delimiter.  Payloads are demultiplexed into one
+ * ring buffer per logical channel (BT/FM/GPS/WIFI/WMT/STP/INFO/ANT) and the
+ * registered channel callback is invoked without any STP lock held.
+ *
+ * The power-saving (PSM) and firmware-coredump (BTM) engines live in
+ * stp_psm.c and stp_btm.c.  The STP transmit path funnels every non-WMT
+ * frame through the PSM filter, and a firmware assert message received on the
+ * STP channel starts the coredump collector instead of resetting the chip
+ * immediately.
+ */
+
+#include <linux/crc16.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+#include "stp_psm.h"
+
+/* Downstream static configuration: NAK and delimiter generation disabled
+ * (stp_core.c:40-41).
+ */
+#define STP_ENABLE_NAK		0
+#define STP_ENABLE_DELIMITER	0
+
+static const u8 stp_delimiter[STP_DEL_SIZE] = { 0x55, 0x55 };
+
+struct stp_ctx {
+	struct mutex lock;		/* protects tx window, ack state */
+	struct mutex parse_lock;	/* serialises the rx parser */
+	struct stp_ring ring[MTKSTP_MAX_TASK_NUM];
+	struct stp_parser parser;
+	struct stp_sequence sequence;
+
+	u8 rx_buf[MTKSTP_BUFFER_SIZE];
+	u32 rx_counter;
+
+	u8 tx_buf[MTKSTP_BUFFER_SIZE];
+	u32 tx_read;
+	u32 tx_write;
+	u32 tx_start_addr[MTKSTP_SEQ_SIZE];
+	u32 tx_length[MTKSTP_SEQ_SIZE];
+
+	struct timer_list tx_timer;
+	struct work_struct tx_timeout_work;
+	struct work_struct reset_work;
+
+	bool enabled;
+	bool ready;
+	bool bluez;
+	u32 mode;			/* MTKSTP_*_MODE bits */
+	u8 pending_type;
+	u32 wmt_last_close;
+	u32 evt_err_assert;
+	bool en_coredump;		/* collection allowed */
+	bool f_coredump;		/* firmware is asserting, TX blocked */
+};
+
+static struct stp_ctx stp;
+static int stp_ctx_ready;
+static enum stp_parser_state stp_prev_state;
+static int stp_packet_fail_count;
+
+static int (*stp_if_tx[STP_TX_IF_MAX])(const u8 *data, u32 size, u32 *written);
+static mtk_wcn_stp_if_rx stp_if_rx;
+static enum mtk_wcn_stp_tx_if stp_if_type = STP_TX_IF_MAX;
+static mtk_wcn_stp_event_cb stp_event_cb[MTKSTP_MAX_TASK_NUM];
+static mtk_wcn_stp_event_cb stp_tx_event_cb[MTKSTP_MAX_TASK_NUM];
+
+/*
+ * TX side helpers
+ */
+
+static int stp_sys_if_tx(const u8 *data, u32 size, u32 *written)
+{
+	if (stp_if_type >= STP_TX_IF_MAX || !stp_if_tx[stp_if_type])
+		return -EIO;
+
+	return stp_if_tx[stp_if_type](data, size, written);
+}
+
+static bool stp_tx_room(u32 length)
+{
+	u32 room;
+
+	if (stp.tx_read <= stp.tx_write)
+		room = MTKSTP_BUFFER_SIZE - stp.tx_write + stp.tx_read - 1;
+	else
+		room = stp.tx_read - stp.tx_write - 1;
+
+	if (room < length) {
+		stp_err("tx queue room shortage\n");
+		return false;
+	}
+
+	return true;
+}
+
+static void stp_add_to_tx_queue(const u8 *buffer, u32 length)
+{
+	u32 last_len;
+
+	if (length + stp.tx_write < MTKSTP_BUFFER_SIZE) {
+		memcpy(stp.tx_buf + stp.tx_write, buffer, length);
+		stp.tx_write += length;
+	} else {
+		last_len = MTKSTP_BUFFER_SIZE - stp.tx_write;
+		memcpy(stp.tx_buf + stp.tx_write, buffer, last_len);
+		memcpy(stp.tx_buf, buffer + last_len, length - last_len);
+		stp.tx_write = length - last_len;
+	}
+}
+
+/* stp_core.c:267-291 */
+static void stp_update_tx_queue(u32 txseq)
+{
+	u32 tx_read = stp.tx_start_addr[txseq];
+	u8 checksum = 0;
+	int i;
+
+	stp.tx_buf[tx_read] &= 0xf8;
+	stp.tx_buf[tx_read] |= stp.sequence.txack;
+
+	for (i = 0; i < 3; i++) {
+		checksum += stp.tx_buf[tx_read];
+		tx_read++;
+		if (tx_read >= MTKSTP_BUFFER_SIZE)
+			tx_read -= MTKSTP_BUFFER_SIZE;
+	}
+
+	stp.tx_buf[tx_read] = checksum;
+}
+
+/* stp_core.c:712-752 */
+static void stp_send_tx_queue(u32 txseq)
+{
+	u32 ret = 0;
+	u32 tx_read = stp.tx_start_addr[txseq];
+	u32 tx_length = stp.tx_length[txseq];
+	u32 last_len;
+
+	stp_update_tx_queue(txseq);
+
+	if (tx_read + tx_length < MTKSTP_BUFFER_SIZE) {
+		stp_sys_if_tx(&stp.tx_buf[tx_read], tx_length, &ret);
+		if (ret != tx_length)
+			stp_err("stp_send_tx_queue %u/%u\n", tx_length, ret);
+	} else {
+		last_len = MTKSTP_BUFFER_SIZE - tx_read;
+		stp_sys_if_tx(&stp.tx_buf[tx_read], last_len, &ret);
+		if (ret != last_len)
+			stp_err("stp_send_tx_queue %u/%u\n", last_len, ret);
+
+		stp_sys_if_tx(&stp.tx_buf[0], tx_length - last_len, &ret);
+		if (ret != tx_length - last_len)
+			stp_err("stp_send_tx_queue %u/%u\n",
+				tx_length - last_len, ret);
+	}
+}
+
+/* stp_core.c:762-802 */
+static void stp_send_ack(u8 tx_ack, u8 nak)
+{
+	u8 header[MTKSTP_HEADER_SIZE];
+	u32 ret = 0;
+
+	header[0] = 0x80 + (0 << 3) + tx_ack;
+	if (STP_ENABLE_NAK)
+		header[1] = nak ? 0x80 : 0x00;
+	else
+		header[1] = 0x00;
+	header[2] = 0;
+	header[3] = (header[0] + header[1] + header[2]) & 0xff;
+
+	if (STP_ENABLE_DELIMITER)
+		stp_sys_if_tx(stp_delimiter, STP_DEL_SIZE, &ret);
+
+	ret = 0;
+	stp_sys_if_tx(&header[0], MTKSTP_HEADER_SIZE, &ret);
+	if (ret != MTKSTP_HEADER_SIZE)
+		stp_err("stp_send_ack %u/%u\n", MTKSTP_HEADER_SIZE, ret);
+}
+
+/*
+ * RX side helpers
+ */
+
+/* Requires stp.parse_lock and stp.lock. */
+static void stp_rest_ctx_state(void)
+{
+	int i;
+
+	stp.rx_counter = 0;
+
+	for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&stp.ring[i].lock, flags);
+		stp.ring[i].read_p = 0;
+		stp.ring[i].write_p = 0;
+		spin_unlock_irqrestore(&stp.ring[i].lock, flags);
+	}
+
+	stp.tx_write = 0;
+	stp.tx_read = 0;
+
+	stp.parser.state = STP_SYNC;
+	stp.sequence.txseq = 0;
+	stp.sequence.txack = 7;
+	stp.sequence.rxack = 7;
+	stp.sequence.winspace = MTKSTP_WINSIZE;
+	stp.sequence.expected_rxseq = 0;
+	stp.sequence.retry_times = 0;
+}
+
+static void stp_change_rx_state(enum stp_parser_state next)
+{
+	stp_prev_state = stp.parser.state;
+	stp.parser.state = next;
+}
+
+/* stp_core.c:604-652 */
+static int stp_add_to_rx_queue(u8 *buffer, u32 length, u8 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+	u32 room, last_len;
+
+	if (type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+
+	if (ring->read_p <= ring->write_p)
+		room = MTKSTP_BUFFER_SIZE - ring->write_p + ring->read_p - 1;
+	else
+		room = ring->read_p - ring->write_p - 1;
+
+	if (room < length) {
+		spin_unlock_irqrestore(&ring->lock, flags);
+		stp_err("queue %u is full\n", type);
+		return -ENOSPC;
+	}
+
+	if (length + ring->write_p < MTKSTP_BUFFER_SIZE) {
+		memcpy(ring->buffer + ring->write_p, buffer, length);
+		ring->write_p += length;
+	} else {
+		last_len = MTKSTP_BUFFER_SIZE - ring->write_p;
+		memcpy(ring->buffer + ring->write_p, buffer, last_len);
+		memcpy(ring->buffer, buffer + last_len, length - last_len);
+		ring->write_p = length - last_len;
+	}
+
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	return 0;
+}
+
+/* stp_core.c:921-963 */
+static int stp_process_rxack(void)
+{
+	u8 rxack;
+	int j = 0, k = 0;
+
+	if (stp.sequence.rxack == stp.parser.ack)
+		return -1;
+
+	rxack = stp.sequence.rxack;
+	rxack = (rxack + 1) & 0x7;
+	while (rxack != stp.sequence.txseq) {
+		j++;
+		if (rxack == stp.parser.ack) {
+			k = 1;
+			break;
+		}
+		rxack = (rxack + 1) & 0x7;
+	}
+
+	if (k != 1)
+		return -1;
+
+	stp.sequence.rxack = stp.parser.ack;
+	stp.tx_read = stp.tx_start_addr[rxack] + stp.tx_length[rxack];
+	if (stp.tx_read >= MTKSTP_BUFFER_SIZE)
+		stp.tx_read -= MTKSTP_BUFFER_SIZE;
+
+	stp.sequence.winspace += j;
+	stp.sequence.retry_times = 0;
+
+	timer_delete(&stp.tx_timer);
+	if (stp.sequence.winspace != MTKSTP_WINSIZE)
+		mod_timer(&stp.tx_timer,
+			  jiffies + msecs_to_jiffies(MTKSTP_TX_TIMEOUT));
+
+	return 0;
+}
+
+static bool stp_function_active(u8 type)
+{
+	return type < MTKSTP_MAX_TASK_NUM && stp_event_cb[type];
+}
+
+/* stp_core.c:965-1160
+ *
+ * Runs with stp.parse_lock held; the TX window and ack state are protected by
+ * stp.lock inside the critical sections.  Channel callbacks are invoked after
+ * stp.lock has been released, as required by mtk_wcn_stp.h.
+ */
+static void stp_process_packet(void)
+{
+	int trigger_resume = -1;
+	u8 tx_ack = 0;
+	static int rx_ok;
+	bool active;
+	bool notify = false;
+	int ret;
+
+	mutex_lock(&stp.lock);
+
+	if (stp.sequence.expected_rxseq == stp.parser.seq &&
+	    stp.parser.type == BT_TASK_INDX && stp.bluez) {
+		/* BlueZ stack: hand the HCI packet straight to the HCI core. */
+		mutex_unlock(&stp.lock);
+		if (stp_if_rx)
+			stp_if_rx(stp.rx_buf, stp.rx_counter);
+		else
+			stp_err("bluez packet without registered rx handler\n");
+		mutex_lock(&stp.lock);
+
+		trigger_resume = stp_process_rxack();
+		stp.sequence.txack = stp.parser.seq;
+		stp.sequence.expected_rxseq =
+			(stp.sequence.expected_rxseq + 1) & 0x7;
+		tx_ack = stp.sequence.txack;
+		stp_send_ack(tx_ack, 0);
+		rx_ok = 0;
+	} else if (stp.sequence.expected_rxseq == stp.parser.seq) {
+		active = stp_function_active(stp.parser.type);
+
+		trigger_resume = stp_process_rxack();
+		stp.sequence.txack = stp.parser.seq;
+		stp.sequence.expected_rxseq =
+			(stp.sequence.expected_rxseq + 1) & 0x7;
+		tx_ack = stp.sequence.txack;
+		stp_send_ack(tx_ack, 0);
+
+		if (stp.parser.type < MTKSTP_MAX_TASK_NUM && active) {
+			if (stp.parser.type == WMT_TASK_INDX &&
+			    stp.parser.wmt_subtype == WMT_LTE_COEX_FLAG) {
+				stp_warn("LTE coex frame on non-LTE project, dropped\n");
+				rx_ok = 0;
+			} else {
+				ret = stp_add_to_rx_queue(stp.rx_buf,
+							  stp.rx_counter,
+							  stp.parser.type);
+				rx_ok = ret ? -1 : 0;
+			}
+		} else {
+			if (active)
+				stp_err("type %u is invalid, dropped\n",
+					stp.parser.type);
+			else
+				stp_err("function %u is inactive, dropped\n",
+					stp.parser.type);
+			rx_ok = 0;
+		}
+
+		if (!rx_ok) {
+			stp_packet_fail_count = 0;
+			if (stp.parser.type == WMT_TASK_INDX &&
+			    stp.parser.wmt_subtype == WMT_LTE_COEX_FLAG)
+				stp_warn("LTE coex frame dropped\n");
+			else
+				notify = true;
+		} else {
+			stp_packet_fail_count++;
+			/* A full GPS queue is drained rather than retried. */
+			if (stp.parser.type == GPS_TASK_INDX)
+				mtk_wcn_stp_flush_rx_queue(GPS_TASK_INDX);
+			else
+				notify = true;
+			/* Do not ack: let the peer retry. */
+			stp_err("enqueue to rx queue %u failed\n",
+				stp.parser.type);
+		}
+	} else if (!rx_ok) {
+		stp_err("expected_rxseq %u, parser.seq %u\n",
+			stp.sequence.expected_rxseq, stp.parser.seq);
+		stp_packet_fail_count++;
+		stp_send_ack(stp.sequence.txack, 1);
+	} else {
+		stp_packet_fail_count++;
+		stp_err("sequence mismatch after enqueue failure\n");
+	}
+
+	mutex_unlock(&stp.lock);
+
+	if (notify && stp_event_cb[stp.parser.type])
+		stp_event_cb[stp.parser.type]();
+
+	if (trigger_resume == 0) {
+		int i;
+
+		for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++)
+			if (stp_tx_event_cb[i])
+				stp_tx_event_cb[i]();
+	}
+
+	if (stp_packet_fail_count > MTKSTP_RETRY_LIMIT) {
+		stp_packet_fail_count = 0;
+		stp_err("too many packet failures, resetting CONSYS\n");
+		stp.ready = false;
+		schedule_work(&stp.reset_work);
+	}
+}
+
+/* stp_core.c:1956-2210 (mandatory mode, no sequence/ack/crc) */
+static int stp_parser_data_in_mand_mode(u32 length, u8 *p_data)
+{
+	u8 padding_len;
+	int remain_length;
+	int i = length;
+
+	while (i > 0) {
+		switch (stp.parser.state) {
+		case STP_SYNC:
+			if ((*p_data & 0x80) == 0x80) {
+				if (*p_data != 0x80)
+					stp_warn("mandatory mode sync byte 0x%x\n",
+						 *p_data);
+				stp_change_rx_state(STP_NAK);
+				stp.rx_counter++;
+			} else {
+				stp_warn("sync to sync, byte 0x%x\n", *p_data);
+				stp_change_rx_state(STP_SYNC);
+			}
+			break;
+		case STP_NAK:
+			stp_change_rx_state(STP_LENGTH);
+			stp.parser.type = (*p_data & 0x70) >> 4;
+			if (stp.parser.type <= MTKSTP_MAX_TASK_NUM) {
+				stp.parser.length = (*p_data & 0x0f) << 8;
+				stp.rx_counter++;
+			} else {
+				stp_warn("invalid type, back to sync\n");
+				stp_change_rx_state(STP_SYNC);
+			}
+			break;
+		case STP_LENGTH:
+			stp_change_rx_state(STP_CHECKSUM);
+			stp.parser.length += *p_data;
+			if (stp.parser.length < 2000) {
+				stp.rx_counter++;
+			} else {
+				stp_warn("invalid STP length %u\n",
+					 stp.parser.length);
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+			}
+			break;
+		case STP_CHECKSUM:
+			if (stp.parser.type == STP_TASK_INDX ||
+			    stp.parser.type == INFO_TASK_INDX) {
+				stp_change_rx_state(STP_FW_MSG);
+				stp.rx_counter = 0;
+				i -= 1;
+				if (i != 0)
+					p_data += 1;
+				continue;
+			}
+			if (stp.parser.length == 0) {
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+			} else {
+				stp_change_rx_state(STP_DATA);
+				stp.rx_counter = 0;
+			}
+			break;
+		case STP_DATA:
+			if (stp.parser.length < stp.rx_counter) {
+				stp_err("abnormal length %u/%u in DATA\n",
+					stp.parser.length, stp.rx_counter);
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			remain_length = stp.parser.length - stp.rx_counter;
+			if (i >= remain_length) {
+				if (stp.rx_counter + remain_length >=
+				    MTKSTP_BUFFER_SIZE) {
+					stp_err("rx buffer overrun\n");
+					stp_change_rx_state(STP_SYNC);
+					stp.rx_counter = 0;
+					return -1;
+				}
+				memcpy(stp.rx_buf + stp.rx_counter, p_data,
+				       remain_length);
+				i -= remain_length;
+				p_data += remain_length;
+				stp.rx_counter = stp.parser.length;
+				stp.parser.state = STP_CRC1;
+				continue;
+			}
+			if (i + stp.rx_counter >= MTKSTP_BUFFER_SIZE) {
+				stp_err("rx buffer overrun 2\n");
+				stp.rx_counter = 0;
+				return -1;
+			}
+			memcpy(stp.rx_buf + stp.rx_counter, p_data, i);
+			stp.rx_counter += i;
+			i = 0;
+			continue;
+		case STP_CRC1:
+			stp_change_rx_state(STP_CRC2);
+			break;
+		case STP_CRC2:
+			if (stp.parser.type == WMT_TASK_INDX)
+				stp.parser.wmt_subtype = stp.rx_buf[1];
+
+			/* STP packets are 4-byte aligned in mandatory mode. */
+			if (i <= 4) {
+				p_data += (i - 1);
+				i -= (i - 1);
+			} else {
+				padding_len = (0x04 -
+					((stp.parser.length + 6) & 0x03)) & 0x03;
+				p_data += padding_len;
+				i -= padding_len;
+			}
+
+			if (stp.parser.type == BT_TASK_INDX && stp.bluez) {
+				if (stp_if_rx)
+					stp_if_rx(stp.rx_buf, stp.rx_counter);
+				else
+					stp_err("bluez packet without handler\n");
+			} else if (stp_function_active(stp.parser.type)) {
+				if (stp.parser.type == WMT_TASK_INDX &&
+				    stp.parser.wmt_subtype ==
+				    WMT_LTE_COEX_FLAG) {
+					stp_warn("LTE coex frame dropped\n");
+				} else {
+					stp_add_to_rx_queue(stp.rx_buf,
+							    stp.rx_counter,
+							    stp.parser.type);
+					if (stp_event_cb[stp.parser.type])
+						stp_event_cb[stp.parser.type]();
+				}
+			} else {
+				stp_err("function %u inactive, dropped\n",
+					stp.parser.type);
+			}
+
+			stp.rx_counter = 0;
+			stp_change_rx_state(STP_SYNC);
+			break;
+		case STP_FW_MSG:
+			stp_err("firmware message, length %u (not dumped)\n",
+				stp.parser.length);
+			stp.rx_counter = 0;
+			stp_change_rx_state(STP_SYNC);
+			break;
+		default:
+			break;
+		}
+		p_data++;
+		i--;
+	}
+
+	return 0;
+}
+
+/* stp_core.c:1779-1954 (full mode) */
+static int stp_parser_data_in_full_mode(u32 length, u8 *p_data)
+{
+	int remain_length;
+	int i = length;
+
+	while (i > 0) {
+		switch (stp.parser.state) {
+		case STP_RESYNC1:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_RESYNC2 : STP_RESYNC1);
+			break;
+		case STP_RESYNC2:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_RESYNC3 : STP_RESYNC1);
+			break;
+		case STP_RESYNC3:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_RESYNC4 : STP_RESYNC1);
+			break;
+		case STP_RESYNC4:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_SYNC : STP_RESYNC1);
+			break;
+		case STP_SYNC:
+			if ((*p_data & 0x80) == 0x80 &&
+			    (*p_data & 0x40) == 0x00) {
+				stp_change_rx_state(STP_NAK);
+				stp.parser.seq = (*p_data & 0x38) >> 3;
+				stp.parser.ack = *p_data & 0x07;
+				stp.rx_buf[0] = *p_data;
+			} else if (*p_data == 0x7f &&
+				   stp_prev_state == STP_RESYNC4) {
+				stp_err("continuous resync pattern\n");
+			} else if (*p_data == 0x7f) {
+				stp_change_rx_state(STP_RESYNC2);
+				stp_err("resync pattern start\n");
+			} else if (*p_data == 0x55) {
+				/* STP delimiter, ignored */
+			} else {
+				stp_err("unexpected byte 0x%x in sync\n",
+					*p_data);
+			}
+			break;
+		case STP_NAK:
+			stp.parser.nak = STP_ENABLE_NAK ?
+				((*p_data & 0x80) >> 7) : 0;
+			stp.parser.type = (*p_data & 0x70) >> 4;
+			stp.parser.length = (*p_data & 0x0f) << 8;
+			stp.rx_buf[1] = *p_data;
+			if (stp.parser.nak)
+				stp_err("NAK received\n");
+
+			if (stp.parser.type < MTKSTP_MAX_TASK_NUM)
+				stp_change_rx_state(STP_LENGTH);
+			else
+				stp_change_rx_state(STP_SYNC);
+			break;
+		case STP_LENGTH:
+			stp_change_rx_state(STP_CHECKSUM);
+			stp.parser.length += *p_data;
+			if (stp.parser.length > MTKSTP_MAX_PKT_SIZE) {
+				stp_err("invalid STP length %u\n",
+					stp.parser.length);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			stp.rx_buf[2] = *p_data;
+			break;
+		case STP_CHECKSUM:
+			if (stp.parser.type == STP_TASK_INDX ||
+			    stp.parser.type == INFO_TASK_INDX) {
+				stp_change_rx_state(STP_FW_MSG);
+				stp.rx_counter = 0;
+				i -= 1;
+				if (i != 0)
+					p_data += 1;
+				continue;
+			}
+
+			if (((stp.rx_buf[0] + stp.rx_buf[1] +
+			      stp.rx_buf[2]) & 0xff) != *p_data) {
+				stp_err("header checksum error %02x %02x %02x %02x\n",
+					stp.rx_buf[0], stp.rx_buf[1],
+					stp.rx_buf[2], *p_data);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+
+			if (stp.parser.length == 0) {
+				int trigger_resume;
+
+				mutex_lock(&stp.lock);
+				trigger_resume = stp_process_rxack();
+				mutex_unlock(&stp.lock);
+
+				if (trigger_resume == 0) {
+					int t;
+
+					for (t = 0; t < MTKSTP_MAX_TASK_NUM; t++)
+						if (stp_tx_event_cb[t])
+							stp_tx_event_cb[t]();
+				}
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+			} else {
+				stp_change_rx_state(STP_DATA);
+				stp.rx_counter = 0;
+			}
+			break;
+		case STP_DATA:
+			if (stp.parser.length < stp.rx_counter) {
+				stp_err("abnormal length %u/%u in DATA\n",
+					stp.parser.length, stp.rx_counter);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			remain_length = stp.parser.length - stp.rx_counter;
+			if (i >= remain_length) {
+				memcpy(stp.rx_buf + stp.rx_counter, p_data,
+				       remain_length);
+				i -= remain_length;
+				p_data += remain_length;
+				stp.rx_counter = stp.parser.length;
+				stp.parser.state = STP_CRC1;
+				continue;
+			}
+			if (i + stp.rx_counter >= MTKSTP_BUFFER_SIZE) {
+				stp_err("rx buffer overrun\n");
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			memcpy(stp.rx_buf + stp.rx_counter, p_data, i);
+			stp.rx_counter += i;
+			i = 0;
+			continue;
+		case STP_CRC1:
+			stp_change_rx_state(STP_CRC2);
+			stp.parser.crc = *p_data;
+			break;
+		case STP_CRC2:
+			stp_change_rx_state(STP_SYNC);
+			stp.parser.crc += (*p_data) << 8;
+			if (stp.parser.type == WMT_TASK_INDX)
+				stp.parser.wmt_subtype = stp.rx_buf[1];
+
+			if (crc16(0, stp.rx_buf, stp.rx_counter) !=
+			    stp.parser.crc) {
+				stp_err("payload CRC error (len %u)\n",
+					stp.rx_counter);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			stp_process_packet();
+			break;
+		case STP_FW_MSG:
+			/* Firmware assert/trace messages are not decoded; the
+			 * payload is consumed so that the stream resynchronises.
+			 * stp_core.c:2035-2165.
+			 */
+			if (stp.parser.length < stp.rx_counter) {
+				stp_err("abnormal length %u/%u in FW_MSG\n",
+					stp.parser.length, stp.rx_counter);
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			remain_length = stp.parser.length - stp.rx_counter;
+			if (i < remain_length) {
+				if (i + stp.rx_counter >= MTKSTP_BUFFER_SIZE) {
+					stp_change_rx_state(STP_RESYNC1);
+					stp.rx_counter = 0;
+					return -1;
+				}
+				memcpy(stp.rx_buf + stp.rx_counter, p_data, i);
+				stp.rx_counter += i;
+				i = 0;
+				continue;
+			}
+
+			memcpy(stp.rx_buf + stp.rx_counter, p_data,
+			       remain_length);
+			i -= remain_length;
+			p_data += remain_length;
+			stp.rx_counter = stp.parser.length;
+			stp_change_rx_state(STP_SYNC);
+
+			if (stp.parser.type == STP_TASK_INDX) {
+				/* mtk_wcn_stp_ctx_save() (stp_core.c:3300-3310):
+				 * stop transmitting and stop asking the MCU to
+				 * sleep while the dump is collected.
+				 */
+				mtk_wcn_stp_coredump_start_ctrl(1);
+				stp_psm_set_sleep_disable();
+				stp.ready = false;
+
+				if (stp.en_coredump && stp.rx_counter) {
+					stp_warn("firmware assert message (%u bytes), collecting coredump\n",
+						 stp.rx_counter);
+					stp_btm_assert(stp.rx_buf,
+						       stp.rx_counter);
+				} else {
+					stp_warn("firmware assert message (%u bytes), resetting\n",
+						 stp.rx_counter);
+					mtk_wcn_stp_coredump_start_ctrl(0);
+					schedule_work(&stp.reset_work);
+				}
+			} else {
+				stp_warn("firmware trace message (%u bytes)\n",
+					 stp.rx_counter);
+			}
+			stp.rx_counter = 0;
+
+			if (i >= 2) {
+				i -= 2;
+				if (i > 0)
+					p_data += 2;
+			}
+			continue;
+		default:
+			break;
+		}
+		p_data++;
+		i--;
+	}
+
+	return 0;
+}
+
+/*
+ * TX timeout handling (stp_core.c:345-495)
+ */
+
+static void stp_do_tx_timeout(void)
+{
+	u8 resync[4];
+	u32 seq, ret = 0;
+
+	mutex_lock(&stp.lock);
+
+	if (stp.sequence.retry_times > MTKSTP_RETRY_LIMIT) {
+		stp_info("retry limit reached, stop\n");
+		mutex_unlock(&stp.lock);
+		return;
+	}
+
+	seq = (stp.sequence.rxack + 1) & 0x7;
+	if (seq != stp.sequence.txseq) {
+		memset(resync, 0x7f, sizeof(resync));
+		stp_sys_if_tx(resync, sizeof(resync), &ret);
+		if (ret != sizeof(resync))
+			stp_err("failed to send resync pattern\n");
+
+		do {
+			stp_warn("resend STP packet seq %u\n", seq);
+			stp_send_tx_queue(seq);
+			seq = (seq + 1) & 0x7;
+		} while (seq != stp.sequence.txseq);
+	}
+
+	timer_delete(&stp.tx_timer);
+	if (stp.sequence.winspace != MTKSTP_WINSIZE) {
+		mod_timer(&stp.tx_timer,
+			  jiffies + msecs_to_jiffies(MTKSTP_TX_TIMEOUT));
+		stp.sequence.retry_times++;
+		if (stp.sequence.retry_times > MTKSTP_RETRY_LIMIT) {
+			timer_delete(&stp.tx_timer);
+			stp_err("TX retry limit %d, resetting CONSYS\n",
+				MTKSTP_RETRY_LIMIT);
+			stp.ready = false;
+			mutex_unlock(&stp.lock);
+			schedule_work(&stp.reset_work);
+			return;
+		}
+	}
+
+	mutex_unlock(&stp.lock);
+}
+
+static void stp_tx_timeout_work_fn(struct work_struct *work)
+{
+	stp_do_tx_timeout();
+}
+
+static void stp_tx_timeout_cb(struct timer_list *timer)
+{
+	schedule_work(&stp.tx_timeout_work);
+}
+
+static void stp_reset_work_fn(struct work_struct *work)
+{
+	wmt_lib_schedule_reset(WMTRSTSRC_RESET_STP);
+}
+
+/*
+ * Public STP API
+ */
+
+bool mtk_wcn_stp_is_ready(void)
+{
+	return stp_ctx_ready && stp.ready;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_is_ready);
+
+/* The actual frame builder, shared by the PSM-filtered path and the
+ * hold-FIFO release path.
+ */
+static int __stp_send_data(const u8 *buffer, u32 length, u8 type)
+{
+	u8 header[MTKSTP_HEADER_SIZE], crc_bytes[2];
+	u16 crc;
+	u32 written = 0;
+	int ret = 0;
+
+	mutex_lock(&stp.lock);
+
+	if (!stp.enabled && type != WMT_TASK_INDX) {
+		mutex_unlock(&stp.lock);
+		return -EAGAIN;
+	}
+
+	if (stp.enabled && mtk_wcn_stp_is_btif_mand_mode()) {
+		/* stp_core.c:2512-2555 */
+		header[0] = 0x80;
+		header[1] = (type << 4) + ((length >> 8) & 0x0f);
+		header[2] = length & 0xff;
+		header[3] = 0x00;
+
+		memcpy(stp.tx_buf, header, MTKSTP_HEADER_SIZE);
+		memcpy(stp.tx_buf + MTKSTP_HEADER_SIZE, buffer, length);
+		crc_bytes[0] = 0;
+		crc_bytes[1] = 0;
+		memcpy(stp.tx_buf + MTKSTP_HEADER_SIZE + length, crc_bytes, 2);
+
+		stp_sys_if_tx(stp.tx_buf,
+			      MTKSTP_HEADER_SIZE + length + MTKSTP_CRC_SIZE,
+			      &written);
+		if (written == MTKSTP_HEADER_SIZE + length + MTKSTP_CRC_SIZE)
+			ret = length;
+		else
+			ret = -EIO;
+		mutex_unlock(&stp.lock);
+		return ret;
+	}
+
+	if (stp.enabled && mtk_wcn_stp_is_btif_fullset_mode()) {
+		if (stp.sequence.winspace > 0 &&
+		    stp_tx_room(MTKSTP_HEADER_SIZE + length +
+				MTKSTP_CRC_SIZE)) {
+			header[0] = 0x80 +
+				    (stp.sequence.txseq << 3) +
+				    stp.sequence.txack;
+			header[1] = (type << 4) + ((length & 0xf00) >> 8);
+			header[2] = length & 0xff;
+			header[3] = (header[0] + header[1] + header[2]) & 0xff;
+
+			stp.tx_start_addr[stp.sequence.txseq] = stp.tx_write;
+			stp.tx_length[stp.sequence.txseq] =
+				MTKSTP_HEADER_SIZE + length + MTKSTP_CRC_SIZE;
+
+			if (STP_ENABLE_DELIMITER) {
+				stp.tx_length[stp.sequence.txseq] +=
+					STP_DEL_SIZE;
+				stp_add_to_tx_queue(stp_delimiter,
+						    STP_DEL_SIZE);
+			}
+
+			stp_add_to_tx_queue(header, MTKSTP_HEADER_SIZE);
+			stp_add_to_tx_queue(buffer, length);
+
+			crc = crc16(0, buffer, length);
+			crc_bytes[0] = crc & 0xff;
+			crc_bytes[1] = (crc & 0xff00) >> 8;
+			stp_add_to_tx_queue(crc_bytes, 2);
+
+			stp_send_tx_queue(stp.sequence.txseq);
+			stp.sequence.txseq =
+				(stp.sequence.txseq + 1) & 0x7;
+			stp.sequence.winspace--;
+
+			timer_delete(&stp.tx_timer);
+			if (stp.sequence.winspace != MTKSTP_WINSIZE)
+				mod_timer(&stp.tx_timer,
+					  jiffies +
+					  msecs_to_jiffies(MTKSTP_TX_TIMEOUT));
+
+			ret = length;
+		} else {
+			stp_err("no window space / tx room\n");
+			ret = 0;
+		}
+	}
+
+	mutex_unlock(&stp.lock);
+
+	return ret;
+}
+
+int mtk_wcn_stp_send_data(const u8 *buffer, u32 length, u8 type)
+{
+	bool psm_locked = false;
+	int ret;
+
+	if (!buffer)
+		return -EINVAL;
+	if (length > MTKSTP_MAX_PKT_SIZE)
+		return -EINVAL;
+
+	if (stp.wmt_last_close) {
+		stp_err("link closed by WMT, dropping tx\n");
+		return length;
+	}
+
+	/* Firmware assert/coredump in progress: drop everything, as the
+	 * downstream driver does while f_coredump is set (stp_core.c:2420).
+	 */
+	if (stp.f_coredump) {
+		stp_warn("firmware coredump in progress, dropping tx\n");
+		return length;
+	}
+
+	/* PSM filtering (stp_core.c:2428-2510).  When PSM is disabled this
+	 * returns 0 and no lock is taken, i.e. the link stays always-awake.
+	 */
+	ret = stp_psm_tx_begin(buffer, length, type, &psm_locked);
+	if (ret) {
+		if (ret > 0)
+			return ret;	/* queued in the hold FIFO */
+		return ret;
+	}
+
+	ret = __stp_send_data(buffer, length, type);
+	stp_psm_tx_end(type, psm_locked);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_send_data);
+
+/* Transmit without the PSM filter.  Used by the PSM engine itself when it
+ * releases data after a wakeup: re-entering the filter would deadlock on the
+ * PSM API lock.
+ */
+int mtk_wcn_stp_send_data_no_ps(const u8 *buffer, u32 length, u8 type)
+{
+	if (!buffer)
+		return -EINVAL;
+	if (length > MTKSTP_MAX_PKT_SIZE)
+		return -EINVAL;
+	if (stp.wmt_last_close)
+		return length;
+	if (stp.f_coredump)
+		return length;
+
+	return __stp_send_data(buffer, length, type);
+}
+
+/* Raw channel used by WMT before STP is formally enabled (stp_core.c:2653-2700).
+ */
+int mtk_wcn_stp_send_data_raw(const u8 *buffer, u32 length, u8 type)
+{
+	u32 written = 0;
+
+	if (!buffer)
+		return -EINVAL;
+
+	if (stp.wmt_last_close) {
+		stp_err("link closed by WMT, dropping raw tx\n");
+		return length;
+	}
+
+	mutex_lock(&stp.lock);
+	stp.pending_type = type;
+	stp_sys_if_tx(buffer, length, &written);
+	mutex_unlock(&stp.lock);
+
+	if (written == length)
+		return written;
+
+	stp_err("raw tx %u/%u\n", length, written);
+	return -EIO;
+}
+
+int mtk_wcn_stp_receive_data(u8 *buffer, u32 length, u8 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+	u32 copy_len = 0, tail_len;
+
+	if (!buffer || type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+
+	while (ring->read_p != ring->write_p) {
+		if (ring->write_p > ring->read_p) {
+			copy_len = ring->write_p - ring->read_p;
+			if (copy_len > length)
+				copy_len = length;
+			memcpy(buffer, ring->buffer + ring->read_p, copy_len);
+			ring->read_p += copy_len;
+		} else {
+			tail_len = MTKSTP_BUFFER_SIZE - ring->read_p;
+			if (tail_len > length) {
+				copy_len = length;
+				memcpy(buffer, ring->buffer + ring->read_p,
+				       copy_len);
+				ring->read_p += copy_len;
+			} else {
+				memcpy(buffer, ring->buffer + ring->read_p,
+				       tail_len);
+				buffer += tail_len;
+
+				copy_len = length - tail_len;
+				copy_len = min(copy_len, ring->write_p);
+				if (copy_len)
+					memcpy(buffer, ring->buffer, copy_len);
+				ring->read_p = copy_len;
+				copy_len += tail_len;
+			}
+		}
+		break;
+	}
+
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	stp_psm_rx_done(type, copy_len);
+
+	return copy_len;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_receive_data);
+
+bool mtk_wcn_stp_is_rxqueue_empty(u8 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+	bool empty;
+
+	if (type >= MTKSTP_MAX_TASK_NUM)
+		return true;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+	empty = ring->read_p == ring->write_p;
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	return empty;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_is_rxqueue_empty);
+
+/* stp_core.c:2233-2300 */
+int mtk_wcn_stp_parser_data(u8 *buffer, u32 length)
+{
+	int ret = 0;
+
+	if (!buffer)
+		return -EINVAL;
+
+	if (!stp_ctx_ready)
+		return -ENODEV;
+
+	if (!stp.enabled) {
+		if (stp.pending_type == WMT_TASK_INDX) {
+			/* Raw WMT traffic before STP is enabled. */
+			stp_add_to_rx_queue(buffer, length, WMT_TASK_INDX);
+			if (stp_event_cb[WMT_TASK_INDX])
+				stp_event_cb[WMT_TASK_INDX]();
+		}
+		return 0;
+	}
+
+	mutex_lock(&stp.parse_lock);
+	if (mtk_wcn_stp_is_btif_mand_mode())
+		ret = stp_parser_data_in_mand_mode(length, buffer);
+	else if (mtk_wcn_stp_is_btif_fullset_mode())
+		ret = stp_parser_data_in_full_mode(length, buffer);
+	mutex_unlock(&stp.parse_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_parser_data);
+
+int mtk_wcn_stp_register_event_cb(int type, mtk_wcn_stp_event_cb func)
+{
+	if (type < 0 || type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	stp_event_cb[type] = func;
+
+	/* stp_exp.c:200-216: a new consumer always starts with an empty queue. */
+	mtk_wcn_stp_flush_rx_queue(type);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_event_cb);
+
+int mtk_wcn_stp_register_tx_event_cb(int type, mtk_wcn_stp_event_cb func)
+{
+	if (type < 0 || type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	stp_tx_event_cb[type] = func;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_tx_event_cb);
+
+int mtk_wcn_stp_register_if_rx(mtk_wcn_stp_if_rx func)
+{
+	stp_if_rx = func;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_if_rx);
+
+int mtk_wcn_stp_register_if_tx(enum mtk_wcn_stp_tx_if stp_interface,
+			       mtk_wcn_stp_if_tx func)
+{
+	if (stp_interface >= STP_TX_IF_MAX) {
+		stp_warn("STP_IF_TX(%d) out of boundary\n", stp_interface);
+		return -EINVAL;
+	}
+
+	stp_if_tx[stp_interface] = func;
+	if (func && stp_if_type == STP_TX_IF_MAX)
+		stp_if_type = stp_interface;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_if_tx);
+
+/*
+ * Internal STP control used by the WMT core
+ */
+
+int stp_drv_init(void)
+{
+	int i;
+
+	memset(&stp, 0, sizeof(stp));
+	mutex_init(&stp.lock);
+	mutex_init(&stp.parse_lock);
+
+	for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++)
+		spin_lock_init(&stp.ring[i].lock);
+
+	timer_setup(&stp.tx_timer, stp_tx_timeout_cb, 0);
+	INIT_WORK(&stp.tx_timeout_work, stp_tx_timeout_work_fn);
+	INIT_WORK(&stp.reset_work, stp_reset_work_fn);
+
+	stp.enabled = false;
+	stp.ready = false;
+	stp.bluez = false;
+	stp.mode = 0;
+	stp.pending_type = 0;
+	stp.wmt_last_close = 0;
+	stp.evt_err_assert = 0;
+	stp.en_coredump = true;
+	stp.f_coredump = false;
+
+	i = stp_psm_init();
+	if (i)
+		return i;
+
+	i = stp_btm_init();
+	if (i) {
+		stp_psm_deinit();
+		return i;
+	}
+
+	stp_ctx_ready = 1;
+	return 0;
+}
+
+void stp_drv_exit(void)
+{
+	if (!stp_ctx_ready)
+		return;
+
+	stp_ctx_ready = 0;
+	cancel_work_sync(&stp.reset_work);
+	cancel_work_sync(&stp.tx_timeout_work);
+	timer_delete_sync(&stp.tx_timer);
+
+	stp_btm_deinit();
+	stp_psm_deinit();
+
+	mutex_lock(&stp.lock);
+	stp.enabled = false;
+	stp.ready = false;
+	memset(stp_event_cb, 0, sizeof(stp_event_cb));
+	memset(stp_tx_event_cb, 0, sizeof(stp_tx_event_cb));
+	memset(stp_if_tx, 0, sizeof(stp_if_tx));
+	stp_if_rx = NULL;
+	stp_if_type = STP_TX_IF_MAX;
+	mutex_unlock(&stp.lock);
+
+	mutex_destroy(&stp.parse_lock);
+	mutex_destroy(&stp.lock);
+}
+
+int mtk_wcn_stp_enable(int value)
+{
+	mutex_lock(&stp.parse_lock);
+	mutex_lock(&stp.lock);
+	stp_rest_ctx_state();
+	stp.enabled = !!value;
+	mutex_unlock(&stp.lock);
+	mutex_unlock(&stp.parse_lock);
+
+	/* stp_core.c:2280-2290 */
+	if (!value) {
+		mtk_wcn_stp_psm_reset();
+		stp_btm_reset();
+		stp.f_coredump = false;
+	} else {
+		mtk_wcn_stp_coredump_start_ctrl(0);
+	}
+
+	stp_dbg("STP %s\n", value ? "enabled" : "disabled");
+	return 0;
+}
+
+int mtk_wcn_stp_ready(int value)
+{
+	if (!stp_ctx_ready)
+		return -ENODEV;
+
+	stp.ready = !!value;
+	stp_dbg("STP %s\n", value ? "ready" : "not ready");
+	return 0;
+}
+
+void mtk_wcn_stp_flush_rx_queue(u32 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+
+	if (type >= MTKSTP_MAX_TASK_NUM)
+		return;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+	ring->read_p = 0;
+	ring->write_p = 0;
+	spin_unlock_irqrestore(&ring->lock, flags);
+}
+
+void mtk_wcn_stp_flush_context(void)
+{
+	if (!stp_ctx_ready)
+		return;
+
+	mutex_lock(&stp.parse_lock);
+	mutex_lock(&stp.lock);
+	stp_rest_ctx_state();
+	mutex_unlock(&stp.lock);
+	mutex_unlock(&stp.parse_lock);
+}
+
+void mtk_wcn_stp_set_mode(u32 mode)
+{
+	stp.mode = mode;
+	stp_dbg("STP mode 0x%08x\n", mode);
+}
+
+void mtk_wcn_stp_set_if_tx_type(enum mtk_wcn_stp_tx_if type)
+{
+	if (type >= STP_TX_IF_MAX) {
+		stp_err("invalid tx interface %d\n", type);
+		return;
+	}
+
+	stp_if_type = type;
+}
+
+void mtk_wcn_stp_set_bluez(bool bluez)
+{
+	stp.bluez = bluez;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_set_bluez);
+
+bool mtk_wcn_stp_is_btif_fullset_mode(void)
+{
+	return stp.mode & MTKSTP_BTIF_FULL_MODE;
+}
+
+bool mtk_wcn_stp_is_btif_mand_mode(void)
+{
+	return stp.mode & MTKSTP_BTIF_MAND_MODE;
+}
+
+int mtk_wcn_stp_set_wmt_last_close(u32 value)
+{
+	stp.wmt_last_close = value;
+	stp_dbg("wmt_last_close %u\n", value);
+	return 0;
+}
+
+/* stp_core.c:3300-3330 */
+u32 mtk_wcn_stp_get_wmt_evt_err_trg_assert(void)
+{
+	return stp.evt_err_assert;
+}
+
+void mtk_wcn_stp_set_wmt_evt_err_trg_assert(u32 value)
+{
+	stp_info("event error assert flag %u\n", value);
+	stp.evt_err_assert = value;
+}
+
+/* stp_core.c:2342-2375 */
+int mtk_wcn_stp_coredump_start_ctrl(u32 value)
+{
+	stp_info("set f/w assert (%u)\n", value);
+	stp.f_coredump = !!value;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_coredump_start_ctrl);
+
+u32 mtk_wcn_stp_coredump_start_get(void)
+{
+	return stp.f_coredump;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_coredump_start_get);
+
+int mtk_wcn_stp_coredump_flag_ctrl(u32 on)
+{
+	stp.en_coredump = !!on;
+	stp_info("coredump collection %s\n", on ? "enabled" : "disabled");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_coredump_flag_ctrl);
+
+int mtk_wcn_stp_coredump_flag_get(void)
+{
+	return stp.en_coredump;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_coredump_flag_get);
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_dbg.c b/drivers/misc/mediatek/connectivity/wmt/stp_dbg.c
new file mode 100644
index 000000000..0c8c1a268
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_dbg.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN STP debug / coredump generic-netlink ABI.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/stp_dbg.c
+ *     (STP_DBG family, stp_dbg_nl_bind/reset/send, stp_dbg.c:83-160,
+ *      1240-1320)
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * Userspace contract (unchanged from downstream):
+ *   family name  : "STP_DBG"
+ *   commands     : 1 = STP_DBG_COMMAND_BIND, 2 = STP_DBG_COMMAND_RESET
+ *   attributes   : 1 = STP_DBG_ATTR_MSG
+ *
+ * A vendor daemon binds by sending STP_DBG_COMMAND_BIND; the kernel records
+ * its netlink port id.  Coredump data is then pushed with
+ * STP_DBG_COMMAND_RESET and the payload in STP_DBG_ATTR_MSG, framed as
+ *
+ *	'[' 'M' ']' | u16 chunk_len | chunk_len bytes
+ *
+ * which is exactly what _stp_btm_put_emi_dump_to_nl() produced downstream
+ * (btm_core.c:189-242).
+ */
+
+#include <linux/module.h>
+#include <linux/netlink.h>
+#include <net/genetlink.h>
+
+#include "wmt_local.h"
+
+#define STP_DBG_PFX	"STPDbg: "
+
+#define stp_dbg_err(fmt, ...)	pr_err(STP_DBG_PFX fmt, ##__VA_ARGS__)
+#define stp_dbg_warn(fmt, ...)	pr_warn(STP_DBG_PFX fmt, ##__VA_ARGS__)
+#define stp_dbg_info(fmt, ...)	pr_info(STP_DBG_PFX fmt, ##__VA_ARGS__)
+#define stp_dbg_dbg(fmt, ...)	pr_debug(STP_DBG_PFX fmt, ##__VA_ARGS__)
+
+#define STP_DBG_FAMILY_NAME	"STP_DBG"
+#define STP_DBG_FAMILY_VERSION	1
+#define STP_DBG_MAX_BIND	4
+
+enum {
+	__STP_DBG_ATTR_INVALID,
+	STP_DBG_ATTR_MSG,
+	__STP_DBG_ATTR_MAX,
+};
+#define STP_DBG_ATTR_MAX	(__STP_DBG_ATTR_MAX - 1)
+
+enum {
+	__STP_DBG_COMMAND_INVALID,
+	STP_DBG_COMMAND_BIND,
+	STP_DBG_COMMAND_RESET,
+	__STP_DBG_COMMAND_MAX,
+};
+
+static int stp_dbg_bind_pid[STP_DBG_MAX_BIND];
+static int stp_dbg_bind_num;
+static u32 stp_dbg_seqnum;
+static DEFINE_MUTEX(stp_dbg_nl_lock);
+
+static int stp_dbg_nl_bind(struct sk_buff *skb, struct genl_info *info)
+{
+	int i;
+	int ret = 0;
+
+	if (!info)
+		return 0;
+
+	mutex_lock(&stp_dbg_nl_lock);
+
+	for (i = 0; i < stp_dbg_bind_num; i++) {
+		if (stp_dbg_bind_pid[i] == info->snd_portid) {
+			stp_dbg_info("pid %d already bound\n", info->snd_portid);
+			goto out;
+		}
+	}
+
+	if (stp_dbg_bind_num >= STP_DBG_MAX_BIND) {
+		stp_dbg_warn("exceeding binding limit %d\n", STP_DBG_MAX_BIND);
+		ret = -ENOSPC;
+		goto out;
+	}
+
+	stp_dbg_bind_pid[stp_dbg_bind_num++] = info->snd_portid;
+	stp_dbg_info("pid %d bound\n", info->snd_portid);
+out:
+	mutex_unlock(&stp_dbg_nl_lock);
+	return ret;
+}
+
+static int stp_dbg_nl_reset(struct sk_buff *skb, struct genl_info *info)
+{
+	/* Downstream stp_dbg.c:1267-1271: the command is reserved for the
+	 * kernel-to-daemon direction and must not be invoked.
+	 */
+	stp_dbg_warn("STP_DBG_COMMAND_RESET is kernel-to-userspace only\n");
+	return 0;
+}
+
+static const struct nla_policy stp_dbg_genl_policy[STP_DBG_ATTR_MAX + 1] = {
+	[STP_DBG_ATTR_MSG] = { .type = NLA_NUL_STRING },
+};
+
+static const struct genl_ops stp_dbg_gnl_ops[] = {
+	{
+		.cmd = STP_DBG_COMMAND_BIND,
+		.doit = stp_dbg_nl_bind,
+		.policy = stp_dbg_genl_policy,
+	},
+	{
+		.cmd = STP_DBG_COMMAND_RESET,
+		.doit = stp_dbg_nl_reset,
+		.policy = stp_dbg_genl_policy,
+	},
+};
+
+static struct genl_family stp_dbg_gnl_family = {
+	.name = STP_DBG_FAMILY_NAME,
+	.version = STP_DBG_FAMILY_VERSION,
+	.maxattr = STP_DBG_ATTR_MAX,
+	.module = THIS_MODULE,
+	.ops = stp_dbg_gnl_ops,
+	.n_ops = ARRAY_SIZE(stp_dbg_gnl_ops),
+};
+
+int stp_dbg_nl_send(const u8 *data, u8 cmd, u32 len)
+{
+	struct sk_buff *skb;
+	void *msg_head;
+	int i, rc;
+
+	if (!len || !data)
+		return -EINVAL;
+
+	mutex_lock(&stp_dbg_nl_lock);
+
+	if (!stp_dbg_bind_num) {
+		mutex_unlock(&stp_dbg_nl_lock);
+		stp_dbg_dbg("no bound process, %u bytes dropped\n", len);
+		return 0;
+	}
+
+	for (i = 0; i < stp_dbg_bind_num; i++) {
+		skb = genlmsg_new(nla_total_size(len) + GENL_HDRLEN,
+				  GFP_KERNEL);
+		if (!skb) {
+			mutex_unlock(&stp_dbg_nl_lock);
+			return -ENOMEM;
+		}
+
+		msg_head = genlmsg_put(skb, 0, stp_dbg_seqnum++,
+				       &stp_dbg_gnl_family, 0, cmd);
+		if (!msg_head) {
+			nlmsg_free(skb);
+			mutex_unlock(&stp_dbg_nl_lock);
+			return -EMSGSIZE;
+		}
+
+		rc = nla_put(skb, STP_DBG_ATTR_MSG, len, data);
+		if (rc) {
+			nlmsg_free(skb);
+			mutex_unlock(&stp_dbg_nl_lock);
+			return rc;
+		}
+
+		genlmsg_end(skb, msg_head);
+
+		rc = genlmsg_unicast(&init_net, skb, stp_dbg_bind_pid[i]);
+		if (rc) {
+			/* A process that died between bind and now: drop it. */
+			stp_dbg_warn("unicast to %d failed (%d)\n",
+				     stp_dbg_bind_pid[i], rc);
+			stp_dbg_bind_pid[i] = stp_dbg_bind_pid[--stp_dbg_bind_num];
+			i--;
+		}
+	}
+
+	mutex_unlock(&stp_dbg_nl_lock);
+	return 0;
+}
+
+int stp_dbg_nl_init(void)
+{
+	int ret;
+
+	ret = genl_register_family(&stp_dbg_gnl_family);
+	if (ret) {
+		stp_dbg_err("generic netlink family registration failed (%d)\n",
+			    ret);
+		return ret;
+	}
+
+	stp_dbg_info("family %s registered\n", STP_DBG_FAMILY_NAME);
+	return 0;
+}
+
+void stp_dbg_nl_deinit(void)
+{
+	genl_unregister_family(&stp_dbg_gnl_family);
+
+	mutex_lock(&stp_dbg_nl_lock);
+	stp_dbg_bind_num = 0;
+	mutex_unlock(&stp_dbg_nl_lock);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_psm.c b/drivers/misc/mediatek/connectivity/wmt/stp_psm.c
new file mode 100644
index 000000000..0cdc4b824
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_psm.c
@@ -0,0 +1,1283 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN STP power-saving engine (PSM).
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/psm_core.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/include/psm_core.h
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_lib.c
+ *     (wmt_lib_ps_handler, wmt_lib_ps_action)
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * Port notes:
+ *   - The downstream "mtk_stp_psm" thread and its op queue are replaced by a
+ *     single-threaded workqueue and a redundant-filtered request ring.  The
+ *     four-state machine, the flag handshake and the WMT SLEEP / WAKEUP /
+ *     HOST_AWAKE command sequence are unchanged (psm_core.c:1000-1380).
+ *   - Every WMT exchange is issued through wmt_lib_run_op(), i.e. on the
+ *     existing WMT operation thread under g_wmt.op_lock.  PSM never calls a
+ *     WMT operation while the caller holds op_lock: the internal entry points
+ *     only queue a request (see stp_psm_request_*).
+ *   - The MMC/SDIO ownership handshake and the AP deep-idle callback of the
+ *     downstream handler do not exist here; the sleep side effect is the BTIF
+ *     DPIDLE control of the STP channel, which is the same hardware state the
+ *     downstream driver reached through mt_combo_plt_enter_deep_idle().
+ */
+
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/suspend.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+
+#include "wmt_local.h"
+#include "stp_psm.h"
+
+/* Request ring entry.  The order of the values matters: ENABLE/DISABLE are
+ * control requests, the rest are the downstream PSM actions.
+ */
+enum psm_req {
+	PSM_REQ_ENABLE = 0x80,
+	PSM_REQ_DISABLE = 0x81,
+};
+
+struct stp_psm {
+	struct mutex api_lock;		/* data path <-> state machine */
+	spinlock_t lock;		/* state, flags, FIFO, requests */
+
+	enum mtk_wcn_stp_psm_state state;
+	unsigned long flags;
+	int sleep_en;
+	u32 idle_time;
+
+	bool initialized;
+	bool enabled;			/* monitor armed by the current boot */
+	bool user_enabled;		/* requested through the public API */
+	u32 user_idle_time;
+	bool quick_ps_support;
+	bool pm_suspending;
+
+	struct timer_list timer;
+	struct work_struct work;
+	wait_queue_head_t wmt_wq;
+	unsigned int wmt_event;		/* bit mask of STP_PSM_WMT_EVENT_*_EN */
+
+	u8 req[STP_OP_BUF_SIZE];
+	unsigned int req_head;
+	unsigned int req_count;
+	u8 last_done;
+
+	u8 hold[STP_PSM_FIFO_SIZE];
+	u32 hold_len;
+	u8 out_buf[STP_PSM_TX_SIZE];
+
+	/* Traffic density sampling (psm_core.c:1401-1490). */
+	ktime_t sample_end;
+	bool sample_start;
+	int tx_sum_len;
+	int rx_sum_len;
+
+	int wl_count;
+	int last_err;			/* result of the last enable/disable */
+	struct notifier_block pm_nb;
+};
+
+static struct stp_psm *psm;
+static unsigned int psm_dbg_level = 2;
+module_param_named(psm_dbg_level, psm_dbg_level, uint, 0644);
+MODULE_PARM_DESC(psm_dbg_level, "STP PSM trace level, 0=err .. 4=loud");
+
+static bool psm_quick_ps = true;
+module_param_named(quick_ps, psm_quick_ps, bool, 0644);
+MODULE_PARM_DESC(quick_ps, "allow the quick-PS path while the system suspends");
+
+#define PSM_ERR(fmt, ...)	pr_err("[STP-PSM][E]%s: " fmt, __func__, ##__VA_ARGS__)
+#define PSM_WRN(fmt, ...)	do { if (psm_dbg_level >= 1) \
+		pr_warn("[STP-PSM][W]%s: " fmt, __func__, ##__VA_ARGS__); } while (0)
+#define PSM_INF(fmt, ...)	do { if (psm_dbg_level >= 2) \
+		pr_info("[STP-PSM][I]%s: " fmt, __func__, ##__VA_ARGS__); } while (0)
+#define PSM_DBG(fmt, ...)	do { if (psm_dbg_level >= 3) \
+		pr_debug("[STP-PSM][D]%s: " fmt, __func__, ##__VA_ARGS__); } while (0)
+
+static const char * const psm_state_name[] = {
+	"ACT", "ACT_INACT", "INACT", "INACT_ACT",
+};
+
+/*
+ * Small helpers
+ */
+
+static bool psm_flag(int bit)
+{
+	unsigned long flags;
+	bool set;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	set = test_bit(bit, &psm->flags);
+	spin_unlock_irqrestore(&psm->lock, flags);
+	return set;
+}
+
+static void psm_set_flag(int bit, bool on)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	if (on)
+		set_bit(bit, &psm->flags);
+	else
+		clear_bit(bit, &psm->flags);
+	spin_unlock_irqrestore(&psm->lock, flags);
+}
+
+static enum mtk_wcn_stp_psm_state psm_get_state(void)
+{
+	unsigned long flags;
+	enum mtk_wcn_stp_psm_state state;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	state = psm->state;
+	spin_unlock_irqrestore(&psm->lock, flags);
+	return state;
+}
+
+static void psm_set_state_internal(enum mtk_wcn_stp_psm_state state)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	psm->state = state;
+	/* psm_core.c:640-660: leaving ACT blocks traffic. */
+	if (state != MTK_WCN_STP_PSM_ACT)
+		set_bit(STP_PSM_BLOCK_DATA_EN, &psm->flags);
+	spin_unlock_irqrestore(&psm->lock, flags);
+	PSM_DBG("state -> %s\n", psm_state_name[state]);
+}
+
+/* Wake lock, nesting counted locally (platform helper is not nesting-safe
+ * for unbalanced calls).
+ */
+static void psm_wake_lock_get(void)
+{
+	unsigned long flags;
+	bool get = false;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	if (psm->wl_count++ == 0)
+		get = true;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	if (get)
+		wmt_plat_wake_lock_ctrl(WL_OP_GET);
+}
+
+static void psm_wake_lock_put(void)
+{
+	unsigned long flags;
+	bool put = false;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	if (psm->wl_count > 0 && --psm->wl_count == 0)
+		put = true;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	if (put)
+		wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+}
+
+/*
+ * Request ring (replacement of the downstream op queue)
+ */
+
+static bool psm_action_is_wakeup(u8 action)
+{
+	return action == MTK_WCN_STP_PSM_WAKEUP ||
+	       action == MTK_WCN_STP_PSM_HOST_AWAKE;
+}
+
+static u8 psm_req_at(unsigned int index)
+{
+	return psm->req[(psm->req_head + index) % STP_OP_BUF_SIZE];
+}
+
+/* psm_core.c:196-260: drop redundant sleep/wakeup requests. */
+static bool psm_req_is_redundant(u8 action)
+{
+	u8 prev;
+
+	if (action == PSM_REQ_ENABLE || action == PSM_REQ_DISABLE)
+		return false;
+
+	if (psm->req_count)
+		prev = psm_req_at(psm->req_count - 1);
+	else
+		prev = psm->last_done;
+
+	if (action == MTK_WCN_STP_PSM_SLEEP)
+		return prev == MTK_WCN_STP_PSM_SLEEP;
+
+	if (psm_action_is_wakeup(action))
+		return psm_action_is_wakeup(prev);
+
+	return false;
+}
+
+/* psm_core.c:262-290 */
+static void psm_req_cleanup(void)
+{
+	while (psm->req_count > 2) {
+		u8 prev = psm_req_at(psm->req_count - 1);
+		u8 prev2 = psm_req_at(psm->req_count - 2);
+
+		if ((prev == MTK_WCN_STP_PSM_SLEEP && psm_action_is_wakeup(prev2)) ||
+		    (psm_action_is_wakeup(prev) && prev2 == MTK_WCN_STP_PSM_SLEEP)) {
+			psm->req_count -= 2;
+		} else if (prev == prev2) {
+			psm->req_count--;
+		} else {
+			break;
+		}
+	}
+}
+
+static void psm_req_put(u8 action)
+{
+	unsigned long flags;
+	unsigned int tail;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	if (psm_req_is_redundant(action)) {
+		spin_unlock_irqrestore(&psm->lock, flags);
+		PSM_DBG("skip redundant request 0x%02x\n", action);
+		return;
+	}
+
+	if (psm->req_count >= STP_OP_BUF_SIZE) {
+		/* Mirror the downstream "active queue full" behaviour: the
+		 * newest request is dropped, the state machine still converges
+		 * through the idle monitor.
+		 */
+		spin_unlock_irqrestore(&psm->lock, flags);
+		PSM_WRN("request queue full, dropping 0x%02x\n", action);
+		return;
+	}
+
+	tail = (psm->req_head + psm->req_count) % STP_OP_BUF_SIZE;
+	psm->req[tail] = action;
+	psm->req_count++;
+	psm_req_cleanup();
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	schedule_work(&psm->work);
+}
+
+static bool psm_req_get(u8 *action)
+{
+	unsigned long flags;
+	bool got = false;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	if (psm->req_count) {
+		*action = psm->req[psm->req_head];
+		psm->req_head = (psm->req_head + 1) % STP_OP_BUF_SIZE;
+		psm->req_count--;
+		got = true;
+	}
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	return got;
+}
+
+static void psm_req_drain(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	psm->req_count = 0;
+	spin_unlock_irqrestore(&psm->lock, flags);
+}
+
+/*
+ * Hold FIFO (psm_core.c:745-860)
+ */
+
+static int psm_hold_data_locked(const u8 *buffer, u32 len, u8 type)
+{
+	unsigned long flags;
+	const u8 delimiter[2] = { 0xbb, 0xbb };
+	u32 need = len + sizeof(u8) + sizeof(u32) + sizeof(delimiter);
+
+	if (len > STP_PSM_PACKET_SIZE_MAX) {
+		PSM_ERR("packet too long (%u)\n", len);
+		return -EMSGSIZE;
+	}
+
+	spin_lock_irqsave(&psm->lock, flags);
+	if (STP_PSM_FIFO_SIZE - psm->hold_len < need) {
+		PSM_ERR("hold FIFO full, dropping %u queued bytes\n",
+			psm->hold_len);
+		psm->hold_len = 0;
+	}
+	memcpy(psm->hold + psm->hold_len, &type, sizeof(type));
+	psm->hold_len += sizeof(type);
+	memcpy(psm->hold + psm->hold_len, &len, sizeof(len));
+	psm->hold_len += sizeof(len);
+	memcpy(psm->hold + psm->hold_len, buffer, len);
+	psm->hold_len += len;
+	memcpy(psm->hold + psm->hold_len, delimiter, sizeof(delimiter));
+	psm->hold_len += sizeof(delimiter);
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	return len;
+}
+
+static int psm_has_pending_data(void)
+{
+	unsigned long flags;
+	u32 len;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	len = psm->hold_len;
+	spin_unlock_irqrestore(&psm->lock, flags);
+	return len;
+}
+
+/* Release queued packets to STP without re-entering PSM.  The caller holds
+ * api_lock, so no other context can consume the FIFO concurrently.
+ */
+static int psm_release_data(void)
+{
+	int i;
+
+	for (i = 0; i < 20 && psm_has_pending_data(); i++) {
+		unsigned long flags;
+		u8 type = 0;
+		u32 len = 0;
+		u8 delimiter[2] = { 0, 0 };
+		u32 avail;
+
+		spin_lock_irqsave(&psm->lock, flags);
+		avail = psm->hold_len;
+
+		memcpy(&type, psm->hold, sizeof(type));
+		memcpy(&len, psm->hold + sizeof(type), sizeof(len));
+
+		if (len > STP_PSM_PACKET_SIZE_MAX ||
+		    sizeof(type) + sizeof(len) + len + sizeof(delimiter) > avail) {
+			psm->hold_len = 0;
+			spin_unlock_irqrestore(&psm->lock, flags);
+			PSM_ERR("corrupt hold FIFO, dropped\n");
+			return -EIO;
+		}
+
+		memcpy(psm->out_buf, psm->hold + sizeof(type) + sizeof(len),
+		       len);
+		memcpy(delimiter,
+		       psm->hold + sizeof(type) + sizeof(len) + len,
+		       sizeof(delimiter));
+		memmove(psm->hold,
+			psm->hold + sizeof(type) + sizeof(len) + len +
+				sizeof(delimiter),
+			avail - (sizeof(type) + sizeof(len) + len +
+				 sizeof(delimiter)));
+		psm->hold_len -= sizeof(type) + sizeof(len) + len +
+				 sizeof(delimiter);
+		spin_unlock_irqrestore(&psm->lock, flags);
+
+		if (delimiter[0] != 0xbb || delimiter[1] != 0xbb) {
+			PSM_ERR("hold FIFO delimiter missing, packet dropped\n");
+			continue;
+		}
+
+		PSM_DBG("release %u bytes on channel %u\n", len, type);
+		mtk_wcn_stp_send_data_no_ps(psm->out_buf, len, type);
+	}
+
+	return 0;
+}
+
+/*
+ * Idle monitor (psm_core.c:662-760)
+ */
+
+static void psm_stop_monitor(void)
+{
+	timer_delete_sync(&psm->timer);
+}
+
+int stp_psm_start_monitor(void)
+{
+	unsigned long flags;
+	u32 idle;
+
+	if (!psm || !psm->initialized)
+		return -ENODEV;
+
+	if (psm_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR))
+		return 0;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	idle = psm->idle_time;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	PSM_DBG("start monitor (%u ms)\n", idle);
+	mod_timer(&psm->timer, jiffies + msecs_to_jiffies(idle));
+	return 0;
+}
+
+static void psm_idle_cb(struct timer_list *timer)
+{
+	if (!psm || !psm->initialized)
+		return;
+
+	psm_set_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR_RX_HIGH_DENSITY, false);
+	psm_set_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR_TX_HIGH_DENSITY, false);
+
+	if (psm_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR))
+		return;
+
+	PSM_INF("idle for %u ms, requesting sleep\n", psm->idle_time);
+	psm_req_put(MTK_WCN_STP_PSM_SLEEP);
+}
+
+/*
+ * WMT handshake
+ */
+
+static int psm_wmt_notify(enum mtk_wcn_stp_psm_action action)
+{
+	int ret;
+
+	switch (action) {
+	case MTK_WCN_STP_PSM_SLEEP:
+		PSM_DBG("send WMT SLEEP\n");
+		break;
+	case MTK_WCN_STP_PSM_WAKEUP:
+	case MTK_WCN_STP_PSM_HOST_AWAKE:
+		PSM_DBG("send WMT %s\n",
+			action == MTK_WCN_STP_PSM_WAKEUP ? "WAKEUP" : "HOST_AWAKE");
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ret = wmt_core_psm_action(action);
+	if (ret) {
+		u32 reason;
+
+		PSM_WRN("WMT action %d failed (%d)\n", action, ret);
+		switch (action) {
+		case MTK_WCN_STP_PSM_SLEEP:
+			reason = 33;
+			break;
+		case MTK_WCN_STP_PSM_WAKEUP:
+			reason = 34;
+			break;
+		default:
+			reason = 35;
+			break;
+		}
+		if (mtk_wcn_stp_is_ready()) {
+			/* Downstream wmt_core.c:1166-1290 triggers the WMT
+			 * error-assert recovery when the peer does not answer
+			 * the power-saving command.
+			 */
+			wmt_core_evt_err_trg_assert(reason);
+		}
+	}
+
+	return ret;
+}
+
+/* psm_core.c:1230-1320: event processing after the WMT round trip. */
+static void psm_wmt_event_done(void)
+{
+	unsigned long flags;
+	unsigned int event;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	event = psm->wmt_event;
+	psm->wmt_event = 0;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	if (event & BIT(STP_PSM_WMT_EVENT_WAKEUP_EN)) {
+		stp_psm_release_data();
+		psm_set_flag(STP_PSM_BLOCK_DATA_EN, false);
+		psm_set_state_internal(MTK_WCN_STP_PSM_ACT);
+
+		if (mtk_wcn_stp_psm_is_quick_ps_support())
+			psm_req_put(MTK_WCN_STP_PSM_SLEEP);
+		else
+			stp_psm_start_monitor();
+	} else if (event & BIT(STP_PSM_WMT_EVENT_SLEEP_EN)) {
+		psm_set_state_internal(MTK_WCN_STP_PSM_INACT);
+		/* Arm the wakeup line before the MCU may sleep, so that
+		 * firmware-originated traffic can still wake the AP
+		 * (wmt_lib.c:690-700).
+		 */
+		wmt_plat_eirq_ctrl(true);
+		/* The MCU is asleep: let the BTIF controller enter deep idle
+		 * too, exactly what mt_combo_plt_enter_deep_idle(COMBO_IF_BTIF)
+		 * did downstream.
+		 */
+		stp_btif_dpidle_ctrl(true);
+		psm_wake_lock_put();
+	} else if (event & BIT(STP_PSM_WMT_EVENT_ROLL_BACK_EN)) {
+		enum mtk_wcn_stp_psm_state state = psm_get_state();
+
+		if (state == MTK_WCN_STP_PSM_ACT_INACT) {
+			stp_psm_release_data();
+			psm_set_flag(STP_PSM_BLOCK_DATA_EN, false);
+			psm_set_state_internal(MTK_WCN_STP_PSM_ACT);
+		} else if (state == MTK_WCN_STP_PSM_INACT_ACT) {
+			psm_set_state_internal(MTK_WCN_STP_PSM_INACT);
+			PSM_INF("wakeup rolled back, staying asleep\n");
+		}
+	} else if (event & BIT(STP_PSM_RESET_EN)) {
+		PSM_DBG("reset event\n");
+	} else {
+		PSM_WRN("no PSM event, state %s\n",
+			psm_state_name[psm_get_state()]);
+	}
+}
+
+/* psm_core.c:956-1220: the state machine proper. */
+static void psm_notify_wmt(enum mtk_wcn_stp_psm_action action)
+{
+	enum mtk_wcn_stp_psm_state state = psm_get_state();
+	int ret;
+
+	if (state == MTK_WCN_STP_PSM_ACT) {
+		if (action == MTK_WCN_STP_PSM_SLEEP) {
+			if (psm_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR)) {
+				PSM_DBG("monitor disabled, no sleep\n");
+				return;
+			}
+
+			psm_set_state_internal(MTK_WCN_STP_PSM_ACT_INACT);
+			stp_psm_release_data();
+
+			ret = psm_wmt_notify(MTK_WCN_STP_PSM_SLEEP);
+			stp_psm_notify_action_done(MTK_WCN_STP_PSM_SLEEP, !ret);
+			psm_wmt_event_done();
+		} else if (psm_action_is_wakeup(action)) {
+			PSM_DBG("already awake, release pending data\n");
+			stp_psm_release_data();
+		} else {
+			PSM_WRN("invalid action %d in ACT\n", action);
+		}
+		return;
+	}
+
+	if (state == MTK_WCN_STP_PSM_INACT) {
+		if (psm_action_is_wakeup(action)) {
+			psm_set_state_internal(MTK_WCN_STP_PSM_INACT_ACT);
+			psm_wake_lock_get();
+			wmt_plat_eirq_ctrl(false);
+			stp_btif_dpidle_ctrl(false);
+
+			ret = psm_wmt_notify(action);
+			stp_psm_notify_action_done(action, !ret);
+			psm_wmt_event_done();
+		} else if (action == MTK_WCN_STP_PSM_SLEEP) {
+			PSM_DBG("already asleep\n");
+		} else {
+			PSM_WRN("invalid action %d in INACT\n", action);
+		}
+		return;
+	}
+
+	/* ACT_INACT / INACT_ACT: a request is already in flight.  The event
+	 * handler will converge the state, and the next request re-runs.
+	 */
+	PSM_DBG("action %d ignored in state %s\n", action,
+		psm_state_name[state]);
+}
+
+/* psm_core.c:1234-1287 */
+int stp_psm_do_wakeup(void)
+{
+	int retry;
+
+	if (!psm || !psm->initialized)
+		return -ENODEV;
+
+	psm_stop_monitor();
+	psm_req_drain();
+
+	for (retry = 0; retry < 10; retry++) {
+		psm_notify_wmt(MTK_WCN_STP_PSM_WAKEUP);
+		if (psm_get_state() == MTK_WCN_STP_PSM_ACT) {
+			/* Idempotent: the line is masked while the MCU is
+			 * awake (psm_core.c:1050-1090).
+			 */
+			wmt_plat_eirq_ctrl(false);
+			return 0;
+		}
+		msleep(20);
+	}
+
+	PSM_ERR("failed to bring the MCU back to ACT\n");
+	return -EIO;
+}
+
+static void psm_handle_req(u8 action)
+{
+	int ret = 0;
+
+	switch (action) {
+	case PSM_REQ_ENABLE:
+		psm_set_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR, true);
+		ret = stp_psm_do_wakeup();
+		if (!ret) {
+			psm_set_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR, false);
+			psm_wake_lock_get();
+			stp_psm_start_monitor();
+			PSM_INF("enabled, idle time %u ms\n", psm->idle_time);
+		} else {
+			PSM_ERR("enable failed, monitor stays off\n");
+		}
+		break;
+	case PSM_REQ_DISABLE:
+		psm_set_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR, true);
+		psm_stop_monitor();
+		ret = stp_psm_do_wakeup();
+		psm_wake_lock_put();
+		PSM_INF("disabled\n");
+		break;
+	case MTK_WCN_STP_PSM_SLEEP:
+		if (stp_psm_check_sleep_enable() > 0 &&
+		    !stp_psm_is_disable())
+			ret = psm_wmt_notify(MTK_WCN_STP_PSM_SLEEP);
+		else
+			PSM_DBG("sleep cancelled\n");
+		break;
+	case MTK_WCN_STP_PSM_WAKEUP:
+	case MTK_WCN_STP_PSM_HOST_AWAKE:
+		psm_notify_wmt(action);
+		break;
+	case MTK_WCN_STP_PSM_ROLLBACK:
+		psm_set_flag(STP_PSM_WMT_EVENT_ROLL_BACK_EN, true);
+		psm_wmt_event_done();
+		break;
+	default:
+		PSM_WRN("unknown request 0x%02x\n", action);
+		break;
+	}
+
+	psm->last_err = ret;
+}
+
+static void psm_work_fn(struct work_struct *work)
+{
+	u8 action;
+
+	if (!psm->initialized)
+		return;
+
+	mutex_lock(&psm->api_lock);
+	while (psm_req_get(&action)) {
+		psm->last_done = action;
+		psm_handle_req(action);
+	}
+	mutex_unlock(&psm->api_lock);
+
+	wake_up_all(&psm->wmt_wq);
+}
+
+/*
+ * Data path API
+ */
+
+int stp_psm_hold_data(const u8 *buffer, u32 len, u8 type)
+{
+	if (!psm || !buffer)
+		return -EINVAL;
+
+	return psm_hold_data_locked(buffer, len, type);
+}
+
+int stp_psm_release_data(void)
+{
+	if (!psm)
+		return -ENODEV;
+
+	return psm_release_data();
+}
+
+int stp_psm_has_pending_data(void)
+{
+	return psm ? psm_has_pending_data() : 0;
+}
+
+bool stp_psm_is_to_block_traffic(void)
+{
+	return psm && psm_flag(STP_PSM_BLOCK_DATA_EN);
+}
+
+int stp_psm_is_disable(void)
+{
+	return psm && psm_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR);
+}
+
+/*
+ * Traffic density: psm_core.c:1460-1490.  High throughput pushes the idle
+ * time to one second and keeps the MCU awake instead of toggling it.
+ */
+void stp_psm_disable_by_tx_rx_density(int dir, int length)
+{
+	unsigned long flags;
+	ktime_t now;
+	bool sample_done = false;
+	int total;
+
+	if (!psm)
+		return;
+
+	now = ktime_get();
+	spin_lock_irqsave(&psm->lock, flags);
+
+	if (!psm->sample_start) {
+		psm->sample_start = true;
+		psm->sample_end = ktime_add_ms(now, STP_PSM_SAMPLE_DURATION_MS);
+		psm->tx_sum_len = 0;
+		psm->rx_sum_len = 0;
+	}
+	if (dir)
+		psm->rx_sum_len += length;
+	else
+		psm->tx_sum_len += length;
+
+	if (ktime_after(now, psm->sample_end)) {
+		total = psm->tx_sum_len + psm->rx_sum_len;
+		if (total > STP_PSM_RTX_SPEED_THRESHOLD) {
+			set_bit(STP_PSM_WMT_EVENT_DISABLE_MONITOR_TX_HIGH_DENSITY,
+				&psm->flags);
+			psm->idle_time = STP_PSM_IDLE_TIME_SLEEP_1000;
+		} else {
+			psm->idle_time = STP_PSM_IDLE_TIME_SLEEP;
+			clear_bit(STP_PSM_WMT_EVENT_DISABLE_MONITOR_TX_HIGH_DENSITY,
+				  &psm->flags);
+		}
+		psm->sample_start = false;
+		psm->tx_sum_len = 0;
+		psm->rx_sum_len = 0;
+		sample_done = true;
+	}
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	if (sample_done) {
+		PSM_INF("traffic %d bytes/s, idle time %u ms\n", total,
+			psm->idle_time);
+		/* psm_core.c:1460-1490 restarts the monitor only in the
+		 * high-throughput branch, where the idle time was stretched
+		 * to STP_PSM_IDLE_TIME_SLEEP_1000.
+		 */
+		if (total > STP_PSM_RTX_SPEED_THRESHOLD)
+			stp_psm_start_monitor();
+	}
+}
+
+/*
+ * TX/RX hooks used by stp_core.c.  The PSM lock is taken across the real STP
+ * transmit so that a sleep transition cannot start between the "can send"
+ * check and the enqueue (psm_core.c:2436-2510).
+ *
+ * Like the downstream stp_psm_thread_lock, this is a sleeping lock: every
+ * in-tree STP producer (BT hci send, GPS/FM character devices, WMT engine)
+ * runs in process context.
+ */
+
+int stp_psm_tx_begin(const u8 *buffer, u32 len, u8 type, bool *locked)
+{
+	bool quick;
+
+	*locked = false;
+
+	if (!psm || !psm->initialized || type == WMT_TASK_INDX)
+		return 0;
+
+	quick = mtk_wcn_stp_psm_is_quick_ps_support();
+	if (quick)
+		stp_psm_disable_by_tx_rx_density(0, len);
+
+	mutex_lock(&psm->api_lock);
+	*locked = true;
+
+	if (stp_psm_is_to_block_traffic()) {
+		int ret = stp_psm_hold_data(buffer, len, type);
+
+		PSM_INF("MCU asleep, hold %u bytes on channel %u\n", len, type);
+		psm_req_put(MTK_WCN_STP_PSM_WAKEUP);
+		mutex_unlock(&psm->api_lock);
+		*locked = false;
+		return ret;
+	}
+
+	if (stp_psm_has_pending_data()) {
+		PSM_WRN("releasing held data before normal TX\n");
+		stp_psm_release_data();
+	}
+
+	/* In quick-PS mode the idle monitor is not re-armed: the MCU is put
+	 * back to sleep by stp_psm_tx_end() as soon as the frame is out
+	 * (psm_core.c:2440-2465).
+	 */
+	if (!quick)
+		stp_psm_start_monitor();
+	return 0;
+}
+
+void stp_psm_tx_end(u8 type, bool locked)
+{
+	if (!psm)
+		return;
+
+	/* Downstream queues the sleep request before releasing the PSM
+	 * thread lock (stp_core.c:2620-2635).
+	 */
+	if (type != WMT_TASK_INDX &&
+	    mtk_wcn_stp_psm_is_quick_ps_support())
+		mtk_wcn_stp_psm_notify_wmt_sleep();
+
+	if (locked)
+		mutex_unlock(&psm->api_lock);
+}
+
+void stp_psm_rx_done(u8 type, int length)
+{
+	if (!psm || !psm->initialized)
+		return;
+
+	if (type != WMT_TASK_INDX && psm->enabled &&
+	    mtk_wcn_stp_psm_is_quick_ps_support())
+		stp_psm_disable_by_tx_rx_density(1, length);
+}
+
+/*
+ * Control API
+ */
+
+static void psm_request_enable(u32 idle_ms, bool from_user)
+{
+	unsigned long flags;
+
+	if (!psm || !psm->initialized)
+		return;
+
+	if (idle_ms < 1 || idle_ms > 20000)
+		idle_ms = STP_PSM_IDLE_TIME_SLEEP;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	psm->idle_time = idle_ms;
+	psm->sleep_en = 1;
+	psm->enabled = true;
+	psm->last_err = 0;
+	if (from_user) {
+		psm->user_enabled = true;
+		psm->user_idle_time = idle_ms;
+	}
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	psm_req_put(PSM_REQ_ENABLE);
+}
+
+static void psm_request_disable(bool from_user)
+{
+	unsigned long flags;
+
+	if (!psm || !psm->initialized)
+		return;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	psm->enabled = false;
+	psm->last_err = 0;
+	if (from_user)
+		psm->user_enabled = false;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	psm_req_put(PSM_REQ_DISABLE);
+}
+
+void stp_psm_request_enable(int idle_ms)
+{
+	psm_request_enable(idle_ms, false);
+}
+
+void stp_psm_request_disable(void)
+{
+	psm_request_disable(false);
+}
+
+void stp_psm_reapply(void)
+{
+	unsigned long flags;
+	bool enabled;
+	u32 idle;
+
+	if (!psm || !psm->initialized)
+		return;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	enabled = psm->user_enabled;
+	idle = psm->user_idle_time;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	if (enabled)
+		psm_request_enable(idle, false);
+	else
+		psm_request_disable(false);
+}
+
+static int psm_wait_requests(u32 timeout_ms)
+{
+	if (wait_event_timeout(psm->wmt_wq, !READ_ONCE(psm->req_count),
+			       msecs_to_jiffies(timeout_ms)))
+		return 0;
+
+	PSM_ERR("request queue not drained within %u ms\n", timeout_ms);
+	return -ETIMEDOUT;
+}
+
+int stp_psm_set_sleep_enable(void)
+{
+	if (!psm)
+		return -ENODEV;
+
+	psm->sleep_en = 1;
+	return 0;
+}
+
+int stp_psm_set_sleep_disable(void)
+{
+	if (!psm)
+		return -ENODEV;
+
+	psm->sleep_en = 0;
+	return 0;
+}
+
+int stp_psm_check_sleep_enable(void)
+{
+	return psm ? psm->sleep_en : -ENODEV;
+}
+
+int stp_psm_sleep_for_thermal(void)
+{
+	if (!psm || !psm->initialized)
+		return -ENODEV;
+
+	if (!psm->enabled || stp_psm_is_disable() ||
+	    stp_psm_check_sleep_enable() <= 0)
+		return -EOPNOTSUPP;
+
+	psm_req_put(MTK_WCN_STP_PSM_SLEEP);
+	return 0;
+}
+
+int stp_psm_notify_action_done(enum mtk_wcn_stp_psm_action action, bool ok)
+{
+	unsigned long flags;
+	enum mtk_wcn_stp_psm_state state;
+	int bit = -1;
+
+	if (!psm)
+		return -ENODEV;
+
+	if (!ok)
+		action = MTK_WCN_STP_PSM_ROLLBACK;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	state = psm->state;
+
+	/* psm_core.c:1050-1130 */
+	if (state == MTK_WCN_STP_PSM_ACT_INACT) {
+		if (action == MTK_WCN_STP_PSM_SLEEP) {
+			clear_bit(STP_PSM_WMT_EVENT_WAKEUP_EN, &psm->flags);
+			set_bit(STP_PSM_WMT_EVENT_SLEEP_EN, &psm->flags);
+			bit = STP_PSM_WMT_EVENT_SLEEP_EN;
+		} else if (action == MTK_WCN_STP_PSM_ROLLBACK) {
+			set_bit(STP_PSM_WMT_EVENT_ROLL_BACK_EN, &psm->flags);
+			bit = STP_PSM_WMT_EVENT_ROLL_BACK_EN;
+		}
+	} else if (state == MTK_WCN_STP_PSM_INACT_ACT) {
+		if (psm_action_is_wakeup(action)) {
+			clear_bit(STP_PSM_WMT_EVENT_SLEEP_EN, &psm->flags);
+			set_bit(STP_PSM_WMT_EVENT_WAKEUP_EN, &psm->flags);
+			bit = STP_PSM_WMT_EVENT_WAKEUP_EN;
+		} else if (action == MTK_WCN_STP_PSM_ROLLBACK) {
+			set_bit(STP_PSM_WMT_EVENT_ROLL_BACK_EN, &psm->flags);
+			bit = STP_PSM_WMT_EVENT_ROLL_BACK_EN;
+		}
+	}
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	if (bit >= 0)
+		wake_up_all(&psm->wmt_wq);
+
+	return bit < 0 ? -EINVAL : 0;
+}
+
+static bool stp_psm_is_quick_ps_support(void)
+{
+	return psm && psm->quick_ps_support && psm->pm_suspending;
+}
+
+void stp_psm_set_pm_suspend(bool suspending)
+{
+	if (!psm)
+		return;
+
+	psm->pm_suspending = suspending;
+	PSM_DBG("system %s\n", suspending ? "suspending" : "resumed");
+}
+
+/*
+ * Public API (mtk_wcn_stp.h)
+ */
+
+int mtk_wcn_stp_psm_enable(int idle_time_ms)
+{
+	int ret;
+
+	if (!psm || !psm->initialized)
+		return -ENODEV;
+	if (!g_wmt.ready)
+		return -ENODEV;
+
+	psm_request_enable(idle_time_ms, true);
+
+	ret = psm_wait_requests(5000);
+	if (ret)
+		return ret;
+
+	return psm->last_err;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_enable);
+
+int mtk_wcn_stp_psm_disable(void)
+{
+	int ret;
+
+	if (!psm || !psm->initialized)
+		return -ENODEV;
+
+	psm_request_disable(true);
+
+	ret = psm_wait_requests(5000);
+	if (ret)
+		return ret;
+
+	return psm->last_err;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_disable);
+
+int mtk_wcn_stp_psm_reset(void)
+{
+	unsigned long flags;
+
+	if (!psm)
+		return -ENODEV;
+
+	/* Called from the STP reset path, possibly while the WMT operation
+	 * thread holds g_wmt.op_lock.  It must not wait for the workqueue.
+	 */
+	psm_set_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR, true);
+	timer_delete(&psm->timer);
+	psm_req_drain();
+
+	spin_lock_irqsave(&psm->lock, flags);
+	psm->flags = 0;
+	set_bit(STP_PSM_WMT_EVENT_DISABLE_MONITOR, &psm->flags);
+	psm->state = MTK_WCN_STP_PSM_ACT;
+	psm->hold_len = 0;
+	psm->wmt_event = 0;
+	psm->sample_start = false;
+	psm->tx_sum_len = 0;
+	psm->rx_sum_len = 0;
+	psm->enabled = false;
+	psm->last_done = 0xff;
+	psm->last_err = 0;
+	spin_unlock_irqrestore(&psm->lock, flags);
+
+	/* The link is being torn down: mask the wakeup line and leave the
+	 * BTIF controller out of deep idle (psm_core.c:769-820).
+	 */
+	wmt_plat_eirq_ctrl(false);
+	stp_btif_dpidle_ctrl(false);
+	stp_psm_set_sleep_enable();
+	psm_wake_lock_put();
+	PSM_INF("reset\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_reset);
+
+int mtk_wcn_stp_psm_set_state(enum mtk_wcn_stp_psm_state state)
+{
+	unsigned long flags;
+
+	if (!psm || state >= MTK_WCN_STP_PSM_STATE_MAX)
+		return -EINVAL;
+
+	spin_lock_irqsave(&psm->lock, flags);
+	psm->state = state;
+	/* psm_core.c:542-565: BLOCK_DATA is raised on leaving ACT and must be
+	 * cleared again when a caller forces ACT.
+	 */
+	if (state != MTK_WCN_STP_PSM_ACT)
+		set_bit(STP_PSM_BLOCK_DATA_EN, &psm->flags);
+	else
+		clear_bit(STP_PSM_BLOCK_DATA_EN, &psm->flags);
+	spin_unlock_irqrestore(&psm->lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_set_state);
+
+int mtk_wcn_stp_psm_notify_stp(enum mtk_wcn_stp_psm_action action)
+{
+	if (!psm)
+		return -ENODEV;
+
+	switch (action) {
+	case MTK_WCN_STP_PSM_EIRQ:
+		/* Unexpected traffic while asleep: wake the MCU. */
+		psm_req_put(MTK_WCN_STP_PSM_HOST_AWAKE);
+		return 0;
+	case MTK_WCN_STP_PSM_SLEEP:
+	case MTK_WCN_STP_PSM_WAKEUP:
+	case MTK_WCN_STP_PSM_HOST_AWAKE:
+	case MTK_WCN_STP_PSM_ROLLBACK:
+		return stp_psm_notify_action_done(action, true);
+	default:
+		return -EINVAL;
+	}
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_notify_stp);
+
+int mtk_wcn_stp_psm_notify_wmt_wakeup(void)
+{
+	if (!psm)
+		return -ENODEV;
+
+	psm_req_put(MTK_WCN_STP_PSM_WAKEUP);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_notify_wmt_wakeup);
+
+int mtk_wcn_stp_psm_notify_wmt_sleep(void)
+{
+	if (!psm)
+		return -ENODEV;
+
+	if (psm_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR) ||
+	    psm_flag(STP_PSM_WMT_EVENT_DISABLE_MONITOR_TX_HIGH_DENSITY))
+		return 0;
+
+	psm_req_put(MTK_WCN_STP_PSM_SLEEP);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_notify_wmt_sleep);
+
+int mtk_wcn_stp_psm_sleep_for_thermal(void)
+{
+	return stp_psm_sleep_for_thermal();
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_sleep_for_thermal);
+
+bool mtk_wcn_stp_psm_dbg_level(u32 level)
+{
+	if (level > 4)
+		return false;
+
+	psm_dbg_level = level;
+	PSM_INF("debug level %u\n", level);
+	return true;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_dbg_level);
+
+bool mtk_wcn_stp_psm_is_quick_ps_support(void)
+{
+	return stp_psm_is_quick_ps_support();
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_psm_is_quick_ps_support);
+
+/*
+ * Lifecycle
+ */
+
+static int psm_pm_notify(struct notifier_block *nb, unsigned long event,
+			 void *unused)
+{
+	if (!psm)
+		return NOTIFY_DONE;
+
+	switch (event) {
+	case PM_SUSPEND_PREPARE:
+		stp_psm_set_pm_suspend(true);
+		break;
+	case PM_POST_SUSPEND:
+		stp_psm_set_pm_suspend(false);
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+int stp_psm_init(void)
+{
+	psm = kzalloc(sizeof(*psm), GFP_KERNEL);
+	if (!psm)
+		return -ENOMEM;
+
+	mutex_init(&psm->api_lock);
+	spin_lock_init(&psm->lock);
+	init_waitqueue_head(&psm->wmt_wq);
+	psm->state = MTK_WCN_STP_PSM_ACT;
+	psm->sleep_en = 1;
+	psm->idle_time = STP_PSM_IDLE_TIME_SLEEP;
+	psm->user_idle_time = STP_PSM_IDLE_TIME_SLEEP;
+	psm->quick_ps_support = psm_quick_ps;
+	psm->last_done = 0xff;
+
+	timer_setup(&psm->timer, psm_idle_cb, 0);
+	INIT_WORK(&psm->work, psm_work_fn);
+
+	psm->pm_nb.notifier_call = psm_pm_notify;
+	register_pm_notifier(&psm->pm_nb);
+
+	/* Safe default: monitor disabled, link always awake
+	 * (downstream psm_core.c:1865 calls _stp_psm_disable at init too).
+	 */
+	set_bit(STP_PSM_WMT_EVENT_DISABLE_MONITOR, &psm->flags);
+	psm->initialized = true;
+
+	PSM_INF("initialised, quick-PS %s\n",
+		psm->quick_ps_support ? "capable" : "off");
+	return 0;
+}
+
+void stp_psm_deinit(void)
+{
+	if (!psm)
+		return;
+
+	psm->initialized = false;
+	unregister_pm_notifier(&psm->pm_nb);
+	timer_delete_sync(&psm->timer);
+	psm_req_drain();
+	cancel_work_sync(&psm->work);
+
+	wmt_plat_eirq_ctrl(false);
+	stp_btif_dpidle_ctrl(false);
+	psm_wake_lock_put();
+
+	mutex_destroy(&psm->api_lock);
+	kfree(psm);
+	psm = NULL;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_psm.h b/drivers/misc/mediatek/connectivity/wmt/stp_psm.h
new file mode 100644
index 000000000..56e77c152
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_psm.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WCN STP power-saving engine (PSM).
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/psm_core.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/include/psm_core.h
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The engine puts the connectivity MCU to sleep with the WMT SLEEP command
+ * once the STP link has been idle for STP_PSM_IDLE_TIME_SLEEP ms and wakes it
+ * up with the WMT WAKEUP/HOST_AWAKE handshake when a channel needs to
+ * transmit.  While the MCU is asleep, payload is queued in a hold FIFO and
+ * released after the wakeup event.
+ *
+ * Scope of this port vs. the downstream thread-based design:
+ *   - the downstream op queue + "mtk_stp_psm" kthread are replaced by a
+ *     workqueue plus a small request ring; PSM never sleeps with a spinlock
+ *     held and all WMT traffic is issued from process context under the
+ *     existing WMT op_lock,
+ *   - the MMC/SDIO ownership and AP deep-idle hooks do not exist in this
+ *     kernel; the equivalent "leave deep idle" step is the BTIF DPIDLE
+ *     control of the STP channel,
+ *   - the early-suspend state used by quick-PS is provided by a PM notifier.
+ */
+
+#ifndef _STP_PSM_H_
+#define _STP_PSM_H_
+
+#include <linux/types.h>
+
+#include <mtk_wcn_stp.h>
+
+/* psm_core.h:52-60, 69 */
+#define STP_PSM_FIFO_SIZE		0x2000	/* 8 KiB hold FIFO */
+#define STP_PSM_TX_SIZE			0x800	/* 2 KiB release scratch */
+#define STP_PSM_PACKET_SIZE_MAX		2000
+#define STP_PSM_IDLE_TIME_SLEEP		30	/* ms */
+#define STP_PSM_IDLE_TIME_SLEEP_1000	1000	/* ms, high traffic */
+#define STP_PSM_WAIT_EVENT_TIMEOUT	6000	/* ms */
+#define STP_PSM_SAMPLE_DURATION_MS	1000
+#define STP_PSM_RTX_SPEED_THRESHOLD	50000	/* bytes per sample */
+
+/* psm_core.h:90-98: flag bit indices (not masks). */
+#define STP_PSM_WMT_EVENT_SLEEP_EN			0
+#define STP_PSM_WMT_EVENT_WAKEUP_EN			1
+#define STP_PSM_BLOCK_DATA_EN				2
+#define STP_PSM_WMT_EVENT_DISABLE_MONITOR		3
+#define STP_PSM_WMT_EVENT_ROLL_BACK_EN			4
+#define STP_PSM_RESET_EN				5
+#define STP_PSM_WMT_EVENT_HOST_WAKEUP_EN		6
+#define STP_PSM_WMT_EVENT_DISABLE_MONITOR_TX_HIGH_DENSITY 7
+#define STP_PSM_WMT_EVENT_DISABLE_MONITOR_RX_HIGH_DENSITY 8
+
+/* psm_core.h:107-113 */
+#define STP_OP_BUF_SIZE		16
+#define STP_PSM_DBG_SIZE	16
+
+struct stp_psm;
+
+/* One-shot lifecycle, called by stp_drv_init()/stp_drv_exit(). */
+int stp_psm_init(void);
+void stp_psm_deinit(void);
+
+/* Data path hooks used by stp_core.c.  stp_psm_tx_begin() returns > 0 when
+ * the packet was queued in the hold FIFO (the caller must not transmit it),
+ * 0 when the caller must transmit while holding @locked, or a negative errno.
+ */
+int stp_psm_tx_begin(const u8 *buffer, u32 len, u8 type, bool *locked);
+void stp_psm_tx_end(u8 type, bool locked);
+void stp_psm_rx_done(u8 type, int length);
+int stp_psm_hold_data(const u8 *buffer, u32 len, u8 type);
+int stp_psm_release_data(void);
+int stp_psm_has_pending_data(void);
+bool stp_psm_is_to_block_traffic(void);
+int stp_psm_start_monitor(void);
+void stp_psm_disable_by_tx_rx_density(int dir, int length);
+
+/* State / control used by stp_core.c and wmt_core.c. */
+int stp_psm_set_sleep_enable(void);
+int stp_psm_set_sleep_disable(void);
+int stp_psm_check_sleep_enable(void);
+int stp_psm_do_wakeup(void);
+int stp_psm_sleep_for_thermal(void);
+int stp_psm_is_disable(void);
+
+/* Completion notification from the WMT engine (wmt_core.c). */
+int stp_psm_notify_action_done(enum mtk_wcn_stp_psm_action action, bool ok);
+
+/* Quick-PS capability: SOC supports it and the system is suspending. */
+void stp_psm_set_pm_suspend(bool suspending);
+
+/* Async control used from contexts that hold g_wmt.op_lock; they only queue
+ * a request for the PSM workqueue.  stp_psm_reapply() restores the state a
+ * user request asked for after a chip reset/re-init.
+ */
+void stp_psm_request_enable(int idle_ms);
+void stp_psm_request_disable(void);
+void stp_psm_reapply(void);
+
+#endif /* _STP_PSM_H_ */
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_api.c b/drivers/misc/mediatek/connectivity/wmt/wmt_api.c
new file mode 100644
index 000000000..f91fb5b92
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_api.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT public API (frozen mtk_wcn_wmt.h).
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/wmt_exp.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ */
+
+#include <linux/module.h>
+
+#include "wmt_local.h"
+
+/* Downstream ENUM_WMTTHERM_TYPE_T (wmt_exp.h:71-78). */
+#define WMTTHERM_ENABLE		1
+#define WMTTHERM_READ		2
+#define WMTTHERM_DISABLE	3
+#define WMTTHERM_MAX		4
+
+static bool wmt_public_op(enum wmt_opid op_id, enum mtk_wcn_wmt_drv type)
+{
+	struct wmt_op op = {
+		.op_id = op_id,
+		.data = { type },
+	};
+	bool ret;
+
+	if (!g_wmt.ready)
+		return false;
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	ret = wmt_lib_run_op(&op) == 0;
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ret;
+}
+
+bool mtk_wcn_wmt_func_on(enum mtk_wcn_wmt_drv type)
+{
+	if (type > WMTDRV_WIFI) {
+		wmt_warn("function %d is not supported\n", type);
+		return false;
+	}
+
+	return wmt_public_op(WMT_OPID_FUNC_ON, type);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_func_on);
+
+bool mtk_wcn_wmt_func_off(enum mtk_wcn_wmt_drv type)
+{
+	if (type > WMTDRV_WIFI) {
+		wmt_warn("function %d is not supported\n", type);
+		return false;
+	}
+
+	return wmt_public_op(WMT_OPID_FUNC_OFF, type);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_func_off);
+
+int mtk_wcn_wmt_msgcb_reg(enum mtk_wcn_wmt_drv type, mtk_wcn_wmt_msgcb cb)
+{
+	if (type < 0 || type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	g_wmt.msgcb[type] = cb;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_msgcb_reg);
+
+int mtk_wcn_wmt_msgcb_unreg(enum mtk_wcn_wmt_drv type)
+{
+	if (type < 0 || type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	g_wmt.msgcb[type] = NULL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_msgcb_unreg);
+
+/* wmt_exp.c:426-462 */
+int mtk_wcn_wmt_wlan_reg(const struct mtk_wcn_wmt_wlan_cb *cb)
+{
+	if (!cb || !cb->probe || !cb->remove)
+		return -EINVAL;
+
+	memcpy(&g_wmt.wlan_cb, cb, sizeof(g_wmt.wlan_cb));
+	wmt_info("WLAN driver registered\n");
+
+	if (g_wmt.wlan_probed) {
+		int ret = cb->probe();
+
+		if (ret) {
+			wmt_err("deferred WLAN probe failed (%d)\n", ret);
+			return ret;
+		}
+		g_wmt.wlan_probed = false;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wlan_reg);
+
+int mtk_wcn_wmt_wlan_unreg(void)
+{
+	memset(&g_wmt.wlan_cb, 0, sizeof(g_wmt.wlan_cb));
+	wmt_info("WLAN driver unregistered\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wlan_unreg);
+
+/* wmt_exp.c:340-400 */
+bool mtk_wcn_wmt_assert(enum mtk_wcn_wmt_drv type, u32 reason)
+{
+	struct wmt_op op = { .op_id = WMT_OPID_ASSERT };
+	unsigned long pa1 = 0, pa2 = 0;
+	bool ret;
+
+	if (type < 0 || type >= WMTDRV_MAX)
+		return false;
+
+	if (!g_wmt.ready)
+		return false;
+
+	wmt_warn("driver %d asserts the firmware (reason %u)\n", type, reason);
+
+	/* Wake the connectivity MCU before sending the assert command; the
+	 * downstream driver does the same through the STP power-saving engine
+	 * (wmt_exp.c:209).
+	 */
+	wmt_core_ctrl(WMT_CTRL_SOC_WAKEUP_CONSYS, &pa1, &pa2);
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	ret = wmt_lib_run_op(&op) == 0;
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_assert);
+
+int mtk_wcn_wmt_system_state_reset(void)
+{
+	g_wmt.func_on_bits = 0;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_system_state_reset);
+
+/* wmt_exp.c:265-335 */
+bool mtk_wcn_wmt_dsns_ctrl(enum mtk_wcn_wmt_dsns type)
+{
+	struct wmt_op op = {
+		.op_id = WMT_OPID_DSNS,
+		.data = { WMTDRV_FM, type },
+	};
+	bool ok;
+
+	if (type >= WMTDSNS_MAX)
+		return false;
+
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready())
+		return false;
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	ok = wmt_lib_run_op(&op) == 0;
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ok;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_dsns_ctrl);
+
+/* wmt_exp.c:180-260 */
+s8 mtk_wcn_wmt_therm_ctrl(u8 type)
+{
+	struct wmt_op op = { .op_id = WMT_OPID_THERM_CTRL };
+	s8 ret;
+
+	if (type < WMTTHERM_ENABLE || type >= WMTTHERM_MAX) {
+		wmt_err("invalid thermal control command %u\n", type);
+		return 0;
+	}
+
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready()) {
+		wmt_err("thermal control needs a ready STP\n");
+		return 0;
+	}
+
+	op.data[0] = type;
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	if (wmt_lib_run_op(&op)) {
+		wmt_warn("thermal command %u failed\n", type);
+		ret = type == WMTTHERM_READ ? (s8)0xff : 0;
+	} else {
+		ret = (s8)op.data[1];
+	}
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_therm_ctrl);
+
+enum mtk_wcn_wmt_hwver mtk_wcn_wmt_hwver_get(void)
+{
+	return wmt_lib_hwver();
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_hwver_get);
+
+u32 mtk_wcn_wmt_hwver_raw_get(void)
+{
+	return wmt_lib_get_icinfo(WMTCHIN_HWVER);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_hwver_raw_get);
+
+u32 mtk_wcn_wmt_fwver_get(void)
+{
+	return wmt_lib_get_icinfo(WMTCHIN_FWVER);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_fwver_get);
+
+bool mtk_wcn_wmt_co_clock_flag_get(void)
+{
+	return wmt_lib_co_clock() != 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_co_clock_flag_get);
+
+u32 mtk_wcn_wmt_ic_info_get(enum mtk_wcn_wmt_icinfo type)
+{
+	switch (type) {
+	case WMT_ICINFO_CHIPID:
+		return wmt_lib_get_icinfo(WMTCHIN_CHIPID);
+	case WMT_ICINFO_HWVER:
+		return wmt_lib_get_icinfo(WMTCHIN_HWVER);
+	case WMT_ICINFO_MAPPINGHWVER:
+		return wmt_lib_get_icinfo(WMTCHIN_MAPPINGHWVER);
+	case WMT_ICINFO_FWVER:
+		return wmt_lib_get_icinfo(WMTCHIN_FWVER);
+	default:
+		return 0;
+	}
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_ic_info_get);
