+	u32 hdr_verno;
+	u32 md_img_size;
+	u32 loaded_size;	/* image bytes copied into md->img_vir */
+	/* DSP sub-image slot from check header v3+, ccci_util_lib_load_img.c:238 */
+	u32 dsp_offset;
+	u32 dsp_size;
+	u32 mem_size;
+	u32 image_type;
+	u32 product_ver;
