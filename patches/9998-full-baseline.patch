+	p->reg_scen = 0xa5a5a5a5;
+	p->burst_qnum = 1;
+	p->ts.fps = 0;
+	p->ts.interval_us = 0;
+	p->ts.compensation_us = 0;
+	p->ts.t_ns = 0;
