+	if (req->arg_count != 1 || !req->args[0].buf ||
+	    req->args[0].len < sizeof(u32)) {
+		ccci_rpc_rsp_u32(rsp, 0, FS_PARAM_ERROR);
+		ccci_rpc_rsp_u32(rsp, 1, FS_PARAM_ERROR);
+		return 0;
+	}
+
+	ccci_rpc_rsp_u32(rsp, 0, FS_NO_FEATURE);
