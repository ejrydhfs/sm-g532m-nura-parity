+/* Uplink (capture) paths                                             */
+/* ------------------------------------------------------------------ */
+
+/* vendor:3256-3271: shared analog supply of both ADC channels */
+static int mt6331_adc_supply_up(struct mt6331_priv *priv)
+{
+	int ret;
+
+	mt6331_ana_write(priv, MT6328_LDO_CON2, 0x8102, 0xffff);
+
+	ret = mt6331_audglb_enable(priv, true);
+	if (ret)
+		return ret;
+	ret = mt6331_clksq_enable(priv, true);
+	if (ret)
+		return ret;
+
+	/* vendor:3262-3264 audio ADC clock generator */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0004, 0x0004);
+	/* vendor:3265 ADC clock from the 13 MHz clock generator */
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON3, 0x0000, 0xffff);
+	/* vendor:3267-3268 LCLDO_ENC 1.8V + remote sense */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0104, 0x0104);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x0006, 0x0006);
+	/* vendor:3270-3271 encoder bias defaults */
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON6, 0x0555, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON4, 0x0800, 0xffff);
+
+	priv->state |= MT6331_ST_ADC_SUPPLY;
+
+	return 0;
+}
+
+static int mt6331_adc_supply_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_ADC_SUPPLY;
+
+	/* vendor:3469-3480 */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x0000, 0x0006);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0004, 0x0104);
+	mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON3, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0000, 0x0104);
+
+	/* vendor:3481-3483: clocks last */
+	mt6331_topck_enable(priv, false);
+	mt6331_clksq_enable(priv, false);
+	mt6331_audglb_enable(priv, false);
+
+	return 0;
+}
