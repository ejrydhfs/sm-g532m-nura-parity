+	msleep(10);		/* spk:150-151 trim settling time */
+
+	/* spk:153-157 trim off, amp off, class AB, amp on, triangular wave */
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x1001, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x1000, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x1004, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x1005, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON13, 0x0000, 0xffff);
+
+	/* spk:159-164 the vendor only logs the trim result */
+	if (!regmap_read(priv->regmap, MT6328_SPK_CON1, &val))
+		dev_dbg(priv->dev, "speaker trim raw 0x%04x%s\n", val,
+			(val & 0x8000) ? "" : " (trim failed)");
+
+	/* spk:166-167 0 dB amplifier gain */
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3005, 0xffff);
