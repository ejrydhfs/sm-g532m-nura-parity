+			.rates = MT6735_VOICE_RATES,
+			.rate_min = MT6735_VOICE_RATE_MIN,
+			.rate_max = MT6735_VOICE_RATE_MAX,
+			.formats = MT6735_VOICE_FORMATS,
+		},
+		.capture = {
+			.stream_name = "Voice MD1 Capture",
+			.channels_min = 1,
+			.channels_max = 1,
+			.rates = MT6735_VOICE_RATES,
+			.rate_min = MT6735_VOICE_RATE_MIN,
+			.rate_max = MT6735_VOICE_RATE_MAX,
+			.formats = MT6735_VOICE_FORMATS,
+		},
+		.symmetric_rate = 1,
