+int ccci_get_ccmni_channel(int md_id, int ccmni_idx, struct ccmni_ch *channel);
+int ccmni_send_pkt_passthrough(int md_id, int tx_ch, void *data);
+
+void ccci_port_kernel_exit(struct ccci_md *md);
+
+/* kernel service API, ROM exec_ccci_kern_func_by_md_id() and friends */
+int exec_ccci_kern_func_by_md_id(int md_id, unsigned int id, char *buf,
+				 unsigned int len);
+int register_ccci_sys_call_back(int md_id, unsigned int id,
+				int (*func)(int md_id, int data));
+unsigned long ccci_get_md_boot_count(int md_id);
+
+/* ------------------------------------------------------------------ */
+/* ring buffer (ccci_ringbuf.c)                                        */
+/* ------------------------------------------------------------------ */
+struct ccci_ringbuf *ccci_ringbuf_create(void __iomem *mem, unsigned int mem_size,
+					 unsigned int rx_size, unsigned int tx_size);
+int ccci_ringbuf_readable(struct ccci_ringbuf *rb);
+int ccci_ringbuf_writeable(struct ccci_ringbuf *rb, unsigned int size);
+int ccci_ringbuf_read(struct ccci_ringbuf *rb, void *dst, unsigned int len);
+int ccci_ringbuf_write(struct ccci_ringbuf *rb, const void *src, unsigned int len);
+void ccci_ringbuf_move_rpointer(struct ccci_ringbuf *rb, unsigned int len);
+void ccci_ringbuf_reset(struct ccci_ringbuf *rb, bool tx);
+
+/* ------------------------------------------------------------------ */
+/* sysfs / debugfs (ccci_sysfs.c)                                      */
+/* ------------------------------------------------------------------ */
+int ccci_sysfs_md_init(struct ccci_md *md);
+void ccci_sysfs_md_exit(struct ccci_md *md);
+int ccci_sysfs_init(void);
+void ccci_sysfs_exit(void);
+
+/* platform driver entry points (ccci_platform.c), called by ccci_core.c */
+int ccci_platform_register(void);
+void ccci_platform_unregister(void);
+
+/* optional hook exported by drivers/misc/mediatek/ccci_util */
+void ccci_util_dump_set_window(unsigned int md_id, phys_addr_t phys,
+			       size_t size);
+
+/* internal registration path: the platform driver passes its device as the
+ * parent of the modem device, the public ccci_register_modem() passes NULL.
+ */
+int ccci_md_register(const struct ccci_md_cfg *cfg, struct device *parent);
+int ccci_md_attach_ccif(struct ccci_md *md, struct ccci_ccif *ccif);
+int ccci_md_attach_cldma(struct ccci_md *md, struct ccci_cldma *cldma);
+
+/*
+ * Logging: the kernel log gets the device prefix, and the ccci_util log ring
+ * (mdlog) receives the same record, per the cross-leaf contract.
+ */
+#define ccci_md_err(md, fmt, ...) do {					\
+	dev_err((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__);	\
+	ccci_util_log((md)->id, fmt, ##__VA_ARGS__);			\
+} while (0)
+#define ccci_md_warn(md, fmt, ...) do {					\
+	dev_warn((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__);	\
+	ccci_util_log((md)->id, fmt, ##__VA_ARGS__);			\
+} while (0)
+#define ccci_md_info(md, fmt, ...) do {					\
+	dev_info((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__);	\
+	ccci_util_log((md)->id, fmt, ##__VA_ARGS__);			\
+} while (0)
+#define ccci_md_dbg(md, fmt, ...)					\
+	dev_dbg((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__)
+
+static inline unsigned int ccci_port_txq(struct ccci_port *p)
+{
+	return p->md->state == CCCI_MD_EXCEPTION ? p->txq_exp : p->txq;
+}
+
+static inline unsigned int ccci_port_rxq(struct ccci_port *p)
+{
+	return p->md->state == CCCI_MD_EXCEPTION ? p->rxq_exp : p->rxq;
+}
+
+/* ------------------------------------------------------------------ */
+/* Gap-closure additions (append-only, CCCI gap leaves)                */
+/* ------------------------------------------------------------------ */
+
+/* downstream mt6735/ccci_config.h:70: EE dump size of the smem window */
+#define CCCI_SMEM_DUMP_SIZE		4096
+
+/* downstream mt6735/ccci_config.h:76-77: 16 byte CCIF SRAM header
+ * snapshot, CCCI_SMEM_OFFSET_EXREC + 1024 - 16 == 3056
+ */
+#define CCCI_SMEM_CCIF_SRAM_SIZE	16
+#define CCCI_SMEM_OFFSET_CCIF_SRAM	(CCCI_SMEM_OFFSET_EXREC + 1024 - \
+					 CCCI_SMEM_CCIF_SRAM_SIZE)
+
+/* downstream modem_cldma.c:1862: SW watchdog marker in smem+0xC64 */
+#define CCCI_SMEM_EPON_SW_WDT		0xBAEBAE10
+
+/* downstream eccci/ccci_core.h:640 */
+#define CCCI_MD_IMG_DUMP_SIZE		(1 << 8)
+
+/* downstream eccci/ccci_core.h:774-777 MD_BOOT_MODE_* */
+#define CCCI_MD_BOOT_MODE_META		2
+
+/* downstream mt_ccci_common.h:334: CCCI_ERR_CCCI_REGION_START_ID + 16 */
+#define CCCI_ERR_MD_INDEX_NOT_FOUND	316
+
+/* downstream mt_ccci_common.h:240-241 (both are _IOW there as well) */
+#define CCCI_IOC_SET_MD_SBP_CFG		_IOW(CCCI_IOC_MAGIC, 40, unsigned int)
+#define CCCI_IOC_GET_MD_SBP_CFG		_IOW(CCCI_IOC_MAGIC, 41, unsigned int)
+
+#endif /* __CCCI_PRIV_H__ */
diff --git a/drivers/misc/mediatek/ccci/ccci_ringbuf.c b/drivers/misc/mediatek/ccci/ccci_ringbuf.c
new file mode 100644
index 000000000..2909895b7
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_ringbuf.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI shared-memory ring buffer.
+ *
+ * The AP and the modem exchange framed packets through a ring carved out of
+ * the modem shared memory.  Wire format (downstream ccci_ringbuf.c):
+ *
+ *   ring  := 2 * CCCI_RBF_HEADER
+ *            rx_control { read, write, length }
+ *            tx_control { read, write, length }
+ *            rx payload [length]
+ *            tx payload [length]
+ *            2 * CCCI_RBF_FOOTER
+ *
+ *   packet := CCIF_PKG_HEADER, len
+ *             payload (len bytes)
+ *             padding to 8 byte alignment
+ *             CCIF_PKG_FOOTER, CCIF_PKG_FOOTER
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/ccci_ringbuf.c.
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ *
+ * Unlike the downstream version the ring is accessed through the MMIO
+ * accessors, because it lives in UNCACHED shared memory that the modem also
+ * writes: plain pointer dereferences would be torn/reordered on arm64.
+ */
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+#define CTL_RX_READ	0
+#define CTL_RX_WRITE	4
+#define CTL_RX_LEN	8
+#define CTL_TX_READ	12
+#define CTL_TX_WRITE	16
+#define CTL_TX_LEN	20
+#define CTL_SIZE	24
+
+struct ccci_ringbuf {
+	void __iomem *base;
+	void __iomem *ctl;
+	void __iomem *rx_buf;
+	void __iomem *tx_buf;
+	u32 rx_len;
+	u32 tx_len;
+	u32 size;
+};
+
+static inline u32 ctl_rd(struct ccci_ringbuf *rb, u32 off)
+{
+	return readl(rb->ctl + off);
+}
+
+static inline void ctl_wr(struct ccci_ringbuf *rb, u32 off, u32 val)
+{
+	writel(val, rb->ctl + off);
+}
+
+/* copy out of a ring region, handling wrap-around */
+static void ring_read(struct ccci_ringbuf *rb, void __iomem *region, u32 pos,
+		      void *dst, u32 len, u32 region_len)
+{
+	u32 first = min(len, region_len - pos);
+
+	memcpy_fromio(dst, region + pos, first);
+	if (first < len)
+		memcpy_fromio((u8 *)dst + first, region, len - first);
+}
+
+static void ring_write(struct ccci_ringbuf *rb, void __iomem *region, u32 pos,
+		       const void *src, u32 len, u32 region_len)
+{
+	u32 first = min(len, region_len - pos);
+
+	memcpy_toio(region + pos, src, first);
+	if (first < len)
+		memcpy_toio(region, (const u8 *)src + first, len - first);
+}
+
+static inline u32 ring_align(u32 len)
+{
+	return (len + 7) & ~7u;
+}
+
+struct ccci_ringbuf *ccci_ringbuf_create(void __iomem *mem, unsigned int mem_size,
+					 unsigned int rx_size, unsigned int tx_size)
+{
+	struct ccci_ringbuf *rb;
+	u32 total = CCCI_RINGBUF_CTL_LEN + rx_size + tx_size;
+
+	if (!mem || !rx_size || !tx_size || mem_size < total)
+		return NULL;
+
+	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
+	if (!rb)
+		return NULL;
+
+	rb->base = mem;
+	rb->ctl = mem + 8;
+	rb->rx_buf = mem + 8 + CTL_SIZE;
+	rb->tx_buf = rb->rx_buf + rx_size;
+	rb->rx_len = rx_size;
+	rb->tx_len = tx_size;
+	rb->size = total;
+
+	/* header, control block and footer guards */
+	writel(CCCI_RBF_HEADER, mem + 0);
+	writel(CCCI_RBF_HEADER, mem + 4);
+	ctl_wr(rb, CTL_RX_READ, 0);
+	ctl_wr(rb, CTL_RX_WRITE, 0);
+	ctl_wr(rb, CTL_RX_LEN, rx_size);
+	ctl_wr(rb, CTL_TX_READ, 0);
+	ctl_wr(rb, CTL_TX_WRITE, 0);
+	ctl_wr(rb, CTL_TX_LEN, tx_size);
+	writel(CCCI_RBF_FOOTER, mem + total - 8);
+	writel(CCCI_RBF_FOOTER, mem + total - 4);
+	wmb();
+
+	return rb;
+}
+
+/**
+ * ccci_ringbuf_readable - length of the next complete packet
+ * @rb: ring buffer
+ *
+ * Returns the payload length (without framing) of the packet at the read
+ * pointer, or a negative CCCI_RINGBUF_* error.
+ */
+int ccci_ringbuf_readable(struct ccci_ringbuf *rb)
+{
+	u32 read, write, length, size, hdr[2], ftr[2], pkg_len, total;
+	u32 footer_pos;
+
+	if (!rb)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	read = ctl_rd(rb, CTL_RX_READ);
+	write = ctl_rd(rb, CTL_RX_WRITE);
+	length = ctl_rd(rb, CTL_RX_LEN);
+
+	size = (write + length - read) % length;
+	if (size < CCIF_PKG_HDR_LEN + CCIF_PKG_FTR_LEN + CCCI_HEADER_SIZE)
+		return -7;	/* CCCI_RINGBUF_EMPTY */
+
+	ring_read(rb, rb->rx_buf, read, hdr, sizeof(hdr), length);
+	if (hdr[0] != CCIF_PKG_HEADER) {
+		pr_err("ccci: ring header 0x%08x != 0x%08x (r=%u w=%u len=%u)\n",
+		       hdr[0], CCIF_PKG_HEADER, read, write, length);
+		return -3;	/* CCCI_RINGBUF_BAD_HEADER */
+	}
+	pkg_len = hdr[1];
+	total = ring_align(CCIF_PKG_HDR_LEN + pkg_len + CCIF_PKG_FTR_LEN);
+	if (total > size)
+		return -6;	/* CCCI_RINGBUF_NOT_COMPLETE */
+
+	footer_pos = read + total - CCIF_PKG_FTR_LEN;
+	if (footer_pos >= length)
+		footer_pos -= length;
+	ring_read(rb, rb->rx_buf, footer_pos, ftr, sizeof(ftr), length);
+	if (ftr[0] != CCIF_PKG_FOOTER || ftr[1] != CCIF_PKG_FOOTER) {
+		pr_err("ccci: ring footer %08x %08x != %08x (pos=%u len=%u)\n",
+		       ftr[0], ftr[1], CCIF_PKG_FOOTER, footer_pos, length);
+		return -4;	/* CCCI_RINGBUF_BAD_FOOTER */
+	}
+	if (pkg_len > rb->rx_len)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	return pkg_len;
+}
+
+/**
+ * ccci_ringbuf_writeable - space left for a @size byte payload
+ *
+ * Positive: number of bytes consumed in the ring (header+payload+footer,
+ * 8 byte aligned).  Negative: the number of bytes that are missing.
+ * Zero payload is rejected, matching downstream behaviour.
+ */
+int ccci_ringbuf_writeable(struct ccci_ringbuf *rb, unsigned int size)
+{
+	u32 read, write, length, avail, need;
+
+	if (!rb)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	read = ctl_rd(rb, CTL_TX_READ);
+	write = ctl_rd(rb, CTL_TX_WRITE);
+	length = ctl_rd(rb, CTL_TX_LEN);
+
+	if (size > length)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	need = ring_align(size + CCIF_PKG_HDR_LEN + CCIF_PKG_FTR_LEN);
+
+	if (read == write)
+		avail = length - 1;
+	else if (read < write)
+		avail = length - write - 1 + read;
+	else
+		avail = read - write - 1;
+
+	return need < avail ? (int)need : -(int)(need - avail);
+}
+
+int ccci_ringbuf_write(struct ccci_ringbuf *rb, const void *src, unsigned int len)
+{
+	u32 write, read, length;
+	const u32 hdr[2] = { CCIF_PKG_HEADER, 0 };
+	u32 hdr_len = len;
+	const u32 ftr[2] = { CCIF_PKG_FOOTER, CCIF_PKG_FOOTER };
+	u32 pos;
+
+	if (!rb || !src || !len)
+		return -CCCI_ERR_INVALID_PARAM;
+	if (ccci_ringbuf_writeable(rb, len) <= 0)
+		return -2;	/* CCCI_RINGBUF_NOT_ENOUGH */
+
+	read = ctl_rd(rb, CTL_TX_READ);
+	write = ctl_rd(rb, CTL_TX_WRITE);
+	length = ctl_rd(rb, CTL_TX_LEN);
+
+	pos = write;
+	ring_write(rb, rb->tx_buf, pos, &hdr[0], 4, length);
+	pos = (pos + 4) % length;
+	ring_write(rb, rb->tx_buf, pos, &hdr_len, 4, length);
+	pos = (pos + 4) % length;
+	ring_write(rb, rb->tx_buf, pos, src, len, length);
+	pos = (pos + ring_align(len)) % length;
+	ring_write(rb, rb->tx_buf, pos, &ftr[0], 4, length);
+	pos = (pos + 4) % length;
+	ring_write(rb, rb->tx_buf, pos, &ftr[1], 4, length);
+	pos = (pos + 4) % length;
+
+	/* publish only after the payload is visible to the modem */
+	wmb();
+	ctl_wr(rb, CTL_TX_WRITE, pos);
+
+	return len;
+}
+
+int ccci_ringbuf_read(struct ccci_ringbuf *rb, void *dst, unsigned int len)
+{
+	u32 read, length;
+
+	if (!rb || !dst || !len)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	read = ctl_rd(rb, CTL_RX_READ);
+	length = ctl_rd(rb, CTL_RX_LEN);
+	if (len > length)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	ring_read(rb, rb->rx_buf, (read + CCIF_PKG_HDR_LEN) % length, dst, len,
+		  length);
+
+	return len;
+}
+
+void ccci_ringbuf_move_rpointer(struct ccci_ringbuf *rb, unsigned int len)
+{
+	u32 read, length, pos;
+
+	if (!rb)
+		return;
+
+	read = ctl_rd(rb, CTL_RX_READ);
+	length = ctl_rd(rb, CTL_RX_LEN);
+	pos = (read + ring_align(len + CCIF_PKG_HDR_LEN + CCIF_PKG_FTR_LEN)) %
+	      length;
+	/* make sure the payload was consumed before the modem may reuse it */
+	mb();
+	ctl_wr(rb, CTL_RX_READ, pos);
+}
+
+void ccci_ringbuf_reset(struct ccci_ringbuf *rb, bool tx)
+{
+	if (!rb)
+		return;
+
+	if (tx) {
+		ctl_wr(rb, CTL_TX_READ, 0);
+		ctl_wr(rb, CTL_TX_WRITE, 0);
+	} else {
+		ctl_wr(rb, CTL_RX_READ, 0);
+		ctl_wr(rb, CTL_RX_WRITE, 0);
+	}
+	wmb();
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_rpc.c b/drivers/misc/mediatek/ccci/ccci_rpc.c
new file mode 100644
index 000000000..e0ec30966
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_rpc.c
@@ -0,0 +1,1451 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI kernel RPC engine: CCCI_RPC_RX request parser, service registry and
+ * the built-in modem-firmware RPC services.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_kernel.c (ccci_rpc_work_helper() and
+ * rpc_msg_handler()) and port_kernel.h.  Original copyright (C) 2015
+ * MediaTek Inc., GPL-2.0.
+ *
+ * The wire format, op ids, argument layouts and FS_* result codes are the
+ * modem firmware ABI and are copied verbatim from port_kernel.h:107-300.
+ *
+ * Handlers whose downstream backend has no counterpart in this tree answer
+ * the downstream error code for that op and log the missing input; they never
+ * return made-up data.  The deviations are listed in the leaf report and in
+ * the comment above each handler.
+ */
+#include <linux/ccci.h>
+#include <linux/clkbuf.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/gpio/consumer.h>
+#include <linux/gpio/driver.h>
+#include <linux/iio/consumer.h>
+#include <linux/iio/iio.h>
+#include <linux/irq.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/refcount.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/types.h>
+
+#include "ccci_priv.h"
+#include "ccci_rpc.h"
+
+/* Each response argument owns one arena slot, so no two arguments alias. */
+#define CCCI_RPC_ARG_SLOT	((CCCI_RPC_ARENA_SIZE / CCCI_RPC_MAX_ARGS) & ~3U)
+
+/* ccci_rpc_init() asserts that every built-in response fits one slot. */
+
+/* ------------------------------------------------------------------ */
+/* service registry                                                    */
+/* ------------------------------------------------------------------ */
+struct ccci_rpc_service {
+	struct list_head node;
+	u32 op_id;
+	char *name;
+	ccci_rpc_handler_t handler;
+	refcount_t refs;
+};
+
+static LIST_HEAD(ccci_rpc_services);
+static DEFINE_MUTEX(ccci_rpc_lock);
+static bool ccci_rpc_ready;
+
+static struct ccci_rpc_service *ccci_rpc_lookup(u32 op_id)
+{
+	struct ccci_rpc_service *svc;
+
+	mutex_lock(&ccci_rpc_lock);
+	list_for_each_entry(svc, &ccci_rpc_services, node) {
+		if (svc->op_id == op_id) {
+			refcount_inc(&svc->refs);
+			mutex_unlock(&ccci_rpc_lock);
+			return svc;
+		}
+	}
+	mutex_unlock(&ccci_rpc_lock);
+	return NULL;
+}
+
+static void ccci_rpc_put(struct ccci_rpc_service *svc)
+{
+	if (refcount_dec_and_test(&svc->refs)) {
+		kfree(svc->name);
+		kfree(svc);
+	}
+}
+
+/* caller holds ccci_rpc_lock */
+static int __ccci_rpc_register(u32 op_id, const char *name,
+			       ccci_rpc_handler_t handler)
+{
+	struct ccci_rpc_service *svc;
+
+	list_for_each_entry(svc, &ccci_rpc_services, node) {
+		if (svc->op_id == op_id)
+			return -EBUSY;
+	}
+
+	svc = kzalloc(sizeof(*svc), GFP_KERNEL);
+	if (!svc)
+		return -ENOMEM;
+	svc->name = kstrdup(name ? name : "rpc", GFP_KERNEL);
+	if (!svc->name) {
+		kfree(svc);
+		return -ENOMEM;
+	}
+	svc->op_id = op_id;
+	svc->handler = handler;
+	refcount_set(&svc->refs, 1);
+	list_add_tail(&svc->node, &ccci_rpc_services);
+	return 0;
+}
+
+int ccci_rpc_register_service(u32 op_id, const char *name,
+			      ccci_rpc_handler_t handler)
+{
+	int ret;
+
+	if (!handler)
+		return -EINVAL;
+
+	mutex_lock(&ccci_rpc_lock);
+	ret = __ccci_rpc_register(op_id, name, handler);
+	mutex_unlock(&ccci_rpc_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ccci_rpc_register_service);
+
+int ccci_rpc_unregister_service(u32 op_id)
+{
+	struct ccci_rpc_service *svc;
+	int ret = -ENOENT;
+
+	mutex_lock(&ccci_rpc_lock);
+	list_for_each_entry(svc, &ccci_rpc_services, node) {
+		if (svc->op_id == op_id) {
+			list_del(&svc->node);
+			ret = 0;
+			break;
+		}
+	}
+	mutex_unlock(&ccci_rpc_lock);
+
+	if (!ret)
+		ccci_rpc_put(svc);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ccci_rpc_unregister_service);
+
+/* ------------------------------------------------------------------ */
+/* response helpers                                                    */
+/* ------------------------------------------------------------------ */
+static void ccci_rpc_rsp_u32(struct ccci_rpc_msg *rsp, unsigned int index,
+			     u32 value)
+{
+	if (index >= CCCI_RPC_MAX_ARGS)
+		return;
+	memcpy(rsp->args[index].buf, &value, sizeof(value));
+	rsp->args[index].len = sizeof(value);
+	if (rsp->arg_count < index + 1)
+		rsp->arg_count = index + 1;
+}
+
+static int ccci_rpc_rsp_data(struct ccci_rpc_msg *rsp, unsigned int index,
+			     const void *data, unsigned int len)
+{
+	if (index >= CCCI_RPC_MAX_ARGS || len > CCCI_RPC_ARG_SLOT)
+		return -EMSGSIZE;
+	if (len)
+		memcpy(rsp->args[index].buf, data, len);
+	rsp->args[index].len = len;
+	if (rsp->arg_count < index + 1)
+		rsp->arg_count = index + 1;
+	return 0;
+}
+
+/*
+ * Result code of a handler that returned a negative errno.  Only handlers
+ * registered through ccci_rpc_register_service() can return negative, the
+ * built-ins return 0 and fill the FS_* code themselves.
+ * [INFERENCE] the mapping itself; the FS_* codes are port_kernel.h:213-221.
+ */
+static int ccci_rpc_errno_to_fs(int err)
+{
+	switch (err) {
+	case -EOPNOTSUPP:
+	case -ENODEV:
+		return FS_NO_FEATURE;
+	case -EINVAL:
+		return FS_PARAM_ERROR;
+	case -ENOENT:
+		return FS_NO_OP;
+	case -ENOMEM:
+		return FS_ERROR_RESERVED;
+	case -EMSGSIZE:
+		return FS_MEM_OVERFLOW;
+	default:
+		return FS_FUNC_FAIL;
+	}
+}
