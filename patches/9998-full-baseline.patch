diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_ahb.c b/drivers/misc/mediatek/connectivity/wlan/wlan_ahb.c
new file mode 100644
index 000000000..f054a89d5
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_ahb.c
@@ -0,0 +1,774 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 AHB host interface driver.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/ahb.c
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/mt6735/ahb_pdma.c
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/include/hif_pdma.h
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/include/nic/mtreg.h
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ *
+ * The block implements the register/PIO/PDMA half of the gen2 HIF only.
+ * Received buffers are handed to the 802.11 MAC layer in wlan_mac.c
+ * unchanged, exactly like HifAhbISR()/wlanIST() pass them to
+ * nicRxProcessRFBs() in the downstream driver (ahb.c:1215-1249,
+ * wlan_lib.c:1800-1850, nic_rx.c:2734-2823).
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/slab.h>
+
+#include "mtk_wcn_wmt.h"
+#include "wlan_hif.h"
+
+/* HIF register window is 0x5c bytes long (hif.h:217-218). */
+#define MTK_WLAN_HIF_MIN_SIZE		(MCR_HSTCR + 4)
+
+/* PDMA completion poll budget (ahb.c:953,1128). */
+#define MTK_WLAN_HIF_DMA_TIMEOUT	(5 * HZ)
+#define MTK_WLAN_HIF_DMA_POLL_MAX	100000
+
+/* IST loop count, CFG_IST_LOOP_COUNT config.h:1296. */
+#define MTK_WLAN_HIF_RX_DRAIN_MAX	8
+
+static int mtk_wlan_ahb_probe(struct platform_device *pdev);
+static void mtk_wlan_ahb_remove(struct platform_device *pdev);
+
+static const struct of_device_id mtk_wlan_of_match[] = {
+	{ .compatible = "mediatek,wifi" },
+	{ .compatible = "mediatek,WIFI" },	/* ROM carries this spelling */
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_wlan_of_match);
+
+/*
+ * HIF register access helpers.
+ */
+
+/* PIO/PDMA burst and transaction setup, ahb.c:1451-1468. */
+static void mtk_wlan_hif_dma_enhance(struct mtk_wlan_hif *hif, u32 burst,
+				     u32 target, u32 trans)
+{
+	u32 val;
+
+	val = FIELD_PREP(HSTCR_AFF_BURST_LEN, burst) |
+	      FIELD_PREP(HSTCR_TRANS_TARGET, target) |
+	      (((trans & 0x3) == 0) ? (trans & HSTCR_HSIF_TRANS_CNT) :
+	       ((trans + 4) & HSTCR_HSIF_TRANS_CNT));
+	mtk_wlan_hif_writel(hif, MCR_HSTCR, val);
+}
+
+void mtk_wlan_hif_set_int_enable(struct mtk_wlan_hif *hif, bool enable)
+{
+	mtk_wlan_hif_writel(hif, MCR_WHLPCR,
+			    enable ? WHLPCR_INT_EN_SET : WHLPCR_INT_EN_CLR);
+	hif->int_enabled = enable;
+}
+
+/*
+ * AP-DMA (PDMA) primitives, ahb_pdma.c:225-592.
+ */
+
+static u32 mtk_wlan_pdma_readl(struct mtk_wlan_hif *hif, u32 off)
+{
+	return readl(hif->dma_base + off);
+}
+
+static void mtk_wlan_pdma_writel(struct mtk_wlan_hif *hif, u32 off, u32 val)
+{
+	writel(val, hif->dma_base + off);
+}
+
+/* ahb_pdma.c:225-258. */
+static void mtk_wlan_pdma_config(struct mtk_wlan_hif *hif, bool tx, u32 count,
+				 phys_addr_t src, phys_addr_t dst)
+{
+	u32 val;
+
+	/* Burst is fixed to 4/4 and address fix-up is disabled (ahb_pdma.c:231-233). */
+	val = mtk_wlan_pdma_readl(hif, AP_DMA_HIF_CON);
+	val &= ~(ADH_CR_BURST_LEN | ADH_CR_FIX_EN | ADH_CR_DIR);
+	val |= FIELD_PREP(ADH_CR_BURST_LEN, HIF_PDMA_BURST_4_4) |
+	       (tx ? 0 : ADH_CR_DIR);
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_CON, val);
+
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_SRC_ADDR, lower_32_bits(src));
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_DST_ADDR, lower_32_bits(dst));
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_LEN, count & ADH_CR_LEN);
+}
+
+/* ahb_pdma.c:269-289. */
+static void mtk_wlan_pdma_start(struct mtk_wlan_hif *hif)
+{
+	u32 val;
+
+	val = mtk_wlan_pdma_readl(hif, AP_DMA_HIF_INT_EN);
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_INT_EN, val | ADH_CR_INTEN_FLAG_0);
+
+	val = mtk_wlan_pdma_readl(hif, AP_DMA_HIF_EN);
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_EN, val | ADH_CR_EN);
+}
+
+/* ahb_pdma.c:300-324. */
+static void mtk_wlan_pdma_stop(struct mtk_wlan_hif *hif)
+{
+	u32 val;
+
+	val = mtk_wlan_pdma_readl(hif, AP_DMA_HIF_INT_EN);
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_INT_EN, val & ~ADH_CR_INTEN_FLAG_0);
+}
+
+/* ahb_pdma.c:354-362. */
+static bool mtk_wlan_pdma_poll_intr(struct mtk_wlan_hif *hif)
+{
+	return mtk_wlan_pdma_readl(hif, AP_DMA_HIF_INT_FLAG) & ADH_CR_FLAG_0;
+}
+
+/* ahb_pdma.c:373-382. */
+static void mtk_wlan_pdma_ack_intr(struct mtk_wlan_hif *hif)
+{
+	u32 val;
+
+	val = mtk_wlan_pdma_readl(hif, AP_DMA_HIF_INT_FLAG);
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_INT_FLAG, val & ~ADH_CR_FLAG_0);
+}
+
+/* ahb_pdma.c:335-343. */
+static bool mtk_wlan_pdma_poll_start(struct mtk_wlan_hif *hif)
+{
+	return mtk_wlan_pdma_readl(hif, AP_DMA_HIF_EN) & ADH_CR_EN;
+}
+
+/* ahb_pdma.c:568-592. */
+static void mtk_wlan_pdma_reset(struct mtk_wlan_hif *hif)
+{
+	unsigned int i;
+
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_RST, ADH_CR_WARM_RST);
+	for (i = 0; i < 10000; i++) {
+		if (!mtk_wlan_pdma_poll_start(hif))
+			return;
+	}
+
+	dev_info(hif->dev, "PDMA warm reset failed, using hard reset\n");
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_RST, ADH_CR_HARD_RST);
+	mdelay(1);
+	mtk_wlan_pdma_writel(hif, AP_DMA_HIF_RST, 0);
+}
+
+static int mtk_wlan_clk_enable(struct mtk_wlan_hif *hif)
+{
+	int ret;
+
+	if (!hif->clk)
+		return 0;
+
+	ret = clk_prepare_enable(hif->clk);
+	if (ret)
+		dev_err(hif->dev, "cannot enable wifi-dma clock: %d\n", ret);
+	return ret;
+}
+
+static void mtk_wlan_clk_disable(struct mtk_wlan_hif *hif)
+{
+	if (hif->clk)
+		clk_disable_unprepare(hif->clk);
+}
+
+static void mtk_wlan_pdma_dump(struct mtk_wlan_hif *hif)
+{
+	dev_err(hif->dev,
+		"PDMA timeout: WCIR=0x%08x WHLPCR=0x%08x CON=0x%08x EN=0x%08x INT_FLAG=0x%08x\n",
+		mtk_wlan_hif_readl(hif, MCR_WCIR),
+		mtk_wlan_hif_readl(hif, MCR_WHLPCR),
+		mtk_wlan_pdma_readl(hif, AP_DMA_HIF_CON),
+		mtk_wlan_pdma_readl(hif, AP_DMA_HIF_EN),
+		mtk_wlan_pdma_readl(hif, AP_DMA_HIF_INT_FLAG));
+}
+
+/*
+ * Run one PDMA transaction over @size bytes.  @src/@dst are physical
+ * addresses; the HIF side is always one of the data ports.
+ */
+static int mtk_wlan_pdma_transfer(struct mtk_wlan_hif *hif, bool tx, u8 *buf,
+				  u32 size, phys_addr_t port_phys)
+{
+	enum dma_data_direction dir = tx ? DMA_TO_DEVICE : DMA_FROM_DEVICE;
+	unsigned long timeout;
+	dma_addr_t phys;
+	u32 i;
+	int ret = 0;
+
+	phys = dma_map_single(hif->dev, buf, size, dir);
+	if (dma_mapping_error(hif->dev, phys)) {
+		dev_err(hif->dev, "cannot map %u bytes for PDMA\n", size);
+		return -EIO;
+	}
+
+	if (tx)
+		mtk_wlan_pdma_config(hif, true, size, phys, port_phys);
+	else
+		mtk_wlan_pdma_config(hif, false, size, port_phys, phys);
+
+	mtk_wlan_pdma_start(hif);
+
+	timeout = jiffies + MTK_WLAN_HIF_DMA_TIMEOUT;
+	while (!mtk_wlan_pdma_poll_intr(hif)) {
+		if (time_after(jiffies, timeout)) {
+			mtk_wlan_pdma_dump(hif);
+			ret = -ETIMEDOUT;
+			goto unmap;
+		}
+		udelay(1);
+	}
+
+	mtk_wlan_pdma_ack_intr(hif);
+	mtk_wlan_pdma_stop(hif);
+
+	/* Wait for the channel to release EN before the next user (ahb.c:1042-1052). */
+	for (i = 0; i < MTK_WLAN_HIF_DMA_POLL_MAX; i++) {
+		if (!mtk_wlan_pdma_poll_start(hif))
+			break;
+		cpu_relax();
+	}
+	if (i == MTK_WLAN_HIF_DMA_POLL_MAX)
+		dev_warn(hif->dev, "PDMA still enabled after completion\n");
+
+unmap:
+	dma_unmap_single(hif->dev, phys, size, dir);
+	return ret;
+}
+
+/*
+ * Read @size bytes from a HIF port.  @buf must have three bytes of slack
+ * because the hardware is accessed in 32-bit words (ahb.c:1005-1012).
+ */
+int mtk_wlan_hif_port_read(struct mtk_wlan_hif *hif, u16 port, u32 size,
+			   u8 *buf, u32 max)
+{
+	u32 whlpcr, words, i;
+	int ret = 0;
+
+	if (!size)
+		return 0;
+	if (size > max) {
+		dev_err(hif->dev, "port %#x read of %u exceeds buffer %u\n",
+			port, size, max);
+		return -EINVAL;
+	}
+
+	/* Burst length must match the one used by PDMA (ahb.c:877-883). */
+	if (port == MCR_WRDR0)
+		mtk_wlan_hif_dma_enhance(hif, HIF_BURST_4DW, HIF_TARGET_RXD0, size);
+	else if (port == MCR_WRDR1)
+		mtk_wlan_hif_dma_enhance(hif, HIF_BURST_4DW, HIF_TARGET_RXD1, size);
+	else if (port == MCR_WHISR)
+		mtk_wlan_hif_dma_enhance(hif, HIF_BURST_4DW, HIF_TARGET_WHISR, size);
+
+	/* Keep the HIF from raising an interrupt while its data port is busy. */
+	whlpcr = mtk_wlan_hif_readl(hif, MCR_WHLPCR);
+	if (whlpcr & WHLPCR_INT_EN_SET)
+		mtk_wlan_hif_writel(hif, MCR_WHLPCR, WHLPCR_INT_EN_CLR);
+
+	if (hif->dma_enabled && (port == MCR_WRDR0 || port == MCR_WRDR1)) {
+		mutex_lock(&hif->io_lock);
+		ret = mtk_wlan_clk_enable(hif);
+		if (!ret) {
+			ret = mtk_wlan_pdma_transfer(hif, false, buf, size,
+						     hif->hif_phys + port);
+			mtk_wlan_clk_disable(hif);
+		}
+		mutex_unlock(&hif->io_lock);
+	} else {
+		words = DIV_ROUND_UP(size, 4);
+		for (i = 0; i < words; i++)
+			((u32 *)buf)[i] =
+				mtk_wlan_hif_readl(hif, port);
+	}
+
+	if (whlpcr & WHLPCR_INT_EN_SET)
+		mtk_wlan_hif_writel(hif, MCR_WHLPCR, WHLPCR_INT_EN_SET);
+
+	return ret;
+}
+
+/*
+ * Write @size bytes to a HIF port.  @buf must be padded with zeroes to a
+ * 4-byte boundary (ahb.c:1177-1186).
+ */
+int mtk_wlan_hif_port_write(struct mtk_wlan_hif *hif, u16 port, u32 size,
+			    const u8 *buf, u32 max)
+{
+	u32 whlpcr, words, i;
+	int ret = 0;
+
+	if (!size)
+		return 0;
+	if (size > max) {
+		dev_err(hif->dev, "port %#x write of %u exceeds buffer %u\n",
+			port, size, max);
+		return -EINVAL;
+	}
+
+	atomic_inc(&hif->tx_count);
+
+	if (port == MCR_WTDR0)
+		mtk_wlan_hif_dma_enhance(hif, HIF_BURST_4DW, HIF_TARGET_TXD0, size);
+	else if (port == MCR_WTDR1)
+		mtk_wlan_hif_dma_enhance(hif, HIF_BURST_4DW, HIF_TARGET_TXD1, size);
+
+	whlpcr = mtk_wlan_hif_readl(hif, MCR_WHLPCR);
+	if (whlpcr & WHLPCR_INT_EN_SET)
+		mtk_wlan_hif_writel(hif, MCR_WHLPCR, WHLPCR_INT_EN_CLR);
+
+	if (hif->dma_enabled && (port == MCR_WTDR0 || port == MCR_WTDR1)) {
+		mutex_lock(&hif->io_lock);
+		ret = mtk_wlan_clk_enable(hif);
+		if (!ret) {
+			ret = mtk_wlan_pdma_transfer(hif, true, (u8 *)buf, size,
+						     hif->hif_phys + port);
+			mtk_wlan_clk_disable(hif);
+		}
+		mutex_unlock(&hif->io_lock);
+	} else {
+		words = size >> 2;
+		if (size & 0x3)
+			words++;
+		for (i = 0; i < words; i++)
+			mtk_wlan_hif_writel(hif, port, ((const u32 *)buf)[i]);
+	}
+
+	if (whlpcr & WHLPCR_INT_EN_SET)
+		mtk_wlan_hif_writel(hif, MCR_WHLPCR, WHLPCR_INT_EN_SET);
+
+	return ret;
+}
+
+/*
+ * Claim HIF ownership from the firmware, nic_pwr_mgt.c:311-406.
+ * WHLPCR bit 8 reads back set once the host owns the interface.
+ */
+int mtk_wlan_hif_claim_driver_own(struct mtk_wlan_hif *hif)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(WLAN_FW_OWN_TOTAL_MS);
+	u32 i = 0, val;
+
+	for (;;) {
+		val = mtk_wlan_hif_readl(hif, MCR_WHLPCR);
+		if (val & WHLPCR_FW_OWN_REQ_SET)
+			return 0;
+
+		if (time_after(jiffies, deadline)) {
+			dev_err(hif->dev,
+				"driver own failed: WHLPCR=0x%08x D2HRM2R=0x%08x\n",
+				val, mtk_wlan_hif_readl(hif, MCR_D2HRM2R));
+			return -ETIMEDOUT;
+		}
+
+		/* Keep asking the firmware to hand the interface over. */
+		if ((i & (WLAN_FW_OWN_CLR_ITERATION - 1)) == 0)
+			mtk_wlan_hif_writel(hif, MCR_WHLPCR,
+					    WHLPCR_FW_OWN_REQ_CLR);
+
+		msleep(WLAN_FW_OWN_LOOP_MS);
+		i++;
+	}
+}
+
+/*
+ * Chip identification and HIF interrupt setup, ahb.c:455-458 and
+ * nic.c:1172-1258.  Only reachable while the connectivity subsystem is
+ * powered, i.e. from the WMT WIFI function callback.
+ */
+void mtk_wlan_hif_hw_init(struct mtk_wlan_hif *hif)
+{
+	u32 val;
+
+	val = mtk_wlan_hif_readl(hif, MCR_WCIR);
+	hif->chip_id = FIELD_GET(WCIR_CHIP_ID, val);
+	switch (hif->chip_id) {
+	case 0x0321:
+	case 0x0335:
+	case 0x0337:
+		hif->chip_id = 0x6735;	/* Denali chip id transition */
+		break;
+	case 0x0326:
+		hif->chip_id = 0x6755;
+		break;
+	default:
+		break;
+	}
+
+	dev_info(hif->dev, "HIF chip id 0x%04x revision %u\n",
+		 hif->chip_id, (u32)FIELD_GET(WCIR_REVISION_ID, val));
+
+	/* Firmware download runs with interrupts masked (wlan_lib.c:1306-1307). */
+	mtk_wlan_hif_set_int_enable(hif, false);
+
+	/* nicInitializeAdapter(): WHIER default mask (nic.c:1251). */
+	mtk_wlan_hif_writel(hif, MCR_WHIER, WHIER_DEFAULT);
+}
+
+/*
+ * Read one frame from a HIF data port.  The port carries ALIGN_4(packet
+ * length) bytes plus one hardware appended DW with the checksum status
+ * (nic_rx.c:2887-2890), so the read length is not the value in WRPLR.
+ */
+static void mtk_wlan_hif_rx_drain(struct mtk_wlan_hif *hif, u32 port)
+{
+	unsigned int i;
+
+	for (i = 0; i < MTK_WLAN_HIF_RX_DRAIN_MAX; i++) {
+		u32 len, read_len, val;
+
+		val = mtk_wlan_hif_readl(hif, MCR_WRPLR);
+		if (port == MCR_WRDR1)
+			len = FIELD_GET(WRPLR_RX1_PACKET_LENGTH, val);
+		else
+			len = FIELD_GET(WRPLR_RX0_PACKET_LENGTH, val);
+		if (!len)
+			break;
+
+		read_len = ALIGN(len, 4) + MTK_WLAN_HIF_HW_APPENDED_LEN;
+		if (len > MTK_WLAN_RX_MAX_PKT_SIZE ||
+		    read_len > MTK_WLAN_HIF_RX_BUF_SIZE) {
+			/*
+			 * A length beyond the documented maximum means the
+			 * port is out of sync; there is no way to resynchronise
+			 * a PIO/PDMA FIFO, so stop draining this port.
+			 */
+			dev_warn(hif->dev,
+				 "RX port %#x frame of %u bytes dropped\n",
+				 port, len);
+			atomic_inc(&hif->rx_dropped);
+			break;
+		}
+
+		if (mtk_wlan_hif_port_read(hif, port, read_len, hif->rx_buf,
+					   MTK_WLAN_HIF_RX_BUF_SIZE)) {
+			atomic_inc(&hif->rx_dropped);
+			break;
+		}
+
+		mtk_wlan_mac_rx(hif, hif->rx_buf, read_len);
+	}
+
+	if (i)
+		dev_dbg_ratelimited(hif->dev, "drained %u RX frame(s) on port %#x\n",
+				    i, port);
+}
+
+static void mtk_wlan_hif_fatal_work(struct work_struct *work)
+{
+	struct mtk_wlan_hif *hif = container_of(to_delayed_work(work),
+						struct mtk_wlan_hif, fatal_work);
+
+	if (!READ_ONCE(hif->up))
+		return;
+
+	dev_err(hif->dev, "fatal HIF error, asserting connectivity chip\n");
+	/* Same reason code as glDoChipReset(), gl_rst.h:80-89. */
+	mtk_wcn_wmt_assert(WMTDRV_WIFI, 0x40);
+}
+
+static void mtk_wlan_hif_irq_work(struct work_struct *work)
+{
+	struct mtk_wlan_hif *hif = container_of(work, struct mtk_wlan_hif,
+						irq_work);
+	u32 hisr = 0;
+	int ret;
+
+	if (!READ_ONCE(hif->up))
+		return;
+
+	ret = mtk_wlan_hif_port_read(hif, MCR_WHISR, sizeof(hisr),
+				     (u8 *)&hisr, sizeof(hisr));
+	if (ret) {
+		dev_err(hif->dev, "cannot read HIF interrupt status: %d\n", ret);
+		/* Let this work return before WMT may cancel it from teardown. */
+		schedule_delayed_work(&hif->fatal_work, msecs_to_jiffies(100));
+		return;
+	}
+
+	if (hisr & (WHISR_RX0_DONE_INT | WHISR_RX1_DONE_INT)) {
+		if (hisr & WHISR_RX0_DONE_INT)
+			mtk_wlan_hif_rx_drain(hif, MCR_WRDR0);
+		if (hisr & WHISR_RX1_DONE_INT)
+			mtk_wlan_hif_rx_drain(hif, MCR_WRDR1);
+	}
+
+	if (hisr & WHISR_ABNORMAL_INT)
+		dev_warn(hif->dev, "HIF abnormal interrupt, WASR=0x%08x\n",
+			 mtk_wlan_hif_readl(hif, MCR_WASR));
+
+	if (hisr & WHISR_TX_DONE_INT) {
+		u32 wtsr0 = mtk_wlan_hif_readl(hif, MCR_WTSR0);
+		u32 wtsr1 = mtk_wlan_hif_readl(hif, MCR_WTSR1);
+
+		/* Each byte is the released TX buffer count of one TC. */
+		dev_dbg(hif->dev, "TX done, WTSR0=0x%08x WTSR1=0x%08x\n",
+			wtsr0, wtsr1);
+		mtk_wlan_mac_tx_done(hif, wtsr0, wtsr1);
+	}
+
+	/* Re-enable unconditionally, like nicEnableInterrupt() at the end of
+	 * wlanIST() (wlan_lib.c:1846-1847).
+	 */
+	mtk_wlan_hif_set_int_enable(hif, true);
+}
+
+static irqreturn_t mtk_wlan_hif_isr(int irq, void *data)
+{
+	struct mtk_wlan_hif *hif = data;
+
+	/* Mask the source before waking the bottom half (ahb.c:1226-1249). */
+	mtk_wlan_hif_writel(hif, MCR_WHLPCR, WHLPCR_INT_EN_CLR);
+
+	if (READ_ONCE(hif->up))
+		schedule_work(&hif->irq_work);
+
+	return IRQ_HANDLED;
+}
+
+int mtk_wlan_hif_request_irq(struct mtk_wlan_hif *hif)
+{
+	int ret;
+
+	if (hif->irq_requested)
+		return 0;
+
+	ret = request_irq(hif->irq, mtk_wlan_hif_isr, 0, "WLAN AHB ISR", hif);
+	if (ret) {
+		dev_err(hif->dev, "cannot request IRQ %d: %d\n", hif->irq, ret);
+		return ret;
+	}
+	hif->irq_requested = true;
+	return 0;
+}
+
+void mtk_wlan_hif_free_irq(struct mtk_wlan_hif *hif)
+{
+	if (!hif->irq_requested)
+		return;
+
+	free_irq(hif->irq, hif);
+	hif->irq_requested = false;
+}
+
+/*
+ * Quiesce the HIF.  Called from the WMT WIFI function off callback, while
+ * the connectivity subsystem is still powered.
+ */
+void mtk_wlan_hif_stop(struct mtk_wlan_hif *hif)
+{
+	WRITE_ONCE(hif->up, false);
+
+	if (hif->int_enabled)
+		mtk_wlan_hif_set_int_enable(hif, false);
+
+	mtk_wlan_hif_free_irq(hif);
+	cancel_work_sync(&hif->irq_work);
+}
+
+int mtk_wlan_hif_start(struct mtk_wlan_hif *hif)
+{
+	bool reenable_irq = false;
+	int ret;
+
+	/*
+	 * On a re-start after a whole-chip reset the IRQ is still installed.
+	 * Park it while the HIF is re-initialised so the bottom half cannot
+	 * touch a half-programmed interface.
+	 */
+	if (hif->irq_requested) {
+		disable_irq(hif->irq);
+		reenable_irq = true;
+	}
+
+	ret = mtk_wlan_hif_request_irq(hif);
+	if (ret)
+		goto out;
+
+	if (hif->dma_base) {
+		mutex_lock(&hif->io_lock);
+		if (!mtk_wlan_clk_enable(hif)) {
+			mtk_wlan_pdma_reset(hif);
+			mtk_wlan_clk_disable(hif);
+		}
+		mutex_unlock(&hif->io_lock);
+	}
+
+out:
+	if (reenable_irq)
+		enable_irq(hif->irq);
+	return ret;
+}
+
+/*
+ * Platform driver.
+ */
+
+static struct device_node *mtk_wlan_consys_node(void)
+{
+	return of_find_compatible_node(NULL, NULL, "mediatek,mt6735-consys");
+}
+
+static int mtk_wlan_ahb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_wlan_hif *hif;
+	struct resource *res;
+	struct device_node *np;
+	struct platform_device *consys;
+	int ret;
+
+	hif = devm_kzalloc(dev, sizeof(*hif), GFP_KERNEL);
+	if (!hif)
+		return -ENOMEM;
+
+	hif->dev = dev;
+	hif->irq = platform_get_irq(pdev, 0);
+	if (hif->irq < 0)
+		return hif->irq;
+
+	hif->hif_base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(hif->hif_base))
+		return PTR_ERR(hif->hif_base);
+	if (resource_size(res) < MTK_WLAN_HIF_MIN_SIZE)
+		dev_warn(dev, "HIF window is only %#llx bytes\n",
+			 (u64)resource_size(res));
+	hif->hif_phys = res->start;
+
+	/*
+	 * The AP-DMA channel is optional: without it the HIF falls back to
+	 * PIO, which is slow but functional (hif.h:71).
+	 */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (res) {
+		hif->dma_base = devm_ioremap_resource(dev, res);
+		if (IS_ERR(hif->dma_base))
+			return PTR_ERR(hif->dma_base);
+		if (resource_size(res) < AP_DMA_HIF_LENGTH) {
+			dev_warn(dev, "AP-DMA window too small, using PIO\n");
+			hif->dma_base = NULL;
+		}
+	} else {
+		dev_warn(dev, "no AP-DMA window in DT, using PIO\n");
+	}
+	hif->dma_enabled = !!hif->dma_base;
+
+	hif->clk = devm_clk_get(dev, "wifi-dma");
+	if (IS_ERR(hif->clk))
+		return dev_err_probe(dev, PTR_ERR(hif->clk),
+				     "cannot get wifi-dma clock\n");
+
+	hif->rx_buf = devm_kmalloc(dev, MTK_WLAN_HIF_RX_BUF_SIZE, GFP_KERNEL);
+	if (!hif->rx_buf)
+		return -ENOMEM;
+
+	mutex_init(&hif->io_lock);
+	mutex_init(&hif->state_lock);
+	atomic_set(&hif->tx_count, 0);
+	atomic_set(&hif->rx_dropped, 0);
+	INIT_WORK(&hif->irq_work, mtk_wlan_hif_irq_work);
+	INIT_DELAYED_WORK(&hif->fatal_work, mtk_wlan_hif_fatal_work);
+
+	/*
+	 * The connectivity subsystem must be resumed before this device; the
+	 * link is informational when the CONSYS node is present.
+	 */
+	np = mtk_wlan_consys_node();
+	if (np) {
+		consys = of_find_device_by_node(np);
+		if (consys) {
+			if (!device_link_add(dev, &consys->dev,
+					     DL_FLAG_STATELESS |
+					     DL_FLAG_AUTOREMOVE_CONSUMER))
+				dev_dbg(dev, "cannot link to the consys device\n");
+			put_device(&consys->dev);
+		} else {
+			dev_dbg(dev, "consys device not available yet\n");
+		}
+		of_node_put(np);
+	}
+
+	platform_set_drvdata(pdev, hif);
+
+	ret = mtk_wlan_main_attach(hif);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "MediaTek WLAN AHB HIF ready (%s)\n",
+		 hif->dma_enabled ? "PDMA" : "PIO");
+	return 0;
+}
+
+static void mtk_wlan_ahb_remove(struct platform_device *pdev)
+{
+	struct mtk_wlan_hif *hif = platform_get_drvdata(pdev);
+
+	if (!hif)
+		return;
+
+	mtk_wlan_main_detach(hif);
+	cancel_delayed_work_sync(&hif->fatal_work);
+	mtk_wlan_hif_stop(hif);
+}
+
+static int mtk_wlan_ahb_suspend(struct device *dev)
+{
+	struct mtk_wlan_hif *hif = dev_get_drvdata(dev);
+
+	if (hif && READ_ONCE(hif->up) && hif->int_enabled) {
+		mtk_wlan_hif_set_int_enable(hif, false);
+		hif->suspended = true;
+	}
+	return 0;
+}
+
+static int mtk_wlan_ahb_resume(struct device *dev)
+{
+	struct mtk_wlan_hif *hif = dev_get_drvdata(dev);
+
+	if (hif && hif->suspended) {
+		hif->suspended = false;
+		if (READ_ONCE(hif->up))
+			mtk_wlan_hif_set_int_enable(hif, true);
+	}
+	return 0;
+}
+
+static const struct dev_pm_ops mtk_wlan_pm_ops = {
+	.suspend = mtk_wlan_ahb_suspend,
+	.resume = mtk_wlan_ahb_resume,
+};
+
+static struct platform_driver mtk_wlan_ahb_driver = {
+	.probe = mtk_wlan_ahb_probe,
+	.remove = mtk_wlan_ahb_remove,
+	.driver = {
+		.name = "mt-wifi",
+		.of_match_table = mtk_wlan_of_match,
+		.pm = &mtk_wlan_pm_ops,
+	},
+};
+
+int mtk_wlan_ahb_driver_register(void)
+{
+	return platform_driver_register(&mtk_wlan_ahb_driver);
+}
+
+void mtk_wlan_ahb_driver_unregister(void)
+{
+	platform_driver_unregister(&mtk_wlan_ahb_driver);
+}
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_cmd.c b/drivers/misc/mediatek/connectivity/wlan/wlan_cmd.c
new file mode 100644
index 000000000..50d7e0501
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_cmd.c
@@ -0,0 +1,598 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 firmware command/event channel.
+ *
+ * The gen2 firmware is configured with Set commands written to HIF TX port 1
+ * (traffic class TC4) and answers them with EVENT_ID_CMD_RESULT events on the
+ * HIF RX side.  This file implements that transport and the three commands
+ * needed to make the firmware aware of a station association:
+ *
+ *   CMD_ID_BSS_ACTIVATE_CTRL   network activation, nicActivateNetwork()
+ *   CMD_ID_UPDATE_STA_RECORD   AP peer record, cnmStaSendUpdateCmd()
+ *   CMD_ID_SET_BSS_INFO        BSS state, nicUpdateBss()
+ *   CMD_ID_REMOVE_STA_RECORD   peer removal, cnmStaSendRemoveCmd()
+ *
+ * Ported from Samsung/MTK downstream:
+ *   include/nic/cmd_buf.h      (CMD_INFO_T, CMD_HDR_SIZE)
+ *   include/nic_cmd_event.h    (WIFI_CMD_T / WIFI_EVENT_T, CMD_* structs)
+ *   nic/nic_tx.c:1597-1761     (nicTxCmd: command PDU framing, port 1)
+ *   common/wlan_lib.c:2037-2098 (wlanSendCommand: TC4, one credit)
+ *   nic/nic_rx.c:1789-1830     (EVENT_ID_CMD_RESULT, matched by sequence)
+ *   nic/nic.c:1966-2103        (nicUpdateBss)
+ *   nic/nic.c:1902-1927        (nicActivateNetwork)
+ *   mgmt/cnm_mem.c:1129-1238   (cnmStaSendUpdateCmd / cnmStaSendRemoveCmd)
+ *   mgmt/rate.c:80-254         (rate IE to rate-set conversion)
+ *   mgmt/rlm.c:1713-1745       (rlmFillSyncCmdParam)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#include <linux/build_bug.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/etherdevice.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <net/cfg80211.h>
+
+#include "wlan_cmd.h"
+#include "wlan_mac.h"
+
+/*
+ * Values copied from the downstream enums:
+ *
+ *   ENUM_PARAM_MEDIA_STATE_T       wlan_oid.h:394-399   CONNECTED = 0
+ *   ENUM_PARAM_AUTH_MODE_T         wlan_oid.h:302-315   AUTH_MODE_OPEN = 0 or 1
+ *   ENUM_WEP_STATUS_T              wlan_oid.h:321-335   ENCRYPTION_DISABLED = 1
+ *   ENUM_STA_TYPE_T                wlan_def.h:769-783   LEGACY_AP = BIT(0)|BIT(6)
+ *   ENUM_PHY_TYPE_INDEX_T          wlan_def.h:547-555   HR_DSSS = 0, ERP = 1
+ *   ENUM_OP_MODE_T                 wlan_def.h:563-571   INFRASTRUCTURE = 0
+ *   ENUM_BAND_T                    wlan_def.h:582-587   BAND_2G4 = 1
+ *   ENUM_CHNL_EXT_T                wlan_def.h:574-579   CHNL_EXT_SCN = 0
+ *   ENUM_HIDDEN_SSID_TYPE_T        p2p_fsm.h:500-505    NONE = 0
+ *   STA_STATE_1 / STA_STATE_3      mac.h:261-263         0 / 2
+ *   PHY_TYPE_BIT_* / RATE_SET_*    wlan_def.h:293-388
+ *
+ * The firmware AUTH_MODE_OPEN value is 0: nicUpdateBss() stores
+ * eAuthMode - 1 when CFG_SUPPORT_802_11R is built in (nic.c:2049-2058), and
+ * AUTH_MODE_OPEN is followed by no other value without it (wlan_oid.h:302-315);
+ * both cases write 0 for an open network.
+ */
+#define MTK_WLAN_MEDIA_STATE_CONNECTED		0
+#define MTK_WLAN_MEDIA_STATE_DISCONNECTED	1
+#define MTK_WLAN_AUTH_MODE_OPEN_FW		0
+#define MTK_WLAN_ENCRYPTION_DISABLED		1
+#define MTK_WLAN_STA_TYPE_LEGACY_AP		(BIT(0) | BIT(6))
+#define MTK_WLAN_OP_MODE_INFRASTRUCTURE		0
+#define MTK_WLAN_BAND_2G4			1
+#define MTK_WLAN_CHNL_EXT_SCN			0
+#define MTK_WLAN_HIDDEN_SSID_NONE		0
+#define MTK_WLAN_PHY_TYPE_HR_DSSS_INDEX		0
+#define MTK_WLAN_PHY_TYPE_ERP_INDEX		1
+#define MTK_WLAN_PHY_TYPE_BIT_HR_DSSS		BIT(0)
+#define MTK_WLAN_PHY_TYPE_BIT_ERP		BIT(1)
+#define MTK_WLAN_PHY_TYPE_SET_802_11BG \
+	(MTK_WLAN_PHY_TYPE_BIT_HR_DSSS | MTK_WLAN_PHY_TYPE_BIT_ERP)
+
+/* RATE_SET_* bits, wlan_def.h:322-360. */
+#define MTK_WLAN_RATE_SET_HR_DSSS \
+	(BIT(0) | BIT(1) | BIT(2) | BIT(3))
+#define MTK_WLAN_RATE_SET_OFDM \
+	(BIT(6) | BIT(7) | BIT(8) | BIT(9) | BIT(10) | BIT(11) | \
+	 BIT(12) | BIT(13))
+#define MTK_WLAN_RATE_SET_ALL_ABG \
+	(MTK_WLAN_RATE_SET_HR_DSSS | MTK_WLAN_RATE_SET_OFDM)
+
+/* ERP IE bits, mac.h:848-849. */
+#define MTK_WLAN_ERP_USE_PROTECTION		BIT(1)
+#define MTK_WLAN_ERP_BARKER_PREAMBLE		BIT(2)
+
+/* ucCheckId of CMD_SET_BSS_RLM_PARAM_T, rlm.c:1741. */
+#define MTK_WLAN_RLM_CHECK_ID			0x72
+
+/*
+ * Supported-rate codes in 500 kb/s units, in RATE_*_INDEX order
+ * (aucDataRate[], rate.c:80-96; values from mac.h:234-247).
+ */
+static const u8 mtk_wlan_data_rates[] = {
+	2, 4, 11, 22, 44, 66, 12, 18, 24, 36, 48, 72, 96, 108,
+};
+
+/* RATE_BASIC_BIT / RATE_MASK, mac.h:250-251. */
+#define MTK_WLAN_RATE_MASK			GENMASK(6, 0)
+#define MTK_WLAN_RATE_BASIC			BIT(7)
+
+static_assert(sizeof(struct mtk_wlan_cmd_hdr) == 8);
+static_assert(sizeof(struct mtk_wlan_event_hdr) == 8);
+static_assert(sizeof(struct mtk_wlan_event_cmd_result) == 4);
+static_assert(sizeof(struct mtk_wlan_cmd_bss_activate) == 4);
+static_assert(sizeof(struct mtk_wlan_cmd_set_bss_rlm) == 16);
+static_assert(sizeof(struct mtk_wlan_cmd_set_bss_info) == 80);
+static_assert(offsetof(struct mtk_wlan_cmd_set_bss_info, rlm) == 64);
+static_assert(sizeof(struct mtk_wlan_cmd_update_sta) == 40);
+static_assert(sizeof(struct mtk_wlan_cmd_remove_sta) == 8);
+
+/**
+ * mtk_wlan_cmd_init - initialize the command channel state
+ * @mac: MAC instance
+ */
+void mtk_wlan_cmd_init(struct mtk_wlan_mac *mac)
+{
+	mutex_init(&mac->cmd.lock);
+	spin_lock_init(&mac->cmd.wait_lock);
+	init_completion(&mac->cmd.done);
+	mac->cmd.aborted = false;
+}
+
+/* Allow commands again after the firmware came back up. */
+void mtk_wlan_cmd_reset(struct mtk_wlan_mac *mac)
+{
+	spin_lock_bh(&mac->cmd.wait_lock);
+	mac->cmd.aborted = false;
+	mac->cmd.pending = false;
+	spin_unlock_bh(&mac->cmd.wait_lock);
+}
+
+/**
+ * mtk_wlan_cmd_cancel - release the command in flight without poisoning the channel
+ * @mac: MAC instance
+ *
+ * Used when a connect attempt is cancelled while the firmware is still up:
+ * the waiting command returns -ECANCELED, and the teardown commands that
+ * follow still work.
+ */
+void mtk_wlan_cmd_cancel(struct mtk_wlan_mac *mac)
+{
+	bool wake = false;
+
+	spin_lock_bh(&mac->cmd.wait_lock);
+	if (mac->cmd.pending) {
+		mac->cmd.result = -ECANCELED;
+		wake = true;
+	}
+	spin_unlock_bh(&mac->cmd.wait_lock);
+
+	if (wake)
+		complete(&mac->cmd.done);
+}
+
+/**
+ * mtk_wlan_cmd_abort - fail the command in flight after a firmware loss
+ * @mac: MAC instance
+ *
+ * Called from the firmware-down path.  The sender is released with -ENETDOWN
+ * and every later command fails immediately until mtk_wlan_cmd_reset().
+ */
+void mtk_wlan_cmd_abort(struct mtk_wlan_mac *mac)
+{
+	bool wake = false;
+
+	spin_lock_bh(&mac->cmd.wait_lock);
+	mac->cmd.aborted = true;
+	if (mac->cmd.pending) {
+		mac->cmd.result = -ENETDOWN;
+		wake = true;
+	}
+	spin_unlock_bh(&mac->cmd.wait_lock);
+
+	if (wake)
+		complete(&mac->cmd.done);
+}
+
+/**
+ * mtk_wlan_cmd_event - dispatch one HIF RX event buffer
+ * @mac: MAC instance
+ * @buf: event payload starting at WIFI_EVENT_T
+ * @len: payload length
+ *
+ * Only command results are consumed here.  The firmware may emit further
+ * unsolicited events (STA record activation, channel privilege, ...); they
+ * have no consumer in this port and are ignored.  Matching is by sequence
+ * number like nicGetPendingCmdInfo() (nic.c:1406-1437); the command id in the
+ * payload is only checked for diagnostics.
+ */
+void mtk_wlan_cmd_event(struct mtk_wlan_mac *mac, const u8 *buf, size_t len)
+{
+	const struct mtk_wlan_event_hdr *ev = (const void *)buf;
+	const struct mtk_wlan_event_cmd_result *res;
+	bool wake = false, mismatch = false;
+	u8 pending_cid = 0;
+	int result;
+
+	if (len < MTK_WLAN_EVENT_HDR_LEN + sizeof(*res))
+		return;
+	if (ev->eid != MTK_WLAN_EVENT_ID_CMD_RESULT)
+		return;
+	if (le16_to_cpu(ev->packet_len) <
+	    MTK_WLAN_EVENT_HDR_LEN + sizeof(*res))
+		return;
+
+	res = (const void *)(buf + MTK_WLAN_EVENT_HDR_LEN);
+	switch (res->status) {
+	case MTK_WLAN_CMD_STATUS_SUCCESS:
+		result = 0;
+		break;
+	case MTK_WLAN_CMD_STATUS_REJECTED:
+		result = -EIO;
+		break;
+	case MTK_WLAN_CMD_STATUS_UNKNOWN:
+		result = -EOPNOTSUPP;
+		break;
+	default:
+		result = -EIO;
+		break;
+	}
+
+	spin_lock_bh(&mac->cmd.wait_lock);
+	if (!mac->cmd.pending || ev->seq != mac->cmd.seq) {
+		spin_unlock_bh(&mac->cmd.wait_lock);
+		return;
+	}
+	pending_cid = mac->cmd.cid;
+	mismatch = res->cmd_id != pending_cid;
+	mac->cmd.result = result;
+	wake = true;
+	spin_unlock_bh(&mac->cmd.wait_lock);
+
+	if (mismatch)
+		dev_warn_ratelimited(mac->dev,
+				     "command result cid 0x%02x for pending 0x%02x\n",
+				     res->cmd_id, pending_cid);
+	if (wake)
+		complete(&mac->cmd.done);
+}
+
+/*
+ * Send one command PDU and optionally wait for its result event.
+ *
+ * Framing follows nicTxCmd() (nic_tx.c:1700-1740): the buffer is
+ * WIFI_CMD_T + payload, its first DW is the HIF TX header's first DW, the
+ * packet type is HIF_TX_PKT_TYPE_CMD on TC4/port 1 and the length is padded
+ * to a DW (TFCB_FRAME_PAD_TO_DW(), hif_tx.h:206).  One TC4 buffer is used
+ * (wlanSendCommand(), wlan_lib.c:2077-2086); the TX-done interrupt returns it.
+ */
+static int mtk_wlan_cmd_send(struct mtk_wlan_mac *mac, u8 cid, bool set_query,
+			     bool need_resp, const void *payload, size_t len)
+{
+	struct mtk_wlan_hif *hif = mac->hif;
+	struct mtk_wlan_cmd_hdr *hdr;
+	u8 buf[MTK_WLAN_CMD_BUF_MAX];
+	size_t total = ALIGN(MTK_WLAN_CMD_HDR_LEN + len, 4);
+	unsigned int tries;
+	unsigned long timeout;
+	int ret;
+
+	if (!READ_ONCE(mac->fw_up))
+		return -ENETDOWN;
+	if (MTK_WLAN_CMD_HDR_LEN + len > sizeof(buf))
+		return -EMSGSIZE;
+
+	mutex_lock(&mac->cmd.lock);
+
+	for (tries = 0; tries < MTK_WLAN_CMD_TRIES; tries++) {
+		if (mtk_wlan_tc_acquire(mac, MTK_WLAN_TC4))
+			break;
+		msleep(MTK_WLAN_CMD_POLL_MS);
+	}
+	if (tries == MTK_WLAN_CMD_TRIES) {
+		mutex_unlock(&mac->cmd.lock);
+		return -EBUSY;
+	}
+
+	memset(buf, 0, total);
+	hdr = (struct mtk_wlan_cmd_hdr *)buf;
+
+	spin_lock_bh(&mac->cmd.wait_lock);
+	if (mac->cmd.aborted || !READ_ONCE(mac->fw_up)) {
+		spin_unlock_bh(&mac->cmd.wait_lock);
+		mtk_wlan_tc_release(mac, MTK_WLAN_TC4, 1);
+		mutex_unlock(&mac->cmd.lock);
+		return -ENETDOWN;
+	}
+	mac->cmd.seq++;
+	mac->cmd.cid = cid;
+	mac->cmd.result = 0;
+	mac->cmd.pending = need_resp;
+	reinit_completion(&mac->cmd.done);
+	hdr->seq = mac->cmd.seq;
+	spin_unlock_bh(&mac->cmd.wait_lock);
+
+	hdr->tx_byte_count_user_priority =
+		cpu_to_le16((u16)total & HIF_TX_HDR_TX_BYTE_COUNT_MASK);
+	hdr->ether_type_offset = 0;
+	hdr->resource_pkttype_csflags =
+		FIELD_PREP(HIF_TX_HDR_RESOURCE_MASK, MTK_WLAN_TC4) |
+		FIELD_PREP(HIF_TX_HDR_PACKET_TYPE_MASK, HIF_TX_PKT_TYPE_CMD);
+	hdr->cid = cid;
+	hdr->set_query = set_query ? 1 : 0;
+	if (len)
+		memcpy(buf + MTK_WLAN_CMD_HDR_LEN, payload, len);
+
+	mutex_lock(&mac->tx_lock);
+	ret = mtk_wlan_hif_port_write(hif, MCR_WTDR1, total, buf, total);
+	mutex_unlock(&mac->tx_lock);
+
+	if (ret) {
+		mtk_wlan_tc_release(mac, MTK_WLAN_TC4, 1);
+		spin_lock_bh(&mac->cmd.wait_lock);
+		mac->cmd.pending = false;
+		spin_unlock_bh(&mac->cmd.wait_lock);
+		mutex_unlock(&mac->cmd.lock);
+		return ret;
+	}
+
+	if (need_resp) {
+		timeout = msecs_to_jiffies(MTK_WLAN_CMD_TIMEOUT_MS);
+		if (!wait_for_completion_timeout(&mac->cmd.done, timeout)) {
+			dev_warn(mac->dev, "command 0x%02x seq %u timed out\n",
+				 cid, hdr->seq);
+			ret = -ETIMEDOUT;
+		} else {
+			ret = mac->cmd.result;
+		}
+	}
+
+	spin_lock_bh(&mac->cmd.wait_lock);
+	mac->cmd.pending = false;
+	spin_unlock_bh(&mac->cmd.wait_lock);
+	mutex_unlock(&mac->cmd.lock);
+
+	return ret;
+}
+
+/* Convert one Supported/Extended Supported Rates element to rate-set bits. */
+static u16 mtk_wlan_rate_set_from_element(const struct element *ie, u16 *basic)
+{
+	unsigned int i, j;
+	u16 set = 0;
+
+	if (!ie)
+		return 0;
+
+	for (i = 0; i < ie->datalen; i++) {
+		u8 code = ie->data[i] & MTK_WLAN_RATE_MASK;
+
+		for (j = 0; j < ARRAY_SIZE(mtk_wlan_data_rates); j++) {
+			if (code != mtk_wlan_data_rates[j])
+				continue;
+			set |= BIT(j);
+			if (ie->data[i] & MTK_WLAN_RATE_BASIC)
+				*basic |= BIT(j);
+			break;
+		}
+	}
+
+	return set;
+}
+
+/**
+ * mtk_wlan_cmd_prepare_ap - derive the firmware AP parameters from a BSS entry
+ * @mac: MAC instance
+ * @bss: BSS the station is about to join, reference held by the caller
+ *
+ * Fills the operational/basic rate sets, PHY type set and protection
+ * parameters the BSS and STA record commands carry.  Downstream derives them
+ * from the beacon/probe response in rateGetRateSetFromIEs() (rate.c:178-254)
+ * and the scan descriptor, and copies them into STA_RECORD_T/BSS_INFO_T in
+ * bssCreateStaRecFromBssDesc() (bss.c:614-662).
+ *
+ * Return: 0 on success, -EINVAL when the AP advertises no usable 2.4 GHz rate.
+ */
+int mtk_wlan_cmd_prepare_ap(struct mtk_wlan_mac *mac, struct cfg80211_bss *bss)
+{
+	const struct element *ie;
+	u16 op = 0, basic = 0;
+	u8 phy = 0;
+	bool barker = false;
+
+	ie = ieee80211_bss_get_elem(bss, WLAN_EID_SUPP_RATES);
+	op |= mtk_wlan_rate_set_from_element(ie, &basic);
+	ie = ieee80211_bss_get_elem(bss, WLAN_EID_EXT_SUPP_RATES);
+	op |= mtk_wlan_rate_set_from_element(ie, &basic);
+	if (!op) {
+		dev_dbg(mac->dev, "AP %pM advertises no supported rates\n",
+			bss->bssid);
+		return -EINVAL;
+	}
+
+	if (op & MTK_WLAN_RATE_SET_HR_DSSS)
+		phy |= MTK_WLAN_PHY_TYPE_BIT_HR_DSSS;
+	if (op & MTK_WLAN_RATE_SET_OFDM)
+		phy |= MTK_WLAN_PHY_TYPE_BIT_ERP;
+	phy &= MTK_WLAN_PHY_TYPE_SET_802_11BG;
+	if (!phy)
+		return -EINVAL;
+
+	ie = ieee80211_bss_get_elem(bss, WLAN_EID_ERP_INFO);
+	if (ie && ie->datalen >= 1) {
+		mac->ap_erp_protect = !!(ie->data[0] & MTK_WLAN_ERP_USE_PROTECTION);
+		barker = !!(ie->data[0] & MTK_WLAN_ERP_BARKER_PREAMBLE);
+	} else {
+		mac->ap_erp_protect = false;
+	}
+
+	mac->ap_rate_set = op;
+	mac->ap_basic_rate_set = basic;
+	mac->ap_phy_type_set = phy;
+	mac->ap_nonht_phy = (phy & MTK_WLAN_PHY_TYPE_BIT_ERP) ?
+			    MTK_WLAN_PHY_TYPE_ERP_INDEX :
+			    MTK_WLAN_PHY_TYPE_HR_DSSS_INDEX;
+	mac->ap_short_preamble =
+		(bss->capability & WLAN_CAPABILITY_SHORT_PREAMBLE) && !barker;
+	mac->ap_short_slot =
+		!!(bss->capability & WLAN_CAPABILITY_SHORT_SLOT_TIME);
+
+	return 0;
+}
+
+/**
+ * mtk_wlan_cmd_bss_activate - activate or deactivate the AIS network
+ * @mac: MAC instance
+ * @active: %true to activate
+ *
+ * nicActivateNetwork()/nicDeactivateNetwork(), nic.c:1902-1958.
+ *
+ * Return: 0 on success, negative errno otherwise.
+ */
+int mtk_wlan_cmd_bss_activate(struct mtk_wlan_mac *mac, bool active)
+{
+	struct mtk_wlan_cmd_bss_activate cmd = {
+		.net_type_index = MTK_WLAN_NETWORK_TYPE_AIS,
+		.active = active ? 1 : 0,
+	};
+
+	return mtk_wlan_cmd_send(mac, MTK_WLAN_CMD_ID_BSS_ACTIVATE_CTRL, true,
+				 false, &cmd, sizeof(cmd));
+}
+
+/**
+ * mtk_wlan_cmd_set_bss_info - sync the BSS state to the firmware
+ * @mac: MAC instance
+ * @connected: %true for the connected state
+ *
+ * nicUpdateBss(), nic.c:1966-2090, with rlmFillSyncCmdParam()
+ * (rlm.c:1713-1745) for the embedded RLM parameters.
+ *
+ * Return: 0 on success, negative errno otherwise.
+ */
+int mtk_wlan_cmd_set_bss_info(struct mtk_wlan_mac *mac, bool connected)
+{
+	struct mtk_wlan_cmd_set_bss_info cmd = { };
+	u8 ssid_len = min_t(u8, mac->ssid_len, sizeof(cmd.ssid));
+
+	cmd.net_type_index = MTK_WLAN_NETWORK_TYPE_AIS;
+	cmd.connection_state = connected ? MTK_WLAN_MEDIA_STATE_CONNECTED :
+			       MTK_WLAN_MEDIA_STATE_DISCONNECTED;
+	cmd.current_op_mode = MTK_WLAN_OP_MODE_INFRASTRUCTURE;
+	cmd.ssid_len = ssid_len;
+	memcpy(cmd.ssid, mac->ssid, ssid_len);
+	memcpy(cmd.bssid, mac->bssid, ETH_ALEN);
+	cmd.is_qbss = 0;
+	cmd.operational_rate_set = cpu_to_le16(mac->ap_rate_set);
+	cmd.bss_basic_rate_set = cpu_to_le16(mac->ap_basic_rate_set);
+	cmd.sta_rec_idx_of_ap = mac->sta_valid ? mac->sta_index :
+				MTK_WLAN_STA_REC_NOT_FOUND;
+	cmd.nonht_basic_phy_type = mac->ap_nonht_phy;
+	cmd.auth_mode = MTK_WLAN_AUTH_MODE_OPEN_FW;
+	cmd.enc_status = MTK_WLAN_ENCRYPTION_DISABLED;
+	cmd.phy_type_set = mac->ap_phy_type_set;
+	memcpy(cmd.own_mac, mac->mac_addr, ETH_ALEN);
+	cmd.wapi_mode = 0;
+	cmd.is_ap_mode = 0;
+	cmd.hidden_ssid_mode = MTK_WLAN_HIDDEN_SSID_NONE;
+	cmd.rlm.net_type_index = MTK_WLAN_NETWORK_TYPE_AIS;
+	cmd.rlm.rf_band = MTK_WLAN_BAND_2G4;
+	cmd.rlm.primary_channel = (u8)mac->channel;
+	cmd.rlm.rf_sco = MTK_WLAN_CHNL_EXT_SCN;
+	cmd.rlm.erp_protect_mode = mac->ap_erp_protect ? 1 : 0;
+	cmd.rlm.ht_protect_mode = 0;	/* HT_PROTECT_MODE_NONE, rlm_protection.h:74 */
+	cmd.rlm.gf_operation_mode = 0;	/* GF_MODE_NORMAL, rlm_protection.h:83 */
+	cmd.rlm.tx_rifs_mode = 0;	/* RIFS_MODE_NORMAL, rlm_protection.h:91 */
+	cmd.rlm.use_short_preamble = mac->ap_short_preamble ? 1 : 0;
+	cmd.rlm.use_short_slot_time = mac->ap_short_slot ? 1 : 0;
+	cmd.rlm.check_id = MTK_WLAN_RLM_CHECK_ID;
+
+	return mtk_wlan_cmd_send(mac, MTK_WLAN_CMD_ID_SET_BSS_INFO, true, false,
+				 &cmd, sizeof(cmd));
+}
+
+/**
+ * mtk_wlan_cmd_update_sta - create or update the AP peer record
+ * @mac: MAC instance
+ * @state: %MTK_WLAN_STA_STATE_1 or %MTK_WLAN_STA_STATE_3
+ * @aid: association id, only used for state 3
+ * @need_resp: wait for the firmware result event
+ *
+ * cnmStaSendUpdateCmd(), cnm_mem.c:1129-1215, with the fields
+ * cnmStaRecChangeState() synchronises (cnm_mem.c:1032-1056).  The peer is the
+ * AP itself, so the record type is STA_TYPE_LEGACY_AP (ais_fsm.c:1372).
+ *
+ * Return: 0 on success, negative errno otherwise.
+ */
+int mtk_wlan_cmd_update_sta(struct mtk_wlan_mac *mac, u8 state, u16 aid,
+			    bool need_resp)
+{
+	struct mtk_wlan_cmd_update_sta cmd = { };
+
+	cmd.index = mac->sta_index;
+	cmd.sta_type = MTK_WLAN_STA_TYPE_LEGACY_AP;
+	memcpy(cmd.mac_addr, mac->bssid, ETH_ALEN);
+	cmd.assoc_id = cpu_to_le16(aid);
+	cmd.listen_interval = cpu_to_le16(MTK_WLAN_LISTEN_INTERVAL);
+	cmd.net_type_index = MTK_WLAN_NETWORK_TYPE_AIS;
+	cmd.desired_phy_type_set = mac->ap_phy_type_set;
+	cmd.desired_nonht_rate_set =
+		cpu_to_le16(mac->ap_rate_set & MTK_WLAN_RATE_SET_ALL_ABG);
+	cmd.bss_basic_rate_set = cpu_to_le16(mac->ap_basic_rate_set);
+	cmd.is_qos = 0;
+	cmd.is_uapsd_supported = 0;
+	cmd.sta_state = state;
+	cmd.mcs_set = 0;
+	cmd.sup_mcs32 = 0;
+	cmd.ampdu_param = 0;
+	cmd.ht_cap_info = 0;
+	cmd.ht_extended_cap = 0;
+	cmd.tx_beamforming_cap = 0;
+	cmd.asel_cap = 0;
+	cmd.rcpi = READ_ONCE(mac->last_signal);
+	cmd.need_resp = need_resp ? 1 : 0;
+	cmd.uapsd_ac = 0;
+	cmd.uapsd_sp = 0;
+
+	return mtk_wlan_cmd_send(mac, MTK_WLAN_CMD_ID_UPDATE_STA_RECORD, true,
+				 need_resp, &cmd, sizeof(cmd));
+}
+
+/**
+ * mtk_wlan_cmd_remove_sta - delete the AP peer record
+ * @mac: MAC instance
+ *
+ * cnmStaSendRemoveCmd(), cnm_mem.c:1220-1238.
+ *
+ * Return: 0 on success, negative errno otherwise.
+ */
+int mtk_wlan_cmd_remove_sta(struct mtk_wlan_mac *mac)
+{
+	struct mtk_wlan_cmd_remove_sta cmd = { };
+
+	cmd.index = mac->sta_index;
+	memcpy(cmd.mac_addr, mac->bssid, ETH_ALEN);
+
+	return mtk_wlan_cmd_send(mac, MTK_WLAN_CMD_ID_REMOVE_STA_RECORD, true,
+				 false, &cmd, sizeof(cmd));
+}
+
+/**
+ * mtk_wlan_cmd_teardown - release the firmware association state
+ * @mac: MAC instance
+ *
+ * Downstream disconnects by moving AIS to PARAM_MEDIA_STATE_DISCONNECTED and
+ * calling nicUpdateBss() (ais_fsm.c:4072-4080), which is the SET_BSS_INFO
+ * command below.  The driver-side STA record is then freed without a chip
+ * sync (cnmStaRecFree(..., FALSE), ais_fsm.c:4975), so downstream does not
+ * send CMD_ID_REMOVE_STA_RECORD for an AIS peer (that command is used by P2P
+ * and TDLS, p2p_func.c:1103 and tdls.c:4331).  This port does send it: the
+ * command and its payload are part of the same firmware ABI, it makes the
+ * next association start from a clean record, and the result is not awaited.
+ * The network is finally deactivated like nicDeactivateNetwork() does.
+ */
+int mtk_wlan_cmd_teardown(struct mtk_wlan_mac *mac)
+{
+	int ret;
+
+	if (!READ_ONCE(mac->fw_up))
+		return -ENETDOWN;
+
+	ret = mtk_wlan_cmd_set_bss_info(mac, false);
+	if (mac->sta_valid) {
+		if (mtk_wlan_cmd_remove_sta(mac))
+			dev_dbg(mac->dev, "cannot remove STA record %u\n",
+				mac->sta_index);
+	}
+	mtk_wlan_cmd_bss_activate(mac, false);
+
+	mac->sta_valid = false;
+	mac->aid = 0;
+	return ret;
+}
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_cmd.h b/drivers/misc/mediatek/connectivity/wlan/wlan_cmd.h
new file mode 100644
index 000000000..597f59c12
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_cmd.h
@@ -0,0 +1,191 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WLAN gen2 firmware command/event channel - wire definitions.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   include/nic_cmd_event.h   (WIFI_CMD_T, WIFI_EVENT_T, CMD and EVENT structs)
+ *   include/nic/cmd_buf.h     (CMD_INFO_T, CMD_HDR_SIZE)
+ *   nic/nic.c                 (nicUpdateBss, nicActivateNetwork,
+ *                              cnmStaRecChangeState callers)
+ *   mgmt/cnm_mem.c            (cnmStaSendUpdateCmd, cnmStaSendRemoveCmd)
+ *   nic/nic_tx.c              (nicTxCmd command framing, TC4/port 1)
+ *   nic/nic_rx.c              (EVENT_ID_CMD_RESULT matching, nic_rx.c:1789)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#ifndef _MTK_WLAN_CMD_H
+#define _MTK_WLAN_CMD_H
+
+#include <linux/types.h>
+
+struct mtk_wlan_mac;
+struct cfg80211_bss;
+
+/* WIFI_CMD_T, nic_cmd_event.h:919-929; CMD_HDR_SIZE is hif_tx.h:98. */
+#define MTK_WLAN_CMD_HDR_LEN		8
+/* WIFI_EVENT_T, nic_cmd_event.h:932-941; EVENT_HDR_SIZE is nic_cmd_event.h:660. */
+#define MTK_WLAN_EVENT_HDR_LEN		8
+/* Largest PDU this port sends: CMD_SET_BSS_INFO (80 bytes). */
+#define MTK_WLAN_CMD_BUF_MAX		128
+
+/* ENUM_CMD_ID_T, nic_cmd_event.h:678-702. */
+#define MTK_WLAN_CMD_ID_BSS_ACTIVATE_CTRL	0x15
+#define MTK_WLAN_CMD_ID_SET_BSS_INFO		0x16
+#define MTK_WLAN_CMD_ID_UPDATE_STA_RECORD	0x17
+#define MTK_WLAN_CMD_ID_REMOVE_STA_RECORD	0x18
+
+/* ENUM_EVENT_ID_T, nic_cmd_event.h:809-811. */
+#define MTK_WLAN_EVENT_ID_CMD_RESULT		1
+
+/* STA_STATE_1 / STA_STATE_3, mac.h:261-263. */
+#define MTK_WLAN_STA_STATE_1			0
+#define MTK_WLAN_STA_STATE_3			2
+
+/* EVENT_CMD_RESULT.ucStatus, nic_cmd_event.h:1175-1179. */
+#define MTK_WLAN_CMD_STATUS_SUCCESS		0
+#define MTK_WLAN_CMD_STATUS_REJECTED		1
+#define MTK_WLAN_CMD_STATUS_UNKNOWN		2
+
+/*
+ * Response timeout.  The downstream OID layer waits for
+ * kalOidComplete() with a 5 s timeout (the value documented next to the
+ * wait in gl_kal.c:2445-2449).
+ */
+#define MTK_WLAN_CMD_TIMEOUT_MS			5000
+/*
+ * Local policy: how long to wait for a free TC4 buffer before giving up.
+ * Downstream polls TC4 resources in the caller (nicTxPollingResource(),
+ * nic_tx.c:633-697) instead of inside the HIF write.
+ */
+#define MTK_WLAN_CMD_TRIES			100
+#define MTK_WLAN_CMD_POLL_MS			2
+
+/* WIFI_CMD_T, nic_cmd_event.h:919-929.  First DW shared with HIF_TX_HEADER_T. */
+struct mtk_wlan_cmd_hdr {
+	__le16 tx_byte_count_user_priority;
+	u8 ether_type_offset;
+	u8 resource_pkttype_csflags;
+	u8 cid;
+	u8 set_query;
+	u8 seq;
+	u8 reserved;
+} __packed;
+
+/* WIFI_EVENT_T, nic_cmd_event.h:932-941. */
+struct mtk_wlan_event_hdr {
+	__le16 packet_len;
+	__le16 packet_type;
+	u8 eid;
+	u8 seq;
+	u8 reserved[2];
+} __packed;
+
+/* EVENT_CMD_RESULT, nic_cmd_event.h:1175-1179. */
+struct mtk_wlan_event_cmd_result {
+	u8 cmd_id;
+	u8 status;
+	u8 reserved[2];
+} __packed;
+
+/* CMD_BSS_ACTIVATE_CTRL, nic_cmd_event.h:1414-1418. */
+struct mtk_wlan_cmd_bss_activate {
+	u8 net_type_index;
+	u8 active;
+	u8 reserved[2];
+} __packed;
+
+/* CMD_SET_BSS_RLM_PARAM_T, nic_cmd_event.h:1420-1435. */
+struct mtk_wlan_cmd_set_bss_rlm {
+	u8 net_type_index;
+	u8 rf_band;
+	u8 primary_channel;
+	u8 rf_sco;
+	u8 erp_protect_mode;
+	u8 ht_protect_mode;
+	u8 gf_operation_mode;
+	u8 tx_rifs_mode;
+	__le16 ht_op_info3;
+	__le16 ht_op_info2;
+	u8 ht_op_info1;
+	u8 use_short_preamble;
+	u8 use_short_slot_time;
+	u8 check_id;
+} __packed;
+
+/* CMD_SET_BSS_INFO, nic_cmd_event.h:1437-1460. */
+struct mtk_wlan_cmd_set_bss_info {
+	u8 net_type_index;
+	u8 connection_state;
+	u8 current_op_mode;
+	u8 ssid_len;
+	u8 ssid[32];
+	u8 bssid[6];
+	u8 is_qbss;
+	u8 reserved1;
+	__le16 operational_rate_set;
+	__le16 bss_basic_rate_set;
+	u8 sta_rec_idx_of_ap;
+	u8 reserved2;
+	u8 reserved3;
+	u8 nonht_basic_phy_type;
+	u8 auth_mode;
+	u8 enc_status;
+	u8 phy_type_set;
+	u8 own_mac[6];
+	u8 wapi_mode;
+	u8 is_ap_mode;
+	u8 hidden_ssid_mode;
+	struct mtk_wlan_cmd_set_bss_rlm rlm;
+} __packed;
+
+/* CMD_UPDATE_STA_RECORD_T, nic_cmd_event.h:1462-1488. */
+struct mtk_wlan_cmd_update_sta {
+	u8 index;
+	u8 sta_type;
+	u8 mac_addr[6];
+	__le16 assoc_id;
+	__le16 listen_interval;
+	u8 net_type_index;
+	u8 desired_phy_type_set;
+	__le16 desired_nonht_rate_set;
+	__le16 bss_basic_rate_set;
+	u8 is_qos;
+	u8 is_uapsd_supported;
+	u8 sta_state;
+	u8 mcs_set;
+	u8 sup_mcs32;
+	u8 ampdu_param;
+	__le16 ht_cap_info;
+	__le16 ht_extended_cap;
+	__le32 tx_beamforming_cap;
+	u8 asel_cap;
+	u8 rcpi;
+	u8 need_resp;
+	u8 uapsd_ac;
+	u8 uapsd_sp;
+	u8 reserved[3];
+} __packed;
+
+/* CMD_REMOVE_STA_RECORD_T, nic_cmd_event.h:1490-1494. */
+struct mtk_wlan_cmd_remove_sta {
+	u8 index;
+	u8 reserved;
+	u8 mac_addr[6];
+} __packed;
+
+/* wlan_cmd.c */
+void mtk_wlan_cmd_init(struct mtk_wlan_mac *mac);
+void mtk_wlan_cmd_reset(struct mtk_wlan_mac *mac);
+void mtk_wlan_cmd_abort(struct mtk_wlan_mac *mac);
+void mtk_wlan_cmd_cancel(struct mtk_wlan_mac *mac);
+void mtk_wlan_cmd_event(struct mtk_wlan_mac *mac, const u8 *buf, size_t len);
+int mtk_wlan_cmd_prepare_ap(struct mtk_wlan_mac *mac, struct cfg80211_bss *bss);
+int mtk_wlan_cmd_bss_activate(struct mtk_wlan_mac *mac, bool active);
+int mtk_wlan_cmd_set_bss_info(struct mtk_wlan_mac *mac, bool connected);
+int mtk_wlan_cmd_update_sta(struct mtk_wlan_mac *mac, u8 state, u16 aid,
+			    bool need_resp);
+int mtk_wlan_cmd_remove_sta(struct mtk_wlan_mac *mac);
+int mtk_wlan_cmd_teardown(struct mtk_wlan_mac *mac);
+
+#endif /* _MTK_WLAN_CMD_H */
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_fw.c b/drivers/misc/mediatek/connectivity/wlan/wlan_fw.c
new file mode 100644
index 000000000..b5a6cc095
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_fw.c
@@ -0,0 +1,390 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 firmware bring-up.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/gl_kal.c
+ *     (kalFirmwareOpen / kalFirmwareSize / kalFirmwareLoad)
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/common/wlan_lib.c
+ *     (wlanAdapterStart, wlanImageSectionDownload, wlanConfigWifiFunc)
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/nic/nic_pwr_mgt.c
+ *     (nicpmSetDriverOwn, nicpmSetAcpiPowerD0)
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/ahb.c
+ *     (glGetChipInfo)
+ *
+ * Copyright (C) 2011 MediaTek Inc.
+ */
+
+#include <linux/crc32.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "wlan_fw.h"
+#include "wlan_hif.h"
+
+/* Standard reflected CRC-32, wlanCRC32() wlan_lib.c:3288-3297. */
+static u32 mtk_wlan_fw_crc32(const u8 *data, u32 len)
+{
+	return ~crc32_le(~0, data, len);
+}
+
+/*
+ * Chip suffix for the firmware file name, glGetChipInfo() ahb.c:534-548.
+ */
+static void mtk_wlan_fw_name(struct mtk_wlan_hif *hif, char *buf, size_t len)
+{
+	switch (hif->chip_id) {
+	case 0x6571:
+	case 0x8127:
+	case 0x6752:
+	case 0x8163:
+	case 0x6735:
+	case 0x6580:
+	case 0x6755:
+		snprintf(buf, len, WLAN_FW_PATH_PREFIX "%04x", hif->chip_id);
+		break;
+	default:
+		snprintf(buf, len, WLAN_FW_PATH_PREFIX "SOC");
+		break;
+	}
+}
+
+/*
+ * Hand one init command to the HIF.  @cmd is the command payload, @data an
+ * optional trailing payload (firmware chunk).
+ */
+static int mtk_wlan_fw_xmit(struct mtk_wlan_hif *hif, u8 cid,
+			    const void *cmd, u32 cmd_len,
+			    const void *data, u32 data_len, u8 *seq)
+{
+	struct wlan_init_hif_tx_header *hdr;
+	u32 payload_len = cmd_len + data_len;
+	u32 aligned = ALIGN(sizeof(*hdr) + payload_len, 4);
+	u8 *buf;
+	int ret;
+
+	buf = kzalloc(aligned, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	hdr = (struct wlan_init_hif_tx_header *)buf;
+	hdr->tx_byte_count = cpu_to_le16((u16)aligned);
+	hdr->ether_type_offset = 0;
+	hdr->cs_flags = 0;
+
+	hif->cmd_seq++;
+	hdr->cmd.cid = cid;
+	hdr->cmd.seq = hif->cmd_seq;
+	*seq = hif->cmd_seq;
+
+	if (cmd_len)
+		memcpy(hdr->cmd.buffer, cmd, cmd_len);
+	if (data_len)
+		memcpy(hdr->cmd.buffer + cmd_len, data, data_len);
+
+	/* Only TC0, i.e. TX data port 0, is used for init commands
+	 * (wlan_lib.c:2905-2908, nic_tx.c:2132-2148).
+	 */
+	ret = mtk_wlan_hif_port_write(hif, MCR_WTDR0, aligned, buf, aligned);
+	kfree(buf);
+	return ret;
+}
+
+/*
+ * Wait for INIT_EVENT_ID_CMD_RESULT, wlanImageSectionDownloadStatus()
+ * wlan_lib.c:3059-3145, and nicRxWaitResponse() nic_rx.c:3619-3704.
+ */
+static int mtk_wlan_fw_wait_result(struct mtk_wlan_hif *hif, u8 seq)
+{
+	u32 max_len = sizeof(struct wlan_init_hif_rx_header) + 4;
+	struct wlan_init_hif_rx_header *rx;
+	unsigned long deadline;
+	u8 *buf;
+	u32 pkt_len;
+	int ret;
+
+	buf = kzalloc(max_len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	deadline = jiffies + msecs_to_jiffies(WLAN_FW_RESPONSE_TIMEOUT_MS);
+	for (;;) {
+		pkt_len = FIELD_GET(WRPLR_RX0_PACKET_LENGTH,
+				    mtk_wlan_hif_readl(hif, MCR_WRPLR));
+		if (pkt_len)
+			break;
+		if (time_after(jiffies, deadline)) {
+			dev_err(hif->dev, "no download response for seq %u\n",
+				seq);
+			ret = -ETIMEDOUT;
+			goto out;
+		}
+		/* kalUdelay(50), nic_rx.c:3655. */
+		usleep_range(50, 100);
+	}
+
+	if (pkt_len > max_len) {
+		dev_err(hif->dev, "download response of %u bytes is too long\n",
+			pkt_len);
+		ret = -EMSGSIZE;
+		goto out;
+	}
+
+	ret = mtk_wlan_hif_port_read(hif, MCR_WRDR0, pkt_len, buf, max_len);
+	if (ret)
+		goto out;
+
+	rx = (struct wlan_init_hif_rx_header *)buf;
+	if (rx->eid != WLAN_INIT_EVENT_ID_CMD_RESULT) {
+		dev_err(hif->dev, "unexpected event id %u for seq %u\n",
+			rx->eid, seq);
+		ret = -EIO;
+		goto out;
+	}
+	if (rx->seq != seq) {
+		dev_err(hif->dev, "event seq %u does not match command %u\n",
+			rx->seq, seq);
+		ret = -EIO;
+		goto out;
+	}
+
+	ret = rx->buffer[0];
+	if (ret) {
+		dev_err(hif->dev, "download command rejected, status %d\n", ret);
+		ret = -EIO;
+	}
+out:
+	kfree(buf);
+	return ret;
+}
+
+/* Download @len bytes to @dest, wlan_lib.c:2865-2965. */
+static int mtk_wlan_fw_download_chunk(struct mtk_wlan_hif *hif, u32 dest,
+				      const u8 *data, u32 len)
+{
+	struct wlan_init_cmd_download_buf dl;
+	u8 seq;
+	int ret;
+
+	dl.address = cpu_to_le32(dest);
+	dl.length = cpu_to_le32(len);
+	dl.crc32 = cpu_to_le32(mtk_wlan_fw_crc32(data, len));
+	/*
+	 * CFG_ENABLE_FW_DOWNLOAD_ACK and CFG_ENABLE_FW_ENCRYPTION are both 1
+	 * in this build (config.h:1329-1330), see wlan_lib.c:2914-2927.
+	 */
+	dl.data_mode = cpu_to_le32(WLAN_DOWNLOAD_BUF_ACK_OPTION |
+				   WLAN_DOWNLOAD_BUF_ENCRYPTION_MODE);
+
+	ret = mtk_wlan_fw_xmit(hif, WLAN_INIT_CMD_ID_DOWNLOAD_BUF,
+			       &dl, sizeof(dl), data, len, &seq);
+	if (ret)
+		return ret;
+
+	return mtk_wlan_fw_wait_result(hif, seq);
+}
+
+static int mtk_wlan_fw_download_section(struct mtk_wlan_hif *hif, u32 dest,
+					const u8 *data, u32 len)
+{
+	u32 done = 0;
+	int ret;
+
+	while (done < len) {
+		u32 chunk = min_t(u32, len - done, WLAN_FW_CHUNK_SIZE);
+
+		ret = mtk_wlan_fw_download_chunk(hif, dest + done,
+						 data + done, chunk);
+		if (ret)
+			return ret;
+		done += chunk;
+	}
+
+	return 0;
+}
+
+/* Send INIT_CMD_ID_WIFI_START, wlanConfigWifiFunc() wlan_lib.c:3156-3221. */
+static int mtk_wlan_fw_kick(struct mtk_wlan_hif *hif, u32 start_addr)
+{
+	struct wlan_init_cmd_wifi_start cmd;
+	u8 seq;
+
+	/* CFG_OVERRIDE_FW_START_ADDRESS is 1 for MT6628, config.h:1353. */
+	cmd.override = cpu_to_le32(1);
+	cmd.address = cpu_to_le32(start_addr);
+
+	return mtk_wlan_fw_xmit(hif, WLAN_INIT_CMD_ID_WIFI_START,
+				&cmd, sizeof(cmd), NULL, 0, &seq);
+}
+
+/*
+ * Download the image.  A file with a valid MTKW header is downloaded
+ * section by section (CFG_ENABLE_FW_DIVIDED_DOWNLOAD, config.h:1334);
+ * otherwise it is a flat image loaded at CFG_FW_LOAD_ADDRESS.
+ */
+static int mtk_wlan_fw_download(struct mtk_wlan_hif *hif,
+				const struct firmware *fw)
+{
+	const struct wlan_fw_divided_header *head;
+	u32 num, i, start_addr;
+	int ret;
+
+	head = (const struct wlan_fw_divided_header *)fw->data;
+	if (fw->size >= sizeof(*head) &&
+	    le32_to_cpu(head->signature) == WLAN_FW_DIVIDED_SIGNATURE &&
+	    le32_to_cpu(head->crc) ==
+		mtk_wlan_fw_crc32(fw->data + WLAN_FW_CRC_OFFSET,
+				  fw->size - WLAN_FW_CRC_OFFSET)) {
+		num = le32_to_cpu(head->num_of_entries);
+		if (!num ||
+		    sizeof(*head) + num * sizeof(struct wlan_fw_section) >
+			fw->size) {
+			dev_err(hif->dev, "invalid section table (%u entries)\n",
+				num);
+			return -EINVAL;
+		}
+
+		for (i = 0; i < num; i++) {
+			u32 off = le32_to_cpu(head->sections[i].offset);
+			u32 len = le32_to_cpu(head->sections[i].length);
+			u32 dest = le32_to_cpu(head->sections[i].dest_addr);
+
+			if (!len || (u64)off + len > fw->size) {
+				dev_err(hif->dev, "invalid section %u\n", i);
+				return -EINVAL;
+			}
+
+			ret = mtk_wlan_fw_download_section(hif, dest,
+							   fw->data + off, len);
+			if (ret)
+				return ret;
+		}
+
+		/* CFG_START_ADDRESS_IS_1ST_SECTION_ADDR, config.h:1355. */
+		start_addr = le32_to_cpu(head->sections[0].dest_addr);
+		dev_info(hif->dev, "divided image: %u sections, start %#x\n",
+			 num, start_addr);
+	} else {
+		dev_warn(hif->dev, "no MTKW header, flat load at %#x\n",
+			 WLAN_FW_LOAD_ADDRESS);
+		ret = mtk_wlan_fw_download_section(hif, WLAN_FW_LOAD_ADDRESS,
+						   fw->data, fw->size);
+		if (ret)
+			return ret;
+		start_addr = WLAN_FW_START_ADDRESS;
+	}
+
+	return mtk_wlan_fw_kick(hif, start_addr);
+}
+
+/* Wait for WCIR.WLAN_READY, wlan_lib.c:1428-1452. */
+static int mtk_wlan_fw_wait_ready(struct mtk_wlan_hif *hif)
+{
+	unsigned int i;
+	u32 val;
+
+	for (i = 0; i < WLAN_FW_READY_POLL_COUNT; i++) {
+		val = mtk_wlan_hif_readl(hif, MCR_WCIR);
+		if (val & WCIR_WLAN_READY) {
+			dev_info(hif->dev, "firmware ready after %u ms\n",
+				 i * WLAN_FW_READY_POLL_MS);
+			return 0;
+		}
+		msleep(WLAN_FW_READY_POLL_MS);
+	}
+
+	val = mtk_wlan_hif_readl(hif, MCR_D2HRM0R);
+	dev_err(hif->dev, "firmware ready timeout, mailbox id %u\n",
+		val & 0xffff);
+	return -ETIMEDOUT;
+}
+
+/*
+ * Reset the interrupt status left over by the download and restore the
+ * hardware clear mode, nic_pwr_mgt.c:598-602 and wlan_lib.c:1649-1653.
+ */
+static void mtk_wlan_fw_clear_state(struct mtk_wlan_hif *hif)
+{
+	u32 hisr = 0, val;
+
+	mtk_wlan_hif_port_read(hif, MCR_WHISR, sizeof(hisr), (u8 *)&hisr,
+			       sizeof(hisr));
+	if (hisr & WHISR_TX_DONE_INT)
+		dev_dbg(hif->dev, "stale TX status: WTSR0=0x%08x WTSR1=0x%08x\n",
+			mtk_wlan_hif_readl(hif, MCR_WTSR0),
+			mtk_wlan_hif_readl(hif, MCR_WTSR1));
+
+	val = mtk_wlan_hif_readl(hif, MCR_WHCR);
+	val &= ~(WHCR_W_INT_CLR_CTRL | WHCR_W_MAILBOX_RD_CLR_EN);
+	mtk_wlan_hif_writel(hif, MCR_WHCR, val);
+}
+
+/**
+ * mtk_wlan_fw_bringup() - power the WLAN firmware up
+ * @hif: host interface instance
+ *
+ * Called from the WMT WIFI function on callback, i.e. after the connectivity
+ * subsystem has been powered and its MCU reset released by
+ * mtk_wcn_consys_hw_pwr_on() (mtk_wcn_consys_hw.c:498-501).  The caller
+ * holds &hif->state_lock.
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int mtk_wlan_fw_bringup(struct mtk_wlan_hif *hif)
+{
+	const struct firmware *fw = NULL;
+	char name[32];
+	int ret;
+
+	lockdep_assert_held(&hif->state_lock);
+
+	ret = mtk_wlan_hif_start(hif);
+	if (ret)
+		return ret;
+
+	mtk_wlan_hif_hw_init(hif);
+
+	mtk_wlan_fw_name(hif, name, sizeof(name));
+	ret = request_firmware(&fw, name, hif->dev);
+	if (ret) {
+		dev_err(hif->dev, "firmware %s not available: %d\n", name, ret);
+		goto err;
+	}
+	if (!fw->size) {
+		dev_err(hif->dev, "firmware %s is empty\n", name);
+		ret = -EINVAL;
+		goto out_free;
+	}
+
+	ret = mtk_wlan_hif_claim_driver_own(hif);
+	if (ret)
+		goto out_free;
+
+	ret = mtk_wlan_fw_download(hif, fw);
+	if (ret)
+		goto out_free;
+
+	ret = mtk_wlan_fw_wait_ready(hif);
+	if (ret)
+		goto out_free;
+
+	mtk_wlan_fw_clear_state(hif);
+
+	WRITE_ONCE(hif->up, true);
+	mtk_wlan_hif_set_int_enable(hif, true);
+	dev_info(hif->dev, "%s running, chip id 0x%04x\n", name, hif->chip_id);
+
+out_free:
+	release_firmware(fw);
+err:
+	if (ret) {
+		mtk_wlan_hif_set_int_enable(hif, false);
+		dev_err(hif->dev, "firmware bring-up failed: %d\n", ret);
+	}
+	return ret;
+}
+
+MODULE_FIRMWARE(WLAN_FW_BASENAME "_6735");
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_fw.h b/drivers/misc/mediatek/connectivity/wlan/wlan_fw.h
new file mode 100644
index 000000000..d494a8fa1
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_fw.h
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WLAN gen2 firmware download definitions.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/include/nic_init_cmd_event.h
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/include/wlan_lib.h
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/include/config.h
+ *
+ * Copyright (C) 2011 MediaTek Inc.
+ */
+
+#ifndef _MTK_WLAN_FW_H
+#define _MTK_WLAN_FW_H
+
+#include <linux/bits.h>
+#include <linux/types.h>
+
+/*
+ * "/etc/firmware/" CFG_FW_FILENAME "_" <chip> as built by kalFirmwareOpen()
+ * (gl_kal.c:851-856) with the chip suffix from glGetChipInfo()
+ * (ahb.c:534-548).  The ROM carries the same prefix (vmlinux.strings:41764).
+ */
+#define WLAN_FW_PATH_PREFIX		"WIFI_RAM_CODE_"
+
+/* CFG_FW_FILENAME, config.h:923-926. */
+#define WLAN_FW_BASENAME		"WIFI_RAM_CODE"
+
+/* CFG_FW_LOAD_ADDRESS / CFG_FW_START_ADDRESS for MT6628, config.h:1352-1355. */
+#define WLAN_FW_LOAD_ADDRESS		0x00060000
+#define WLAN_FW_START_ADDRESS		0x00060000
+
+/* CMD_PKT_SIZE_FOR_IMAGE, hif_tx.h:100. */
+#define WLAN_FW_CHUNK_SIZE		2048
+
+/* CFG_RESPONSE_POLLING_TIMEOUT, config.h:1204 (x 10 ms). */
+#define WLAN_FW_READY_POLL_COUNT	512
+#define WLAN_FW_READY_POLL_MS		10
+
+/* RX_RESPONSE_TIMEOUT, nic_rx.c:834. */
+#define WLAN_FW_RESPONSE_TIMEOUT_MS	1000
+
+/* BUILD_SIGN('M', 'T', 'K', 'W'), wlan_lib.h:733-737. */
+#define WLAN_FW_DIVIDED_SIGNATURE	0x574b544d
+
+/* Offset of u4NumOfEntries, i.e. the start of the CRC-covered area. */
+#define WLAN_FW_CRC_OFFSET		8
+
+/* INIT_CMD_ID_*, nic_init_cmd_event.h:69-74. */
+#define WLAN_INIT_CMD_ID_DOWNLOAD_BUF	1
+#define WLAN_INIT_CMD_ID_WIFI_START	2
+#define WLAN_INIT_CMD_ID_QUERY_ERROR	4
+
+/* INIT_EVENT_ID_*, nic_init_cmd_event.h:76-81. */
+#define WLAN_INIT_EVENT_ID_CMD_RESULT	1
+#define WLAN_INIT_EVENT_ID_PENDING_ERROR 3
+
+/* DOWNLOAD_BUF_*, nic_init_cmd_event.h:103-105. */
+#define WLAN_DOWNLOAD_BUF_ENCRYPTION_MODE	BIT(0)
+#define WLAN_DOWNLOAD_BUF_NO_CRC_CHECKING	BIT(30)
+#define WLAN_DOWNLOAD_BUF_ACK_OPTION		BIT(31)
+
+/* INIT_CMD_STATUS_*, nic_init_cmd_event.h:61-65. */
+#define WLAN_INIT_CMD_STATUS_SUCCESS		0
+#define WLAN_INIT_CMD_STATUS_INVALID_PARAMS	1
+#define WLAN_INIT_CMD_STATUS_CRC_ERROR		2
+#define WLAN_INIT_CMD_STATUS_DECRYPT_FAIL	3
+#define WLAN_INIT_CMD_STATUS_UNKNOWN		4
+
+/* INIT_WIFI_CMD_T / INIT_HIF_TX_HEADER_T, nic_init_cmd_event.h:89-102. */
+struct wlan_init_wifi_cmd {
+	u8 cid;
+	u8 seq;
+	__le16 reserved;
+	u8 buffer[];
+} __packed;
+
+struct wlan_init_hif_tx_header {
+	__le16 tx_byte_count;
+	u8 ether_type_offset;
+	u8 cs_flags;
+	struct wlan_init_wifi_cmd cmd;
+} __packed;
+
+/* INIT_CMD_DOWNLOAD_BUF, nic_init_cmd_event.h:106-112. */
+struct wlan_init_cmd_download_buf {
+	__le32 address;
+	__le32 length;
+	__le32 crc32;
+	__le32 data_mode;
+	u8 buffer[];
+} __packed;
+
+/* INIT_CMD_WIFI_START, nic_init_cmd_event.h:114-117. */
+struct wlan_init_cmd_wifi_start {
+	__le32 override;
+	__le32 address;
+} __packed;
+
+/* INIT_HIF_RX_HEADER_T, nic_init_cmd_event.h:127-141. */
+struct wlan_init_hif_rx_header {
+	__le16 rx_byte_count;
+	u8 eid;
+	u8 seq;
+	u8 buffer[];
+} __packed;
+
+/* FWDL_SECTION_INFO_T / FIRMWARE_DIVIDED_DOWNLOAD_T, wlan_lib.h:598-611. */
+struct wlan_fw_section {
+	__le32 offset;
+	__le32 reserved;
+	__le32 length;
+	__le32 dest_addr;
+} __packed;
+
+struct wlan_fw_divided_header {
+	__le32 signature;
+	__le32 crc;
+	__le32 num_of_entries;
+	__le32 reserved;
+	struct wlan_fw_section sections[];
+} __packed;
+
+#endif /* _MTK_WLAN_FW_H */
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_hif.h b/drivers/misc/mediatek/connectivity/wlan/wlan_hif.h
new file mode 100644
index 000000000..c4936b41f
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_hif.h
@@ -0,0 +1,271 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WLAN gen2 AHB host interface - private definitions.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/include/hif.h
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/os/linux/hif/ahb/include/hif_pdma.h
+ *   drivers/misc/mediatek/connectivity/wlan/gen2/include/nic/mtreg.h
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#ifndef _MTK_WLAN_HIF_H
+#define _MTK_WLAN_HIF_H
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/mutex.h>
+#include <linux/rfkill.h>
+#include <linux/types.h>
+#include <linux/workqueue.h>
+
+/*
+ * HIF host registers.  Offsets and field layouts are copied verbatim from
+ * mtreg.h:81-143 ("1 MT6628 MCR Definition" / "2 Host Interface").
+ * The HIF block lives at the first "reg" of the DT node and is 0x5c bytes
+ * long (hif.h:217-218).
+ */
+#define MCR_WCIR			0x0000	/* chip id / revision */
+#define MCR_WHLPCR			0x0004	/* HIF low power control */
+#define MCR_WHCR			0x000c	/* HIF control */
+#define MCR_WHISR			0x0010	/* HIF interrupt status */
+#define MCR_WHIER			0x0014	/* HIF interrupt enable */
+#define MCR_WASR			0x0018	/* abnormal status */
+#define MCR_WTSR0			0x0020	/* WLAN TX status 0 */
+#define MCR_WTSR1			0x0024	/* WLAN TX status 1 */
+#define MCR_WTDR0			0x0028	/* WLAN TX data 0 */
+#define MCR_WTDR1			0x002c	/* WLAN TX data 1 */
+#define MCR_WRDR0			0x0030	/* WLAN RX data 0 */
+#define MCR_WRDR1			0x0034	/* WLAN RX data 1 */
+#define MCR_D2HRM0R			0x0040	/* device to host mailbox 0 */
+#define MCR_D2HRM2R			0x0048	/* device to host mailbox 2 */
+#define MCR_WRPLR			0x0050	/* RX packet length */
+#define MCR_HSTCR			0x0058	/* HSIF transaction count */
+
+/* WCIR (mtreg.h:175-178). */
+#define WCIR_CHIP_ID			GENMASK(15, 0)
+#define WCIR_REVISION_ID		GENMASK(19, 16)
+#define WCIR_WLAN_READY			BIT(21)
+
+/* WHLPCR (mtreg.h:187-190). */
+#define WHLPCR_INT_EN_SET		BIT(0)
+#define WHLPCR_INT_EN_CLR		BIT(1)
+#define WHLPCR_FW_OWN_REQ_SET		BIT(8)
+#define WHLPCR_FW_OWN_REQ_CLR		BIT(9)
+
+/* WHCR (mtreg.h:204-205). */
+#define WHCR_W_INT_CLR_CTRL		BIT(1)
+#define WHCR_W_MAILBOX_RD_CLR_EN	BIT(2)
+
+/* WHISR / WHIER (mtreg.h:213-225). */
+#define WHISR_TX_DONE_INT		BIT(0)
+#define WHISR_RX0_DONE_INT		BIT(1)
+#define WHISR_RX1_DONE_INT		BIT(2)
+#define WHISR_ABNORMAL_INT		BIT(3)
+
+#define WHIER_TX_DONE_INT_EN		BIT(0)
+#define WHIER_RX0_DONE_INT_EN		BIT(1)
+#define WHIER_RX1_DONE_INT_EN		BIT(2)
+#define WHIER_ABNORMAL_INT_EN		BIT(3)
+
+/* Driver-own acquisition, nicpmSetDriverOwn() nic_pwr_mgt.c:313-315. */
+#define WLAN_FW_OWN_TOTAL_MS		2000
+#define WLAN_FW_OWN_LOOP_MS		1
+#define WLAN_FW_OWN_CLR_ITERATION	256
+
+/* Value programmed by nicInitializeAdapter() (hal.h:231-238, nic.c:1251). */
+#define WHIER_DEFAULT			(WHIER_RX0_DONE_INT_EN | \
+					 WHIER_RX1_DONE_INT_EN | \
+					 WHIER_TX_DONE_INT_EN | \
+					 WHIER_ABNORMAL_INT_EN | \
+					 GENMASK(31, 8))
+
+/* WRPLR (mtreg.h:243-244). */
+#define WRPLR_RX0_PACKET_LENGTH		GENMASK(15, 0)
+#define WRPLR_RX1_PACKET_LENGTH		GENMASK(31, 16)
+
+/* HSTCR (mtreg.h:246-260). */
+#define HSTCR_HSIF_TRANS_CNT		GENMASK(19, 2)
+#define HSTCR_TRANS_TARGET		GENMASK(22, 20)
+#define HSTCR_TRANS_TARGET_OFFSET	20
+#define HSTCR_AFF_BURST_LEN		GENMASK(25, 24)
+#define HSTCR_AFF_BURST_LEN_OFFSET	24
+
+/* Burst length / transfer target (hif.h:220-232). */
+enum mtk_wlan_hif_burst {
+	HIF_BURST_1DW = 0,
+	HIF_BURST_4DW,
+	HIF_BURST_8DW,
+};
+
+enum mtk_wlan_hif_target {
+	HIF_TARGET_TXD0 = 0,
+	HIF_TARGET_TXD1,
+	HIF_TARGET_RXD0,
+	HIF_TARGET_RXD1,
+	HIF_TARGET_WHISR,
+};
+
+/*
+ * AP-DMA (PDMA) channel 1 register window, hif_pdma.h:61-106.  The window
+ * itself is the second "reg" of the DT node; the driver never ioremaps a
+ * hard-coded address.
+ */
+#define AP_DMA_HIF_INT_FLAG		0x0000
+#define AP_DMA_HIF_INT_EN		0x0004
+#define AP_DMA_HIF_EN			0x0008
+#define AP_DMA_HIF_RST			0x000c
+#define AP_DMA_HIF_CON			0x0018
+#define AP_DMA_HIF_SRC_ADDR		0x001c
+#define AP_DMA_HIF_DST_ADDR		0x0020
+#define AP_DMA_HIF_LEN			0x0024
+#define AP_DMA_HIF_LENGTH		0x0054
+
+#define ADH_CR_FLAG_0			BIT(0)
+#define ADH_CR_INTEN_FLAG_0		BIT(0)
+#define ADH_CR_EN			BIT(0)
+#define ADH_CR_WARM_RST			BIT(0)
+#define ADH_CR_HARD_RST			BIT(1)
+#define ADH_CR_DIR			BIT(0)
+#define ADH_CR_FIX_EN			BIT(1)
+#define ADH_CR_BURST_LEN		GENMASK(17, 16)
+#define ADH_CR_BURST_LEN_OFFSET		16
+#define ADH_CR_LEN			GENMASK(19, 0)
+
+/* hif_pdma.h:45-50. */
+enum mtk_wlan_pdma_burst {
+	HIF_PDMA_BURST_1_4 = 0,
+	HIF_PDMA_BURST_2_4,
+	HIF_PDMA_BURST_3_4,
+	HIF_PDMA_BURST_4_4,
+};
+
+/* hif_rx.h:115-116: HIF_RX_HW_APPENDED_LEN. */
+#define MTK_WLAN_HIF_HW_APPENDED_LEN	4
+
+/*
+ * Largest frame the firmware can hand up: CFG_RX_MAX_PKT_SIZE,
+ * config.h:1179 (28 + 2312 + 12).
+ */
+#define MTK_WLAN_RX_MAX_PKT_SIZE	2352
+
+/*
+ * The HIF data port carries ALIGN_4(u2PacketLen) bytes plus one hardware
+ * appended DW holding the checksum status (nic_rx.c:2887-2890).  Both
+ * together may exceed MTK_WLAN_RX_MAX_PKT_SIZE by up to four bytes, so the
+ * bounce buffer keeps that much slack.
+ */
+#define MTK_WLAN_HIF_RX_BUF_SIZE	(MTK_WLAN_RX_MAX_PKT_SIZE + 4)
+
+struct mtk_wlan_mac;
+
+/**
+ * struct mtk_wlan_hif - WLAN AHB host interface instance
+ * @dev: platform device
+ * @hif_base: HIF register window (DT reg 0)
+ * @dma_base: AP-DMA channel window (DT reg 1), %NULL for PIO-only
+ * @hif_phys: physical address of @hif_base, used for the PDMA source/dest
+ * @irq: BGF_EINT line (DT interrupt 0)
+ * @clk: "wifi-dma" AP-DMA gate
+ * @chip_id: WLAN chip id read from WCIR, after the Denali remap
+ * @dma_enabled: PDMA is available and selected
+ * @int_enabled: HIF interrupt enable is currently asserted
+ * @irq_requested: @irq is installed
+ * @up: firmware is downloaded and running
+ * @resetting: a whole-chip reset is in progress
+ * @suspended: system suspend masked the HIF interrupt
+ * @tx_count: frames handed to the HIF TX data port (WMT bus counter)
+ * @rx_dropped: RX frames drained without a valid length or read error
+ * @cmd_seq: command sequence number used by the firmware download
+ * @io_lock: serializes port/DMA transactions
+ * @state_lock: serializes bring-up and teardown
+ * @mac: 802.11 MAC/cfg80211 instance, owned by wlan_mac.c
+ * @rx_buf: bounce buffer for the RX drain in &irq_work
+ * @irq_work: HIF interrupt bottom half
+ * @fatal_work: deferred chip assert after a fatal HIF error
+ * @reset_work: deferred re-open after a whole-chip reset
+ * @reset_failed: last whole-chip reset failed
+ * @was_up: WLAN was running when the reset started
+ * @rfkill: WLAN rfkill switch
+ * @wmt_registered: WMT WLAN callbacks are installed
+ */
+struct mtk_wlan_hif {
+	struct device *dev;
+	void __iomem *hif_base;
+	void __iomem *dma_base;
+	phys_addr_t hif_phys;
+	int irq;
+	struct clk *clk;
+	u32 chip_id;
+	bool dma_enabled;
+	bool int_enabled;
+	bool irq_requested;
+	bool up;
+	bool resetting;
+	bool suspended;
+	atomic_t tx_count;
+	atomic_t rx_dropped;
+	u8 cmd_seq;
+	struct mutex io_lock;		/* serializes port/DMA transactions */
+	struct mutex state_lock;	/* serializes bring-up and teardown */
+	struct mtk_wlan_mac *mac;	/* 802.11 MAC/cfg80211 instance */
+	u8 *rx_buf;
+	struct work_struct irq_work;
+	struct delayed_work fatal_work;
+	struct work_struct reset_work;
+	bool reset_failed;
+	bool was_up;
+	struct rfkill *rfkill;
+	bool wmt_registered;
+	bool msgcb_registered;
+};
+
+static inline u32 mtk_wlan_hif_readl(struct mtk_wlan_hif *hif, u32 off)
+{
+	return readl(hif->hif_base + off);
+}
+
+static inline void mtk_wlan_hif_writel(struct mtk_wlan_hif *hif, u32 off,
+				       u32 val)
+{
+	writel(val, hif->hif_base + off);
+}
+
+/* wlan_ahb.c */
+int mtk_wlan_ahb_driver_register(void);
+void mtk_wlan_ahb_driver_unregister(void);
+
+void mtk_wlan_hif_hw_init(struct mtk_wlan_hif *hif);
+int mtk_wlan_hif_claim_driver_own(struct mtk_wlan_hif *hif);
+int mtk_wlan_hif_port_read(struct mtk_wlan_hif *hif, u16 port, u32 size,
+			   u8 *buf, u32 max);
+int mtk_wlan_hif_port_write(struct mtk_wlan_hif *hif, u16 port, u32 size,
+			    const u8 *buf, u32 max);
+void mtk_wlan_hif_set_int_enable(struct mtk_wlan_hif *hif, bool enable);
+int mtk_wlan_hif_request_irq(struct mtk_wlan_hif *hif);
+void mtk_wlan_hif_free_irq(struct mtk_wlan_hif *hif);
+int mtk_wlan_hif_start(struct mtk_wlan_hif *hif);
+void mtk_wlan_hif_stop(struct mtk_wlan_hif *hif);
+
+/* wlan_fw.c */
+int mtk_wlan_fw_bringup(struct mtk_wlan_hif *hif);
+
+/*
+ * wlan_mac.c hooks used by the HIF.  @buf holds one complete RX buffer as it
+ * left the data port: HIF_RX_HEADER_T, payload and the hardware appended
+ * length/checksum DW, @len bytes in total.
+ */
+void mtk_wlan_mac_rx(struct mtk_wlan_hif *hif, const u8 *buf, u32 len);
+void mtk_wlan_mac_tx_done(struct mtk_wlan_hif *hif, u32 wtsr0, u32 wtsr1);
+
+/* wlan_main.c */
+int mtk_wlan_main_attach(struct mtk_wlan_hif *hif);
+void mtk_wlan_main_detach(struct mtk_wlan_hif *hif);
+int mtk_wcn_wlan_gen2_init(void);
+void mtk_wcn_wlan_gen2_exit(void);
+
+#endif /* _MTK_WLAN_HIF_H */
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_mac.c b/drivers/misc/mediatek/connectivity/wlan/wlan_mac.c
new file mode 100644
index 000000000..174e5d077
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_mac.c
@@ -0,0 +1,457 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WLAN gen2 802.11 MAC and cfg80211 instance.
+ *
+ * This file creates the wiphy and the Ethernet netdev, keeps them in sync
+ * with the firmware state, owns the received-frame dispatch and implements
+ * the cfg80211 operations that are backed by real hardware state: software
+ * scan, open-system connect/disconnect and get_station.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   os/linux/gl_init.c      (wlanNetRegister/wlanNetUnregister, wiphy setup)
+ *   os/linux/gl_cfg80211.c  (mtk_wlan_ops, scan/connect result reporting)
+ *   nic/nic_rx.c            (nicRxProcessRFBs: RX packet type dispatch,
+ *                            nic_rx.c:2734-2823)
+ *   os/linux/gl_kal.c       (kalIndicateStatusAndComplete)
+ *   os/linux/gl_rst.c       (reset start/end notifications)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/ieee80211.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/of_net.h>
+#include <linux/slab.h>
+#include <net/cfg80211.h>
+
+#include "wlan_cmd.h"
+#include "wlan_mac.h"
+
+/* Largest IE blob accepted for a scan request (fits a probe request). */
+#define MTK_WLAN_SCAN_IE_MAX	256
+
+/* 2.4 GHz channels 1..14, IEEE 802.11-2016 17.4.2.4. */
+static struct ieee80211_channel mtk_wlan_channels_2ghz[] = {
+	{ .center_freq = 2412, .hw_value = 1, .max_power = 20, },
+	{ .center_freq = 2417, .hw_value = 2, .max_power = 20, },
+	{ .center_freq = 2422, .hw_value = 3, .max_power = 20, },
+	{ .center_freq = 2427, .hw_value = 4, .max_power = 20, },
+	{ .center_freq = 2432, .hw_value = 5, .max_power = 20, },
+	{ .center_freq = 2437, .hw_value = 6, .max_power = 20, },
+	{ .center_freq = 2442, .hw_value = 7, .max_power = 20, },
+	{ .center_freq = 2447, .hw_value = 8, .max_power = 20, },
+	{ .center_freq = 2452, .hw_value = 9, .max_power = 20, },
+	{ .center_freq = 2457, .hw_value = 10, .max_power = 20, },
+	{ .center_freq = 2462, .hw_value = 11, .max_power = 20, },
+	{ .center_freq = 2467, .hw_value = 12, .max_power = 20, },
+	{ .center_freq = 2472, .hw_value = 13, .max_power = 20, },
+	/* Channel 14 is Japan only, DSSS/CCK, passive scan only. */
+	{ .center_freq = 2484, .hw_value = 14, .max_power = 20,
+	  .flags = IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_NO_OFDM, },
+};
+
+/*
+ * Supported 2.4 GHz rates, in cfg80211 units of 100 kb/s.  hw_value is the
+ * 500 kb/s rate code the firmware and the 802.11 Supported Rates element use
+ * (mac.h:234-247); bitrate and rate code therefore agree by construction.
+ * There is no HT capability here: this port associates without HT IEs.
+ */
+static struct ieee80211_rate mtk_wlan_rates_2ghz[] = {
+	{ .bitrate = 10,  .hw_value = MTK_WLAN_RATE_1M, },
+	{ .bitrate = 20,  .hw_value = MTK_WLAN_RATE_2M, },
+	{ .bitrate = 55,  .hw_value = MTK_WLAN_RATE_5_5M, },
+	{ .bitrate = 110, .hw_value = MTK_WLAN_RATE_11M, },
+	{ .bitrate = 60,  .hw_value = MTK_WLAN_RATE_6M, },
+	{ .bitrate = 90,  .hw_value = MTK_WLAN_RATE_9M, },
+	{ .bitrate = 120, .hw_value = MTK_WLAN_RATE_12M, },
+	{ .bitrate = 180, .hw_value = MTK_WLAN_RATE_18M, },
+	{ .bitrate = 240, .hw_value = MTK_WLAN_RATE_24M, },
+	{ .bitrate = 360, .hw_value = MTK_WLAN_RATE_36M, },
+	{ .bitrate = 480, .hw_value = MTK_WLAN_RATE_48M, },
+	{ .bitrate = 540, .hw_value = MTK_WLAN_RATE_54M, },
+};
+
+static struct ieee80211_supported_band mtk_wlan_band_2ghz = {
+	.band		= NL80211_BAND_2GHZ,
+	.channels	= mtk_wlan_channels_2ghz,
+	.n_channels	= ARRAY_SIZE(mtk_wlan_channels_2ghz),
+	.bitrates	= mtk_wlan_rates_2ghz,
+	.n_bitrates	= ARRAY_SIZE(mtk_wlan_rates_2ghz),
+};
+
+/*
+ * cfg80211 operations.  Only what the hardware can actually do is listed:
+ * no key offload (so the wiphy advertises no cipher suite), no AP/IBSS/P2P,
+ * no remain-on-channel, no scheduled scan, no hardware scan.
+ */
+static int mtk_wlan_cfg80211_scan(struct wiphy *wiphy,
+				  struct cfg80211_scan_request *request)
+{
+	return mtk_wlan_mgmt_scan(wiphy_priv(wiphy), request);
+}
+
+static void mtk_wlan_cfg80211_abort_scan(struct wiphy *wiphy,
+					 struct wireless_dev *wdev)
+{
+	mtk_wlan_mgmt_abort_scan(wiphy_priv(wiphy));
+}
+
+static int mtk_wlan_cfg80211_connect(struct wiphy *wiphy,
+				     struct net_device *dev,
+				     struct cfg80211_connect_params *sme)
+{
+	return mtk_wlan_mgmt_connect(wiphy_priv(wiphy), sme);
+}
+
+static int mtk_wlan_cfg80211_disconnect(struct wiphy *wiphy,
+					struct net_device *dev, u16 reason_code)
+{
+	return mtk_wlan_mgmt_disconnect(wiphy_priv(wiphy), reason_code);
+}
+
+static int mtk_wlan_cfg80211_get_station(struct wiphy *wiphy,
+					 struct net_device *dev, const u8 *mac,
+					 struct station_info *sinfo)
+{
+	struct mtk_wlan_mac *m = wiphy_priv(wiphy);
+	bool have_signal;
+	u8 rcpi;
+
+	if (!READ_ONCE(m->connected) || !ether_addr_equal(mac, m->bssid))
+		return -ENOENT;
+
+	/*
+	 * Only the fields the HIF actually reports are filled.  The RX header
+	 * carries RCPI for every received frame (hif_rx.h:96-113,
+	 * RCPI_TO_dBm() mac.h:2533-2534); it carries no rate, so no rate
+	 * information is invented here.  Packet and byte counters are MAC
+	 * level frames, not the per-station counters downstream derives from
+	 * wlanoidQueryStaStatistics(), so they are not reported either.
+	 */
+	spin_lock_bh(&m->rx_lock);
+	have_signal = m->have_signal;
+	rcpi = m->last_signal;
+	spin_unlock_bh(&m->rx_lock);
+
+	if (have_signal) {
+		sinfo->signal = (s8)mtk_wlan_rcpi_to_dbm(rcpi);
+		sinfo->filled |= BIT_ULL(NL80211_STA_INFO_SIGNAL);
+	}
+
+	sinfo->connected_time = jiffies_to_msecs(jiffies - m->assoc_ts) / 1000;
+	sinfo->filled |= BIT_ULL(NL80211_STA_INFO_CONNECTED_TIME);
+
+	return 0;
+}
+
+static const struct cfg80211_ops mtk_wlan_cfg80211_ops = {
+	.scan		= mtk_wlan_cfg80211_scan,
+	.abort_scan	= mtk_wlan_cfg80211_abort_scan,
+	.connect	= mtk_wlan_cfg80211_connect,
+	.disconnect	= mtk_wlan_cfg80211_disconnect,
+	.get_station	= mtk_wlan_cfg80211_get_station,
+};
+
+/*
+ * Expected channels from the HIF RX header, HIF_RX_HDR_GET_CHNL_NUM()
+ * hif_rx.h:152-155.
+ */
+static u8 mtk_wlan_hw_channel(u8 hw_channel)
+{
+	if (hw_channel > HIF_RX_HW_CHNL_NUM_MAX_4G_5G)
+		return hw_channel - HIF_RX_HW_CHNL_NUM_MAX_4G_5G;
+	return hw_channel;
+}
+
+/**
+ * mtk_wlan_mac_rx - dispatch one frame drained from a HIF data port
+ * @hif: host interface
+ * @buf: complete buffer as it left the data port
+ * @len: buffer length including the hardware appended DW
+ *
+ * Data and management frames use the layout nicRxFillRFB()/nicRxProcessRFBs()
+ * work on (nic_rx.c:1044-1085 and 2734-2823): HIF_RX_HEADER_T, then the
+ * payload at HIF_RX_HDR_SIZE + header offset, with the packet length covering
+ * both.  Events are different: the first DW of WIFI_EVENT_T is shared with
+ * HIF_RX_HEADER_T (nic_cmd_event.h:613), so the event header starts at offset
+ * 0 and its body at EVENT_HDR_SIZE = 8 (nic_rx.c:1750-1775).
+ */
+void mtk_wlan_mac_rx(struct mtk_wlan_hif *hif, const u8 *buf, u32 len)
+{
+	const struct mtk_wlan_hif_rx_header *rx =
+		(const struct mtk_wlan_hif_rx_header *)buf;
+	struct mtk_wlan_mac *mac = hif->mac;
+	u32 pkt_len, payload_off, payload_len;
+	u16 type_field;
+	unsigned int pkt_type;
+	bool is_80211;
+	u8 channel, rcpi;
+
+	if (!mac)
+		return;
+
+	if (len < MTK_WLAN_HIF_RX_HDR_LEN + MTK_WLAN_HIF_HW_APPENDED_LEN) {
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+
+	pkt_len = le16_to_cpu(rx->packet_len);
+	if (pkt_len < MTK_WLAN_EVENT_HDR_LEN ||
+	    ALIGN(pkt_len, 4) + MTK_WLAN_HIF_HW_APPENDED_LEN > len) {
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+
+	type_field = le16_to_cpu(rx->packet_type);
+	pkt_type = FIELD_GET(HIF_RX_HDR_PACKET_TYPE_MASK, type_field);
+
+	if (pkt_type == HIF_RX_PKT_TYPE_EVENT) {
+		/*
+		 * Firmware command results and unsolicited events.  The
+		 * command channel consumes EVENT_ID_CMD_RESULT and ignores
+		 * the rest, like nicRxProcessEventPacket() (nic_rx.c:1750).
+		 */
+		mtk_wlan_cmd_event(mac, buf, len);
+		return;
+	}
+
+	if (pkt_len < MTK_WLAN_HIF_RX_HDR_LEN) {
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+
+	payload_off = MTK_WLAN_HIF_RX_HDR_LEN +
+		      (rx->hdr_len_offset & HIF_RX_HDR_HEADER_OFFSET_MASK);
+	if (payload_off > pkt_len) {
+		atomic_inc(&mac->rx_dropped);
+		return;
+	}
+	payload_len = pkt_len - payload_off;
+
+	is_80211 = rx->reorder_pal_tcl & HIF_RX_HDR_80211_HEADER_FORMAT;
+	channel = mtk_wlan_hw_channel(rx->hw_channel);
+	rcpi = rx->rcpi;
+
+	switch (pkt_type) {
+	case HIF_RX_PKT_TYPE_DATA:
+		mtk_wlan_rx_data(mac, buf + payload_off, payload_len,
+				 is_80211);
+		break;
+	case HIF_RX_PKT_TYPE_MANAGEMENT:
+		mtk_wlan_rx_mgmt(mac, buf + payload_off, payload_len, channel,
+				 rcpi);
+		break;
+	default:
+		atomic_inc(&mac->rx_dropped);
+		break;
+	}
+}
+
+/* Register or unregister the netdev after a firmware transition. */
+static void mtk_wlan_link_work(struct work_struct *work)
+{
+	struct mtk_wlan_mac *mac = container_of(work, struct mtk_wlan_mac,
+						link_work);
+
+	if (READ_ONCE(mac->fw_up)) {
+		if (!mac->registered)
+			mtk_wlan_netdev_register(mac);
+		return;
+	}
+
+	if (!mac->registered)
+		return;
+
+	/*
+	 * Let the scan and connect workers finish: both report their own
+	 * abort/failure through cfg80211, so the wiphy state stays consistent
+	 * until the netdev goes away.
+	 */
+	mtk_wlan_mgmt_quiesce(mac);
+	cancel_work_sync(&mac->tx_work);
+	mtk_wlan_netdev_unregister(mac);
+}
+
+/**
+ * mtk_wlan_mac_fw_up - the firmware finished downloading
+ * @hif: host interface
+ *
+ * Called after mtk_wlan_fw_bringup() reported success.  The netdev is
+ * published from a work item because the caller may hold WMT internal locks
+ * that must not be taken underneath the RTNL.
+ */
+void mtk_wlan_mac_fw_up(struct mtk_wlan_hif *hif)
+{
+	struct mtk_wlan_mac *mac = hif->mac;
+
+	if (!mac)
+		return;
+
+	WRITE_ONCE(mac->fw_up, true);
+	WRITE_ONCE(mac->state, MTK_WLAN_STATE_IDLE);
+	WRITE_ONCE(mac->connected, false);
+	mac->sta_valid = false;
+	mac->aid = 0;
+	mtk_wlan_cmd_reset(mac);
+	schedule_work(&mac->link_work);
+}
+
+/**
+ * mtk_wlan_mac_fw_down - the firmware stopped or the chip is resetting
+ * @hif: host interface
+ *
+ * Aborts a pending scan or connect, reports a lost association and drops the
+ * netdev so userspace never sees an interface that claims to be up while the
+ * firmware is gone.
+ */
+void mtk_wlan_mac_fw_down(struct mtk_wlan_hif *hif)
+{
+	struct mtk_wlan_mac *mac = hif->mac;
+
+	if (!mac)
+		return;
+
+	WRITE_ONCE(mac->fw_up, false);
+	mtk_wlan_mgmt_quiesce(mac);
+	schedule_work(&mac->link_work);
+}
+
+/**
+ * mtk_wlan_mac_attach - create the wiphy, netdev and MAC state
+ * @hif: host interface
+ *
+ * Return: 0 on success, negative errno on failure.
+ */
+int mtk_wlan_mac_attach(struct mtk_wlan_hif *hif)
+{
+	struct mtk_wlan_mac *mac;
+	struct wiphy *wiphy;
+	u8 addr[ETH_ALEN];
+	u8 credits[MTK_WLAN_TC_NUM] = MTK_WLAN_TC_CREDITS_INIT;
+	int ret;
+
+	wiphy = wiphy_new(&mtk_wlan_cfg80211_ops, sizeof(*mac));
+	if (!wiphy) {
+		dev_err(hif->dev, "cannot allocate wiphy\n");
+		return -ENOMEM;
+	}
+	mac = wiphy_priv(wiphy);
+	mac->hif = hif;
+	mac->wiphy = wiphy;
+	mac->dev = hif->dev;
+
+	mutex_init(&mac->lock);
+	mutex_init(&mac->tx_lock);
+	spin_lock_init(&mac->txq_lock);
+	spin_lock_init(&mac->rx_lock);
+	skb_queue_head_init(&mac->txq);
+	init_completion(&mac->mgmt_done);
+	mtk_wlan_cmd_init(mac);
+	memcpy(mac->tc_max, credits, sizeof(credits));
+	memcpy(mac->tc_credits, credits, sizeof(credits));
+
+	/*
+	 * The single AIS peer uses STA record index 0: cnmStaRecAlloc()
+	 * (cnm_mem.c:808-830) returns the first free slot and the transmit
+	 * path rejects only STA_REC_INDEX_BMCAST/NOT_FOUND (que_mgt.h:766).
+	 */
+	mac->sta_index = 0;
+
+	mac->tx_buf = devm_kmalloc(hif->dev, MTK_WLAN_TX_BUF_SIZE, GFP_KERNEL);
+	if (!mac->tx_buf) {
+		ret = -ENOMEM;
+		goto err_wiphy;
+	}
+
+	INIT_WORK(&mac->link_work, mtk_wlan_link_work);
+	INIT_WORK(&mac->tx_work, mtk_wlan_tx_work);
+	INIT_WORK(&mac->scan_work, mtk_wlan_mgmt_scan_work);
+	INIT_WORK(&mac->connect_work, mtk_wlan_mgmt_connect_work);
+
+	/*
+	 * The permanent address lives in the "WIFI" NVRAM section the
+	 * downstream driver reads in glLoadNvram() (gl_init.c:1119-1150,
+	 * WIFI_CFG_PARAM_STRUCT.aucMacAddress) and then programs through
+	 * wlanoidSetCurrentAddr.  Neither the NVRAM file nor the firmware
+	 * command queue exists in this port, so the address comes from the
+	 * device tree ("local-mac-address") when present; otherwise the
+	 * netdev gets a random locally administered address in
+	 * mtk_wlan_netdev_create().
+	 */
+	if (of_get_mac_address(hif->dev->of_node, addr))
+		eth_zero_addr(mac->mac_addr);
+	else
+		ether_addr_copy(mac->mac_addr, addr);
+
+	set_wiphy_dev(wiphy, hif->dev);
+	/*
+	 * One station interface on 2.4 GHz only.  No 5 GHz band pointer, no
+	 * AP/IBSS/P2P mode, no remain-on-channel and no scheduled scan: the
+	 * firmware command interface needed for all of those is not part of
+	 * this port.  Hardware scan does not exist either - only the .scan
+	 * callback below is implemented (gl_init.c:1583-1612 sets the same
+	 * station interface, but also ADHOC and the 5 GHz band, both of which
+	 * this port does not support).
+	 */
+	wiphy->interface_modes = BIT(NL80211_IFTYPE_STATION);
+	wiphy->bands[NL80211_BAND_2GHZ] = &mtk_wlan_band_2ghz;
+	wiphy->signal_type = CFG80211_SIGNAL_TYPE_MBM;
+	wiphy->max_scan_ssids = MTK_WLAN_MAX_SCAN_SSIDS;
+	wiphy->max_scan_ie_len = MTK_WLAN_SCAN_IE_MAX;
+	/*
+	 * No cipher suites at all: there is no key offload, so cfg80211 has
+	 * nothing to install and only open networks can be joined.
+	 */
+	wiphy->cipher_suites = NULL;
+	wiphy->n_cipher_suites = 0;
+
+	ret = wiphy_register(wiphy);
+	if (ret) {
+		dev_err(hif->dev, "cannot register wiphy: %d\n", ret);
+		goto err_wiphy;
+	}
+
+	ret = mtk_wlan_netdev_create(mac);
+	if (ret)
+		goto err_wiphy_unregister;
+
+	hif->mac = mac;
+
+	return 0;
+
+err_wiphy_unregister:
+	wiphy_unregister(wiphy);
+err_wiphy:
+	wiphy_free(wiphy);
+	return ret;
+}
+
+/**
+ * mtk_wlan_mac_detach - tear the MAC layer down
+ * @hif: host interface
+ */
+void mtk_wlan_mac_detach(struct mtk_wlan_hif *hif)
+{
+	struct mtk_wlan_mac *mac = hif->mac;
+
+	if (!mac)
+		return;
+
+	WRITE_ONCE(mac->fw_up, false);
+
+	/* Let pending scan/connect work report their abort to cfg80211. */
+	mtk_wlan_mgmt_quiesce(mac);
+	cancel_work_sync(&mac->link_work);
+	cancel_work_sync(&mac->tx_work);
+
+	mtk_wlan_netdev_unregister(mac);
+	mtk_wlan_netdev_destroy(mac);
+	skb_queue_purge(&mac->txq);
+
+	wiphy_unregister(mac->wiphy);
+	wiphy_free(mac->wiphy);	/* frees @mac, which is wiphy_priv() */
+	hif->mac = NULL;
+}
diff --git a/drivers/misc/mediatek/connectivity/wlan/wlan_mac.h b/drivers/misc/mediatek/connectivity/wlan/wlan_mac.h
new file mode 100644
index 000000000..3c22f86f7
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wlan/wlan_mac.h
@@ -0,0 +1,491 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WLAN gen2 802.11 MAC layer - private definitions.
+ *
+ * The host side of the MT6628/MT6735 WLAN function is split in two:
+ *
+ *  - the HIF (wlan_ahb.c) moves HIF_TX_HEADER_T prefixed buffers to the
+ *    firmware and hands every received buffer up unchanged;
+ *  - this layer owns the cfg80211 wiphy, the Ethernet netdev, the TX
+ *    queue with its TC credit accounting, the 802.3 <-> 802.11 data
+ *    conversion and the STA management state machine (scan/auth/assoc).
+ *
+ * Firmware data frames are exchanged in 802.3 format, management frames in
+ * 802.11 format; see the comments at the individual frame builders.
+ *
+ * Ported from Samsung/MTK downstream:
+ *   include/nic/hif_tx.h, include/nic/hif_rx.h   (HIF headers)
+ *   include/nic/nic_tx.h, nic/nic_tx.c           (TC accounting, TX header)
+ *   os/linux/gl_init.c, os/linux/gl_kal.c        (wiphy/netdev glue, RX)
+ *   mgmt/auth.c, mgmt/assoc.c                    (auth/assoc frames)
+ *   mgmt/scan.c, mgmt/scan_fsm.c                 (BSS results, probe)
+ *   os/linux/gl_rst.c                            (reset handling)
+ *
+ * Copyright (C) 2013 MediaTek Inc.
+ */
+
+#ifndef _MTK_WLAN_MAC_H
+#define _MTK_WLAN_MAC_H
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/etherdevice.h>
+#include <linux/ieee80211.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/spinlock.h>
+#include <linux/workqueue.h>
