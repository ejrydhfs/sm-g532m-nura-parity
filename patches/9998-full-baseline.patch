diff --git a/tools/mediatek/camera/Makefile b/tools/mediatek/camera/Makefile
new file mode 100644
index 000000000..af2fac5d3
--- /dev/null
+++ b/tools/mediatek/camera/Makefile
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# libcamdrv, the camdrv command line tool and the camservice front end.
+#
+# Port from Samsung/MTK downstream GPL kernel
+# drivers/misc/mediatek/cameraisp/src/mt6735/ and from the ROM userspace
+# libcamdrv.so interface.
+#
+# This is a host build with the system compiler.  The only kernel header it
+# consumes is include/uapi/linux/mtk_isp.h; no kernel internal header and no
+# proprietary blob takes part in the build.
+#
+#   make            static + shared library, the CLI and the service
+#   make compat32   32-bit ABI check (-m32, skipped if unavailable)
+#   make check      no-device behaviour of both programs plus compat32
+#   make clean
+#
+# Everything generated lives under build/: objects in build/obj/ and
+# build/obj/32/, binaries and libraries in build/bin/.  Keeping the
+# executable directory separate from the object tree means no target name can
+# collide with a directory left behind by an older layout.
+
+ROOT := $(abspath $(CURDIR)/../../..)
+
+CC ?= gcc
+AR ?= ar
+CFLAGS ?= -O2
+CPPFLAGS += -I$(ROOT)/include/uapi -I$(CURDIR)/libcamdrv -D__EXPORTED_HEADERS__
+CFLAGS += -Wall -Wextra -std=gnu11 -fPIC
+LDFLAGS ?=
+LDLIBS ?=
+
+BUILD := build
+OBJ := $(BUILD)/obj
+BIN := $(BUILD)/bin
+
+LIB_SRCS := libcamdrv/camdrv.c libcamdrv/camdrv_cq.c libcamdrv/camdrv_mem.c
+LIB_OBJS := $(LIB_SRCS:%.c=$(OBJ)/%.o)
+LIB32_OBJS := $(LIB_SRCS:%.c=$(OBJ)/32/%.o)
+CLI_OBJS := $(OBJ)/camdrv/main.o
+SVC_OBJS := $(OBJ)/camdrv/camservice.o
+
+# The uapi fixes every pointer field to __u64 so that the ioctl size field
+# (and therefore the ioctl number) does not depend on the userspace pointer
+# width.  That only holds on ABIs that align __u64 to 8 bytes: arm, arm64 and
+# x86-64 all do, i386 does not.  -malign-double restores the ARM EABI
+# alignment on i386 so the 32-bit build reproduces the real numbers; without
+# it the check would compare a different ABI and is skipped.
+COMPAT32_FLAGS := $(shell $(CC) -m32 -malign-double -x c -c /dev/null -o /dev/null >/dev/null 2>&1 && echo "-m32 -malign-double")
+
+.PHONY: all static shared cli service compat32 check nodev-check clean
+
+all: static shared cli service ; @$(MAKE) -C otp
+	@$(MAKE) -C iopipe
+
+static: $(BIN)/libcamdrv.a
+shared: $(BIN)/libcamdrv.so
+cli: $(BIN)/camdrv
+service: $(BIN)/camservice
+
+$(OBJ)/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+$(OBJ)/32/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(COMPAT32_FLAGS) -c $< -o $@
+
+$(BIN)/libcamdrv.a: $(LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(AR) rcs $@ $(LIB_OBJS)
+
+$(BIN)/libcamdrv.so: $(LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -shared -Wl,-soname,libcamdrv.so -o $@ $(LIB_OBJS) \
+		$(LDFLAGS) $(LDLIBS)
+
+$(BIN)/camdrv: $(CLI_OBJS) $(BIN)/libcamdrv.a
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -o $@ $(CLI_OBJS) $(BIN)/libcamdrv.a $(LDFLAGS) $(LDLIBS)
+
+$(BIN)/camservice: $(SVC_OBJS) $(BIN)/libcamdrv.a
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -o $@ $(SVC_OBJS) $(BIN)/libcamdrv.a $(LDFLAGS) $(LDLIBS)
+
+$(BIN)/libcamdrv32.a: $(LIB32_OBJS)
+	@mkdir -p $(dir $@)
+	$(AR) rcs $@ $(LIB32_OBJS)
+
+$(BIN)/abi32: tests/abi32.c $(BIN)/libcamdrv32.a
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(COMPAT32_FLAGS) -o $@ tests/abi32.c \
+		$(BIN)/libcamdrv32.a $(LDFLAGS) $(LDLIBS)
+
+ifneq ($(COMPAT32_FLAGS),)
+compat32: $(BIN)/abi32
+	@echo "compat32: built $< (32-bit ABI layout checked)"
+else
+compat32:
+	@echo "compat32: no 32-bit toolchain ($(CC) -m32 -malign-double), check skipped"
+endif
+
+# Acceptance behaviour without a device: both programs must fail and both
+# must name ENODEV, never print a fabricated success.
+nodev-check: cli service
+	@$(BIN)/camdrv --help >/dev/null
+	@$(BIN)/camservice --help >/dev/null
+	@if $(BIN)/camdrv info >$(BUILD)/nodev.out 2>$(BUILD)/nodev.err; then \
+		echo "nodev-check: unexpected success, is a camera ISP device present?"; \
+		exit 1; \
+	fi
+	@if grep -q ENODEV $(BUILD)/nodev.err; then \
+		echo "nodev-check: camdrv reports the missing device as ENODEV"; \
+	else \
+		echo "nodev-check: camdrv device error not reported as ENODEV"; \
+		cat $(BUILD)/nodev.err; \
+		exit 1; \
+	fi
+	@if $(BIN)/camservice --frames 1 >$(BUILD)/nodev-svc.out 2>$(BUILD)/nodev-svc.err; then \
+		echo "nodev-check: camservice succeeded without a device"; \
+		exit 1; \
+	fi
+	@if grep -q ENODEV $(BUILD)/nodev-svc.err; then \
+		echo "nodev-check: camservice reports the missing device as ENODEV"; \
+	else \
+		echo "nodev-check: camservice device error not reported as ENODEV"; \
+		cat $(BUILD)/nodev-svc.err; \
+		exit 1; \
+	fi
+
+ifeq ($(COMPAT32_FLAGS),)
+check: nodev-check compat32
+	@$(MAKE) -C otp check
+	@$(MAKE) -C iopipe check
+else
+check: nodev-check compat32
+	@$(BIN)/abi32 >/dev/null
+	@$(MAKE) -C otp check
+	@$(MAKE) -C iopipe check
+endif
+
+clean:
+	rm -rf $(BUILD)
diff --git a/tools/mediatek/camera/camdrv/camservice.c b/tools/mediatek/camera/camdrv/camservice.c
new file mode 100644
index 000000000..95446ff02
--- /dev/null
+++ b/tools/mediatek/camera/camdrv/camservice.c
@@ -0,0 +1,641 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * camservice - userspace camera ISP service front end.
+ *
+ * Port from Samsung/MTK downstream GPL kernel
+ * drivers/misc/mediatek/cameraisp/src/mt6735/camera_isp_D1.c
+ * and from the ROM userspace libcamdrv.so IspDrvImp::* API.
+ *
+ * This is the process that owns /dev/camera-isp for the lifetime of a camera
+ * session, the way the ROM camera service does through libcamdrv.so:
+ *
+ *   - it is the single opener of the device node,
+ *   - it is the single mapper of the ISP register windows (mmap(2), the page
+ *     offset is the physical base, exactly what the uapi defines),
+ *   - it registers the interrupt user key and blocks in ISP_WAIT_IRQ, waking
+ *     a frame consumer per pass-1 interrupt.
+ *
+ * It does not program the ISP pipeline.  The pipeline is written through the
+ * CQ0C ring and the tuning tables, whose instruction encodings exist only in
+ * the closed camera HAL and are not part of this port; libcamdrv refuses to
+ * invent those words (see camdrv_cq_ring_init()).  Everything this program
+ * does is a real ioctl or mmap(2) on /dev/camera-isp: when the device, the
+ * interrupt or the timeout is missing it prints the errno and exits non-zero,
+ * and it never reports a frame it did not receive.
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "camdrv.h"
+
+#define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
+
+static const char *const prog = "camservice";
+static volatile sig_atomic_t stop;
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	stop = 1;
+}
+
+static void usage(FILE *out)
+{
+	int i;
+
+	fprintf(out,
+"usage: %s [options]\n"
+"\n"
+"Opens %s, maps the requested ISP register windows, registers an\n"
+"interrupt user key and then waits for pass-1 interrupts until the requested\n"
+"number of frames arrived or a signal is received.\n"
+"\n"
+"options:\n"
+"  --frames <n>      stop after n interrupts (0 = until signalled, default 0)\n"
+"  --type <n|name>   IRQ type to wait for (default 0 = p1)\n"
+"  --status <hex>    status bits to wait for (default 0x%08x)\n"
+"  --timeout <ms>    per-wait timeout (default 1000)\n"
+"  --key <n>         IRQ user key (default: the key registered at start)\n"
+"  --user <n>        use the v1 IRQ flow with this user number (> 0)\n"
+"  --capture         run a real capture sequence: allocate DMA buffers,\n"
+"                    program the DMA destination, build and start the CQ0C\n"
+"                    ring, enqueue, stream on, wait for the ISP interrupt and\n"
+"                    dequeue.  Needs the imgsys and isp windows.\n"
+"  --buffers <n>     DMA buffers for --capture (default 4, max 16)\n"
+"  --width <n>       destination width for --capture\n"
+"  --height <n>      destination height for --capture\n"
+"  --stride <n>      destination stride in bytes for --capture\n"
+"  --map <window>    map a register window; repeatable, or 'all'\n"
+"  --no-irq-key      do not register an interrupt user key\n"
+"  --quiet           only report errors\n"
+"  --help            this text\n"
+"\n"
+"windows:",
+		prog, CAMDRV_DEV_NODE, ISP_IRQ_P1_STATUS_SOF1_INT_ST);
+	for (i = 0; i < CAMDRV_WIN_COUNT; i++)
+		fprintf(out, " %s(0x%08x+0x%x)", camdrv_windows[i].name,
+			camdrv_windows[i].base, camdrv_windows[i].size);
+	fprintf(out, "\n\nexit status: 0 when the requested frames arrived or a "
+		"signal stopped the loop,\n             1 on a driver error, "
+		"2 on a usage error\n");
+}
+
+static void usage_error(const char *msg)
+{
+	fprintf(stderr, "%s: %s\n", prog, msg);
+	fprintf(stderr, "%s: try '%s --help'\n", prog, prog);
+	exit(2);
+}
+
+static int fail(int err, const char *what)
+{
+	fprintf(stderr, "%s: %s: %s: %s\n", prog, what, camdrv_errname(err),
+		strerror(-err));
+	return 1;
+}
+
+static bool parse_num(const char *s, uint64_t *out)
+{
+	char *end;
+	unsigned long long v;
+
+	if (!s || !*s)
+		return false;
+	errno = 0;
+	v = strtoull(s, &end, 0);
+	if (errno || *end)
+		return false;
+	*out = v;
+	return true;
+}
+
+static uint64_t need_num(const char *s, const char *what)
+{
+	uint64_t v;
+
+	if (!parse_num(s, &v))
+		usage_error(what);
+	return v;
+}
+
+/* ------------------------------------------------------------------ */
+/* Capture flow                                                        */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Register addresses used below, all offsets from 0x15000000 (the address
+ * space ISP_REG_STRUCT.Addr uses, camera_isp_D1.c:3387-3455):
+ *
+ *   0x4414  TG_VF_CON      stream on/off, bit 0
+ *                         (libcamdrv.so writeReg(0x4414, 1) @0xcc32-0xcc42)
+ *   0x40f0  IMGO_FBC       frame buffer control
+ *   0x40f4  RRZO_FBC
+ *   0x40b4  CQ0C base      head of the CQ0C ring
+ *   0xf308  IMGO_XSIZE     inner (TPIPE) DMA destination width
+ *   0xf30c  IMGO_YSIZE
+ *   0xf310  IMGO_STRIDE
+ */
+#define CAM_TG_VF_CON		0x4414
+#define CAM_IMGO_FBC		0x40f0
+#define CAM_CQ0C_BASE		0x40b4
+#define CAM_IMGO_XSIZE		0xf308
+#define CAM_IMGO_YSIZE		0xf30c
+#define CAM_IMGO_STRIDE		0xf310
+
+struct capture_cfg {
+	uint64_t frames;
+	unsigned int buffers;
+	uint32_t width;
+	uint32_t height;
+	uint32_t stride;
+	uint32_t timeout;
+	int key;
+	bool quiet;
+};
+
+static int cap_write(struct camdrv *d, uint32_t addr, uint32_t val,
+		     const char *what)
+{
+	int ret = camdrv_write_reg(d, addr, val);
+
+	if (ret) {
+		fprintf(stderr, "camservice: write %s (0x%08x) failed: %s\n",
+			what, addr, camdrv_errname(ret));
+		return ret;
+	}
+	return 0;
+}
+
+/*
+ * Run one real capture sequence on /dev/camera-isp:
+ *
+ *   allocate -> program DMA destination -> build+start CQ0C ring -> enqueue
+ *   -> enable DMA -> stream on -> wait for the SOF/PASS1_DON interrupt ->
+ *   dequeue -> re-enqueue.
+ *
+ * Every step is a real ioctl or a real register write; the finish condition is
+ * the ISP interrupt.  There is no timer-driven "frame".
+ *
+ * Not programmed here, because the data does not exist in any available
+ * source: the Pass-1 / Pass-2 / DSP processing tables (the CAM_* module
+ * registers, the TPIPE block and the CQ0 table the ISP firmware executes) are
+ * generated by the closed camera HAL for the attached sensor.  Without them
+ * the ISP will not produce a completed frame, and this program then reports
+ * the interrupt timeout instead of inventing one.
+ */
+static int run_capture(struct camdrv *d, const struct capture_cfg *cfg,
+		       unsigned int map_mask)
+{
+	ISP_RT_BUF_INFO_STRUCT *bufs = NULL;
+	ISP_DEQUE_BUF_INFO_STRUCT deque;
+	struct camdrv_buffer frames = { .fd = -1 }, ringmem = { .fd = -1 };
+	struct camdrv_cq_ring ring;
+	struct camdrv_mem ring_mem;
+	uint8_t dma_en[_rt_dma_max_] = { 0 };
+	size_t frame_size, total;
+	uint64_t frame;
+	unsigned int i;
+	int ret = 0;
+
+	if (!(map_mask & (1u << CAMDRV_WIN_IMGSYS)) ||
+	    !(map_mask & (1u << CAMDRV_WIN_ISP))) {
+		fprintf(stderr,
+			"camservice: capture needs the imgsys and isp windows (--map imgsys --map isp)\n");
+		return 2;
+	}
+	if (!cfg->width || !cfg->height || !cfg->stride) {
+		fprintf(stderr, "camservice: capture needs --width/--height/--stride\n");
+		return 2;
+	}
+
+	frame_size = (size_t)cfg->stride * cfg->height;
+	frame_size = (frame_size + 0xfff) & ~(size_t)0xfff;
+	total = frame_size * cfg->buffers;
+	if (total < frame_size || total > (size_t)512 * 1024 * 1024) {
+		fprintf(stderr, "camservice: buffer geometry out of range\n");
+		return 2;
+	}
+
+	bufs = calloc(cfg->buffers, sizeof(*bufs));
+	if (!bufs)
+		return 1;
+
+	ret = camdrv_buffer_alloc(&frames, total);
+	if (ret) {
+		fprintf(stderr, "camservice: frame buffer: %s (%s)\n",
+			camdrv_errname(ret), strerror(-ret));
+		goto out;
+	}
+	ret = camdrv_buffer_alloc(&ringmem, sizeof(ISP_CQ_RTBC_RING_ST));
+	if (ret) {
+		fprintf(stderr, "camservice: CQ0C ring buffer: %s (%s)\n",
+			camdrv_errname(ret), strerror(-ret));
+		goto out;
+	}
+
+	if (!cfg->quiet)
+		printf("camservice: %u buffers of %zu bytes, PA 0x%08x, CQ ring PA 0x%08x\n",
+		       cfg->buffers, frame_size, frames.pa, ringmem.pa);
+
+	/* 1. DMA destination geometry (inner/TPIPE registers). */
+	ret = cap_write(d, CAM_IMGO_XSIZE, cfg->stride, "IMGO_XSIZE");
+	if (ret)
+		goto out;
+	ret = cap_write(d, CAM_IMGO_YSIZE, cfg->height, "IMGO_YSIZE");
+	if (ret)
+		goto out;
+	ret = cap_write(d, CAM_IMGO_STRIDE, cfg->stride, "IMGO_STRIDE");
+	if (ret)
+		goto out;
+
+	/* 2. Fill the buffer descriptors. */
+	for (i = 0; i < cfg->buffers; i++) {
+		bufs[i].memID = 0;
+		bufs[i].size = (uint32_t)frame_size;
+		bufs[i].base_pAddr = frames.pa + (uint32_t)(i * frame_size);
+		bufs[i].base_vAddr = (int64_t)(uintptr_t)
+			((char *)frames.va + i * frame_size);
+		bufs[i].bufIdx = (int32_t)i;
+		bufs[i].image.frm_cnt = 0xffff;
+	}
+
+	/* 3. Enqueue before streaming: the kernel arms the DMA base address
+	 *    when the first buffer of a stopped ring arrives
+	 *    (mtk-isp.c, mtk_isp_rtbc_enque). */
+	for (i = 0; i < cfg->buffers; i++) {
+		ret = camdrv_rtbuf_enqueue(d, _imgo_, &bufs[i]);
+		if (ret) {
+			fprintf(stderr, "camservice: enqueue %u: %s\n", i,
+				camdrv_errname(ret));
+			goto out;
+		}
+	}
+
+	/* 4. Build the CQ0C ring with the recovered encodings and start it. */
+	ring_mem.va = ringmem.va;
+	ring_mem.pa = ringmem.pa;
+	ring_mem.size = ringmem.size;
+	ret = camdrv_cq_ring_init_ex(&ring, &ring_mem, false);
+	if (ret)
+		goto out;
+	for (i = 0; i < cfg->buffers; i++) {
+		ret = camdrv_cq_ring_push(&ring, bufs[i].base_pAddr,
+					  bufs[i].bufIdx,
+					  bufs[i].base_pAddr, bufs[i].bufIdx,
+					  NULL);
+		if (ret)
+			goto out;
+	}
+	ret = camdrv_cq_ring_fbc_program(d, &ring, false, false);
+	if (ret) {
+		fprintf(stderr, "camservice: FBC program: %s\n",
+			camdrv_errname(ret));
+		goto out;
+	}
+	ret = camdrv_cq_ring_kick(d, &ring);
+	if (ret) {
+		fprintf(stderr, "camservice: CQ0C kick: %s\n",
+			camdrv_errname(ret));
+		goto out;
+	}
+
+	/* 5. Enable the DMA port and stream on. */
+	dma_en[_imgo_] = 1;
+	ret = camdrv_rtbuf_dma_en(d, dma_en, sizeof(dma_en));
+	if (ret)
+		goto out;
+	ret = cap_write(d, CAM_TG_VF_CON, 1, "TG_VF_CON");
+	if (ret)
+		goto out;
+
+	/* 6. Wait for real interrupts, dequeue and re-arm. */
+	for (frame = 0; frame < cfg->frames; frame++) {
+		ISP_WAIT_IRQ_STRUCT irq;
+
+		camdrv_irq_fill_v3(&irq, ISP_IRQ_TYPE_INT_P1_ST,
+				   ISP_IRQ_P1_STATUS_SOF1_INT_ST, cfg->key,
+				   cfg->timeout);
+		ret = camdrv_wait_irq(d, &irq);
+		if (ret) {
+			fprintf(stderr, "camservice: SOF wait: %s (%s)\n",
+				camdrv_errname(ret), strerror(-ret));
+			break;
+		}
+		camdrv_irq_fill_v3(&irq, ISP_IRQ_TYPE_INT_P1_ST,
+				   ISP_IRQ_P1_STATUS_PASS1_DON_ST, cfg->key,
+				   cfg->timeout);
+		ret = camdrv_wait_irq(d, &irq);
+		if (ret) {
+			fprintf(stderr, "camservice: pass1-done wait: %s (%s)\n",
+				camdrv_errname(ret), strerror(-ret));
+			break;
+		}
+
+		memset(&deque, 0, sizeof(deque));
+		ret = camdrv_rtbuf_dequeue(d, _imgo_, &deque);
+		if (ret) {
+			fprintf(stderr, "camservice: dequeue: %s\n",
+				camdrv_errname(ret));
+			break;
+		}
+		if (!cfg->quiet) {
+			const ISP_RT_BUF_INFO_STRUCT *b = &deque.data[0];
+
+			printf("camservice: frame %llu pa=0x%08x %ux%u stride=%u fmt=%u t=%u.%06u sof=%u img=%u\n",
+			       (unsigned long long)frame, b->base_pAddr,
+			       b->image.w, b->image.h, b->image.stride,
+			       b->image.fmt, b->timeStampS, b->timeStampUs,
+			       deque.sof_cnt, deque.img_cnt);
+			fflush(stdout);
+		}
+
+		/* Give the buffer back so the ring keeps running. */
+		ret = camdrv_rtbuf_enqueue(d, _imgo_, &deque.data[0]);
+		if (ret) {
+			fprintf(stderr, "camservice: re-enqueue: %s\n",
+				camdrv_errname(ret));
+			break;
+		}
+	}
+
+	/* 7. Stream off. */
+	camdrv_write_reg(d, CAM_TG_VF_CON, 0);
+	camdrv_rtbuf_clear(d, _imgo_);
+
+out:
+	camdrv_buffer_free(&ringmem);
+	camdrv_buffer_free(&frames);
+	free(bufs);
+	return ret ? 1 : 0;
+}
+
+static int irq_type_by_name(const char *s)
+{
+	static const char *const names[] = {
+		[ISP_IRQ_TYPE_INT_P1_ST]	= "p1",
+		[ISP_IRQ_TYPE_INT_P1_ST2]	= "p1-dma",
+		[ISP_IRQ_TYPE_INT_P1_ST_D]	= "p1-d",
+		[ISP_IRQ_TYPE_INT_P1_ST2_D]	= "p1-dma-d",
+		[ISP_IRQ_TYPE_INT_P2_ST]	= "p2",
+		[ISP_IRQ_TYPE_INT_STATUSX]	= "statusx",
+		[ISP_IRQ_TYPE_INT_STATUS2X]	= "status2x",
+		[ISP_IRQ_TYPE_INT_STATUS3X]	= "status3x",
+		[ISP_IRQ_TYPE_INT_SENINF1]	= "seninf1",
+		[ISP_IRQ_TYPE_INT_SENINF2]	= "seninf2",
+		[ISP_IRQ_TYPE_INT_SENINF3]	= "seninf3",
+		[ISP_IRQ_TYPE_INT_SENINF4]	= "seninf4",
+		[ISP_IRQ_TYPE_INT_CAMSV]	= "camsv",
+		[ISP_IRQ_TYPE_INT_CAMSV2]	= "camsv2",
+	};
+	uint64_t v;
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (names[i] && !strcmp(s, names[i]))
+			return (int)i;
+	if (parse_num(s, &v) && v < ISP_IRQ_TYPE_AMOUNT)
+		return (int)v;
+	return -1;
+}
+
+int main(int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "capture",	no_argument,		NULL, 'C' },
+		{ "buffers",	required_argument,	NULL, 'B' },
+		{ "width",	required_argument,	NULL, 'W' },
+		{ "height",	required_argument,	NULL, 'H' },
+		{ "stride",	required_argument,	NULL, 'S' },
+		{ "frames",	required_argument,	NULL, 'f' },
+		{ "type",	required_argument,	NULL, 't' },
+		{ "status",	required_argument,	NULL, 's' },
+		{ "timeout",	required_argument,	NULL, 'o' },
+		{ "key",	required_argument,	NULL, 'k' },
+		{ "user",	required_argument,	NULL, 'u' },
+		{ "map",	required_argument,	NULL, 'm' },
+		{ "no-irq-key",	no_argument,		NULL, 'n' },
+		{ "quiet",	no_argument,		NULL, 'q' },
+		{ "help",	no_argument,		NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	struct sigaction sa = { .sa_handler = on_signal };
+	struct capture_cfg cap = { .buffers = 4, .timeout = 1000 };
+	uint64_t frames = 0;
+	uint32_t type = ISP_IRQ_TYPE_INT_P1_ST;
+	uint32_t status = ISP_IRQ_P1_STATUS_SOF1_INT_ST;
+	uint32_t timeout = 1000;
+	bool map_all = false, quiet = false, no_key = false, capture = false;
+	unsigned int map_mask = 0;
+	long user = -1, key = -1;
+	struct camdrv *d;
+	uint64_t frame;
+	int c, ret, rc = 0;
+
+	optind = 1;
+	while ((c = getopt_long(argc, argv, "h", opts, NULL)) != -1) {
+		uint64_t v;
+
+		switch (c) {
+		case 'C':
+			capture = true;
+			break;
+		case 'B':
+			v = need_num(optarg, "bad --buffers");
+			if (v < 1 || v > ISP_RT_BUF_SIZE)
+				usage_error("--buffers must be 1..ISP_RT_BUF_SIZE");
+			cap.buffers = (unsigned int)v;
+			break;
+		case 'W':
+			v = need_num(optarg, "bad --width");
+			cap.width = (uint32_t)v;
+			break;
+		case 'H':
+			v = need_num(optarg, "bad --height");
+			cap.height = (uint32_t)v;
+			break;
+		case 'S':
+			v = need_num(optarg, "bad --stride");
+			cap.stride = (uint32_t)v;
+			break;
+		case 'f':
+			frames = need_num(optarg, "bad --frames");
+			break;
+		case 't':
+			if (irq_type_by_name(optarg) < 0)
+				usage_error("bad --type");
+			type = (uint32_t)irq_type_by_name(optarg);
+			break;
+		case 's':
+			status = (uint32_t)need_num(optarg, "bad --status");
+			if (!status)
+				usage_error("--status needs at least one bit");
+			break;
+		case 'o':
+			v = need_num(optarg, "bad --timeout");
+			if (!v || v > UINT32_MAX)
+				usage_error("bad --timeout");
+			timeout = (uint32_t)v;
+			break;
+		case 'k':
+			v = need_num(optarg, "bad --key");
+			if (v < 1 || v > INT32_MAX)
+				usage_error("--key must be 1..INT32_MAX");
+			key = (long)v;
+			break;
+		case 'u':
+			v = need_num(optarg, "bad --user");
+			if (v < 1 || v >= ISP_IRQ_USER_MAX)
+				usage_error("--user must be 1..ISP_IRQ_USER_MAX-1");
+			user = (long)v;
+			break;
+		case 'm': {
+			int id;
+
+			if (!strcmp(optarg, "all")) {
+				map_all = true;
+				break;
+			}
+			id = camdrv_window_id_by_name(optarg);
+			if (id < 0)
+				usage_error("unknown window name");
+			map_mask |= 1u << id;
+			break;
+		}
+		case 'n':
+			no_key = true;
+			break;
+		case 'q':
+			quiet = true;
+			break;
+		case 'h':
+			usage(stdout);
+			return 0;
+		default:
+			usage_error("unknown option");
+		}
+	}
+	if (optind != argc)
+		usage_error("unexpected argument");
+	if (key >= 0 && user > 0)
+		usage_error("--key and --user are mutually exclusive");
+
+	if (!quiet) {
+		printf("%s: opening %s\n", prog, CAMDRV_DEV_NODE);
+		fflush(stdout);
+	}
+
+	d = camdrv_create();
+	if (!d) {
+		fprintf(stderr, "%s: out of memory\n", prog);
+		return 1;
+	}
+
+	/* Registering a key is what the downstream service does in
+	 * IspDrvImp::init().  --no-irq-key skips it, which is what a client
+	 * of the v1 --user flow or a kernel without
+	 * ISP_REGISTER_IRQ_USER_KEY needs. */
+	ret = camdrv_init(d, no_key ? NULL : "camservice");
+	if (ret) {
+		rc = fail(ret, "open");
+		goto out_destroy;
+	}
+
+	if (map_all)
+		map_mask = (1u << CAMDRV_WIN_COUNT) - 1;
+	if (capture)
+		map_mask |= (1u << CAMDRV_WIN_IMGSYS) | (1u << CAMDRV_WIN_ISP);
+	for (c = 0; c < CAMDRV_WIN_COUNT; c++) {
+		if (!(map_mask & (1u << c)))
+			continue;
+		ret = camdrv_mmap(d, (enum camdrv_window_id)c);
+		if (ret) {
+			rc = fail(ret, camdrv_windows[c].name);
+			goto out_uninit;
+		}
+		if (!quiet)
+			printf("%s: mapped %s at 0x%08x (%u bytes)\n", prog,
+			       camdrv_windows[c].name, camdrv_windows[c].base,
+			       camdrv_windows[c].size);
+	}
+
+	if (key < 0)
+		key = camdrv_user_key(d);
+	if (user <= 0 && key <= 0) {
+		fprintf(stderr, "%s: no IRQ user key registered; pass --key <n> "
+			"or --user <n>\n", prog);
+		rc = 2;
+		goto out_uninit;
+	}
+
+	if (capture) {
+		if (user > 0) {
+			fprintf(stderr, "%s: --capture needs the v3 IRQ flow, "
+				"not --user\n", prog);
+			rc = 2;
+			goto out_uninit;
+		}
+		cap.frames = frames ? frames : 1;
+		cap.timeout = timeout;
+		cap.key = (int)key;
+		cap.quiet = quiet;
+		rc = run_capture(d, &cap, map_mask);
+		goto out_uninit;
+	}
+
+	sigaction(SIGINT, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+
+	frame = 0;
+	while (!stop && (!frames || frame < frames)) {
+		ISP_WAIT_IRQ_STRUCT irq;
+
+		if (user > 0)
+			camdrv_irq_fill_v1(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+					   (ISP_IRQ_USER_ENUM)user, timeout);
+		else
+			camdrv_irq_fill_v3(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+					   (int)key, timeout);
+
+		ret = camdrv_wait_irq(d, &irq);
+		if (ret) {
+			rc = fail(ret, "wait-irq");
+			goto out_uninit;
+		}
+
+		frame++;
+		if (!quiet) {
+			unsigned int u = (unsigned int)(type < ISP_IRQ_TYPE_AMOUNT ?
+							type : 0);
+
+			printf("%s: frame %llu irq type=%u status=0x%08x "
+			       "tstamp=%u sig=%u.%06u\n",
+			       prog, (unsigned long long)frame, u,
+			       irq.UserInfo.Status ? irq.UserInfo.Status :
+			       irq.Status, irq.irq_TStamp,
+			       irq.TimeInfo.tLastSig_sec,
+			       irq.TimeInfo.tLastSig_usec);
+			fflush(stdout);
+		}
+	}
+
+	if (stop && !quiet)
+		printf("%s: stopped by signal after %llu frames\n", prog,
+		       (unsigned long long)frame);
+	else if (!quiet)
+		printf("%s: done, %llu frames\n", prog,
+		       (unsigned long long)frame);
+
+out_uninit:
+	camdrv_uninit(d);
+out_destroy:
+	camdrv_destroy(d);
+	return rc;
+}
diff --git a/tools/mediatek/camera/camdrv/main.c b/tools/mediatek/camera/camdrv/main.c
new file mode 100644
index 000000000..573f58765
--- /dev/null
+++ b/tools/mediatek/camera/camdrv/main.c
@@ -0,0 +1,947 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * camdrv - command line front end for libcamdrv.
+ *
+ * Port from Samsung/MTK downstream GPL kernel
+ * drivers/misc/mediatek/cameraisp/src/mt6735/camera_isp_D1.c
+ * and from the ROM userspace libcamdrv.so IspDrvImp::* API.
+ *
+ * Every subcommand issues a real ioctl on /dev/camera-isp.  Nothing is
+ * simulated: a missing device, an unsupported control or a timeout is
+ * reported on stderr and turned into a non-zero exit status.
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "camdrv.h"
+
+#define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
+
+static const char *const prog = "camdrv";
+static const char *const default_user = "camdrv";
+
+struct dma_name {
+	const char *name;
+	_isp_dma_enum_ id;
+};
+
+static const struct dma_name dma_names[] = {
+	{ "imgi",		_imgi_ },
+	{ "vipi",		_vipi_ },
+	{ "vip2i",		_vip2i_ },
+	{ "vip3i",		_vip3i_ },
+	{ "imgo",		_imgo_ },
+	{ "ufdi",		_ufdi_ },
+	{ "lcei",		_lcei_ },
+	{ "ufeo",		_ufeo_ },
+	{ "rrzo",		_rrzo_ },
+	{ "imgo-d",		_imgo_d_ },
+	{ "rrzo-d",		_rrzo_d_ },
+	{ "img2o",		_img2o_ },
+	{ "img3o",		_img3o_ },
+	{ "img3bo",		_img3bo_ },
+	{ "img3co",		_img3co_ },
+	{ "camsv-imgo",		_camsv_imgo_ },
+	{ "camsv2-imgo",	_camsv2_imgo_ },
+	{ "mfbo",		_mfbo_ },
+	{ "feo",		_feo_ },
+	{ "wrot",		_wrot_ },
+	{ "wdma",		_wdma_ },
+	{ "jpeg",		_jpeg_ },
+};
+
+static const char *const irq_type_names[] = {
+	[ISP_IRQ_TYPE_INT_P1_ST]	= "p1",
+	[ISP_IRQ_TYPE_INT_P1_ST2]	= "p1-dma",
+	[ISP_IRQ_TYPE_INT_P1_ST_D]	= "p1-d",
+	[ISP_IRQ_TYPE_INT_P1_ST2_D]	= "p1-dma-d",
+	[ISP_IRQ_TYPE_INT_P2_ST]	= "p2",
+	[ISP_IRQ_TYPE_INT_STATUSX]	= "statusx",
+	[ISP_IRQ_TYPE_INT_STATUS2X]	= "status2x",
+	[ISP_IRQ_TYPE_INT_STATUS3X]	= "status3x",
+	[ISP_IRQ_TYPE_INT_SENINF1]	= "seninf1",
+	[ISP_IRQ_TYPE_INT_SENINF2]	= "seninf2",
+	[ISP_IRQ_TYPE_INT_SENINF3]	= "seninf3",
+	[ISP_IRQ_TYPE_INT_SENINF4]	= "seninf4",
+	[ISP_IRQ_TYPE_INT_CAMSV]	= "camsv",
+	[ISP_IRQ_TYPE_INT_CAMSV2]	= "camsv2",
+};
+
+static const char *const ref_ctrl_names[] = {
+	[ISP_REF_CNT_GET]				= "get",
+	[ISP_REF_CNT_INC]				= "inc",
+	[ISP_REF_CNT_DEC]				= "dec",
+	[ISP_REF_CNT_DEC_AND_RESET_P1_P2_IF_LAST_ONE]	= "dec-reset-p1p2",
+	[ISP_REF_CNT_DEC_AND_RESET_P1_IF_LAST_ONE]	= "dec-reset-p1",
+	[ISP_REF_CNT_DEC_AND_RESET_P2_IF_LAST_ONE]	= "dec-reset-p2",
+};
+
+static const char *const ref_id_names[] = {
+	"imem", "isp-func", "global-pipe", "p1-pipe", "p2-pipe",
+};
+
+static void usage(FILE *out)
+{
+	int i;
+
+	fprintf(out,
+"usage: %s <command> [options]\n"
+"\n"
+"commands:\n"
+"  info                       device node, register scenario, burst queue,\n"
+"                             SOF and drop-frame counters, error counters\n"
+"  dump-regs                  request a full ISP register dump (kernel log)\n"
+"  dump-isr-log [--tg n]      request an interrupt log dump for one TG\n"
+"  read-reg <addr> [count]    read one register or a block of registers\n"
+"  write-reg <addr> <value>   write one register\n"
+"  wait-irq [options]         wait for an ISP interrupt\n"
+"  rtbuf-enqueue [options]    enqueue a pass-1 real time buffer\n"
+"  rtbuf-dequeue [options]    dequeue a filled pass-1 real time buffer\n"
+"  rtbuf-status [options]     ring size, ready flag and current FBC dump\n"
+"  mmap-dump [options]        hex dump a mapped ISP register window\n"
+"  get-sof [options]          query the software SOF counter\n"
+"  get-errors                 dump interrupt and DMA error counters\n"
+"  ref-cnt [options]          get/inc/dec a driver reference counter\n"
+"  hold <0|1>                 hold register writes until the next trigger\n"
+"\n"
+"device node: %s (fixed by the uapi)\n", prog, CAMDRV_DEV_NODE);
+
+	fprintf(out, "\nwait-irq options:\n"
+"  --type <n|name>            IRQ type (default 0 = p1)\n"
+"  --status <hex>             status bits to wait for (default 0x%08x)\n"
+"  --timeout <ms>             timeout in milliseconds (default 1000)\n"
+"  --clear <n>                ISP_IRQ_CLEAR_ENUM (default 0 = none)\n"
+"  --user <n>                 use the v1 flow with this user number (> 0)\n"
+"  --key <n>                  use the v3 flow with this IRQ user key\n"
+"                             (default: the key registered at init)\n"
+"  --mark                     mark an IRQ request instead of waiting\n"
+"  --flush                    flush pending IRQ requests\n"
+"  --mark-time                query the mark-to-query time only\n",
+		ISP_IRQ_P1_STATUS_SOF1_INT_ST);
+
+	fprintf(out, "\nrtbuf options:\n"
+"  --dma <name>               DMA channel (default imgo)\n"
+"  --pa <hex>                 buffer physical address (required)\n"
+"  --va <num>                 buffer virtual address recorded in the ring\n"
+"  --size <num>               buffer size\n"
+"  --index <num>              buffer index used for replacement\n"
+"  --memid <num>              memory id\n"
+"  --immediate                use ENQUE_IMD instead of ENQUE\n");
+
+	fprintf(out, "\nwindows:");
+	for (i = 0; i < CAMDRV_WIN_COUNT; i++)
+		fprintf(out, " %s(0x%08x+0x%x)", camdrv_windows[i].name,
+			camdrv_windows[i].base, camdrv_windows[i].size);
+	fprintf(out, "\n\nmmap-dump options:\n"
+"  --window <name>            window to map (default isp)\n"
+"  --offset <num>             byte offset inside the window\n"
+"  --length <num>             bytes to dump (default 64, max window size)\n"
+"\nref-cnt options:\n"
+"  --ctrl <name|n>            get/inc/dec/dec-reset-* (default get)\n"
+"  --id <name|n>              imem/isp-func/global-pipe/p1-pipe/p2-pipe\n"
+"\n"
+"exit status: 0 on success, 1 on a driver error, 2 on a usage error\n");
+}
+
+static void usage_error(const char *msg)
+{
+	fprintf(stderr, "%s: %s\n", prog, msg);
+	fprintf(stderr, "%s: try '%s --help'\n", prog, prog);
+	exit(2);
+}
+
+static int fail(int err, const char *what)
+{
+	fprintf(stderr, "%s: %s: %s: %s\n", prog, what, camdrv_errname(err),
+		strerror(-err));
+	return 1;
+}
+
+static bool parse_num(const char *s, uint64_t *out)
+{
+	char *end;
+	unsigned long long v;
+
+	if (!s || !*s)
+		return false;
+	errno = 0;
+	v = strtoull(s, &end, 0);
+	if (errno || *end)
+		return false;
+	*out = v;
+	return true;
+}
+
+static uint64_t need_num(const char *s, const char *what)
+{
+	uint64_t v;
+
+	if (!parse_num(s, &v))
+		usage_error(what);
+	return v;
+}
+
+static int dma_by_name(const char *name)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(dma_names); i++)
+		if (!strcmp(name, dma_names[i].name))
+			return dma_names[i].id;
+	return -1;
+}
+
+static const char *dma_name(int id)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(dma_names); i++)
+		if ((int)dma_names[i].id == id)
+			return dma_names[i].name;
+	return "?";
+}
