+/*
+ * Port from Samsung/MTK downstream pmic_auxadc.c:173-455
+ * PMIC_IMM_GetOneChannelValue(): one-shot conversion of one channel.
+ *
+ * The downstream function turns on the AUXADC clock, the input buffer and
+ * the AP-mode 26 MHz clock, requests the channel through RQST0_SET and polls
+ * the ready bit of that channel's output register.  For channel 9 it returns
+ * the raw 12 bit code (pmic_auxadc.c:434-436); every other channel is scaled
+ * to millivolts there.  This helper always returns the raw code, which is
+ * what the HP impedance path consumes.
+ *
+ * The baseline accdet driver (drivers/misc/mediatek/accdet/accdet.c:137-166)
+ * uses the same PMIC AUXADC block for channel 5 through the same RQST0_SET /
+ * ready-bit scheme; only the channel and the auto-sample setup differ.
+ */
+static int mt6331_auxadc_read(struct mt6331_priv *priv, unsigned int channel,
+			      unsigned int *code)
+{
+	unsigned int val;
+	int ret;
+
+	/* pmic_auxadc.c:207: the PMIC has 16 channels */
+	if (channel > 15)
+		return -EINVAL;
+
+	/* pmic_auxadc.c:212-214 */
+	ret = regmap_update_bits(priv->regmap, MT6328_AUXADC_CON0,
+				 MT6328_AUXADC_CK_AON,
+				 MT6328_AUXADC_CK_AON);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(priv->regmap, MT6328_AUXADC_CON12,
+				 MT6328_AUXADC_VBUF_EN,
+				 MT6328_AUXADC_VBUF_EN);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(priv->regmap, MT6328_TOP_CLKSQ,
+				 RG_CLKSQ_EN_AUX_AP_MODE,
+				 RG_CLKSQ_EN_AUX_AP_MODE);
+	if (ret)
+		return ret;
+
+	/* pmic_auxadc.c:222: request one conversion */
+	ret = regmap_write(priv->regmap, MT6328_AUXADC_RQST0_SET,
+			   BIT(channel));
+	if (ret)
+		return ret;
+
+	/* pmic_auxadc.c:337-347: bit 15 of the channel output is the ready
+	 * flag, bits 11:0 the code.  The downstream loop is bounded by a retry
+	 * counter; a poll timeout is equivalent.
+	 */
+	ret = regmap_read_poll_timeout(priv->regmap,
+				       MT6328_AUXADC_ADC_BASE + 2 * channel,
+				       val, val & MT6328_AUXADC_RDY,
+				       MT6331_AUXADC_POLL_US,
+				       MT6331_AUXADC_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	*code = val & MT6328_AUXADC_DATA_MASK;
+	return 0;
+}
+
+/*
+ * vendor:351-370: the first call measures the analog/AUXADC offset with the
+ * trim buffer connected to ground.  The vendor also fills the AFE internal
+ * SRAM and waits 5 s in this branch; the SRAM fill is userspace's job here
+ * (AFE control "HP Impedance DC Value"), so only the offset is measured.
+ */
+static int mt6331_hp_impedance_calibrate(struct mt6331_priv *priv)
+{
+	unsigned int code = 0;
+	int ret;
+
+	ret = mt6331_open_analog_trim_hw(priv, true);
+	if (ret)
+		return ret;
+
+	mt6331_set_offset_trim_mux(priv, MT6331_TRIM_MUX_GROUND);
+	mt6331_set_offset_trim_buffer_gain(priv, 3);
+	mt6331_enable_trimbuffer(priv, true);
+	usleep_range(5000, 20000);	/* vendor:357 */
+
+	ret = mt6331_auxadc_read(priv, MT6331_AUXADC_HP_CHANNEL, &code);
+
+	mt6331_enable_trimbuffer(priv, false);
+	mt6331_open_analog_trim_hw(priv, false);
+	if (ret)
+		return ret;
+
+	priv->auxadc_offset = code;
+	priv->auxadc_offset_valid = true;
+	dev_info(priv->dev, "HP impedance AUXADC offset = %u\n", code);
+
+	return 0;
+}
+
+/* mt_soc_pcm_hp_impedance.c:338-420 Audio_HP_ImpeDance_Set() */
+static int mt6331_hp_impedance_set(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_kcontrol_chip(kcontrol);
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned long value = ucontrol->value.integer.value[0];
+	int ret = 0;
+
+	/* The AFE SRAM DC word is 16 bit wide. */
+	if (value > U16_MAX)
+		return -EINVAL;
+
+	mutex_lock(&priv->ana_lock);
+
+	priv->hp_impedance_dc = value;
+
+	if (!priv->auxadc_offset_valid) {
+		ret = mt6331_hp_impedance_calibrate(priv);
+		if (ret)
+			goto out;
+	}
+
+	if (value == 1) {
+		/* vendor:371-379: start the measurement.  The AFE SRAM is
+		 * filled through the AFE component control "HP Impedance DC
+		 * Value" instead of the vendor's memset() (vendor:377-378).
+		 */
+		ret = mt6331_open_hp_impedance_setting(priv, true);
+		if (ret)
+			goto out;
+		mt6331_set_offset_trim_mux(priv, MT6331_TRIM_MUX_HPR);
+		mt6331_set_offset_trim_buffer_gain(priv, 3);
+		mt6331_enable_trimbuffer(priv, true);
+		mt6331_set_hp_gain(priv, 8);	/* 8: 0 dB */
+		priv->hp_impedance_on = true;
+	} else if (value == 0) {
+		/* vendor:380-386: stop and restore the idle analog state */
+		ret = mt6331_open_hp_impedance_setting(priv, false);
+		if (ret)
+			goto out;
+		mt6331_set_offset_trim_mux(priv, MT6331_TRIM_MUX_GROUND);
+		mt6331_enable_trimbuffer(priv, false);
+		mt6331_set_sdm_level(priv, MT6331_SDM_LEVEL_NORMAL);
+		priv->hp_impedance_on = false;
+	} else {
+		/* vendor:387-418 sweeps this value in 200-count steps with a
+		 * 20 ms settle and a 3 s pause.  That sweep is userspace
+		 * driven here: write the DC value, start, wait, read
+		 * "Audio AUXADC Data".
+		 */
+		dev_dbg(priv->dev, "HP impedance DC value %lu\n", value);
+	}
+
+out:
+	mutex_unlock(&priv->ana_lock);
+	return ret;
+}
+
+/*
+ * The downstream get handler (mt_soc_pcm_hp_impedance.c:579-606) runs the
+ * whole DC sweep and returns the computed resistance.  That sweep needs the
+ * AFE SRAM buffer and is userspace's job in this design, so report the last
+ * value written to the control instead.
+ */
+static int mt6331_hp_impedance_get(struct snd_kcontrol *kcontrol,
+				   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_kcontrol_chip(kcontrol);
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	ucontrol->value.integer.value[0] = priv->hp_impedance_dc;
+
+	return 0;
+}
+
+/* vendor:2814-2825 Audio_AuxAdcData_Get() */
+static int mt6331_auxadc_data_get(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_kcontrol_chip(kcontrol);
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int code;
+	int ret;
+
+	mutex_lock(&priv->ana_lock);
+	ret = mt6331_auxadc_read(priv, priv->auxadc_channel, &code);
+	mutex_unlock(&priv->ana_lock);
+	if (ret)
+		return ret;
+
+	ucontrol->value.integer.value[0] = code;
+
+	return 0;
+}
+
+/* vendor:2828-2833 Audio_AuxAdcData_Set() */
+static int mt6331_auxadc_data_set(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *cmpnt = snd_kcontrol_chip(kcontrol);
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned long channel = ucontrol->value.integer.value[0];
+
+	if (channel > 15)
+		return -EINVAL;
+
+	priv->auxadc_channel = channel;
+
+	return 0;
+}
