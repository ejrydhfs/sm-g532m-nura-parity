diff --git a/sound/soc/codecs/mt6331.c b/sound/soc/codecs/mt6331.c
new file mode 100644
index 000000000..825b2fb60
--- /dev/null
+++ b/sound/soc/codecs/mt6331.c
@@ -0,0 +1,1714 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6328 PMIC audio codec driver (MT6735 / MT6737)
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ * Copyright (c) 2024 The Nura project
+ *
+ * Port from Samsung/MTK downstream:
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_codec_63xx.c
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_codec_speaker_63xx.c
+ *   sound/soc/mediatek/mt_soc_audio_v3/AudDrv_Ana.{c,h}
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * The vendor driver is named "mt6331" (ROM symbols mt6331_codec_probe,
+ * mt6331_read, mt6331_write) but the PMIC on MT6737T/grandpplte is an MT6328
+ * and only the MT6328 audio register map is programmed here.  In the vendor
+ * kernel every one of these registers is a PMIC register reached over pwrap
+ * (AudDrv_Ana.c:67-104 Ana_Set_Reg/Ana_Get_Reg), therefore the driver is a
+ * plain regmap client of the parent PMIC and never touches the SoC AFE MMIO.
+ *
+ * Sequence/source citations use the form "vendor:LINE" for
+ * sound/soc/mediatek/mt_soc_audio_v3/mt_soc_codec_63xx.c, "spk:LINE" for
+ * mt_soc_codec_speaker_63xx.c and "upmu:LINE" for
+ * drivers/misc/mediatek/include/mt-plat/mt6735/include/mach/upmu_hw.h.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mfd/mt6397/core.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <sound/jack.h>
+#include <sound/pcm.h>
+#include <sound/soc.h>
+#include <sound/soc-dapm.h>
+#include <sound/tlv.h>
+
+#include "mt6331.h"
+
+/* Vendor names (AudDrv_Def.h:273-295) */
+#define MT6331_CODEC_NAME		"mt-soc-codec"
+#define MT6331_TXDAI_NAME		"mt-soc-codec-tx-dai"
+#define MT6331_TXDAI2_NAME		"mt-soc-codec-tx-dai2"
+#define MT6331_RXDAI_NAME		"mt-soc-codec-rx-dai"
+#define MT6331_DL1_STREAM_NAME		"MultiMedia1_PLayback"
+#define MT6331_DL2_STREAM_NAME		"MultiMedia2_PLayback"
+#define MT6331_UL1_STREAM_NAME		"MultiMedia1_Capture"
+
+/* Vendor trim indexes (mt_soc_pcm_common.h:204-206) */
+#define MT6331_HP_TRIM_INDEX		8	/* 0 dB */
+#define MT6331_SPK_TRIM_INDEX		4	/* 6 dB */
+
+/* Vendor microphone bias reference, always programmed when a bias is enabled
+ * (vendor:3280 "MISBIAS0 = 1P9V", vendor:3287).
+ */
+#define MT6331_MICBIAS_VREF_DEFAULT	7
+
+/* Analog/digital block states, used to mirror the vendor driver's
+ * mAudio_Ana_DevicePower[] bookkeeping and to gate the shared "last user"
+ * power-down paths (vendor:203 GetDLStatus, vendor:3210 GetAdcStatus).
+ */
+#define MT6331_ST_DAC			BIT(0)
+#define MT6331_ST_ADC_SUPPLY		BIT(1)
+#define MT6331_ST_PGA_L			BIT(2)
+#define MT6331_ST_PGA_R			BIT(3)
+#define MT6331_ST_MICBIAS1		BIT(4)
+#define MT6331_ST_MICBIAS2		BIT(5)
+#define MT6331_ST_ADC			BIT(6)
+#define MT6331_ST_HP			BIT(7)
+#define MT6331_ST_EARPIECE		BIT(8)
+#define MT6331_ST_SPEAKER		BIT(9)
+
+#define MT6331_ST_OUTPUTS		(MT6331_ST_HP | MT6331_ST_EARPIECE | \
+					 MT6331_ST_SPEAKER)
+
+struct mt6331_priv {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *hp_depop;
+
+	/* Serializes the analog sequences (vendor Ana_Ctrl_Mutex). */
+	struct mutex ana_lock;
+	/* Vendor ClsqCount / TopCkCount / NvRegCount counters. */
+	struct mutex clk_lock;		/* vendor Ana_Clk_Mutex (TopCk + NvReg) */
+	struct mutex clksq_lock;	/* vendor AudAna_lock (ClsqEnable) */
+	unsigned int clksq_users;
+	unsigned int topck_users;
+	unsigned int audglb_users;
+
+	unsigned int state;		/* MT6331_ST_* */
+	unsigned int suspend_state;	/* saved on suspend */
+
+	unsigned int dl_rate;		/* vendor mBlockSampleRate[OUT_DAC] */
+	unsigned int ul_rate;		/* vendor mBlockSampleRate[IN_ADC] */
+
+	unsigned int micbias_ref;	/* vendor MicbiasRef */
+	bool micbias_ref_saved;		/* vendor GetMicbias */
+	bool headset_mic;		/* jack reports a headset microphone */
+	unsigned int mic_gain;		/* vendor mAudio_Ana_Volume[MICAMPx] */
+
+	struct snd_soc_jack *jack;
+	struct notifier_block jack_nb;
+};
+
+static int mt6331_ana_write(struct mt6331_priv *priv, unsigned int reg,
+			    unsigned int val, unsigned int mask)
+{
+	/* Identical to the vendor Ana_Set_Reg() read-modify-write. */
+	return regmap_update_bits(priv->regmap, reg, mask, val);
+}
+
+/* ------------------------------------------------------------------ */
+/* Reference counted PMIC clocks / global block (vendor:276-381)      */
+/* ------------------------------------------------------------------ */
+
+static int mt6331_clksq_enable(struct mt6331_priv *priv, bool enable)
+{
+	int ret = 0;
+
+	mutex_lock(&priv->clksq_lock);
+	if (enable) {
+		if (priv->clksq_users == 0) {
+			/* vendor:318 ClsqEnable: enable CLKSQ 26MHz and its
+			 * source clock.
+			 */
+			ret = mt6331_ana_write(priv, MT6328_TOP_CLKSQ,
+					       RG_CLKSQ_EN_AUD,
+					       RG_CLKSQ_EN_AUD);
+			if (!ret)
+				ret = mt6331_ana_write(priv,
+						       MT6328_TOP_CLKSQ_SET,
+						       RG_CLKSQ_EN_AUD,
+						       RG_CLKSQ_EN_AUD);
+		}
+		priv->clksq_users++;
+	} else {
+		if (priv->clksq_users)
+			priv->clksq_users--;
+		if (priv->clksq_users == 0) {
+			/* vendor:322-324 */
+			ret = mt6331_ana_write(priv, MT6328_TOP_CLKSQ_CLR,
+					       RG_CLKSQ_EN_AUD,
+					       RG_CLKSQ_EN_AUD);
+			if (!ret)
+				ret = mt6331_ana_write(priv, MT6328_TOP_CLKSQ,
+						       0, RG_CLKSQ_EN_AUD);
+		}
+	}
+	mutex_unlock(&priv->clksq_lock);
+
+	return ret;
+}
+
+static int mt6331_topck_enable(struct mt6331_priv *priv, bool enable)
+{
+	int ret = 0;
+
+	mutex_lock(&priv->clk_lock);
+	if (enable) {
+		if (priv->topck_users == 0) {
+			/* vendor:283: AUDNCP clock divider engine clock +
+			 * AUD 26M clock.
+			 */
+			ret = mt6331_ana_write(priv, MT6328_TOP_CKPDN_CON0_CLR,
+					       RG_AUD_CLK_GRP_VENDOR,
+					       RG_AUD_CLK_GRP_VENDOR);
+		}
+		priv->topck_users++;
+	} else {
+		if (priv->topck_users)
+			priv->topck_users--;
+		if (priv->topck_users == 0)
+			/* vendor:288 */
+			ret = mt6331_ana_write(priv, MT6328_TOP_CKPDN_CON0_SET,
+					       RG_AUD_CLK_GRP_VENDOR,
+					       RG_AUD_CLK_GRP_VENDOR);
+	}
+	mutex_unlock(&priv->clk_lock);
+
+	return ret;
+}
+
+static int mt6331_audglb_enable(struct mt6331_priv *priv, bool enable)
+{
+	int ret = 0;
+
+	mutex_lock(&priv->clk_lock);
+	if (enable) {
+		if (priv->audglb_users == 0)
+			/* vendor:369 NvregEnable: clear AUDGLB power down */
+			ret = mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON8, 0,
+					       RG_AUDGLB_PWRDN_VA28);
+		priv->audglb_users++;
+	} else {
+		if (priv->audglb_users)
+			priv->audglb_users--;
+		if (priv->audglb_users == 0)
+			/* vendor:373 */
+			ret = mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON8,
+					       RG_AUDGLB_PWRDN_VA28,
+					       RG_AUDGLB_PWRDN_VA28);
+	}
+	mutex_unlock(&priv->clk_lock);
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Downlink interface rate (vendor:1581 GetDLNewIFFrequency)          */
+/* ------------------------------------------------------------------ */
+static unsigned int mt6331_dl_if_freq(unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return 0;
+	case 11025:
+		return 1;
+	case 12000:
+		return 2;
+	case 16000:
+		return 3;
+	case 22050:
+		return 4;
+	case 24000:
+		return 5;
+	case 32000:
+		return 6;
+	case 44100:
+		return 7;
+	case 48000:
+	default:
+		return 8;
+	}
+}
+
+/* Uplink sample rate field (vendor:1290 ULSampleRateTransform) */
+static unsigned int mt6331_ul_rate_sel(unsigned int rate)
+{
+	switch (rate) {
+	case 16000:
+		return 1;
+	case 32000:
+		return 2;
+	case 48000:
+		return 3;
+	case 8000:
+	default:
+		return 0;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Downlink digital path (vendor:1618 TurnOnDacPower)                 */
+/* ------------------------------------------------------------------ */
+static int mt6331_dl_power_up(struct mt6331_priv *priv)
+{
+	int ret;
+
+	ret = mt6331_clksq_enable(priv, true);
+	if (ret)
+		return ret;
+	ret = mt6331_topck_enable(priv, true);
+	if (ret)
+		return ret;
+	udelay(250);
+	ret = mt6331_audglb_enable(priv, true);
+	if (ret)
+		return ret;
+
+	/* vendor:1628-1631 */
+	mt6331_ana_write(priv, MT6328_AFE_AUDIO_TOP_CON0,
+			 (priv->state & MT6331_ST_ADC) ? 0x0000 : 0x003a,
+			 0xffff);
+	/* vendor:1634-1637 */
+	mt6331_ana_write(priv, MT6328_AFUNC_AUD_CON2, 0x0006, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFUNC_AUD_CON0, 0xc3a1, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFUNC_AUD_CON2, 0x0003, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFUNC_AUD_CON2, 0x000b, 0xffff);
+	/* vendor:1638-1640 */
+	mt6331_ana_write(priv, MT6328_AFE_DL_SDM_CON1, 0x001e, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFE_UL_DL_CON0, 0x0001, 0xffff);
+	/* vendor:1641-1646 */
+	mt6331_ana_write(priv, MT6328_AFE_PMIC_NEWIF_CFG0,
+			 (mt6331_dl_if_freq(priv->dl_rate) <<
+			  RG_DL_IF_FREQ_SHIFT) | 0x0330, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFE_DL_SRC2_CON0_H,
+			 (mt6331_dl_if_freq(priv->dl_rate) <<
+			  RG_DL_IF_FREQ_SHIFT) | 0x0300, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFE_DL_SRC2_CON0_L, 0x0001, 0xffff);
+	/* vendor:1648 */
+	mt6331_ana_write(priv, MT6328_PMIC_AFE_TOP_CON0, 0x0000, 0xffff);
+
+	priv->state |= MT6331_ST_DAC;
+
+	return 0;
+}
+
+static int mt6331_dl_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_DAC;
+
+	/* vendor:1654-1664 TurnOffDacPower */
+	mt6331_ana_write(priv, MT6328_AFE_DL_SRC2_CON0_L, 0x0000, 0xffff);
+	if (!(priv->state & MT6331_ST_ADC))
+		mt6331_ana_write(priv, MT6328_AFE_UL_DL_CON0, 0x0000, 0xffff);
+
+	udelay(250);
+
+	mt6331_ana_write(priv, MT6328_AFE_AUDIO_TOP_CON0, 0x0040, 0x0040);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON0, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON1, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON3, 0x0001, 0xffff);
+
+	mt6331_audglb_enable(priv, false);
+	mt6331_clksq_enable(priv, false);
+	mt6331_topck_enable(priv, false);
+
+	return 0;
+}
+
+/*
+ * Shared analog part of the downlink amplifiers: NCP clock generation, the
+ * cap-less LDOs and the negative voltage regulator (vendor:1749-1778 for the
+ * headphone/speaker values, vendor:1934-1963 for the earpiece values, which
+ * use 0x0A40/0x2AC0 and ZCD_CON0 = 0 instead).
+ */
+static int mt6331_dl_analog_up(struct mt6331_priv *priv, bool va33refgen,
+			       unsigned int zcd_con0)
+{
+	/* vendor:1749-1756 */
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON1, 0x0001, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON2, 0x002b, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON0, 0x0001, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON4, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON3, 0x0000, 0xffff);
+	/* vendor:1757-1778: cap-less HC/LC LDO (1.5V) + NV regulator (-1.5V) */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6,
+			 va33refgen ? 0x0a41 : 0x0a40,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6,
+			 va33refgen ? 0x2ac1 : 0x2ac0,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x8000,
+			 RG_NVREG_EN_VAUDP15);
+	mt6331_ana_write(priv, MT6328_ZCD_CON0, zcd_con0, 0xffff);
+
+	return 0;
+}
+
+/* vendor:1834-1849 (headphone), vendor:1965-1976 (earpiece),
+ * vendor:2104-2119 (speaker): the shared teardown when the last
+ * downlink output powers down.
+ */
+static int mt6331_dl_analog_down(struct mt6331_priv *priv)
+{
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON4, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac0,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x0000,
+			 RG_NVREG_EN_VAUDP15);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0001,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+
+	return 0;
+}
+
+/* vendor:1673-1703 HeadsetVoloumeRestore / vendor:1705-1732
+ * HeadsetVoloumeSet: the vendor ramps the zero-cross-detect gain one step at
+ * a time.  It keeps a single volume for both channels; here the left and
+ * right targets are ramped independently in the same step sequence.
+ */
+static void mt6331_hp_volume_ramp(struct mt6331_priv *priv, unsigned int l,
+				  unsigned int r)
+{
+	unsigned int val, cl, cr;
+
+	if (regmap_read(priv->regmap, MT6328_ZCD_CON2, &val))
+		return;
+	cl = val & RG_AUDHPLGAIN_MASK;
+	cr = (val >> RG_AUDHPRGAIN_SHIFT) & RG_AUDHPRGAIN_MASK;
+
+	while (cl != l || cr != r) {
+		if (cl < l)
+			cl++;
+		else if (cl > l)
+			cl--;
+		if (cr < r)
+			cr++;
+		else if (cr > r)
+			cr--;
+		mt6331_ana_write(priv, MT6328_ZCD_CON2,
+				 (cr << RG_AUDHPRGAIN_SHIFT) | cl, 0xf9f);
+		udelay(200);
+	}
+}
+
+/* Headphone depop pin: vendor:383 HP_Ana_Switch_to_On() drives the
+ * "hpdepop" pinctrl output low while the amplifier settles, and
+ * vendor:409 HP_Ana_Switch_to_Release() drives it high afterwards.
+ */
+static void mt6331_hp_depop(struct mt6331_priv *priv, bool switch_to_ground)
+{
+	if (!priv->hp_depop)
+		return;
+
+	gpiod_set_value_cansleep(priv->hp_depop, switch_to_ground ? 0 : 1);
+	usleep_range(10000, 11000);	/* vendor:404 / vendor:414 */
+}
+
+/* vendor:1734-1826 Audio_Amp_Change(..., true) */
+static int mt6331_hp_power_up(struct mt6331_priv *priv)
+{
+	unsigned int val, hp_l, hp_r;
+
+	/* The de-pop sequence drives both HP gains to the minimum; keep the
+	 * user volume (vendor mAudio_Ana_Volume[HPOUTL/R]) and restore it.
+	 */
+	if (regmap_read(priv->regmap, MT6328_ZCD_CON2, &val))
+		return -EIO;
+	hp_l = val & RG_AUDHPLGAIN_MASK;
+	hp_r = (val >> RG_AUDHPRGAIN_SHIFT) & RG_AUDHPRGAIN_MASK;
+
+	mt6331_hp_depop(priv, true);
+	mt6331_dl_analog_up(priv, true, 0x0400);
+	/* vendor:1786-1790 */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe080, 0xffff);
+	/* vendor:1792 IBIST */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac0,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	/* vendor:1794-1796 HP & HS driver bias circuit */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON4, 0x0700, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON5, 0x5490, 0xffff);
+	udelay(50);
+	/* vendor:1798-1812 */
+	mt6331_ana_write(priv, MT6328_ZCD_CON2, 0x0f9f, 0xffff);
+	mt6331_ana_write(priv, MT6328_ZCD_CON3, 0x001f, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x0480, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x1480, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe090, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x14a0, 0xffff);
+	udelay(50);
+	/* vendor:1813-1816 */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac2,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe09f, 0xffff);
+
+	/* vendor:1818-1824: DAC gain, HP mux to the audio DAC, drivers on */
+	mt6331_hp_volume_ramp(priv, MT6331_HP_TRIM_INDEX,
+			      MT6331_HP_TRIM_INDEX);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xf49f, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xf4ff, 0xffff);
+	udelay(50);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x1480, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x0480, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xf46f, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON4, 0x0300, 0xffff);
+
+	/* vendor:1820-1822 restore the user volume, then release the switch */
+	mt6331_hp_volume_ramp(priv, hp_l, hp_r);
+	mt6331_hp_depop(priv, false);
+
+	priv->state |= MT6331_ST_HP;
+
+	return 0;
+}
+
+/* vendor:1828-1862 Audio_Amp_Change(..., false) */
+static int mt6331_hp_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_HP;
+
+	mt6331_hp_depop(priv, true);
+	mt6331_hp_volume_ramp(priv, MT6331_HP_TRIM_INDEX,
+			      MT6331_HP_TRIM_INDEX);
+	/* vendor:1837 disable HPR/HPL */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xf40f, 0xffff);
+
+	if (!(priv->state & MT6331_ST_OUTPUTS))
+		mt6331_dl_analog_down(priv);
+
+	return 0;
+}
+
+/* vendor:1925-1999 Voice_Amp_Change (earpiece) */
+static int mt6331_earpiece_power_up(struct mt6331_priv *priv)
+{
+	unsigned int val, hs_gain;
+
+	/* The voice power sequence below drives the handset gain to the
+	 * minimum and then to +8 dB (vendor:1988-1997), which would discard
+	 * the user setting of the "Earpiece Volume" control; keep it and
+	 * apply it again once the driver is up.
+	 */
+	if (regmap_read(priv->regmap, MT6328_ZCD_CON3, &val))
+		return -EIO;
+	hs_gain = val & RG_AUDHSGAIN_MASK;
+
+	mt6331_dl_analog_up(priv, false, 0x0000);
+	/* vendor:1965-1976 */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe080, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac0,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON4, 0x0400, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON5, 0x5490, 0xffff);
+	udelay(50);
+	mt6331_ana_write(priv, MT6328_ZCD_CON3, 0x001f, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x1000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac2,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe089, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe109, 0xffff);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe119, 0xffff);
+	udelay(50);
+	/* vendor:1997 HS gain (+8 dB) after the driver is up */
+	mt6331_ana_write(priv, MT6328_ZCD_CON3, 0x0000, 0xffff);
+	/* restore the user volume */
+	mt6331_ana_write(priv, MT6328_ZCD_CON3, hs_gain, RG_AUDHSGAIN_MASK);
+
+	priv->state |= MT6331_ST_EARPIECE;
+
+	return 0;
+}
+
+static int mt6331_earpiece_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_EARPIECE;
+
+	/* vendor:2003 disable the voice driver */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe109, 0xffff);
+
+	if (!(priv->state & MT6331_ST_OUTPUTS))
+		mt6331_dl_analog_down(priv);
+
+	return 0;
+}
+
+/* vendor:569-604 Apply_Speaker_Gain: ramp the internal speaker PGA */
+static void mt6331_speaker_gain_apply(struct mt6331_priv *priv,
+				      unsigned int target)
+{
+	unsigned int val, cur;
+
+	if (regmap_read(priv->regmap, MT6328_SPK_ANA_CON0, &val))
+		return;
+	cur = (val & (RG_SPKPGA_GAIN_MASK << RG_SPKPGA_GAIN_SHIFT)) >>
+		RG_SPKPGA_GAIN_SHIFT;
+
+	while (cur != target) {
+		usleep_range(200, 300);
+		if (target > cur)
+			cur++;
+		else
+			cur--;
+		mt6331_ana_write(priv, MT6328_SPK_ANA_CON0,
+				 cur << RG_SPKPGA_GAIN_SHIFT,
+				 RG_SPKPGA_GAIN_MASK << RG_SPKPGA_GAIN_SHIFT);
+	}
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON0,
+			 target << RG_SPKPGA_GAIN_SHIFT,
+			 RG_SPKPGA_GAIN_MASK << RG_SPKPGA_GAIN_SHIFT);
+}
+
+/* spk:75-117 Speaker_ClassD_Open */
+static int mt6331_speaker_classd_up(struct mt6331_priv *priv)
+{
+	unsigned int val;
+
+	/* spk:81-86 speaker offset trim + class D mode */
+	mt6331_ana_write(priv, MT6328_SPK_CON7, 0x4531, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3008, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON13, 0x1800, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON2, 0x04a4, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON0,
+			 MT6331_SPK_TRIM_INDEX << RG_SPKPGA_GAIN_SHIFT,
+			 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON9, 0x2000, 0xffff);
+	/* spk:91 turn the speaker on, spk:93 Vcm high-PSRR mode */
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3009, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON9, 0x0a00, 0xffff);
+
+	msleep(10);		/* spk:95-96 trim settling time */
+
+	/* spk:101 trim off, spk:103 clock back to triangular wave */
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3001, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON13, 0x0000, 0xffff);
+
+	/* spk:105-110 the vendor only logs the trim result */
+	if (!regmap_read(priv->regmap, MT6328_SPK_CON1, &val))
+		dev_dbg(priv->dev, "speaker trim raw 0x%04x%s\n", val,
+			(val & 0x8000) ? "" : " (trim failed)");
+
+	/* spk:112-117 0 dB amplifier gain, trim disabled */
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3001, 0xffff);
+
+	return 0;
+}
+
+/* spk:119-130 Speaker_ClassD_close */
+static int mt6331_speaker_classd_down(struct mt6331_priv *priv)
+{
+	mt6331_ana_write(priv, MT6328_SPK_CON9, 0x2a00, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON0,
+			 MT6331_SPK_TRIM_INDEX << RG_SPKPGA_GAIN_SHIFT,
+			 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3001, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_CON0, 0x3000, 0xffff);
+
+	return 0;
+}
+
+/* vendor:2030-2126 Speaker_Amp_Change (internal class-D speaker) */
+static int mt6331_speaker_power_up(struct mt6331_priv *priv)
+{
+	unsigned int val, gain;
+
+	/* Keep the user speaker gain: Speaker_ClassD_Open() below rewrites
+	 * SPK_ANA_CON0 with the trim level (spk:85).
+	 */
+	if (regmap_read(priv->regmap, MT6328_SPK_ANA_CON0, &val))
+		return -EIO;
+	gain = (val & (RG_SPKPGA_GAIN_MASK << RG_SPKPGA_GAIN_SHIFT)) >>
+		RG_SPKPGA_GAIN_SHIFT;
+	if (!gain)
+		gain = MT6331_SPK_TRIM_INDEX;
+
+	mt6331_dl_analog_up(priv, true, 0x0000);
+	/* vendor:2085-2100 */
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac0,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac2,
+			 RG_AUDDEC_ANA_CON6_SPK_MASK);
+	mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0x0009, 0x0009);
+	mt6331_ana_write(priv, MT6328_ZCD_CON0, 0x0400, 0xffff);
+	mt6331_ana_write(priv, MT6328_ZCD_CON4, 0x0505, 0xffff);
+	/* vendor:2101-2104 IV buffer mux + enable */
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON3, 0x0100, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON3, 0x0110, 0xffff);
+	/* vendor:2106 class-AB/D clock */
+	mt6331_ana_write(priv, MT6328_TOP_CKPDN_CON2_CLR, RG_SPK_CK_GRP,
+			 RG_SPK_CK_GRP);
+
+	mt6331_speaker_classd_up(priv);
+	mt6331_speaker_gain_apply(priv, gain);
+
+	priv->state |= MT6331_ST_SPEAKER;
+
+	return 0;
+}
+
+static int mt6331_speaker_power_down(struct mt6331_priv *priv)
+{
+	priv->state &= ~MT6331_ST_SPEAKER;
+
+	/* vendor:2128-2136: the vendor grounds the de-pop switch first */
+	mt6331_hp_depop(priv, true);
+	mt6331_speaker_classd_down(priv);
+
+	mt6331_ana_write(priv, MT6328_TOP_CKPDN_CON2_SET, RG_SPK_CK_GRP,
+			 RG_SPK_CK_GRP);
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON3, 0x0100, 0xffff);
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON3, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_ZCD_CON4, 0x0505, 0xffff);
+	usleep_range(1000, 2000);	/* vendor:2140 */
+
+	if (!(priv->state & MT6331_ST_OUTPUTS))
+		mt6331_dl_analog_down(priv);
+
+	return 0;
+}
