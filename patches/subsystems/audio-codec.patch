+/* ------------------------------------------------------------------ */
+/* DAI                                                                */
+/* ------------------------------------------------------------------ */
+static int mt6331_dai_hw_params(struct snd_pcm_substream *substream,
+				struct snd_pcm_hw_params *params,
+				struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *cmpnt = dai->component;
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int rate = params_rate(params);
+
+	switch (rate) {
+	case 8000:
+	case 11025:
+	case 12000:
+	case 16000:
+	case 22050:
+	case 24000:
+	case 32000:
+	case 44100:
+	case 48000:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	mutex_lock(&priv->ana_lock);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		priv->dl_rate = rate;
+		/* vendor:1641-1646: downlink interface / SDM rate */
+		mt6331_ana_write(priv, MT6328_AFE_PMIC_NEWIF_CFG0,
+				 (mt6331_dl_if_freq(rate) <<
+				  RG_DL_IF_FREQ_SHIFT) | 0x0330, 0xffff);
+		mt6331_ana_write(priv, MT6328_AFE_DL_SRC2_CON0_H,
+				 (mt6331_dl_if_freq(rate) <<
+				  RG_DL_IF_FREQ_SHIFT) | 0x0300, 0xffff);
+	} else {
+		priv->ul_rate = rate;
+		/* vendor:3386-3389: uplink sample rate and mode */
+		mt6331_ana_write(priv, MT6328_AFE_UL_SRC0_CON0_H,
+				 (mt6331_ul_rate_sel(rate) << 3) |
+				 (mt6331_ul_rate_sel(rate) << 1),
+				 RG_UL_RATE_MASK);
+	}
+
+	mutex_unlock(&priv->ana_lock);
+
+	return 0;
+}
