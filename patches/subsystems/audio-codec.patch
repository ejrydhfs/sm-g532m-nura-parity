--- /dev/null
+++ b/sound/soc/codecs/mt6331.h
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MT6328 PMIC audio codec (MT6735 / MT6737)
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream:
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_codec_63xx.c
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_codec_speaker_63xx.c
+ *   sound/soc/mediatek/mt_soc_audio_v3/AudDrv_Ana.{c,h}
+ *
+ * Register addresses and bit fields are the MT6328 audio register map from
+ *   drivers/misc/mediatek/include/mt-plat/mt6735/include/mach/upmu_hw.h
+ * (line numbers cited per register), and the PMIC "AFE" digital block that the
+ * vendor codec driver programs through pwrap (AudDrv_Ana.h:70-101).
+ *
+ * NAMING: the vendor driver that owns these registers is called "mt6331"
+ * (ROM symbols mt6331_codec_probe, mt6331_read, mt6331_write; the
+ * of_compatible in 3.18 was "mediatek,mt_soc_codec_63xx"), but the PMIC
+ * populated on MT6737T/grandpplte is an MT6328 and it is the MT6328 audio
+ * register map that the driver programs.  No MT6331 register map exists in
+ * this driver and none must be added.
+ */
+#ifndef __SND_SOC_MT6331_H
+#define __SND_SOC_MT6331_H
+
+/* ------------------------------------------------------------------ */
+/* PMIC top level clock registers (upmu_hw.h:83-127)                  */
+/* ------------------------------------------------------------------ */
+#define MT6328_TOP_CKPDN_CON0_SET	0x023e	/* upmu_hw.h:84 */
+#define MT6328_TOP_CKPDN_CON0_CLR	0x0240	/* upmu_hw.h:85 */
+#define MT6328_TOP_CKPDN_CON2_SET	0x024a	/* upmu_hw.h:90 */
+#define MT6328_TOP_CKPDN_CON2_CLR	0x024c	/* upmu_hw.h:91 */
+#define MT6328_TOP_CLKSQ		0x028a	/* upmu_hw.h:122 */
+#define MT6328_TOP_CLKSQ_SET		0x028c	/* upmu_hw.h:123 */
+#define MT6328_TOP_CLKSQ_CLR		0x028e	/* upmu_hw.h:124 */
+
+/* AUDNCP / AUDIF / AUD 26M engine clocks (upmu_hw.h:1784-1793) */
+#define RG_AUDNCP_CK_PDN		BIT(12)
+#define RG_AUDIF_CK_PDN			BIT(13)
+#define RG_AUD_CK_PDN			BIT(14)
+/*
+ * The three audio engine clocks switched by the vendor driver
+ * (mt_soc_codec_63xx.c:283 TOP_CKPDN_CON0_CLR 0x7000).  The probe-time
+ * sequence uses a different group including the AUXADC 26M clock
+ * (mt_soc_codec_63xx.c:4981 TOP_CKPDN_CON0_SET 0x3800).
+ */
+#define RG_AUD_CLK_GRP_VENDOR		(RG_AUDNCP_CK_PDN | RG_AUDIF_CK_PDN | \
+					 RG_AUD_CK_PDN)
+#define RG_AUD_CLK_GRP_INIT		(BIT(11) | RG_AUDNCP_CK_PDN | \
+					 RG_AUDIF_CK_PDN)
+
+/* TOP_CLKSQ bit 0: 26MHz clock squarer for the audio block (upmu_hw.h:2267) */
+#define RG_CLKSQ_EN_AUD			BIT(0)
+
+/* TOP_CKPDN_CON2 bits 0/1: internal speaker class-D / PWM clock (upmu_hw.h:1844) */
+#define RG_SPK_CK_GRP			(BIT(0) | BIT(1))
+
+/* ------------------------------------------------------------------ */
+/* Impedance / zero-cross detect block (upmu_hw.h:370-375)            */
+/* ------------------------------------------------------------------ */
+#define MT6328_ZCD_CON0			0x0800
+#define MT6328_ZCD_CON2			0x0804
+#define MT6328_ZCD_CON3			0x0806
+#define MT6328_ZCD_CON4			0x0808
+
+/* upmu_hw.h:4361-4369 */
+#define RG_AUDHPLGAIN_MASK		0x1f
+#define RG_AUDHPLGAIN_SHIFT		0
+#define RG_AUDHPRGAIN_MASK		0x1f
+#define RG_AUDHPRGAIN_SHIFT		7
+#define RG_AUDHSGAIN_MASK		0x1f
+#define RG_AUDHSGAIN_SHIFT		0
+
+/* ------------------------------------------------------------------ */
+/* Speaker amplifier (upmu_hw.h:464-483)                              */
+/* ------------------------------------------------------------------ */
+#define MT6328_SPK_CON0			0x0a90
+#define MT6328_SPK_CON1			0x0a92
+#define MT6328_SPK_CON2			0x0a94
+#define MT6328_SPK_CON7			0x0a9e
+#define MT6328_SPK_CON9			0x0aa2
+#define MT6328_SPK_CON13			0x0aaa
+#define MT6328_SPK_ANA_CON0		0x0ab2
+#define MT6328_SPK_ANA_CON3		0x0ab6
+
+/* upmu_hw.h:6155-6157 */
+#define RG_SPKPGA_GAIN_MASK		0xf
+#define RG_SPKPGA_GAIN_SHIFT		11
+
+/* ------------------------------------------------------------------ */
+/* Audio LDO (upmu_hw.h has no symbolic name; AudDrv_Ana.h:383)       */
+/* ------------------------------------------------------------------ */
+#define MT6328_LDO_CON2			0x0a04
+
+/* ------------------------------------------------------------------ */
+/* Decoder analog block (upmu_hw.h:594-602)                           */
+/* ------------------------------------------------------------------ */
+#define MT6328_AUDDEC_ANA_CON0		0x0cdc
+#define MT6328_AUDDEC_ANA_CON1		0x0cde
+#define MT6328_AUDDEC_ANA_CON4		0x0ce4
+#define MT6328_AUDDEC_ANA_CON5		0x0ce6
+#define MT6328_AUDDEC_ANA_CON6		0x0ce8
+#define MT6328_AUDDEC_ANA_CON7		0x0cea
+#define MT6328_AUDDEC_ANA_CON8		0x0cec
+
+/* upmu_hw.h:6893: 1 = audio global block powered down */
+#define RG_AUDGLB_PWRDN_VA28		BIT(1)
+/* upmu_hw.h:6884-6887: NV regulator (-1.5V) enable */
+#define RG_NVREG_EN_VAUDP15		BIT(15)
+/*
+ * Vendor mask for the shared LDO/clock register: bits 2/4/8 belong to the
+ * encoder path and are never rewritten by the decoder sequences
+ * (mt_soc_codec_63xx.c:1757 "AUDDEC_ANA_CON6 0x0A41 mask 0xfeeb").
+ */
+#define RG_AUDDEC_ANA_CON6_SPK_MASK	0xfeeb
+
+/* ------------------------------------------------------------------ */
+/* Encoder analog block (upmu_hw.h:603-613)                           */
+/* ------------------------------------------------------------------ */
+#define MT6328_AUDENC_ANA_CON0		0x0cee
+#define MT6328_AUDENC_ANA_CON1		0x0cf0
+#define MT6328_AUDENC_ANA_CON3		0x0cf4
+#define MT6328_AUDENC_ANA_CON4		0x0cf6
+#define MT6328_AUDENC_ANA_CON6		0x0cfa
+#define MT6328_AUDENC_ANA_CON9		0x0d00
+#define MT6328_AUDENC_ANA_CON10		0x0d02
+
+/* upmu_hw.h:7005 / 7016: preamplifier input select on the left channel */
+#define RG_AUDPREAMPLINPUTSEL_MASK	(0x3 << 6)
+#define RG_AUDPREAMPLINPUTSEL_AIN0	(0x1 << 6)	/* main mic */
+#define RG_AUDPREAMPLINPUTSEL_AIN1	(0x2 << 6)	/* headset mic */
+
+/* upmu_hw.h:7091-7123: microphone bias control (AUDENC_ANA_CON9) */
+#define RG_AUDPWDBMICBIAS0		BIT(0)
+#define RG_AUDMICBIAS0DCC_MASK		(0x3 << 1)
+#define RG_AUDPWDBMICBIAS1		BIT(4)
+#define RG_AUDMICBIAS1DCC_MASK		(0x3 << 5)
+#define RG_AUDMICBIASVREF_MASK		(0x7 << 8)
+#define RG_AUDMICBIASVREF_SHIFT		8
+
+/* upmu_hw.h:7124-7129: microphone preamplifier gain (AUDENC_ANA_CON10) */
+#define RG_AUDPREAMPLGAIN_MASK		0x7
+#define RG_AUDPREAMPLGAIN_SHIFT		0
+#define RG_AUDPREAMPRGAIN_MASK		0x7
+#define RG_AUDPREAMPRGAIN_SHIFT		4
+
+/* ------------------------------------------------------------------ */
+/* NCP clock divider (upmu_hw.h:614-618)                              */
+/* ------------------------------------------------------------------ */
+#define MT6328_AUDNCP_CLKDIV_CON0	0x0d04
+#define MT6328_AUDNCP_CLKDIV_CON1	0x0d06
+#define MT6328_AUDNCP_CLKDIV_CON2	0x0d08
+#define MT6328_AUDNCP_CLKDIV_CON3	0x0d0a
+#define MT6328_AUDNCP_CLKDIV_CON4	0x0d0c
+
+/* ------------------------------------------------------------------ */
+/* PMIC AFE digital block (AudDrv_Ana.h:70-101, base 0x2000)          */
+/* These are PMIC registers reached over pwrap, not SoC MMIO.         */
+/* ------------------------------------------------------------------ */
+#define MT6328_AFE_UL_DL_CON0		0x2000	/* AudDrv_Ana.h:70 */
+#define MT6328_AFE_DL_SRC2_CON0_H	0x2002	/* AudDrv_Ana.h:71 */
+#define MT6328_AFE_DL_SRC2_CON0_L	0x2004	/* AudDrv_Ana.h:72 */
+#define MT6328_AFE_DL_SDM_CON1		0x2008	/* AudDrv_Ana.h:74 */
+#define MT6328_AFE_UL_SRC0_CON0_H	0x200a	/* AudDrv_Ana.h:75 */
+#define MT6328_AFE_UL_SRC0_CON0_L	0x200c	/* AudDrv_Ana.h:76 */
+#define MT6328_PMIC_AFE_TOP_CON0	0x2012	/* AudDrv_Ana.h:79 */
+#define MT6328_AFE_AUDIO_TOP_CON0	0x2014	/* AudDrv_Ana.h:80 */
+#define MT6328_AFUNC_AUD_CON0		0x201c	/* AudDrv_Ana.h:84 */
+#define MT6328_AFUNC_AUD_CON2		0x2020	/* AudDrv_Ana.h:86 */
+#define MT6328_AFE_PMIC_NEWIF_CFG0	0x2038	/* AudDrv_Ana.h:98 */
+#define MT6328_AFE_PMIC_NEWIF_CFG2	0x203c	/* AudDrv_Ana.h:100 */
+
+/* Downlink interface rate field, bits 12-15 (mt_soc_codec_63xx.c:1641) */
+#define RG_DL_IF_FREQ_SHIFT		12
+/* Uplink rate / mode field, bits 0-4 (mt_soc_codec_63xx.c:3386) */
+#define RG_UL_RATE_MASK			0x1f
+
+#endif /* __SND_SOC_MT6331_H */
