+/* ------------------------------------------------------------------ */
+/* Jack                                                               */
+/* ------------------------------------------------------------------ */
+/*
+ * The vendor driver selects the headset microphone path (AIN1 plus the
+ * second microphone bias) from the accessory detection result, through the
+ * Audio_MicSource1_Setting control and TurnOnADcPowerACC()'s headset
+ * branches (vendor:3285-3288, vendor:3335-3337).  Here the accessory
+ * detection driver reports jack status and the codec follows it.
+ */
+static void mt6331_headset_mic_set(struct mt6331_priv *priv, bool on)
+{
+	bool pga_on;
+
+	priv->headset_mic = on;
+
+	mutex_lock(&priv->ana_lock);
+	pga_on = priv->state & MT6331_ST_PGA_L;
+
+	if (on) {
+		/* second microphone bias on, vendor:3287 */
+		mt6331_micbias_set(priv, true, true);
+		if (pga_on) {
+			/* vendor:3335-3337 headset microphone path */
+			mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0,
+					 0x0500, 0xffff);
+			mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0,
+					 0x0581, 0xffff);
+		} else {
+			mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0,
+					 RG_AUDPREAMPLINPUTSEL_AIN1,
+					 RG_AUDPREAMPLINPUTSEL_MASK);
+		}
+	} else {
+		mt6331_micbias_set(priv, true, false);
+		if (pga_on) {
+			/* vendor:3329-3331 main microphone path */
+			mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0,
+					 0x0041, 0x00c1);
+			mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0,
+					 0x0541, 0xffff);
+		} else {
+			mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON0,
+					 RG_AUDPREAMPLINPUTSEL_AIN0,
+					 RG_AUDPREAMPLINPUTSEL_MASK);
+		}
+	}
+	mutex_unlock(&priv->ana_lock);
+}
+
+static int mt6331_jack_notify(struct notifier_block *nb, unsigned long status,
+			      void *data)
+{
+	struct mt6331_priv *priv = container_of(nb, struct mt6331_priv,
+						jack_nb);
+	bool mic = status & SND_JACK_MICROPHONE;
+
+	if (mic != priv->headset_mic)
+		mt6331_headset_mic_set(priv, mic);
+
+	return NOTIFY_OK;
+}
+
+static int mt6331_set_jack(struct snd_soc_component *cmpnt,
+			   struct snd_soc_jack *jack, void *data)
+{
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	if (priv->jack) {
+		snd_soc_jack_notifier_unregister(priv->jack, &priv->jack_nb);
+		priv->jack = NULL;
+	}
+
+	if (!jack) {
+		if (priv->headset_mic)
+			mt6331_headset_mic_set(priv, false);
+		return 0;
+	}
+
+	priv->jack = jack;
+	snd_soc_jack_notifier_register(jack, &priv->jack_nb);
+	mt6331_headset_mic_set(priv, jack->status & SND_JACK_MICROPHONE);
+
+	return 0;
+}
