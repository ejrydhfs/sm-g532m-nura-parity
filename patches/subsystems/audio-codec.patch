+/* ------------------------------------------------------------------ */
+/* Component                                                          */
+/* ------------------------------------------------------------------ */
+/* vendor:4970-4982 mt6331_codec_init_reg(); the ROM probe function
+ * (mt6331_codec_probe @ 0xc0864460-0xc08644bc) issues exactly these six
+ * read-modify-writes before calling InitCodecDefault @ 0xc08642d4.
+ */
+static int mt6331_codec_init_reg(struct mt6331_priv *priv)
+{
+	int ret;
+
+	/* Disable the CLKSQ 26 MHz clock. */
+	ret = mt6331_ana_write(priv, MT6328_TOP_CLKSQ, 0x0000,
+			       RG_CLKSQ_EN_AUD);
+	if (ret)
+		return ret;
+	/* Power down AUDGLB. */
+	ret = mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON8,
+			       RG_AUDGLB_PWRDN_VA28, RG_AUDGLB_PWRDN_VA28);
+	if (ret)
+		return ret;
+	/* Turn off the AUDNCP clock divider engine clock and AUD 26M. */
+	ret = mt6331_ana_write(priv, MT6328_TOP_CKPDN_CON0_SET,
+			       RG_AUD_CLK_GRP_INIT, RG_AUD_CLK_GRP_INIT);
+	if (ret)
+		return ret;
+	/* Disable headphone/voice short-circuit protection. */
+	ret = mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe000, 0xe000);
+	if (ret)
+		return ret;
+	/* Power off microphone bias 1. */
+	ret = mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0x0000,
+			       RG_AUDPWDBMICBIAS1);
+	if (ret)
+		return ret;
+	/* Reverse the PMIC clock. */
+	return mt6331_ana_write(priv, MT6328_AFE_PMIC_NEWIF_CFG2, 0x8000,
+				0x8000);
+}
+
+/* vendor:4975-4996 InitCodecDefault(): default volumes are MICAMP = 3
+ * (18 dB) and HPOUT = 8 (0 dB).
+ */
+static int mt6331_codec_defaults(struct mt6331_priv *priv)
+{
+	int ret;
+
+	priv->mic_gain = (3 << RG_AUDPREAMPRGAIN_SHIFT) | 3;
+
+	ret = mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON10,
+			       priv->mic_gain,
+			       RG_AUDPREAMPLGAIN_MASK |
+			       RG_AUDPREAMPRGAIN_MASK);
+	if (ret)
+		return ret;
+
+	return mt6331_ana_write(priv, MT6328_ZCD_CON2,
+				(MT6331_HP_TRIM_INDEX <<
+				 RG_AUDHPRGAIN_SHIFT) | MT6331_HP_TRIM_INDEX,
+				0xf9f);
+}
+
+static int mt6331_codec_probe(struct snd_soc_component *cmpnt)
+{
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	int ret;
+
+	snd_soc_component_init_regmap(cmpnt, priv->regmap);
+
+	ret = mt6331_codec_init_reg(priv);
+	if (ret) {
+		dev_err(priv->dev, "codec init sequence failed: %d\n", ret);
+		return ret;
+	}
+
+	ret = mt6331_codec_defaults(priv);
+	if (ret) {
+		dev_err(priv->dev, "codec defaults failed: %d\n", ret);
+		return ret;
+	}
+
+	dev_info(priv->dev, "MT6328 audio codec ready\n");
+
+	return 0;
+}
+
+static int mt6331_codec_suspend(struct snd_soc_component *cmpnt)
+{
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+
+	mutex_lock(&priv->ana_lock);
+
+	/* vendor:215-262 SetAnalogSuspend(true): remember every powered
+	 * block, then power the analog and digital paths down.
+	 */
+	priv->suspend_state = priv->state;
+
+	if (priv->state & MT6331_ST_ADC)
+		mt6331_adc_power_down(priv);
+	if (priv->state & MT6331_ST_PGA_R)
+		mt6331_pga_r_power_down(priv);
+	if (priv->state & MT6331_ST_PGA_L)
+		mt6331_pga_l_power_down(priv);
+	if (priv->state & MT6331_ST_MICBIAS2)
+		mt6331_micbias_set(priv, true, false);
+	if (priv->state & MT6331_ST_MICBIAS1)
+		mt6331_micbias_set(priv, false, false);
+	if (priv->state & MT6331_ST_ADC_SUPPLY)
+		mt6331_adc_supply_down(priv);
+	if (priv->state & MT6331_ST_SPEAKER)
+		mt6331_speaker_power_down(priv);
+	if (priv->state & MT6331_ST_EARPIECE)
+		mt6331_earpiece_power_down(priv);
+	if (priv->state & MT6331_ST_HP)
+		mt6331_hp_power_down(priv);
+	if (priv->state & MT6331_ST_DAC)
+		mt6331_dl_power_down(priv);
+
+	mutex_unlock(&priv->ana_lock);
+
+	return 0;
+}
+
+static int mt6331_codec_resume(struct snd_soc_component *cmpnt)
+{
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	unsigned int saved = priv->suspend_state;
+	int ret = 0;
+
+	mutex_lock(&priv->ana_lock);
+
+	/* vendor:242-262 SetAnalogSuspend(false): restore what was on. */
+	if (saved & MT6331_ST_DAC)
+		ret = mt6331_dl_power_up(priv);
+	if (!ret && (saved & MT6331_ST_HP))
+		ret = mt6331_hp_power_up(priv);
+	if (!ret && (saved & MT6331_ST_EARPIECE))
+		ret = mt6331_earpiece_power_up(priv);
+	if (!ret && (saved & MT6331_ST_SPEAKER))
+		ret = mt6331_speaker_power_up(priv);
+	if (!ret && (saved & MT6331_ST_ADC_SUPPLY))
+		ret = mt6331_adc_supply_up(priv);
+	if (!ret && (saved & MT6331_ST_MICBIAS1))
+		ret = mt6331_micbias_set(priv, false, true);
+	if (!ret && (saved & MT6331_ST_MICBIAS2))
+		ret = mt6331_micbias_set(priv, true, true);
+	if (!ret && (saved & MT6331_ST_PGA_L))
+		ret = mt6331_pga_l_power_up(priv);
+	if (!ret && (saved & MT6331_ST_PGA_R))
+		ret = mt6331_pga_r_power_up(priv);
+	if (!ret && (saved & MT6331_ST_ADC))
+		ret = mt6331_adc_power_up(priv);
+
+	mutex_unlock(&priv->ana_lock);
+
+	if (ret)
+		dev_err(priv->dev, "resume restore failed: %d\n", ret);
+
+	return ret;
+}
+
+static const struct snd_soc_component_driver mt6331_soc_component_driver = {
+	.name = MT6331_CODEC_NAME,
+	.probe = mt6331_codec_probe,
+	.suspend = mt6331_codec_suspend,
+	.resume = mt6331_codec_resume,
+	.set_jack = mt6331_set_jack,
+	.controls = mt6331_snd_controls,
+	.num_controls = ARRAY_SIZE(mt6331_snd_controls),
+	.dapm_widgets = mt6331_dapm_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(mt6331_dapm_widgets),
+	.dapm_routes = mt6331_dapm_routes,
+	.num_dapm_routes = ARRAY_SIZE(mt6331_dapm_routes),
+};
+
+/* ------------------------------------------------------------------ */
+/* Platform driver                                                    */
+/* ------------------------------------------------------------------ */
+static int mt6331_platform_probe(struct platform_device *pdev)
+{
+	struct mt6397_chip *pmic = dev_get_drvdata(pdev->dev.parent);
+	struct mt6331_priv *priv;
+	int ret;
+
+	if (!pmic || !pmic->regmap)
+		return -EPROBE_DEFER;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->dev = &pdev->dev;
+	priv->regmap = pmic->regmap;
+	priv->dl_rate = 48000;	/* vendor:118 mBlockSampleRate[] */
+	priv->ul_rate = 48000;
+
+	mutex_init(&priv->ana_lock);
+	mutex_init(&priv->clk_lock);
+	mutex_init(&priv->clksq_lock);
+	priv->jack_nb.notifier_call = mt6331_jack_notify;
+
+	/* Optional de-pop switch, driven low while the headphone amplifier
+	 * settles (vendor:383-440).  Only present on boards that route it.
+	 */
+	priv->hp_depop = devm_gpiod_get_optional(&pdev->dev, "hp-depop",
+						 GPIOD_OUT_HIGH);
+	if (IS_ERR(priv->hp_depop))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->hp_depop),
+				     "failed to get the headphone de-pop GPIO\n");
+
+	dev_set_drvdata(&pdev->dev, priv);
+
+	dev_info(priv->dev, "MT6328 PMIC codec (MT6331 register map naming)\n");
+
+	ret = devm_snd_soc_register_component(&pdev->dev,
+					      &mt6331_soc_component_driver,
+					      mt6331_dai_driver,
+					      ARRAY_SIZE(mt6331_dai_driver));
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+static const struct of_device_id mt6331_of_match[] = {
+	{ .compatible = "mediatek,mt6328-codec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6331_of_match);
+
+static struct platform_driver mt6331_platform_driver = {
+	.driver = {
+		.name = "mt6328-codec",
+		.of_match_table = mt6331_of_match,
+	},
+	.probe = mt6331_platform_probe,
+};
+module_platform_driver(mt6331_platform_driver);
+
+MODULE_DESCRIPTION("MT6328 PMIC audio codec (vendor name: mt6331)");
+MODULE_AUTHOR("MediaTek Inc.");
+MODULE_LICENSE("GPL v2");
diff --git a/sound/soc/codecs/mt6331.h b/sound/soc/codecs/mt6331.h
new file mode 100644
