+/* ------------------------------------------------------------------ */
+/* State machine                                                      */
+/* ------------------------------------------------------------------ */
+
+/* Downstream mtk_btif.c:1204-1241 / btif_dma_plat.c:883-906 */
+static bool btif_is_tx_complete(struct mtk_btif *btif)
+{
+	if (btif->tx_mode == BTIF_MODE_DMA &&
+	    !btif_dma_is_tx_complete(&btif->tx_dma))
+		return false;
+
+	return btif_hw_is_tx_complete(btif);
+}
+
+/*
+ * Downstream mtk_btif.c:1712-1763 (_btif_enter_dpidle_from_on): wait up to
+ * 5 s for the TX path to drain, then gate all clocks.  The downstream loop
+ * counts 5000 msleep(1) iterations; a real deadline is used here because
+ * msleep(1) only guarantees a lower bound.
+ */
+static int btif_enter_dpidle_from_on(struct mtk_btif *btif)
+{
+	ktime_t deadline = ktime_add_ms(ktime_get(), 5000);
+
+	while (!btif_is_tx_complete(btif)) {
+		if (ktime_after(ktime_get(), deadline)) {
+			dev_warn(btif->dev,
+				 "BTIF TX busy, deep-idle entry refused\n");
+			return -EBUSY;
+		}
+		usleep_range(1000, 2000);
+	}
+
+	if (btif->tx_mode == BTIF_MODE_DMA)
+		btif_apdma_clk_disable(btif);
+	if (btif->rx_mode == BTIF_MODE_DMA)
+		btif_apdma_clk_disable(btif);
+	btif_clk_disable(btif);
+
+	return 0;
+}
+
+static int btif_enter_dpidle(struct mtk_btif *btif)
+{
+	int ret = 0;
+
+	switch (btif->state) {
+	case B_S_ON:
+		ret = btif_enter_dpidle_from_on(btif);
+		break;
+	case B_S_SUSPEND:
+		ret = btif_hw_start(btif);
+		if (!ret)
+			ret = btif_enter_dpidle_from_on(btif);
+		break;
+	case B_S_DPIDLE:
+		return 0;
+	default:
+		dev_warn(btif->dev, "cannot enter deep idle from %s\n",
+			 btif_state_name[btif->state]);
+		return E_BTIF_INVAL_STATE;
+	}
+
+	if (!ret)
+		btif->state = B_S_DPIDLE;
+
+	return ret;
+}
+
+/* Downstream mtk_btif.c:1670-1692 / 1693-1701 */
+static int btif_exit_dpidle(struct mtk_btif *btif)
+{
+	int ret = 0;
+
+	switch (btif->state) {
+	case B_S_DPIDLE:
+		if (btif->tx_mode == BTIF_MODE_DMA) {
+			ret = btif_apdma_clk_enable(btif);
+			if (ret)
+				return ret;
+		}
+		if (btif->rx_mode == BTIF_MODE_DMA) {
+			ret = btif_apdma_clk_enable(btif);
+			if (ret) {
+				if (btif->tx_mode == BTIF_MODE_DMA)
+					btif_apdma_clk_disable(btif);
+				return ret;
+			}
+		}
+		ret = btif_clk_enable(btif);
+		if (ret)
+			return ret;
+		break;
+	case B_S_SUSPEND:
+	case B_S_OFF:
+		ret = btif_hw_start(btif);
+		break;
+	case B_S_ON:
+		return 0;
+	default:
+		return E_BTIF_INVAL_PARAM;
+	}
+
+	if (!ret)
+		btif->state = B_S_ON;
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Transmit path                                                      */
+/* ------------------------------------------------------------------ */
+
+/* Downstream mtk_btif.c:2882-2933 (_btif_dma_write) */
+static int btif_dma_write(struct mtk_btif *btif, const u8 *buf,
+			  unsigned int len)
+{
+	struct btif_dma_chan *chan = &btif->tx_dma;
+	int ret;
+	int retry;
+
+	for (retry = 0; retry < 10; retry++) {
+		if (!btif_dma_is_tx_allow(chan))
+			continue;
+
+		ret = btif_dma_tx_room(chan);
+		if (ret < (int)len)
+			return E_BTIF_AGAIN;
+
+		return btif_dma_send(chan, buf, len);
+	}
+
+	dev_warn_ratelimited(btif->dev, "BTIF TX DMA not allowed\n");
+	return E_BTIF_AGAIN;
+}
+
+/* Downstream mtk_btif.c:2938-2968 (_btif_pio_write) */
+static int btif_pio_write(struct mtk_btif *btif, const u8 *buf,
+			  unsigned int len)
+{
+	unsigned int sent = 0;
+	unsigned int retry = 0;
+	int ret;
+
+	while (sent < len && retry < 10) {
+		ret = btif_hw_send(btif, buf + sent, len - sent);
+		if (ret > 0) {
+			sent += ret;
+			retry = 0;
+		} else {
+			retry++;
+		}
+	}
+
+	return sent;
+}
+
+/* Downstream mtk_btif.c:2897-2969 (_btif_send_data) */
+static int btif_send(struct mtk_btif *btif, const u8 *buf, unsigned int len)
+{
+	int ret;
+
+	if (!btif->enabled)
+		return E_BTIF_NOT_OPEN;
+
+	mutex_lock(&btif->tx_mtx);
+	mutex_lock(&btif->state_mtx);
+	if (btif->state == B_S_ON)
+		ret = 0;
+	else
+		ret = btif_exit_dpidle(btif);
+
+	if (ret) {
+		mutex_unlock(&btif->state_mtx);
+		mutex_unlock(&btif->tx_mtx);
+		return E_BTIF_INVAL_STATE;
+	}
+
+	if (btif->tx_mode == BTIF_MODE_DMA)
+		ret = btif_dma_write(btif, buf, len);
+	else
+		ret = btif_pio_write(btif, buf, len);
+
+	if (ret > 0)
+		btif_log_record(&btif->tx_log, buf, ret);
+
+	mutex_unlock(&btif->state_mtx);
+	mutex_unlock(&btif->tx_mtx);
+
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Open / close                                                       */
+/* ------------------------------------------------------------------ */
+
+/* Downstream mtk_btif.c:1524-1553 (btif_open) */
+static int btif_enable(struct mtk_btif *btif)
+{
+	int ret;
+
+	if (btif->enabled)
+		return E_BTIF_ALREADY_OPEN;
+
+	mutex_lock(&btif->state_mtx);
+	ret = btif_hw_start(btif);
+	if (!ret) {
+		btif->enabled = true;
+		btif->state = B_S_ON;
+	}
+	btif_log_clear(&btif->tx_log);
+	btif_log_clear(&btif->rx_log);
+	btif_log_set(&btif->tx_log, true);
+	btif_log_set(&btif->rx_log, true);
+	mutex_unlock(&btif->state_mtx);
+
+	dev_info(btif->dev, "BTIF opened, tx %s rx %s\n",
+		 btif->tx_mode == BTIF_MODE_DMA ? "DMA" : "PIO",
+		 btif->rx_mode == BTIF_MODE_DMA ? "DMA" : "PIO");
+
+	return ret;
+}
+
+/* Downstream mtk_btif.c:1555-1588 (btif_close) */
+static int btif_disable(struct mtk_btif *btif)
+{
+	if (!btif->enabled)
+		return E_BTIF_NOT_OPEN;
+
+	mutex_lock(&btif->state_mtx);
+
+	/* return to ON so the teardown runs with live clocks */
+	btif_exit_dpidle(btif);
+
+	btif->enabled = false;
+	btif_tx_free(btif);
+	btif_rx_free(btif);
+	btif_controller_free(btif);
+
+	btif->rx_cb = NULL;
+	btif->lpbk = false;
+	btif->state = B_S_OFF;
+	mutex_unlock(&btif->state_mtx);
+
+	btif_log_set(&btif->tx_log, false);
+	btif_log_set(&btif->rx_log, false);
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Exported API                                                       */
+/* ------------------------------------------------------------------ */
+
+static struct btif_user *btif_user_find(unsigned long id)
+{
+	struct mtk_btif *btif = g_btif;
+
+	if (!btif || !btif->owner || btif->owner->id != id)
+		return NULL;
+
+	return btif->owner;
+}
+
+int mtk_wcn_btif_open(char *owner, unsigned long *id)
+{
+	struct mtk_btif *btif = g_btif;
+	struct btif_user *user;
+	int ret;
+
+	if (!btif)
+		return E_BTIF_BAD_POINTER;
+	if (!owner || !id) {
+		if (id)
+			*id = 0;
+		return E_BTIF_INVAL_PARAM;
+	}
+
+	mutex_lock(&btif->ops_mtx);
+	if (btif->owner) {
+		dev_warn(btif->dev, "BTIF already owned by %s\n",
+			 btif->owner->name);
+		ret = E_BTIF_ALREADY_OPEN;
+		goto out;
+	}
+
+	user = kzalloc_obj(*user);
+	if (!user) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = btif_enable(btif);
+	if (ret) {
+		kfree(user);
+		goto out;
+	}
+
+	strscpy(user->name, owner, sizeof(user->name));
+	user->id = (unsigned long)user;
+	user->btif = btif;
+	btif->owner = user;
+	*id = user->id;
+
+out:
+	mutex_unlock(&btif->ops_mtx);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_open);
+
+int mtk_wcn_btif_close(unsigned long id)
+{
+	struct mtk_btif *btif = g_btif;
+	int ret = E_BTIF_INVAL_PARAM;
+
+	if (!btif)
+		return E_BTIF_BAD_POINTER;
+
+	mutex_lock(&btif->ops_mtx);
+	if (!btif->owner || btif->owner->id != id)
+		goto out;
+
+	ret = btif_disable(btif);
+	kfree(btif->owner);
+	btif->owner = NULL;
+
+out:
+	mutex_unlock(&btif->ops_mtx);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_close);
+
+int mtk_wcn_btif_write(unsigned long id, const unsigned char *buf,
+		       unsigned int len)
+{
+	struct btif_user *user = btif_user_find(id);
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	if (!buf)
+		return E_BTIF_INVAL_PARAM;
+	if (!len || len > BTIF_MAX_LEN_PER_PKT) {
+		dev_err(user->btif->dev, "invalid BTIF TX length %u\n", len);
+		return E_BTIF_INVAL_PARAM;
+	}
+
+	return btif_send(user->btif, buf, len);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_write);
+
+int mtk_wcn_btif_read(unsigned long id, unsigned char *buf, unsigned int len)
+{
+	struct btif_user *user = btif_user_find(id);
+	struct mtk_btif *btif;
+	unsigned long flags;
+	unsigned int count;
+	unsigned int chunk;
+	unsigned int tail;
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	btif = user->btif;
+	if (!buf || !len)
+		return E_BTIF_INVAL_PARAM;
+
+	/* owners using a callback never read from the staging ring */
+	if (btif->rx_cb)
+		return E_BTIF_INVAL_STATE;
+
+	mutex_lock(&btif->rx_mtx);
+	spin_lock_irqsave(&btif->rx_lock, flags);
+	count = btif_rx_ring_count(btif);
+	chunk = min(count, len);
+	tail = min(chunk, btif->rx_size - btif->rx_rd);
+	if (chunk) {
+		memcpy(buf, btif->rx_buf + btif->rx_rd, tail);
+		if (chunk > tail)
+			memcpy(buf + tail, btif->rx_buf, chunk - tail);
+		btif->rx_rd = (btif->rx_rd + chunk) & (btif->rx_size - 1);
+	}
+	spin_unlock_irqrestore(&btif->rx_lock, flags);
+	mutex_unlock(&btif->rx_mtx);
+
+	return chunk;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_read);
+
+int mtk_wcn_btif_dpidle_ctrl(unsigned long id,
+			     enum mtk_btif_dpidle_ctrl flag)
+{
+	struct btif_user *user = btif_user_find(id);
+	struct mtk_btif *btif;
+	int ret;
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	btif = user->btif;
+	if (!btif->enabled)
+		return E_BTIF_NOT_OPEN;
+
+	mutex_lock(&btif->state_mtx);
+	if (flag == BTIF_DPIDLE_DISABLE)
+		ret = btif_exit_dpidle(btif);
+	else
+		ret = btif_enter_dpidle(btif);
+	mutex_unlock(&btif->state_mtx);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_dpidle_ctrl);
+
+int mtk_wcn_btif_rx_cb_register(unsigned long id, mtk_btif_rx_cb rx_cb)
+{
+	struct btif_user *user = btif_user_find(id);
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	if (!rx_cb)
+		return E_BTIF_INVAL_PARAM;
+
+	if (user->btif->rx_cb && user->btif->rx_cb != rx_cb)
+		dev_warn(user->btif->dev, "replacing BTIF RX callback\n");
+
+	user->btif->rx_cb = rx_cb;
+
+	/* deliver anything that arrived before the callback was registered */
+	complete(&user->btif->rx_comp);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_rx_cb_register);
+
+int mtk_wcn_btif_wakeup_consys(unsigned long id)
+{
+	struct btif_user *user = btif_user_find(id);
+	struct mtk_btif *btif;
+	int ret;
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	btif = user->btif;
+	if (!btif->enabled)
+		return E_BTIF_NOT_OPEN;
+
+	/*
+	 * The WAK register lives in the BTIF block, so its clock must be on
+	 * even when the channel is in deep idle.  Downstream does the same
+	 * around hal_btif_raise_wak_sig() (mtk_btif.c:1779-1795).
+	 */
+	mutex_lock(&btif->state_mtx);
+	ret = btif_clk_enable(btif);
+	if (!ret) {
+		ret = btif_hw_raise_wake(btif);
+		btif_clk_disable(btif);
+	}
+	mutex_unlock(&btif->state_mtx);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_wakeup_consys);
+
+int mtk_wcn_btif_loopback_ctrl(unsigned long id,
+			       enum mtk_btif_lpbk_mode enable)
+{
+	struct btif_user *user = btif_user_find(id);
+	struct mtk_btif *btif;
+	bool en;
+	int ret;
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	btif = user->btif;
+	if (!btif->enabled)
+		return E_BTIF_NOT_OPEN;
+	en = enable == BTIF_LPBK_ENABLE;
+
+	mutex_lock(&btif->state_mtx);
+	ret = btif_exit_dpidle(btif);
+	if (!ret) {
+		ret = btif_hw_loopback(btif, en);
+		if (!ret) {
+			btif->lpbk = en;
+			dev_info(btif->dev, "BTIF loopback %s\n",
+				 en ? "enabled" : "disabled");
+		}
+	} else {
+		ret = E_BTIF_INVAL_STATE;
+	}
+	mutex_unlock(&btif->state_mtx);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_loopback_ctrl);
+
+int mtk_wcn_btif_dbg_ctrl(unsigned long id, enum mtk_btif_dbg_id flag)
+{
+	struct btif_user *user = btif_user_find(id);
+	struct mtk_btif *btif;
+	enum btif_state saved;
+	int ret = 0;
+
+	if (!user)
+		return E_BTIF_INVAL_PARAM;
+	btif = user->btif;
+
+	switch (flag) {
+	case BTIF_DISABLE_LOGGER:
+		btif_log_set(&btif->tx_log, false);
+		btif_log_set(&btif->rx_log, false);
+		break;
+	case BTIF_ENABLE_LOGGER:
+		btif_log_set(&btif->tx_log, true);
+		btif_log_set(&btif->rx_log, true);
+		break;
+	case BTIF_DUMP_LOG:
+		btif_log_dump(btif, &btif->tx_log);
+		btif_log_dump(btif, &btif->rx_log);
+		break;
+	case BTIF_CLR_LOG:
+		btif_log_clear(&btif->tx_log);
+		btif_log_clear(&btif->rx_log);
+		break;
+	case BTIF_DUMP_BTIF_REG:
+		mutex_lock(&btif->state_mtx);
+		saved = btif->state;
+		if (saved == B_S_OFF) {
+			ret = E_BTIF_INVAL_STATE;
+		} else {
+			if (saved != B_S_ON)
+				btif_exit_dpidle(btif);
+			btif_hw_dump_regs(btif);
+			if (btif->tx_mode == BTIF_MODE_DMA)
+				btif_dma_dump_regs(&btif->tx_dma);
+			if (btif->rx_mode == BTIF_MODE_DMA)
+				btif_dma_dump_regs(&btif->rx_dma);
+			if (saved != B_S_ON)
+				btif_enter_dpidle(btif);
+		}
+		mutex_unlock(&btif->state_mtx);
+		break;
+	case BTIF_ENABLE_RT_LOG:
+		btif_log_set_realtime(&btif->tx_log, true);
+		btif_log_set_realtime(&btif->rx_log, true);
+		break;
+	case BTIF_DISABLE_RT_LOG:
+		btif_log_set_realtime(&btif->tx_log, false);
+		btif_log_set_realtime(&btif->rx_log, false);
+		break;
+	default:
+		ret = E_BTIF_INVAL_PARAM;
+		break;
+	}
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_dbg_ctrl);
+
+/*
+ * Downstream btif_parser_wmt_evt() (mtk_btif.c:1102-1166) copies the whole
+ * staging buffer and searches for the supplied byte sequence without
+ * consuming it; it is used by WMT to verify that a known sleep/wakeup event
+ * went through the RX path (wmt_ctrl.c:948-975).
+ */
+bool mtk_wcn_btif_parser_wmt_evt(unsigned long id, const unsigned char *buf,
+				 unsigned int len)
+{
+	struct btif_user *user = btif_user_find(id);
+	struct mtk_btif *btif;
+	unsigned long flags;
+	unsigned int count;
+	unsigned int alloc;
+	unsigned int tail;
+	unsigned int i;
+	u8 *snapshot;
+	bool found = false;
+
+	if (!user || !buf || !len)
+		return false;
+	btif = user->btif;
+
+	mutex_lock(&btif->rx_mtx);
+	spin_lock_irqsave(&btif->rx_lock, flags);
+	count = btif_rx_ring_count(btif);
+	spin_unlock_irqrestore(&btif->rx_lock, flags);
+	if (count < len) {
+		mutex_unlock(&btif->rx_mtx);
+		return false;
+	}
+
+	alloc = count;
+	snapshot = kmalloc(alloc, GFP_KERNEL);
+	if (!snapshot) {
+		mutex_unlock(&btif->rx_mtx);
+		return false;
+	}
+
+	spin_lock_irqsave(&btif->rx_lock, flags);
+	count = min(btif_rx_ring_count(btif), alloc);
+	tail = min(count, btif->rx_size - btif->rx_rd);
+	memcpy(snapshot, btif->rx_buf + btif->rx_rd, tail);
+	if (count > tail)
+		memcpy(snapshot + tail, btif->rx_buf, count - tail);
+	spin_unlock_irqrestore(&btif->rx_lock, flags);
+
+	for (i = 0; i + len <= count; i++) {
+		if (!memcmp(snapshot + i, buf, len)) {
+			found = true;
+			break;
+		}
+	}
+
+	kfree(snapshot);
+	mutex_unlock(&btif->rx_mtx);
+
+	dev_info(btif->dev, "WMT event parser %s at %u of %u bytes\n",
+		 found ? "match" : "miss", found ? i : 0, count);
+
+	return found;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_btif_parser_wmt_evt);
+
+/* ------------------------------------------------------------------ */
+/* Platform driver                                                    */
+/* ------------------------------------------------------------------ */
+
+static int btif_dma_chan_init(struct mtk_btif *btif,
+			      struct btif_dma_chan *chan,
+			      enum btif_dma_dir dir, unsigned int size,
+			      unsigned int thre, void __iomem *base, int irq)
+{
+	chan->btif = btif;
+	chan->dir = dir;
+	chan->base = base;
+	chan->irq = irq;
+	chan->irq_registered = false;
+	chan->vfifo.size = size;
+	chan->vfifo.thre = thre;
+	chan->vfifo.vir = dma_alloc_coherent(btif->dev, size,
+					     &chan->vfifo.phys, GFP_KERNEL);
+	if (!chan->vfifo.vir)
+		return -ENOMEM;
+	memset(chan->vfifo.vir, 0, size);
+
+	return 0;
+}
+
+static void btif_dma_chan_deinit(struct mtk_btif *btif,
+				 struct btif_dma_chan *chan)
+{
+	if (!chan->vfifo.vir)
+		return;
+	dma_free_coherent(btif->dev, chan->vfifo.size, chan->vfifo.vir,
+			  chan->vfifo.phys);
+	chan->vfifo.vir = NULL;
+}
+
+static int mtk_btif_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mtk_btif *btif;
+	void __iomem *tx_base;
+	void __iomem *rx_base;
+	int tx_irq;
+	int rx_irq;
+	int ret;
+
+	if (g_btif)
+		return -EBUSY;
+
+	btif = devm_kzalloc(dev, sizeof(*btif), GFP_KERNEL);
+	if (!btif)
+		return -ENOMEM;
+	btif->dev = dev;
+	btif->tx_mode = BTIF_MODE_DMA;
+	btif->rx_mode = BTIF_MODE_DMA;
+	btif->state = B_S_OFF;
+
+	mutex_init(&btif->state_mtx);
+	mutex_init(&btif->ops_mtx);
+	mutex_init(&btif->tx_mtx);
+	mutex_init(&btif->rx_mtx);
+	spin_lock_init(&btif->rx_lock);
+	spin_lock_init(&btif->tx_lock);
+	init_completion(&btif->rx_comp);
+
+	btif->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(btif->base))
+		return PTR_ERR(btif->base);
+
+	btif->irq = platform_get_irq(pdev, 0);
+	if (btif->irq < 0)
+		return btif->irq;
+
+	btif->clk_btif = devm_clk_get(dev, "btifc");
+	if (IS_ERR(btif->clk_btif))
+		return dev_err_probe(dev, PTR_ERR(btif->clk_btif),
+				     "failed to get btifc clock\n");
+
+	btif->clk_apdma = devm_clk_get(dev, "apdmac");
+	if (IS_ERR(btif->clk_apdma))
+		return dev_err_probe(dev, PTR_ERR(btif->clk_apdma),
+				     "failed to get apdmac clock\n");
+
+	/*
+	 * The APDMA vFIFO base is programmed through a 32-bit register and the
+	 * downstream driver allocates it with GFP_DMA32 (mtk_btif.c:1862-1864), so
+	 * the controller only addresses the low 4 GiB [INFERENCE].
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	ret = clk_prepare(btif->clk_btif);
+	if (ret)
+		return ret;
+	ret = clk_prepare(btif->clk_apdma);
+	if (ret) {
+		clk_unprepare(btif->clk_btif);
+		return ret;
+	}
+
+	btif->rx_buf = devm_kzalloc(dev, BTIF_RX_BUFFER_SIZE, GFP_KERNEL);
+	if (!btif->rx_buf) {
+		ret = -ENOMEM;
+		goto err_clk;
+	}
+	btif->rx_size = BTIF_RX_BUFFER_SIZE;
+
+	btif->tx_fifo = devm_kzalloc(dev, sizeof(*btif->tx_fifo), GFP_KERNEL);
+	if (!btif->tx_fifo) {
+		ret = -ENOMEM;
+		goto err_clk;
+	}
+	ret = kfifo_alloc(btif->tx_fifo, BTIF_TX_FIFO_SIZE, GFP_KERNEL);
+	if (ret)
+		goto err_clk;
+
+	tx_base = devm_platform_ioremap_resource(pdev, 1);
+	rx_base = devm_platform_ioremap_resource(pdev, 2);
+	tx_irq = platform_get_irq(pdev, 1);
+	rx_irq = platform_get_irq(pdev, 2);
+	if (IS_ERR(tx_base) || IS_ERR(rx_base) || tx_irq < 0 || rx_irq < 0) {
+		dev_err(dev, "missing APDMA resources\n");
+		ret = -EINVAL;
+		goto err_kfifo;
+	}
+
+	ret = btif_dma_chan_init(btif, &btif->tx_dma, BTIF_DMA_TX,
+				 BTIF_TX_DMA_VFIFO_SIZE,
+				 BTIF_DMA_TX_THRE(BTIF_TX_DMA_VFIFO_SIZE),
+				 tx_base, tx_irq);
+	if (ret)
+		goto err_kfifo;
+
+	ret = btif_dma_chan_init(btif, &btif->rx_dma, BTIF_DMA_RX,
+				 BTIF_RX_DMA_VFIFO_SIZE,
+				 BTIF_DMA_RX_THRE(BTIF_RX_DMA_VFIFO_SIZE),
+				 rx_base, rx_irq);
+	if (ret)
+		goto err_tx_dma;
+
+	btif_log_init(&btif->tx_log, "tx",
+		      devm_kcalloc(dev, BTIF_LOG_ENTRY_NUM,
+				   sizeof(struct btif_log_entry), GFP_KERNEL));
+	btif_log_init(&btif->rx_log, "rx",
+		      devm_kcalloc(dev, BTIF_LOG_ENTRY_NUM,
+				   sizeof(struct btif_log_entry), GFP_KERNEL));
+	if (!btif->tx_log.entries || !btif->rx_log.entries) {
+		ret = -ENOMEM;
+		goto err_rx_dma;
+	}
+
+	btif->rx_thread = kthread_run(btif_rx_thread, btif, "btif_rxd");
+	if (IS_ERR(btif->rx_thread)) {
+		ret = PTR_ERR(btif->rx_thread);
+		btif->rx_thread = NULL;
+		goto err_rx_dma;
+	}
+
+	platform_set_drvdata(pdev, btif);
+	g_btif = btif;
+
+	dev_info(dev, "BTIF registered (irq %d, tx dma irq %d, rx dma irq %d)\n",
+		 btif->irq, btif->tx_dma.irq, btif->rx_dma.irq);
+	return 0;
+
+err_rx_dma:
+	btif_dma_chan_deinit(btif, &btif->rx_dma);
+err_tx_dma:
+	btif_dma_chan_deinit(btif, &btif->tx_dma);
+err_kfifo:
+	kfifo_free(btif->tx_fifo);
+err_clk:
+	clk_unprepare(btif->clk_apdma);
+	clk_unprepare(btif->clk_btif);
+	return ret;
+}
+
+static void mtk_btif_remove(struct platform_device *pdev)
+{
+	struct mtk_btif *btif = platform_get_drvdata(pdev);
+
+	if (!btif)
+		return;
+
+	g_btif = NULL;
+	platform_set_drvdata(pdev, NULL);
+
+	if (btif->rx_thread)
+		kthread_stop(btif->rx_thread);
+
+	mutex_lock(&btif->ops_mtx);
+	if (btif->enabled) {
+		dev_warn(btif->dev, "BTIF still open at remove, forcing down\n");
+		btif_disable(btif);
+	}
+	kfree(btif->owner);
+	btif->owner = NULL;
+	mutex_unlock(&btif->ops_mtx);
+
+	btif_dma_chan_deinit(btif, &btif->rx_dma);
+	btif_dma_chan_deinit(btif, &btif->tx_dma);
+	kfifo_free(btif->tx_fifo);
+	clk_unprepare(btif->clk_apdma);
+	clk_unprepare(btif->clk_btif);
+}
+
+/*
+ * Downstream mtk_btif.c:259-435 keeps the controller off across system
+ * suspend and re-initialises it on resume; a busy channel refuses the
+ * transition so that a pending transfer is not torn down.
+ */
+static int mtk_btif_suspend(struct device *dev)
+{
+	struct mtk_btif *btif = dev_get_drvdata(dev);
+	int ret = 0;
+
+	mutex_lock(&btif->state_mtx);
+	if (btif->enabled) {
+		if (btif->state == B_S_ON) {
+			dev_err(dev, "BTIF busy, refusing suspend\n");
+			ret = -EBUSY;
+		} else {
+			btif_exit_dpidle(btif);
+			btif_tx_free(btif);
+			btif_rx_free(btif);
+			btif_controller_free(btif);
+			btif->state = B_S_SUSPEND;
+		}
+	}
+	mutex_unlock(&btif->state_mtx);
+
+	return ret;
+}
+
+static int mtk_btif_resume(struct device *dev)
+{
+	struct mtk_btif *btif = dev_get_drvdata(dev);
+
+	mutex_lock(&btif->state_mtx);
+	if (btif->enabled && btif->state == B_S_SUSPEND)
+		btif_enter_dpidle(btif);
+	mutex_unlock(&btif->state_mtx);
+
+	return 0;
+}
+
+static const struct dev_pm_ops mtk_btif_pm_ops = {
+	.suspend = mtk_btif_suspend,
+	.resume = mtk_btif_resume,
+};
+
+static const struct of_device_id mtk_btif_of_match[] = {
+	{ .compatible = "mediatek,btif" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_btif_of_match);
+
+static struct platform_driver mtk_btif_driver = {
+	.probe = mtk_btif_probe,
+	.remove = mtk_btif_remove,
+	.driver = {
+		.name = "mtk_btif",
+		.of_match_table = mtk_btif_of_match,
+		.pm = &mtk_btif_pm_ops,
+	},
+};
+module_platform_driver(mtk_btif_driver);
+
+MODULE_AUTHOR("MBJ/WCN/SE/SS1/Chaozhong.Liang");
+MODULE_DESCRIPTION("MediaTek BTIF driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/btif/btif_core.h b/drivers/misc/mediatek/btif/btif_core.h
new file mode 100644
index 000000000..6c9755eb9
--- /dev/null
+++ b/drivers/misc/mediatek/btif/btif_core.h
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek BTIF internal interface.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/btif/common/inc/mtk_btif.h
+ *   drivers/misc/mediatek/btif/common/plat_inc/btif_pub.h
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#ifndef __BTIF_CORE_H__
+#define __BTIF_CORE_H__
+
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/kfifo.h>
+#include <linux/ktime.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+#include "mtk_btif.h"
+
+/* Downstream mtk_btif.h:42 (BTIF_USER_NAME_MAX_LEN) */
+#define BTIF_USER_NAME_MAX_LEN	32
+/* Downstream mtk_btif.h:48 (BTIF_RX_BUFFER_SIZE) */
+#define BTIF_RX_BUFFER_SIZE	(64 * 1024)
+/* Downstream plat_common.h:199 (BTIF_HAL_TX_FIFO_SIZE) */
+#define BTIF_TX_FIFO_SIZE	(4 * 1024)
+/* Downstream mtk_btif.h:173 (BTIF_LOG_SZ) / :170 (BTIF_LOG_ENTRY_NUM) */
+#define BTIF_LOG_SZ		1536
+#define BTIF_LOG_ENTRY_NUM	30
+/* Downstream btif_priv.h:97-101 */
+#define BTIF_TX_FIFO_DEPTH	16
+#define BTIF_RX_FIFO_DEPTH	8
+#define BTIF_TX_FIFO_THRE	(BTIF_TX_FIFO_DEPTH / 2)
+#define BTIF_RX_FIFO_THRE	0x1
+/* Downstream btif_dma_priv.h:30-34 */
+#define BTIF_TX_DMA_VFIFO_SIZE	(8 * 1024)
+#define BTIF_RX_DMA_VFIFO_SIZE	(8 * 1024)
+#define BTIF_DMA_TX_THRE(n)	((n) - 7)
+#define BTIF_DMA_RX_THRE(n)	((n) * 3 / 4)
+
+/* Downstream btif_pub.h:21-25 (ENUM_BTIF_MODE) */
+enum btif_mode {
+	BTIF_MODE_PIO = 0,
+	BTIF_MODE_DMA,
+};
+
+/* Downstream mtk_btif.h:70-75 (ENUM_BTIF_STATE) */
+enum btif_state {
+	B_S_OFF = 0,
+	B_S_SUSPEND,
+	B_S_DPIDLE,
+	B_S_ON,
+};
+
+enum btif_dma_dir {
+	BTIF_DMA_RX = 0,
+	BTIF_DMA_TX,
+};
+
+struct mtk_btif;
+
+struct btif_vfifo {
+	void *vir;
+	dma_addr_t phys;
+	unsigned int size;
+	unsigned int thre;
+	unsigned int wpt;
+	unsigned int last_wpt_wrap;
+	unsigned int rpt;
+	unsigned int last_rpt_wrap;
+};
+
+struct btif_dma_chan {
+	struct mtk_btif *btif;
+	void __iomem *base;
+	int irq;
+	bool irq_registered;
+	enum btif_dma_dir dir;
+	struct btif_vfifo vfifo;
+	unsigned int flush_irq_count;
+};
+
+struct btif_log_entry {
+	ktime_t ts;
+	unsigned int len;
+	u8 buf[BTIF_LOG_SZ];
+};
+
+struct btif_log {
+	const char *name;
+	bool enabled;
+	bool realtime;
+	unsigned int in;
+	unsigned int count;
+	spinlock_t lock;
+	struct btif_log_entry *entries;
+};
+
+struct btif_user {
+	char name[BTIF_USER_NAME_MAX_LEN];
+	unsigned long id;
+	struct mtk_btif *btif;
+};
+
+struct mtk_btif {
+	struct device *dev;
+	void __iomem *base;		/* BTIF controller */
+	int irq;
+	bool irq_registered;
+
+	struct clk *clk_btif;
+	struct clk *clk_apdma;
+
+	struct btif_dma_chan tx_dma;
+	struct btif_dma_chan rx_dma;
+
+	enum btif_mode tx_mode;
+	enum btif_mode rx_mode;
+	enum btif_state state;
+	bool enabled;
+	bool lpbk;
+
+	struct mutex state_mtx;		/* state machine */
+	struct mutex ops_mtx;		/* open/close */
+	struct mutex tx_mtx;		/* TX serialisation */
+
+	struct btif_user *owner;
+	mtk_btif_rx_cb rx_cb;
+
+	/* RX staging ring, filled from IRQ context */
+	u8 *rx_buf;
+	unsigned int rx_size;
+	unsigned int rx_rd;
+	unsigned int rx_wr;
+	spinlock_t rx_lock;
+
+	struct task_struct *rx_thread;
+	struct completion rx_comp;
+	struct mutex rx_mtx;		/* RX ring consumption */
+
+	/* PIO TX staging */
+	struct kfifo *tx_fifo;
+	spinlock_t tx_lock;
+
+	struct btif_log tx_log;
+	struct btif_log rx_log;
+};
+
+/* mtk_btif.c */
+unsigned int btif_rx_ring_write(struct mtk_btif *btif, const u8 *buf,
+				unsigned int len);
+unsigned int btif_rx_ring_count(struct mtk_btif *btif);
+
+/* btif_hw.c */
+int btif_clk_enable(struct mtk_btif *btif);
+void btif_clk_disable(struct mtk_btif *btif);
+int btif_apdma_clk_enable(struct mtk_btif *btif);
+void btif_apdma_clk_disable(struct mtk_btif *btif);
+int btif_hw_init(struct mtk_btif *btif);
+int btif_hw_tx_mode(struct mtk_btif *btif, enum btif_mode mode);
+int btif_hw_rx_mode(struct mtk_btif *btif, enum btif_mode mode);
+void btif_hw_tx_ier(struct mtk_btif *btif, bool en);
+void btif_hw_rx_ier(struct mtk_btif *btif, bool en);
+int btif_hw_loopback(struct mtk_btif *btif, bool en);
+int btif_hw_send(struct mtk_btif *btif, const u8 *buf, unsigned int len);
+int btif_hw_tx_irq(struct mtk_btif *btif);
+int btif_hw_rx_drain(struct mtk_btif *btif);
+int btif_hw_raise_wake(struct mtk_btif *btif);
+bool btif_hw_is_tx_complete(struct mtk_btif *btif);
+void btif_hw_dump_regs(struct mtk_btif *btif);
+u32 btif_readl(struct mtk_btif *btif, u32 off);
+void btif_writel(struct mtk_btif *btif, u32 val, u32 off);
+u8 btif_readb(struct mtk_btif *btif, u32 off);
+void btif_writeb(struct mtk_btif *btif, u8 val, u32 off);
+
+/* btif_dma.c */
+int btif_dma_hw_init(struct btif_dma_chan *chan);
+void btif_dma_vfifo_reset(struct btif_dma_chan *chan);
+int btif_dma_ctrl(struct btif_dma_chan *chan, bool enable);
+int btif_dma_send(struct btif_dma_chan *chan, const u8 *buf,
+		  unsigned int len);
+bool btif_dma_is_tx_allow(struct btif_dma_chan *chan);
+int btif_dma_tx_room(struct btif_dma_chan *chan);
+bool btif_dma_is_tx_complete(struct btif_dma_chan *chan);
+irqreturn_t btif_dma_tx_irq(int irq, void *data);
+irqreturn_t btif_dma_rx_irq(int irq, void *data);
+void btif_dma_dump_regs(struct btif_dma_chan *chan);
+
+#endif /* __BTIF_CORE_H__ */
diff --git a/drivers/misc/mediatek/btif/btif_dma.c b/drivers/misc/mediatek/btif/btif_dma.c
new file mode 100644
index 000000000..acbdbe060
--- /dev/null
+++ b/drivers/misc/mediatek/btif/btif_dma.c
@@ -0,0 +1,393 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek BTIF APDMA (virtual FIFO) channel operations.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/btif/common/btif_dma_plat.c
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+
+#include "btif_core.h"
+#include "btif_regs.h"
+
+static u32 btif_dma_readl(struct btif_dma_chan *chan, u32 off)
+{
+	return readl(chan->base + off);
+}
+
+static void btif_dma_writel(struct btif_dma_chan *chan, u32 val, u32 off)
+{
+	writel(val, chan->base + off);
+}
+
+/*
+ * Reset the software view of the virtual FIFO pointers.
+ * Downstream btif_dma_plat.c:576-591 (hal_btif_vfifo_reset).
+ */
+void btif_dma_vfifo_reset(struct btif_dma_chan *chan)
+{
+	chan->vfifo.rpt = 0;
+	chan->vfifo.last_rpt_wrap = 0;
+	chan->vfifo.wpt = 0;
+	chan->vfifo.last_wpt_wrap = 0;
+}
+
+/*
+ * Downstream btif_dma_plat.c:397-460 (hal_btif_dma_hw_init): warm reset the
+ * channel, program the virtual FIFO base/length/pointers/threshold and mask
+ * or clear the channel interrupt.
+ */
+int btif_dma_hw_init(struct btif_dma_chan *chan)
+{
+	struct btif_vfifo *vfifo = &chan->vfifo;
+	u32 dat;
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_RST) |
+			      BTIF_DMA_WARM_RST, BTIF_DMA_REG_RST);
+	do {
+		dat = btif_dma_readl(chan, BTIF_DMA_REG_EN);
+	} while (dat & BTIF_DMA_EN_BIT);
+
+	btif_dma_writel(chan, lower_32_bits(vfifo->phys),
+			BTIF_DMA_REG_VFF_ADDR);
+	btif_dma_writel(chan, vfifo->size, BTIF_DMA_REG_VFF_LEN);
+	btif_dma_writel(chan, vfifo->wpt, BTIF_DMA_REG_VFF_WPT);
+	btif_dma_writel(chan, vfifo->rpt, BTIF_DMA_REG_VFF_RPT);
+	btif_dma_writel(chan, vfifo->thre, BTIF_DMA_REG_VFF_THRE);
+
+	if (chan->dir == BTIF_DMA_RX) {
+		btif_dma_writel(chan,
+				btif_dma_readl(chan, BTIF_DMA_REG_INT_FLAG) |
+				BTIF_RX_DMA_INT_DONE | BTIF_RX_DMA_INT_THRE,
+				BTIF_DMA_REG_INT_FLAG);
+		btif_dma_writel(chan,
+				btif_dma_readl(chan, BTIF_DMA_REG_INT_EN) |
+				BTIF_RX_DMA_INT_THRE_EN |
+				BTIF_RX_DMA_INT_DONE_EN, BTIF_DMA_REG_INT_EN);
+	} else {
+		btif_dma_writel(chan,
+				btif_dma_readl(chan, BTIF_DMA_REG_INT_FLAG) &
+				~BTIF_TX_DMA_INT_FLAG_MASK,
+				BTIF_DMA_REG_INT_FLAG);
+		btif_dma_writel(chan,
+				btif_dma_readl(chan, BTIF_DMA_REG_INT_EN) &
+				~BTIF_TX_DMA_INTEN_BIT, BTIF_DMA_REG_INT_EN);
+	}
+
+	chan->flush_irq_count = 0;
+	return 0;
+}
+
+/*
+ * Downstream btif_dma_plat.c:502-564.  Disable is a graceful stop: setting
+ * STOP lets the current transaction finish, so poll until the hardware
+ * clears it.
+ */
+int btif_dma_ctrl(struct btif_dma_chan *chan, bool enable)
+{
+	u32 dat;
+
+	if (enable) {
+		btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_EN) |
+				      BTIF_DMA_EN_BIT, BTIF_DMA_REG_EN);
+		return 0;
+	}
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_STOP) |
+			      BTIF_DMA_STOP_BIT, BTIF_DMA_REG_STOP);
+	do {
+		dat = btif_dma_readl(chan, BTIF_DMA_REG_STOP);
+	} while (dat & BTIF_DMA_STOP_BIT);
+
+	return 0;
+}
+
+/* Downstream btif_dma_plat.c:1256-1284 */
+static void btif_dma_tx_flush(struct btif_dma_chan *chan)
+{
+	u32 stop = btif_dma_readl(chan, BTIF_DMA_REG_STOP);
+
+	if (stop & BTIF_DMA_STOP_BIT) {
+		dev_warn_ratelimited(chan->btif->dev,
+				     "BTIF TX DMA stopped, skip flush\n");
+		return;
+	}
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_FLUSH) |
+			      BTIF_DMA_FLUSH_BIT, BTIF_DMA_REG_FLUSH);
+}
+
+static bool btif_dma_tx_in_flush(struct btif_dma_chan *chan)
+{
+	return btif_dma_readl(chan, BTIF_DMA_REG_FLUSH) & BTIF_DMA_FLUSH_BIT;
+}
+
+/*
+ * Downstream btif_dma_plat.c:942-959.  A flush needs to complete before the
+ * next WPT update; the worst case wait derived from the BTIF baud rate is
+ * 8 bytes at the minimum transfer rate (26 MHz / 13 = 2 MB/s), i.e. 4 us.
+ */
+bool btif_dma_is_tx_allow(struct btif_dma_chan *chan)
+{
+#define BTIF_MIN_TX_MB	((26 * 1000000 / 13) / 1000000)
+	unsigned int wait_us = 8 / BTIF_MIN_TX_MB;
+
+	if (!btif_dma_tx_in_flush(chan))
+		return true;
+
+	usleep_range(wait_us, 2 * wait_us);
+
+	if (btif_dma_tx_in_flush(chan)) {
+		dev_warn_ratelimited(chan->btif->dev,
+				     "BTIF TX DMA flush still running\n");
+		return false;
+	}
+
+	return true;
+}
+
+/* Downstream btif_dma_plat.c:918-930 */
+int btif_dma_tx_room(struct btif_dma_chan *chan)
+{
+	return btif_dma_readl(chan, BTIF_DMA_REG_VFF_LEFT_SIZE);
+}
+
+/*
+ * Downstream btif_dma_plat.c:775-871 (hal_dma_send_data).  The caller has
+ * already checked that the virtual FIFO holds enough room; the length is
+ * still clamped here because a hardware ring wrap must never overrun.
+ */
+int btif_dma_send(struct btif_dma_chan *chan, const u8 *buf, unsigned int len)
+{
+	struct btif_vfifo *vfifo = &chan->vfifo;
+	unsigned int avail;
+	unsigned int wpt;
+	unsigned int wrap;
+	unsigned int send;
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_INT_EN) &
+			      ~BTIF_TX_DMA_INTEN_BIT, BTIF_DMA_REG_INT_EN);
+
+	avail = btif_dma_readl(chan, BTIF_DMA_REG_VFF_LEFT_SIZE);
+	wpt = btif_dma_readl(chan, BTIF_DMA_REG_VFF_WPT);
+	wrap = wpt & BTIF_DMA_WPT_WRAP;
+	wpt &= BTIF_DMA_WPT_MASK;
+
+	send = min(len, avail);
+	if (send < len)
+		dev_warn_ratelimited(chan->btif->dev,
+				     "BTIF TX vFIFO short: %u of %u\n",
+				     send, len);
+
+	if (send + wpt >= vfifo->size) {
+		unsigned int tail = vfifo->size - wpt;
+
+		memcpy((u8 *)vfifo->vir + wpt, buf, tail);
+		memcpy(vfifo->vir, buf + tail, send - tail);
+		wpt = send - tail;
+		wrap ^= BTIF_DMA_WPT_WRAP;
+	} else {
+		memcpy((u8 *)vfifo->vir + wpt, buf, send);
+		wpt += send;
+	}
+
+	/* data must reach memory before the hardware sees the new WPT */
+	wmb();
+
+	vfifo->wpt = wpt;
+	vfifo->last_wpt_wrap = wrap;
+
+	if (!btif_dma_is_tx_allow(chan)) {
+		btif_dma_writel(chan, btif_dma_readl(chan,
+					BTIF_DMA_REG_INT_EN) |
+					BTIF_TX_DMA_INTEN_BIT,
+				BTIF_DMA_REG_INT_EN);
+		return 0;
+	}
+
+	btif_dma_ctrl(chan, true);
+	btif_dma_writel(chan, wpt | wrap, BTIF_DMA_REG_VFF_WPT);
+
+	/* a sub 8-byte remainder would never trigger the threshold */
+	avail = btif_dma_readl(chan, BTIF_DMA_REG_VFF_VALID_SIZE);
+	if (avail > 0 && avail < 8)
+		btif_dma_tx_flush(chan);
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_INT_EN) |
+			      BTIF_TX_DMA_INTEN_BIT, BTIF_DMA_REG_INT_EN);
+
+	return send;
+}
+
+/* Downstream btif_dma_plat.c:883-906 */
+bool btif_dma_is_tx_complete(struct btif_dma_chan *chan)
+{
+	unsigned int valid = btif_dma_readl(chan,
+					    BTIF_DMA_REG_VFF_VALID_SIZE);
+	unsigned int internal = btif_dma_readl(chan,
+					       BTIF_DMA_REG_INT_BUF_SIZE);
+	bool irq_done = !(btif_dma_readl(chan, BTIF_DMA_REG_INT_FLAG) &
+			  BTIF_TX_DMA_INT_FLAG_MASK);
+
+	return valid == 0 && internal == 0 && irq_done;
+}
+
+/* Downstream btif_dma_plat.c:687-761 (hal_tx_dma_irq_handler) */
+irqreturn_t btif_dma_tx_irq(int irq, void *data)
+{
+	struct btif_dma_chan *chan = data;
+	unsigned int vff_len;
+	unsigned int valid_size;
+	unsigned int left_len;
+
+	vff_len = btif_dma_readl(chan, BTIF_DMA_REG_VFF_LEN);
+	valid_size = btif_dma_readl(chan, BTIF_DMA_REG_VFF_VALID_SIZE);
+	left_len = btif_dma_readl(chan, BTIF_DMA_REG_VFF_LEFT_SIZE);
+
+	if (valid_size > 0 && valid_size < 8) {
+		btif_dma_tx_flush(chan);
+		if (++chan->flush_irq_count >= 512) {
+			dev_err(chan->btif->dev,
+				"BTIF TX stalled, disabling TX DMA irq\n");
+			btif_dma_writel(chan,
+					btif_dma_readl(chan,
+						BTIF_DMA_REG_INT_FLAG) &
+					~BTIF_TX_DMA_INT_FLAG_MASK,
+					BTIF_DMA_REG_INT_FLAG);
+			btif_dma_writel(chan,
+					btif_dma_readl(chan,
+						BTIF_DMA_REG_INT_EN) &
+					~BTIF_TX_DMA_INTEN_BIT,
+					BTIF_DMA_REG_INT_EN);
+		}
+	} else if (vff_len == left_len) {
+		chan->flush_irq_count = 0;
+		btif_dma_writel(chan, btif_dma_readl(chan,
+					BTIF_DMA_REG_INT_FLAG) &
+					~BTIF_TX_DMA_INT_FLAG_MASK,
+				BTIF_DMA_REG_INT_FLAG);
+		btif_dma_writel(chan, btif_dma_readl(chan,
+					BTIF_DMA_REG_INT_EN) &
+					~BTIF_TX_DMA_INTEN_BIT,
+				BTIF_DMA_REG_INT_EN);
+	} else {
+		dev_dbg(chan->btif->dev,
+			"spurious BTIF TX DMA irq, vff_len %u left %u valid %u\n",
+			vff_len, left_len, valid_size);
+	}
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * Downstream btif_dma_plat.c:974-1079 (hal_rx_dma_irq_handler): move the
+ * received bytes out of the virtual FIFO, hand them to the staging ring and
+ * publish the read pointer back to the hardware.
+ */
+irqreturn_t btif_dma_rx_irq(int irq, void *data)
+{
+	struct btif_dma_chan *chan = data;
+	struct mtk_btif *btif = chan->btif;
+	struct btif_vfifo *vfifo = &chan->vfifo;
+	unsigned int valid_len;
+	unsigned int wpt;
+	unsigned int rpt;
+	unsigned int real_len;
+	unsigned int tail_len;
+	unsigned int budget = 64;
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_INT_EN) &
+			      ~(BTIF_RX_DMA_INT_THRE_EN |
+				BTIF_RX_DMA_INT_DONE_EN), BTIF_DMA_REG_INT_EN);
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_INT_FLAG) |
+			      BTIF_RX_DMA_INT_DONE | BTIF_RX_DMA_INT_THRE,
+			BTIF_DMA_REG_INT_FLAG);
+
+	valid_len = btif_dma_readl(chan, BTIF_DMA_REG_VFF_VALID_SIZE);
+	rpt = btif_dma_readl(chan, BTIF_DMA_REG_VFF_RPT);
+	wpt = btif_dma_readl(chan, BTIF_DMA_REG_VFF_WPT);
+
+	while ((valid_len > 0 || rpt != wpt) && budget--) {
+		unsigned int rpt_wrap = rpt & BTIF_DMA_RPT_WRAP;
+		unsigned int wpt_wrap = wpt & BTIF_DMA_WPT_WRAP;
+
+		rpt &= BTIF_DMA_RPT_MASK;
+		wpt &= BTIF_DMA_WPT_MASK;
+
+		if (wpt_wrap != vfifo->last_wpt_wrap)
+			real_len = wpt + vfifo->size - rpt;
+		else
+			real_len = wpt - rpt;
+
+		tail_len = vfifo->size - rpt;
+		if (tail_len >= real_len) {
+			btif_rx_ring_write(btif, (u8 *)vfifo->vir + rpt, real_len);
+		} else {
+			btif_rx_ring_write(btif, (u8 *)vfifo->vir + rpt, tail_len);
+			btif_rx_ring_write(btif, vfifo->vir,
+					   real_len - tail_len);
+		}
+
+		/* bytes are consumed now; publish the read pointer */
+		rmb();
+		rpt += real_len;
+		if (rpt >= vfifo->size) {
+			rpt_wrap ^= BTIF_DMA_RPT_WRAP;
+			rpt %= vfifo->size;
+		}
+		rpt |= rpt_wrap;
+
+		vfifo->wpt = wpt;
+		vfifo->last_wpt_wrap = wpt_wrap;
+		vfifo->rpt = rpt;
+		vfifo->last_rpt_wrap = rpt_wrap;
+		btif_dma_writel(chan, rpt, BTIF_DMA_REG_VFF_RPT);
+
+		valid_len = btif_dma_readl(chan, BTIF_DMA_REG_VFF_VALID_SIZE);
+		rpt = btif_dma_readl(chan, BTIF_DMA_REG_VFF_RPT);
+		wpt = btif_dma_readl(chan, BTIF_DMA_REG_VFF_WPT);
+	}
+
+	if (!budget)
+		dev_warn_ratelimited(btif->dev, "BTIF RX DMA drain budget hit\n");
+
+	btif_dma_writel(chan, btif_dma_readl(chan, BTIF_DMA_REG_INT_EN) |
+			      BTIF_RX_DMA_INT_THRE_EN |
+			      BTIF_RX_DMA_INT_DONE_EN, BTIF_DMA_REG_INT_EN);
+
+	complete(&btif->rx_comp);
+	return IRQ_HANDLED;
+}
+
+/* Downstream btif_dma_plat.c:1081-1254 */
+void btif_dma_dump_regs(struct btif_dma_chan *chan)
+{
+	struct device *dev = chan->btif->dev;
+	const char *dir = chan->dir == BTIF_DMA_TX ? "TX" : "RX";
+
+	dev_info(dev, "BTIF %s DMA base %p\n", dir, chan->base);
+	dev_info(dev, "%s EN 0x%08x STOP 0x%08x FLUSH 0x%08x INT_FLAG 0x%08x INT_EN 0x%08x\n",
+		 dir, btif_dma_readl(chan, BTIF_DMA_REG_EN),
+		 btif_dma_readl(chan, BTIF_DMA_REG_STOP),
+		 btif_dma_readl(chan, BTIF_DMA_REG_FLUSH),
+		 btif_dma_readl(chan, BTIF_DMA_REG_INT_FLAG),
+		 btif_dma_readl(chan, BTIF_DMA_REG_INT_EN));
+	dev_info(dev, "%s VFF_ADDR 0x%08x LEN 0x%08x THRE 0x%08x WPT 0x%08x RPT 0x%08x\n",
+		 dir, btif_dma_readl(chan, BTIF_DMA_REG_VFF_ADDR),
+		 btif_dma_readl(chan, BTIF_DMA_REG_VFF_LEN),
+		 btif_dma_readl(chan, BTIF_DMA_REG_VFF_THRE),
+		 btif_dma_readl(chan, BTIF_DMA_REG_VFF_WPT),
+		 btif_dma_readl(chan, BTIF_DMA_REG_VFF_RPT));
+	dev_info(dev, "%s INT_BUF_SIZE 0x%08x VALID 0x%08x LEFT 0x%08x DBG 0x%08x\n",
+		 dir, btif_dma_readl(chan, BTIF_DMA_REG_INT_BUF_SIZE),
+		 btif_dma_readl(chan, BTIF_DMA_REG_VFF_VALID_SIZE),
+		 btif_dma_readl(chan, BTIF_DMA_REG_VFF_LEFT_SIZE),
+		 btif_dma_readl(chan, BTIF_DMA_REG_DBG_STATUS));
+}
diff --git a/drivers/misc/mediatek/btif/btif_hw.c b/drivers/misc/mediatek/btif/btif_hw.c
new file mode 100644
index 000000000..7f1b037fe
--- /dev/null
+++ b/drivers/misc/mediatek/btif/btif_hw.c
@@ -0,0 +1,330 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek BTIF controller hardware operations (PIO path, interrupts,
+ * wakeup signalling and clock control).
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/btif/common/btif_plat.c
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/kfifo.h>
+#include <linux/spinlock.h>
+
+#include "btif_core.h"
+#include "btif_regs.h"
+
+u32 btif_readl(struct mtk_btif *btif, u32 off)
+{
+	return readl(btif->base + off);
+}
+
+void btif_writel(struct mtk_btif *btif, u32 val, u32 off)
+{
+	writel(val, btif->base + off);
+}
+
+u8 btif_readb(struct mtk_btif *btif, u32 off)
+{
+	return readb(btif->base + off);
+}
+
+void btif_writeb(struct mtk_btif *btif, u8 val, u32 off)
+{
+	writeb(val, btif->base + off);
+}
+
+/*
+ * Clock control.  Downstream keeps two independent reference counters
+ * (hal_btif_clk_ctrl() in btif_plat.c:321 and hal_btif_dma_clk_ctrl() in
+ * btif_dma_plat.c:263, each wrapping clk_enable()/clk_disable()).  The CCF
+ * already reference counts enable/disable, so wrap it directly.
+ */
+int btif_clk_enable(struct mtk_btif *btif)
+{
+	return clk_enable(btif->clk_btif);
+}
+
+void btif_clk_disable(struct mtk_btif *btif)
+{
+	clk_disable(btif->clk_btif);
+}
+
+int btif_apdma_clk_enable(struct mtk_btif *btif)
+{
+	return clk_enable(btif->clk_apdma);
+}
+
+void btif_apdma_clk_disable(struct mtk_btif *btif)
+{
+	clk_disable(btif->clk_apdma);
+}
+
+/* Downstream btif_plat.c:535-575 */
+void btif_hw_tx_ier(struct mtk_btif *btif, bool en)
+{
+	u32 val = btif_readl(btif, BTIF_REG_IER);
+
+	if (en)
+		val |= BTIF_IER_TXEEN;
+	else
+		val &= ~BTIF_IER_TXEEN;
+
+	btif_writel(btif, val, BTIF_REG_IER);
+}
+
+/* Downstream btif_plat.c:535-548 */
+void btif_hw_rx_ier(struct mtk_btif *btif, bool en)
+{
+	u32 val = btif_readl(btif, BTIF_REG_IER);
+
+	if (en)
+		val |= BTIF_IER_RXFEN;
+	else
+		val &= ~BTIF_IER_RXFEN;
+
+	btif_writel(btif, val, BTIF_REG_IER);
+}
+
+/* Downstream btif_plat.c:938-979 */
+int btif_hw_tx_mode(struct mtk_btif *btif, enum btif_mode mode)
+{
+	u32 val = btif_readl(btif, BTIF_REG_DMA_EN);
+
+	if (mode == BTIF_MODE_DMA)
+		val |= BTIF_DMA_EN_TX;
+	else
+		val &= ~BTIF_DMA_EN_TX;
+
+	btif_writel(btif, val, BTIF_REG_DMA_EN);
+	return 0;
+}
+
+int btif_hw_rx_mode(struct mtk_btif *btif, enum btif_mode mode)
+{
+	u32 val = btif_readl(btif, BTIF_REG_DMA_EN);
+
+	if (mode == BTIF_MODE_DMA)
+		val |= BTIF_DMA_EN_RX;
+	else
+		val &= ~BTIF_DMA_EN_RX;
+
+	btif_writel(btif, val, BTIF_REG_DMA_EN);
+	return 0;
+}
+
+/* Downstream btif_plat.c:708-722 */
+int btif_hw_loopback(struct mtk_btif *btif, bool en)
+{
+	u32 val = btif_readl(btif, BTIF_REG_TRI_LVL);
+
+	if (en)
+		val |= BTIF_TRI_LOOP_EN;
+	else
+		val &= ~BTIF_TRI_LOOP_EN;
+
+	btif_writel(btif, val, BTIF_REG_TRI_LVL);
+	return 0;
+}
+
+/*
+ * Downstream btif_plat.c:476-522 (hal_btif_hw_init): normal mode, new
+ * handshake, FIFO flush, trigger levels, PIO default, RX auto-reset and
+ * RX interrupt enable.  The TX interrupt stays masked until data is queued.
+ */
+int btif_hw_init(struct mtk_btif *btif)
+{
+	struct kfifo *fifo = btif->tx_fifo;
+
+	if (fifo)
+		kfifo_reset(fifo);
+
+	/* normal (non-UART) mode */
+	btif_writel(btif, BTIF_FAKELCR_NORMAL_MODE, BTIF_REG_FAKELCR);
+
+	/* new handshake mode */
+	btif_writel(btif, btif_readl(btif, BTIF_REG_HANDSHAKE) |
+			  BTIF_HANDSHAKE_EN, BTIF_REG_HANDSHAKE);
+
+	/* flush both FIFOs */
+	btif_writel(btif, btif_readl(btif, BTIF_REG_FIFOCTRL) |
+			  BTIF_FIFOCTRL_CLR_RX, BTIF_REG_FIFOCTRL);
+	btif_writel(btif, btif_readl(btif, BTIF_REG_FIFOCTRL) &
+			  ~BTIF_FIFOCTRL_CLR_RX, BTIF_REG_FIFOCTRL);
+	btif_writel(btif, btif_readl(btif, BTIF_REG_FIFOCTRL) |
+			  BTIF_FIFOCTRL_CLR_TX, BTIF_REG_FIFOCTRL);
+	btif_writel(btif, btif_readl(btif, BTIF_REG_FIFOCTRL) &
+			  ~BTIF_FIFOCTRL_CLR_TX, BTIF_REG_FIFOCTRL);
+
+	btif_writel(btif, BTIF_TRI_LVL_TX(BTIF_TX_FIFO_THRE) |
+			  BTIF_TRI_LVL_RX(BTIF_RX_FIFO_THRE),
+		    BTIF_REG_TRI_LVL);
+	btif_hw_loopback(btif, false);
+
+	/* default to PIO, DMA is enabled later by the DMA setup path */
+	btif_hw_tx_mode(btif, BTIF_MODE_PIO);
+	btif_hw_rx_mode(btif, BTIF_MODE_PIO);
+
+	/* auto reset of the RX timeout counter */
+	btif_writel(btif, btif_readl(btif, BTIF_REG_DMA_EN) |
+			  BTIF_DMA_EN_AUTORST_EN, BTIF_REG_DMA_EN);
+
+	btif_hw_tx_ier(btif, false);
+	btif_hw_rx_ier(btif, true);
+	return 0;
+}
+
+/*
+ * PIO transmit: queue into the controller FIFO staging kfifo and let the
+ * TX-empty interrupt push bytes into THR.  Downstream btif_plat.c:993-1075.
+ */
+int btif_hw_send(struct mtk_btif *btif, const u8 *buf, unsigned int len)
+{
+	unsigned long flags;
+	unsigned int room;
+	unsigned int queued;
+
+	room = kfifo_avail(btif->tx_fifo);
+	queued = min(len, room);
+	if (!queued)
+		return 0;
+
+	spin_lock_irqsave(&btif->tx_lock, flags);
+	queued = kfifo_in(btif->tx_fifo, buf, queued);
+	if (queued)
+		btif_hw_tx_ier(btif, true);
+	spin_unlock_irqrestore(&btif->tx_lock, flags);
+
+	return queued;
+}
+
+/* Downstream btif_plat.c:874-925 */
+int btif_hw_tx_irq(struct mtk_btif *btif)
+{
+	unsigned long flags;
+	unsigned int lsr;
+	unsigned int avail;
+	unsigned int count;
+	u8 local[BTIF_TX_FIFO_DEPTH];
+	unsigned int i;
+
+	lsr = btif_readl(btif, BTIF_REG_LSR);
+	if (lsr & BTIF_LSR_TEMT)
+		avail = BTIF_TX_FIFO_DEPTH;
+	else if (lsr & BTIF_LSR_THRE)
+		avail = BTIF_TX_FIFO_DEPTH - BTIF_TX_FIFO_THRE;
+	else
+		return 0;
+
+	spin_lock_irqsave(&btif->tx_lock, flags);
+	count = kfifo_out(btif->tx_fifo, local, avail);
+	spin_unlock_irqrestore(&btif->tx_lock, flags);
+
+	for (i = 0; i < count; i++)
+		btif_writeb(btif, local[i], BTIF_REG_THR);
+
+	spin_lock_irqsave(&btif->tx_lock, flags);
+	if (kfifo_is_empty(btif->tx_fifo))
+		btif_hw_tx_ier(btif, false);
+	spin_unlock_irqrestore(&btif->tx_lock, flags);
+
+	return count;
+}
+
+/*
+ * PIO receive: drain the RX FIFO into the staging ring.
+ * Downstream btif_plat.c:816-860.
+ */
+int btif_hw_rx_drain(struct mtk_btif *btif)
+{
+	u8 local[256];
+	unsigned int len = 0;
+	unsigned int iir;
+
+	iir = btif_readl(btif, BTIF_REG_IIR);
+	while ((iir & (BTIF_IIR_RX | BTIF_IIR_RX_TIMEOUT)) &&
+	       len < sizeof(local)) {
+		local[len++] = btif_readb(btif, BTIF_REG_RBR);
+		iir = btif_readl(btif, BTIF_REG_IIR);
+	}
+
+	if (len)
+		btif_rx_ring_write(btif, local, len);
+
+	return len;
+}
+
+/*
+ * Wake the connectivity SoC.  Writing 0 pulses the wake line low for longer
+ * than a 32 kHz period (downstream uses a 64..96 us sleep) before releasing
+ * it.  Downstream btif_plat.c:1088-1112.
+ */
+int btif_hw_raise_wake(struct mtk_btif *btif)
+{
+	btif_writel(btif, btif_readl(btif, BTIF_REG_WAK) & ~BTIF_WAK_BIT,
+		    BTIF_REG_WAK);
+	usleep_range(64, 96);
+	btif_writel(btif, btif_readl(btif, BTIF_REG_WAK) | BTIF_WAK_BIT,
+		    BTIF_REG_WAK);
+	return 0;
+}
+
+/*
+ * TX is complete when THR and the shift register are empty, the TX interrupt
+ * is masked, no RX byte is pending and the staging kfifo drained.
+ * Downstream btif_plat.c:1204-1241.
+ */
+bool btif_hw_is_tx_complete(struct mtk_btif *btif)
+{
+	unsigned long flags;
+	bool complete;
+	u32 lsr;
+
+	lsr = btif_readl(btif, BTIF_REG_LSR);
+	complete = (lsr & BTIF_LSR_TEMT) &&
+		   !(btif_readl(btif, BTIF_REG_IER) & BTIF_IER_TXEEN) &&
+		   !(lsr & BTIF_LSR_DR);
+
+	if (complete) {
+		spin_lock_irqsave(&btif->tx_lock, flags);
+		complete = kfifo_is_empty(btif->tx_fifo);
+		spin_unlock_irqrestore(&btif->tx_lock, flags);
+	}
+
+	return complete;
+}
+
+/* Downstream btif_plat.c:1125-1192 (register dump used by debug control) */
+void btif_hw_dump_regs(struct mtk_btif *btif)
+{
+	struct device *dev = btif->dev;
+	unsigned int i;
+
+	dev_info(dev, "BTIF register dump:\n");
+	dev_info(dev, "IER 0x%08x IIR 0x%08x LSR 0x%08x\n",
+		 btif_readl(btif, BTIF_REG_IER),
+		 btif_readl(btif, BTIF_REG_IIR),
+		 btif_readl(btif, BTIF_REG_LSR));
+	dev_info(dev, "FAKELCR 0x%08x SLEEP_EN 0x%08x DMA_EN 0x%08x\n",
+		 btif_readl(btif, BTIF_REG_FAKELCR),
+		 btif_readl(btif, BTIF_REG_SLEEP_EN),
+		 btif_readl(btif, BTIF_REG_DMA_EN));
+	dev_info(dev, "RTOCNT 0x%08x TRI_LVL 0x%08x WAT_TIME 0x%08x HANDSHAKE 0x%08x\n",
+		 btif_readl(btif, BTIF_REG_RTOCNT),
+		 btif_readl(btif, BTIF_REG_TRI_LVL),
+		 btif_readl(btif, BTIF_REG_WAT_TIME),
+		 btif_readl(btif, BTIF_REG_HANDSHAKE));
+
+	/*
+	 * Skip offset 0x00 (RBR/THR) so the debug dump cannot consume a
+	 * received byte, as downstream does (btif_plat.c:1147-1150).
+	 */
+	for (i = 1; i < 0xE0 / 4; i++)
+		dev_info(dev, "BTIF[0x%02x] = 0x%08x\n", i * 4,
+			 btif_readl(btif, i * 4));
+}
diff --git a/drivers/misc/mediatek/btif/btif_regs.h b/drivers/misc/mediatek/btif/btif_regs.h
new file mode 100644
index 000000000..869b60bfc
--- /dev/null
+++ b/drivers/misc/mediatek/btif/btif_regs.h
@@ -0,0 +1,119 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek BTIF register map.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/btif/common/plat_inc/btif_priv.h
+ *   drivers/misc/mediatek/btif/common/plat_inc/btif_dma_priv.h
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#ifndef __BTIF_REGS_H__
+#define __BTIF_REGS_H__
+
+/* BTIF controller registers, downstream btif_priv.h:32-45 */
+#define BTIF_REG_RBR		0x00	/* RX buffer register, read only */
+#define BTIF_REG_THR		0x00	/* TX holding register, write only */
+#define BTIF_REG_IER		0x04	/* interrupt enable */
+#define BTIF_REG_IIR		0x08	/* interrupt identification, read only */
+#define BTIF_REG_FIFOCTRL	0x08	/* FIFO control, write only */
+#define BTIF_REG_FAKELCR	0x0c	/* fake LCR */
+#define BTIF_REG_LSR		0x14	/* line status */
+#define BTIF_REG_SLEEP_EN	0x48	/* sleep enable */
+#define BTIF_REG_DMA_EN		0x4c	/* DMA enable */
+#define BTIF_REG_RTOCNT		0x54	/* RX timeout count */
+#define BTIF_REG_TRI_LVL	0x60	/* TX/RX trigger level */
+#define BTIF_REG_WAK		0x64	/* module wakeup, write only */
+#define BTIF_REG_WAT_TIME	0x68	/* async wait time */
+#define BTIF_REG_HANDSHAKE	0x6c	/* new handshake control */
+
+/* BTIF_REG_IER bits, downstream btif_priv.h:48-49 */
+#define BTIF_IER_TXEEN		BIT(1)	/* TX holding register empty */
+#define BTIF_IER_RXFEN		BIT(0)	/* RX buffer contains data */
+
+/* BTIF_REG_IIR bits, downstream btif_priv.h:52-55 */
+#define BTIF_IIR_NINT		BIT(0)	/* no interrupt pending */
+#define BTIF_IIR_TX_EMPTY	BIT(1)	/* TX holding register empty */
+#define BTIF_IIR_RX		BIT(2)	/* RX data received */
+#define BTIF_IIR_RX_TIMEOUT	(0x11 << 2)
+
+/* BTIF_REG_LSR bits, downstream btif_priv.h:58-60 */
+#define BTIF_LSR_DR		BIT(0)
+#define BTIF_LSR_THRE		BIT(5)
+#define BTIF_LSR_TEMT		BIT(6)
+
+/* BTIF_REG_FIFOCTRL bits, downstream btif_priv.h:63-64 */
+#define BTIF_FIFOCTRL_CLR_TX	BIT(2)
+#define BTIF_FIFOCTRL_CLR_RX	BIT(1)
+
+/* BTIF_REG_FAKELCR values, downstream btif_priv.h:67 */
+#define BTIF_FAKELCR_NORMAL_MODE	0x0
+
+/* BTIF_REG_SLEEP_EN bits, downstream btif_priv.h:70-71 */
+#define BTIF_SLEEP_EN_BIT	BIT(0)
+
+/* BTIF_REG_DMA_EN bits, downstream btif_priv.h:74-78 */
+#define BTIF_DMA_EN_RX		BIT(0)
+#define BTIF_DMA_EN_TX		BIT(1)
+#define BTIF_DMA_EN_AUTORST_EN	BIT(2)
+
+/* BTIF_REG_TRI_LVL bits, downstream btif_priv.h:81-88 */
+#define BTIF_TRI_LVL_TX_MASK	(0xf << 0)
+#define BTIF_TRI_LVL_RX_MASK	(0x7 << 4)
+#define BTIF_TRI_LVL_TX(x)	(((x) & 0xf) << 0)
+#define BTIF_TRI_LVL_RX(x)	(((x) & 0x7) << 4)
+#define BTIF_TRI_LOOP_EN	BIT(7)
+
+/* BTIF_REG_WAK bits, downstream btif_priv.h:91 */
+#define BTIF_WAK_BIT		BIT(0)
+
+/* BTIF_REG_HANDSHAKE values, downstream btif_priv.h:94-95 */
+#define BTIF_HANDSHAKE_EN	1
+
+/*
+ * APDMA BTIF channel registers.  Both directions use the same layout at a
+ * different base address (0x11000880 for TX, 0x11000900 for RX).
+ * Downstream btif_dma_priv.h:44-96.
+ */
+#define BTIF_DMA_REG_INT_FLAG		0x00
+#define BTIF_DMA_REG_INT_EN		0x04
+#define BTIF_DMA_REG_EN			0x08
+#define BTIF_DMA_REG_RST		0x0c
+#define BTIF_DMA_REG_STOP		0x10
+#define BTIF_DMA_REG_FLUSH		0x14
+#define BTIF_DMA_REG_VFF_ADDR		0x1c
+#define BTIF_DMA_REG_VFF_LEN		0x24
+#define BTIF_DMA_REG_VFF_THRE		0x28
+#define BTIF_DMA_REG_VFF_WPT		0x2c
+#define BTIF_DMA_REG_VFF_RPT		0x30
+#define BTIF_DMA_REG_INT_BUF_SIZE	0x38
+#define BTIF_DMA_REG_VFF_VALID_SIZE	0x3c
+#define BTIF_DMA_REG_VFF_LEFT_SIZE	0x40
+#define BTIF_DMA_REG_DBG_STATUS		0x50
+
+/* Downstream btif_dma_priv.h:98-145 */
+#define BTIF_DMA_EN_BIT			BIT(0)
+#define BTIF_DMA_STOP_BIT		BIT(0)
+#define BTIF_DMA_RST_BIT		BIT(0)
+#define BTIF_DMA_FLUSH_BIT		BIT(0)
+
+#define BTIF_DMA_WARM_RST		BIT(0)
+#define BTIF_DMA_HARD_RST		BIT(1)
+
+#define BTIF_DMA_WPT_MASK		0x0000ffff
+#define BTIF_DMA_WPT_WRAP		0x00010000
+#define BTIF_DMA_RPT_MASK		0x0000ffff
+#define BTIF_DMA_RPT_WRAP		0x00010000
+
+/* TX channel interrupt bits, downstream btif_dma_priv.h:113-125 */
+#define BTIF_TX_DMA_INT_FLAG_MASK	0x1
+#define BTIF_TX_DMA_INTEN_BIT		BIT(0)
+
+/* RX channel interrupt bits, downstream btif_dma_priv.h:128-145 */
+#define BTIF_RX_DMA_INT_THRE		BIT(0)
+#define BTIF_RX_DMA_INT_DONE		BIT(1)
+#define BTIF_RX_DMA_INT_THRE_EN		BIT(0)
+#define BTIF_RX_DMA_INT_DONE_EN		BIT(1)
+
+#endif /* __BTIF_REGS_H__ */
