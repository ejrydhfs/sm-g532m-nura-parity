+/*
+ * Samsung grandpplte module link frequencies.
+ *
+ * [INFERENCE] The rates are not stated directly downstream; they are derived
+ * from the output PLL programmed by each mode. The CSI-2 link frequency is
+ *
+ *	link_freq = INCK * PLL_OP_MPY / (2 * PREPLLCK_OP_DIV)
+ *
+ * with INCK = 24 MHz (imgsensor_info.mclk, imx219mipiraw_Sensor.c:159) and
+ * PREPLLCK_OP_DIV = 3 (register 0x0305, the "AUTO" value also used by the
+ * generic tables above). The formula reproduces both rates of the generic
+ * driver exactly: PLL_OP_MPY 114 -> 456 MHz (2-lane default) and
+ * PLL_OP_MPY 91 -> 364 MHz (4-lane default). The Samsung modes program
+ * 0x030c/0x030d = 0x0068, 0x0056 and 0x0055 respectively, giving
+ * 416 MHz, 344 MHz and 340 MHz.
+ */
+static const s64 imx219_samsung_link_freq_menu[] = {
+	416000000,
+	344000000,
+	340000000,
+};
