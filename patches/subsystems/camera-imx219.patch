+/*
+ * Power up order, voltage and post-enable delay of the Samsung module,
+ * transcribed from kd_camera_hw.c:494-525:
+ *   VCAM_A 2.8 V, VCAM_D 1.2 V, VCAM_AF 2.8 V, mdelay(2),
+ *   VCAM_IO 1.8 V, mdelay(3), MCLK on, mdelay(1), PDN high, RESET high.
+ */
+struct imx219_power_rail {
+	unsigned int supply;
+	unsigned int uV;
+	unsigned int delay_ms;
+};
