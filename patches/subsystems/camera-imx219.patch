+static const struct imx219_power_rail imx219_samsung_power_on_seq[] = {
+	{ 0, 2800000, 0 },	/* VCAM_A, kd_camera_hw.c:495 */
+	{ 1, 1200000, 0 },	/* VCAM_D, kd_camera_hw.c:500 */
+	{ 2, 2800000, 2 },	/* VCAM_AF, kd_camera_hw.c:506 + mdelay(2) :511 */
+	{ 3, 1800000, 3 },	/* VCAM_IO, kd_camera_hw.c:514 + mdelay(3) :519 */
+};
+
+/*
+ * Power down sequence: VCAM_AF, MCLK, PDN/RESET low, VCAM_IO, VCAM_D, VCAM_A
