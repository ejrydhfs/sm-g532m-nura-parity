+void ccci_cldma_stop(struct ccci_cldma *cd);
+int ccci_cldma_send(struct ccci_cldma *cd, unsigned int qno, struct sk_buff *skb);
+void ccci_cldma_set_rx_cb(struct ccci_cldma *cd,
