diff --git a/drivers/misc/mediatek/ccci_util/ccci_util_dump.c b/drivers/misc/mediatek/ccci_util/ccci_util_dump.c
new file mode 100644
index 000000000..02f61be2f
--- /dev/null
+++ b/drivers/misc/mediatek/ccci_util/ccci_util_dump.c
@@ -0,0 +1,414 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * CCCI memory dump helpers and the debugfs request interface for dumping the
+ * modem shared-memory window.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/ccci_util/ccci_private_log.c
+ *     - ccci_util_mem_dump()       (line 752)
+ *     - ccci_util_cmpt_mem_dump()  (line 793)
+ *   drivers/misc/mediatek/eccci/ccci_core.c: get_smem_start_addr() (line 773)
+ *
+ * Downstream obtained the modem shared-memory mapping from the CCCI core via
+ * get_smem_start_addr(); the util driver must not depend on the core, so the
+ * window is registered with ccci_util_dump_set_window() instead.  A request
+ * for an MD without a registered window returns -ENODEV.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/printk.h>
+#include <linux/ccci.h>
+
+#include "ccci_util.h"
+
+/* Upper bound for a single debugfs dump request. */
+#define CCCI_UTIL_DUMP_REQ_MAX		SZ_64K
+
+struct ccci_util_dump_win {
+	phys_addr_t phys;
+	size_t size;
+	void *base;
+	bool valid;
+};
+
+static struct ccci_util_dump_win ccci_util_win[CCCI_MAX_MD_NUM];
+static DEFINE_MUTEX(ccci_util_win_lock);
+static struct dentry *ccci_util_dump_req;
+static struct dentry *ccci_util_dump_window;
+
+/**
+ * ccci_util_dump_set_window() - register the modem shared-memory window
+ * @md_id:	modem index (0 == MD_SYS1)
+ * @phys:	physical base of the AP view of the MD shared memory
+ * @size:	window size in bytes
+ *
+ * The CCCI core (or the platform code that reserved the MD shared memory)
+ * calls this once the region is known.  Returns 0 on success.
+ */
+int ccci_util_dump_set_window(unsigned int md_id, phys_addr_t phys, size_t size)
+{
+	struct ccci_util_dump_win *win;
+	void *base;
+
+	if (md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+	if (!size || !IS_ALIGNED(phys, PAGE_SIZE))
+		return -EINVAL;
+	if (phys + size < phys)
+		return -EINVAL;
+
+	base = memremap(phys, size, MEMREMAP_WB);
+	if (!base)
+		return -ENOMEM;
+
+	mutex_lock(&ccci_util_win_lock);
+
+	win = &ccci_util_win[md_id];
+	if (win->valid)
+		memunmap(win->base);
+
+	win->phys = phys;
+	win->size = size;
+	win->base = base;
+	win->valid = true;
+
+	mutex_unlock(&ccci_util_win_lock);
+
+	pr_info("[ccci%u/util] dump window %pa+0x%zx\n", md_id + 1, &phys, size);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ccci_util_dump_set_window);
+
+void ccci_util_dump_clear_window(unsigned int md_id)
+{
+	struct ccci_util_dump_win *win;
+
+	if (md_id >= CCCI_MAX_MD_NUM)
+		return;
+
+	mutex_lock(&ccci_util_win_lock);
+	win = &ccci_util_win[md_id];
+	if (win->valid) {
+		memunmap(win->base);
+		win->base = NULL;
+		win->phys = 0;
+		win->size = 0;
+		win->valid = false;
+	}
+	mutex_unlock(&ccci_util_win_lock);
+}
+EXPORT_SYMBOL_GPL(ccci_util_dump_clear_window);
+
+/* ------------------------------------------------------------------ */
+/* Hex/ASCII dump helpers                                              */
+/* ------------------------------------------------------------------ */
+
+/**
+ * ccci_util_dump_hex() - append a hex+ASCII dump of a kernel buffer
+ * @md_id:	modem index selecting the dump ring
+ * @buf_type:	CCCI_DUMP_* ring selector
+ * @buf:	buffer to dump
+ * @len:	number of bytes
+ */
+void ccci_util_dump_hex(int md_id, int buf_type, const void *buf, size_t len)
+{
+	const u8 *p = buf;
+	char line[128];
+	size_t off, n;
+
+	if (!buf) {
+		ccci_util_dump_write(md_id, buf_type, 0, "start_addr <NULL>\n");
+		return;
+	}
+	if (!len) {
+		ccci_util_dump_write(md_id, buf_type, 0, "len [0]\n");
+		return;
+	}
+
+	for (off = 0; off < len; off += 16) {
+		n = min_t(size_t, 16, len - off);
+		hex_dump_to_buffer(p + off, n, 16, 1, line, sizeof(line), true);
+		ccci_util_dump_write(md_id, buf_type, 0, "%08zX: %s\n", off,
+				     line);
+	}
+}
+EXPORT_SYMBOL_GPL(ccci_util_dump_hex);
+
+/* Downstream ccci_util_mem_dump(), ccci_private_log.c:752. */
+void ccci_util_mem_dump(int md_id, int buf_type, void *start_addr, int len)
+{
+	unsigned int *curr_p = (unsigned int *)start_addr;
+	unsigned char *curr_ch_p;
+	int _16_fix_num = len / 16;
+	int tail_num = len % 16;
+	unsigned char tail[16];
+	int i, j;
+
+	if (curr_p == NULL) {
+		ccci_util_dump_write(md_id, buf_type, 0, "start_addr <NULL>\n");
+		return;
+	}
+	if (len == 0) {
+		ccci_util_dump_write(md_id, buf_type, 0, "len [0]\n");
+		return;
+	}
+
+	ccci_util_dump_write(md_id, buf_type, 0, "Base: %px\n", start_addr);
+	for (i = 0; i < _16_fix_num; i++) {
+		ccci_util_dump_write(md_id, buf_type, 0,
+				     "%03X: %08X %08X %08X %08X\n",
+				     i * 16, *curr_p, *(curr_p + 1),
+				     *(curr_p + 2), *(curr_p + 3));
+		curr_p += 4;
+	}
+
+	if (tail_num > 0) {
+		curr_ch_p = (unsigned char *)curr_p;
+		for (j = 0; j < tail_num; j++)
+			tail[j] = *curr_ch_p++;
+		for (; j < 16; j++)
+			tail[j] = 0;
+		curr_p = (unsigned int *)tail;
+		ccci_util_dump_write(md_id, buf_type, 0,
+				     "%03X: %08X %08X %08X %08X\n",
+				     i * 16, *curr_p, *(curr_p + 1),
+				     *(curr_p + 2), *(curr_p + 3));
+	}
+}
+EXPORT_SYMBOL_GPL(ccci_util_mem_dump);
+
+/* Downstream ccci_util_cmpt_mem_dump(), ccci_private_log.c:793. */
+void ccci_util_cmpt_mem_dump(int md_id, int buf_type, void *start_addr, int len)
+{
+	unsigned int *curr_p = (unsigned int *)start_addr;
+	unsigned char *curr_ch_p;
+	int _64_fix_num = len / 64;
+	int tail_num = len % 64;
+	unsigned char tail[64];
+	int i, j;
+
+	if (curr_p == NULL) {
+		ccci_util_dump_write(md_id, buf_type, 0, "start_addr <NULL>\n");
+		return;
+	}
+	if (len == 0) {
+		ccci_util_dump_write(md_id, buf_type, 0, "len [0]\n");
+		return;
+	}
+
+	for (i = 0; i < _64_fix_num; i++) {
+		ccci_util_dump_write(md_id, buf_type, 0,
+				     "%03X: %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X\n",
+				     i * 64,
+				     *curr_p, *(curr_p + 1), *(curr_p + 2),
+				     *(curr_p + 3), *(curr_p + 4), *(curr_p + 5),
+				     *(curr_p + 6), *(curr_p + 7), *(curr_p + 8),
+				     *(curr_p + 9), *(curr_p + 10),
+				     *(curr_p + 11), *(curr_p + 12),
+				     *(curr_p + 13), *(curr_p + 14),
+				     *(curr_p + 15));
+		curr_p += 64 / 4;
+	}
+
+	if (tail_num > 0) {
+		curr_ch_p = (unsigned char *)curr_p;
+		for (j = 0; j < tail_num; j++)
+			tail[j] = *curr_ch_p++;
+		for (; j < 64; j++)
+			tail[j] = 0;
+		curr_p = (unsigned int *)tail;
+		ccci_util_dump_write(md_id, buf_type, 0,
+				     "%03X: %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X %X\n",
+				     i * 64,
+				     *curr_p, *(curr_p + 1), *(curr_p + 2),
+				     *(curr_p + 3), *(curr_p + 4), *(curr_p + 5),
+				     *(curr_p + 6), *(curr_p + 7), *(curr_p + 8),
+				     *(curr_p + 9), *(curr_p + 10),
+				     *(curr_p + 11), *(curr_p + 12),
+				     *(curr_p + 13), *(curr_p + 14),
+				     *(curr_p + 15));
+	}
+}
+EXPORT_SYMBOL_GPL(ccci_util_cmpt_mem_dump);
+
+/* ------------------------------------------------------------------ */
+/* debugfs request interface: "md_id addr len"                         */
+/* ------------------------------------------------------------------ */
+
+static int ccci_util_dump_window_read(unsigned int md_id, u64 addr, u32 len,
+				      void **out)
+{
+	struct ccci_util_dump_win *win;
+	u64 offset;
+	void *buf;
+	int ret = 0;
+
+	*out = NULL;
+
+	if (md_id >= CCCI_MAX_MD_NUM || !len)
+		return -EINVAL;
+	if (len > CCCI_UTIL_DUMP_REQ_MAX)
+		return -EINVAL;
+
+	mutex_lock(&ccci_util_win_lock);
+	win = &ccci_util_win[md_id];
+	if (!win->valid) {
+		ret = -ENODEV;
+		goto out_unlock;
+	}
+	if (addr < win->phys || addr - win->phys >= win->size) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	offset = addr - win->phys;
+	if (len > win->size - offset) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	buf = kmalloc(len, GFP_KERNEL);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto out_unlock;
+	}
+
+	memcpy(buf, win->base + offset, len);
+	*out = buf;
+out_unlock:
+	mutex_unlock(&ccci_util_win_lock);
+
+	return ret;
+}
+
+static ssize_t ccci_util_dump_req_write(struct file *file,
+					const char __user *ubuf, size_t count,
+					loff_t *ppos)
+{
+	unsigned int md_id, len;
+	unsigned long long addr;
+	char *kbuf;
+	void *data = NULL;
+	int ret;
+
+	if (!count)
+		return 0;
+	if (count > 64)
+		return -EINVAL;
+
+	kbuf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	if (sscanf(kbuf, "%u %llx %x", &md_id, &addr, &len) != 3) {
+		kfree(kbuf);
+		return -EINVAL;
+	}
+	kfree(kbuf);
+
+	ret = ccci_util_dump_window_read(md_id, addr, len, &data);
+	if (ret)
+		return ret;
+
+	if (!ccci_util_dump_ring_ready(md_id, CCCI_DUMP_MEM_DUMP)) {
+		kfree(data);
+		return -ENODEV;
+	}
+
+	ccci_util_dump_write(md_id, CCCI_DUMP_MEM_DUMP, 0,
+			     "Base: 0x%llx len: %u\n", addr, len);
+	ccci_util_dump_hex(md_id, CCCI_DUMP_MEM_DUMP, data, len);
+	kfree(data);
+
+	return count;
+}
+
+static const struct file_operations ccci_util_dump_req_fops = {
+	.write		= ccci_util_dump_req_write,
+	.llseek		= noop_llseek,
+};
+
+/*
+ * Window registration through debugfs, for configurations where the CCCI
+ * core does not know the AP view of the MD shared memory yet:
+ *	echo "md_id phys size" > /sys/kernel/debug/ccci/dump_window
+ * A zero size unregisters the window.
+ */
+static ssize_t ccci_util_dump_window_write(struct file *file,
+					   const char __user *ubuf,
+					   size_t count, loff_t *ppos)
+{
+	unsigned long long phys, size;
+	unsigned int md_id;
+	char *kbuf;
+	int ret;
+
+	if (!count)
+		return 0;
+	if (count > 64)
+		return -EINVAL;
+
+	kbuf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(kbuf))
+		return PTR_ERR(kbuf);
+
+	if (sscanf(kbuf, "%u %llx %llx", &md_id, &phys, &size) != 3) {
+		kfree(kbuf);
+		return -EINVAL;
+	}
+	kfree(kbuf);
+
+	if (md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+
+	if (!size) {
+		ccci_util_dump_clear_window(md_id);
+		return count;
+	}
+
+	ret = ccci_util_dump_set_window(md_id, (phys_addr_t)phys,
+					(size_t)size);
+	if (ret)
+		return ret;
+
+	return count;
+}
+
+static const struct file_operations ccci_util_dump_window_fops = {
+	.write		= ccci_util_dump_window_write,
+	.llseek		= noop_llseek,
+};
+
+int ccci_util_dump_debugfs_init(struct dentry *root)
+{
+	if (!root)
+		return 0;
+
+	ccci_util_dump_req = debugfs_create_file("dump", 0200, root, NULL,
+						 &ccci_util_dump_req_fops);
+	ccci_util_dump_window = debugfs_create_file("dump_window", 0200, root,
+						    NULL,
+						    &ccci_util_dump_window_fops);
+
+	return 0;
+}
+
+void ccci_util_dump_debugfs_exit(void)
+{
+	debugfs_remove(ccci_util_dump_req);
+	debugfs_remove(ccci_util_dump_window);
+	ccci_util_dump_req = NULL;
+	ccci_util_dump_window = NULL;
+}
+
+MODULE_DESCRIPTION("MediaTek CCCI memory dump helpers");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/ccci_util/ccci_util_img.c b/drivers/misc/mediatek/ccci_util/ccci_util_img.c
new file mode 100644
index 000000000..fc5c0bd9e
--- /dev/null
+++ b/drivers/misc/mediatek/ccci_util/ccci_util_img.c
@@ -0,0 +1,438 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * CCCI MD image check-header parsing and validation.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/ccci_util/ccci_util_lib_load_img.c
+ *     - check_md_header_v3()      (line 102)
+ *     - md_check_header_parser()  (line 285)
+ *     - md_check_header()         (line 508)
+ *     - ccci_get_md_info_str()    (line 646)
+ *     - ccci_get_md_check_hdr_inf (line 1059)
+ *
+ * Only the image-header part of the downstream loader is reproduced here.
+ * Downstream also opened the modem image through block-device file I/O and
+ * verified it with the secure boot library; on this tree the firmware blob is
+ * supplied by the CCCI core through request_firmware() and secure-image
+ * authentication is a separate hook, so those paths are not duplicated.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+#include <linux/ccci.h>
+
+#include "ccci_util.h"
+
+/* Downstream type_str[], ccci_util_lib_load_img.c:54-75. */
+static const char * const md_type_str[] = {
+	[0]  = "invalid",
+	[1]  = "2g",
+	[2]  = "3g",
+	[3]  = "wg",
+	[4]  = "tg",
+	[5]  = "lwg",
+	[6]  = "ltg",
+	[7]  = "sglte",
+	[8]  = "ultg",
+	[9]  = "ulwg",
+	[10] = "ulwtg",
+	[11] = "ulwcg",
+	[12] = "ulwctg",
+	[13] = "ulttg",
+	[14] = "ulfwg",
+	[15] = "ulfwcg",
+	[16] = "ulctg",
+	[17] = "ultctg",
+	[18] = "ultwg",
+	[19] = "ultwcg",
+	[20] = "ulftg",
+	[21] = "ulfctg",
+};
+
+static_assert(ARRAY_SIZE(md_type_str) == CCCI_MD_MAX_IMG_TYPE + 1,
+	       "md_type_str must cover MAX_IMG_NUM");
+
+/*
+ * Field offsets of the common check-header prefix.  They are identical in
+ * v3, v4 and v5 because v4 only reuses v3's reserved2[] area and v5 only
+ * appends fields after domain_attr[] (ccci_util_lib_main.h:16-96).
+ */
+#define MD_HDR_OFF_VERNO	12
+#define MD_HDR_OFF_PRODUCT_VER	16
+#define MD_HDR_OFF_IMAGE_TYPE	20
+#define MD_HDR_OFF_PLATFORM	24
+#define MD_HDR_OFF_BUILD_TIME	40
+#define MD_HDR_OFF_BUILD_VER	104
+#define MD_HDR_OFF_BIND_SYS_ID	168
+#define MD_HDR_OFF_EXT_ATTR	169
+#define MD_HDR_OFF_MEM_SIZE	172
+#define MD_HDR_OFF_MD_IMG_SIZE	176
+#define MD_HDR_OFF_RPC_SEC	180
+#define MD_HDR_OFF_DSP_OFFSET	184
+#define MD_HDR_OFF_DSP_SIZE	188
+#define MD_HDR_OFF_REGION_NUM	192
+#define MD_HDR_OFF_REGION_INFO	196
+#define MD_HDR_OFF_DOMAIN_ATTR	260
+#define MD_HDR_OFF_ARM7_OFFSET	276
+#define MD_HDR_OFF_ARM7_SIZE	280
+
+/* DSP not loaded into EMI, ccci_util_lib_load_img.c:243. */
+#define MD_DSP_ON_EMI_DISABLED	0xCDCDCDAA
+
+static_assert(sizeof(struct md_check_header_v3) == 284, "v3 layout");
+static_assert(sizeof(struct md_check_header_v4) == 284, "v4 layout");
+static_assert(sizeof(struct md_check_header_v5) == 344, "v5 layout");
+
+static char md_img_info_str[CCCI_MAX_MD_NUM][MD_INFO_STR_LEN];
+static DEFINE_MUTEX(md_img_info_lock);
+
+const char *ccci_util_md_type_str(unsigned int image_type)
+{
+	if (image_type >= ARRAY_SIZE(md_type_str))
+		return "invalid";
+
+	return md_type_str[image_type];
+}
+EXPORT_SYMBOL_GPL(ccci_util_md_type_str);
+
+/* Downstream product_str[], ccci_util_lib_load_img.c:84-88. */
+const char *ccci_util_md_product_str(unsigned int product_ver)
+{
+	switch (product_ver) {
+	case 1:
+		return MD_DEBUG_STR;
+	case 2:
+		return MD_RELEASE_STR;
+	default:
+		return MD_INVALID_STR;
+	}
+}
+EXPORT_SYMBOL_GPL(ccci_util_md_product_str);
+
+static void md_hdr_copy_str(char *dst, size_t dst_size, const u8 *src,
+			    size_t src_size)
+{
+	size_t len = strnlen((const char *)src, src_size);
+
+	len = min(len, dst_size - 1);
+	memcpy(dst, src, len);
+	dst[len] = '\0';
+}
+
+static void md_hdr_build_info_str(int md_id, const char *ap_platform,
+				  unsigned int ap_mem_size,
+				  const struct ccci_util_md_img_info *info)
+{
+	char *str = md_img_info_str[md_id];
+
+	snprintf(str, MD_INFO_STR_LEN,
+		 "MD:%s*%s*%s*%s*%s\nAP:%s*%s*%08x (MD)%08x\n",
+		 info->image_type_str, info->platform, info->build_ver,
+		 info->build_time, info->product_ver_str,
+		 info->image_type_str, ap_platform ?: "unknown",
+		 ap_mem_size, info->mem_size);
+}
+
+char *ccci_get_md_info_str(int md_id)
+{
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return NULL;
+
+	return md_img_info_str[md_id];
+}
+EXPORT_SYMBOL_GPL(ccci_get_md_info_str);
+
+/**
+ * ccci_util_md_check_header() - parse and validate an MD image check header
+ * @md_id:	modem index (0 == MD_SYS1); bind_sys_id must equal md_id + 1
+ * @hdr:	start of the check header ("CHECK_HEADER")
+ * @hdr_len:	bytes available at @hdr
+ * @md_mem_size: AP reserved MD memory size, 0 if unknown (downstream md_size)
+ * @ap_img_size: AP reserved image size, 0 if unknown (downstream image->size)
+ * @ap_platform: AP platform string for the info line, may be NULL
+ * @info:	decoded header
+ *
+ * Mirrors check_md_header_v3()/md_check_header_parser() from the downstream
+ * loader.  Returns 0 on success, -EOPNOTSUPP for header versions this driver
+ * does not implement (v1/v2 and v6), -EINVAL for malformed input, or the
+ * downstream CCCI_ERR_LOAD_IMG_* error codes.
+ */
+int ccci_util_md_check_header(int md_id, const void *hdr, size_t hdr_len,
+			      unsigned int md_mem_size,
+			      unsigned int ap_img_size,
+			      const char *ap_platform,
+			      struct ccci_util_md_img_info *info)
+{
+	const u8 *p = hdr;
+	unsigned int verno, layout_size, size_field;
+	unsigned int image_type, product_ver, mem_size, md_img_size;
+	unsigned int dsp_offset, dsp_size;
+	unsigned int i;
+	int ret = 0;
+
+	if (!hdr || !info)
+		return -EINVAL;
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+	if (hdr_len < MD_HDR_OFF_VERNO + sizeof(u32))
+		return -EINVAL;
+
+	memset(info, 0, sizeof(*info));
+
+	if (memcmp(p, MD_HEADER_MAGIC_NO, MD_HEADER_MAGIC_LEN)) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md check header not exist!\n");
+		return -CCCI_ERR_LOAD_IMG_CHECK_HEAD;
+	}
+
+	verno = get_unaligned_le32(p + MD_HDR_OFF_VERNO);
+	switch (verno) {
+	case 3:
+	case 4:
+		layout_size = sizeof(struct md_check_header_v4);
+		break;
+	case 5:
+		layout_size = sizeof(struct md_check_header_v5);
+		break;
+	default:
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md check header version %u not supported\n",
+				     verno);
+		return -EOPNOTSUPP;
+	}
+
+	if (hdr_len < layout_size) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md check header truncated: %zu < %u\n",
+				     hdr_len, layout_size);
+		return -EINVAL;
+	}
+
+	/* The last word of the header is its own size (downstream dispatch). */
+	size_field = get_unaligned_le32(p + layout_size - sizeof(u32));
+	if (size_field != layout_size) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md check header size mismatch: field %u, layout %u\n",
+				     size_field, layout_size);
+		return -CCCI_ERR_LOAD_IMG_CHECK_HEAD;
+	}
+
+	if (p[MD_HDR_OFF_BIND_SYS_ID] != (u8)(md_id + 1)) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md image is for MD SYS%u, not MD SYS%d!\n",
+				     p[MD_HDR_OFF_BIND_SYS_ID], md_id + 1);
+		return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+	}
+
+	image_type = get_unaligned_le32(p + MD_HDR_OFF_IMAGE_TYPE);
+	if (image_type > CCCI_MD_MAX_IMG_TYPE) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md image type %u out of range\n", image_type);
+		return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+	}
+
+	product_ver = get_unaligned_le32(p + MD_HDR_OFF_PRODUCT_VER);
+	mem_size = get_unaligned_le32(p + MD_HDR_OFF_MEM_SIZE);
+	md_img_size = get_unaligned_le32(p + MD_HDR_OFF_MD_IMG_SIZE);
+
+	/* Downstream ENABLE_MEM_SIZE_CHECK block, ccci_util_lib_load_img.c:143. */
+	if (md_mem_size) {
+		if (mem_size > md_mem_size) {
+			ccci_util_dump_write(md_id, CCCI_DUMP_INIT,
+					     CCCI_DUMP_TIME_FLAG,
+					     "md mem size 0x%x > AP reserve 0x%x\n",
+					     mem_size, md_mem_size);
+			return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+		}
+		if (mem_size < md_mem_size)
+			ccci_util_dump_write(md_id, CCCI_DUMP_INIT,
+					     CCCI_DUMP_TIME_FLAG,
+					     "[Warning]md size in md header isn't sync to DFO setting: (%08x, %08x)\n",
+					     mem_size, md_mem_size);
+	}
+
+	/* Downstream compares head->md_img_size with the reserved image size. */
+	if (ap_img_size && md_img_size && md_img_size > ap_img_size) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "md image size 0x%x > AP reserve 0x%x\n",
+				     md_img_size, ap_img_size);
+		return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+	}
+
+	/* DSP image sanity, ccci_util_lib_load_img.c:225-251. */
+	dsp_offset = get_unaligned_le32(p + MD_HDR_OFF_DSP_OFFSET);
+	dsp_size = get_unaligned_le32(p + MD_HDR_OFF_DSP_SIZE);
+	if (dsp_offset == MD_DSP_ON_EMI_DISABLED) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "DSP on EMI disabled\n");
+	} else if (verno == 3 && (dsp_offset & 0xFFFF)) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "DSP image offset not 64KB align\n");
+		return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+	} else if (md_mem_size &&
+		   (u64)dsp_offset + dsp_size > md_mem_size) {
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "DSP image size too large %x\n", md_mem_size);
+		return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+	}
+
+	/* RMPU region table, only meaningful from check header v4 on. */
+	if (verno >= 4) {
+		unsigned int region_num =
+			get_unaligned_le32(p + MD_HDR_OFF_REGION_NUM);
+		unsigned int region_cnt;
+
+		if (region_num > MD_MAX_REGION_NUM) {
+			ccci_util_dump_write(md_id, CCCI_DUMP_INIT,
+					     CCCI_DUMP_TIME_FLAG,
+					     "md region number %u out of range\n",
+					     region_num);
+			return -CCCI_ERR_LOAD_IMG_MD_CHECK;
+		}
+
+		/*
+		 * Downstream always consumes MPU_REGION_INFO_ID_LAST + 1
+		 * entries regardless of region_num.
+		 */
+		region_cnt = clamp_t(unsigned int, region_num,
+				     MPU_REGION_INFO_ID_LAST + 1,
+				     MD_MAX_REGION_NUM);
+		info->region_num = region_cnt;
+
+		for (i = 0; i < region_cnt; i++) {
+			const u8 *r = p + MD_HDR_OFF_REGION_INFO + i * 8;
+
+			info->region_info[i].region_offset =
+				get_unaligned_le32(r);
+			info->region_info[i].region_size =
+				get_unaligned_le32(r + 4);
+			ccci_util_dump_write(md_id, CCCI_DUMP_INIT,
+					     CCCI_DUMP_TIME_FLAG,
+					     "[CCCI_UTIL] load_image: check_header_v%u, region(%u): size = %x , offset = %x\n",
+					     verno, i,
+					     info->region_info[i].region_size,
+					     info->region_info[i].region_offset);
+		}
+
+		for (i = 0; i < MPU_DOMAIN_INFO_ID_TOTAL_NUM; i++) {
+			info->domain_attr[i] = get_unaligned_le32(p +
+				MD_HDR_OFF_DOMAIN_ATTR + i * 4);
+			ccci_util_dump_write(md_id, CCCI_DUMP_INIT,
+					     CCCI_DUMP_TIME_FLAG,
+					     "[CCCI_UTIL] load_image: check_header_v%u, domain(%u): attr = %x\n",
+					     verno, i, info->domain_attr[i]);
+		}
+	}
+
+	if (verno >= 5) {
+		info->arm7_img_offset =
+			get_unaligned_le32(p + MD_HDR_OFF_ARM7_OFFSET);
+		info->arm7_img_size =
+			get_unaligned_le32(p + MD_HDR_OFF_ARM7_SIZE);
+		ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+				     "[CCCI_UTIL] load_image: check_header_v5, arm7_offset = 0x%08X, arm_size = 0x%08X\n",
+				     info->arm7_img_offset, info->arm7_img_size);
+	}
+
+	info->header_size = layout_size;
+	info->header_verno = verno;
+	info->product_ver = product_ver;
+	info->image_type = image_type;
+	info->bind_sys_id = p[MD_HDR_OFF_BIND_SYS_ID];
+	info->ext_attr = p[MD_HDR_OFF_EXT_ATTR];
+	info->mem_size = mem_size;
+	info->md_img_size = md_img_size;
+	info->rpc_sec_mem_addr = get_unaligned_le32(p + MD_HDR_OFF_RPC_SEC);
+	info->dsp_img_offset = dsp_offset;
+	info->dsp_img_size = dsp_size;
+	info->image_type_str = ccci_util_md_type_str(image_type);
+	info->product_ver_str = ccci_util_md_product_str(product_ver);
+
+	md_hdr_copy_str(info->platform, sizeof(info->platform),
+			p + MD_HDR_OFF_PLATFORM, 16);
+	md_hdr_copy_str(info->build_time, sizeof(info->build_time),
+			p + MD_HDR_OFF_BUILD_TIME, 64);
+	md_hdr_copy_str(info->build_ver, sizeof(info->build_ver),
+			p + MD_HDR_OFF_BUILD_VER, 64);
+
+	mutex_lock(&md_img_info_lock);
+	md_hdr_build_info_str(md_id, ap_platform, md_mem_size, info);
+	mutex_unlock(&md_img_info_lock);
+
+	ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+			     "Modem header check OK! v%u size=%zu\n",
+			     verno, hdr_len);
+	ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+			     "(MD)[type]=%s, (AP)[type]=%s\n",
+			     info->image_type_str, info->image_type_str);
+	ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+			     "(MD)[size]=%x, (AP)[size]=%x\n",
+			     mem_size, md_mem_size);
+	ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+			     "(MD)[img_size]=%x, (AP)[img_size]=%x\n",
+			     md_img_size, ap_img_size);
+	ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+			     "(MD)[build_ver]=%s, [build_time]=%s\n",
+			     info->build_ver, info->build_time);
+	ccci_util_dump_write(md_id, CCCI_DUMP_INIT, CCCI_DUMP_TIME_FLAG,
+			     "(MD)[product_ver]=%s\n", info->product_ver_str);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(ccci_util_md_check_header);
+
+/**
+ * ccci_util_md_region_info() - extract the RMPU region/domain table
+ * @info:	decoded header from ccci_util_md_check_header()
+ * @region_num:	output, number of valid entries in @info->region_info
+ * @regions:	output array for the region table (may be NULL)
+ * @max_regions: size of @regions
+ * @domain_attr: output array for the domain attributes (may be NULL)
+ * @max_domains: size of @domain_attr
+ *
+ * v4 and v5 headers carry the region table; v3 does not.  Mirrors the
+ * "RMPU only available after check header v4" loop in
+ * ccci_util_lib_load_img.c:254-274.
+ */
+int ccci_util_md_region_info(const struct ccci_util_md_img_info *info,
+			     unsigned int *region_num,
+			     struct _md_regin_info *regions,
+			     unsigned int max_regions,
+			     unsigned int *domain_attr,
+			     unsigned int max_domains)
+{
+	unsigned int num;
+
+	if (!info)
+		return -EINVAL;
+	if (info->header_verno < 4)
+		return -EOPNOTSUPP;
+
+	num = min(info->region_num, (unsigned int)MD_MAX_REGION_NUM);
+
+	if (regions) {
+		if (max_regions < num)
+			return -EINVAL;
+		memcpy(regions, info->region_info, num * sizeof(*regions));
+	}
+	if (region_num)
+		*region_num = num;
+
+	if (domain_attr) {
+		if (max_domains < MPU_DOMAIN_INFO_ID_TOTAL_NUM)
+			return -EINVAL;
+		memcpy(domain_attr, info->domain_attr,
+		       MPU_DOMAIN_INFO_ID_TOTAL_NUM * sizeof(*domain_attr));
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ccci_util_md_region_info);
+
+MODULE_DESCRIPTION("MediaTek CCCI MD image header helpers");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/ccci_util/ccci_util_log.c b/drivers/misc/mediatek/ccci_util/ccci_util_log.c
new file mode 100644
index 000000000..da7a51b22
--- /dev/null
+++ b/drivers/misc/mediatek/ccci_util/ccci_util_log.c
@@ -0,0 +1,652 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * CCCI character devices: /dev/ccci_log (debug log ring) and /dev/ccci_dump
+ * (per-MD dump buffers), plus the event log ring.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/ccci_util/ccci_private_log.c
+ *     - ccci_log_write()       (line 54)
+ *     - ccci_log_write_raw()   (line 104)
+ *     - ccci_log_read()        (line 165)
+ *     - ccci_log_poll/open/close (lines 212, 223, 231)
+ *     - ccci_dump_read/poll/open/close (lines 472, 615, 620, 636)
+ *     - ccci_event_log()       (line 867)
+ *     - ccci_event_log_cpy()   (line 941)
+ *     - ccci_log_init()        (line 969)
+ *
+ * Downstream exposed the two interfaces as /proc/ccci_log and /proc/ccci_dump
+ * with proc_create() (ROM: proc_create_data at 0xc0197e64, called from
+ * ccci_log_init at 0xc0504e30 and 0xc0504e98).  This driver exposes them as
+ * misc character devices, which is what Android/MTK userspace expects on
+ * current kernels; the byte stream is unchanged.
+ *
+ * /dev/ccci_dump write format (one record per write):
+ *	struct ccci_util_dump_rec {
+ *		__le32 type;	// CCCI_DUMP_* selector
+ *		__le32 len;	// payload length
+ *		u8     data[];
+ *	};
+ * The target MD is selected with CCCI_UTIL_IOC_SET_MD (default MD_SYS1).
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/poll.h>
+#include <linux/sched.h>
+#include <linux/sched/clock.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/time.h>
+#include <linux/timekeeping.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/ccci.h>
+
+#include "ccci_util.h"
+
+#define CCCI_LOG_BUF_SIZE	CCCI_UTIL_LOG_SIZE
+
+struct ccci_log_ring {
+	u8 *buffer;
+	u32 write_pos;
+	u32 data_size;		/* valid bytes, capped at CCCI_LOG_BUF_SIZE */
+	atomic_t reader_cnt;
+	wait_queue_head_t log_wq;
+	spinlock_t write_lock;
+};
+
+static struct ccci_log_ring ccci_log_buf;
+
+static int ccci_util_ring_put(u8 *buffer, u32 size, u32 *write_pos,
+			      u32 *data_size, const void *data, u32 len,
+			      spinlock_t *lock)
+{
+	unsigned long flags;
+	u32 start, first;
+
+	spin_lock_irqsave(lock, flags);
+
+	start = *write_pos & (size - 1);
+	first = min(len, size - start);
+	memcpy(buffer + start, data, first);
+	if (len > first)
+		memcpy(buffer, data + first, len - first);
+
+	*write_pos = (start + len) & (size - 1);
+	if (*data_size + len > size)
+		*data_size = size;	/* full: oldest byte at *write_pos */
+	else
+		*data_size += len;
+
+	spin_unlock_irqrestore(lock, flags);
+
+	return len;
+}
+
+static int ccci_log_ring_write(const void *data, u32 len)
+{
+	if (!ccci_log_buf.buffer)
+		return -ENODEV;
+
+	if (!len)
+		return 0;
+	if (len > CCCI_LOG_BUF_SIZE) {
+		data += len - CCCI_LOG_BUF_SIZE;
+		len = CCCI_LOG_BUF_SIZE;
+	}
+
+	ccci_util_ring_put(ccci_log_buf.buffer, CCCI_LOG_BUF_SIZE,
+			   &ccci_log_buf.write_pos, &ccci_log_buf.data_size,
+			   data, len, &ccci_log_buf.write_lock);
+
+	wake_up_interruptible_all(&ccci_log_buf.log_wq);
+
+	return len;
+}
+
+int ccci_log_write(const char *fmt, ...)
+{
+	char temp_log[CCCI_UTIL_MAX_WRITE];
+	unsigned long rem_nsec;
+	u64 ts_nsec;
+	va_list args;
+	int cpu;
+	int write_len;
+
+	ts_nsec = local_clock();
+	rem_nsec = do_div(ts_nsec, NSEC_PER_SEC);
+	cpu = get_cpu();
+	put_cpu();
+	write_len = scnprintf(temp_log, sizeof(temp_log),
+			      "[%5lu.%06lu]%c(%x)[%d:%s]",
+			      (unsigned long)ts_nsec, rem_nsec / 1000,
+			      irqs_disabled() ? '-' : ' ', cpu, current->pid,
+			      current->comm);
+
+	va_start(args, fmt);
+	write_len += vscnprintf(temp_log + write_len,
+				sizeof(temp_log) - write_len, fmt, args);
+	va_end(args);
+
+	return ccci_log_ring_write(temp_log,
+				   min_t(int, write_len, sizeof(temp_log) - 1));
+}
+EXPORT_SYMBOL_GPL(ccci_log_write);
+
+int ccci_log_write_raw(unsigned int set_flags, const char *fmt, ...)
+{
+	char temp_log[CCCI_UTIL_MAX_WRITE];
+	unsigned long rem_nsec;
+	u64 ts_nsec;
+	va_list args;
+	int write_len = 0;
+	int cpu;
+
+	if (set_flags & CCCI_DUMP_TIME_FLAG) {
+		ts_nsec = local_clock();
+		rem_nsec = do_div(ts_nsec, NSEC_PER_SEC);
+		cpu = get_cpu();
+		put_cpu();
+		write_len += scnprintf(temp_log + write_len,
+				       sizeof(temp_log) - write_len,
+				       "[%5lu.%06lu]%c(%x)",
+				       (unsigned long)ts_nsec, rem_nsec / 1000,
+				       irqs_disabled() ? '-' : ' ', cpu);
+	}
+
+	if (set_flags & CCCI_DUMP_CURR_FLAG)
+		write_len += scnprintf(temp_log + write_len,
+				       sizeof(temp_log) - write_len, "[%d:%s]",
+				       current->pid, current->comm);
+
+	va_start(args, fmt);
+	write_len += vscnprintf(temp_log + write_len,
+				sizeof(temp_log) - write_len, fmt, args);
+	va_end(args);
+
+	return ccci_log_ring_write(temp_log,
+				   min_t(int, write_len, sizeof(temp_log) - 1));
+}
+EXPORT_SYMBOL_GPL(ccci_log_write_raw);
+
+/* ------------------------------------------------------------------ */
+/* /dev/ccci_log                                                       */
+/* ------------------------------------------------------------------ */
+
+static ssize_t ccci_log_read(struct file *file, char __user *buf, size_t size,
+			     loff_t *ppos)
+{
+	unsigned int available, read_len, read_pos, first;
+	unsigned long flags;
+	int ret;
+
+retry:
+	spin_lock_irqsave(&ccci_log_buf.write_lock, flags);
+	available = ccci_log_buf.data_size;
+	if (available >= CCCI_LOG_BUF_SIZE) {
+		/* Overflow: the write pointer is the oldest byte. */
+		available = CCCI_LOG_BUF_SIZE;
+		read_pos = ccci_log_buf.write_pos;
+	} else {
+		read_pos = (ccci_log_buf.write_pos + CCCI_LOG_BUF_SIZE -
+			    available) & (CCCI_LOG_BUF_SIZE - 1);
+	}
+	spin_unlock_irqrestore(&ccci_log_buf.write_lock, flags);
+
+	if (!available) {
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+
+		ret = wait_event_interruptible(ccci_log_buf.log_wq,
+					       READ_ONCE(ccci_log_buf.data_size));
+		if (ret)
+			return -ERESTARTSYS;
+		goto retry;
+	}
+
+	read_len = min_t(size_t, size, available);
+	first = min(read_len, CCCI_LOG_BUF_SIZE - read_pos);
+
+	if (copy_to_user(buf, ccci_log_buf.buffer + read_pos, first))
+		return -EFAULT;
+	if (read_len > first &&
+	    copy_to_user(buf + first, ccci_log_buf.buffer, read_len - first))
+		return -EFAULT;
+
+	spin_lock_irqsave(&ccci_log_buf.write_lock, flags);
+	ccci_log_buf.data_size -= read_len;
+	spin_unlock_irqrestore(&ccci_log_buf.write_lock, flags);
+
+	return read_len;
+}
+
+static __poll_t ccci_log_poll(struct file *file, poll_table *wait)
+{
+	__poll_t mask = 0;
+
+	poll_wait(file, &ccci_log_buf.log_wq, wait);
+	if (READ_ONCE(ccci_log_buf.data_size))
+		mask |= EPOLLIN | EPOLLRDNORM;
+
+	return mask;
+}
+
+static int ccci_log_open(struct inode *inode, struct file *file)
+{
+	if (!ccci_log_buf.buffer)
+		return -ENODEV;
+
+	if (atomic_inc_return(&ccci_log_buf.reader_cnt) > 1) {
+		atomic_dec(&ccci_log_buf.reader_cnt);
+		return -EBUSY;
+	}
+
+	return 0;
+}
+
+static int ccci_log_close(struct inode *inode, struct file *file)
+{
+	atomic_dec(&ccci_log_buf.reader_cnt);
+
+	return 0;
+}
+
+static const struct file_operations ccci_log_fops = {
+	.owner		= THIS_MODULE,
+	.read		= ccci_log_read,
+	.open		= ccci_log_open,
+	.release	= ccci_log_close,
+	.poll		= ccci_log_poll,
+	.llseek		= noop_llseek,
+};
+
+/* ------------------------------------------------------------------ */
+/* /dev/ccci_dump                                                      */
+/* ------------------------------------------------------------------ */
+
+#define CCCI_UTIL_IOC_MAGIC	'C'
+#define CCCI_UTIL_IOC_SET_MD	_IOW(CCCI_UTIL_IOC_MAGIC, 0x40, __u32)
+#define CCCI_UTIL_IOC_GET_MD	_IOR(CCCI_UTIL_IOC_MAGIC, 0x41, __u32)
+
+struct ccci_util_dump_rec {
+	__le32 type;
+	__le32 len;
+	u8 data[];
+} __packed;
+
+struct ccci_dump_file {
+	u32 md_id;
+	char *buf;
+	size_t len;
+	size_t pos;
+	bool snapshotted;
+};
+
+static void ccci_dump_file_reset_snapshot(struct ccci_dump_file *df)
+{
+	ccci_util_snapshot_free(df->buf);
+	df->buf = NULL;
+	df->len = 0;
+	df->pos = 0;
+	df->snapshotted = false;
+}
+
+static int ccci_dump_open(struct inode *inode, struct file *file)
+{
+	struct ccci_dump_file *df;
+
+	df = kzalloc(sizeof(*df), GFP_KERNEL);
+	if (!df)
+		return -ENOMEM;
+
+	df->md_id = CCCI_MD_SYS1;
+	file->private_data = df;
+
+	return nonseekable_open(inode, file);
+}
+
+static int ccci_dump_release(struct inode *inode, struct file *file)
+{
+	struct ccci_dump_file *df = file->private_data;
+
+	if (df) {
+		ccci_dump_file_reset_snapshot(df);
+		kfree(df);
+	}
+
+	return 0;
+}
+
+static ssize_t ccci_dump_read(struct file *file, char __user *buf, size_t size,
+			      loff_t *ppos)
+{
+	struct ccci_dump_file *df = file->private_data;
+	size_t len;
+
+	if (!df)
+		return -EBADF;
+
+	if (!df->snapshotted) {
+		int ret = ccci_util_dump_snapshot(df->md_id, &df->buf);
+
+		if (ret < 0)
+			return ret;
+		df->len = ret;
+		df->snapshotted = true;
+	}
+
+	if (df->pos >= df->len)
+		return 0;
+
+	len = min(size, df->len - df->pos);
+	if (copy_to_user(buf, df->buf + df->pos, len))
+		return -EFAULT;
+
+	df->pos += len;
+
+	return len;
+}
+
+static ssize_t ccci_dump_dev_write(struct file *file, const char __user *buf,
+			       size_t count, loff_t *ppos)
+{
+	struct ccci_dump_file *df = file->private_data;
+	struct ccci_util_dump_rec rec;
+	u32 type, len;
+	void *data;
+	int ret;
+
+	if (!df)
+		return -EBADF;
+	if (count < sizeof(rec))
+		return -EINVAL;
+
+	if (copy_from_user(&rec, buf, sizeof(rec)))
+		return -EFAULT;
+
+	type = le32_to_cpu(rec.type);
+	len = le32_to_cpu(rec.len);
+
+	if (type >= CCCI_DUMP_MAX)
+		return -EINVAL;
+	if (len != count - sizeof(rec))
+		return -EINVAL;
+	if (!len)
+		return -EINVAL;
+
+	data = memdup_user(buf + sizeof(rec), len);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+
+	ret = ccci_util_dump_append_raw(df->md_id, type, data, len);
+	kfree(data);
+	if (ret < 0)
+		return ret;
+
+	return count;
+}
+
+static __poll_t ccci_dump_poll(struct file *file, poll_table *wait)
+{
+	/* Downstream ccci_dump_poll() always reports readable data. */
+	return EPOLLIN | EPOLLRDNORM;
+}
+
+static long ccci_dump_ioctl(struct file *file, unsigned int cmd,
+			    unsigned long arg)
+{
+	struct ccci_dump_file *df = file->private_data;
+	u32 md_id;
+
+	if (!df)
+		return -EBADF;
+
+	switch (cmd) {
+	case CCCI_UTIL_IOC_SET_MD:
+		if (get_user(md_id, (u32 __user *)arg))
+			return -EFAULT;
+		if (md_id >= CCCI_MAX_MD_NUM)
+			return -EINVAL;
+		df->md_id = md_id;
+		ccci_dump_file_reset_snapshot(df);
+		return 0;
+	case CCCI_UTIL_IOC_GET_MD:
+		if (put_user(df->md_id, (u32 __user *)arg))
+			return -EFAULT;
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations ccci_dump_fops = {
+	.owner		= THIS_MODULE,
+	.read		= ccci_dump_read,
+	.write		= ccci_dump_dev_write,
+	.open		= ccci_dump_open,
+	.release	= ccci_dump_release,
+	.poll		= ccci_dump_poll,
+	.unlocked_ioctl	= ccci_dump_ioctl,
+	.llseek		= noop_llseek,
+};
+
+/* ------------------------------------------------------------------ */
+/* Event log ring (ccci_event_log / ccci_event_log_cpy)                */
+/* ------------------------------------------------------------------ */
+
+#define CCCI_EVENT_BUF_SIZE	4096
+
+struct ccci_event_buf {
+	u8 *buffer;
+	u32 write_pos;
+	u32 data_size;
+	spinlock_t lock;
+};
+
+static struct ccci_event_buf ccci_event_buffer;
+static bool ccci_logdev_registered;
+
+int ccci_event_log(const char *fmt, ...)
+{
+	char temp_log[CCCI_UTIL_MAX_WRITE];
+	struct timespec64 ts;
+	struct tm tm, tm_android;
+	unsigned long rem_nsec;
+	unsigned long flags;
+	u64 ts_nsec;
+	va_list args;
+	u32 wr_pos, can_be_write;
+	int write_len;
+	int cpu;
+
+	if (!ccci_event_buffer.buffer)
+		return 0;
+
+	/* Kernel monotonic stamp, as in downstream. */
+	ts_nsec = local_clock();
+	rem_nsec = do_div(ts_nsec, NSEC_PER_SEC);
+	cpu = get_cpu();
+	put_cpu();
+
+	/* Wall clock plus the configured timezone offset. */
+	ktime_get_real_ts64(&ts);
+	time64_to_tm(ts.tv_sec, 0, &tm);
+	time64_to_tm(ts.tv_sec - sys_tz.tz_minuteswest * 60, 0, &tm_android);
+
+	write_len = scnprintf(temp_log, sizeof(temp_log),
+			      "%ld%02d%02d-%02d:%02d:%02d.%03d [%5lu.%06lu]%c(%x)[%d:%s]",
+			      tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday,
+			      tm_android.tm_hour, tm_android.tm_min,
+			      tm_android.tm_sec,
+			      (unsigned int)(ts.tv_nsec / NSEC_PER_MSEC),
+			      (unsigned long)ts_nsec, rem_nsec / 1000,
+			      irqs_disabled() ? '-' : ' ', cpu, current->pid,
+			      current->comm);
+
+	va_start(args, fmt);
+	write_len += vscnprintf(temp_log + write_len,
+				sizeof(temp_log) - write_len, fmt, args);
+	va_end(args);
+
+	write_len = min_t(int, write_len, sizeof(temp_log) - 1);
+	if (!write_len)
+		return 0;
+
+	spin_lock_irqsave(&ccci_event_buffer.lock, flags);
+
+	wr_pos = ccci_event_buffer.write_pos;
+	ccci_event_buffer.data_size += write_len;
+	if (ccci_event_buffer.data_size > CCCI_EVENT_BUF_SIZE)
+		ccci_event_buffer.data_size = CCCI_EVENT_BUF_SIZE + 1;
+
+	ccci_event_buffer.write_pos = (wr_pos + write_len) &
+				      (CCCI_EVENT_BUF_SIZE - 1);
+
+	if (wr_pos + write_len > CCCI_EVENT_BUF_SIZE) {
+		can_be_write = CCCI_EVENT_BUF_SIZE - wr_pos;
+		memcpy(ccci_event_buffer.buffer + wr_pos, temp_log, can_be_write);
+		memcpy(ccci_event_buffer.buffer, temp_log + can_be_write,
+		       write_len - can_be_write);
+	} else {
+		memcpy(ccci_event_buffer.buffer + wr_pos, temp_log, write_len);
+	}
+
+	spin_unlock_irqrestore(&ccci_event_buffer.lock, flags);
+
+	return write_len;
+}
+EXPORT_SYMBOL_GPL(ccci_event_log);
+
+int ccci_event_log_cpy(char buf[], int size)
+{
+	unsigned long flags;
+	unsigned int rd_pos;
+	int cpy_size, first_half;
+
+	if (!ccci_event_buffer.buffer || !buf || size <= 0)
+		return 0;
+
+	spin_lock_irqsave(&ccci_event_buffer.lock, flags);
+
+	if (ccci_event_buffer.data_size > CCCI_EVENT_BUF_SIZE) {
+		cpy_size = min_t(int, CCCI_EVENT_BUF_SIZE, size);
+		rd_pos = ccci_event_buffer.write_pos;
+		first_half = CCCI_EVENT_BUF_SIZE - rd_pos;
+		first_half = min(first_half, cpy_size);
+		memcpy(buf, ccci_event_buffer.buffer + rd_pos, first_half);
+		if (cpy_size > first_half)
+			memcpy(buf + first_half, ccci_event_buffer.buffer,
+			       cpy_size - first_half);
+	} else {
+		cpy_size = min_t(int, ccci_event_buffer.data_size, size);
+		memcpy(buf, ccci_event_buffer.buffer, cpy_size);
+	}
+
+	spin_unlock_irqrestore(&ccci_event_buffer.lock, flags);
+
+	return cpy_size;
+}
+EXPORT_SYMBOL_GPL(ccci_event_log_cpy);
+
+/* ------------------------------------------------------------------ */
+/* Device registration                                                 */
+/* ------------------------------------------------------------------ */
+
+static struct miscdevice ccci_log_dev = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "ccci_log",
+	.fops	= &ccci_log_fops,
+	.mode	= 0400,
+};
+
+static struct miscdevice ccci_dump_dev = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "ccci_dump",
+	.fops	= &ccci_dump_fops,
+	.mode	= 0600,
+};
+
+int ccci_util_logdev_init(void)
+{
+	int ret;
+
+	if (ccci_logdev_registered)
+		return 0;
+
+	ccci_log_buf.buffer = kzalloc(CCCI_LOG_BUF_SIZE, GFP_KERNEL);
+	if (!ccci_log_buf.buffer)
+		return -ENOMEM;
+
+	spin_lock_init(&ccci_log_buf.write_lock);
+	init_waitqueue_head(&ccci_log_buf.log_wq);
+	ccci_log_buf.write_pos = 0;
+	ccci_log_buf.data_size = 0;
+	atomic_set(&ccci_log_buf.reader_cnt, 0);
+
+	ccci_event_buffer.buffer = kzalloc(CCCI_EVENT_BUF_SIZE, GFP_KERNEL);
+	if (!ccci_event_buffer.buffer) {
+		ret = -ENOMEM;
+		goto err_log;
+	}
+	spin_lock_init(&ccci_event_buffer.lock);
+	ccci_event_buffer.write_pos = 0;
+	ccci_event_buffer.data_size = 0;
+
+	ret = misc_register(&ccci_log_dev);
+	if (ret)
+		goto err_event;
+
+	ret = misc_register(&ccci_dump_dev);
+	if (ret)
+		goto err_dump;
+
+	ccci_logdev_registered = true;
+
+	return 0;
+
+err_dump:
+	misc_deregister(&ccci_log_dev);
+err_event:
+	kfree(ccci_event_buffer.buffer);
+	ccci_event_buffer.buffer = NULL;
+err_log:
+	kfree(ccci_log_buf.buffer);
+	ccci_log_buf.buffer = NULL;
+
+	return ret;
+}
+
+void ccci_util_logdev_exit(void)
+{
+	if (!ccci_logdev_registered)
+		return;
+
+	misc_deregister(&ccci_dump_dev);
+	misc_deregister(&ccci_log_dev);
+	ccci_logdev_registered = false;
+
+	kfree(ccci_event_buffer.buffer);
+	ccci_event_buffer.buffer = NULL;
+	ccci_event_buffer.write_pos = 0;
+	ccci_event_buffer.data_size = 0;
+
+	kfree(ccci_log_buf.buffer);
+	ccci_log_buf.buffer = NULL;
+	ccci_log_buf.write_pos = 0;
+	ccci_log_buf.data_size = 0;
+}
+
+/* Downstream entry point name, ccci_private_log.c:969. */
+void ccci_log_init(void)
+{
+	int ret = ccci_util_logdev_init();
+
+	if (ret)
+		pr_err("[ccci0/util] fail to init log devices: %d\n", ret);
+}
+EXPORT_SYMBOL_GPL(ccci_log_init);
