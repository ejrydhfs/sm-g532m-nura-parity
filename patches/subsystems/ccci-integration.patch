+		if (i == 0) {
+			first_item = item;
+		} else {
+			prev_gpd->next_gpd_ptr =
+				lower_32_bits(item->gpd_addr);
+			cldma_checksum(prev_gpd, prev_gpd->gpd_flags);
+		}
+		prev_gpd = gpd;
