+# SPDX-License-Identifier: GPL-2.0-only
+#
+# MediaTek CCMNI (Cross Chip Modem Network Interface) driver
+#
+
+config MTK_CCMNI
+	bool "MediaTek CCMNI modem network interface"
+	depends on MTK_CCCI
+	help
+	  Say Y here to build the CCMNI network device driver used by the
+	  MediaTek CCCI modem subsystem.  It exposes one Ethernet-like
+	  net_device per modem data channel (ccmni0..ccmniN) and forwards IP
+	  packets to and from the modem over the CCCI channels.
+
+	  The CCMNI driver is a library for the CCCI core: it registers the
+	  net_devices when the core calls ccmni_init() and is otherwise
+	  driven by the core through ccmni_rx_callback() and
+	  ccmni_md_state_callback().
+
+	  If unsure, say N.
