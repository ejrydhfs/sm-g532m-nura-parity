+/********************netdev register function********************/
+/* ccmni.c:237-246 */
+static u16 ccmni_select_queue(struct net_device *dev, struct sk_buff *skb,
+			      struct net_device *sb_dev)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[ccmni->md_id];
+
+	if (!ctlb || !ctlb->ccci_ops)
+		return CCMNI_TXQ_NORMAL;
+
+	if (!(ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_MQ))
+		return CCMNI_TXQ_NORMAL;
+
+	return is_ack_skb(ccmni->md_id, skb) ? CCMNI_TXQ_FAST
+					     : CCMNI_TXQ_NORMAL;
+}
+
+/* ccmni.c:248-285 */
+static int ccmni_open(struct net_device *dev)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[ccmni->md_id];
+	struct ccmni_instance *ccmni_tmp;
+	struct ccmni_ccci_ops *ops;
+	int ret;
+
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(ccmni->md_id, "%s_Open: MD%d ctlb is NULL\n",
+			      dev->name, ccmni->md_id + 1);
+		return -ENODEV;
+	}
+	ops = ctlb->ccci_ops;
+
+	ret = ops->get_ccmni_ch(ccmni->md_id, ccmni->index, &ccmni->ch);
+	if (ret) {
+		CCMNI_ERR_MSG(ccmni->md_id, "get ccmni%d channel fail: %d\n",
+			      ccmni->index, ret);
+		return ret;
+	}
+
+	if (ops->md_ability & CCCI_MD_CAP_CCMNI_MQ)
+		netif_tx_start_all_queues(dev);
+	else
+		netif_start_queue(dev);
+
+	if (unlikely(ops->md_ability & CCCI_MD_CAP_NAPI)) {
+		napi_enable(&ccmni->napi);
+		napi_schedule(&ccmni->napi);
+	}
+
+	atomic_inc(&ccmni->usage);
+	ccmni_tmp = ctlb->ccmni_inst[ccmni->index];
+	if (ccmni_tmp && ccmni != ccmni_tmp)
+		atomic_inc(&ccmni_tmp->usage);
+
+	CCMNI_INF_MSG(ccmni->md_id, "%s_Open: cnt=(%d,%d), md_ab=0x%X\n",
+		      dev->name, atomic_read(&ccmni->usage),
+		      ccmni_tmp ? atomic_read(&ccmni_tmp->usage) :
+				  atomic_read(&ccmni->usage),
+		      ops->md_ability);
+	return 0;
+}
+
+/* ccmni.c:287-315 */
+static int ccmni_close(struct net_device *dev)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[ccmni->md_id];
+	struct ccmni_instance *ccmni_tmp;
+
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(ccmni->md_id, "%s_Close: MD%d ctlb is NULL\n",
+			      dev->name, ccmni->md_id + 1);
+		return -ENODEV;
+	}
+
+	atomic_dec(&ccmni->usage);
+	ccmni_tmp = ctlb->ccmni_inst[ccmni->index];
+	if (ccmni_tmp && ccmni != ccmni_tmp)
+		atomic_dec(&ccmni_tmp->usage);
+
+	if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_MQ)
+		netif_tx_disable(dev);
+	else
+		netif_stop_queue(dev);
+
+	if (unlikely(ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI))
+		napi_disable(&ccmni->napi);
+
+	CCMNI_INF_MSG(ccmni->md_id, "%s_Close: cnt=(%d, %d)\n", dev->name,
+		      atomic_read(&ccmni->usage),
+		      ccmni_tmp ? atomic_read(&ccmni_tmp->usage) :
+				  atomic_read(&ccmni->usage));
+	return 0;
+}
+
+/* ccmni.c:317-389 */
+static netdev_tx_t ccmni_start_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[ccmni->md_id];
+	struct ccmni_stats *st;
+	unsigned int is_ack = 0;
+	int skb_len = skb->len;
+	int ccci_tx_ch, queue;
+	int ret;
+
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		dev_kfree_skb(skb);
+		return NETDEV_TX_OK;
+	}
+	st = ccmni_inst_stats(ccmni);
+
+	/* dev->mtu is changed if dev->mtu is changed by upper layer */
+	if (unlikely(skb->len > dev->mtu)) {
+		CCMNI_ERR_MSG(ccmni->md_id,
+			      "CCMNI%d write fail: len(0x%x)>MTU(0x%x, 0x%x)\n",
+			      ccmni->index, skb->len, CCMNI_MTU, dev->mtu);
+		dev_kfree_skb(skb);
+		atomic64_inc(&st->tx_dropped);
+		return NETDEV_TX_OK;
+	}
+
+	if (unlikely(skb_headroom(skb) < sizeof(struct ccci_header))) {
+		CCMNI_ERR_MSG(ccmni->md_id,
+			      "CCMNI%d write fail: header room(%d) < ccci_header(%d)\n",
+			      ccmni->index, skb_headroom(skb),
+			      (int)sizeof(struct ccci_header));
+		dev_kfree_skb(skb);
+		atomic64_inc(&st->tx_dropped);
+		return NETDEV_TX_OK;
+	}
+
+	ccci_tx_ch = ccmni->ch.tx;
+	if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_DATA_ACK_DVD) {
+		is_ack = is_ack_skb(ccmni->md_id, skb);
+		if (is_ack)
+			ccci_tx_ch = ccmni->ch.dl_ack;
+		else
+			ccci_tx_ch = ccmni->ch.tx;
+	}
+	queue = is_ack ? CCMNI_TXQ_FAST : CCMNI_TXQ_NORMAL;
+
+	if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_TX))
+		CCMNI_INF_MSG(ccmni->md_id,
+			      "[TX]CCMNI%d head_len=%d len=%d ack=%d tx_ch=%d\n",
+			      ccmni->index, skb_headroom(skb), skb->len,
+			      is_ack, ccci_tx_ch);
+
+	if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_TX_SKB))
+		ccmni_dbg_skb_header(ccmni->md_id, true, skb);
+
+	ret = ctlb->ccci_ops->send_pkt(ccmni->md_id, ccci_tx_ch, skb);
+	if (ret == CCMNI_ERR_MD_NO_READY || ret == CCMNI_ERR_TX_INVAL) {
+		dev_kfree_skb(skb);
+		atomic64_inc(&st->tx_dropped);
+		ccmni->tx_busy_cnt = 0;
+		CCMNI_ERR_MSG(ccmni->md_id,
+			      "[TX]CCMNI%d send pkt fail: %d\n",
+			      ccmni->index, ret);
+		return NETDEV_TX_OK;
+	} else if (ret == CCMNI_ERR_TX_BUSY) {
+		goto tx_busy;
+	}
+	atomic64_inc(&st->tx_packets);
+	atomic64_add(skb_len, &st->tx_bytes);
+	if (ccmni->tx_busy_cnt > 10)
+		CCMNI_ERR_MSG(ccmni->md_id,
+			      "[TX]CCMNI%d TX busy: tx_pkt=%llu retry %ld times done\n",
+			      ccmni->index, atomic64_read(&st->tx_packets),
+			      ccmni->tx_busy_cnt);
+	ccmni->tx_busy_cnt = 0;
+
+	if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_SEQNO)
+		ccmni->tx_seq_num[queue]++;
+
+	return NETDEV_TX_OK;
+
+tx_busy:
+	/*
+	 * ccmni.c:380-388: downstream does not stop the queue here even with
+	 * MODEM_CAP_TXBUSY_STOP; the core reports the ring-full condition via
+	 * the TX_FULL state notification, which is not part of the CCCI
+	 * contract state enum.  Keep the downstream retry accounting and let
+	 * the stack requeue the skb.
+	 */
+	if (unlikely(!(ctlb->ccci_ops->md_ability & CCCI_MD_CAP_TXBUSY_STOP))) {
+		if ((ccmni->tx_busy_cnt++) % 100 == 0)
+			CCMNI_ERR_MSG(ccmni->md_id,
+				      "[TX]CCMNI%d TX busy: retry_times=%ld\n",
+				      ccmni->index, ccmni->tx_busy_cnt);
+	} else {
+		ccmni->tx_busy_cnt++;
+	}
+	return NETDEV_TX_BUSY;
+}
+
+/* ccmni.c:391-398 */
+static int ccmni_change_mtu(struct net_device *dev, int new_mtu)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+
+	if (new_mtu < ETH_MIN_MTU)
+		return -EINVAL;
+
+	dev->mtu = new_mtu;
+	CCMNI_INF_MSG(ccmni->md_id, "CCMNI%d change mtu_siz=%d\n",
+		      ccmni->index, new_mtu);
+	return 0;
+}
+
+/* ccmni.c:400-415 */
+static void ccmni_tx_timeout(struct net_device *dev, unsigned int txqueue)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[ccmni->md_id];
+
+	CCMNI_INF_MSG(ccmni->md_id,
+		      "ccmni%d_tx_timeout: usage_cnt=%d, timeout=%ds, txq=%u\n",
+		      ccmni->index, atomic_read(&ccmni->usage),
+		      dev->watchdog_timeo / HZ, txqueue);
+
+	atomic64_inc(&ccmni_inst_stats(ccmni)->tx_errors);
+	if (atomic_read(&ccmni->usage) > 0 && ctlb && ctlb->ccci_ops) {
+		if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_MQ)
+			netif_tx_wake_all_queues(dev);
+		else
+			netif_wake_queue(dev);
+	}
+}
+
+/*
+ * ccmni.c:417-534.  SIOCDEVPRIVATE+0/+1 are dispatched through
+ * ndo_siocdevprivate() on current kernels (net/core/dev_ioctl.c), so the
+ * argument is still read from ifr->ifr_ifru.ifru_ivalue exactly as the
+ * Android RILD/thermal clients set it.
+ */
+static int ccmni_siocdevprivate(struct net_device *dev, struct ifreq *ifr,
+				void __user *data, int cmd)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_instance *ccmni_tmp = NULL;
+	struct ccmni_ctl_block *ctlb = NULL;
+	struct ccmni_ctl_block *ctlb_irat = NULL;
+	struct ccmni_instance *ccmni_irat;
+	unsigned int timeout = 0;
+	int md_id, md_id_irat, usage_cnt;
+
+	switch (cmd) {
+	case SIOCSTXQSTATE:
+		/* ifru_ivalue[3~0]:start/stop; ifru_ivalue[7~4]:reserve; */
+		/* ifru_ivalue[15~8]:user id, bit8=rild, bit9=thermal */
+		/* ifru_ivalue[31~16]: watchdog timeout value */
+		ctlb = ccmni_ctl_blk[ccmni->md_id];
+		if (!ctlb || !ctlb->ccci_ops)
+			return -ENODEV;
+
+		if ((ifr->ifr_ifru.ifru_ivalue & 0xF) == 0) {
+			if (atomic_read(&ccmni->usage) > 0) {
+				atomic_dec(&ccmni->usage);
+
+				if (ctlb->ccci_ops->md_ability &
+				    CCCI_MD_CAP_CCMNI_MQ)
+					netif_tx_disable(dev);
+				else
+					netif_stop_queue(dev);
+				/* stop queue won't stop Tx watchdog */
+				timeout = (ifr->ifr_ifru.ifru_ivalue &
+					   0xFFFF0000) >> 16;
+				if (timeout == 0)
+					dev->watchdog_timeo = 60 * HZ;
+				else
+					dev->watchdog_timeo = timeout * HZ;
+
+				ccmni_tmp = ctlb->ccmni_inst[ccmni->index];
+				if (ccmni_tmp && ccmni_tmp != ccmni) {
+					usage_cnt = atomic_read(&ccmni->usage);
+					atomic_set(&ccmni_tmp->usage,
+						   usage_cnt);
+				}
+			}
+		} else {
+			if (atomic_read(&ccmni->usage) <= 0) {
+				if (netif_running(dev)) {
+					if (ctlb->ccci_ops->md_ability &
+					    CCCI_MD_CAP_CCMNI_MQ)
+						netif_tx_wake_all_queues(dev);
+					else
+						netif_wake_queue(dev);
+				}
+				dev->watchdog_timeo = CCMNI_NETDEV_WDT_TO;
+				atomic_inc(&ccmni->usage);
+
+				ccmni_tmp = ctlb->ccmni_inst[ccmni->index];
+				if (ccmni_tmp && ccmni_tmp != ccmni) {
+					usage_cnt = atomic_read(&ccmni->usage);
+					atomic_set(&ccmni_tmp->usage,
+						   usage_cnt);
+				}
+			}
+		}
+		if (ccmni_tmp)
+			CCMNI_INF_MSG(ccmni->md_id,
+				      "SIOCSTXQSTATE: %s_state=0x%x, cnt=(%d, %d)\n",
+				      dev->name, ifr->ifr_ifru.ifru_ivalue,
+				      atomic_read(&ccmni->usage),
+				      atomic_read(&ccmni_tmp->usage));
+		else
+			CCMNI_INF_MSG(ccmni->md_id,
+				      "SIOCSTXQSTATE: %s_state=0x%x, cnt=%d\n",
+				      dev->name, ifr->ifr_ifru.ifru_ivalue,
+				      atomic_read(&ccmni->usage));
+		break;
+
+	case SIOCCCMNICFG:
+		md_id_irat = ifr->ifr_ifru.ifru_ivalue;
+		md_id = ccmni->md_id;
+		if (md_id_irat < 0 || md_id_irat >= CCCI_MAX_MD_NUM) {
+			CCMNI_ERR_MSG(md_id,
+				      "SIOCSCCMNICFG: %s invalid md_id(%d)\n",
+				      dev->name, md_id_irat + 1);
+			return -EINVAL;
+		}
+
+		if (dev != ccmni->dev) {
+			ccmni->dev = dev;
+			atomic_set(&ccmni->usage, 0);
+			ccmni->tx_busy_cnt = 0;
+			CCMNI_INF_MSG(md_id,
+				      "SIOCCCMNICFG: %s iRAT on MD%d, diff dev(%s->%s)\n",
+				      dev->name, md_id_irat + 1,
+				      ccmni->dev->name, dev->name);
+			break;
+		}
+
+		if (md_id_irat == ccmni->md_id) {
+			CCMNI_INF_MSG(md_id,
+				      "SIOCCCMNICFG: %s iRAT on the same MD%d, cnt=%d\n",
+				      dev->name, md_id_irat + 1,
+				      atomic_read(&ccmni->usage));
+			break;
+		}
+
+		ctlb = ccmni_ctl_blk[md_id];
+		ctlb_irat = ccmni_ctl_blk[md_id_irat];
+		if (!ctlb || !ctlb_irat || !ctlb_irat->ccci_ops ||
+		    !ctlb_irat->ccci_ops->get_ccmni_ch) {
+			CCMNI_ERR_MSG(md_id,
+				      "SIOCSCCMNICFG: %s iRAT fail, MD%d ccmni not ready\n",
+				      dev->name, md_id_irat + 1);
+			return -ENODEV;
+		}
+		if (ccmni->index >= ctlb_irat->ccci_ops->ccmni_num) {
+			CCMNI_ERR_MSG(md_id,
+				      "SIOCSCCMNICFG: %s iRAT fail, ccmni_idx(%d) > md%d_ccmni_num(%d)\n",
+				      dev->name, ccmni->index, md_id_irat + 1,
+				      ctlb_irat->ccci_ops->ccmni_num);
+			break;
+		}
+		ccmni_irat = ctlb_irat->ccmni_inst[ccmni->index];
+		if (!ccmni_irat || ccmni_irat == ccmni) {
+			CCMNI_ERR_MSG(md_id,
+				      "SIOCSCCMNICFG: %s iRAT fail, no MD%d peer instance\n",
+				      dev->name, md_id_irat + 1);
+			break;
+		}
+
+		/*
+		 * Downstream memcpy()s the whole peer instance into
+		 * netdev_priv(dev).  That would duplicate live locks, timers
+		 * and the NAPI context, so only the routing state is
+		 * exchanged here; the net_device, NAPI and watchdog stay with
+		 * the instance embedded in the device.
+		 */
+		{
+			unsigned int usage = atomic_read(&ccmni->usage);
+			unsigned long tx_busy = ccmni->tx_busy_cnt;
+			struct ccmni_ch ch = ccmni->ch;
+			int old_md_id = ccmni->md_id;
+			struct ccmni_ctl_block *old_ctlb = ctlb;
+
+			ccmni->md_id = md_id_irat;
+			ccmni->ctlb = ctlb_irat;
+			ccmni->ch = ccmni_irat->ch;
+			ccmni->tx_busy_cnt = ccmni_irat->tx_busy_cnt;
+			atomic_set(&ccmni->usage,
+				   atomic_read(&ccmni_irat->usage));
+
+			ccmni_irat->md_id = old_md_id;
+			ccmni_irat->ctlb = old_ctlb;
+			ccmni_irat->ch = ch;
+			ccmni_irat->tx_busy_cnt = tx_busy;
+			atomic_set(&ccmni_irat->usage, usage);
+		}
+
+		CCMNI_INF_MSG(md_id,
+			      "SIOCCCMNICFG: %s iRAT MD%d->MD%d, dev_cnt=%d, md_cnt=%d, md_irat_cnt=%d\n",
+			      dev->name, md_id + 1, md_id_irat + 1,
+			      atomic_read(&ccmni->usage),
+			      ctlb->ccmni_inst[ccmni->index] ?
+				      atomic_read(&ctlb->ccmni_inst[ccmni->index]->usage) : 0,
+			      atomic_read(&ccmni_irat->usage));
+		break;
+
+	default:
+		CCMNI_ERR_MSG(ccmni->md_id, "%s: unknown ioctl cmd=%x\n",
+			      dev->name, cmd);
+		return -EOPNOTSUPP;
+	}
+
+	return 0;
+}
+
+static void ccmni_get_stats64(struct net_device *dev,
+			      struct rtnl_link_stats64 *storage)
+{
+	struct ccmni_instance *ccmni = netdev_priv(dev);
+	struct ccmni_stats *st = &ccmni->stats;
+
+	storage->rx_packets = atomic64_read(&st->rx_packets);
+	storage->tx_packets = atomic64_read(&st->tx_packets);
+	storage->rx_bytes = atomic64_read(&st->rx_bytes);
+	storage->tx_bytes = atomic64_read(&st->tx_bytes);
+	storage->rx_dropped = atomic64_read(&st->rx_dropped);
+	storage->tx_dropped = atomic64_read(&st->tx_dropped);
+	storage->tx_errors = atomic64_read(&st->tx_errors);
+}
+
+/* ccmni.c:536-544 */
+static const struct net_device_ops ccmni_netdev_ops = {
+	.ndo_open		= ccmni_open,
+	.ndo_stop		= ccmni_close,
+	.ndo_start_xmit		= ccmni_start_xmit,
+	.ndo_tx_timeout		= ccmni_tx_timeout,
+	.ndo_siocdevprivate	= ccmni_siocdevprivate,
+	.ndo_change_mtu		= ccmni_change_mtu,
+	.ndo_select_queue	= ccmni_select_queue,
+	.ndo_get_stats64	= ccmni_get_stats64,
+};
+
+/* ccmni.c:546-558 */
+static int ccmni_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct ccmni_instance *ccmni = netdev_priv(napi->dev);
+	int md_id = ccmni->md_id;
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[md_id];
+
+	timer_delete(&ccmni->timer);
+
+	if (ctlb && ctlb->ccci_ops && ctlb->ccci_ops->napi_poll)
+		return ctlb->ccci_ops->napi_poll(md_id, ccmni->ch.rx, napi,
+						 budget);
+	return 0;
+}
+
+/* ccmni.c:560-565 */
+static void ccmni_napi_poll_timeout(struct timer_list *t)
+{
+	struct ccmni_instance *ccmni = container_of(t, struct ccmni_instance,
+						  timer);
+
+	CCMNI_ERR_MSG(ccmni->md_id, "CCMNI%d lost NAPI polling\n", ccmni->index);
+}
+
+/********************ccmni driver register ccci function********************/
+/* ccmni.c:569-592 */
+static int ccmni_inst_init(int md_id, struct ccmni_instance *ccmni,
+			   struct net_device *dev, bool owns_dev)
+{
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[md_id];
+	int ret;
+
+	ret = ctlb->ccci_ops->get_ccmni_ch(md_id, ccmni->index, &ccmni->ch);
+	if (ret)
+		return ret;
+
+	ccmni->dev = dev;
+	ccmni->ctlb = ctlb;
+	ccmni->md_id = md_id;
+	ccmni->owns_dev = owns_dev;
+	atomic_set(&ccmni->usage, 0);
+	spin_lock_init(&ccmni->spinlock);
+
+	if (dev && owns_dev && (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI)) {
+		unsigned int weight = ctlb->ccci_ops->napi_poll_weigh;
+
+		timer_setup(&ccmni->timer, ccmni_napi_poll_timeout, 0);
+		/* downstream passes 0 for cc3mni; NAPI requires weight >= 1 */
+		if (!weight)
+			weight = NAPI_POLL_WEIGHT;
+		netif_napi_add_weight(dev, &ccmni->napi, ccmni_napi_poll,
+				      weight);
+	}
+
+	return 0;
+}
+
+/* ccmni is an Ethernet framing device with no ARP; reuse ether_setup(). */
+static void ccmni_netdev_setup(struct net_device *dev)
+{
+	ether_setup(dev);
+}
+
+/* ccmni.c:594-781 */
+int ccmni_init(int md_id, struct ccmni_ccci_ops *ccci_info)
+{
+	struct ccmni_ctl_block *ctlb = NULL;
+	struct ccmni_ctl_block *ctlb_irat_src = NULL;
+	struct ccmni_instance *ccmni = NULL;
+	struct ccmni_instance *ccmni_irat;
+	struct ccmni_instance *ccmni_src;
+	struct net_device *dev = NULL;
+	struct ccmni_ccci_ops *ops;
+	char name[IFNAMSIZ];
+	int i, ret = 0;
+
+	if (!ccci_info || md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+
+	if (unlikely(ccci_info->md_ability & CCCI_MD_CAP_CCMNI_DISABLE)) {
+		CCMNI_ERR_MSG(md_id, "no need init ccmni: md_ability=0x%08X\n",
+			      ccci_info->md_ability);
+		return 0;
+	}
+
+	if (ccmni_ctl_blk[md_id]) {
+		CCMNI_ERR_MSG(md_id, "ccmni already initialised for MD%d\n",
+			      md_id + 1);
+		return -EBUSY;
+	}
+
+	if (ccci_info->ccmni_num <= 0 || ccci_info->ccmni_num > CCMNI_MAX_INST) {
+		CCMNI_ERR_MSG(md_id, "invalid ccmni_num=%d\n",
+			      ccci_info->ccmni_num);
+		return -EINVAL;
+	}
+
+	ctlb = kzalloc(sizeof(*ctlb), GFP_KERNEL);
+	if (unlikely(!ctlb)) {
+		CCMNI_ERR_MSG(md_id, "alloc ccmni ctl struct fail\n");
+		return -ENOMEM;
+	}
+
+	ctlb->ccci_ops = kmemdup(ccci_info, sizeof(*ccci_info), GFP_KERNEL);
+	if (unlikely(!ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(md_id, "alloc ccmni_ccci_ops struct fail\n");
+		kfree(ctlb);
+		return -ENOMEM;
+	}
+
+	ccmni_ctl_blk[md_id] = ctlb;
+	ops = ctlb->ccci_ops;
+
+	CCMNI_INF_MSG(md_id,
+		      "ccmni_init: ccmni_num=%d, md_ability=0x%08x, irat_en=%08x, irat_md_id=%d, send_pkt=%p, get_ccmni_ch=%p, name=%s\n",
+		      ops->ccmni_num, ops->md_ability,
+		      (ops->md_ability & CCCI_MD_CAP_CCMNI_IRAT),
+		      (int)ops->irat_md_id, ops->send_pkt, ops->get_ccmni_ch,
+		      ops->name);
+
+	ccmni_debug_file_init(md_id);
+
+	/*
+	 * ccmni.c:634-636: plain modems, and the world-phone variant, get
+	 * netdevices of their own.  A pure iRAT modem reuses the peer's
+	 * devices instead (handled below).
+	 */
+	if (!(ops->md_ability & CCCI_MD_CAP_CCMNI_IRAT) ||
+	    (ops->md_ability & CCCI_MD_CAP_WORLD_PHONE)) {
+		for (i = 0; i < ops->ccmni_num; i++) {
+			unsigned int txqs;
+
+			/* MQ: two tx queues (normal/ack), one rx queue */
+			txqs = (ops->md_ability & CCCI_MD_CAP_CCMNI_MQ) ?
+				CCMNI_TXQ_NUM : 1;
+			snprintf(name, sizeof(name), "%s%d", ops->name, i);
+
+			dev = alloc_netdev_mqs(sizeof(struct ccmni_instance),
+					       name, NET_NAME_PREDICTABLE,
+					       ccmni_netdev_setup, txqs, 1);
+			if (unlikely(!dev)) {
+				CCMNI_ERR_MSG(md_id, "alloc netdev fail\n");
+				ret = -ENOMEM;
+				goto alloc_mem_fail;
+			}
+
+			/* ccmni.c:649-668 */
+			dev->header_ops = NULL;
+			dev->mtu = CCMNI_MTU;
+			dev->tx_queue_len = CCMNI_TX_QUEUE;
+			dev->watchdog_timeo = CCMNI_NETDEV_WDT_TO;
+			/* ccmni is a pure IP, P2P device */
+			dev->flags = IFF_NOARP;
+			dev->features |= NETIF_F_VLAN_CHALLENGED;
+			if (ops->md_ability & CCCI_MD_CAP_SGIO) {
+				dev->features |= NETIF_F_SG;
+				dev->hw_features |= NETIF_F_SG;
+			}
+			dev->addr_len = ETH_ALEN;
+			dev->needs_free_netdev = true;
+			/* reserve Tx CCCI header room */
+			dev->hard_header_len += sizeof(struct ccci_header);
+			dev->netdev_ops = &ccmni_netdev_ops;
+			eth_hw_addr_random(dev);
+
+			CCMNI_INF_MSG(md_id, "register netdev name: %s\n",
+				      dev->name);
+
+			ccmni = netdev_priv(dev);
+			ccmni->index = i;
+			ret = ccmni_inst_init(md_id, ccmni, dev, true);
+			if (ret) {
+				CCMNI_ERR_MSG(md_id,
+					      "initial ccmni instance fail: %d\n",
+					      ret);
+				free_netdev(dev);
+				dev = NULL;
+				goto alloc_mem_fail;
+			}
+
+			ret = register_netdev(dev);
+			if (ret) {
+				CCMNI_ERR_MSG(md_id,
+					      "CCMNI%d register netdev fail: %d\n",
+					      i, ret);
+				free_netdev(dev);
+				dev = NULL;
+				goto alloc_mem_fail;
+			}
+
+			ctlb->ccmni_inst[i] = ccmni;
+			ctlb->netdev[i] = dev;
+			ccmni_dbg_add_instance(ctlb, md_id, i);
+
+			CCMNI_DBG_MSG(ccmni->md_id,
+				      "CCMNI%d=%p, ctlb=%p, ctlb_ops=%p, dev=%p\n",
+				      i, ccmni, ccmni->ctlb, ccmni->ctlb->ccci_ops,
+				      ccmni->dev);
+			dev = NULL;
+		}
+	}
+
+	/* ccmni.c:692-755: reuse the iRAT source modem's net_devices. */
+	if (ops->md_ability & CCCI_MD_CAP_CCMNI_IRAT) {
+		if (ops->irat_md_id >= CCCI_MAX_MD_NUM) {
+			CCMNI_ERR_MSG(md_id,
+				      "md%d IRAT fail because invalid irat md(%d)\n",
+				      md_id + 1, (int)ops->irat_md_id);
+			ret = -EINVAL;
+			goto alloc_mem_fail;
+		}
+
+		ctlb_irat_src = ccmni_ctl_blk[ops->irat_md_id];
+		if (!ctlb_irat_src || !ctlb_irat_src->ccci_ops) {
+			CCMNI_ERR_MSG(md_id,
+				      "md%d IRAT fail because irat md%d ctlb is NULL\n",
+				      md_id + 1, (int)ops->irat_md_id);
+			ret = -EINVAL;
+			goto alloc_mem_fail;
+		}
+
+		if (unlikely(ops->ccmni_num >
+			     ctlb_irat_src->ccci_ops->ccmni_num)) {
+			CCMNI_ERR_MSG(md_id,
+				      "IRAT fail because number of src(%d) and dest(%d) ccmni isn't equal\n",
+				      ctlb_irat_src->ccci_ops->ccmni_num,
+				      ops->ccmni_num);
+			ret = -EINVAL;
+			goto alloc_mem_fail;
+		}
+
+		if (!(ops->md_ability & CCCI_MD_CAP_WORLD_PHONE)) {
+			for (i = 0; i < ops->ccmni_num; i++) {
+				ccmni_src = ctlb_irat_src->ccmni_inst[i];
+				if (unlikely(!ccmni_src || !ccmni_src->dev ||
+					     !ctlb_irat_src->netdev[i])) {
+					CCMNI_ERR_MSG(md_id,
+						      "md%d IRAT fail: md%d ccmni%d has no netdev\n",
+						      md_id + 1,
+						      (int)ops->irat_md_id + 1, i);
+					ret = -EINVAL;
+					goto alloc_mem_fail;
+				}
+
+				ccmni_irat = kzalloc(sizeof(*ccmni_irat),
+						     GFP_KERNEL);
+				if (unlikely(!ccmni_irat)) {
+					CCMNI_ERR_MSG(md_id,
+						      "alloc ccmni instance fail\n");
+					ret = -ENOMEM;
+					goto alloc_mem_fail;
+				}
+				ccmni_irat->index = i;
+				ccmni_irat->heap = true;
+				ret = ccmni_inst_init(md_id, ccmni_irat,
+						      ccmni_src->dev, false);
+				if (ret) {
+					CCMNI_ERR_MSG(md_id,
+						      "initial ccmni instance fail: %d\n",
+						      ret);
+					kfree(ccmni_irat);
+					goto alloc_mem_fail;
+				}
+				ctlb->ccmni_inst[i] = ccmni_irat;
+				ccmni_dbg_add_instance(ctlb, md_id, i);
+
+				/*
+				 * Keep a separate routing instance in the
+				 * source modem's table so that
+				 * SIOCCCMNICFG()/SIOCSTXQSTATE() can address
+				 * the two modems independently, like
+				 * ccmni.c:750-751 does with a full memcpy().
+				 * The net_device stays owned by the source
+				 * modem (ctlb_irat_src->netdev[i]).
+				 */
+				if (!ccmni_src->heap) {
+					struct ccmni_instance *ccmni_dup;
+
+					ccmni_dup = kzalloc(sizeof(*ccmni_dup),
+							    GFP_KERNEL);
+					if (unlikely(!ccmni_dup)) {
+						CCMNI_ERR_MSG(md_id,
+							      "alloc ccmni_irat instance fail\n");
+						ret = -ENOMEM;
+						goto alloc_mem_fail;
+					}
+					ccmni_dup->index = i;
+					ccmni_dup->md_id = ccmni_src->md_id;
+					ccmni_dup->ctlb = ccmni_src->ctlb;
+					ccmni_dup->dev = ccmni_src->dev;
+					ccmni_dup->ch = ccmni_src->ch;
+					ccmni_dup->heap = true;
+					atomic_set(&ccmni_dup->usage,
+						   atomic_read(&ccmni_src->usage));
+					spin_lock_init(&ccmni_dup->spinlock);
+					ctlb_irat_src->ccmni_inst[i] = ccmni_dup;
+				}
+			}
+		}
+	}
+
+	snprintf(ctlb->wakelock_name, sizeof(ctlb->wakelock_name),
+		 "ccmni_md%d", md_id + 1);
+	ctlb->ccmni_wakelock = wakeup_source_register(NULL, ctlb->wakelock_name);
+	if (!ctlb->ccmni_wakelock) {
+		CCMNI_ERR_MSG(md_id, "register wakeup source fail\n");
+		ret = -ENOMEM;
+		goto alloc_mem_fail;
+	}
+
+	return 0;
+
+alloc_mem_fail:
+	ccmni_exit(md_id);
+	return ret;
+}
+
+/*
+ * An iRAT peer modem keeps instances that point at the source modem's
+ * net_device.  When the source goes away, drop those references so a late
+ * RX/state callback cannot touch a freed net_device.
+ */
+static void ccmni_unlink_shared_dev(struct ccmni_ctl_block *owner,
+				    struct net_device *dev)
+{
+	struct ccmni_ctl_block *ctlb;
+	int md, i;
+
+	for (md = 0; md < CCCI_MAX_MD_NUM; md++) {
+		ctlb = ccmni_ctl_blk[md];
+		if (!ctlb || ctlb == owner || !ctlb->ccci_ops)
+			continue;
+		for (i = 0; i < ctlb->ccci_ops->ccmni_num &&
+			    i < CCMNI_MAX_INST; i++) {
+			if (ctlb->ccmni_inst[i] &&
+			    ctlb->ccmni_inst[i]->dev == dev)
+				ctlb->ccmni_inst[i]->dev = NULL;
+		}
+	}
+}
+
+/* ccmni.c:783-812 */
+void ccmni_exit(int md_id)
+{
+	struct ccmni_ctl_block *ctlb;
+	struct ccmni_instance *ccmni;
+	int i;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return;
+
+	CCMNI_INF_MSG(md_id, "ccmni_exit\n");
+
+	ctlb = ccmni_ctl_blk[md_id];
+	if (!ctlb)
+		return;
+
+	if (ctlb->ccci_ops) {
+		for (i = 0; i < ctlb->ccci_ops->ccmni_num && i < CCMNI_MAX_INST;
+		     i++) {
+			bool heap;
+
+			ccmni = ctlb->ccmni_inst[i];
+			heap = ccmni && ccmni->heap;
+
+			/*
+			 * unregister_netdev() frees the net_device and the
+			 * instance embedded in it, so evaluate ->heap first.
+			 */
+			if (ctlb->netdev[i]) {
+				CCMNI_INF_MSG(md_id,
+					      "ccmni_exit: unregister ccmni%d dev\n",
+					      i);
+				ccmni_unlink_shared_dev(ctlb, ctlb->netdev[i]);
+				unregister_netdev(ctlb->netdev[i]);
+				ctlb->netdev[i] = NULL;
+			}
+			if (heap)
+				kfree(ccmni);
+			ctlb->ccmni_inst[i] = NULL;
+		}
+
+		debugfs_remove_recursive(ctlb->dbg_dir);
+		ctlb->dbg_dir = NULL;
+		if (ctlb->ccmni_wakelock)
+			wakeup_source_unregister(ctlb->ccmni_wakelock);
+		ctlb->ccmni_wakelock = NULL;
+		kfree(ctlb->ccci_ops);
+		ctlb->ccci_ops = NULL;
+	}
+
+	kfree(ctlb);
+	ccmni_ctl_blk[md_id] = NULL;
+}
+
+/* ccmni.c:814-882 */
+int ccmni_rx_callback(int md_id, int ccmni_idx, struct sk_buff *skb)
+{
+	struct ccmni_ctl_block *ctlb;
+	struct ccmni_instance *ccmni;
+	struct ccmni_stats *st;
+	struct net_device *dev;
+	unsigned int pkt_type;
+	int skb_len;
+	u64 t0;
+
+	if (unlikely(!skb))
+		return -EINVAL;
+
+	if (unlikely(md_id < 0 || md_id >= CCCI_MAX_MD_NUM ||
+		     ccmni_idx < 0 || ccmni_idx >= CCMNI_MAX_INST)) {
+		CCMNI_ERR_MSG(md_id, "invalid CCMNI%d ctrl/ops struct\n",
+			      ccmni_idx);
+		consume_skb(skb);
+		return -EINVAL;
+	}
+
+	ctlb = ccmni_ctl_blk[md_id];
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(md_id, "invalid CCMNI%d ctrl/ops struct\n",
+			      ccmni_idx);
+		consume_skb(skb);
+		return -EINVAL;
+	}
+
+	ccmni = ctlb->ccmni_inst[ccmni_idx];
+	if (unlikely(!ccmni || !ccmni->dev)) {
+		CCMNI_ERR_MSG(md_id, "invalid CCMNI%d instance\n", ccmni_idx);
+		consume_skb(skb);
+		return -EINVAL;
+	}
+
+	/*
+	 * Drop while the core reports the modem as down.  Until the first
+	 * state notification the transport itself is the gatekeeper (as in
+	 * downstream), so packets are not discarded.
+	 */
+	if (unlikely(ctlb->md_sta_reported &&
+		     ctlb->md_sta != CCCI_MD_READY)) {
+		ccmni_rx_drop(ccmni, skb, "modem not ready");
+		return -EAGAIN;
+	}
+
+	dev = ccmni->dev;
+
+	if (unlikely(skb->len < 1)) {
+		ccmni_rx_drop(ccmni, skb, "empty skb");
+		return -EINVAL;
+	}
+
+	/*
+	 * Downstream assumes the CLDMA RX path left ETH_HLEN of headroom and
+	 * writes the Ethernet header at skb->data - ETH_HLEN (ccmni.c:833).
+	 * Expand instead of writing out of bounds when that is not the case.
+	 */
+	if (unlikely(skb_headroom(skb) < ETH_HLEN)) {
+		if (pskb_expand_head(skb, ETH_HLEN, 0, GFP_ATOMIC)) {
+			ccmni_rx_drop(ccmni, skb, "no headroom");
+			return -ENOMEM;
+		}
+	}
+
+	pkt_type = skb->data[0] & 0xF0;
+	ccmni_make_etherframe(skb->data - ETH_HLEN, dev->dev_addr, pkt_type);
+	skb_set_mac_header(skb, -ETH_HLEN);
+	skb->dev = dev;
+	if (pkt_type == IPV6_VERSION)
+		skb->protocol = htons(ETH_P_IPV6);
+	else
+		skb->protocol = htons(ETH_P_IP);
+	skb->ip_summed = CHECKSUM_NONE;
+	skb_len = skb->len;
+
+	if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_RX))
+		CCMNI_INF_MSG(md_id, "[RX]CCMNI%d recv data_len=%d\n",
+			      ccmni_idx, skb->len);
+
+	if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_RX_SKB))
+		ccmni_dbg_skb_header(ccmni->md_id, false, skb);
+
+	if (skb->protocol == htons(ETH_P_IP) &&
+	    skb->len >= sizeof(struct iphdr))
+		net_rx_delay[2] = ntohs(((struct iphdr *)skb->data)->id);
+
+	/*
+	 * ccmni.c:862-869: with MODEM_CAP_NAPI the skb is delivered straight
+	 * to the stack (the core schedules the NAPI instance and calls
+	 * ->napi_poll() through this driver); otherwise it goes through the
+	 * backlog.  netif_rx_ni() no longer exists, netif_rx() works from
+	 * both process and interrupt context.
+	 */
+	t0 = sched_clock();
+	if (likely(ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI))
+		netif_receive_skb(skb);
+	else
+		netif_rx(skb);
+
+	st = ccmni_inst_stats(ccmni);
+	atomic64_inc(&st->rx_packets);
+	atomic64_add(skb_len, &st->rx_bytes);
+	net_rx_delay[3] = sched_clock() - t0;
+	net_rx_delay[0] = atomic64_read(&st->rx_bytes) -
+			  40 * atomic64_read(&st->rx_packets);
+	net_rx_delay[1] = atomic64_read(&st->tx_bytes) -
+			  40 * atomic64_read(&st->tx_packets);
+
+	if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_SEQNO)
+		ccmni->rx_seq_num++;
+
+	if (ctlb->ccmni_wakelock)
+		__pm_wakeup_event(ctlb->ccmni_wakelock,
+				  jiffies_to_msecs(HZ));
+
+	return 0;
+}
+
+/* ccmni.c:884-956 */
+void ccmni_md_state_callback(int md_id, int ccmni_idx,
+			     enum ccci_md_state state)
+{
+	struct ccmni_ctl_block *ctlb;
+	struct ccmni_instance *ccmni;
+	struct ccmni_instance *dev_inst;
+	struct net_device *dev;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return;
+
+	ctlb = ccmni_ctl_blk[md_id];
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(md_id,
+			      "invalid ccmni ctrl struct when ccmni_idx=%d md_sta=%d\n",
+			      ccmni_idx, state);
+		return;
+	}
+	if (ccmni_idx < 0 || ccmni_idx >= CCMNI_MAX_INST ||
+	    !ctlb->ccmni_inst[ccmni_idx]) {
+		CCMNI_ERR_MSG(md_id, "invalid ccmni_idx=%d md_sta=%d\n",
+			      ccmni_idx, state);
+		return;
+	}
+
+	ccmni = ctlb->ccmni_inst[ccmni_idx];
+	dev = ccmni->dev;
+	if (unlikely(!dev))
+		return;
+	dev_inst = netdev_priv(dev);
+
+	CCMNI_INF_MSG(md_id, "md_state_cb: CCMNI%d, md_sta=%d, usage=%d\n",
+		      ccmni_idx, state, atomic_read(&ccmni->usage));
+
+	ctlb->md_sta = state;
+	ctlb->md_sta_reported = true;
+
+	switch (state) {
+	case CCCI_MD_READY:
+		netif_carrier_on(dev);
+		/* ccmni.c:904-907 */
+		ccmni->tx_seq_num[CCMNI_TXQ_NORMAL] = 0;
+		ccmni->tx_seq_num[CCMNI_TXQ_FAST] = 0;
+		ccmni->rx_seq_num = 0;
+		ccmni->tx_busy_cnt = 0;
+
+		if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_MQ)
+			netif_tx_wake_all_queues(dev);
+		else
+			netif_wake_queue(dev);
+
+		if ((ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI) &&
+		    dev_inst->napi.dev && netif_running(dev))
+			napi_schedule(&dev_inst->napi);
+		break;
+
+	case CCCI_MD_EXCEPTION:
+	case CCCI_MD_STOPPED:
+		/* ccmni.c:910-913; NAPI stays enabled (ndo_stop owns it), RX
+		 * is gated by the state check in ccmni_rx_callback(). */
+		netif_carrier_off(dev);
+		netif_tx_stop_all_queues(dev);
+		break;
+
+	case CCCI_MD_BOOTING:
+	case CCCI_MD_INVALID:
+	default:
+		netif_carrier_off(dev);
+		netif_tx_stop_all_queues(dev);
+		break;
+	}
+}
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("MediaTek CCMNI modem network interface (CCCI v0)");
diff --git a/drivers/net/ccmni/ccmni.h b/drivers/net/ccmni/ccmni.h
new file mode 100644
index 000000000..d6cec02e8
--- /dev/null
+++ b/drivers/net/ccmni/ccmni.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/ccmni/ccmni.h
+ *   drivers/misc/mediatek/ccmni/ccmni.c
+ *
+ * The constants below are verbatim from the downstream header; the kernel
+ * facing interface (struct ccmni_ch, struct ccmni_ccci_ops and the four
+ * entry points) lives in <linux/ccci.h>.
+ */
+#ifndef __CCMNI_H__
+#define __CCMNI_H__
+
+#include <linux/kernel.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/atomic.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <linux/debugfs.h>
+
+#include <linux/ccci.h>
+
+#define CCMNI_MTU		1500		/* ccmni.h:36 */
+#define CCMNI_TX_QUEUE		1000		/* ccmni.h:37 */
+#define CCMNI_NETDEV_WDT_TO	(1 * HZ)	/* ccmni.h:38 */
+
+#define IPV4_VERSION		0x40		/* ccmni.h:40 */
+#define IPV6_VERSION		0x60		/* ccmni.h:41 */
+
+/* ccmni.h:43-44 */
+#define SIOCSTXQSTATE		(SIOCDEVPRIVATE + 0)	/* stop/start tx queue */
+#define SIOCCCMNICFG		(SIOCDEVPRIVATE + 1)	/* ccmni/md remapping */
+
+/* ccmni.h:113-118 */
+enum ccmni_ch_id {
+	CCMNI_RX_CH = 0,
+	CCMNI_RX_ACK_CH = 1,
+	CCMNI_TX_CH = 2,
+	CCMNI_TX_ACK_CH = 3,
+};
+
+/* ccmni.h:120-125 */
+enum ccmni_errno {
+	CCMNI_ERR_TX_OK = 0,		/* ccci send pkt success */
+	CCMNI_ERR_TX_BUSY = -1,		/* ccci tx packet buffer full and tx fail */
+	CCMNI_ERR_MD_NO_READY = -2,	/* modem not ready and tx fail */
+	CCMNI_ERR_TX_INVAL = -3,	/* ccmni parameter error */
+};
+
+/* ccmni.h:127-134 */
+enum ccmni_dbg_level {
+	CCMNI_DBG_LEVEL_1 = (1 << 0),
+	CCMNI_DBG_LEVEL_TX = (1 << 1),
+	CCMNI_DBG_LEVEL_RX = (1 << 2),
+	CCMNI_DBG_LEVEL_ACK_SKB = (1 << 3),
+	CCMNI_DBG_LEVEL_TX_SKB = (1 << 4),
+	CCMNI_DBG_LEVEL_RX_SKB = (1 << 5),
+};
+
+/* ccmni.h:136-141 - must match the alloc_netdev_mqs() queue count. */
+enum ccmni_txq_no {
+	CCMNI_TXQ_NORMAL = 0,
+	CCMNI_TXQ_FAST = 1,
+	CCMNI_TXQ_NUM,
+	CCMNI_TXQ_END = CCMNI_TXQ_NUM,
+};
+
+#define CCMNI_MAX_INST	16		/* ccmni.h:89, ccmni_inst[16] */
+
+/*
+ * Per-instance statistics.  Downstream keeps them in dev->stats; modern
+ * drivers use ndo_get_stats64(), so the counters are kept here and exported
+ * through that callback as well as through debugfs.
+ */
+struct ccmni_stats {
+	atomic64_t	rx_packets;
+	atomic64_t	rx_bytes;
+	atomic64_t	rx_dropped;
+	atomic64_t	tx_packets;
+	atomic64_t	tx_bytes;
+	atomic64_t	tx_dropped;
+	atomic64_t	tx_errors;
+};
+
+/*
+ * Ported from ccmni.h:57-73 (struct ccmni_instance).
+ *
+ * A ccmni_instance is either embedded in a net_device (netdev_priv(), the
+ * usual case) or heap allocated for the iRAT peer modem, in which case it
+ * only carries routing/statistics state and shares the net_device of the
+ * source modem.  @owns_dev tells ccmni_exit() whether the instance created
+ * the net_device; @heap tells it whether the instance itself has to be freed.
+ */
+struct ccmni_instance {
+	int			index;
+	int			md_id;
+	struct ccmni_ch		ch;
+	int			net_if_off;
+	atomic_t		usage;
+	struct timer_list	timer;
+	struct net_device	*dev;
+	struct napi_struct	napi;
+	unsigned int		rx_seq_num;
+	unsigned int		tx_seq_num[CCMNI_TXQ_NUM];
+	unsigned long		flags;
+	spinlock_t		spinlock;
+	struct ccmni_ctl_block	*ctlb;
+	unsigned long		tx_busy_cnt;
+	struct ccmni_stats	stats;
+	bool			owns_dev;
+	bool			heap;
+};
+
+/*
+ * Ported from ccmni.h:87-93 (struct ccmni_ctl_block) and extended with the
+ * per-MD net_device table so that iRAT peers can share a device without
+ * copying the private structure around (see ccmni_siocdevprivate()).
+ */
+struct ccmni_ctl_block {
+	struct ccmni_ccci_ops	*ccci_ops;
+	struct ccmni_instance	*ccmni_inst[CCMNI_MAX_INST];
+	struct net_device	*netdev[CCMNI_MAX_INST];
+	unsigned int		md_sta;
+	bool			md_sta_reported;
+	struct wakeup_source	*ccmni_wakelock;
+	char			wakelock_name[16];
+	struct dentry		*dbg_dir;
+};
+
+/* ccmni.h:153-160 */
+#define CCMNI_DBG_MSG(idx, fmt, args...)				\
+do {									\
+	if (ccmni_debug_level & CCMNI_DBG_LEVEL_1)			\
+		pr_debug("[ccci%d/net]" fmt, (idx) + 1, ##args);		\
+} while (0)
+
+#define CCMNI_INF_MSG(idx, fmt, args...)				\
+	pr_debug("[ccci%d/net]" fmt, (idx) + 1, ##args)
+
+#define CCMNI_ERR_MSG(idx, fmt, args...)				\
+	pr_err("[ccci%d/net][Error:%d]%s:" fmt, (idx) + 1, __LINE__,	\
+	       __func__, ##args)
+
+#endif /* __CCMNI_H__ */
diff --git a/include/linux/ccci.h b/include/linux/ccci.h
new file mode 100644
index 000000000..84fdab351
--- /dev/null
+++ b/include/linux/ccci.h
@@ -0,0 +1,298 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * CCCI (Cross Chip Communication Interface) public kernel API.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/include/mt-plat/mt_ccci_common.h
+ *   drivers/misc/mediatek/eccci/ccci_core.h
+ *   drivers/misc/mediatek/ccmni/ccmni.h
+ *
+ * This file is the frozen contract between the CCCI core, the CLDMA engine,
+ * the CCMNI netdev driver, the CCCI util driver and the C2K/dual-modem driver.
+ * Do not change existing declarations; append only if unavoidable.
+ */
+#ifndef __LINUX_CCCI_H
+#define __LINUX_CCCI_H
+
+#include <linux/types.h>
+#include <linux/skbuff.h>
+#include <linux/netdevice.h>
+#include <linux/device.h>
+
+/* Modem ids. Downstream md_id is 0-based (MD_SYS1 == 0). */
+enum ccci_md_id {
+	CCCI_MD_SYS1 = 0,
+	CCCI_MD_SYS2,
+	CCCI_MD_SYS3,
+	CCCI_MD_SYS4,
+	CCCI_MD_SYS5,
+	CCCI_MAX_MD_NUM,
+};
+
+/* Modem states, mirror downstream MD_STATE (eccci/ccci_core.h). */
+enum ccci_md_state {
+	CCCI_MD_INVALID = 0,
+	CCCI_MD_BOOTING,
+	CCCI_MD_READY,
+	CCCI_MD_EXCEPTION,
+	CCCI_MD_STOPPED,
+};
+
+/* Logical channel ids, verbatim from downstream mt_ccci_common.h. */
+enum ccci_ch {
+	CCCI_CONTROL_RX = 0,
+	CCCI_CONTROL_TX = 1,
+	CCCI_SYSTEM_RX = 2,
+	CCCI_SYSTEM_TX = 3,
+	CCCI_PCM_RX = 4,
+	CCCI_PCM_TX = 5,
+	CCCI_UART1_RX = 6,
+	CCCI_UART1_RX_ACK = 7,
+	CCCI_UART1_TX = 8,
