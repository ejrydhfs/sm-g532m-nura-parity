+	struct clk *clk;
+	char err_str[CCCI_IMG_ERR_STR_LEN];
+	char post_fix[CCCI_IMG_POSTFIX_LEN];
+	char file_name[CCCI_IMG_PATH_LEN];
+	u32 hdr_verno;
+	u32 md_img_size;
+	u32 mem_size;
+	u32 image_type;
+	u32 product_ver;
+	u8 bind_sys_id;
+	char md_platform[17];
+	char build_ver[65];
+	char build_time[65];
+};
