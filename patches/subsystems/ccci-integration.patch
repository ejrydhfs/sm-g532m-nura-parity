+	s16 seq_in[CCCI_MAX_CH_NUM];
+
+	/* memory regions */
+	void __iomem *smem_vir;
+	phys_addr_t smem_phy;
+	size_t smem_size;
+	bool smem_coherent;
+	void __iomem *img_vir;
+	phys_addr_t img_phy;
+	size_t img_size;
+	bool img_present;
+
+	/* transports */
+	struct ccci_ccif *ccif;
+	struct ccci_cldma *cldma;
+	bool ring_mode;
+
+	/* ccmni binding */
+	struct ccmni_ccci_ops *ccmni_ops;
+	bool ccmni_inited;
+
+	/* character device accounting */
+	dev_t devt;
+	unsigned int major;
+
+	/* boot */
+	struct ccci_boot boot;
+	bool powered;
+
+	/* debug */
+	struct dentry *dbg_dir;
+	char boot_info[192];
+	char version[16];
+	bool registered;
+};
