+/* internal registration path: the platform driver passes its device as the
+ * parent of the modem device, the public ccci_register_modem() passes NULL.
+ */
+int ccci_md_register(const struct ccci_md_cfg *cfg, struct device *parent);
+int ccci_md_attach_ccif(struct ccci_md *md, struct ccci_ccif *ccif);
+int ccci_md_attach_cldma(struct ccci_md *md, struct ccci_cldma *cldma);
+
+/*
+ * Logging: the kernel log gets the device prefix, and the ccci_util log ring
+ * (mdlog) receives the same record, per the cross-leaf contract.
+ */
+#define ccci_md_err(md, fmt, ...) do {					\
+	dev_err((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__);	\
+	ccci_util_log((md)->id, fmt, ##__VA_ARGS__);			\
+} while (0)
+#define ccci_md_warn(md, fmt, ...) do {					\
+	dev_warn((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__);	\
+	ccci_util_log((md)->id, fmt, ##__VA_ARGS__);			\
+} while (0)
+#define ccci_md_info(md, fmt, ...) do {					\
+	dev_info((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__);	\
+	ccci_util_log((md)->id, fmt, ##__VA_ARGS__);			\
+} while (0)
+#define ccci_md_dbg(md, fmt, ...)					\
+	dev_dbg((md)->dev, "[md%u] " fmt, (md)->id + 1, ##__VA_ARGS__)
+
+static inline unsigned int ccci_port_txq(struct ccci_port *p)
+{
+	return p->md->state == CCCI_MD_EXCEPTION ? p->txq_exp : p->txq;
+}
+
+static inline unsigned int ccci_port_rxq(struct ccci_port *p)
+{
+	return p->md->state == CCCI_MD_EXCEPTION ? p->rxq_exp : p->rxq;
+}
+
+#endif /* __CCCI_PRIV_H__ */
diff --git a/drivers/misc/mediatek/ccci/ccci_ringbuf.c b/drivers/misc/mediatek/ccci/ccci_ringbuf.c
new file mode 100644
index 000000000..2909895b7
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_ringbuf.c
@@ -0,0 +1,290 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI shared-memory ring buffer.
+ *
+ * The AP and the modem exchange framed packets through a ring carved out of
+ * the modem shared memory.  Wire format (downstream ccci_ringbuf.c):
+ *
+ *   ring  := 2 * CCCI_RBF_HEADER
+ *            rx_control { read, write, length }
+ *            tx_control { read, write, length }
+ *            rx payload [length]
+ *            tx payload [length]
+ *            2 * CCCI_RBF_FOOTER
+ *
+ *   packet := CCIF_PKG_HEADER, len
+ *             payload (len bytes)
+ *             padding to 8 byte alignment
+ *             CCIF_PKG_FOOTER, CCIF_PKG_FOOTER
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/ccci_ringbuf.c.
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ *
+ * Unlike the downstream version the ring is accessed through the MMIO
+ * accessors, because it lives in UNCACHED shared memory that the modem also
+ * writes: plain pointer dereferences would be torn/reordered on arm64.
+ */
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+#define CTL_RX_READ	0
+#define CTL_RX_WRITE	4
+#define CTL_RX_LEN	8
+#define CTL_TX_READ	12
+#define CTL_TX_WRITE	16
+#define CTL_TX_LEN	20
+#define CTL_SIZE	24
+
+struct ccci_ringbuf {
+	void __iomem *base;
+	void __iomem *ctl;
+	void __iomem *rx_buf;
+	void __iomem *tx_buf;
+	u32 rx_len;
+	u32 tx_len;
+	u32 size;
+};
+
+static inline u32 ctl_rd(struct ccci_ringbuf *rb, u32 off)
+{
+	return readl(rb->ctl + off);
+}
+
+static inline void ctl_wr(struct ccci_ringbuf *rb, u32 off, u32 val)
+{
+	writel(val, rb->ctl + off);
+}
+
+/* copy out of a ring region, handling wrap-around */
+static void ring_read(struct ccci_ringbuf *rb, void __iomem *region, u32 pos,
+		      void *dst, u32 len, u32 region_len)
+{
+	u32 first = min(len, region_len - pos);
+
+	memcpy_fromio(dst, region + pos, first);
+	if (first < len)
+		memcpy_fromio((u8 *)dst + first, region, len - first);
+}
+
+static void ring_write(struct ccci_ringbuf *rb, void __iomem *region, u32 pos,
+		       const void *src, u32 len, u32 region_len)
+{
+	u32 first = min(len, region_len - pos);
+
+	memcpy_toio(region + pos, src, first);
+	if (first < len)
+		memcpy_toio(region, (const u8 *)src + first, len - first);
+}
+
+static inline u32 ring_align(u32 len)
+{
+	return (len + 7) & ~7u;
+}
+
+struct ccci_ringbuf *ccci_ringbuf_create(void __iomem *mem, unsigned int mem_size,
+					 unsigned int rx_size, unsigned int tx_size)
+{
+	struct ccci_ringbuf *rb;
+	u32 total = CCCI_RINGBUF_CTL_LEN + rx_size + tx_size;
+
+	if (!mem || !rx_size || !tx_size || mem_size < total)
+		return NULL;
+
+	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
+	if (!rb)
+		return NULL;
+
+	rb->base = mem;
+	rb->ctl = mem + 8;
+	rb->rx_buf = mem + 8 + CTL_SIZE;
+	rb->tx_buf = rb->rx_buf + rx_size;
+	rb->rx_len = rx_size;
+	rb->tx_len = tx_size;
+	rb->size = total;
+
+	/* header, control block and footer guards */
+	writel(CCCI_RBF_HEADER, mem + 0);
+	writel(CCCI_RBF_HEADER, mem + 4);
+	ctl_wr(rb, CTL_RX_READ, 0);
+	ctl_wr(rb, CTL_RX_WRITE, 0);
+	ctl_wr(rb, CTL_RX_LEN, rx_size);
+	ctl_wr(rb, CTL_TX_READ, 0);
+	ctl_wr(rb, CTL_TX_WRITE, 0);
+	ctl_wr(rb, CTL_TX_LEN, tx_size);
+	writel(CCCI_RBF_FOOTER, mem + total - 8);
+	writel(CCCI_RBF_FOOTER, mem + total - 4);
+	wmb();
+
+	return rb;
+}
+
+/**
+ * ccci_ringbuf_readable - length of the next complete packet
+ * @rb: ring buffer
+ *
+ * Returns the payload length (without framing) of the packet at the read
+ * pointer, or a negative CCCI_RINGBUF_* error.
+ */
+int ccci_ringbuf_readable(struct ccci_ringbuf *rb)
+{
+	u32 read, write, length, size, hdr[2], ftr[2], pkg_len, total;
+	u32 footer_pos;
+
+	if (!rb)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	read = ctl_rd(rb, CTL_RX_READ);
+	write = ctl_rd(rb, CTL_RX_WRITE);
+	length = ctl_rd(rb, CTL_RX_LEN);
+
+	size = (write + length - read) % length;
+	if (size < CCIF_PKG_HDR_LEN + CCIF_PKG_FTR_LEN + CCCI_HEADER_SIZE)
+		return -7;	/* CCCI_RINGBUF_EMPTY */
+
+	ring_read(rb, rb->rx_buf, read, hdr, sizeof(hdr), length);
+	if (hdr[0] != CCIF_PKG_HEADER) {
+		pr_err("ccci: ring header 0x%08x != 0x%08x (r=%u w=%u len=%u)\n",
+		       hdr[0], CCIF_PKG_HEADER, read, write, length);
+		return -3;	/* CCCI_RINGBUF_BAD_HEADER */
+	}
+	pkg_len = hdr[1];
+	total = ring_align(CCIF_PKG_HDR_LEN + pkg_len + CCIF_PKG_FTR_LEN);
+	if (total > size)
+		return -6;	/* CCCI_RINGBUF_NOT_COMPLETE */
+
+	footer_pos = read + total - CCIF_PKG_FTR_LEN;
+	if (footer_pos >= length)
+		footer_pos -= length;
+	ring_read(rb, rb->rx_buf, footer_pos, ftr, sizeof(ftr), length);
+	if (ftr[0] != CCIF_PKG_FOOTER || ftr[1] != CCIF_PKG_FOOTER) {
+		pr_err("ccci: ring footer %08x %08x != %08x (pos=%u len=%u)\n",
+		       ftr[0], ftr[1], CCIF_PKG_FOOTER, footer_pos, length);
+		return -4;	/* CCCI_RINGBUF_BAD_FOOTER */
+	}
+	if (pkg_len > rb->rx_len)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	return pkg_len;
+}
+
+/**
+ * ccci_ringbuf_writeable - space left for a @size byte payload
+ *
+ * Positive: number of bytes consumed in the ring (header+payload+footer,
+ * 8 byte aligned).  Negative: the number of bytes that are missing.
+ * Zero payload is rejected, matching downstream behaviour.
+ */
+int ccci_ringbuf_writeable(struct ccci_ringbuf *rb, unsigned int size)
+{
+	u32 read, write, length, avail, need;
+
+	if (!rb)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	read = ctl_rd(rb, CTL_TX_READ);
+	write = ctl_rd(rb, CTL_TX_WRITE);
+	length = ctl_rd(rb, CTL_TX_LEN);
+
+	if (size > length)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	need = ring_align(size + CCIF_PKG_HDR_LEN + CCIF_PKG_FTR_LEN);
+
+	if (read == write)
+		avail = length - 1;
+	else if (read < write)
+		avail = length - write - 1 + read;
+	else
+		avail = read - write - 1;
+
+	return need < avail ? (int)need : -(int)(need - avail);
+}
+
+int ccci_ringbuf_write(struct ccci_ringbuf *rb, const void *src, unsigned int len)
+{
+	u32 write, read, length;
+	const u32 hdr[2] = { CCIF_PKG_HEADER, 0 };
+	u32 hdr_len = len;
+	const u32 ftr[2] = { CCIF_PKG_FOOTER, CCIF_PKG_FOOTER };
+	u32 pos;
+
+	if (!rb || !src || !len)
+		return -CCCI_ERR_INVALID_PARAM;
+	if (ccci_ringbuf_writeable(rb, len) <= 0)
+		return -2;	/* CCCI_RINGBUF_NOT_ENOUGH */
+
+	read = ctl_rd(rb, CTL_TX_READ);
+	write = ctl_rd(rb, CTL_TX_WRITE);
+	length = ctl_rd(rb, CTL_TX_LEN);
+
+	pos = write;
+	ring_write(rb, rb->tx_buf, pos, &hdr[0], 4, length);
+	pos = (pos + 4) % length;
+	ring_write(rb, rb->tx_buf, pos, &hdr_len, 4, length);
+	pos = (pos + 4) % length;
+	ring_write(rb, rb->tx_buf, pos, src, len, length);
+	pos = (pos + ring_align(len)) % length;
+	ring_write(rb, rb->tx_buf, pos, &ftr[0], 4, length);
+	pos = (pos + 4) % length;
+	ring_write(rb, rb->tx_buf, pos, &ftr[1], 4, length);
+	pos = (pos + 4) % length;
+
+	/* publish only after the payload is visible to the modem */
+	wmb();
+	ctl_wr(rb, CTL_TX_WRITE, pos);
+
+	return len;
+}
+
+int ccci_ringbuf_read(struct ccci_ringbuf *rb, void *dst, unsigned int len)
+{
+	u32 read, length;
+
+	if (!rb || !dst || !len)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	read = ctl_rd(rb, CTL_RX_READ);
+	length = ctl_rd(rb, CTL_RX_LEN);
+	if (len > length)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	ring_read(rb, rb->rx_buf, (read + CCIF_PKG_HDR_LEN) % length, dst, len,
+		  length);
+
+	return len;
+}
+
+void ccci_ringbuf_move_rpointer(struct ccci_ringbuf *rb, unsigned int len)
+{
+	u32 read, length, pos;
+
+	if (!rb)
+		return;
+
+	read = ctl_rd(rb, CTL_RX_READ);
+	length = ctl_rd(rb, CTL_RX_LEN);
+	pos = (read + ring_align(len + CCIF_PKG_HDR_LEN + CCIF_PKG_FTR_LEN)) %
+	      length;
+	/* make sure the payload was consumed before the modem may reuse it */
+	mb();
+	ctl_wr(rb, CTL_RX_READ, pos);
+}
+
+void ccci_ringbuf_reset(struct ccci_ringbuf *rb, bool tx)
+{
+	if (!rb)
+		return;
+
+	if (tx) {
+		ctl_wr(rb, CTL_TX_READ, 0);
+		ctl_wr(rb, CTL_TX_WRITE, 0);
+	} else {
+		ctl_wr(rb, CTL_RX_READ, 0);
+		ctl_wr(rb, CTL_RX_WRITE, 0);
+	}
+	wmb();
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_sysfs.c b/drivers/misc/mediatek/ccci/ccci_sysfs.c
new file mode 100644
index 000000000..ddd43d431
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_sysfs.c
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI per-modem sysfs attributes and debugfs views.
+ *
+ * Attribute names follow the Samsung/MTK ROM service set
+ * (md_enable/version/md_state/dump/boot_info/md_exception, see downstream
+ * ccci_util_lib_sys.c for the global /sys/kernel/ccci variant).  Here they are
+ * attached to the per-modem device /sys/class/ccci_node/mdN and duplicated in
+ * debugfs ccci/mdN, which the ccci_util log driver also populates.
+ */
+#include <linux/ccci.h>
+#include <linux/debugfs.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "ccci_priv.h"
+
+static struct dentry *ccci_debugfs_root;
+
+/* ------------------------------------------------------------------ */
+/* text helpers                                                        */
+/* ------------------------------------------------------------------ */
+static const char *ccci_state_name(enum ccci_md_state state)
+{
+	switch (state) {
+	case CCCI_MD_BOOTING:
+		return "boot";
+	case CCCI_MD_READY:
+		return "ready";
+	case CCCI_MD_EXCEPTION:
+		return "exception";
+	case CCCI_MD_STOPPED:
+		return "stop";
+	case CCCI_MD_INVALID:
+	default:
+		return "invalid";
+	}
+}
+
+static int ccci_show_version(struct ccci_md *md, char *buf, size_t len)
+{
+	return scnprintf(buf, len, "%u\n", CCCI_DRIVER_VER);
+}
+
+static int ccci_show_state(struct ccci_md *md, char *buf, size_t len)
+{
+	return scnprintf(buf, len, "%s, boot stage %u, ex stage %u\n",
+			 ccci_state_name(md->state), md->boot_stage,
+			 md->ex_stage);
+}
+
+static int ccci_show_boot_info(struct ccci_md *md, char *buf, size_t len)
+{
+	if (!md->boot_info[0])
+		return scnprintf(buf, len, "not loaded\n");
+	return scnprintf(buf, len, "%s", md->boot_info);
+}
+
+static int ccci_show_exception(struct ccci_md *md, char *buf, size_t len)
+{
+	return scnprintf(buf, len, "type %u, stage %u, state %s\n", md->ex_type,
+			 md->ex_stage, ccci_state_name(md->state));
+}
+
+static int ccci_show_enable(struct ccci_md *md, char *buf, size_t len)
+{
+	bool up = md->state != CCCI_MD_STOPPED && md->state != CCCI_MD_INVALID;
+
+	return scnprintf(buf, len, "%d\n", up);
+}
+
+static int ccci_store_enable(struct ccci_md *md, const char *buf, size_t len)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	if (enable)
+		ret = ccci_md_start(md);
+	else
+		ret = ccci_md_stop(md, 0);
+	return ret ? ret : len;
+}
+
+static int ccci_store_dump(struct ccci_md *md, const char *buf, size_t len)
+{
+	struct ccci_port *port;
+
+	ccci_md_info(md, "state %s, boot %u, ex %u, fw %s\n",
+		     ccci_state_name(md->state), md->boot_stage, md->ex_stage,
+		     md->boot.file_name[0] ? md->boot.file_name : "none");
+	ccci_ccif_dump_regs(md, NULL);
+	list_for_each_entry(port, &md->ports_list, node)
+		ccci_md_info(md, "port %-18s ch %3u/%-3u q %2u/%-3u rx %llu tx %llu drop %llu busy %llu\n",
+			     port->name, port->tx_ch, port->rx_ch, port->txq,
+			     port->rxq, port->rx_pkts, port->tx_pkts,
+			     port->rx_drops, port->tx_busy_cnt);
+	return len;
+}
+
+/* ------------------------------------------------------------------ */
+/* sysfs                                                               */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_md_enable_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	return ccci_show_enable(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+
+static ssize_t ccci_md_enable_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	return ccci_store_enable(dev_get_drvdata(dev), buf, count);
+}
+static DEVICE_ATTR_RW(ccci_md_enable);
+
+static ssize_t ccci_version_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	return ccci_show_version(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_version);
+
+static ssize_t ccci_md_state_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	return ccci_show_state(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_md_state);
+
+static ssize_t ccci_boot_info_show(struct device *dev,
+				   struct device_attribute *attr, char *buf)
+{
+	return ccci_show_boot_info(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_boot_info);
+
+static ssize_t ccci_md_exception_show(struct device *dev,
+				      struct device_attribute *attr,
+				      char *buf)
+{
+	return ccci_show_exception(dev_get_drvdata(dev), buf, PAGE_SIZE);
+}
+static DEVICE_ATTR_RO(ccci_md_exception);
+
+static ssize_t ccci_dump_store(struct device *dev,
+			       struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	return ccci_store_dump(dev_get_drvdata(dev), buf, count);
+}
+static DEVICE_ATTR_WO(ccci_dump);
+
+static struct attribute *ccci_md_attrs[] = {
+	&dev_attr_ccci_md_enable.attr,
+	&dev_attr_ccci_version.attr,
+	&dev_attr_ccci_md_state.attr,
+	&dev_attr_ccci_dump.attr,
+	&dev_attr_ccci_boot_info.attr,
+	&dev_attr_ccci_md_exception.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(ccci_md);
+
+/* ------------------------------------------------------------------ */
+/* debugfs                                                             */
+/* ------------------------------------------------------------------ */
+static int ccci_dbg_version_show(struct seq_file *s, void *unused)
+{
+	char buf[32];
+
+	ccci_show_version(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static int ccci_dbg_state_show(struct seq_file *s, void *unused)
+{
+	struct ccci_md *md = s->private;
+	struct ccci_port *port;
+
+	seq_printf(s, "md%u: %s\n", md->id + 1, ccci_state_name(md->state));
+	seq_printf(s, "transport: %s\n",
+		   md->cldma ? "cldma" : (md->ring_mode ? "ccif-ring" : "none"));
+	seq_printf(s, "fw: %s (%u bytes)\n",
+		   md->boot.file_name[0] ? md->boot.file_name : "none",
+		   md->boot.md_img_size);
+	seq_printf(s, "smem: %pa + 0x%zx\n", &md->smem_phy, md->smem_size);
+	list_for_each_entry(port, &md->ports_list, node)
+		seq_printf(s, "  %-18s ch %3u/%-3u q %2u/%-3u rx %llu tx %llu\n",
+			   port->name, port->tx_ch, port->rx_ch, port->txq,
+			   port->rxq, port->rx_pkts, port->tx_pkts);
+	return 0;
+}
+
+static int ccci_dbg_ccif_show(struct seq_file *s, void *unused)
+{
+	ccci_ccif_dump_regs(s->private, s);
+	return 0;
+}
+
+static int ccci_dbg_boot_show(struct seq_file *s, void *unused)
+{
+	char buf[256];
+
+	ccci_show_boot_info(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static int ccci_dbg_exception_show(struct seq_file *s, void *unused)
+{
+	char buf[128];
+
+	ccci_show_exception(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static int ccci_dbg_enable_show(struct seq_file *s, void *unused)
+{
+	char buf[16];
+
+	ccci_show_enable(s->private, buf, sizeof(buf));
+	seq_puts(s, buf);
+	return 0;
+}
+
+static ssize_t ccci_dbg_enable_write(struct file *file,
+				     const char __user *ubuf, size_t len,
+				     loff_t *ppos)
+{
+	struct ccci_md *md = file_inode(file)->i_private;
+	char buf[16];
+	size_t n = min(len, sizeof(buf) - 1);
+	int ret;
+
+	if (copy_from_user(buf, ubuf, n))
+		return -EFAULT;
+	buf[n] = 0;
+	ret = ccci_store_enable(md, buf, n);
+	return ret < 0 ? ret : n;
+}
+
+static int ccci_dbg_enable_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ccci_dbg_enable_show, inode->i_private);
+}
+
+static const struct file_operations ccci_dbg_enable_fops = {
+	.owner = THIS_MODULE,
+	.open = ccci_dbg_enable_open,
+	.read = seq_read,
+	.write = ccci_dbg_enable_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+#define CCCI_DBG_SEQ_FOPS(_name, _showfn)				\
+static int _name##_open(struct inode *inode, struct file *file)		\
+{									\
+	return single_open(file, _showfn, inode->i_private);		\
+}									\
+static const struct file_operations _name##_fops = {			\
+	.owner = THIS_MODULE,						\
+	.open = _name##_open,						\
+	.read = seq_read,						\
+	.llseek = seq_lseek,						\
+	.release = single_release,					\
+}
+
+CCCI_DBG_SEQ_FOPS(ccci_dbg_version, ccci_dbg_version_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_state, ccci_dbg_state_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_ccif, ccci_dbg_ccif_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_boot, ccci_dbg_boot_show);
+CCCI_DBG_SEQ_FOPS(ccci_dbg_exception, ccci_dbg_exception_show);
+
+static struct dentry *ccci_dbg_dir_get(struct ccci_md *md)
+{
+	struct dentry *dir;
+	char name[16];
+
+	if (!ccci_debugfs_root)
+		return NULL;
+
+	snprintf(name, sizeof(name), "md%u", md->id + 1);
+	dir = debugfs_lookup(name, ccci_debugfs_root);
+	if (IS_ERR_OR_NULL(dir)) {
+		dir = debugfs_create_dir(name, ccci_debugfs_root);
+		if (IS_ERR(dir))
+			return NULL;
+	}
+	return dir;
+}
+
+int ccci_sysfs_md_init(struct ccci_md *md)
+{
+	int ret;
+
+	ret = sysfs_create_groups(&md->dev->kobj, ccci_md_groups);
+	if (ret)
+		return ret;
+
+	md->dbg_dir = ccci_dbg_dir_get(md);
+	if (!md->dbg_dir)
+		return 0;	/* debugfs is optional */
+
+	debugfs_create_file("ccci_version", 0444, md->dbg_dir, md,
+			    &ccci_dbg_version_fops);
+	debugfs_create_file("ccci_md_state", 0444, md->dbg_dir, md,
+			    &ccci_dbg_state_fops);
+	debugfs_create_file("ccci_md_enable", 0644, md->dbg_dir, md,
+			    &ccci_dbg_enable_fops);
+	debugfs_create_file("ccci_boot_info", 0444, md->dbg_dir, md,
+			    &ccci_dbg_boot_fops);
+	debugfs_create_file("ccci_md_exception", 0444, md->dbg_dir, md,
+			    &ccci_dbg_exception_fops);
+	debugfs_create_file("ccif", 0444, md->dbg_dir, md, &ccci_dbg_ccif_fops);
+	return 0;
+}
+
+void ccci_sysfs_md_exit(struct ccci_md *md)
+{
+	if (!md->dev)
+		return;
+	sysfs_remove_groups(&md->dev->kobj, ccci_md_groups);
+	md->dbg_dir = NULL;	/* the util log driver owns the directory */
+}
+
+int ccci_sysfs_init(void)
+{
+	ccci_debugfs_root = debugfs_create_dir("ccci", NULL);
+	if (IS_ERR(ccci_debugfs_root)) {
+		pr_warn("ccci: debugfs unavailable (%ld)\n",
+			PTR_ERR(ccci_debugfs_root));
+		ccci_debugfs_root = NULL;
+	}
+	return 0;
+}
+
+void ccci_sysfs_exit(void)
+{
+	if (ccci_debugfs_root)
+		debugfs_remove(ccci_debugfs_root);
+	ccci_debugfs_root = NULL;
+}
