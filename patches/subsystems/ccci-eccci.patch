+
+int ccci_md_port_cfg(struct ccci_md *md)
+{
+	const struct ccci_port *table;
+	unsigned int count, i;
+	struct ccci_port *ports;
+
+	switch (md->id) {
+	case CCCI_MD_SYS1:
+		table = ccci_md1_ports;
+		count = ARRAY_SIZE(ccci_md1_ports);
+		break;
+	case CCCI_MD_SYS3:
+		table = ccci_md3_ports;
+		count = ARRAY_SIZE(ccci_md3_ports);
+		break;
+	default:
+		ccci_md_err(md, "no port table for this modem\n");
+		return -ENODEV;
+	}
+
+	ports = kmemdup(table, sizeof(*ports) * count, GFP_KERNEL);
+	if (!ports)
+		return -ENOMEM;
+
+	md->ports = ports;
+	md->port_count = count;
+
+	for (i = 0; i < count; i++) {
+		struct ccci_port *port = &ports[i];
+
+		port->md = md;
+		port->rx_len_th = CCCI_PORT_RX_LEN_TH;
+		skb_queue_head_init(&port->rx_q);
+		spin_lock_init(&port->rx_lock);
+		init_waitqueue_head(&port->rx_wq);
+		atomic_set(&port->open_count, 0);
+		INIT_LIST_HEAD(&port->node);
+		INIT_LIST_HEAD(&port->rx_node);
+		list_add_tail(&port->node, &md->ports_list);
+		if (port->rx_ch < CCCI_MAX_CH_NUM)
+			list_add_tail(&port->rx_node, &md->rx_ch_ports[port->rx_ch]);
+
+		if (port->ops && port->ops->init) {
+			int ret = port->ops->init(port);
+
+			if (ret)
+				ccci_md_warn(md, "port %s init failed %d\n",
+					     port->name, ret);
+		}
+	}
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* module init                                                         */
+/* ------------------------------------------------------------------ */
+static int __init ccci_init(void)
+{
+	int ret;
+
+	ccci_class = class_create(CCCI_DEV_NAME);
+	if (IS_ERR(ccci_class))
+		return PTR_ERR(ccci_class);
+
+	ret = ccci_sysfs_init();
+	if (ret)
+		goto err_class;
+
+	ret = ccci_util_init();
+	if (ret) {
+		pr_err("ccci: util init failed %d\n", ret);
+		goto err_sysfs;
+	}
+
+	ret = ccci_platform_register();
+	if (ret)
+		goto err_util;
+
+	pr_info("ccci: core initialised (driver ver 0x%08x)\n", CCCI_DRIVER_VER);
+	return 0;
+
+err_util:
+	ccci_util_exit();
+err_sysfs:
+	ccci_sysfs_exit();
+err_class:
+	class_destroy(ccci_class);
+	return ret;
+}
+
+static void __exit ccci_exit(void)
+{
+	ccci_platform_unregister();
+	ccci_util_exit();
+	ccci_sysfs_exit();
+	class_destroy(ccci_class);
+}
+
+module_init(ccci_init);
+module_exit(ccci_exit);
+
+MODULE_AUTHOR("MediaTek Inc.");
+MODULE_DESCRIPTION("MediaTek CCCI modem core (MT6735/MT6737T port)");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/ccci/ccci_platform.c b/drivers/misc/mediatek/ccci/ccci_platform.c
new file mode 100644
index 000000000..25b93d293
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_platform.c
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI platform driver for the MT6735/MT6737T mdcldma block.
+ *
+ * DT node (downstream arch/arm64/boot/dts/mt6735.dtsi, node
+ * "mdcldma@1000A000"): reg order AP_CLDMA_AO, MD_CLDMA_AO, AP_CLDMA_PDN,
+ * MD_CLDMA_PDN, AP_CCIF, MD_CCIF; interrupts CLDMA, CCIF, MDWDT.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/mt6735/cldma_platform.c and
+ * drivers/misc/mediatek/eccci/modem_cldma.c (probe/remove/PM).
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#include <linux/ccci.h>
+#include <linux/clk.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_MD1_RES_NAME	"md1"
+
+/* Downstream mt6735/modem_reg_base.h: MD1 boot slave + RGU. */
+#define CCCI_MD1_BOOT_VECTOR	0x20190000
+#define CCCI_MD1_BOOT_VECTOR_KEY 0x2019379C
+#define CCCI_MD1_BOOT_VECTOR_EN	0x20195488
+#define CCCI_MD1_RGU_BASE	0x20050000
+
+struct ccci_plat {
+	struct ccci_md *md;
+	struct ccci_ccif *ccif;
+	struct ccci_cldma *cldma;
+	struct clk *clk;
+	void __iomem *cldma_ao;
+	void __iomem *cldma_pdn;
+	void __iomem *ccif_ap;
+	unsigned int cldma_irq;
+	unsigned int md_wdt_irq;
+};
+
+static int ccci_plat_parse_dt(struct platform_device *pdev,
+			      struct ccci_md_cfg *cfg, phys_addr_t *rgu,
+			      phys_addr_t *bv, phys_addr_t *bv_key,
+			      phys_addr_t *bv_en)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct resource *res;
+	const char *fw;
+	u32 val;
+	int nreg = 0, ret;
+
+	ret = of_property_read_u32(np, "mediatek,md_id", &val);
+	if (ret)
+		val = 0;
+	if (val >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+
+	cfg->md_id = val;
+	cfg->name = CCCI_MD1_RES_NAME;
+	cfg->irat_md_id = CCCI_MAX_MD_NUM;
+
+	if (!of_property_read_string(np, "firmware-name", &fw))
+		cfg->firmware_name = fw;
+	else
+		cfg->firmware_name = "md1img";
+
+	if (!of_property_read_u32(np, "mediatek,cldma_capability", &val))
+		cfg->capability = val;
+
+	/* boot slave / RGU addresses: DT overrides, otherwise the fixed MT6735
+	 * values from downstream mt6735/modem_reg_base.h
+	 */
+	*bv = CCCI_MD1_BOOT_VECTOR;
+	*bv_key = CCCI_MD1_BOOT_VECTOR_KEY;
+	*bv_en = CCCI_MD1_BOOT_VECTOR_EN;
+	*rgu = CCCI_MD1_RGU_BASE;
+	of_property_read_u32(np, "mediatek,md-boot-vector", &val);
+	if (val)
+		*bv = val;
+	of_property_read_u32(np, "mediatek,md-boot-vector-key", &val);
+	if (val)
+		*bv_key = val;
+	of_property_read_u32(np, "mediatek,md-boot-vector-en", &val);
+	if (val)
+		*bv_en = val;
+	if (!of_property_read_u32(np, "mediatek,rgu-base", &val) && val)
+		*rgu = val;
+
+	while (platform_get_resource(pdev, IORESOURCE_MEM, nreg))
+		nreg++;
+
+	if (nreg < 2)
+		return -ENODEV;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, nreg >= 6 ? 4 : 0);
+	cfg->ccif_phys = res->start;
+	cfg->ccif_size = resource_size(res);
+
+	cfg->md_boot_vector_phys = *bv;
+	cfg->md_boot_vector_key_phys = *bv_key;
+	cfg->md_boot_vector_en_phys = *bv_en;
+	cfg->rgu_phys = *rgu;
+	cfg->sram_size = CCIF_SRAM_SIZE;
+
+	return 0;
+}
+
+static int ccci_plat_hw_get(struct platform_device *pdev, struct ccci_plat *pl,
+			    struct ccci_md_cfg *cfg, bool *has_cldma)
+{
+	int nreg = 0, irq;
+
+	while (platform_get_resource(pdev, IORESOURCE_MEM, nreg))
+		nreg++;
+
+	*has_cldma = nreg >= 6;
+	if (*has_cldma) {
+		pl->cldma_ao = devm_platform_ioremap_resource(pdev, 0);
+		if (IS_ERR(pl->cldma_ao))
+			return PTR_ERR(pl->cldma_ao);
+		/* MD side registers are mapped by the CLDMA engine owner; keep
+		 * only AP_CLDMA_PDN here for suspend/resume book-keeping.
+		 */
+		pl->cldma_pdn = devm_platform_ioremap_resource(pdev, 2);
+		if (IS_ERR(pl->cldma_pdn))
+			return PTR_ERR(pl->cldma_pdn);
+		pl->ccif_ap = devm_platform_ioremap_resource(pdev, 4);
+		if (IS_ERR(pl->ccif_ap))
+			return PTR_ERR(pl->ccif_ap);
+
+		pl->cldma_irq = platform_get_irq(pdev, 0);
+		cfg->ccif_irq = platform_get_irq(pdev, 1);
+	} else {
+		pl->ccif_ap = devm_platform_ioremap_resource(pdev, 0);
+		if (IS_ERR(pl->ccif_ap))
+			return PTR_ERR(pl->ccif_ap);
+		cfg->ccif_irq = platform_get_irq(pdev, 0);
+	}
+	irq = platform_get_irq_optional(pdev, *has_cldma ? 2 : 1);
+	pl->md_wdt_irq = irq > 0 ? irq : 0;
+
+	if ((int)cfg->ccif_irq < 0) {
+		dev_err(&pdev->dev, "no CCIF interrupt in DT\n");
+		return -ENODEV;
+	}
+	return 0;
+}
+
+static const struct of_device_id ccci_mdcldma_of_match[] = {
+	{ .compatible = "mediatek,mdcldma" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ccci_mdcldma_of_match);
+
+static int ccci_mdcldma_probe(struct platform_device *pdev)
+{
+	struct ccci_plat *pl;
+	struct ccci_md_cfg cfg = {};
+	struct ccci_cldma_cfg ccfg = {};
+	phys_addr_t rgu = 0, bv = 0, bv_key = 0, bv_en = 0;
+	struct device *dev = &pdev->dev;
+	void __iomem *md_ccif;
+	bool has_cldma = false;
+	int ret;
+
+	if (!dev->of_node) {
+		dev_err(dev, "missing DT node\n");
+		return -ENODEV;
+	}
+
+	pl = devm_kzalloc(dev, sizeof(*pl), GFP_KERNEL);
+	if (!pl)
+		return -ENOMEM;
+
+	ret = ccci_plat_parse_dt(pdev, &cfg, &rgu, &bv, &bv_key, &bv_en);
+	if (ret) {
+		dev_err(dev, "DT parse failed %d\n", ret);
+		return ret;
+	}
+
+	ret = ccci_plat_hw_get(pdev, pl, &cfg, &has_cldma);
+	if (ret) {
+		dev_err(dev, "resource mapping failed %d\n", ret);
+		return ret;
+	}
+
+	/* MD side CCIF view, used for register dumps only */
+	md_ccif = devm_platform_ioremap_resource(pdev, has_cldma ? 5 : 1);
+	if (IS_ERR(md_ccif))
+		md_ccif = NULL;
+
+	pl->clk = devm_clk_get_optional(dev, "scp-sys-md1-main");
+	if (IS_ERR(pl->clk)) {
+		dev_err(dev, "cannot get scp-sys-md1-main: %ld\n",
+			PTR_ERR(pl->clk));
+		return PTR_ERR(pl->clk);
+	}
+	if (!pl->clk)
+		dev_warn(dev, "no scp-sys-md1-main clock, relying on power domain\n");
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = ccci_md_register(&cfg, dev);
+	if (ret) {
+		dev_err(dev, "modem registration failed %d\n", ret);
+		return ret;
+	}
+
+	pl->md = ccci_md_get(cfg.md_id);
+	if (!pl->md) {
+		ccci_unregister_modem(cfg.md_id);
+		return -ENODEV;
+	}
+	pl->md->pdev = pdev;
+	pl->md->boot.clk = pl->clk;
+
+	pl->ccif = ccci_ccif_create(pl->md, dev, pl->ccif_ap, md_ccif,
+				    devm_ioremap(dev, rgu, 0x40),
+				    bv, bv_key, bv_en, cfg.ccif_irq,
+				    pl->md_wdt_irq, cfg.sram_size, !has_cldma);
+	if (IS_ERR(pl->ccif)) {
+		ret = PTR_ERR(pl->ccif);
+		pl->ccif = NULL;
+		dev_err(dev, "CCIF init failed %d\n", ret);
+		goto err_unregister;
+	}
+	ret = ccci_md_attach_ccif(pl->md, pl->ccif);
+	if (ret)
+		goto err_ccif;
+
+	if (has_cldma) {
+		ccfg.dev = dev;
+		ccfg.ap_base = pl->cldma_ao;
+		ccfg.ap_pdn_base = pl->cldma_pdn;
+		ccfg.irq = pl->cldma_irq;
+		ccfg.smem_phys = pl->md->smem_phy;
+		ccfg.smem_size = pl->md->smem_size;
+		pl->cldma = ccci_cldma_create(&ccfg);
+		if (!pl->cldma) {
+			dev_err(dev, "CLDMA engine create failed\n");
+			ret = -ENOMEM;
+			goto err_ccif;
+		}
+		ccci_cldma_set_rx_cb(pl->cldma, ccci_md_rx_cb, pl->md);
+		ccci_md_attach_cldma(pl->md, pl->cldma);
+	}
+
+	platform_set_drvdata(pdev, pl);
+	dev_info(dev, "md%u probed (%s data path, fw %s)\n", cfg.md_id + 1,
+		 has_cldma ? "CLDMA" : "CCIF-ring", cfg.firmware_name);
+	return 0;
+
+err_ccif:
+	ccci_ccif_destroy(pl->ccif);
+err_unregister:
+	ccci_unregister_modem(cfg.md_id);
+	return ret;
+}
+
+static void ccci_mdcldma_remove(struct platform_device *pdev)
+{
+	struct ccci_plat *pl = platform_get_drvdata(pdev);
+	unsigned int md_id;
+
+	if (!pl || !pl->md)
+		return;
+
+	md_id = pl->md->id;
+	if (pl->cldma) {
+		ccci_cldma_destroy(pl->cldma);
+		pl->cldma = NULL;
+	}
+	if (pl->ccif) {
+		ccci_ccif_destroy(pl->ccif);
+		pl->ccif = NULL;
+	}
+	ccci_unregister_modem(md_id);
+	platform_set_drvdata(pdev, NULL);
+}
+
+static void ccci_mdcldma_shutdown(struct platform_device *pdev)
+{
+	struct ccci_plat *pl = platform_get_drvdata(pdev);
+
+	if (pl && pl->md)
+		ccci_md_stop(pl->md, 0);
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int ccci_mdcldma_suspend(struct device *dev)
+{
+	struct ccci_plat *pl = dev_get_drvdata(dev);
+
+	if (!pl || !pl->md)
+		return 0;
+	/* the modem keeps running; only the AP side is quiesced */
+	dev_dbg(dev, "suspend, md state %d\n", pl->md->state);
+	return 0;
+}
+
+static int ccci_mdcldma_resume(struct device *dev)
+{
+	struct ccci_plat *pl = dev_get_drvdata(dev);
+
+	if (!pl || !pl->md || !pl->ccif)
+		return 0;
+	/* downstream md_ccif_resume(): restore CCIF arbitration */
+	if (pl->ccif->ap_base)
+		writel(0x01, pl->ccif->ap_base + APCCIF_CON);
+	return 0;
+}
+
+static int ccci_mdcldma_restore_noirq(struct device *dev)
+{
+	struct ccci_plat *pl = dev_get_drvdata(dev);
+
+	if (!pl || !pl->md)
+		return 0;
+	/* IPO-H: the modem lost power, force a full reload on next start */
+	pl->md->boot.fw_valid = false;
+	pl->md->boot_stage = CCCI_BOOT_STAGE_0;
+	return 0;
+}
+#endif /* CONFIG_PM_SLEEP */
+
+static const struct dev_pm_ops ccci_modem_pm_ops = {
+#ifdef CONFIG_PM_SLEEP
+	.suspend = ccci_mdcldma_suspend,
+	.resume = ccci_mdcldma_resume,
+	.freeze = ccci_mdcldma_suspend,
+	.thaw = ccci_mdcldma_resume,
+	.poweroff = ccci_mdcldma_suspend,
+	.restore = ccci_mdcldma_resume,
+	.restore_noirq = ccci_mdcldma_restore_noirq,
+#endif
+};
+
+static struct platform_driver ccci_mdcldma_driver = {
+	.probe = ccci_mdcldma_probe,
+	.remove = ccci_mdcldma_remove,
+	.shutdown = ccci_mdcldma_shutdown,
+	.driver = {
+		.name = "ccci_mdcldma",
+		.of_match_table = ccci_mdcldma_of_match,
+		.pm = &ccci_modem_pm_ops,
+	},
+};
+
+int ccci_platform_register(void)
+{
+	return platform_driver_register(&ccci_mdcldma_driver);
+}
+
+void ccci_platform_unregister(void)
+{
+	platform_driver_unregister(&ccci_mdcldma_driver);
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_port_char.c b/drivers/misc/mediatek/ccci/ccci_port_char.c
new file mode 100644
index 000000000..be290ff6e
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_port_char.c
@@ -0,0 +1,577 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI character ports (/dev/ccci_monitor, /dev/ttyC0, /dev/ccci_fs, ...).
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_char.c (read/write/poll/ioctl and the
+ * critical-user bookkeeping) and port_cfg.c (port table, see ccci_core.c).
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#include <linux/cdev.h>
+#include <linux/ccci.h>
+#include <linux/compat.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/kdev_t.h>
+#include <linux/module.h>
+#include <linux/poll.h>
+#include <linux/sched.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#include "ccci_priv.h"
+
+/*
+ * Downstream keeps four "critical user" flags so the modem is only reset from
+ * userspace when no important client is attached (port_char.c:50-89).
+ */
+static void ccci_char_open_check(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+
+	if (port->rx_ch == CCCI_FS_RX)
+		md->critical_user[0] = 1;
+	if (port->rx_ch == CCCI_UART2_RX)
+		md->critical_user[1] = 1;
+	if (port->rx_ch == CCCI_MD_LOG_RX)
+		md->critical_user[2] = 0;
+	if (port->rx_ch == CCCI_UART1_RX)
+		md->critical_user[3] = 0;
+}
+
+static int ccci_char_close_check(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+
+	if (port->rx_ch == CCCI_FS_RX && !atomic_read(&port->open_count))
+		md->critical_user[0] = 0;
+	if (port->rx_ch == CCCI_UART2_RX && !atomic_read(&port->open_count))
+		md->critical_user[1] = 0;
+	if (port->rx_ch == CCCI_MD_LOG_RX && !atomic_read(&port->open_count))
+		md->critical_user[2] = 0;
+	if (port->rx_ch == CCCI_UART1_RX && !atomic_read(&port->open_count))
+		md->critical_user[3] = 0;
+
+	if (md->critical_user[0] || md->critical_user[1])
+		return 1;
+	if (md->critical_user[2] || md->critical_user[3])
+		return 1;
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* open / release                                                      */
+/* ------------------------------------------------------------------ */
+static int ccci_char_open(struct inode *inode, struct file *file)
+{
+	struct ccci_port *port = ccci_get_port_for_node(inode->i_rdev);
+
+	if (!port)
+		return -ENODEV;
+
+	if (atomic_inc_return(&port->open_count) > 1) {
+		atomic_dec(&port->open_count);
+		ccci_md_err(port->md, "port %s already open\n", port->name);
+		return -EBUSY;
+	}
+
+	file->private_data = port;
+	nonseekable_open(inode, file);
+	ccci_char_open_check(port);
+	ccci_md_dbg(port->md, "port %s opened by %s\n", port->name,
+		    current->comm);
+	return 0;
+}
+
+static int ccci_char_release(struct inode *inode, struct file *file)
+{
+	struct ccci_port *port = file->private_data;
+	unsigned long flags;
+	struct sk_buff *skb;
+
+	atomic_dec(&port->open_count);
+
+	spin_lock_irqsave(&port->rx_lock, flags);
+	while ((skb = __skb_dequeue(&port->rx_q)) != NULL) {
+		if (port->rx_len)
+			port->rx_len--;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		dev_kfree_skb_any(skb);
+		spin_lock_irqsave(&port->rx_lock, flags);
+	}
+	if (port->rx_current) {
+		dev_kfree_skb_any(port->rx_current);
+		port->rx_current = NULL;
+	}
+	port->rx_len = 0;
+	port->rx_full = false;
+	spin_unlock_irqrestore(&port->rx_lock, flags);
+
+	/* let a pending modem reset proceed if no critical user is left */
+	if (ccci_char_close_check(port) == 0 &&
+	    port->md->state == CCCI_MD_STOPPED)
+		ccci_send_virtual_md_msg(port->md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_READY_TO_RESET, 0);
+
+	ccci_port_ask_more(port);
+	ccci_md_dbg(port->md, "port %s closed\n", port->name);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* read                                                                */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_char_read(struct file *file, char __user *buf,
+			      size_t count, loff_t *ppos)
+{
+	struct ccci_port *port = file->private_data;
+	struct sk_buff *skb;
+	struct ccci_header *ccci_h;
+	size_t read_len;
+	unsigned long flags;
+	int ret;
+
+	if (!count)
+		return 0;
+
+	if (!port->rx_current) {
+		if (skb_queue_empty(&port->rx_q)) {
+			if (file->f_flags & O_NONBLOCK)
+				return -EAGAIN;
+			ret = wait_event_interruptible(port->rx_wq,
+						       !skb_queue_empty(&port->rx_q));
+			if (ret)
+				return -ERESTARTSYS;
+		}
+
+		spin_lock_irqsave(&port->rx_lock, flags);
+		skb = __skb_dequeue(&port->rx_q);
+		if (skb && port->rx_len)
+			port->rx_len--;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		if (!skb)
+			return -EAGAIN;
+
+		port->rx_current = skb;
+		port->rx_current_user_header = false;
+
+		if (port->flags & PORT_F_USER_HEADER) {
+			/* monitor channel: hand the header to md_init and tag it
+			 * with the legacy CCCI_MONITOR_CH_ID (port_char.c:205)
+			 */
+			ccci_h = (struct ccci_header *)skb->data;
+			if (ccci_h->data[0] == CCCI_MAGIC_NUM &&
+			    ccci_h->channel == CCCI_MONITOR_CH) {
+				*(((u32 *)ccci_h) + 2) = CCCI_MONITOR_CH_ID;
+				port->rx_current_user_header = true;
+			}
+		} else {
+			skb_pull(skb, CCCI_HEADER_SIZE);
+		}
+	}
+
+	skb = port->rx_current;
+	read_len = min(count, (size_t)skb->len);
+	if (copy_to_user(buf, skb->data, read_len)) {
+		ccci_md_err(port->md, "read on %s: copy_to_user failed\n",
+			    port->name);
+		return -EFAULT;
+	}
+	skb_pull(skb, read_len);
+	if (!skb->len) {
+		dev_kfree_skb_any(skb);
+		port->rx_current = NULL;
+		ccci_port_ask_more(port);
+	}
+	return read_len;
+}
+
+/* ------------------------------------------------------------------ */
+/* write                                                               */
+/* ------------------------------------------------------------------ */
+static ssize_t ccci_char_write(struct file *file, const char __user *buf,
+			       size_t count, loff_t *ppos)
+{
+	struct ccci_port *port = file->private_data;
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	size_t limit, actual;
+	bool user_header = port->flags & PORT_F_USER_HEADER;
+	unsigned int qno, retries = 0;
+	int ret;
+
+	if (port->tx_ch == CCCI_MONITOR_CH)
+		return -EPERM;
+
+	if (md->state == CCCI_MD_BOOTING && port->tx_ch != CCCI_FS_TX &&
+	    port->tx_ch != CCCI_RPC_TX)
+		return -ENODEV;
+	if (md->state == CCCI_MD_EXCEPTION && port->tx_ch != CCCI_MD_LOG_TX &&
+	    port->tx_ch != CCCI_UART1_TX && port->tx_ch != CCCI_FS_TX)
+		return -ETXTBSY;
+	if (md->state == CCCI_MD_STOPPED || md->state == CCCI_MD_INVALID)
+		return -ENODEV;
+
+	limit = user_header ? CCCI_MTU + CCCI_HEADER_SIZE : CCCI_MTU;
+	if (!count)
+		return -EINVAL;
+	actual = min(count, limit);
+
+	qno = ccci_port_txq(port);
+	if (qno >= CCCI_MAX_QUEUES)
+		return -ENODEV;
+
+	skb = alloc_skb(CCCI_HEADER_SIZE + actual, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+
+	if (!user_header) {
+		ccci_h = (struct ccci_header *)skb_put(skb, CCCI_HEADER_SIZE);
+		memset(ccci_h, 0, CCCI_HEADER_SIZE);
+		ccci_h->data[0] = 0;
+		ccci_h->data[1] = actual + CCCI_HEADER_SIZE;
+		ccci_h->channel = port->tx_ch;
+		ccci_h->reserved = 0;
+	}
+
+	if (copy_from_user(skb_put(skb, actual), buf, actual)) {
+		dev_kfree_skb_any(skb);
+		return -EFAULT;
+	}
+
+	if (user_header) {
+		/* the CCCI header came from the user, only patch what the ROM
+		 * patches (port_char.c:492-502)
+		 */
+		ccci_h = (struct ccci_header *)skb->data;
+		if (actual == CCCI_HEADER_SIZE)
+			ccci_h->data[0] = CCCI_MAGIC_NUM;
+		else
+			ccci_h->data[1] = actual;
+		ccci_h->channel = port->tx_ch;
+	}
+
+	port->tx_pkts++;
+	for (;;) {
+		ret = ccci_md_send_skb(md, qno, skb);
+		if (!ret)
+			return actual;
+		if (ret != -EBUSY)
+			break;
+		port->tx_busy_cnt++;
+		/* a blocking writer waits for room, like downstream's blocking
+		 * request allocation
+		 */
+		if ((file->f_flags & O_NONBLOCK) || ++retries > 2000)
+			break;
+		usleep_range(1000, 2000);
+	}
+	dev_kfree_skb_any(skb);
+	return ret == -EBUSY ? -EAGAIN : ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* poll                                                                */
+/* ------------------------------------------------------------------ */
+static __poll_t ccci_char_poll(struct file *file, poll_table *wait)
+{
+	struct ccci_port *port = file->private_data;
+	__poll_t mask = 0;
+
+	poll_wait(file, &port->rx_wq, wait);
+	if (port->rx_current || !skb_queue_empty(&port->rx_q))
+		mask |= EPOLLIN | EPOLLRDNORM;
+	if (ccci_md_write_room(port->md, ccci_port_txq(port)) > 0)
+		mask |= EPOLLOUT | EPOLLWRNORM;
+	/* mdlogger polls to learn that the modem is going away */
+	if (port->rx_ch == CCCI_UART1_RX &&
+	    port->md->state != CCCI_MD_READY &&
+	    port->md->state != CCCI_MD_EXCEPTION)
+		mask |= EPOLLERR;
+	return mask;
+}
+
+/* ------------------------------------------------------------------ */
+/* ioctl                                                               */
+/* ------------------------------------------------------------------ */
+static long ccci_char_ioctl(struct file *file, unsigned int cmd,
+			    unsigned long arg)
+{
+	struct ccci_port *port = file->private_data;
+	struct ccci_md *md = port->md;
+	unsigned int val;
+	long ret = 0;
+
+	switch (cmd) {
+	case CCCI_IOC_GET_MD_STATE:
+		ret = put_user((unsigned int)md->boot_stage,
+			       (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_MD_RESET:
+		ccci_md_info(md, "MD reset requested by %s\n", current->comm);
+		ret = ccci_md_reset(md);
+		if (!ret)
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_RESET, 0);
+		break;
+
+	case CCCI_IOC_DO_MD_RST:
+		ret = ccci_md_reset(md);
+		break;
+
+	/* downstream CCCI_IOC_GET_MD_INFO returns the image version, this is
+	 * the closest ROM ioctl to a "get boot info" request
+	 */
+	case CCCI_IOC_GET_MD_INFO:
+		ret = put_user(md->boot.product_ver, (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_GET_MD_EX_TYPE:
+		ret = put_user(md->ex_type, (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_FORCE_MD_ASSERT:
+		ccci_md_info(md, "force MD assert by %s\n", current->comm);
+		ret = ccci_md_force_assert(md,
+					   md->id == CCCI_MD_SYS3 ? 1 : 0);
+		break;
+
+	case CCCI_IOC_SEND_RUN_TIME_DATA:
+		if (port->rx_ch != CCCI_MONITOR_CH) {
+			ret = -EPERM;
+			break;
+		}
+		ret = ccci_boot_send_runtime_data(md, md->sbp_code);
+		break;
+
+	case CCCI_IOC_ENTER_DEEP_FLIGHT:
+		ccci_md_info(md, "enter flight mode by %s\n", current->comm);
+		ret = ccci_md_reset(md);
+		if (!ret) {
+			ccci_md_stop(md, 1000);
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_ENTER_FLIGHT_MODE,
+						       0);
+		}
+		break;
+
+	case CCCI_IOC_LEAVE_DEEP_FLIGHT:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_LEAVE_FLIGHT_MODE,
+					       0);
+		break;
+
+	case CCCI_IOC_DO_START_MD:
+		ret = ccci_md_start(md);
+		break;
+
+	case CCCI_IOC_DO_STOP_MD:
+		ret = ccci_md_stop(md, 0);
+		break;
+
+	case CCCI_IOC_SEND_STOP_MD_REQUEST:
+		ret = ccci_md_reset(md);
+		if (!ret) {
+			ccci_md_stop(md, 0);
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_STOP_MD_REQUEST,
+						       0);
+		}
+		break;
+
+	case CCCI_IOC_SEND_START_MD_REQUEST:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_START_MD_REQUEST, 0);
+		break;
+
+	case CCCI_IOC_POWER_ON_MD_REQUEST:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_POWER_ON_REQUEST, 0);
+		break;
+
+	case CCCI_IOC_POWER_OFF_MD_REQUEST:
+		ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					       CCCI_MD_MSG_POWER_OFF_REQUEST, 0);
+		break;
+
+	case CCCI_IOC_POWER_ON_MD:
+	case CCCI_IOC_POWER_OFF_MD:
+		/* downstream marks these abandoned but returns -1 */
+		ret = -EPERM;
+		break;
+
+	case CCCI_IOC_GET_MD_PROTOCOL_TYPE:
+		/* { "DHL", 0 } as char[16] buffer, downstream port_char.c:574 */
+		ret = copy_to_user((void __user *)arg, "DHL", 4) ? -EFAULT : 0;
+		break;
+
+	case CCCI_IOC_SEND_BATTERY_INFO:
+		/* needs the MT6328 battery driver, absent from this tree */
+		ccci_md_info(md, "battery info request without battery driver\n");
+		ret = -EOPNOTSUPP;
+		break;
+
+	case CCCI_IOC_SET_MD_BOOT_MODE:
+		if (copy_from_user(&val, (void __user *)arg, sizeof(val))) {
+			ret = -EFAULT;
+			break;
+		}
+		if (val > 0 && val < 3)	/* NORMAL / META */
+			md->md_boot_mode = val;
+		else
+			ret = -EINVAL;
+		break;
+
+	case CCCI_IOC_GET_MD_BOOT_MODE:
+		ret = put_user(md->md_boot_mode, (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_GET_MD_MEM_SIZE:
+		ret = put_user((unsigned int)md->img_size,
+			       (unsigned int __user *)arg);
+		break;
+
+	case CCCI_IOC_PCM_BASE_ADDR:
+	case CCCI_IOC_PCM_LEN:
+	case CCCI_IOC_ALLOC_MD_LOG_MEM:
+		/* deprecated shared-memory operations, downstream ignores them */
+		break;
+
+	default:
+		ccci_md_dbg(md, "unsupported ioctl 0x%x on %s\n", cmd,
+			    port->name);
+		ret = -ENOTTY;
+		break;
+	}
+	return ret;
+}
+
+#ifdef CONFIG_COMPAT
+static long ccci_char_compat_ioctl(struct file *file, unsigned int cmd,
+				   unsigned long arg)
+{
+	return ccci_char_ioctl(file, cmd, (unsigned long)compat_ptr(arg));
+}
+#endif
+
+static const struct file_operations ccci_char_fops = {
+	.owner = THIS_MODULE,
+	.open = ccci_char_open,
+	.release = ccci_char_release,
+	.read = ccci_char_read,
+	.write = ccci_char_write,
+	.poll = ccci_char_poll,
+	.unlocked_ioctl = ccci_char_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = ccci_char_compat_ioctl,
+#endif
+};
+
+/* ------------------------------------------------------------------ */
+/* port ops                                                            */
+/* ------------------------------------------------------------------ */
+static int ccci_char_port_recv_skb(struct ccci_port *port, struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+
+	/* nobody is listening: keep the modem alive, count the drop */
+	if (!atomic_read(&port->open_count) && port->rx_ch != CCCI_UART2_RX &&
+	    port->rx_ch != CCCI_PCM_RX && port->rx_ch != CCCI_FS_RX &&
+	    port->rx_ch != CCCI_RPC_RX) {
+		port->rx_drops++;
+		dev_kfree_skb_any(skb);
+		return 0;
+	}
+
+	md->wakeup_src = 0;
+	return ccci_port_recv_skb(port, skb);
+}
+
+static void ccci_char_md_state_notice(struct ccci_port *port, int event)
+{
+	if (port->rx_ch == CCCI_UART1_RX && event == CCCI_MD_STOPPED)
+		wake_up_interruptible(&port->rx_wq);
+}
+
+const struct ccci_port_ops ccci_char_port_ops = {
+	.recv_skb = ccci_char_port_recv_skb,
+	.md_state_notice = ccci_char_md_state_notice,
+};
+
+/* ------------------------------------------------------------------ */
+/* device node management                                              */
+/* ------------------------------------------------------------------ */
+static int ccci_char_add_port(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+	dev_t devt = MKDEV(md->major, port->minor);
+	int ret;
+
+	cdev_init(&port->cdev, &ccci_char_fops);
+	port->cdev.owner = THIS_MODULE;
+	ret = cdev_add(&port->cdev, devt, 1);
+	if (ret) {
+		ccci_md_err(md, "cdev_add(%s, %u:%u) failed %d\n", port->name,
+			    md->major, port->minor, ret);
+		return ret;
+	}
+	port->cdev_added = true;
+
+	port->dev = device_create(ccci_class, md->dev, devt, port, "%s",
+				  port->name);
+	if (IS_ERR(port->dev)) {
+		ret = PTR_ERR(port->dev);
+		port->dev = NULL;
+		cdev_del(&port->cdev);
+		port->cdev_added = false;
+		ccci_md_err(md, "device_create(%s) failed %d\n", port->name,
+			    ret);
+		return ret;
+	}
+	ccci_md_info(md, "port %s at %u:%u\n", port->name, md->major,
+		     port->minor);
+	return 0;
+}
+
+int ccci_port_char_init(struct ccci_md *md)
+{
+	struct ccci_port *port;
+	int ret;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops != &ccci_char_port_ops)
+			continue;
+		ret = ccci_char_add_port(port);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+void ccci_port_char_exit(struct ccci_md *md)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (!port->cdev_added)
+			continue;
+		if (port->dev) {
+			device_destroy(ccci_class,
+				       MKDEV(md->major, port->minor));
+			port->dev = NULL;
+		}
+		cdev_del(&port->cdev);
+		port->cdev_added = false;
+		skb_queue_purge(&port->rx_q);
+		if (port->rx_current) {
+			dev_kfree_skb_any(port->rx_current);
+			port->rx_current = NULL;
+		}
+		port->rx_len = 0;
+	}
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_port_kernel.c b/drivers/misc/mediatek/ccci/ccci_port_kernel.c
new file mode 100644
index 000000000..0148148b4
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_port_kernel.c
@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI kernel ports: control, system, status and RPC channels handled inside
+ * the kernel, plus the kernel service API used by other subsystems.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_kernel.c.  Original copyright
+ * (C) 2015 MediaTek Inc., GPL-2.0.
+ *
+ * Deviations from the ROM, all because the corresponding provider does not
+ * exist in this kernel tree (documented in the leaf report):
+ *   - kernel RPC services (GPIO/ADC/EINT/time) are not implemented; the
+ *     ccci_rpc_k port logs and drops requests.
+ *   - ID_GET_TXPOWER needs the thermal/DVFS clients; the service still
+ *     forwards the system message, and unknown ids return -EOPNOTSUPP.
+ */
+#include <linux/ccci.h>
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/wait.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_MAX_KERN_API	35
+
+struct ccci_md;
+
+struct ccci_sys_cb {
+	unsigned int id;
+	int (*func)(int md_id, int data);
+};
+
+static struct ccci_sys_cb ccci_sys_cb_100[CCCI_MAX_MD_NUM][CCCI_MAX_KERN_API];
+static struct ccci_sys_cb ccci_sys_cb_1000[CCCI_MAX_MD_NUM][CCCI_MAX_KERN_API];
+static DEFINE_MUTEX(ccci_sys_cb_lock);
+
+/* ------------------------------------------------------------------ */
+/* system callback dispatch                                            */
+/* ------------------------------------------------------------------ */
+static void ccci_exec_sys_cb(struct ccci_md *md, unsigned int id, int data)
+{
+	struct ccci_sys_cb *slot = NULL;
+
+	if (id >= 0x1000 && id - 0x1000 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_1000[md->id][id - 0x1000];
+	else if (id >= 0x100 && id - 0x100 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_100[md->id][id - 0x100];
+	if (!slot || !slot->func) {
+		ccci_md_dbg(md, "no kernel callback for message 0x%x\n", id);
+		return;
+	}
+	slot->func(md->id, data);
+}
+
+int register_ccci_sys_call_back(int md_id, unsigned int id,
+				int (*func)(int md_id, int data))
+{
+	struct ccci_sys_cb *slot = NULL;
+	int ret = 0;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM || !func)
+		return -EINVAL;
+
+	mutex_lock(&ccci_sys_cb_lock);
+	if (id >= 0x1000 && id - 0x1000 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_1000[md_id][id - 0x1000];
+	else if (id >= 0x100 && id - 0x100 < CCCI_MAX_KERN_API)
+		slot = &ccci_sys_cb_100[md_id][id - 0x100];
+	else
+		ret = -EINVAL;
+
+	if (!ret) {
+		if (slot->func) {
+			pr_err("ccci: sys callback 0x%x already registered\n", id);
+			ret = -EBUSY;
+		} else {
+			slot->id = id;
+			slot->func = func;
+		}
+	}
+	mutex_unlock(&ccci_sys_cb_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(register_ccci_sys_call_back);
+
+/* ------------------------------------------------------------------ */
+/* boot count (throttling feature, ROM ccci_get_md_boot_count)         */
+/* ------------------------------------------------------------------ */
+unsigned long ccci_get_md_boot_count(int md_id)
+{
+	struct ccci_md *md;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return 0;
+	md = ccci_md_get(md_id);
+	return md ? md->boot_count : 0;
+}
+EXPORT_SYMBOL_GPL(ccci_get_md_boot_count);
+
+/* ------------------------------------------------------------------ */
+/* kernel service API (ROM exec_ccci_kern_func_by_md_id)               */
+/* ------------------------------------------------------------------ */
+int exec_ccci_kern_func_by_md_id(int md_id, unsigned int id, char *buf,
+				 unsigned int len)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	int val = 0;
+	int ret = 0;
+
+	if (!md)
+		return -ENODEV;
+
+	if (buf && len >= sizeof(int))
+		memcpy(&val, buf, sizeof(int));
+
+	switch (id) {
+	case ID_GET_MD_WAKEUP_SRC:
+		/* SPM asks who woke the AP; the CCIF Rx path marks it */
+		md->wakeup_src = 1;
+		break;
+	case ID_GET_MD_STATE:
+		ret = md->boot_stage;
+		break;
+	case ID_RESET_MD:
+		ret = ccci_md_reset(md);
+		if (!ret)
+			ret = ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						       CCCI_MD_MSG_RESET, 0);
+		break;
+	case ID_PAUSE_LTE:
+		/* DVFS: >0 means "modem not available", 0 delivered */
+		if (md->state != CCCI_MD_READY) {
+			ret = 1;
+			break;
+		}
+		ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX, MD_PAUSE_LTE,
+					  val, true);
+		if (ret == -CCCI_ERR_MD_NOT_READY ||
+		    ret == -CCCI_ERR_HIF_NOT_POWER_ON)
+			ret = 1;
+		break;
+	case ID_GET_TXPOWER:
+		if (!buf)
+			return -EINVAL;
+		if (val == 0)
+			ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX,
+						  MD_TX_POWER, 0, false);
+		else if (val == 1)
+			ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX,
+						  MD_RF_TEMPERATURE, 0, false);
+		else if (val == 2)
+			ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX,
+						  MD_RF_TEMPERATURE_3G, 0,
+						  false);
+		else
+			ret = -EINVAL;
+		break;
+	case ID_STORE_SIM_SWITCH_MODE:
+		/* no SIM switch driver in this tree: keep the value locally */
+		md->sim_switch_mode = val;
+		break;
+	case ID_GET_SIM_SWITCH_MODE:
+		if (!buf)
+			return -EINVAL;
+		memcpy(buf, &md->sim_switch_mode, sizeof(int));
+		break;
+	case ID_THROTTLING_CFG:
+		/* no MD throughput throttling client in this tree */
+		ret = -EOPNOTSUPP;
+		break;
+	case ID_DUMP_MD_SLEEP_MODE:
+		if (md->smem_vir) {
+			ccci_md_info(md, "MD sleep debug at smem+0x%x\n",
+				     CCCI_SMEM_SIZE_EXCEPTION -
+				     CCCI_SMEM_SLEEP_MODE_DBG_SIZE);
+		}
+		break;
+	case ID_DUMP_MD_REG:
+		ccci_ccif_dump_regs(md, NULL);
+		break;
+	case ID_UPDATE_MD_BOOT_MODE:
+		if (val > 0 && val < 3)
+			md->md_boot_mode = val;
+		else
+			ret = -EINVAL;
+		break;
+	case MD_THERMAL_LOW_POWER:
+	case MD_THROTTLING:
+		ret = ccci_send_msg_to_md(md, CCCI_SYSTEM_TX, id, val, false);
+		break;
+	default:
+		ret = -EOPNOTSUPP;
+		break;
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(exec_ccci_kern_func_by_md_id);
+
+/* ------------------------------------------------------------------ */
+/* message handlers                                                    */
+/* ------------------------------------------------------------------ */
+static void ccci_kernel_drop(struct ccci_md *md, const char *what,
+			     struct sk_buff *skb)
+{
+	ccci_md_dbg(md, "%s: unsupported request, dropped (%u bytes)\n", what,
+		    skb->len);
+	dev_kfree_skb_any(skb);
+}
+
+static void ccci_control_msg_handler(struct ccci_port *port,
+				     struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h = (struct ccci_header *)skb->data;
+	u32 msg = ccci_h->data[1];
+	u32 check = ccci_h->reserved;
+
+	ccci_md_dbg(md, "control msg 0x%x/0x%x\n", msg, check);
+
+	if (msg == MD_INIT_START_BOOT && check == MD_INIT_CHK_ID &&
+	    md->boot_stage == CCCI_BOOT_STAGE_0) {
+		ccci_boot_disarm_timer(md);
+		md->boot_stage = CCCI_BOOT_STAGE_1;
+		if (skb->len == CCCI_HEADER_SIZE + sizeof(struct md_query_ap_feature)) {
+			if (ccci_boot_prepare_runtime_data(md, skb))
+				ccci_md_err(md, "runtime data prep failed\n");
+		} else if (skb->len == CCCI_HEADER_SIZE) {
+			ccci_md_info(md, "legacy handshake message\n");
+		} else {
+			ccci_md_err(md, "invalid MD_QUERY_MSG length %u\n",
+				    skb->len);
+		}
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_BOOT_UP, 0);
+	} else if (msg == MD_NORMAL_BOOT && md->boot_stage == CCCI_BOOT_STAGE_1) {
+		ccci_boot_disarm_timer(md);
+		md->boot_stage = CCCI_BOOT_STAGE_2;
+		ccci_md_set_state(md, CCCI_MD_READY);
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_BOOT_READY, 0);
+	} else if (msg == MD_EX) {
+		if (check != MD_EX_CHK_ID) {
+			ccci_md_err(md, "invalid MD_EX check id 0x%x\n", check);
+		} else {
+			ccci_boot_disarm_timer(md);
+			md->ex_stage = CCCI_EX_INIT;
+			ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+			ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+						 CCCI_MD_MSG_EXCEPTION, 0);
+			/* downstream disables the MD watchdog on exception
+			 * entry (port_kernel.c:562 ee_callback)
+			 */
+			ccif_wdt_irq(md, false);
+			ccci_send_msg_to_md(md, CCCI_CONTROL_TX, MD_EX,
+					    MD_EX_CHK_ID, true);
+		}
+	} else if (msg == MD_EX_REC_OK) {
+		if (check != MD_EX_REC_OK_CHK_ID ||
+		    skb->len < CCCI_HEADER_SIZE + 4) {
+			ccci_md_err(md, "invalid MD_EX_REC_OK resv 0x%x len %u\n",
+				    check, skb->len);
+		} else {
+			/* exception log: first byte is EX_HEADER_T.ex_type */
+			md->ex_type = skb->data[CCCI_HEADER_SIZE];
+			md->ex_stage = CCCI_EX_DHL_DL_RDY;
+			ccci_md_err(md, "MD exception type %u, rec ok (%u bytes)\n",
+				    md->ex_type, skb->len);
+			ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+		}
+	} else if (msg == MD_EX_PASS) {
+		md->ex_stage = CCCI_EX_INIT_DONE;
+		ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+	} else if (msg == MD_INIT_START_BOOT && check == MD_INIT_CHK_ID) {
+		/* second boot attempt: userspace has to restart the modem */
+		md->boot_stage = CCCI_BOOT_STAGE_0;
+		ccci_md_err(md, "MD second boot detected\n");
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_RESET, 0);
+	} else if (msg == MD_EX_RESUME) {
+		md->ex_type = 0;	/* MD_EX_TYPE_EMI_CHECK is 0 in ROM */
+		ccci_md_err(md, "MD EMI check resume\n");
+		ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+	} else if (msg == CCCI_DRV_VER_ERROR) {
+		ccci_md_err(md, "AP/MD CCCI version mismatch\n");
+	} else if (msg == C2K_HB_MSG && md->id == CCCI_MD_SYS3) {
+		md->heartbeat++;
+	} else if ((msg == C2K_STATUS_IND_MSG ||
+		    msg == C2K_STATUS_QUERY_MSG) && md->id == CCCI_MD_SYS3) {
+		/* struct c2k_ctrl_port_msg option byte lives in reserved[3] */
+		md->dtr_state = !!(ccci_h->reserved & 0x80000000);
+	} else {
+		ccci_md_err(md, "unknown control message 0x%x\n", msg);
+	}
+	dev_kfree_skb_any(skb);
+}
+
+static void ccci_system_msg_handler(struct ccci_port *port,
+				    struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h = (struct ccci_header *)skb->data;
+
+	switch (ccci_h->data[1]) {
+	case MD_GET_BATTERY_INFO:
+		ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH,
+					 CCCI_MD_MSG_SEND_BATTERY_INFO, 0);
+		break;
+	case MD_WDT_MONITOR:
+		/* heartbeat, the WDT IRQ is the real watchdog */
+		md->heartbeat++;
+		break;
+	case MD_SIM_TYPE:
+		md->sim_type = ccci_h->reserved;
+		break;
+	case MD_TX_POWER:
+	case MD_RF_TEMPERATURE:
+	case MD_RF_TEMPERATURE_3G:
+	case MD_THROTTLING:
+	case MD_THERMAL_LOW_POWER:
+		ccci_exec_sys_cb(md, ccci_h->data[1], ccci_h->reserved);
+		break;
+	default:
+		ccci_md_dbg(md, "unhandled system message 0x%x\n",
+			    ccci_h->data[1]);
+		break;
+	}
+	dev_kfree_skb_any(skb);
+}
+
+static void ccci_status_msg_handler(struct ccci_port *port,
+				    struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+
+	md->heartbeat++;
+	ccci_md_dbg(md, "status message 0x%x\n",
+		    ((struct ccci_header *)skb->data)->data[1]);
+	dev_kfree_skb_any(skb);
+}
+
+/* ------------------------------------------------------------------ */
+/* kernel port thread                                                  */
+/* ------------------------------------------------------------------ */
+static int ccci_kernel_port_thread(void *arg)
+{
+	struct ccci_port *port = arg;
+	struct ccci_md *md = port->md;
+	struct sk_buff *skb;
+	unsigned long flags;
+
+	while (!kthread_should_stop()) {
+		wait_event_interruptible(port->rx_wq,
+					 !skb_queue_empty(&port->rx_q) ||
+					 kthread_should_stop());
+		if (kthread_should_stop())
+			break;
+
+		spin_lock_irqsave(&port->rx_lock, flags);
+		skb = __skb_dequeue(&port->rx_q);
+		if (skb && port->rx_len)
+			port->rx_len--;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		if (!skb)
+			continue;
+
+		switch (((struct ccci_header *)skb->data)->channel) {
+		case CCCI_CONTROL_RX:
+			ccci_control_msg_handler(port, skb);
+			break;
+		case CCCI_SYSTEM_RX:
+			ccci_system_msg_handler(port, skb);
+			break;
+		case CCCI_STATUS_RX:
+			ccci_status_msg_handler(port, skb);
+			break;
+		case CCCI_RPC_RX:
+			/* ROM implements RPC handlers on top of MTK GPIO/ADC/
+			 * EINT APIs that do not exist in this tree
+			 */
+			ccci_kernel_drop(md, "kernel RPC", skb);
+			break;
+		default:
+			ccci_kernel_drop(md, "kernel port", skb);
+			break;
+		}
+		ccci_port_ask_more(port);
+	}
+	return 0;
+}
+
+static int ccci_kernel_port_init(struct ccci_port *port)
+{
+	struct task_struct *task;
+
+	port->rx_len_th = CCCI_PORT_RX_LEN_TH;
+	task = kthread_run(ccci_kernel_port_thread, port, "%s", port->name);
+	if (IS_ERR(task)) {
+		ccci_md_err(port->md, "cannot start thread for %s\n",
+			    port->name);
+		return PTR_ERR(task);
+	}
+	port->priv = task;
+	return 0;
+}
+
+static int ccci_kernel_port_recv_skb(struct ccci_port *port,
+				     struct sk_buff *skb)
+{
+	return ccci_port_recv_skb(port, skb);
+}
+
+const struct ccci_port_ops ccci_kernel_port_ops = {
+	.init = ccci_kernel_port_init,
+	.recv_skb = ccci_kernel_port_recv_skb,
+};
+
+void ccci_port_kernel_exit(struct ccci_md *md)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops != &ccci_kernel_port_ops || !port->priv)
+			continue;
+		wake_up_interruptible(&port->rx_wq);
+		kthread_stop(port->priv);
+		port->priv = NULL;
+		skb_queue_purge(&port->rx_q);
+	}
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_port_net.c b/drivers/misc/mediatek/ccci/ccci_port_net.c
new file mode 100644
index 000000000..71baab01d
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_port_net.c
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI network ports: bind the logical CCMNI channels to the CCMNI netdev
+ * driver through struct ccmni_ccci_ops.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/port_net.c.  Original copyright
+ * (C) 2015 MediaTek Inc., GPL-2.0.
+ */
+#include <linux/ccci.h>
+#include <linux/etherdevice.h>
+#include <linux/if_ether.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_CCMNI_IDX(port)	(((port)->minor & 0xF) - 1)
+
+/* downstream ccmni.h:121-124 */
+#define CCMNI_ERR_TX_OK		0
+#define CCMNI_ERR_TX_BUSY	(-1)
+#define CCMNI_ERR_MD_NO_READY	(-2)
+#define CCMNI_ERR_TX_INVAL	(-3)
+
+#define CCMNI_NAME_MD1		"ccmni"
+#define CCMNI_NAME_MD3		"cc3mni"
+
+/* ------------------------------------------------------------------ */
+/* channel mapping                                                     */
+/* ------------------------------------------------------------------ */
+static void ccci_ccmni_default_channel(int md_id, int idx,
+				       struct ccmni_ch *channel)
+{
+	/* downstream port_net.c:56 ccmni_get_default_channel() */
+	switch (idx) {
+	case 0:
+		channel->rx = CCCI_CCMNI1_RX;
+		channel->tx = CCCI_CCMNI1_TX;
+		channel->dl_ack = CCCI_CCMNI1_DL_ACK;
+		break;
+	case 1:
+		channel->rx = CCCI_CCMNI2_RX;
+		channel->tx = CCCI_CCMNI2_TX;
+		channel->dl_ack = CCCI_CCMNI2_DL_ACK;
+		break;
+	case 2:
+		channel->rx = CCCI_CCMNI3_RX;
+		channel->tx = CCCI_CCMNI3_TX;
+		channel->dl_ack = CCCI_CCMNI3_DL_ACK;
+		break;
+	case 3:
+		channel->rx = CCCI_CCMNI4_RX;
+		channel->tx = CCCI_CCMNI4_TX;
+		channel->dl_ack = CCCI_CCMNI4_DLACK_RX;
+		break;
+	case 4:
+		channel->rx = CCCI_CCMNI5_RX;
+		channel->tx = CCCI_CCMNI5_TX;
+		channel->dl_ack = CCCI_CCMNI5_DLACK_RX;
+		break;
+	case 5:
+		channel->rx = CCCI_CCMNI6_RX;
+		channel->tx = CCCI_CCMNI6_TX;
+		channel->dl_ack = CCCI_CCMNI6_DLACK_RX;
+		break;
+	case 6:
+		channel->rx = CCCI_CCMNI7_RX;
+		channel->tx = CCCI_CCMNI7_TX;
+		channel->dl_ack = CCCI_CCMNI7_DLACK_RX;
+		break;
+	case 7:
+		channel->rx = CCCI_CCMNI8_RX;
+		channel->tx = CCCI_CCMNI8_TX;
+		channel->dl_ack = CCCI_CCMNI8_DLACK_RX;
+		break;
+	default:
+		pr_err("ccci: invalid ccmni index %d for md%d\n", idx,
+		       md_id + 1);
+		channel->rx = CCCI_MAX_CH_NUM;
+		channel->tx = CCCI_MAX_CH_NUM;
+		channel->dl_ack = CCCI_MAX_CH_NUM;
+	}
+
+	channel->rx_ack = 0xFF;
+	channel->tx_ack = 0xFF;
+	channel->multiq = 0;
+}
+
+static int ccci_ccmni_dl_ack(int idx)
+{
+	static const int dl_ack[8] = {
+		CCCI_CCMNI1_DL_ACK, CCCI_CCMNI2_DL_ACK, CCCI_CCMNI3_DL_ACK,
+		CCCI_CCMNI4_DLACK_RX, CCCI_CCMNI5_DLACK_RX,
+		CCCI_CCMNI6_DLACK_RX, CCCI_CCMNI7_DLACK_RX,
+		CCCI_CCMNI8_DLACK_RX,
+	};
+
+	return idx >= 0 && idx < 8 ? dl_ack[idx] : CCCI_MAX_CH_NUM;
+}
+
+int ccci_get_ccmni_channel(int md_id, int ccmni_idx,
+			   struct ccmni_ch *channel)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	struct ccci_port *port;
+
+	if (!channel)
+		return -EINVAL;
+
+	if (!md) {
+		ccci_ccmni_default_channel(md_id, ccmni_idx, channel);
+		return 0;
+	}
+
+	/* the ccmni ports carry different minors (0xF1..0xF8) than their index */
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops != &ccci_net_port_ops)
+			continue;
+		if (port->minor != (0xF0 | (ccmni_idx + 1)))
+			continue;
+		channel->rx = port->rx_ch;
+		channel->rx_ack = 0xFF;
+		channel->tx = port->tx_ch;
+		channel->tx_ack = 0xFF;
+		channel->dl_ack = ccci_ccmni_dl_ack(ccmni_idx);
+		channel->multiq = md_id == CCCI_MD_SYS1 ? 1 : 0;
+		return 0;
+	}
+
+	ccci_ccmni_default_channel(md_id, ccmni_idx, channel);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ccci_get_ccmni_channel);
+
+/* ------------------------------------------------------------------ */
+/* Tx                                                                  */
+/* ------------------------------------------------------------------ */
+static bool ccci_net_ack_channel(unsigned int tx_ch, unsigned int *port_ch)
+{
+	switch (tx_ch) {
+	case CCCI_CCMNI1_DL_ACK:
+		*port_ch = CCCI_CCMNI1_TX;
+		return true;
+	case CCCI_CCMNI2_DL_ACK:
+		*port_ch = CCCI_CCMNI2_TX;
+		return true;
+	case CCCI_CCMNI3_DL_ACK:
+		*port_ch = CCCI_CCMNI3_TX;
+		return true;
+	case CCCI_CCMNI4_DLACK_RX:
+		*port_ch = CCCI_CCMNI4_TX;
+		return true;
+	case CCCI_CCMNI5_DLACK_RX:
+		*port_ch = CCCI_CCMNI5_TX;
+		return true;
+	case CCCI_CCMNI6_DLACK_RX:
+		*port_ch = CCCI_CCMNI6_TX;
+		return true;
+	case CCCI_CCMNI7_DLACK_RX:
+		*port_ch = CCCI_CCMNI7_TX;
+		return true;
+	case CCCI_CCMNI8_DLACK_RX:
+		*port_ch = CCCI_CCMNI8_TX;
+		return true;
+	default:
+		*port_ch = tx_ch;
+		return false;
+	}
+}
+
+/*
+ * ccmni_send_pkt - CCMNI -> modem packet path
+ *
+ * The skb arrives with the L3 payload at skb->data and at least
+ * sizeof(struct ccci_header) of headroom; the CCCI header is pushed here.
+ * On success (0) the skb is consumed.  On -CCMNI_ERR_TX_BUSY the header is
+ * pulled again so CCMNI can retry with the same skb.
+ */
+static int ccci_ccmni_send_pkt(int md_id, int tx_ch, void *data)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	struct ccci_port *port;
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb = data;
+	unsigned int port_ch, qno;
+	bool is_ack;
+	int ret;
+
+	if (!md || !skb)
+		return CCMNI_ERR_TX_INVAL;
+	if (md->state != CCCI_MD_READY)
+		return CCMNI_ERR_MD_NO_READY;
+
+	is_ack = ccci_net_ack_channel(tx_ch, &port_ch);
+	port = ccci_md_get_port_by_channel(md, port_ch);
+	if (!port)
+		return CCMNI_ERR_TX_INVAL;
+
+	if (skb_headroom(skb) < CCCI_HEADER_SIZE)
+		return CCMNI_ERR_TX_INVAL;
+
+	/* downstream NET_ACK_TXQ_INDEX(): ack packets share the lower nibble
+	 * of the exception queue index
+	 */
+	if (is_ack)
+		qno = port->txq_exp == 0xFF ? port->txq :
+		      (port->txq_exp & 0x0F);
+	else
+		qno = ccci_port_txq(port);
+	if (qno >= CCCI_MAX_QUEUES)
+		return CCMNI_ERR_TX_INVAL;
+
+	ccci_h = (struct ccci_header *)skb_push(skb, CCCI_HEADER_SIZE);
+	memset(ccci_h, 0, CCCI_HEADER_SIZE);
+	ccci_h->data[0] = 0;
+	ccci_h->data[1] = skb->len;
+	ccci_h->channel = tx_ch;
+	ccci_h->reserved = 0;
+
+	port->tx_pkts++;
+	ret = ccci_md_send_skb(md, qno, skb);
+	if (ret == 0)
+		return CCMNI_ERR_TX_OK;
+
+	skb_pull(skb, CCCI_HEADER_SIZE);
+	if (ret == -EBUSY) {
+		port->tx_busy_cnt++;
+		return CCMNI_ERR_TX_BUSY;
+	}
+	return CCMNI_ERR_TX_INVAL;
+}
+
+/*
+ * Downstream ccmni_napi_poll() returns 0: the ECCCI/CCMNI split delivers Rx
+ * straight through ccmni_rx_callback(), the CCMNI napi is not the Rx path.
+ */
+static int ccci_ccmni_napi_poll(int md_id, int rx_ch, struct napi_struct *napi,
+				int weight)
+{
+	return 0;
+}
+
+static int ccci_net_port_init(struct ccci_port *port);
+
+/* ------------------------------------------------------------------ */
+/* Rx                                                                  */
+/* ------------------------------------------------------------------ */
+static int ccci_net_recv_skb(struct ccci_port *port, struct sk_buff *skb)
+{
+	struct ccci_md *md = port->md;
+	struct ccci_header *ccci_h = (struct ccci_header *)skb->data;
+	int idx = CCCI_CCMNI_IDX(port);
+
+	ccci_md_dbg(md, "rx net ch%u len%u idx%d\n", ccci_h->channel, skb->len,
+		    idx);
+
+	if (idx < 0 || idx >= 8) {
+		ccci_md_err(md, "bad ccmni index for port %s (minor 0x%x)\n",
+			    port->name, port->minor);
+		dev_kfree_skb_any(skb);
+		return -CCCI_ERR_DROP_PACKET;
+	}
+
+	/* CCMNI expects the L3 payload at skb->data; the 16 byte ccci header
+	 * leaves exactly the headroom it needs for the Ethernet header.
+	 */
+	skb_pull(skb, CCCI_HEADER_SIZE);
+	port->rx_pkts++;
+
+	/* consumes the skb in every path */
+	ccmni_rx_callback(md->id, idx, skb);
+	return 0;
+}
+
+static void ccci_net_md_state_notice(struct ccci_port *port, int event)
+{
+	struct ccci_md *md = port->md;
+	int idx = CCCI_CCMNI_IDX(port);
+
+	switch (event) {
+	case CCCI_MD_READY:
+	case CCCI_MD_EXCEPTION:
+	case CCCI_MD_STOPPED:
+		if (idx >= 0 && idx < 8)
+			ccmni_md_state_callback(md->id, idx, event);
+		break;
+	case CCCI_EV_TX_FULL:
+		port->rx_full = true;
+		break;
+	case CCCI_EV_TX_IRQ:
+		port->rx_full = false;
+		break;
+	default:
+		break;
+	}
+}
+
+const struct ccci_port_ops ccci_net_port_ops = {
+	.init = ccci_net_port_init,
+	.recv_skb = ccci_net_recv_skb,
+	.md_state_notice = ccci_net_md_state_notice,
+};
+
+/* ------------------------------------------------------------------ */
+/* per modem binding                                                   */
+/* ------------------------------------------------------------------ */
+int ccci_port_net_init(struct ccci_md *md)
+{
+	struct ccmni_ccci_ops *ops;
+	bool has_net = false;
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops == &ccci_net_port_ops) {
+			has_net = true;
+			break;
+		}
+	}
+	if (!has_net)
+		return 0;
+	if (md->ccmni_inited)
+		return 0;
+
+	ops = kzalloc(sizeof(*ops), GFP_KERNEL);
+	if (!ops)
+		return -ENOMEM;
+
+	ops->ccmni_ver = CCMNI_DRV_V0;
+	ops->ccmni_num = md->id == CCCI_MD_SYS1 ? 8 : 3;
+	strscpy(ops->name, md->id == CCCI_MD_SYS1 ? CCMNI_NAME_MD1 :
+		CCMNI_NAME_MD3, sizeof(ops->name));
+	ops->md_ability = md->capability | CCCI_MD_CAP_DATA_ACK_DVD;
+	ops->irat_md_id = md->irat_md_id;
+	ops->napi_poll_weigh = NAPI_POLL_WEIGHT;
+	ops->send_pkt = ccci_ccmni_send_pkt;
+	ops->napi_poll = ccci_ccmni_napi_poll;
+	ops->get_ccmni_ch = ccci_get_ccmni_channel;
+
+	md->ccmni_ops = ops;
+	if (ccmni_init(md->id, ops)) {
+		ccci_md_err(md, "ccmni_init failed\n");
+		md->ccmni_ops = NULL;
+		kfree(ops);
+		return -EINVAL;
+	}
+	md->ccmni_inited = true;
+	ccci_md_info(md, "%s bound (%u devices, ability 0x%x)\n", ops->name,
+		     ops->ccmni_num, ops->md_ability);
+	return 0;
+}
+
+void ccci_port_net_exit(struct ccci_md *md)
+{
+	if (!md->ccmni_inited)
+		return;
+	ccmni_exit(md->id);
+	md->ccmni_inited = false;
+	kfree(md->ccmni_ops);
+	md->ccmni_ops = NULL;
+}
+
+/* used by the net port init hook in the port table walk */
+static int ccci_net_port_init(struct ccci_port *port)
+{
+	return ccci_port_net_init(port->md);
+}
