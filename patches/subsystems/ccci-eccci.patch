diff --git a/drivers/misc/mediatek/ccci/ccci_boot.c b/drivers/misc/mediatek/ccci/ccci_boot.c
new file mode 100644
index 000000000..a73a4b0a1
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_boot.c
@@ -0,0 +1,918 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI modem boot: firmware validation/load into modem memory, boot vector
+ * programming, runtime-data handshake and the boot watchdog.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/ccci_util/ccci_util_lib_load_img.c (header parsing,
+ *       copy into the modem image region)
+ *   drivers/misc/mediatek/ccci/modem_cldma.c (md_cd_power_on/let_md_go,
+ *       md_cd_send_runtime_data_v2)
+ *   drivers/misc/mediatek/ccci/modem_ccif.c (md_ccif_send_runtime_data,
+ *       SRAM runtime block)
+ *   drivers/misc/mediatek/ccci/port_kernel.c (prepare_runtime_data)
+ *   drivers/misc/mediatek/eccci/mt6735/cldma_platform.c (clock + WDT setup)
+ *   drivers/misc/mediatek/eccci/mt6735/modem_reg_base.h (boot vector values)
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ */
+#include <linux/ccci.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/pm_runtime.h>
+#include <linux/minmax.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/timer.h>
+#include <linux/time.h>
+#include <linux/timekeeping.h>
+#include <linux/unaligned.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_BOOT_TIMEOUT_CLDMA_S 20	/* modem_cldma.c:119 */
+#define CCCI_BOOT_TIMEOUT_CCIF_S  10	/* modem_ccif.c:44  */
+#define CCCI_IMG_COPY_CHUNK	  (1024 * 1024)
+#define CCCI_IMG_MAX_HEADER	  1024
+#define CCCI_IMAGE_ALIGN	  0x4000
+
+#define MD1_LOGGER_FILE_PATH	"/data/mdlog/mdlog1_config"
+#define MD2_LOGGER_FILE_PATH	"/data/mdlog/mdlog2_config"
+
+/* check header versions, downstream ccci_util_lib_main.h */
+struct md_check_header_v3 {
+	u8 check_header[12];
+	u32 header_verno;
+	u32 product_ver;
+	u32 image_type;
+	u8 platform[16];
+	u8 build_time[64];
+	u8 build_ver[64];
+	u8 bind_sys_id;
+	u8 ext_attr;
+	u8 reserved[2];
+	u32 mem_size;
+	u32 md_img_size;
+	u32 rpc_sec_mem_addr;
+	u32 dsp_img_offset;
+	u32 dsp_img_size;
+	u8 reserved2[88];
+	u32 size;
+} __packed;
+
+struct md_check_header_v4 {
+	u8 check_header[12];
+	u32 header_verno;
+	u32 product_ver;
+	u32 image_type;
+	u8 platform[16];
+	u8 build_time[64];
+	u8 build_ver[64];
+	u8 bind_sys_id;
+	u8 ext_attr;
+	u8 reserved[2];
+	u32 mem_size;
+	u32 md_img_size;
+	u32 rpc_sec_mem_addr;
+	u32 dsp_img_offset;
+	u32 dsp_img_size;
+	u32 region_num;
+	u32 region_info[8][2];
+	u32 domain_attr[4];
+	u8 reserved2[4];
+	u32 size;
+} __packed;
+
+struct md_check_header_v5 {
+	u8 check_header[12];
+	u32 header_verno;
+	u32 product_ver;
+	u32 image_type;
+	u8 platform[16];
+	u8 build_time[64];
+	u8 build_ver[64];
+	u8 bind_sys_id;
+	u8 ext_attr;
+	u8 reserved[2];
+	u32 mem_size;
+	u32 md_img_size;
+	u32 rpc_sec_mem_addr;
+	u32 dsp_img_offset;
+	u32 dsp_img_size;
+	u32 region_num;
+	u32 region_info[8][2];
+	u32 domain_attr[4];
+	u32 arm7_img_offset;
+	u32 arm7_img_size;
+	u8 reserved_1[56];
+	u32 size;
+} __packed;
+
+/* v1/v2 header, downstream mt_ccci_common.h struct md_check_header */
+struct md_check_header_v2 {
+	u8 check_header[12];
+	u32 header_verno;
+	u32 product_ver;
+	u32 image_type;
+	u8 platform[16];
+	u8 build_time[64];
+	u8 build_ver[64];
+	u8 bind_sys_id;
+	u8 ext_attr;
+	u8 reserved[2];
+	u32 mem_size;
+	u32 md_img_size;
+	u32 reserved_info;
+	u32 size;
+} __packed;
+
+/* common leading part of every check header */
+struct md_check_header_common {
+	u8 check_header[12];
+	u32 header_verno;
+	u32 product_ver;
+	u32 image_type;
+	u8 platform[16];
+	u8 build_time[64];
+	u8 build_ver[64];
+	u8 bind_sys_id;
+	u8 ext_attr;
+	u8 reserved[2];
+	u32 mem_size;
+	u32 md_img_size;
+} __packed;
+
+/* ------------------------------------------------------------------ */
+/* helpers                                                             */
+/* ------------------------------------------------------------------ */
+static u32 ccci_boot_get_booting_start_id(struct ccci_md *md)
+{
+	struct file *filp;
+	char path[32];
+	loff_t pos = 0;
+	int mdlog_flag = 0;	/* MODE_IDLE */
+	ssize_t n;
+
+	snprintf(path, sizeof(path), "%s",
+		 md->id == CCCI_MD_SYS1 ? MD1_LOGGER_FILE_PATH :
+		 MD2_LOGGER_FILE_PATH);
+	filp = filp_open(path, O_RDONLY, 0);
+	if (!IS_ERR(filp)) {
+		n = kernel_read(filp, &mdlog_flag, sizeof(mdlog_flag), &pos);
+		if (n != sizeof(mdlog_flag))
+			mdlog_flag = 0;
+		filp_close(filp, NULL);
+	}
+
+	if (md->md_boot_mode == 2)	/* MD_BOOT_MODE_META */
+		return ((u8)mdlog_flag << 8) | CCCI_META_BOOT_ID;
+	return ((u8)mdlog_flag << 8) | CCCI_NORMAL_BOOT_ID;
+}
+
+static void ccci_boot_timeout(struct timer_list *t)
+{
+	struct ccci_boot *boot = timer_container_of(boot, t, timer);
+	struct ccci_md *md = boot->md;
+
+	boot->timer_armed = false;
+	ccci_md_err(md, "handshake%d timeout, boot failed\n",
+		    md->boot_stage + 1);
+	ccci_md_notify_ports(md, CCCI_EV_BOOT_FAIL);
+	/* downstream md_bootup_timeout_func() additionally hands a dump to
+	 * AEE (ccci_aed); there is no AEE client in this tree, so only the
+	 * kernel log dump of the image head is produced.
+	 */
+	if (md->img_vir) {
+		u32 vals[8], i;
+
+		for (i = 0; i < ARRAY_SIZE(vals); i++)
+			vals[i] = readl(md->img_vir + i * 4);
+		ccci_md_err(md, "md image %08x %08x %08x %08x %08x %08x %08x %08x\n",
+			    vals[0], vals[1], vals[2], vals[3], vals[4], vals[5],
+			    vals[6], vals[7]);
+	}
+}
+
+void ccci_boot_arm_timer(struct ccci_md *md)
+{
+	unsigned int sec = md->ring_mode ? CCCI_BOOT_TIMEOUT_CCIF_S :
+			   CCCI_BOOT_TIMEOUT_CLDMA_S;
+
+	mod_timer(&md->boot.timer, jiffies + sec * HZ);
+	md->boot.timer_armed = true;
+}
+
+void ccci_boot_disarm_timer(struct ccci_md *md)
+{
+	if (md->boot.timer_armed) {
+		timer_delete_sync(&md->boot.timer);
+		md->boot.timer_armed = false;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* shared memory                                                       */
+/* ------------------------------------------------------------------ */
+static int ccci_boot_region_get(struct device *dev, const char *prop,
+				unsigned int index, phys_addr_t *phys,
+				resource_size_t *size)
+{
+	struct device_node *np = dev->of_node;
+	struct device_node *rn;
+	struct resource res;
+	int ret;
+
+	rn = of_parse_phandle(np, prop, index);
+	if (!rn)
+		return -ENOENT;
+
+	ret = of_address_to_resource(rn, 0, &res);
+	of_node_put(rn);
+	if (ret)
+		return ret;
+
+	*phys = res.start;
+	*size = resource_size(&res);
+	return 0;
+}
+
+int ccci_boot_smem_setup(struct ccci_md *md, struct device *dev)
+{
+	struct device *dma_dev = md->dev->parent ? md->dev->parent : md->dev;
+	struct device_node *np = dev ? dev->of_node : NULL;
+	phys_addr_t img_phys = 0, smem_phys = 0;
+	resource_size_t img_size = 0, smem_size = 0;
+	u32 dt_smem_size = 0;
+	dma_addr_t dma_addr;
+	void *dma_virt;
+	int ret;
+
+	md->img_present = false;
+
+	/* image region: memory-region index 0 (reserved-memory, no-map) */
+	if (np) {
+		ret = ccci_boot_region_get(dev, "memory-region", 0, &img_phys,
+					   &img_size);
+		if (!ret) {
+			md->img_phy = img_phys;
+			md->img_size = img_size;
+			md->img_vir = ioremap(img_phys, img_size);
+			if (!md->img_vir) {
+				ccci_md_err(md,
+					    "cannot map md image region %pa+0x%zx\n",
+					    &img_phys, (size_t)img_size);
+				return -ENOMEM;
+			}
+			md->img_present = true;
+			ccci_md_info(md, "md image region %pa size 0x%zx\n",
+				     &md->img_phy, md->img_size);
+		} else {
+			ccci_md_warn(md,
+				     "no memory-region[0] (md image), boot will fail\n");
+		}
+	}
+
+	/* shared memory: memory-region index 1, then md_smem_size, then a
+	 * coherent allocation sized for the CCIF rings
+	 */
+	if (np) {
+		ret = ccci_boot_region_get(dev, "memory-region", 1, &smem_phys,
+					   &smem_size);
+		if (!ret) {
+			md->smem_phy = smem_phys;
+			md->smem_size = smem_size;
+			md->smem_vir = ioremap(smem_phys, smem_size);
+			if (!md->smem_vir) {
+				ccci_md_err(md, "cannot map smem %pa+0x%zx\n",
+					    &smem_phys, (size_t)smem_size);
+				return -ENOMEM;
+			}
+			md->smem_coherent = false;
+		}
+		if (!of_property_read_u32(np, "mediatek,md_smem_size",
+					  &dt_smem_size) && dt_smem_size &&
+		    !md->smem_vir)
+			smem_size = dt_smem_size;
+	}
+
+	if (!md->smem_vir) {
+		if (!smem_size) {
+			/* worst case: exception + runtime + all CCIF rings */
+			smem_size = CCCI_SMEM_SIZE_EXCEPTION +
+				    CCCI_SMEM_SIZE_RUNTIME +
+				    ccci_ccif_ring_total_size();
+			smem_size = max_t(size_t, smem_size, 0x30000);
+		}
+		smem_size = round_up(smem_size, PAGE_SIZE);
+		dma_virt = dma_alloc_coherent(dma_dev, smem_size, &dma_addr,
+					      GFP_KERNEL);
+		if (!dma_virt) {
+			ccci_md_err(md, "dma_alloc_coherent(0x%zx) failed\n",
+				    (size_t)smem_size);
+			return -ENOMEM;
+		}
+		md->smem_phy = dma_addr;
+		md->smem_size = smem_size;
+		md->smem_vir = (void __iomem *)dma_virt;
+		md->smem_coherent = true;
+		/* [INFERENCE] a coherent allocation is only usable if the modem
+		 * can address that physical range; provide a reserved-memory
+		 * region on real hardware.
+		 */
+		ccci_md_warn(md,
+			     "smem from dma_alloc_coherent %pa+0x%zx, modem visibility unverified\n",
+			     &md->smem_phy, md->smem_size);
+	}
+
+	memset_io(md->smem_vir, 0, md->smem_size);
+	/* let the util debugfs dump file read the modem shared memory */
+	ccci_util_dump_set_window(md->id, md->smem_phy, md->smem_size);
+	ccci_md_info(md, "smem %pa size 0x%zx%s\n", &md->smem_phy,
+		     md->smem_size, md->smem_coherent ? " (coherent)" : "");
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* firmware                                                            */
+/* ------------------------------------------------------------------ */
+static void ccci_boot_release_fw(struct ccci_md *md)
+{
+	if (md->boot.fw) {
+		release_firmware(md->boot.fw);
+		md->boot.fw = NULL;
+	}
+	md->boot.fw_valid = false;
+}
+
+static int ccci_boot_parse_header(struct ccci_md *md, const u8 *data, size_t size)
+{
+	struct ccci_boot *boot = &md->boot;
+	const struct md_check_header_common *h;
+	u32 hdr_size, parse_size;
+
+	if (size < sizeof(struct md_check_header_common) + 4) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "image too small (%zu)\n", size);
+		return -EINVAL;
+	}
+
+	/* the header size word is the last u32 of the image, downstream
+	 * check_md_header(): header_size = *(((u32 *)parse_addr) - 1)
+	 */
+	hdr_size = get_unaligned_le32(data + size - 4);
+	if (hdr_size > CCCI_IMG_MAX_HEADER || hdr_size > size)
+		hdr_size = sizeof(struct md_check_header_v2);
+
+	if (hdr_size == sizeof(struct md_check_header_v5))
+		parse_size = sizeof(struct md_check_header_v5);
+	else if (hdr_size == sizeof(struct md_check_header_v4))
+		parse_size = sizeof(struct md_check_header_v4);
+	else if (hdr_size == sizeof(struct md_check_header_v3))
+		parse_size = sizeof(struct md_check_header_v3);
+	else
+		parse_size = sizeof(struct md_check_header_v2);
+
+	h = (const struct md_check_header_common *)(data + size - parse_size);
+
+	if (memcmp(h->check_header, CCCI_MD_HEADER_MAGIC, 12)) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "bad magic, not a modem image\n");
+		return -EINVAL;
+	}
+
+	if (h->bind_sys_id != md->id + 1) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "image is for md sys%d, not md sys%u\n",
+			 h->bind_sys_id, md->id + 1);
+		return -EINVAL;
+	}
+
+	/* header_verno > 5 (v6) is not supported by this driver */
+	if (h->header_verno > 5) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "unsupported header version %u\n", h->header_verno);
+		return -EOPNOTSUPP;
+	}
+
+	boot->hdr_verno = h->header_verno;
+	boot->product_ver = h->product_ver;
+	boot->image_type = h->image_type;
+	boot->mem_size = h->mem_size;
+	boot->md_img_size = h->md_img_size;
+	boot->bind_sys_id = h->bind_sys_id;
+	memcpy(boot->md_platform, h->platform, 16);
+	boot->md_platform[16] = 0;
+	memcpy(boot->build_ver, h->build_ver, 64);
+	boot->build_ver[64] = 0;
+	memcpy(boot->build_time, h->build_time, 64);
+	boot->build_time[64] = 0;
+
+	if (boot->md_img_size && boot->md_img_size > size) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "md_img_size 0x%x > firmware size 0x%zx\n",
+			 boot->md_img_size, size);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int ccci_boot_load_firmware(struct ccci_md *md)
+{
+	struct ccci_boot *boot = &md->boot;
+	const u8 *src;
+	size_t total, copy_len, done = 0;
+	u32 chunk;
+	int ret;
+
+	if (boot->fw_valid)
+		return 0;
+
+	ccci_boot_release_fw(md);
+
+	if (!md->img_present || !md->img_vir) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "no modem image memory region in DT\n");
+		return -ENODEV;
+	}
+
+	ret = request_firmware(&boot->fw, md->fw_name, md->dev);
+	if (ret) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "Modem image '%s' not found (%d)\n", md->fw_name, ret);
+		boot->fw = NULL;
+		return -ENOENT;
+	}
+
+	total = boot->fw->size;
+	ret = ccci_boot_parse_header(md, boot->fw->data, total);
+	if (ret) {
+		ccci_md_err(md, "%s", boot->err_str);
+		ccci_boot_release_fw(md);
+		return ret;
+	}
+
+	copy_len = boot->md_img_size ? min_t(size_t, boot->md_img_size, total) :
+		   total;
+	if (copy_len > md->img_size) {
+		snprintf(boot->err_str, sizeof(boot->err_str),
+			 "image 0x%zx larger than md region 0x%zx\n", copy_len,
+			 md->img_size);
+		ccci_boot_release_fw(md);
+		return -ENOMEM;
+	}
+
+	src = boot->fw->data;
+	strscpy(boot->file_name, md->fw_name, sizeof(boot->file_name));
+	while (done < copy_len) {
+		chunk = min_t(size_t, CCCI_IMG_COPY_CHUNK, copy_len - done);
+
+		memcpy_toio(md->img_vir + done, src + done, chunk);
+		done += chunk;
+	}
+	/* make sure the image is in memory before the modem is released */
+	wmb();
+
+	/* the modem keeps its own copy in DRAM, do not pin the firmware */
+	release_firmware(boot->fw);
+	boot->fw = NULL;
+	boot->fw_valid = true;
+
+	snprintf(md->boot_info, sizeof(md->boot_info),
+		 "MD:%s*%s*%s*%s*%s\nAP:%s drv 0x%08x (MD)mem 0x%08x smem 0x%08x\n",
+		 md->boot.image_type == 1 ? "2G" :
+		 (md->boot.image_type == 2 ? "3G" : "INVALID"),
+		 md->boot.md_platform, md->boot.build_ver,
+		 md->boot.build_time,
+		 md->boot.product_ver == 1 ? "Debug" :
+		 (md->boot.product_ver == 2 ? "Release" : "INVALID"),
+		 AP_PLATFORM_INFO, CCCI_DRIVER_VER, boot->mem_size,
+		 (u32)md->smem_size);
+
+	ccci_md_info(md, "loaded %s: 0x%zx bytes, hdr v%u, md build %s\n",
+		     boot->file_name, done, boot->hdr_verno, boot->build_ver);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* power on / let go / power off                                       */
+/* ------------------------------------------------------------------ */
+int ccci_boot_power_on(struct ccci_md *md)
+{
+	int ret = 0;
+	struct ccci_ccif *ccif = md->ccif;
+
+	if (md->boot.clk) {
+		ret = clk_prepare_enable(md->boot.clk);
+		if (ret) {
+			ccci_md_err(md, "clk_prepare_enable failed %d\n", ret);
+			return ret;
+		}
+	}
+
+	if (md->dev->parent) {
+		ret = pm_runtime_resume_and_get(md->dev->parent);
+		if (ret) {
+			ccci_md_err(md, "pm_runtime_resume_and_get failed %d\n",
+				    ret);
+			if (md->boot.clk)
+				clk_disable_unprepare(md->boot.clk);
+			return ret;
+		}
+	}
+
+	/* downstream md_cd_power_on(): disable the MD watchdog before the
+	 * modem starts executing (WDT_MD_MODE_KEY)
+	 */
+	if (ccif && ccif->rgu_base)
+		writel(WDT_MD_MODE_KEY, ccif->rgu_base + WDT_MD_MODE);
+
+	ccci_md_info(md, "power on done\n");
+	return 0;
+}
+
+int ccci_boot_let_md_go(struct ccci_md *md)
+{
+	struct ccci_ccif *ccif = md->ccif;
+
+	if (!ccif || !ccif->boot_key || !ccif->boot_vector || !ccif->boot_en) {
+		ccci_md_err(md, "boot slave registers not mapped\n");
+		return -ENODEV;
+	}
+
+	/* downstream md_cd_let_md_go(): make the boot vector programmable,
+	 * program it, then let it take effect. Values from
+	 * mt6735/modem_reg_base.h MD2_BOOT_VECTOR_*_VALUE.
+	 */
+	writel(MD_BOOT_VECTOR_KEY_VALUE, ccif->boot_key);
+	writel(MD_BOOT_VECTOR_VALUE, ccif->boot_vector);
+	wmb();
+	writel(MD_BOOT_VECTOR_EN_VALUE, ccif->boot_en);
+
+	ccci_md_info(md, "boot vector programmed, modem released\n");
+	return 0;
+}
+
+void ccci_boot_power_off(struct ccci_md *md)
+{
+	/* downstream polls spm_is_md1_sleep() before power off; SPM API is not
+	 * available in this tree, so drop the clock/domain directly.
+	 */
+	if (md->dev->parent)
+		pm_runtime_put_sync(md->dev->parent);
+	if (md->boot.clk)
+		clk_disable_unprepare(md->boot.clk);
+	ccci_md_info(md, "power off done\n");
+}
+
+/* ------------------------------------------------------------------ */
+/* runtime data handshake                                              */
+/* ------------------------------------------------------------------ */
+struct ccci_rt_builder {
+	void __iomem *base;
+	size_t size;
+	size_t off;
+	bool overflow;
+};
+
+static void ccci_rt_append(struct ccci_rt_builder *b, u8 id, u8 mask, u8 ver,
+			   const void *data, u32 len)
+{
+	struct ccci_runtime_feature hdr = {
+		.feature_id = id,
+		.data_len = len,
+	};
+
+	hdr.support_info.support_mask = mask;
+	hdr.support_info.version = ver;
+
+	if (b->off + sizeof(hdr) + len > b->size) {
+		b->overflow = true;
+		return;
+	}
+	memcpy_toio(b->base + b->off, &hdr, sizeof(hdr));
+	b->off += sizeof(hdr);
+	if (len) {
+		memcpy_toio(b->base + b->off, data, len);
+		b->off += len;
+	}
+}
+
+static u8 ccci_ap_feature_mask(struct ccci_md *md, unsigned int id)
+{
+	switch (id) {
+	case CCCI_RT_BOOT_INFO:
+	case CCCI_RT_EXCEPTION_SHARE_MEMORY:
+	case CCCI_RT_MISC_INFO_HIF_DMA_REMAP:
+	case CCCI_RT_MISC_INFO_RANDOM_SEED_NUM:
+	case CCCI_RT_MISC_INFO_GPS_COCLOCK:
+	case CCCI_RT_MISC_INFO_SBP_ID:
+	case CCCI_RT_MISC_INFO_CCCI:
+	case CCCI_RT_MISC_INFO_CLIB_TIME:
+		return CCCI_FEATURE_MUST_SUPPORT;
+	case CCCI_RT_CCIF_SHARE_MEMORY:
+		return md->id == CCCI_MD_SYS1 ? CCCI_FEATURE_NOT_SUPPORT :
+		       CCCI_FEATURE_MUST_SUPPORT;
+	case CCCI_RT_DHL_SHARE_MEMORY:
+	case CCCI_RT_MD1MD3_SHARE_MEMORY:
+	case CCCI_RT_MISC_INFO_RTC_32K_LESS:
+	case CCCI_RT_MISC_INFO_C2K:
+	default:
+		/* features whose providers (DHL logging, MD1<->MD3 smem,
+		 * 32K-less crystal, C2K always-on) do not exist in this tree
+		 */
+		return CCCI_FEATURE_NOT_SUPPORT;
+	}
+}
+
+/**
+ * ccci_boot_prepare_runtime_data - answer the modem's feature query
+ *
+ * The modem sends struct md_query_ap_feature on the control channel during
+ * handshake 1; the AP publishes its answers into the runtime region of the
+ * shared memory (downstream prepare_runtime_data()).
+ */
+int ccci_boot_prepare_runtime_data(struct ccci_md *md, struct sk_buff *skb)
+{
+	const struct md_query_ap_feature *query;
+	struct ccci_rt_builder b;
+	struct ccci_runtime_share_memory shm;
+	struct ccci_misc_info_element el;
+	struct ccci_runtime_boot_info bi;
+	u32 seed = 0;
+	u8 i;
+
+	if (!md->smem_vir || md->smem_size <= CCCI_SMEM_SIZE_EXCEPTION) {
+		ccci_md_err(md, "no runtime smem region\n");
+		return -ENODEV;
+	}
+	if (skb->len < CCCI_HEADER_SIZE + sizeof(*query)) {
+		ccci_md_err(md, "md feature query too short (%u)\n", skb->len);
+		return -EINVAL;
+	}
+	query = (const struct md_query_ap_feature *)(skb->data +
+						     CCCI_HEADER_SIZE);
+	if (query->head_pattern != CCCI_MD_FEATURE_QUERY_PATTERN ||
+	    query->tail_pattern != CCCI_MD_FEATURE_QUERY_PATTERN) {
+		ccci_md_err(md, "bad feature query pattern %08x/%08x\n",
+			    query->head_pattern, query->tail_pattern);
+		return -EINVAL;
+	}
+
+	md->runtime_version = AP_MD_HS_V2;
+	b.base = md->smem_vir + CCCI_SMEM_SIZE_EXCEPTION;
+	b.size = CCCI_SMEM_SIZE_RUNTIME_AP;
+	b.off = 0;
+	b.overflow = false;
+
+	for (i = 0; i < CCCI_FEATURE_COUNT; i++) {
+		u8 md_mask = query->feature_set[i].support_mask;
+		u8 ap_mask = ccci_ap_feature_mask(md, i);
+		u8 ver = query->feature_set[i].version;
+
+		if (md_mask == CCCI_FEATURE_MUST_SUPPORT &&
+		    ap_mask < CCCI_FEATURE_MUST_SUPPORT) {
+			ccci_md_err(md, "md requires feature %u not supported\n",
+				    i);
+			return -EOPNOTSUPP;
+		}
+
+		if (md_mask == CCCI_FEATURE_NOT_EXIST ||
+		    md_mask == CCCI_FEATURE_MUST_SUPPORT) {
+			/* keep the modem's view */
+		} else if (md_mask == CCCI_FEATURE_OPTIONAL_SUPPORT) {
+			if (ap_mask >= CCCI_FEATURE_MUST_SUPPORT)
+				md_mask = CCCI_FEATURE_MUST_SUPPORT;
+			else
+				md_mask = CCCI_FEATURE_NOT_SUPPORT;
+			ver = query->feature_set[i].version;
+		} else {	/* CCCI_FEATURE_SUPPORT_BACKWARD_COMPAT */
+			u8 ap_ver = 0;	/* every AP feature is version 0 */
+
+			if (ver >= ap_ver)
+				md_mask = CCCI_FEATURE_MUST_SUPPORT;
+			else
+				md_mask = CCCI_FEATURE_NOT_SUPPORT;
+			ver = ap_ver;
+		}
+
+		if (md_mask != CCCI_FEATURE_MUST_SUPPORT) {
+			ccci_rt_append(&b, i, md_mask, ver, NULL, 0);
+			continue;
+		}
+
+		switch (i) {
+		case CCCI_RT_BOOT_INFO:
+			memset(&bi, 0, sizeof(bi));
+			bi.boot_channel = CCCI_CONTROL_RX;
+			bi.booting_start_id = ccci_boot_get_booting_start_id(md);
+			ccci_rt_append(&b, i, md_mask, ver, &bi, sizeof(bi));
+			break;
+		case CCCI_RT_EXCEPTION_SHARE_MEMORY:
+			shm.addr = (u32)md->smem_phy;
+			shm.size = CCCI_SMEM_SIZE_EXCEPTION;
+			ccci_rt_append(&b, i, md_mask, ver, &shm, sizeof(shm));
+			break;
+		case CCCI_RT_CCIF_SHARE_MEMORY:
+			shm.addr = (u32)(md->smem_phy +
+					 CCCI_SMEM_SIZE_EXCEPTION +
+					 CCCI_SMEM_SIZE_RUNTIME);
+			shm.size = md->ccif ? md->ccif->total_smem_size : 0;
+			ccci_rt_append(&b, i, md_mask, ver, &shm, sizeof(shm));
+			break;
+		case CCCI_RT_MISC_INFO_RANDOM_SEED_NUM:
+			memset(&el, 0, sizeof(el));
+			get_random_bytes(&seed, sizeof(seed));
+			el.feature[0] = seed;
+			ccci_rt_append(&b, i, md_mask, ver, &el, sizeof(el));
+			break;
+		case CCCI_RT_MISC_INFO_SBP_ID:
+			memset(&el, 0, sizeof(el));
+			el.feature[0] = md->sbp_code;
+			ccci_rt_append(&b, i, md_mask, ver, &el, sizeof(el));
+			break;
+		case CCCI_RT_MISC_INFO_CCCI:
+			memset(&el, 0, sizeof(el));
+			el.feature[0] |= BIT(0);	/* sequence check */
+			ccci_rt_append(&b, i, md_mask, ver, &el, sizeof(el));
+			break;
+		case CCCI_RT_MISC_INFO_CLIB_TIME:
+			memset(&el, 0, sizeof(el));
+			el.feature[0] = (u32)ktime_get_real_seconds();
+			el.feature[2] = sys_tz.tz_minuteswest;
+			el.feature[3] = sys_tz.tz_dsttime;
+			ccci_rt_append(&b, i, md_mask, ver, &el, sizeof(el));
+			break;
+		default:
+			memset(&el, 0, sizeof(el));
+			ccci_rt_append(&b, i, md_mask, ver, &el, sizeof(el));
+			break;
+		}
+	}
+
+	if (b.overflow) {
+		ccci_md_err(md, "runtime feature block exceeds 0x%x bytes\n",
+			    CCCI_SMEM_SIZE_RUNTIME_AP);
+		return -ENOSPC;
+	}
+	wmb();
+	ccci_md_info(md, "runtime data published, %zu bytes\n", b.off);
+	return 0;
+}
+
+/* legacy SRAM runtime block, downstream md_ccif_op_send_runtime_data() */
+static int ccci_boot_send_runtime_sram(struct ccci_md *md)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	struct modem_runtime rt;
+	struct ccci_header *ccci_h;
+	u32 packet_size = sizeof(struct ccci_header) + sizeof(rt);
+	u32 seed = 0;
+	u32 mask = 0;
+	u32 i;
+
+	if (!ccif || !ccif->sram)
+		return -ENODEV;
+	if (sizeof(rt) > sizeof(ccif->sram->runtime))
+		return -ENOSPC;
+
+	ccci_h = &ccif->sram->up_header;
+
+	writel(0x00, &ccci_h->data[0]);
+	writel(packet_size, &ccci_h->data[1]);
+	writel(MD_INIT_CHK_ID, &ccci_h->reserved);
+	writel(CCCI_CONTROL_TX, ((u32 __iomem *)ccci_h) + 2);
+
+	memset(&rt, 0, sizeof(rt));
+	rt.Prefix = 0x46494343;		/* "CCIF" */
+	rt.Postfix = 0x46494343;	/* "CCIF" */
+	memcpy(&rt.Platform_L, AP_PLATFORM_INFO,
+	       min_t(size_t, 8, strlen(AP_PLATFORM_INFO)));
+	rt.BootChannel = CCCI_CONTROL_RX;
+	rt.DriverVersion = CCCI_DRIVER_VER;
+	rt.BootingStartID = ccci_boot_get_booting_start_id(md);
+
+	rt.ExceShareMemBase = (u32)md->smem_phy;
+	rt.ExceShareMemSize = CCCI_SMEM_SIZE_EXCEPTION;
+	rt.CCIFShareMemBase = (u32)(md->smem_phy + CCCI_SMEM_SIZE_EXCEPTION +
+				    CCCI_SMEM_SIZE_RUNTIME);
+	rt.CCIFShareMemSize = ccif->total_smem_size;
+	rt.TotalShareMemBase = (u32)md->smem_phy;
+	rt.TotalShareMemSize = (u32)md->smem_size;
+
+	rt.misc_prefix = 0x4353494D;	/* "MISC" */
+	rt.misc_postfix = 0x4353494D;
+
+	mask |= CCCI_FEATURE_NOT_SUPPORT << (CCCI_RT_MISC_INFO_RTC_32K_LESS * 2);
+	mask |= CCCI_FEATURE_SUPPORT << (CCCI_RT_MISC_INFO_RANDOM_SEED_NUM * 2);
+	mask |= CCCI_FEATURE_SUPPORT << (CCCI_RT_MISC_INFO_SBP_ID * 2);
+	mask |= CCCI_FEATURE_SUPPORT << (CCCI_RT_MISC_INFO_CCCI * 2);
+	rt.support_mask = mask;
+
+	get_random_bytes(&seed, sizeof(seed));
+	rt.feature_val[CCCI_RT_MISC_INFO_RANDOM_SEED_NUM][0] = seed;
+	rt.feature_val[CCCI_RT_MISC_INFO_SBP_ID][0] = md->sbp_code;
+	rt.feature_val[CCCI_RT_MISC_INFO_CCCI][0] = BIT(0);
+
+	memcpy_toio(ccif->sram->runtime, &rt, sizeof(rt));
+	wmb();
+	(void)i;
+
+	return ccci_ccif_send(md, H2D_SRAM);
+}
+
+int ccci_boot_send_runtime_data(struct ccci_md *md, u32 sbp_code)
+{
+	struct ap_query_md_feature *ap;
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	u32 packet_size = sizeof(struct ccci_header) + sizeof(*ap);
+	unsigned int qno = 0;
+	int ret;
+
+	if (md->state != CCCI_MD_BOOTING && md->state != CCCI_MD_READY)
+		return -CCCI_ERR_MD_NOT_READY;
+
+	md->sbp_code = sbp_code ? sbp_code : md->sbp_code_default;
+
+	if (md->ring_mode)
+		return ccci_boot_send_runtime_sram(md);
+
+	skb = ccci_alloc_skb(packet_size, GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	ap = (struct ap_query_md_feature *)skb_put(skb, sizeof(*ap));
+	memset(ap, 0, sizeof(*ap));
+	ap->head_pattern = CCCI_AP_FEATURE_QUERY_PATTERN;
+	ap->tail_pattern = CCCI_AP_FEATURE_QUERY_PATTERN;
+	ap->share_memory_support = 1;
+	ap->ap_runtime_data_addr =
+		(u32)(md->smem_phy + CCCI_SMEM_SIZE_EXCEPTION);
+	ap->ap_runtime_data_size = CCCI_SMEM_SIZE_RUNTIME_AP;
+	ap->md_runtime_data_addr = ap->ap_runtime_data_addr +
+				   CCCI_SMEM_SIZE_RUNTIME_AP;
+	ap->md_runtime_data_size = CCCI_SMEM_SIZE_RUNTIME_MD;
+	ap->set_md_mpu_start_addr = (u32)md->smem_phy;
+	ap->set_md_mpu_total_size = (u32)md->smem_size;
+
+	ccci_h = (struct ccci_header *)skb_push(skb, CCCI_HEADER_SIZE);
+	memset(ccci_h, 0, CCCI_HEADER_SIZE);
+	ccci_h->data[0] = 0;
+	ccci_h->data[1] = packet_size;
+	ccci_h->channel = CCCI_CONTROL_TX;
+	ccci_h->reserved = MD_INIT_CHK_ID;
+
+	ret = ccci_md_send_skb(md, qno, skb);
+	if (ret)
+		dev_kfree_skb_any(skb);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* init / exit                                                         */
+/* ------------------------------------------------------------------ */
+int ccci_boot_init(struct ccci_md *md)
+{
+	struct ccci_boot *boot = &md->boot;
+
+	boot->md = md;
+	boot->fw = NULL;
+	boot->fw_valid = false;
+	boot->timer_armed = false;
+	snprintf(boot->post_fix, sizeof(boot->post_fix), "%u", md->id + 1);
+	timer_setup(&boot->timer, ccci_boot_timeout, 0);
+	return 0;
+}
+
+void ccci_boot_exit(struct ccci_md *md)
+{
+	struct ccci_boot *boot = &md->boot;
+
+	timer_delete_sync(&boot->timer);
+	ccci_boot_release_fw(md);
+	if (md->img_vir) {
+		iounmap(md->img_vir);
+		md->img_vir = NULL;
+	}
+	if (md->smem_vir) {
+		if (md->smem_coherent) {
+			struct device *dma_dev = md->dev &&
+						 md->dev->parent ?
+						 md->dev->parent : md->dev;
+
+			if (dma_dev)
+				dma_free_coherent(dma_dev, md->smem_size,
+						  (void *)md->smem_vir,
+						  md->smem_phy);
+		} else {
+			iounmap(md->smem_vir);
+		}
+		md->smem_vir = NULL;
+	}
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_ccif.c b/drivers/misc/mediatek/ccci/ccci_ccif.c
new file mode 100644
index 000000000..66fcf8d2a
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_ccif.c
@@ -0,0 +1,784 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI CCIF control transport.
+ *
+ * The CCIF block is the doorbell/exception path between AP and modem:
+ *   APCCIF_CON     arbitration enable
+ *   APCCIF_BUSY    bitmask of channels currently owned by AP
+ *   APCCIF_START   bitmask of channels granted to AP
+ *   APCCIF_TCHNUM  write channel id to raise an AP->MD interrupt
+ *   APCCIF_RCHNUM  channel ids raised by the MD
+ *   APCCIF_ACK     write back RCHNUM to acknowledge
+ *   APCCIF_CHDATA  512 byte shared SRAM window
+ *
+ * Two data paths are supported:
+ *   - CLDMA modems (MD1): data runs over the CLDMA engine, CCIF only carries
+ *     the exception handshake and the SRAM runtime block.
+ *   - CCIF-ring modems (MD3/C2K): eight framed rings in shared memory, each
+ *     with a doorbell channel H2D_RINGQ0+n / D2H_RINGQ0+n.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/{modem_ccif.c,modem_cldma.c,modem_ccif_c2k.c},
+ * mt6735/ccif_c2k_platform.h.  Original copyright (C) 2015 MediaTek Inc.,
+ * GPL-2.0.
+ */
+#include <linux/ccci.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irqreturn.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/seq_file.h>
+
+#include "ccci_priv.h"
+
+#define CCCI_CCIF_RING_MASK	(GENMASK(D2H_RINGQ0 + CCCI_MAX_QUEUES - 1, \
+					 D2H_RINGQ0))
+
+#define CCIF_IRQ_POLL_MS	20	/* downstream polling_ready(): 20ms */
+#define CCIF_IRQ_POLL_CNT	500	/* 500 * 20ms = 10s, MD timeout */
+
+/* queue sizes in bytes, downstream modem_ccif.c:104 and
+ * modem_ccif_c2k.c:146
+ */
+static const unsigned int ccif_rx_size_md1[CCCI_MAX_QUEUES] = {
+	32 * 1024, 100 * 1024, 100 * 1024, 100 * 1024,
+	16 * 1024, 16 * 1024, 16 * 1024, 16 * 1024,
+};
+static const unsigned int ccif_tx_size_md1[CCCI_MAX_QUEUES] = {
+	32 * 1024, 100 * 1024, 16 * 1024, 100 * 1024,
+	16 * 1024, 16 * 1024, 16 * 1024, 16 * 1024,
+};
+static const unsigned int ccif_rx_size_md3[CCCI_MAX_QUEUES] = {
+	10 * 1024, 100 * 1024, 100 * 1024, 150 * 1024,
+	50 * 1024, 10 * 1024, 10 * 1024, 10 * 1024,
+};
+static const unsigned int ccif_tx_size_md3[CCCI_MAX_QUEUES] = {
+	10 * 1024, 100 * 1024, 50 * 1024, 50 * 1024,
+	50 * 1024, 10 * 1024, 10 * 1024, 10 * 1024,
+};
+
+static const unsigned int *ccif_rx_sizes(struct ccci_md *md)
+{
+	return md->id == CCCI_MD_SYS1 ? ccif_rx_size_md1 : ccif_rx_size_md3;
+}
+
+static const unsigned int *ccif_tx_sizes(struct ccci_md *md)
+{
+	return md->id == CCCI_MD_SYS1 ? ccif_tx_size_md1 : ccif_tx_size_md3;
+}
+
+size_t ccci_ccif_ring_total_size(void)
+{
+	size_t md1 = 0, md3 = 0;
+	unsigned int i;
+
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		md1 += CCCI_RINGBUF_CTL_LEN + ccif_rx_size_md1[i] +
+		       ccif_tx_size_md1[i];
+		md3 += CCCI_RINGBUF_CTL_LEN + ccif_rx_size_md3[i] +
+		       ccif_tx_size_md3[i];
+	}
+	return max(md1, md3);
+}
+
+/* ------------------------------------------------------------------ */
+/* register access                                                     */
+/* ------------------------------------------------------------------ */
+static inline u32 ccif_rd(struct ccci_ccif *ccif, u32 reg)
+{
+	return readl(ccif->ap_base + reg);
+}
+
+static inline void ccif_wr(struct ccci_ccif *ccif, u32 reg, u32 val)
+{
+	writel(val, ccif->ap_base + reg);
+}
+
+void ccif_enable_irq(struct ccci_md *md)
+{
+	struct ccci_ccif *ccif = md->ccif;
+
+	if (!ccif || !ccif->started)
+		return;
+	if (ccif->irq_enabled)
+		return;
+	enable_irq(ccif->irq);
+	if (ccif->wdt_irq)
+		enable_irq(ccif->wdt_irq);
+	ccif->irq_enabled = true;
+}
+
+void ccif_wdt_irq(struct ccci_md *md, bool enable)
+{
+	struct ccci_ccif *ccif = md->ccif;
+
+	if (!ccif || !ccif->wdt_irq)
+		return;
+	if (enable)
+		enable_irq(ccif->wdt_irq);
+	else
+		disable_irq_nosync(ccif->wdt_irq);
+}
+
+void ccif_disable_irq(struct ccci_md *md)
+{
+	struct ccci_ccif *ccif = md->ccif;
+
+	if (!ccif || !ccif->irq_enabled)
+		return;
+	disable_irq_nosync(ccif->irq);
+	if (ccif->wdt_irq)
+		disable_irq(ccif->wdt_irq);
+	ccif->irq_enabled = false;
+}
+
+/**
+ * ccci_ccif_send - raise one CCIF channel towards the modem
+ *
+ * Downstream returns -1 immediately when the channel is busy; the modem needs
+ * the previous transfer to complete, so wait for the BUSY bit to clear with a
+ * bounded timeout instead.
+ */
+int ccci_ccif_send(struct ccci_md *md, unsigned int channel)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	unsigned int i;
+	u32 busy;
+
+	if (!ccif || !ccif->ap_base)
+		return -ENODEV;
+	if (channel >= CCCI_CCIF_CH_NUM)
+		return -EINVAL;
+
+	for (i = 0; i < CCCI_CCIF_SEND_RETRIES; i++) {
+		busy = ccif_rd(ccif, APCCIF_BUSY);
+		if (!(busy & BIT(channel)))
+			break;
+		/* udelay: this path also runs from the softirq/tasklet Rx */
+		udelay(10);
+	}
+	if (i == CCCI_CCIF_SEND_RETRIES) {
+		ccci_md_dbg(md, "ccif channel %u busy timeout\n", channel);
+		return -EBUSY;
+	}
+
+	ccif_wr(ccif, APCCIF_BUSY, BIT(channel));
+	ccif_wr(ccif, APCCIF_TCHNUM, channel);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* ring transport                                                      */
+/* ------------------------------------------------------------------ */
+static void ccci_ccif_rx_tasklet(struct tasklet_struct *t)
+{
+	struct ccci_ccif_queue *q = from_tasklet(q, t, rx_task);
+	struct ccci_md *md = q->md;
+	struct ccci_ringbuf *rb = q->rx_ring;
+	struct sk_buff *skb;
+	int len, ret, count = 0;
+
+	if (!rb)
+		return;
+
+	while (count++ < 32) {
+		len = ccci_ringbuf_readable(rb);
+		if (len < 0) {
+			if (len != -7)	/* -CCCI_RINGBUF_EMPTY */
+				ccci_md_err(md, "q%u ring read error %d\n",
+					    q->index, len);
+			return;
+		}
+
+		skb = ccci_alloc_skb(len + CCCI_HEADER_SIZE, GFP_ATOMIC);
+		if (!skb) {
+			ccci_md_err(md, "q%u rx alloc %d failed\n", q->index,
+				    len);
+			return;
+		}
+		if (ccci_ringbuf_read(rb, skb_put(skb, len), len) != len) {
+			dev_kfree_skb_any(skb);
+			return;
+		}
+
+		ret = ccci_rx_dispatch(md, skb);
+		if (ret == -CCCI_ERR_PORT_RX_FULL) {
+			/* keep the packet in shared memory and retry later */
+			dev_kfree_skb_any(skb);
+			queue_work(system_wq, &q->rx_retry_work);
+			return;
+		}
+		ccci_ringbuf_move_rpointer(rb, len);
+	}
+	/* more data may be waiting */
+	tasklet_schedule(&q->rx_task);
+}
+
+static void ccci_ccif_rx_retry_work(struct work_struct *work)
+{
+	struct ccci_ccif_queue *q = container_of(work, struct ccci_ccif_queue,
+						 rx_retry_work);
+
+	msleep(5);
+	tasklet_schedule(&q->rx_task);
+}
+
+int ccci_ccif_ring_send(struct ccci_md *md, unsigned int qno,
+			struct sk_buff *skb)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	struct ccci_ccif_queue *q;
+	unsigned long flags;
+	int ret;
+
+	if (!ccif || !md->ring_mode || qno >= CCCI_MAX_QUEUES)
+		return -ENODEV;
+
+	q = &ccif->q[qno];
+	if (!q->tx_ring)
+		return -ENODEV;
+
+	spin_lock_irqsave(&q->tx_lock, flags);
+	if (ccci_ringbuf_writeable(q->tx_ring, skb->len) <= 0) {
+		spin_unlock_irqrestore(&q->tx_lock, flags);
+		return -EBUSY;
+	}
+	ccci_inc_tx_seq(md, (struct ccci_header *)skb->data);
+	ret = ccci_ringbuf_write(q->tx_ring, skb->data, skb->len);
+	spin_unlock_irqrestore(&q->tx_lock, flags);
+	if (ret != skb->len) {
+		ccci_md_err(md, "q%u ring write %d/%u failed\n", qno, ret,
+			    skb->len);
+		return -EIO;
+	}
+
+	dev_kfree_skb_any(skb);
+	ccci_ccif_send(md, H2D_RINGQ0 + qno);
+	return 0;
+}
+
+int ccci_ccif_ring_write_room(struct ccci_md *md, unsigned int qno)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	unsigned long flags;
+	int ret;
+
+	if (!ccif || qno >= CCCI_MAX_QUEUES || !ccif->q[qno].tx_ring)
+		return 0;
+
+	spin_lock_irqsave(&ccif->q[qno].tx_lock, flags);
+	ret = ccci_ringbuf_writeable(ccif->q[qno].tx_ring, CCCI_HEADER_SIZE);
+	spin_unlock_irqrestore(&ccif->q[qno].tx_lock, flags);
+	return ret > 0 ? 1 : 0;
+}
+
+int ccci_ccif_ring_rx_poll(struct ccci_md *md, unsigned int qno, int budget)
+{
+	struct ccci_ccif *ccif = md->ccif;
+
+	if (!ccif || qno >= CCCI_MAX_QUEUES || !ccif->q[qno].rx_ring)
+		return 0;
+	/* budget 0 means "kick, do not poll in this context" */
+	if (budget == 0) {
+		if (!atomic_read(&ccif->q[qno].rx_running))
+			tasklet_schedule(&ccif->q[qno].rx_task);
+		return 0;
+	}
+	ccci_ccif_rx_tasklet(&ccif->q[qno].rx_task);
+	return 0;
+}
+
+static int ccci_ccif_ring_init(struct ccci_ccif *ccif)
+{
+	struct ccci_md *md = ccif->md;
+	const unsigned int *rx = ccif_rx_sizes(md);
+	const unsigned int *tx = ccif_tx_sizes(md);
+	size_t off, remain, total = 0;
+	void __iomem *base;
+	unsigned int i;
+
+	/* downstream: MD1 reserves 2MB for the EE dump at the head of smem,
+	 * MD3 starts after exception+runtime regions
+	 */
+	off = (md->id == CCCI_MD_SYS1) ? CCIF_MD_SMEM_RESERVE :
+	      (CCCI_SMEM_SIZE_EXCEPTION + CCCI_SMEM_SIZE_RUNTIME);
+	if (off >= md->smem_size)
+		return -ENOMEM;
+
+	base = md->smem_vir + off;
+	remain = md->smem_size - off;
+
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		struct ccci_ccif_queue *q = &ccif->q[i];
+		size_t size = CCCI_RINGBUF_CTL_LEN + rx[i] + tx[i];
+
+		if (size > remain) {
+			ccci_md_err(md,
+				    "smem too small for q%u rings (need 0x%zx, have 0x%zx)\n",
+				    i, size, remain);
+			return -ENOMEM;
+		}
+		q->rx_ring = ccci_ringbuf_create(base, size, rx[i], tx[i]);
+		if (!q->rx_ring) {
+			ccci_md_err(md, "q%u ring create failed\n", i);
+			return -ENOMEM;
+		}
+		q->tx_ring = q->rx_ring;
+		base += size;
+		remain -= size;
+		total += size;
+	}
+	ccif->total_smem_size = total;
+	ccci_md_info(md, "ccif rings at smem+0x%zx, 0x%zx bytes\n", off, total);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* exception handshake                                                 */
+/* ------------------------------------------------------------------ */
+static int ccci_ccif_poll_ready(struct ccci_md *md, unsigned int channel)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	unsigned int i;
+	u32 ch;
+
+	for (i = 0; i < CCIF_IRQ_POLL_CNT; i++) {
+		ch = ccif_rd(ccif, APCCIF_RCHNUM);
+		if (ch & BIT(channel)) {
+			ccif_wr(ccif, APCCIF_ACK, BIT(channel));
+			return 0;
+		}
+		msleep(CCIF_IRQ_POLL_MS);
+	}
+	ccci_md_err(md, "poll ccif ch%u timeout, RCHNUM=%08x\n", channel, ch);
+	return -ETIMEDOUT;
+}
+
+void ccci_ccif_exception(struct ccci_md *md, unsigned int stage)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	unsigned int i;
+
+	ccci_md_err(md, "MD exception HIF stage %u\n", stage);
+
+	switch (stage) {
+	case HIF_EX_INIT:
+		ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+		if (md->cldma)
+			ccci_cldma_stop(md->cldma);
+		/* dispatch must not depend on queue indices, so Rx can still
+		 * reach the ports during the exception flow
+		 */
+		ccci_ccif_send(md, H2D_EXCEPTION_ACK);
+		break;
+	case HIF_EX_INIT_DONE:
+		ccci_md_set_state(md, CCCI_MD_EXCEPTION);
+		break;
+	case HIF_EX_CLEARQ_DONE:
+		if (ccif) {
+			for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+				if (ccif->q[i].rx_ring) {
+					ccci_ringbuf_reset(ccif->q[i].rx_ring,
+							   false);
+					ccci_ringbuf_reset(ccif->q[i].rx_ring,
+							   true);
+				}
+			}
+		}
+		ccci_ccif_send(md, H2D_EXCEPTION_CLEARQ_ACK);
+		break;
+	case HIF_EX_ALLQ_RESET:
+		if (md->cldma)
+			ccci_cldma_start(md->cldma);
+		md->boot_stage = CCCI_BOOT_STAGE_2;
+		break;
+	default:
+		break;
+	}
+}
+
+/* CLDMA exception flow after H2D_EXCEPTION_ACK: the following stages are
+ * signalled by polling, downstream md_cd_ccif_work()
+ */
+static void ccci_ccif_exc_work(struct work_struct *work)
+{
+	struct ccci_ccif *ccif = container_of(work, struct ccci_ccif, exc_work);
+	struct ccci_md *md = ccif->md;
+
+	ccci_ccif_exception(md, HIF_EX_INIT);
+	if (ccci_ccif_poll_ready(md, D2H_EXCEPTION_INIT_DONE))
+		return;
+	ccci_ccif_exception(md, HIF_EX_INIT_DONE);
+	if (ccci_ccif_poll_ready(md, D2H_EXCEPTION_CLEARQ_DONE))
+		return;
+	ccci_ccif_exception(md, HIF_EX_CLEARQ_DONE);
+	if (ccci_ccif_poll_ready(md, D2H_EXCEPTION_ALLQ_RESET))
+		return;
+	ccci_ccif_exception(md, HIF_EX_ALLQ_RESET);
+}
+
+/* ------------------------------------------------------------------ */
+/* SRAM message                                                        */
+/* ------------------------------------------------------------------ */
+static void ccci_ccif_sram_rx(struct ccci_md *md)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	struct ccci_header *h = &ccif->sram->up_header;
+	struct sk_buff *skb;
+	u32 header[4];
+	int i;
+
+	/* downstream md_ccif_sram_rx_work(): only the 16 byte header lives in
+	 * the SRAM window, payload follows in shared memory
+	 */
+	for (i = 0; i < 4; i++)
+		header[i] = readl(((u32 __iomem *)h) + i);
+
+	skb = ccci_alloc_skb(CCCI_HEADER_SIZE, GFP_ATOMIC);
+	if (!skb)
+		return;
+	memcpy(skb_put(skb, CCCI_HEADER_SIZE), header, CCCI_HEADER_SIZE);
+	if (ccci_rx_dispatch(md, skb) == -CCCI_ERR_PORT_RX_FULL)
+		dev_kfree_skb_any(skb);
+}
+
+/* ------------------------------------------------------------------ */
+/* IRQ                                                                 */
+/* ------------------------------------------------------------------ */
+static irqreturn_t ccci_ccif_isr(int irq, void *data)
+{
+	struct ccci_ccif *ccif = data;
+	u32 ch;
+
+	ch = ccif_rd(ccif, APCCIF_RCHNUM);
+	if (!ch)
+		return IRQ_NONE;
+
+	/* the MD asserts the line until APCCIF_ACK is written back */
+	ccif_wr(ccif, APCCIF_ACK, ch);
+	spin_lock(&ccif->lock);
+	ccif->channels |= ch;
+	spin_unlock(&ccif->lock);
+
+	if (ch & (BIT(D2H_EXCEPTION_INIT) | BIT(D2H_EXCEPTION_INIT_DONE) |
+		  BIT(D2H_EXCEPTION_CLEARQ_DONE) |
+		  BIT(D2H_EXCEPTION_ALLQ_RESET) | BIT(AP_MD_SEQ_ERROR) |
+		  BIT(D2H_SRAM)))
+		return IRQ_WAKE_THREAD;
+
+	tasklet_schedule(&ccif->irq_task);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t ccci_ccif_thread(int irq, void *data)
+{
+	struct ccci_ccif *ccif = data;
+	struct ccci_md *md = ccif->md;
+	unsigned long pending;
+
+	spin_lock_irq(&ccif->lock);
+	pending = ccif->channels &
+		  (BIT(D2H_EXCEPTION_INIT) | BIT(D2H_EXCEPTION_INIT_DONE) |
+		   BIT(D2H_EXCEPTION_CLEARQ_DONE) |
+		   BIT(D2H_EXCEPTION_ALLQ_RESET) | BIT(AP_MD_SEQ_ERROR) |
+		   BIT(D2H_SRAM));
+	ccif->channels &= ~pending;
+	spin_unlock_irq(&ccif->lock);
+
+	if (!pending) {
+		tasklet_schedule(&ccif->irq_task);
+		return IRQ_HANDLED;
+	}
+
+	if (pending & BIT(AP_MD_SEQ_ERROR)) {
+		ccci_md_err(md, "MD detected a sequence error\n");
+		ccci_ccif_dump_regs(md, NULL);
+	}
+
+	if (pending & BIT(D2H_SRAM))
+		ccci_ccif_sram_rx(md);
+
+	if (md->cldma) {
+		if (pending & (BIT(D2H_EXCEPTION_INIT) |
+			       BIT(D2H_EXCEPTION_INIT_DONE) |
+			       BIT(D2H_EXCEPTION_CLEARQ_DONE) |
+			       BIT(D2H_EXCEPTION_ALLQ_RESET)))
+			schedule_work(&ccif->exc_work);
+	} else {
+		if (pending & BIT(D2H_EXCEPTION_INIT))
+			ccci_ccif_exception(md, HIF_EX_INIT);
+		if (pending & BIT(D2H_EXCEPTION_INIT_DONE))
+			ccci_ccif_exception(md, HIF_EX_INIT_DONE);
+		if (pending & BIT(D2H_EXCEPTION_CLEARQ_DONE))
+			ccci_ccif_exception(md, HIF_EX_CLEARQ_DONE);
+		if (pending & BIT(D2H_EXCEPTION_ALLQ_RESET))
+			ccci_ccif_exception(md, HIF_EX_ALLQ_RESET);
+	}
+
+	/* anything the thread could not classify (unknown bits) is dropped by
+	 * the tasklet, ring bits are handled there as well
+	 */
+	tasklet_schedule(&ccif->irq_task);
+	return IRQ_HANDLED;
+}
+
+static void ccci_ccif_irq_task(struct tasklet_struct *t)
+{
+	struct ccci_ccif *ccif = from_tasklet(ccif, t, irq_task);
+	unsigned long pending;
+	int i;
+
+	/* the tasklet owns the ring doorbells only; exception and SRAM bits
+	 * stay queued for the threaded handler
+	 */
+	spin_lock_irq(&ccif->lock);
+	pending = ccif->channels & CCCI_CCIF_RING_MASK;
+	ccif->channels &= ~CCCI_CCIF_RING_MASK;
+	spin_unlock_irq(&ccif->lock);
+
+	if (!pending)
+		return;
+
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		if ((pending & BIT(D2H_RINGQ0 + i)) && ccif->q[i].rx_ring)
+			tasklet_schedule(&ccif->q[i].rx_task);
+	}
+
+}
+
+/* ------------------------------------------------------------------ */
+/* MD watchdog                                                         */
+/* ------------------------------------------------------------------ */
+static void ccci_ccif_wdt_work(struct work_struct *work)
+{
+	struct ccci_ccif *ccif = container_of(work, struct ccci_ccif, wdt_work);
+	struct ccci_md *md = ccif->md;
+
+	ccci_md_err(md, "MD watchdog IRQ, recovering\n");
+	ccif_disable_irq(md);
+	ccci_ccif_dump_regs(md, NULL);
+	ccci_md_reset(md);
+	ccci_send_virtual_md_msg(md, CCCI_MONITOR_CH, CCCI_MD_MSG_RESET, 0);
+}
+
+static irqreturn_t ccci_ccif_wdt_isr(int irq, void *data)
+{
+	struct ccci_ccif *ccif = data;
+
+	schedule_work(&ccif->wdt_work);
+	return IRQ_HANDLED;
+}
+
+/* ------------------------------------------------------------------ */
+/* create / start / stop / destroy                                     */
+/* ------------------------------------------------------------------ */
+struct ccci_ccif *ccci_ccif_create(struct ccci_md *md, struct device *dev,
+				   void __iomem *ap_base, void __iomem *md_base,
+				   void __iomem *rgu_base, phys_addr_t boot_vector,
+				   phys_addr_t boot_key, phys_addr_t boot_en,
+				   unsigned int irq, unsigned int wdt_irq,
+				   unsigned int sram_size, bool ring_mode)
+{
+	struct ccci_ccif *ccif;
+	unsigned int i;
+
+	if (!md || !ap_base || !irq)
+		return ERR_PTR(-EINVAL);
+
+	ccif = kzalloc(sizeof(*ccif), GFP_KERNEL);
+	if (!ccif)
+		return ERR_PTR(-ENOMEM);
+
+	ccif->md = md;
+	ccif->dev = dev;
+	ccif->ap_base = ap_base;
+	ccif->md_base = md_base;
+	ccif->rgu_base = rgu_base;
+	if (boot_vector)
+		ccif->boot_vector = ioremap(boot_vector, 4);
+	if (boot_key)
+		ccif->boot_key = ioremap(boot_key, 4);
+	if (boot_en)
+		ccif->boot_en = ioremap(boot_en, 4);
+	ccif->irq = irq;
+	ccif->wdt_irq = wdt_irq;
+	ccif->sram_size = sram_size ? sram_size : CCIF_SRAM_SIZE;
+	ccif->ring_mode = ring_mode;
+	ccif->sram = (struct ccci_ccif_sram *)(ap_base + APCCIF_CHDATA);
+	spin_lock_init(&ccif->lock);
+	tasklet_setup(&ccif->irq_task, ccci_ccif_irq_task);
+	INIT_WORK(&ccif->exc_work, ccci_ccif_exc_work);
+	INIT_WORK(&ccif->wdt_work, ccci_ccif_wdt_work);
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		ccif->q[i].md = md;
+		ccif->q[i].index = i;
+		spin_lock_init(&ccif->q[i].tx_lock);
+		atomic_set(&ccif->q[i].rx_running, 0);
+		tasklet_setup(&ccif->q[i].rx_task, ccci_ccif_rx_tasklet);
+		INIT_WORK(&ccif->q[i].rx_retry_work,
+			  ccci_ccif_rx_retry_work);
+	}
+	return ccif;
+}
+
+int ccci_ccif_start(struct ccci_ccif *ccif)
+{
+	struct ccci_md *md;
+	unsigned int i;
+	int ret;
+
+	if (!ccif)
+		return -EINVAL;
+	md = ccif->md;
+	if (ccif->started)
+		return 0;
+
+	/* downstream md_ccif_hw_init(): arbitration on, clear all acks,
+	 * clear the SRAM window
+	 */
+	ccif_wr(ccif, APCCIF_CON, 0x01);
+	ccif_wr(ccif, APCCIF_ACK, 0xFFFF);
+	for (i = 0; i < ccif->sram_size / sizeof(u32); i++)
+		writel(0, ccif->ap_base + APCCIF_CHDATA + i * sizeof(u32));
+
+	ret = request_threaded_irq(ccif->irq, ccci_ccif_isr, ccci_ccif_thread,
+				   0, "CCIF_AP", ccif);
+	if (ret) {
+		ccci_md_err(md, "request CCIF irq %u failed %d\n", ccif->irq,
+			    ret);
+		return ret;
+	}
+	if (ccif->wdt_irq) {
+		ret = request_threaded_irq(ccif->wdt_irq, NULL,
+					   ccci_ccif_wdt_isr, 0, "MD_WDT",
+					   ccif);
+		if (ret) {
+			ccci_md_err(md, "request MD WDT irq %u failed %d\n",
+				    ccif->wdt_irq, ret);
+			free_irq(ccif->irq, ccif);
+			return ret;
+		}
+		/* balanced by ccif_enable_irq() at modem start */
+		disable_irq_nosync(ccif->wdt_irq);
+	}
+	ccif->irq_enabled = true;
+
+	if (ccif->ring_mode) {
+		ret = ccci_ccif_ring_init(ccif);
+		if (ret) {
+			free_irq(ccif->irq, ccif);
+			if (ccif->wdt_irq)
+				free_irq(ccif->wdt_irq, ccif);
+			ccif->irq_enabled = false;
+			return ret;
+		}
+	}
+
+	ccif->started = true;
+	ccci_md_info(md, "ccif started (%s mode), irq %u wdt %u\n",
+		     ccif->ring_mode ? "ring" : "control", ccif->irq,
+		     ccif->wdt_irq);
+	return 0;
+}
+
+void ccci_ccif_stop(struct ccci_ccif *ccif)
+{
+	struct ccci_md *md;
+	unsigned int i;
+
+	if (!ccif || !ccif->started)
+		return;
+	md = ccif->md;
+
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		cancel_work_sync(&ccif->q[i].rx_retry_work);
+		tasklet_kill(&ccif->q[i].rx_task);
+	}
+	cancel_work_sync(&ccif->exc_work);
+	tasklet_kill(&ccif->irq_task);
+
+	free_irq(ccif->irq, ccif);
+	if (ccif->wdt_irq)
+		free_irq(ccif->wdt_irq, ccif);
+	ccif->started = false;
+	ccif->irq_enabled = false;
+	ccif->channels = 0;
+
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		kfree(ccif->q[i].rx_ring);
+		ccif->q[i].rx_ring = NULL;
+		ccif->q[i].tx_ring = NULL;
+	}
+	ccci_md_dbg(md, "ccif stopped\n");
+}
+
+void ccci_ccif_destroy(struct ccci_ccif *ccif)
+{
+	if (!ccif)
+		return;
+	ccci_ccif_stop(ccif);
+	cancel_work_sync(&ccif->wdt_work);
+	if (ccif->boot_vector)
+		iounmap(ccif->boot_vector);
+	if (ccif->boot_key)
+		iounmap(ccif->boot_key);
+	if (ccif->boot_en)
+		iounmap(ccif->boot_en);
+	if (ccif->md)
+		ccif->md->ccif = NULL;
+	kfree(ccif);
+}
+
+void ccci_ccif_reset_rings(struct ccci_md *md)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	unsigned int i;
+
+	if (!ccif)
+		return;
+	for (i = 0; i < CCCI_MAX_QUEUES; i++) {
+		if (!ccif->q[i].rx_ring)
+			continue;
+		ccci_ringbuf_reset(ccif->q[i].rx_ring, false);
+		ccci_ringbuf_reset(ccif->q[i].rx_ring, true);
+	}
+}
+
+void ccci_ccif_dump_regs(struct ccci_md *md, struct seq_file *s)
+{
+	struct ccci_ccif *ccif = md->ccif;
+	u32 con, busy, start, tchnum, rchnum, ack;
+
+	if (!ccif || !ccif->ap_base) {
+		if (s)
+			seq_puts(s, "ccif: not available\n");
+		return;
+	}
+
+	con = ccif_rd(ccif, APCCIF_CON);
+	busy = ccif_rd(ccif, APCCIF_BUSY);
+	start = ccif_rd(ccif, APCCIF_START);
+	tchnum = ccif_rd(ccif, APCCIF_TCHNUM);
+	rchnum = ccif_rd(ccif, APCCIF_RCHNUM);
+	ack = ccif_rd(ccif, APCCIF_ACK);
+
+	if (s) {
+		seq_printf(s, "AP_CON     0x%08x\n", con);
+		seq_printf(s, "AP_BUSY    0x%08x\n", busy);
+		seq_printf(s, "AP_START   0x%08x\n", start);
+		seq_printf(s, "AP_TCHNUM  0x%08x\n", tchnum);
+		seq_printf(s, "AP_RCHNUM  0x%08x\n", rchnum);
+		seq_printf(s, "AP_ACK     0x%08x\n", ack);
+		seq_printf(s, "irq         %u (enabled %d), wdt irq %u\n",
+			   ccif->irq, ccif->irq_enabled, ccif->wdt_irq);
+		seq_printf(s, "channels    0x%08lx\n", ccif->channels);
+		seq_printf(s, "ring mode   %d, smem 0x%zx\n", ccif->ring_mode,
+			   (size_t)ccif->total_smem_size);
+	} else {
+		ccci_md_err(md, "CON %08x BUSY %08x START %08x TCHNUM %08x RCHNUM %08x ACK %08x\n",
+			    con, busy, start, tchnum, rchnum, ack);
+	}
+}
diff --git a/drivers/misc/mediatek/ccci/ccci_core.c b/drivers/misc/mediatek/ccci/ccci_core.c
new file mode 100644
index 000000000..acf1f414c
--- /dev/null
+++ b/drivers/misc/mediatek/ccci/ccci_core.c
@@ -0,0 +1,1265 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCCI core: modem objects, per-MD state machine, logical port table,
+ * Rx dispatch and Tx queueing.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel
+ * drivers/misc/mediatek/eccci/{ccci_core.c,port_cfg.c}.
+ * Original copyright: Copyright (C) 2015 MediaTek Inc. GPL-2.0.
+ *
+ * State machine: downstream uses MD_STATE {INVALID, GATED, BOOTING, READY,
+ * EXCEPTION, RESET, RX_IRQ, TX_IRQ, TX_FULL, BOOT_FAIL}.  The frozen shared
+ * header exposes enum ccci_md_state {INVALID, BOOTING, READY, EXCEPTION,
+ * STOPPED}, so INVALID/GATED/RESET are collapsed into CCCI_MD_STOPPED and the
+ * port-private pseudo events are delivered as CCCI_EV_* below.
+ */
+#include <linux/ccci.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "ccci_priv.h"
+
+LIST_HEAD(ccci_md_list);
+static DEFINE_MUTEX(ccci_md_list_lock);
+struct class *ccci_class;
+
+static struct ccci_md *ccci_md_alloc(unsigned int md_id);
+static void ccci_md_free(struct ccci_md *md);
+
+/* ------------------------------------------------------------------ */
+/* skb helpers                                                         */
+/* ------------------------------------------------------------------ */
+struct sk_buff *ccci_alloc_skb(unsigned int len, gfp_t gfp)
+{
+	if (!len)
+		return NULL;
+	/* the ccci_header is always the first thing the modem sees and the
+	 * ports pull it, which leaves CCCI_HEADER_SIZE bytes of headroom
+	 */
+	return alloc_skb(len, gfp);
+}
+
+/* ------------------------------------------------------------------ */
+/* sequence numbers, downstream FEATURE_SEQ_CHECK_EN handling           */
+/* ------------------------------------------------------------------ */
+void ccci_reset_seq(struct ccci_md *md)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&md->lock, flags);
+	memset(md->seq_out, 0, sizeof(md->seq_out));
+	memset(md->seq_in, 0xFF, sizeof(md->seq_in));	/* -1 per entry */
+	spin_unlock_irqrestore(&md->lock, flags);
+}
+
+void ccci_inc_tx_seq(struct ccci_md *md, struct ccci_header *ccci_h)
+{
+	unsigned long flags;
+
+	if (ccci_h->channel >= CCCI_MAX_CH_NUM)
+		return;		/* e.g. CCCI_FORCE_ASSERT_CH */
+
+	spin_lock_irqsave(&md->lock, flags);
+	ccci_h->seq_num = md->seq_out[ccci_h->channel]++;
+	ccci_h->assert_bit = 1;
+	/* RPC/FS tasks are preemptible once the modem runs multi-task */
+	if ((ccci_h->channel == CCCI_RPC_TX || ccci_h->channel == CCCI_FS_TX) &&
+	    md->boot_stage != CCCI_BOOT_STAGE_1)
+		ccci_h->assert_bit = 0;
+	spin_unlock_irqrestore(&md->lock, flags);
+}
+
+void ccci_chk_rx_seq(struct ccci_md *md, struct ccci_header *ccci_h,
+		     unsigned int qno)
+{
+	unsigned long flags;
+	u16 channel = ccci_h->channel;
+	s16 prev;
+
+	if (channel >= CCCI_MAX_CH_NUM || !ccci_h->assert_bit)
+		return;
+
+	spin_lock_irqsave(&md->lock, flags);
+	prev = md->seq_in[channel];
+	if (prev != -1 && ((ccci_h->seq_num - prev) & 0x7FFF) != 1) {
+		spin_unlock_irqrestore(&md->lock, flags);
+		ccci_md_err(md, "channel %u seq out-of-order %d->%u (q%u)\n",
+			    channel, prev, ccci_h->seq_num, qno);
+		ccci_ccif_dump_regs(md, NULL);
+		/* downstream force_assert(md, CCIF_INTR_SEQ) */
+		if (md->ccif)
+			ccci_ccif_send(md, AP_MD_SEQ_ERROR);
+		else
+			ccci_md_force_assert(md, 0);
+		return;
+	}
+	md->seq_in[channel] = ccci_h->seq_num;
+	spin_unlock_irqrestore(&md->lock, flags);
+}
+
+/* ------------------------------------------------------------------ */
+/* state machine                                                       */
+/* ------------------------------------------------------------------ */
+int ccci_md_set_state(struct ccci_md *md, enum ccci_md_state state)
+{
+	unsigned long flags;
+	enum ccci_md_state old;
+
+	spin_lock_irqsave(&md->lock, flags);
+	old = md->state;
+	md->state = state;
+	spin_unlock_irqrestore(&md->lock, flags);
+
+	if (old == state)
+		return 0;
+
+	ccci_md_info(md, "state %d -> %d\n", old, state);
+	ccci_md_notify_ports(md, state);
+	return 0;
+}
+
+void ccci_md_notify_ports(struct ccci_md *md, int event)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->ops && port->ops->md_state_notice)
+			port->ops->md_state_notice(port, event);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* port lookups and dispatch                                           */
+/* ------------------------------------------------------------------ */
+struct ccci_md *ccci_md_get(unsigned int md_id)
+{
+	struct ccci_md *md, *found = NULL;
+
+	mutex_lock(&ccci_md_list_lock);
+	list_for_each_entry(md, &ccci_md_list, list) {
+		if (md->id == md_id) {
+			found = md;
+			break;
+		}
+	}
+	mutex_unlock(&ccci_md_list_lock);
+	return found;
+}
+
+struct ccci_port *ccci_md_get_port_by_channel(struct ccci_md *md, unsigned int ch)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->tx_ch == ch || port->rx_ch == ch)
+			return port;
+	}
+	return NULL;
+}
+
+struct ccci_port *ccci_md_get_port_by_minor(struct ccci_md *md, unsigned int minor)
+{
+	struct ccci_port *port;
+
+	list_for_each_entry(port, &md->ports_list, node) {
+		if (port->minor == minor && port->cdev_added)
+			return port;
+	}
+	return NULL;
+}
+
+struct ccci_port *ccci_get_port_for_node(dev_t devt)
+{
+	struct ccci_md *md;
+
+	mutex_lock(&ccci_md_list_lock);
+	list_for_each_entry(md, &ccci_md_list, list) {
+		if (md->major == MAJOR(devt)) {
+			struct ccci_port *port = ccci_md_get_port_by_minor(md,
+							MINOR(devt));
+
+			mutex_unlock(&ccci_md_list_lock);
+			return port;
+		}
+	}
+	mutex_unlock(&ccci_md_list_lock);
+	return NULL;
+}
+
+int ccci_port_recv_skb(struct ccci_port *port, struct sk_buff *skb)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&port->rx_lock, flags);
+	if (port->rx_len >= port->rx_len_th) {
+		port->rx_full = true;
+		spin_unlock_irqrestore(&port->rx_lock, flags);
+		if (port->flags & PORT_F_ALLOW_DROP) {
+			port->rx_drops++;
+			dev_kfree_skb_any(skb);
+			return 0;
+		}
+		return -CCCI_ERR_PORT_RX_FULL;
+	}
+	port->rx_full = false;
+	port->rx_len++;
+	__skb_queue_tail(&port->rx_q, skb);
+	spin_unlock_irqrestore(&port->rx_lock, flags);
+
+	port->rx_pkts++;
+	wake_up_interruptible(&port->rx_wq);
+	if (port->ops->md_state_notice)
+		port->ops->md_state_notice(port, CCCI_EV_RX_IRQ);
+
+	return 0;
+}
+
+/*
+ * ccci_rx_dispatch_qno - hand a received packet from hardware queue @qno to
+ * its port
+ *
+ * Return 0 when the skb was consumed (or dropped), -CCCI_ERR_PORT_RX_FULL
+ * when the caller must retry with the same skb.
+ */
+int ccci_rx_dispatch_qno(struct ccci_md *md, struct sk_buff *skb,
+			 unsigned int qno)
+{
+	struct ccci_header *ccci_h;
+	struct ccci_port *port;
+	enum ccci_md_state state;
+	int ret = -CCCI_ERR_DROP_PACKET;
+
+	if (!skb || skb->len < CCCI_HEADER_SIZE) {
+		dev_kfree_skb_any(skb);
+		return -CCCI_ERR_INVALID_PARAM;
+	}
+
+	ccci_h = (struct ccci_header *)skb->data;
+	if (ccci_h->channel >= CCCI_MAX_CH_NUM) {
+		ccci_md_err(md, "drop packet on invalid channel %u\n",
+			    ccci_h->channel);
+		dev_kfree_skb_any(skb);
+		return -CCCI_ERR_CHANNEL_NUM_MIS_MATCH;
+	}
+
+	state = md->state;
+	if ((state == CCCI_MD_STOPPED || state == CCCI_MD_INVALID) &&
+	    ccci_h->channel != CCCI_MONITOR_CH) {
+		dev_kfree_skb_any(skb);
+		return -CCCI_ERR_HIF_NOT_POWER_ON;
+	}
+
+	ccci_chk_rx_seq(md, ccci_h, qno);
+	ccci_md_dbg(md, "rx ch%u len%u\n", ccci_h->channel, skb->len);
+
+	list_for_each_entry(port, &md->rx_ch_ports[ccci_h->channel], rx_node) {
+		if (port->rx_ch != ccci_h->channel)
+			continue;
+		if (!port->ops->recv_skb)
+			break;
+		ret = port->ops->recv_skb(port, skb);
+		/* the port consumed the skb on 0, kept it on -RX_FULL */
+		if (ret == 0 || ret == -CCCI_ERR_PORT_RX_FULL)
+			return ret;
+		break;
+	}
+
+	dev_kfree_skb_any(skb);
+	return -CCCI_ERR_DROP_PACKET;
+}
+
+int ccci_rx_dispatch(struct ccci_md *md, struct sk_buff *skb)
+{
+	return ccci_rx_dispatch_qno(md, skb, 0);
+}
+
+void ccci_port_ask_more(struct ccci_port *port)
+{
+	struct ccci_md *md = port->md;
+
+	port->rx_full = false;
+	/* CCIF ring transport only pushes packets on a doorbell or after the
+	 * port drains; wake the queue worker so it re-scans the ring.
+	 */
+	if (md->ring_mode && md->ccif) {
+		unsigned int qno = ccci_port_rxq(port);
+
+		if (qno < CCCI_MAX_QUEUES)
+			ccci_ccif_ring_rx_poll(md, qno, 0);
+	}
+	if (!skb_queue_empty(&md->rx_backlog))
+		schedule_work(&md->rx_backlog_work);
+}
+
+/*
+ * ccci_md_rx_backlog_work - retry packets whose port was full
+ *
+ * The CLDMA engine hands us skbs one by one; a busy character port must not
+ * make us drop modem traffic, so pending packets wait here until the port
+ * drains.
+ */
+static void ccci_md_rx_backlog_work(struct work_struct *work)
+{
+	struct ccci_md *md = container_of(work, struct ccci_md, rx_backlog_work);
+	struct sk_buff *skb;
+
+	while ((skb = skb_dequeue(&md->rx_backlog))) {
+		unsigned int retry = 0;
+
+		while (ccci_rx_dispatch(md, skb) == -CCCI_ERR_PORT_RX_FULL) {
+			/* the port drains in process context; give it time and
+			 * eventually drop instead of stalling the modem Rx path
+			 */
+			if (++retry > 20) {
+				ccci_md_err(md, "port still full, drop rx packet\n");
+				dev_kfree_skb_any(skb);
+				break;
+			}
+			msleep(5);
+		}
+	}
+}
+
+/* CLDMA rx callback: called with a packet owned by us */
+void ccci_md_rx_cb(void *ctx, unsigned int qno, struct sk_buff *skb)
+{
+	struct ccci_md *md = ctx;
+
+	if (!md || !skb)
+		return;
+
+	if (ccci_rx_dispatch_qno(md, skb, qno) == -CCCI_ERR_PORT_RX_FULL) {
+		if (skb_queue_len(&md->rx_backlog) > 256) {
+			ccci_md_err(md, "rx backlog overflow on q%u\n", qno);
+			dev_kfree_skb_any(skb);
+			return;
+		}
+		skb_queue_tail(&md->rx_backlog, skb);
+		schedule_work(&md->rx_backlog_work);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Tx                                                                  */
+/* ------------------------------------------------------------------ */
+int ccci_md_write_room(struct ccci_md *md, unsigned int qno)
+{
+	if (qno >= CCCI_MAX_QUEUES)
+		return -CCCI_ERR_INVALID_QUEUE_INDEX;
+
+	if (md->cldma)
+		return 1;	/* the CLDMA engine reports -EBUSY on send */
+
+	if (md->ring_mode && md->ccif)
+		return ccci_ccif_ring_write_room(md, qno);
+
+	return -CCCI_ERR_INVALID_QUEUE_INDEX;
+}
+
+/**
+ * ccci_md_send_skb - send one CCCI packet to the modem
+ *
+ * On success the skb is consumed here.  On failure the caller still owns the
+ * skb and must free it (documented in the leaf report).
+ */
+int ccci_md_send_skb(struct ccci_md *md, unsigned int qno, struct sk_buff *skb)
+{
+	struct ccci_header *ccci_h;
+	int ret;
+
+	if (!skb)
+		return -CCCI_ERR_INVALID_PARAM;
+	if (skb->len < CCCI_HEADER_SIZE)
+		return -CCCI_ERR_INVALID_PARAM;
+	if (qno >= CCCI_MAX_QUEUES)
+		return -CCCI_ERR_INVALID_QUEUE_INDEX;
+
+	ccci_h = (struct ccci_header *)skb->data;
+
+	/* room is checked before the sequence number is applied, so a busy
+	 * queue does not leave a hole in the per-channel sequence
+	 */
+	if (ccci_md_write_room(md, qno) <= 0)
+		return -EBUSY;
+
+	if (md->cldma) {
+		/* the CLDMA engine owns the per-channel sequence counter, as
+		 * in downstream modem_cldma.c:2862.  RPC/FS must only assert
+		 * while the modem is in its single-task phase (ccci_core.h:902)
+		 */
+		if (ccci_h->channel == CCCI_RPC_TX ||
+		    ccci_h->channel == CCCI_FS_TX)
+			ccci_h->assert_bit =
+				md->boot_stage == CCCI_BOOT_STAGE_1;
+		ret = ccci_cldma_send(md->cldma, qno, skb);
+		return ret;
+	}
+
+	if (md->ring_mode && md->ccif) {
+		/* ring send applies the sequence number under its tx lock */
+		ret = ccci_ccif_ring_send(md, qno, skb);
+		return ret;
+	}
+
+	return -CCCI_ERR_INVALID_QUEUE_INDEX;
+}
+
+int ccci_send_msg_to_md(struct ccci_md *md, unsigned int ch, u32 msg, u32 resv,
+			bool blocking)
+{
+	struct ccci_port *port;
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	unsigned int qno;
+	gfp_t gfp;
+	int ret;
+
+	if (!md)
+		return -CCCI_ERR_INVALID_PARAM;
+
+	if (md->state != CCCI_MD_BOOTING && md->state != CCCI_MD_READY &&
+	    md->state != CCCI_MD_EXCEPTION)
+		return -CCCI_ERR_MD_NOT_READY;
+	if (ch == CCCI_SYSTEM_TX && md->state != CCCI_MD_READY)
+		return -CCCI_ERR_MD_NOT_READY;
+
+	port = ccci_md_get_port_by_channel(md, ch);
+	if (!port)
+		return -CCCI_ERR_CHANNEL_NUM_MIS_MATCH;
+
+	qno = ccci_port_txq(port);
+	if (qno >= CCCI_MAX_QUEUES)
+		return -CCCI_ERR_INVALID_QUEUE_INDEX;
+
+	if (blocking) {
+		unsigned int retry = 0;
+
+		/* ID_PAUSE_LTE is called by DVFS with interrupts disabled, so
+		 * this wait must not sleep (downstream spins with udelay(5))
+		 */
+		while (ccci_md_write_room(md, qno) <= 0 && retry++ < 200)
+			udelay(5);
+	}
+
+	/* DVFS may call this with interrupts disabled */
+	gfp = (in_interrupt() || irqs_disabled()) ? GFP_ATOMIC : GFP_KERNEL;
+	skb = ccci_alloc_skb(CCCI_HEADER_SIZE, gfp);
+	if (!skb)
+		return -CCCI_ERR_ALLOCATE_MEMORY_FAIL;
+
+	ccci_h = (struct ccci_header *)skb_put(skb, CCCI_HEADER_SIZE);
+	memset(ccci_h, 0, CCCI_HEADER_SIZE);
+	ccci_h->data[0] = CCCI_MAGIC_NUM;
+	ccci_h->data[1] = msg;
+	ccci_h->channel = ch;
+	ccci_h->reserved = resv;
+
+	port->tx_pkts++;
+	ret = ccci_md_send_skb(md, qno, skb);
+	if (ret) {
+		if (ret == -EBUSY)
+			port->tx_busy_cnt++;
+		dev_kfree_skb_any(skb);
+	}
+	return ret;
+}
+
+int ccci_send_virtual_md_msg(struct ccci_md *md, unsigned int ch, u32 msg,
+			     u32 resv)
+{
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	int ret, retry = 0;
+
+	if (ch != CCCI_MONITOR_CH)
+		return -CCCI_ERR_CHANNEL_NUM_MIS_MATCH;
+	if (in_interrupt())
+		return -CCCI_ERR_INVALID_PARAM;
+
+	skb = ccci_alloc_skb(CCCI_HEADER_SIZE, GFP_KERNEL);
+	if (!skb)
+		return -CCCI_ERR_ALLOCATE_MEMORY_FAIL;
+
+	ccci_h = (struct ccci_header *)skb_put(skb, CCCI_HEADER_SIZE);
+	memset(ccci_h, 0, CCCI_HEADER_SIZE);
+	ccci_h->data[0] = CCCI_MAGIC_NUM;
+	ccci_h->data[1] = msg;
+	ccci_h->channel = ch;
+	ccci_h->reserved = resv;
+
+	for (;;) {
+		ret = ccci_rx_dispatch(md, skb);
+		if (ret != -CCCI_ERR_PORT_RX_FULL)
+			return ret;
+		if (++retry > 20) {
+			ccci_md_err(md, "port full, drop virtual msg 0x%x\n",
+				    msg);
+			return ret;
+		}
+		msleep(100);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* force assert                                                        */
+/* ------------------------------------------------------------------ */
+int ccci_md_force_assert(struct ccci_md *md, unsigned int ccif_only)
+{
+	struct ccci_header *ccci_h;
+	struct sk_buff *skb;
+	int ret;
+
+	if (ccif_only && md->ccif)
+		return ccci_ccif_send(md, H2D_FORCE_MD_ASSERT);
+
+	skb = ccci_alloc_skb(CCCI_HEADER_SIZE, GFP_ATOMIC);
+	if (!skb)
+		return -CCCI_ERR_ALLOCATE_MEMORY_FAIL;
+
+	ccci_h = (struct ccci_header *)skb_put(skb, CCCI_HEADER_SIZE);
+	memset(ccci_h, 0, CCCI_HEADER_SIZE);
+	ccci_h->data[0] = 0xFFFFFFFF;
+	ccci_h->data[1] = 0x5A5A5A5A;
+	/* the header channel field is 16 bit wide, the ROM relies on the
+	 * truncation of CCCI_FORCE_ASSERT_CH
+	 */
+	ccci_h->channel = (u16)CCCI_FORCE_ASSERT_CH;
+	ccci_h->reserved = 0xA5A5A5A5;
+
+	/* downstream hardcodes queue 0 */
+	ret = ccci_md_send_skb(md, 0, skb);
+	if (ret)
+		dev_kfree_skb_any(skb);
+	if (ret && md->ccif)
+		ret = ccci_ccif_send(md, H2D_FORCE_MD_ASSERT);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Modem life cycle                                                    */
+/* ------------------------------------------------------------------ */
+int ccci_md_start(struct ccci_md *md)
+{
+	unsigned int ret = 0;
+	int err;
+
+	mutex_lock(&md->op_lock);
+	if (md->state != CCCI_MD_STOPPED && md->state != CCCI_MD_INVALID) {
+		mutex_unlock(&md->op_lock);
+		return -EBUSY;
+	}
+
+	ccci_md_info(md, "start (fw=%s)\n", md->fw_name);
+
+	if (!md->boot.fw_valid) {
+		err = ccci_boot_load_firmware(md);
+		if (err) {
+			ccci_md_err(md, "firmware load failed: %s\n",
+				    md->boot.err_str[0] ? md->boot.err_str :
+				    "unknown");
+			ret = err;
+			goto fail;
+		}
+	}
+
+	if (md->hw_ops && md->hw_ops->power_on)
+		err = md->hw_ops->power_on(md->id);
+	else
+		err = ccci_boot_power_on(md);
+	if (err) {
+		ccci_md_err(md, "power on failed: %d\n", err);
+		ret = err;
+		goto fail;
+	}
+	md->powered = true;
+
+	ccci_reset_seq(md);
+	if (md->ccif) {
+		err = ccci_ccif_start(md->ccif);
+		if (err) {
+			ccci_md_err(md, "ccif start failed: %d\n", err);
+			ret = err;
+			goto fail;
+		}
+		ccci_ccif_reset_rings(md);
+	}
+	if (md->cldma) {
+		err = ccci_cldma_start(md->cldma);
+		if (err) {
+			ccci_md_err(md, "cldma start failed: %d\n", err);
+			ret = err;
+			goto fail;
+		}
+	}
+
+	md->boot_stage = CCCI_BOOT_STAGE_0;
+	ccci_md_set_state(md, CCCI_MD_BOOTING);
+	ccci_boot_arm_timer(md);
+
+	if (md->hw_ops && md->hw_ops->let_md_go)
+		err = md->hw_ops->let_md_go(md->id);
+	else
+		err = ccci_boot_let_md_go(md);
+	if (err) {
+		ccci_md_err(md, "let md go failed: %d\n", err);
+		ret = err;
+		goto fail;
+	}
+
+	if (md->ccif)
+		ccif_enable_irq(md);
+
+	md->boot_count++;
+	mutex_unlock(&md->op_lock);
+	return 0;
+
+fail:
+	ccci_boot_disarm_timer(md);
+	if (md->powered) {
+		if (md->hw_ops && md->hw_ops->power_off)
+			md->hw_ops->power_off(md->id);
+		else
+			ccci_boot_power_off(md);
+		md->powered = false;
+	}
+	ccci_md_set_state(md, CCCI_MD_STOPPED);
+	ccci_md_notify_ports(md, CCCI_EV_BOOT_FAIL);
+	mutex_unlock(&md->op_lock);
+	return ret;
+}
+
+int ccci_md_stop(struct ccci_md *md, unsigned int timeout)
+{
+	mutex_lock(&md->op_lock);
+	ccci_md_info(md, "stop (timeout=%u)\n", timeout);
+
+	ccci_boot_disarm_timer(md);
+	if (md->ccif) {
+		ccif_disable_irq(md);
+		ccci_ccif_stop(md->ccif);
+	}
+	if (md->cldma)
+		ccci_cldma_stop(md->cldma);
+
+	if (md->powered) {
+		if (md->hw_ops && md->hw_ops->power_off)
+			md->hw_ops->power_off(md->id);
+		else
+			ccci_boot_power_off(md);
+		md->powered = false;
+	}
+
+	ccci_md_set_state(md, CCCI_MD_STOPPED);
+	mutex_unlock(&md->op_lock);
+	return 0;
+}
+
+int ccci_md_reset(struct ccci_md *md)
+{
+	mutex_lock(&md->op_lock);
+	ccci_md_info(md, "reset\n");
+
+	ccci_boot_disarm_timer(md);
+	if (md->ccif)
+		ccif_disable_irq(md);
+	if (md->hw_ops && md->hw_ops->reset)
+		md->hw_ops->reset(md->id);
+	md->boot_stage = CCCI_BOOT_STAGE_0;
+	ccci_md_set_state(md, CCCI_MD_STOPPED);
+	mutex_unlock(&md->op_lock);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Registration API (frozen shared header)                             */
+/* ------------------------------------------------------------------ */
+static void ccci_md_class_dev_release(struct device *dev)
+{
+	kfree(dev);
+}
+
+static int ccci_md_class_dev_register(struct ccci_md *md, struct device *parent)
+{
+	struct device *dev;
+
+	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	if (!dev)
+		return -ENOMEM;
+
+	device_initialize(dev);
+	dev->class = ccci_class;
+	dev->parent = parent;
+	dev->release = ccci_md_class_dev_release;
+	dev_set_name(dev, "md%u", md->id + 1);
+	if (device_add(dev)) {
+		put_device(dev);
+		return -ENODEV;
+	}
+	dev_set_drvdata(dev, md);
+	md->dev = dev;
+	return 0;
+}
+
+static void ccci_md_class_dev_unregister(struct ccci_md *md)
+{
+	if (!md->dev)
+		return;
+	device_unregister(md->dev);
+	md->dev = NULL;
+}
+
+int ccci_md_register(const struct ccci_md_cfg *cfg, struct device *parent)
+{
+	struct ccci_md *md;
+	int ret;
+
+	if (!cfg || cfg->md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+	if (ccci_md_get(cfg->md_id))
+		return -EEXIST;
+
+	md = ccci_md_alloc(cfg->md_id);
+	if (!md)
+		return -ENOMEM;
+
+	/* Per-modem device: also the parent of every port char device and the
+	 * home of the per-modem sysfs attributes.
+	 */
+	ret = ccci_md_class_dev_register(md, parent);
+	if (ret)
+		goto err_free;
+
+	strscpy(md->name, cfg->name ? cfg->name : "md", sizeof(md->name));
+	strscpy(md->fw_name, cfg->firmware_name ? cfg->firmware_name :
+		(cfg->md_id == CCCI_MD_SYS3 ? "md3img" : "md1img"),
+		sizeof(md->fw_name));
+	md->capability = cfg->capability;
+	md->irat_md_id = cfg->irat_md_id;
+	md->ring_mode = true;
+
+	ret = ccci_boot_init(md);
+	if (ret)
+		goto err_device;
+
+	/* shared memory: image region + smem (DT reserved-memory, or a
+	 * coherent fallback sized for the CCIF rings)
+	 */
+	ret = ccci_boot_smem_setup(md, parent);
+	if (ret)
+		goto err_boot;
+
+	/* character device range for this modem */
+	ret = alloc_chrdev_region(&md->devt, 0, CCCI_MAX_PORT_MINOR, md->name);
+	if (ret) {
+		ccci_md_err(md, "alloc_chrdev_region failed %d\n", ret);
+		goto err_boot;
+	}
+	md->major = MAJOR(md->devt);
+
+	ret = ccci_md_port_cfg(md);
+	if (ret)
+		goto err_chrdev;
+
+	mutex_lock(&ccci_md_list_lock);
+	list_add_tail(&md->list, &ccci_md_list);
+	mutex_unlock(&ccci_md_list_lock);
+	md->registered = true;
+
+	ret = ccci_port_char_init(md);
+	if (ret)
+		goto err_registered;
+
+	ret = ccci_sysfs_md_init(md);
+	if (ret)
+		goto err_char;
+
+	if (ccci_util_log_init(md->id, md->dev))
+		ccci_md_warn(md, "util log init failed\n");
+
+	ccci_md_info(md, "registered, major %u, %u ports, %s transport\n",
+		     md->major, md->port_count,
+		     md->ring_mode ? "CCIF-ring" : "CLDMA");
+	return 0;
+
+err_char:
+	ccci_port_kernel_exit(md);
+	ccci_port_net_exit(md);
+	ccci_port_char_exit(md);
+err_registered:
+	mutex_lock(&ccci_md_list_lock);
+	list_del_init(&md->list);
+	mutex_unlock(&ccci_md_list_lock);
+	md->registered = false;
+err_chrdev:
+	unregister_chrdev_region(md->devt, CCCI_MAX_PORT_MINOR);
+err_boot:
+	ccci_boot_exit(md);
+err_device:
+	ccci_md_class_dev_unregister(md);
+	md->dev = NULL;
+err_free:
+	ccci_md_free(md);
+	return ret;
+}
+
+int ccci_register_modem(const struct ccci_md_cfg *cfg)
+{
+	return ccci_md_register(cfg, NULL);
+}
+EXPORT_SYMBOL_GPL(ccci_register_modem);
+
+void ccci_unregister_modem(unsigned int md_id)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+
+	if (!md)
+		return;
+
+	if (md->state == CCCI_MD_BOOTING || md->state == CCCI_MD_READY ||
+	    md->state == CCCI_MD_EXCEPTION)
+		ccci_md_stop(md, 0);
+
+	mutex_lock(&ccci_md_list_lock);
+	list_del_init(&md->list);
+	mutex_unlock(&ccci_md_list_lock);
+	md->registered = false;
+
+	ccci_util_log_exit(md->id);
+	ccci_sysfs_md_exit(md);
+	ccci_port_kernel_exit(md);
+	ccci_port_net_exit(md);
+	ccci_port_char_exit(md);
+	unregister_chrdev_region(md->devt, CCCI_MAX_PORT_MINOR);
+	ccci_boot_exit(md);
+	ccci_md_class_dev_unregister(md);
+	md->dev = NULL;
+	ccci_md_free(md);
+}
+EXPORT_SYMBOL_GPL(ccci_unregister_modem);
+
+int ccci_md_attach_ccif(struct ccci_md *md, struct ccci_ccif *ccif)
+{
+	if (!md || !ccif)
+		return -EINVAL;
+	md->ccif = ccif;
+	return 0;
+}
+
+int ccci_md_attach_cldma(struct ccci_md *md, struct ccci_cldma *cldma)
+{
+	if (!md || !cldma)
+		return -EINVAL;
+	md->cldma = cldma;
+	md->ring_mode = false;
+	return 0;
+}
+
+int ccci_md_get_state(unsigned int md_id)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+	int state;
+
+	if (!md)
+		return -ENODEV;
+	state = (int)READ_ONCE(md->state);
+	return state;
+}
+EXPORT_SYMBOL_GPL(ccci_md_get_state);
+
+int ccci_md_set_irat(unsigned int md_id, unsigned int irat_md_id)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+
+	if (!md)
+		return -ENODEV;
+	if (irat_md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+	md->irat_md_id = irat_md_id;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ccci_md_set_irat);
+
+int ccci_register_md_hw_ops(unsigned int md_id, const struct ccci_md_hw_ops *ops)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+
+	if (!md)
+		return -ENODEV;
+	md->hw_ops = ops;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ccci_register_md_hw_ops);
+
+void ccci_unregister_md_hw_ops(unsigned int md_id)
+{
+	struct ccci_md *md = ccci_md_get(md_id);
+
+	if (!md)
+		return;
+	md->hw_ops = NULL;
+}
+EXPORT_SYMBOL_GPL(ccci_unregister_md_hw_ops);
+
+/* ------------------------------------------------------------------ */
+/* modem object allocation                                             */
+/* ------------------------------------------------------------------ */
+static struct ccci_md *ccci_md_alloc(unsigned int md_id)
+{
+	struct ccci_md *md;
+	int i;
+
+	md = kzalloc(sizeof(*md), GFP_KERNEL);
+	if (!md)
+		return NULL;
+
+	md->id = md_id;
+	md->dev = NULL;
+	md->state = CCCI_MD_INVALID;
+	md->ex_type = 0;
+	md->irat_md_id = CCCI_MAX_MD_NUM;
+	md->runtime_version = AP_MD_HS_V2;
+	md->md_boot_mode = 0;	/* MD_BOOT_MODE_INVALID */
+	md->sim_type = 0xEEEEEEEE;
+	spin_lock_init(&md->lock);
+	mutex_init(&md->op_lock);
+	INIT_LIST_HEAD(&md->list);
+	INIT_LIST_HEAD(&md->ports_list);
+	skb_queue_head_init(&md->rx_backlog);
+	INIT_WORK(&md->rx_backlog_work, ccci_md_rx_backlog_work);
+	for (i = 0; i < CCCI_MAX_CH_NUM; i++)
+		INIT_LIST_HEAD(&md->rx_ch_ports[i]);
+	ccci_reset_seq(md);
+	snprintf(md->version, sizeof(md->version), "%u", CCCI_DRIVER_VER);
+	return md;
+}
+
+static void ccci_md_free(struct ccci_md *md)
+{
+	cancel_work_sync(&md->rx_backlog_work);
+	skb_queue_purge(&md->rx_backlog);
+	mutex_destroy(&md->op_lock);
+	kfree(md->ports);
+	kfree(md);
+}
