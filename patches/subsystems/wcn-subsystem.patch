+struct mtk_wcn_fm_pkt {
+	u8 *buf;
+	int cap;
+	int len;
+	int err;
+};
+
+static void mtk_wcn_fm_pkt_init(struct mtk_wcn_fm_pkt *pkt, u8 *buf, int cap,
+				u8 opcode)
+{
+	pkt->buf = buf;
+	pkt->cap = cap;
+	pkt->len = 4;
+	pkt->err = 0;
+	buf[0] = FM_PKT_TYPE_CMD;
+	buf[1] = opcode;
+	buf[2] = 0;
+	buf[3] = 0;
+}
+
+static void mtk_wcn_fm_pkt_add(struct mtk_wcn_fm_pkt *pkt, int written)
+{
+	if (pkt->err)
+		return;
+	if (written < 0)
+		pkt->err = written;
+	else
+		pkt->len += written;
+}
