+/* Maximum number of raw RDS records buffered for read(). */
+#define MTK_WCN_FM_RDS_FIFO_RECORDS	32
+
+/**
+ * struct mtk_wcn_fm_rds_block - one RDS group as delivered by the firmware
+ *
+ * Mirrors downstream rds_packet_t (inc/fm_rds.h:32-39): the firmware packs
+ * the four blocks of a group plus the correct-bit counter and CRC.
+ */
+struct mtk_wcn_fm_rds_block {
+	__u16 blk_a;
+	__u16 blk_b;
+	__u16 blk_c;
+	__u16 blk_d;
+	__u16 cbc;
+	__u16 crc;
+};
+
+/**
+ * struct mtk_wcn_fm_rds_data - payload of an RDS_RX_DATA event
+ *
+ * Mirrors downstream rds_rx_t (inc/fm_rds.h:41-45): two demodulator samples
+ * followed by up to MAX_RDS_RX_GROUP_CNT (12) groups.  sizeof() is 148 bytes,
+ * the same size as downstream rds_rx_t and rds_raw_t.data[].
+ */
+struct mtk_wcn_fm_rds_data {
+	__u16 sin;
+	__u16 cos;
+	struct mtk_wcn_fm_rds_block group[12];
+};
