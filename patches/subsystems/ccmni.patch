+/********************internal debug function*********************/
+/* ccmni.c:124-201 */
+static void ccmni_dbg_eth_header(int md_id, bool tx, struct ethhdr *ethh)
+{
+	if (ethh != NULL) {
+		CCMNI_INF_MSG(md_id,
+			      "[SKB][%s] ethhdr: proto=0x%04x dest_mac=%02x:%02x:%02x:%02x:%02x:%02x src_mac=%02x:%02x:%02x:%02x:%02x:%02x\n",
+			      tx ? "TX" : "RX", ntohs(ethh->h_proto),
+			      ethh->h_dest[0], ethh->h_dest[1], ethh->h_dest[2],
+			      ethh->h_dest[3], ethh->h_dest[4], ethh->h_dest[5],
+			      ethh->h_source[0], ethh->h_source[1],
+			      ethh->h_source[2], ethh->h_source[3],
+			      ethh->h_source[4], ethh->h_source[5]);
+	}
+}
+
+static void ccmni_dbg_ip_header(int md_id, bool tx, struct iphdr *iph)
+{
+	if (iph != NULL) {
+		CCMNI_INF_MSG(md_id,
+			      "[SKB][%s] iphdr: ihl=0x%02x ver=0x%02x tos=0x%02x tot_len=0x%04x id=0x%04x frag_off=0x%04x ttl=0x%02x proto=0x%02x check=0x%04x saddr=0x%08x daddr=0x%08x\n",
+			      tx ? "TX" : "RX", iph->ihl, iph->version, iph->tos,
+			      ntohs(iph->tot_len), ntohs(iph->id),
+			      ntohs(iph->frag_off), iph->ttl, iph->protocol,
+			      ntohs(iph->check), ntohl(iph->saddr),
+			      ntohl(iph->daddr));
+	}
+}
+
+static void ccmni_dbg_tcp_header(int md_id, bool tx, struct tcphdr *tcph)
+{
+	if (tcph != NULL) {
+		CCMNI_INF_MSG(md_id,
+			      "[SKB][%s] tcp_hdr: src=0x%04x dest=0x%04x seq=0x%08x ack_seq=0x%08x urg=%d ack=%d psh=%d rst=%d syn=%d fin=%d\n",
+			      tx ? "TX" : "RX", ntohs(tcph->source),
+			      ntohs(tcph->dest), ntohl(tcph->seq),
+			      ntohl(tcph->ack_seq), tcph->urg, tcph->ack,
+			      tcph->psh, tcph->rst, tcph->syn, tcph->fin);
+	}
+}
+
+static void ccmni_dbg_skb_header(int md_id, bool tx, struct sk_buff *skb)
+{
+	struct ethhdr *ethh = NULL;
+	struct iphdr *iph = NULL;
+	struct ipv6hdr *ipv6h = NULL;
+	struct tcphdr *tcph = NULL;
+	__be16 frag_off;
+	u8 nexthdr;
+	u32 l4_off;
+
+	if (!tx) {
+		ethh = (struct ethhdr *)(skb->data - ETH_HLEN);
+		ccmni_dbg_eth_header(md_id, tx, ethh);
+	}
+
+	if (skb->protocol == htons(ETH_P_IP)) {
+		iph = (struct iphdr *)skb->data;
+		ccmni_dbg_ip_header(md_id, tx, iph);
+
+		if (iph->protocol == IPPROTO_TCP) {
+			tcph = (struct tcphdr *)(skb->data + (iph->ihl << 2));
+			ccmni_dbg_tcp_header(md_id, tx, tcph);
+		}
+	} else if (skb->protocol == htons(ETH_P_IPV6)) {
+		ipv6h = (struct ipv6hdr *)skb->data;
+
+		nexthdr = ipv6h->nexthdr;
+		if (nexthdr == IPPROTO_TCP) {
+			l4_off = ipv6_skip_exthdr(skb, sizeof(*ipv6h), &nexthdr,
+						  &frag_off);
+			if (l4_off >= 0 &&
+			    l4_off + sizeof(*tcph) <= skb->len) {
+				tcph = (struct tcphdr *)(skb->data + l4_off);
+				ccmni_dbg_tcp_header(md_id, tx, tcph);
+			}
+		}
+	}
+}
+
+/* The device level counters are shared by all instances of a net_device. */
+static struct ccmni_stats *ccmni_inst_stats(struct ccmni_instance *ccmni)
+{
+	struct ccmni_instance *dev_inst;
+
+	dev_inst = ccmni->dev ? netdev_priv(ccmni->dev) : ccmni;
+	return &dev_inst->stats;
+}
+
+static void ccmni_rx_drop(struct ccmni_instance *ccmni, struct sk_buff *skb,
+			  const char *why)
+{
+	atomic64_inc(&ccmni_inst_stats(ccmni)->rx_dropped);
+	CCMNI_DBG_MSG(ccmni->md_id, "CCMNI%d drop rx skb: %s\n", ccmni->index, why);
+	kfree_skb(skb);
+}
+
+/********************ccmni debug function*********************/
+/* ccmni.c:987-990 */
+static void ccmni_dump_rx_status(int md_id, int rx_ch,
+				 unsigned long long *status)
+{
+	memcpy(status, net_rx_delay, sizeof(net_rx_delay));
+}
+
+/*
+ * ccmni.c:958-985.  Downstream prints to the kernel log from the core dump
+ * path; the same line is rendered into the debugfs file here.
+ */
+static void ccmni_dump(struct seq_file *m, int md_id, int ccmni_idx,
+		       unsigned int flag)
+{
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[md_id];
+	struct ccmni_instance *ccmni_tmp, *ccmni;
+	struct ccmni_stats *st;
+	struct netdev_queue *dev_queue;
+	struct net_device *dev;
+	u64 rx_packets, tx_packets;
+
+	if (!ctlb || ccmni_idx < 0 || ccmni_idx >= CCMNI_MAX_INST)
+		return;
+
+	ccmni_tmp = ctlb->ccmni_inst[ccmni_idx];
+	if (unlikely(!ccmni_tmp || !ccmni_tmp->dev))
+		return;
+
+	/* ccmni.c:973-974: nothing to report before the first packet */
+	st = ccmni_inst_stats(ccmni_tmp);
+	rx_packets = atomic64_read(&st->rx_packets);
+	tx_packets = atomic64_read(&st->tx_packets);
+	if (!rx_packets && !tx_packets)
+		return;
+
+	dev = ccmni_tmp->dev;
+	/* ccmni differs from ccmni_tmp for MD IRAT */
+	ccmni = netdev_priv(dev);
+	dev_queue = netdev_get_tx_queue(dev, 0);
+	seq_printf(m,
+		   "%s(%d,%d), irat_md=MD%d, rx=(%llu,%llu), tx=(%llu,%llu), txq_len=%u, tx_busy=%lu, dev_sta=(%d,%d,%d)\n",
+		   dev->name, atomic_read(&ccmni->usage),
+		   atomic_read(&ccmni_tmp->usage), ccmni->md_id + 1,
+		   rx_packets, atomic64_read(&st->rx_bytes), tx_packets,
+		   atomic64_read(&st->tx_bytes),
+		   dev->qdisc ? qdisc_qlen(dev->qdisc) : 0, ccmni->tx_busy_cnt,
+		   netif_running(dev), netif_carrier_ok(dev),
+		   netif_tx_queue_stopped(dev_queue));
+
+	if (flag & CCMNI_DBG_LEVEL_1) {
+		seq_printf(m,
+			   "  seq: rx=%u tx=[%u,%u] dropped(rx=%llu,tx=%llu) errors=%llu\n",
+			   ccmni->rx_seq_num, ccmni->tx_seq_num[CCMNI_TXQ_NORMAL],
+			   ccmni->tx_seq_num[CCMNI_TXQ_FAST],
+			   atomic64_read(&st->rx_dropped),
+			   atomic64_read(&st->tx_dropped),
+			   atomic64_read(&st->tx_errors));
+	}
+}
+
+/********************debugfs*********************/
+#define CCMNI_DBG_KEY(md, idx)	((void *)(unsigned long)(((md) << 8) | (idx)))
+
+static struct ccmni_instance *ccmni_dbg_lookup(void *key, int *md_id,
+					       int *idx)
+{
+	unsigned long v = (unsigned long)key;
+	struct ccmni_ctl_block *ctlb;
+
+	*md_id = (v >> 8) & 0xf;
+	*idx = v & 0xff;
+	if (*md_id >= CCCI_MAX_MD_NUM || *idx >= CCMNI_MAX_INST)
+		return NULL;
+	ctlb = ccmni_ctl_blk[*md_id];
+	if (!ctlb)
+		return NULL;
+	return ctlb->ccmni_inst[*idx];
+}
+
+static int ccmni_stats_show(struct seq_file *m, void *v)
+{
+	struct ccmni_instance *ccmni;
+	struct ccmni_stats *st;
+	struct net_device *dev;
+	int md_id, idx;
+
+	ccmni = ccmni_dbg_lookup(m->private, &md_id, &idx);
+	if (!ccmni || !ccmni->dev)
+		return -ENODEV;
+
+	dev = ccmni->dev;
+	st = ccmni_inst_stats(ccmni);
+	seq_printf(m, "md=%d idx=%d dev=%s mtu=%u usage=%d txq=%u\n",
+		   md_id + 1, idx, dev->name, dev->mtu,
+		   atomic_read(&ccmni->usage), dev->real_num_tx_queues);
+	seq_printf(m, "rx_packets=%llu rx_bytes=%llu rx_dropped=%llu\n",
+		   atomic64_read(&st->rx_packets),
+		   atomic64_read(&st->rx_bytes),
+		   atomic64_read(&st->rx_dropped));
+	seq_printf(m, "tx_packets=%llu tx_bytes=%llu tx_dropped=%llu tx_errors=%llu tx_busy=%lu\n",
+		   atomic64_read(&st->tx_packets),
+		   atomic64_read(&st->tx_bytes),
+		   atomic64_read(&st->tx_dropped),
+		   atomic64_read(&st->tx_errors), ccmni->tx_busy_cnt);
+	seq_printf(m, "seq: rx=%u tx_normal=%u tx_fast=%u ch=(rx=%d tx=%d dl_ack=%d)\n",
+		   ccmni->rx_seq_num, ccmni->tx_seq_num[CCMNI_TXQ_NORMAL],
+		   ccmni->tx_seq_num[CCMNI_TXQ_FAST], ccmni->ch.rx,
+		   ccmni->ch.tx, ccmni->ch.dl_ack);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ccmni_stats);
+
+static int ccmni_dump_show(struct seq_file *m, void *v)
+{
+	int md_id, idx;
+
+	if (!ccmni_dbg_lookup(m->private, &md_id, &idx))
+		return -ENODEV;
+	ccmni_dump(m, md_id, idx, CCMNI_DBG_LEVEL_1);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ccmni_dump);
+
+static int ccmni_rx_status_show(struct seq_file *m, void *v)
+{
+	unsigned long long status[4];
+	struct ccmni_instance *ccmni;
+	int md_id, idx;
+	int i;
+
+	ccmni = ccmni_dbg_lookup(m->private, &md_id, &idx);
+	if (!ccmni)
+		return -ENODEV;
+
+	ccmni_dump_rx_status(md_id, ccmni->ch.rx, status);
+	for (i = 0; i < ARRAY_SIZE(status); i++)
+		seq_printf(m, "net_rx_delay[%d]=%llu\n", i, status[i]);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ccmni_rx_status);
+
+static void ccmni_dbg_add_instance(struct ccmni_ctl_block *ctlb, int md_id,
+				   int idx)
+{
+	struct dentry *dir;
+	char name[16];
+
+	if (!ctlb->dbg_dir)
+		return;
+
+	snprintf(name, sizeof(name), "ccmni%d", idx);
+	dir = debugfs_create_dir(name, ctlb->dbg_dir);
+	if (IS_ERR(dir))
+		return;
+
+	debugfs_create_file("stats", 0444, dir, CCMNI_DBG_KEY(md_id, idx),
+			    &ccmni_stats_fops);
+	debugfs_create_file("dump", 0444, dir, CCMNI_DBG_KEY(md_id, idx),
+			    &ccmni_dump_fops);
+	debugfs_create_file("rx_status", 0444, dir,
+			    CCMNI_DBG_KEY(md_id, idx), &ccmni_rx_status_fops);
+}
+
+/* ccmni debug sys file create, ccmni.c:204-234 */
+static int ccmni_debug_file_init(int md_id)
+{
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[md_id];
+	struct dentry *dentry;
+	char fname[16];
+
+	CCMNI_INF_MSG(md_id, "ccmni_debug_file_init\n");
+
+	if (!ccmni_debugfs_root) {
+		ccmni_debugfs_root = debugfs_create_dir("ccmni", NULL);
+		if (IS_ERR(ccmni_debugfs_root)) {
+			int ret = PTR_ERR(ccmni_debugfs_root);
+
+			ccmni_debugfs_root = NULL;
+			CCMNI_ERR_MSG(md_id, "create /debugfs/ccmni fail: %d\n",
+				      ret);
+			return ret;
+		}
+	}
+
+	snprintf(fname, sizeof(fname), "md%d", md_id + 1);
+	dentry = debugfs_create_dir(fname, ccmni_debugfs_root);
+	if (IS_ERR(dentry)) {
+		CCMNI_ERR_MSG(md_id, "create /debugfs/ccmni/md%d fail\n",
+			      md_id + 1);
+		return PTR_ERR(dentry);
+	}
+	ctlb->dbg_dir = dentry;
+
+	debugfs_create_u32("debug_level", 0600, dentry, &ccmni_debug_level);
+	return 0;
+}
