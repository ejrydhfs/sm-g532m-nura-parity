new file mode 100644
index 000000000..d6cec02e8
--- /dev/null
+++ b/drivers/net/ccmni/ccmni.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel:
+ *   drivers/misc/mediatek/ccmni/ccmni.h
+ *   drivers/misc/mediatek/ccmni/ccmni.c
+ *
+ * The constants below are verbatim from the downstream header; the kernel
+ * facing interface (struct ccmni_ch, struct ccmni_ccci_ops and the four
+ * entry points) lives in <linux/ccci.h>.
+ */
+#ifndef __CCMNI_H__
+#define __CCMNI_H__
+
+#include <linux/kernel.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <linux/atomic.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <linux/debugfs.h>
+
+#include <linux/ccci.h>
+
+#define CCMNI_MTU		1500		/* ccmni.h:36 */
+#define CCMNI_TX_QUEUE		1000		/* ccmni.h:37 */
+#define CCMNI_NETDEV_WDT_TO	(1 * HZ)	/* ccmni.h:38 */
+
+#define IPV4_VERSION		0x40		/* ccmni.h:40 */
+#define IPV6_VERSION		0x60		/* ccmni.h:41 */
+
+/* ccmni.h:43-44 */
+#define SIOCSTXQSTATE		(SIOCDEVPRIVATE + 0)	/* stop/start tx queue */
+#define SIOCCCMNICFG		(SIOCDEVPRIVATE + 1)	/* ccmni/md remapping */
+
+/* ccmni.h:113-118 */
+enum ccmni_ch_id {
+	CCMNI_RX_CH = 0,
+	CCMNI_RX_ACK_CH = 1,
+	CCMNI_TX_CH = 2,
+	CCMNI_TX_ACK_CH = 3,
+};
+
+/* ccmni.h:120-125 */
+enum ccmni_errno {
+	CCMNI_ERR_TX_OK = 0,		/* ccci send pkt success */
+	CCMNI_ERR_TX_BUSY = -1,		/* ccci tx packet buffer full and tx fail */
+	CCMNI_ERR_MD_NO_READY = -2,	/* modem not ready and tx fail */
+	CCMNI_ERR_TX_INVAL = -3,	/* ccmni parameter error */
+};
+
+/* ccmni.h:127-134 */
+enum ccmni_dbg_level {
+	CCMNI_DBG_LEVEL_1 = (1 << 0),
+	CCMNI_DBG_LEVEL_TX = (1 << 1),
+	CCMNI_DBG_LEVEL_RX = (1 << 2),
+	CCMNI_DBG_LEVEL_ACK_SKB = (1 << 3),
+	CCMNI_DBG_LEVEL_TX_SKB = (1 << 4),
+	CCMNI_DBG_LEVEL_RX_SKB = (1 << 5),
+};
+
+/* ccmni.h:136-141 - must match the alloc_netdev_mqs() queue count. */
+enum ccmni_txq_no {
+	CCMNI_TXQ_NORMAL = 0,
+	CCMNI_TXQ_FAST = 1,
+	CCMNI_TXQ_NUM,
+	CCMNI_TXQ_END = CCMNI_TXQ_NUM,
+};
+
+#define CCMNI_MAX_INST	16		/* ccmni.h:89, ccmni_inst[16] */
+
+/*
+ * Per-instance statistics.  Downstream keeps them in dev->stats; modern
+ * drivers use ndo_get_stats64(), so the counters are kept here and exported
+ * through that callback as well as through debugfs.
+ */
+struct ccmni_stats {
+	atomic64_t	rx_packets;
+	atomic64_t	rx_bytes;
+	atomic64_t	rx_dropped;
+	atomic64_t	tx_packets;
+	atomic64_t	tx_bytes;
+	atomic64_t	tx_dropped;
+	atomic64_t	tx_errors;
+};
+
+/*
+ * Ported from ccmni.h:57-73 (struct ccmni_instance).
+ *
+ * A ccmni_instance is either embedded in a net_device (netdev_priv(), the
+ * usual case) or heap allocated for the iRAT peer modem, in which case it
+ * only carries routing/statistics state and shares the net_device of the
+ * source modem.  @owns_dev tells ccmni_exit() whether the instance created
+ * the net_device; @heap tells it whether the instance itself has to be freed.
+ */
+struct ccmni_instance {
+	int			index;
+	int			md_id;
+	struct ccmni_ch		ch;
+	int			net_if_off;
+	atomic_t		usage;
+	struct timer_list	timer;
+	struct net_device	*dev;
+	struct napi_struct	napi;
+	unsigned int		rx_seq_num;
+	unsigned int		tx_seq_num[CCMNI_TXQ_NUM];
+	unsigned long		flags;
+	spinlock_t		spinlock;
+	struct ccmni_ctl_block	*ctlb;
+	unsigned long		tx_busy_cnt;
+	struct ccmni_stats	stats;
+	bool			owns_dev;
+	bool			heap;
+};
+
+/*
+ * Ported from ccmni.h:87-93 (struct ccmni_ctl_block) and extended with the
+ * per-MD net_device table so that iRAT peers can share a device without
+ * copying the private structure around (see ccmni_siocdevprivate()).
+ */
+struct ccmni_ctl_block {
+	struct ccmni_ccci_ops	*ccci_ops;
+	struct ccmni_instance	*ccmni_inst[CCMNI_MAX_INST];
+	struct net_device	*netdev[CCMNI_MAX_INST];
+	unsigned int		md_sta;
+	bool			md_sta_reported;
+	struct wakeup_source	*ccmni_wakelock;
+	char			wakelock_name[16];
+	struct dentry		*dbg_dir;
+};
+
+/* ccmni.h:153-160 */
+#define CCMNI_DBG_MSG(idx, fmt, args...)				\
+do {									\
+	if (ccmni_debug_level & CCMNI_DBG_LEVEL_1)			\
+		pr_debug("[ccci%d/net]" fmt, (idx) + 1, ##args);		\
+} while (0)
+
+#define CCMNI_INF_MSG(idx, fmt, args...)				\
+	pr_debug("[ccci%d/net]" fmt, (idx) + 1, ##args)
+
+#define CCMNI_ERR_MSG(idx, fmt, args...)				\
+	pr_err("[ccci%d/net][Error:%d]%s:" fmt, (idx) + 1, __LINE__,	\
+	       __func__, ##args)
+
+#endif /* __CCMNI_H__ */
diff --git a/include/linux/ccci.h b/include/linux/ccci.h
new file mode 100644
index 000000000..d5bc2b4af
--- /dev/null
