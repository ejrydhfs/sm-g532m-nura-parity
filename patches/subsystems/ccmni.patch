+/* ccmni.c:546-558 */
+static int ccmni_napi_poll(struct napi_struct *napi, int budget)
+{
+	struct ccmni_instance *ccmni = netdev_priv(napi->dev);
+	int md_id = ccmni->md_id;
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[md_id];
+
+	timer_delete(&ccmni->timer);
+
+	if (ctlb && ctlb->ccci_ops && ctlb->ccci_ops->napi_poll)
+		return ctlb->ccci_ops->napi_poll(md_id, ccmni->ch.rx, napi,
+						 budget);
+	return 0;
+}
+
+/* ccmni.c:560-565 */
+static void ccmni_napi_poll_timeout(struct timer_list *t)
+{
+	struct ccmni_instance *ccmni = container_of(t, struct ccmni_instance,
+						  timer);
+
+	CCMNI_ERR_MSG(ccmni->md_id, "CCMNI%d lost NAPI polling\n", ccmni->index);
+}
+
+/********************ccmni driver register ccci function********************/
+/* ccmni.c:569-592 */
+static int ccmni_inst_init(int md_id, struct ccmni_instance *ccmni,
+			   struct net_device *dev, bool owns_dev)
+{
+	struct ccmni_ctl_block *ctlb = ccmni_ctl_blk[md_id];
+	int ret;
+
+	ret = ctlb->ccci_ops->get_ccmni_ch(md_id, ccmni->index, &ccmni->ch);
+	if (ret)
+		return ret;
+
+	ccmni->dev = dev;
+	ccmni->ctlb = ctlb;
+	ccmni->md_id = md_id;
+	ccmni->owns_dev = owns_dev;
+	atomic_set(&ccmni->usage, 0);
+	spin_lock_init(&ccmni->spinlock);
+
+	if (dev && owns_dev && (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI)) {
+		unsigned int weight = ctlb->ccci_ops->napi_poll_weigh;
+
+		timer_setup(&ccmni->timer, ccmni_napi_poll_timeout, 0);
+		/* downstream passes 0 for cc3mni; NAPI requires weight >= 1 */
+		if (!weight)
+			weight = NAPI_POLL_WEIGHT;
+		netif_napi_add_weight(dev, &ccmni->napi, ccmni_napi_poll,
+				      weight);
+	}
+
+	return 0;
+}
+
+/* ccmni is an Ethernet framing device with no ARP; reuse ether_setup(). */
+static void ccmni_netdev_setup(struct net_device *dev)
+{
+	ether_setup(dev);
+}
+
+/* ccmni.c:594-781 */
+int ccmni_init(int md_id, struct ccmni_ccci_ops *ccci_info)
+{
+	struct ccmni_ctl_block *ctlb = NULL;
+	struct ccmni_ctl_block *ctlb_irat_src = NULL;
+	struct ccmni_instance *ccmni = NULL;
+	struct ccmni_instance *ccmni_irat;
+	struct ccmni_instance *ccmni_src;
+	struct net_device *dev = NULL;
+	struct ccmni_ccci_ops *ops;
+	char name[IFNAMSIZ];
+	int i, ret = 0;
+
+	if (!ccci_info || md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return -EINVAL;
+
+	if (unlikely(ccci_info->md_ability & CCCI_MD_CAP_CCMNI_DISABLE)) {
+		CCMNI_ERR_MSG(md_id, "no need init ccmni: md_ability=0x%08X\n",
+			      ccci_info->md_ability);
+		return 0;
+	}
+
+	if (ccmni_ctl_blk[md_id]) {
+		CCMNI_ERR_MSG(md_id, "ccmni already initialised for MD%d\n",
+			      md_id + 1);
+		return -EBUSY;
+	}
+
+	if (ccci_info->ccmni_num <= 0 || ccci_info->ccmni_num > CCMNI_MAX_INST) {
+		CCMNI_ERR_MSG(md_id, "invalid ccmni_num=%d\n",
+			      ccci_info->ccmni_num);
+		return -EINVAL;
+	}
+
+	ctlb = kzalloc(sizeof(*ctlb), GFP_KERNEL);
+	if (unlikely(!ctlb)) {
+		CCMNI_ERR_MSG(md_id, "alloc ccmni ctl struct fail\n");
+		return -ENOMEM;
+	}
+
+	ctlb->ccci_ops = kmemdup(ccci_info, sizeof(*ccci_info), GFP_KERNEL);
+	if (unlikely(!ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(md_id, "alloc ccmni_ccci_ops struct fail\n");
+		kfree(ctlb);
+		return -ENOMEM;
+	}
+
+	ccmni_ctl_blk[md_id] = ctlb;
+	ops = ctlb->ccci_ops;
+
+	CCMNI_INF_MSG(md_id,
+		      "ccmni_init: ccmni_num=%d, md_ability=0x%08x, irat_en=%08x, irat_md_id=%d, send_pkt=%p, get_ccmni_ch=%p, name=%s\n",
+		      ops->ccmni_num, ops->md_ability,
+		      (ops->md_ability & CCCI_MD_CAP_CCMNI_IRAT),
+		      (int)ops->irat_md_id, ops->send_pkt, ops->get_ccmni_ch,
+		      ops->name);
+
+	ccmni_debug_file_init(md_id);
+
+	/*
+	 * ccmni.c:634-636: plain modems, and the world-phone variant, get
+	 * netdevices of their own.  A pure iRAT modem reuses the peer's
+	 * devices instead (handled below).
+	 */
+	if (!(ops->md_ability & CCCI_MD_CAP_CCMNI_IRAT) ||
+	    (ops->md_ability & CCCI_MD_CAP_WORLD_PHONE)) {
+		for (i = 0; i < ops->ccmni_num; i++) {
+			unsigned int txqs;
+
+			/* MQ: two tx queues (normal/ack), one rx queue */
+			txqs = (ops->md_ability & CCCI_MD_CAP_CCMNI_MQ) ?
+				CCMNI_TXQ_NUM : 1;
+			snprintf(name, sizeof(name), "%s%d", ops->name, i);
+
+			dev = alloc_netdev_mqs(sizeof(struct ccmni_instance),
+					       name, NET_NAME_PREDICTABLE,
+					       ccmni_netdev_setup, txqs, 1);
+			if (unlikely(!dev)) {
+				CCMNI_ERR_MSG(md_id, "alloc netdev fail\n");
+				ret = -ENOMEM;
+				goto alloc_mem_fail;
+			}
+
+			/* ccmni.c:649-668 */
+			dev->header_ops = NULL;
+			dev->mtu = CCMNI_MTU;
+			dev->tx_queue_len = CCMNI_TX_QUEUE;
+			dev->watchdog_timeo = CCMNI_NETDEV_WDT_TO;
+			/* ccmni is a pure IP, P2P device */
+			dev->flags = IFF_NOARP;
+			dev->features |= NETIF_F_VLAN_CHALLENGED;
+			if (ops->md_ability & CCCI_MD_CAP_SGIO) {
+				dev->features |= NETIF_F_SG;
+				dev->hw_features |= NETIF_F_SG;
+			}
+			dev->addr_len = ETH_ALEN;
+			dev->needs_free_netdev = true;
+			/* reserve Tx CCCI header room */
+			dev->hard_header_len += sizeof(struct ccci_header);
+			dev->netdev_ops = &ccmni_netdev_ops;
+			eth_hw_addr_random(dev);
+
+			CCMNI_INF_MSG(md_id, "register netdev name: %s\n",
+				      dev->name);
+
+			ccmni = netdev_priv(dev);
+			ccmni->index = i;
+			ret = ccmni_inst_init(md_id, ccmni, dev, true);
+			if (ret) {
+				CCMNI_ERR_MSG(md_id,
+					      "initial ccmni instance fail: %d\n",
+					      ret);
+				free_netdev(dev);
+				dev = NULL;
+				goto alloc_mem_fail;
+			}
+
+			ret = register_netdev(dev);
+			if (ret) {
+				CCMNI_ERR_MSG(md_id,
+					      "CCMNI%d register netdev fail: %d\n",
+					      i, ret);
+				free_netdev(dev);
+				dev = NULL;
+				goto alloc_mem_fail;
+			}
+
+			ctlb->ccmni_inst[i] = ccmni;
+			ctlb->netdev[i] = dev;
+			ccmni_dbg_add_instance(ctlb, md_id, i);
+
+			CCMNI_DBG_MSG(ccmni->md_id,
+				      "CCMNI%d=%p, ctlb=%p, ctlb_ops=%p, dev=%p\n",
+				      i, ccmni, ccmni->ctlb, ccmni->ctlb->ccci_ops,
+				      ccmni->dev);
+			dev = NULL;
+		}
+	}
+
+	/* ccmni.c:692-755: reuse the iRAT source modem's net_devices. */
+	if (ops->md_ability & CCCI_MD_CAP_CCMNI_IRAT) {
+		if (ops->irat_md_id >= CCCI_MAX_MD_NUM) {
+			CCMNI_ERR_MSG(md_id,
+				      "md%d IRAT fail because invalid irat md(%d)\n",
+				      md_id + 1, (int)ops->irat_md_id);
+			ret = -EINVAL;
+			goto alloc_mem_fail;
+		}
+
+		ctlb_irat_src = ccmni_ctl_blk[ops->irat_md_id];
+		if (!ctlb_irat_src || !ctlb_irat_src->ccci_ops) {
+			CCMNI_ERR_MSG(md_id,
+				      "md%d IRAT fail because irat md%d ctlb is NULL\n",
+				      md_id + 1, (int)ops->irat_md_id);
+			ret = -EINVAL;
+			goto alloc_mem_fail;
+		}
+
+		if (unlikely(ops->ccmni_num >
+			     ctlb_irat_src->ccci_ops->ccmni_num)) {
+			CCMNI_ERR_MSG(md_id,
+				      "IRAT fail because number of src(%d) and dest(%d) ccmni isn't equal\n",
+				      ctlb_irat_src->ccci_ops->ccmni_num,
+				      ops->ccmni_num);
+			ret = -EINVAL;
+			goto alloc_mem_fail;
+		}
+
+		if (!(ops->md_ability & CCCI_MD_CAP_WORLD_PHONE)) {
+			for (i = 0; i < ops->ccmni_num; i++) {
+				ccmni_src = ctlb_irat_src->ccmni_inst[i];
+				if (unlikely(!ccmni_src || !ccmni_src->dev ||
+					     !ctlb_irat_src->netdev[i])) {
+					CCMNI_ERR_MSG(md_id,
+						      "md%d IRAT fail: md%d ccmni%d has no netdev\n",
+						      md_id + 1,
+						      (int)ops->irat_md_id + 1, i);
+					ret = -EINVAL;
+					goto alloc_mem_fail;
+				}
+
+				ccmni_irat = kzalloc(sizeof(*ccmni_irat),
+						     GFP_KERNEL);
+				if (unlikely(!ccmni_irat)) {
+					CCMNI_ERR_MSG(md_id,
+						      "alloc ccmni instance fail\n");
+					ret = -ENOMEM;
+					goto alloc_mem_fail;
+				}
+				ccmni_irat->index = i;
+				ccmni_irat->heap = true;
+				ret = ccmni_inst_init(md_id, ccmni_irat,
+						      ccmni_src->dev, false);
+				if (ret) {
+					CCMNI_ERR_MSG(md_id,
+						      "initial ccmni instance fail: %d\n",
+						      ret);
+					kfree(ccmni_irat);
+					goto alloc_mem_fail;
+				}
+				ctlb->ccmni_inst[i] = ccmni_irat;
+				ccmni_dbg_add_instance(ctlb, md_id, i);
+
+				/*
+				 * Keep a separate routing instance in the
+				 * source modem's table so that
+				 * SIOCCCMNICFG()/SIOCSTXQSTATE() can address
+				 * the two modems independently, like
+				 * ccmni.c:750-751 does with a full memcpy().
+				 * The net_device stays owned by the source
+				 * modem (ctlb_irat_src->netdev[i]).
+				 */
+				if (!ccmni_src->heap) {
+					struct ccmni_instance *ccmni_dup;
+
+					ccmni_dup = kzalloc(sizeof(*ccmni_dup),
+							    GFP_KERNEL);
+					if (unlikely(!ccmni_dup)) {
+						CCMNI_ERR_MSG(md_id,
+							      "alloc ccmni_irat instance fail\n");
+						ret = -ENOMEM;
+						goto alloc_mem_fail;
+					}
+					ccmni_dup->index = i;
+					ccmni_dup->md_id = ccmni_src->md_id;
+					ccmni_dup->ctlb = ccmni_src->ctlb;
+					ccmni_dup->dev = ccmni_src->dev;
+					ccmni_dup->ch = ccmni_src->ch;
+					ccmni_dup->heap = true;
+					atomic_set(&ccmni_dup->usage,
+						   atomic_read(&ccmni_src->usage));
+					spin_lock_init(&ccmni_dup->spinlock);
+					ctlb_irat_src->ccmni_inst[i] = ccmni_dup;
+				}
+			}
+		}
+	}
+
+	snprintf(ctlb->wakelock_name, sizeof(ctlb->wakelock_name),
+		 "ccmni_md%d", md_id + 1);
+	ctlb->ccmni_wakelock = wakeup_source_register(NULL, ctlb->wakelock_name);
+	if (!ctlb->ccmni_wakelock) {
+		CCMNI_ERR_MSG(md_id, "register wakeup source fail\n");
+		ret = -ENOMEM;
+		goto alloc_mem_fail;
+	}
+
+	return 0;
+
+alloc_mem_fail:
+	ccmni_exit(md_id);
+	return ret;
+}
+
+/*
+ * An iRAT peer modem keeps instances that point at the source modem's
+ * net_device.  When the source goes away, drop those references so a late
+ * RX/state callback cannot touch a freed net_device.
+ */
+static void ccmni_unlink_shared_dev(struct ccmni_ctl_block *owner,
+				    struct net_device *dev)
+{
+	struct ccmni_ctl_block *ctlb;
+	int md, i;
+
+	for (md = 0; md < CCCI_MAX_MD_NUM; md++) {
+		ctlb = ccmni_ctl_blk[md];
+		if (!ctlb || ctlb == owner || !ctlb->ccci_ops)
+			continue;
+		for (i = 0; i < ctlb->ccci_ops->ccmni_num &&
+			    i < CCMNI_MAX_INST; i++) {
+			if (ctlb->ccmni_inst[i] &&
+			    ctlb->ccmni_inst[i]->dev == dev)
+				ctlb->ccmni_inst[i]->dev = NULL;
+		}
+	}
+}
+
+/* ccmni.c:783-812 */
+void ccmni_exit(int md_id)
+{
+	struct ccmni_ctl_block *ctlb;
+	struct ccmni_instance *ccmni;
+	int i;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return;
+
+	CCMNI_INF_MSG(md_id, "ccmni_exit\n");
+
+	ctlb = ccmni_ctl_blk[md_id];
+	if (!ctlb)
+		return;
+
+	if (ctlb->ccci_ops) {
+		for (i = 0; i < ctlb->ccci_ops->ccmni_num && i < CCMNI_MAX_INST;
+		     i++) {
+			bool heap;
+
+			ccmni = ctlb->ccmni_inst[i];
+			heap = ccmni && ccmni->heap;
+
+			/*
+			 * unregister_netdev() frees the net_device and the
+			 * instance embedded in it, so evaluate ->heap first.
+			 */
+			if (ctlb->netdev[i]) {
+				CCMNI_INF_MSG(md_id,
+					      "ccmni_exit: unregister ccmni%d dev\n",
+					      i);
+				ccmni_unlink_shared_dev(ctlb, ctlb->netdev[i]);
+				unregister_netdev(ctlb->netdev[i]);
+				ctlb->netdev[i] = NULL;
+			}
+			if (heap)
+				kfree(ccmni);
+			ctlb->ccmni_inst[i] = NULL;
+		}
+
+		debugfs_remove_recursive(ctlb->dbg_dir);
+		ctlb->dbg_dir = NULL;
+		if (ctlb->ccmni_wakelock)
+			wakeup_source_unregister(ctlb->ccmni_wakelock);
+		ctlb->ccmni_wakelock = NULL;
+		kfree(ctlb->ccci_ops);
+		ctlb->ccci_ops = NULL;
+	}
+
+	kfree(ctlb);
+	ccmni_ctl_blk[md_id] = NULL;
+}
+
+/* ccmni.c:814-882 */
+int ccmni_rx_callback(int md_id, int ccmni_idx, struct sk_buff *skb)
+{
+	struct ccmni_ctl_block *ctlb;
+	struct ccmni_instance *ccmni;
+	struct ccmni_stats *st;
+	struct net_device *dev;
+	unsigned int pkt_type;
+	int skb_len;
+	u64 t0;
+
+	if (unlikely(!skb))
+		return -EINVAL;
+
+	if (unlikely(md_id < 0 || md_id >= CCCI_MAX_MD_NUM ||
+		     ccmni_idx < 0 || ccmni_idx >= CCMNI_MAX_INST)) {
+		CCMNI_ERR_MSG(md_id, "invalid CCMNI%d ctrl/ops struct\n",
+			      ccmni_idx);
+		consume_skb(skb);
+		return -EINVAL;
+	}
+
+	ctlb = ccmni_ctl_blk[md_id];
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(md_id, "invalid CCMNI%d ctrl/ops struct\n",
+			      ccmni_idx);
+		consume_skb(skb);
+		return -EINVAL;
+	}
+
+	ccmni = ctlb->ccmni_inst[ccmni_idx];
+	if (unlikely(!ccmni || !ccmni->dev)) {
+		CCMNI_ERR_MSG(md_id, "invalid CCMNI%d instance\n", ccmni_idx);
+		consume_skb(skb);
+		return -EINVAL;
+	}
+
+	/*
+	 * Drop while the core reports the modem as down.  Until the first
+	 * state notification the transport itself is the gatekeeper (as in
+	 * downstream), so packets are not discarded.
+	 */
+	if (unlikely(ctlb->md_sta_reported &&
+		     ctlb->md_sta != CCCI_MD_READY)) {
+		ccmni_rx_drop(ccmni, skb, "modem not ready");
+		return -EAGAIN;
+	}
+
+	dev = ccmni->dev;
+
+	if (unlikely(skb->len < 1)) {
+		ccmni_rx_drop(ccmni, skb, "empty skb");
+		return -EINVAL;
+	}
+
+	/*
+	 * Downstream assumes the CLDMA RX path left ETH_HLEN of headroom and
+	 * writes the Ethernet header at skb->data - ETH_HLEN (ccmni.c:833).
+	 * Expand instead of writing out of bounds when that is not the case.
+	 */
+	if (unlikely(skb_headroom(skb) < ETH_HLEN)) {
+		if (pskb_expand_head(skb, ETH_HLEN, 0, GFP_ATOMIC)) {
+			ccmni_rx_drop(ccmni, skb, "no headroom");
+			return -ENOMEM;
+		}
+	}
+
+	pkt_type = skb->data[0] & 0xF0;
+	ccmni_make_etherframe(skb->data - ETH_HLEN, dev->dev_addr, pkt_type);
+	skb_set_mac_header(skb, -ETH_HLEN);
+	skb->dev = dev;
+	if (pkt_type == IPV6_VERSION)
+		skb->protocol = htons(ETH_P_IPV6);
+	else
+		skb->protocol = htons(ETH_P_IP);
+	skb->ip_summed = CHECKSUM_NONE;
+	skb_len = skb->len;
+
+	if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_RX))
+		CCMNI_INF_MSG(md_id, "[RX]CCMNI%d recv data_len=%d\n",
+			      ccmni_idx, skb->len);
+
+	if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_RX_SKB))
+		ccmni_dbg_skb_header(ccmni->md_id, false, skb);
+
+	if (skb->protocol == htons(ETH_P_IP) &&
+	    skb->len >= sizeof(struct iphdr))
+		net_rx_delay[2] = ntohs(((struct iphdr *)skb->data)->id);
+
+	/*
+	 * ccmni.c:862-869: with MODEM_CAP_NAPI the skb is delivered straight
+	 * to the stack (the core schedules the NAPI instance and calls
+	 * ->napi_poll() through this driver); otherwise it goes through the
+	 * backlog.  netif_rx_ni() no longer exists, netif_rx() works from
+	 * both process and interrupt context.
+	 */
+	t0 = sched_clock();
+	if (likely(ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI))
+		netif_receive_skb(skb);
+	else
+		netif_rx(skb);
+
+	st = ccmni_inst_stats(ccmni);
+	atomic64_inc(&st->rx_packets);
+	atomic64_add(skb_len, &st->rx_bytes);
+	net_rx_delay[3] = sched_clock() - t0;
+	net_rx_delay[0] = atomic64_read(&st->rx_bytes) -
+			  40 * atomic64_read(&st->rx_packets);
+	net_rx_delay[1] = atomic64_read(&st->tx_bytes) -
+			  40 * atomic64_read(&st->tx_packets);
+
+	if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_SEQNO)
+		ccmni->rx_seq_num++;
+
+	if (ctlb->ccmni_wakelock)
+		__pm_wakeup_event(ctlb->ccmni_wakelock,
+				  jiffies_to_msecs(HZ));
+
+	return 0;
+}
+
+/* ccmni.c:884-956 */
+void ccmni_md_state_callback(int md_id, int ccmni_idx,
+			     enum ccci_md_state state)
+{
+	struct ccmni_ctl_block *ctlb;
+	struct ccmni_instance *ccmni;
+	struct ccmni_instance *dev_inst;
+	struct net_device *dev;
+
+	if (md_id < 0 || md_id >= CCCI_MAX_MD_NUM)
+		return;
+
+	ctlb = ccmni_ctl_blk[md_id];
+	if (unlikely(!ctlb || !ctlb->ccci_ops)) {
+		CCMNI_ERR_MSG(md_id,
+			      "invalid ccmni ctrl struct when ccmni_idx=%d md_sta=%d\n",
+			      ccmni_idx, state);
+		return;
+	}
+	if (ccmni_idx < 0 || ccmni_idx >= CCMNI_MAX_INST ||
+	    !ctlb->ccmni_inst[ccmni_idx]) {
+		CCMNI_ERR_MSG(md_id, "invalid ccmni_idx=%d md_sta=%d\n",
+			      ccmni_idx, state);
+		return;
+	}
+
+	ccmni = ctlb->ccmni_inst[ccmni_idx];
+	dev = ccmni->dev;
+	if (unlikely(!dev))
+		return;
+	dev_inst = netdev_priv(dev);
+
+	CCMNI_INF_MSG(md_id, "md_state_cb: CCMNI%d, md_sta=%d, usage=%d\n",
+		      ccmni_idx, state, atomic_read(&ccmni->usage));
+
+	ctlb->md_sta = state;
+	ctlb->md_sta_reported = true;
+
+	switch (state) {
+	case CCCI_MD_READY:
+		netif_carrier_on(dev);
+		/* ccmni.c:904-907 */
+		ccmni->tx_seq_num[CCMNI_TXQ_NORMAL] = 0;
+		ccmni->tx_seq_num[CCMNI_TXQ_FAST] = 0;
+		ccmni->rx_seq_num = 0;
+		ccmni->tx_busy_cnt = 0;
+
+		if (ctlb->ccci_ops->md_ability & CCCI_MD_CAP_CCMNI_MQ)
+			netif_tx_wake_all_queues(dev);
+		else
+			netif_wake_queue(dev);
+
+		if ((ctlb->ccci_ops->md_ability & CCCI_MD_CAP_NAPI) &&
+		    dev_inst->napi.dev && netif_running(dev))
+			napi_schedule(&dev_inst->napi);
+		break;
+
+	case CCCI_MD_EXCEPTION:
+	case CCCI_MD_STOPPED:
+		/* ccmni.c:910-913; NAPI stays enabled (ndo_stop owns it), RX
+		 * is gated by the state check in ccmni_rx_callback(). */
+		netif_carrier_off(dev);
+		netif_tx_stop_all_queues(dev);
+		break;
+
+	case CCCI_MD_BOOTING:
+	case CCCI_MD_INVALID:
+	default:
+		netif_carrier_off(dev);
+		netif_tx_stop_all_queues(dev);
+		break;
+	}
+}
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("MediaTek CCMNI modem network interface (CCCI v0)");
