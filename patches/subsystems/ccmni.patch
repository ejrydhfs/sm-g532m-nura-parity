+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Cross Chip Modem Network Interface (CCMNI), driver version 0.
+ *
+ * Ported from the Samsung/MTK 3.18 downstream kernel (GPL-2.0):
+ *   drivers/misc/mediatek/ccmni/ccmni.c   (behavioural reference)
+ *   drivers/misc/mediatek/ccmni/ccmni.h   (constants/private structures)
+ *   drivers/misc/mediatek/eccci/port_net.c (v0 "CCMNI_U" glue: channel
+ *                                          mapping, TX-ACK split, NAPI)
+ *
+ * Protocol, channel numbers, state machine and the Ethernet frame that the
+ * modem expects are kept identical; only the kernel API usage is modernised
+ * (ndo_get_stats64, timer_setup, netif_napi_add_weight, wakeup_source,
+ * ndo_siocdevprivate, netif_rx instead of netif_rx_ni).
+ *
+ * RX skbs handed to ccmni_rx_callback() already have the CCCI header pulled
+ * (downstream port_net_recv_skb() does that before calling
+ * ccmni_ops.rx_callback()); skb->data therefore points at the IP header and
+ * ETH_HLEN bytes of headroom must exist for the synthetic Ethernet header.
+ */
+
+#define pr_fmt(fmt) "ccmni: " fmt
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+#include <linux/skbuff.h>
+#include <linux/ip.h>
+#include <linux/tcp.h>
+#include <linux/ipv6.h>
+#include <linux/if_ether.h>
+#include <linux/if.h>
+#include <linux/sockios.h>
+#include <linux/timer.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include <linux/atomic.h>
+#include <linux/pm_wakeup.h>
+#include <linux/delay.h>
+#include <linux/sched/clock.h>
+#include <net/ipv6.h>
+#include <net/sch_generic.h>
+
+#include <linux/ccci.h>
+
+#include "ccmni.h"
+
+/* ccmni.c:51-53 */
+static struct ccmni_ctl_block *ccmni_ctl_blk[CCCI_MAX_MD_NUM];
+static unsigned int ccmni_debug_level;
+
+/*
+ * Downstream keeps a scheduler-clock profile in net_rx_delay[] and exports it
+ * through ccmni_dump_rx_status().  It is only filled in when the (disabled by
+ * default) CCCI_SKB_TRACE build option is set; the same four slots are
+ * maintained here unconditionally so the debugfs file has parity.
+ */
+static u64 net_rx_delay[4];
+
+static struct dentry *ccmni_debugfs_root;
+
+static void ccmni_make_etherframe(void *_eth_hdr, const unsigned char *mac_addr,
+				  unsigned int packet_type)
+{
+	struct ethhdr *eth_hdr = _eth_hdr;
+
+	memcpy(eth_hdr->h_dest, mac_addr, sizeof(eth_hdr->h_dest));
+	memset(eth_hdr->h_source, 0, sizeof(eth_hdr->h_source));
+	if (packet_type == IPV6_VERSION)
+		eth_hdr->h_proto = cpu_to_be16(ETH_P_IPV6);
+	else
+		eth_hdr->h_proto = cpu_to_be16(ETH_P_IP);
+}
+
+/*
+ * TCP ACK detector, ccmni.c:67-121.  Used both by ccmni_select_queue() and by
+ * the TX-ACK split in ccmni_start_xmit().  The explicit length checks are
+ * modern hardening of the downstream code, which reads the headers blindly.
+ */
+static int is_ack_skb(int md_id, struct sk_buff *skb)
+{
+	u32 packet_type;
+	int ret = 0;
+
+	if (unlikely(!skb->len))
+		return 0;
+
+	packet_type = skb->data[0] & 0xF0;
+	if (packet_type == IPV6_VERSION) {
+		struct ipv6hdr *iph = (struct ipv6hdr *)skb->data;
+		__be16 frag_off;
+		struct tcphdr *tcph;
+		u8 nexthdr;
+		u32 total_len;
+		int l4_off;
+
+		if (skb->len < sizeof(*iph))
+			return 0;
+
+		total_len = sizeof(*iph) + ntohs(iph->payload_len);
+		if (total_len > 128 - sizeof(struct ccci_header) ||
+		    total_len > skb->len) {
+			if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_ACK_SKB))
+				CCMNI_INF_MSG(md_id, "[SKB] ack=%d: tot_len=%u\n",
+					      ret, total_len);
+			return 0;
+		}
+
+		nexthdr = iph->nexthdr;
+		l4_off = ipv6_skip_exthdr(skb, sizeof(*iph), &nexthdr,
+					  &frag_off);
+		if (l4_off < 0 ||
+		    l4_off + (int)sizeof(*tcph) > (int)skb->len)
+			return 0;
+
+		tcph = (struct tcphdr *)(skb->data + l4_off);
+		if (nexthdr == IPPROTO_TCP && !tcph->syn && !tcph->fin &&
+		    !tcph->rst && ((total_len - l4_off) == (tcph->doff << 2)))
+			ret = 1;
+
+		if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_ACK_SKB))
+			CCMNI_INF_MSG(md_id,
+				      "[SKB] ack=%d: proto=%d syn=%d fin=%d rst=%d ack=%d tot_len=%u l4_off=%d doff=%d\n",
+				      ret, nexthdr, tcph->syn, tcph->fin,
+				      tcph->rst, tcph->ack, total_len, l4_off,
+				      tcph->doff);
+	} else if (packet_type == IPV4_VERSION) {
+		struct iphdr *iph = (struct iphdr *)skb->data;
+		struct tcphdr *tcph;
+		u16 tot_len;
+
+		if (skb->len < sizeof(*iph))
+			return 0;
+
+		tot_len = ntohs(iph->tot_len);
+		if (tot_len > 128 - sizeof(struct ccci_header) ||
+		    tot_len > skb->len) {
+			if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_ACK_SKB))
+				CCMNI_INF_MSG(md_id, "[SKB] ack=%d: tot_len=%u\n",
+					      ret, tot_len);
+			return 0;
+		}
+		if (tot_len < (iph->ihl << 2) + sizeof(*tcph))
+			return 0;
+
+		tcph = (struct tcphdr *)(skb->data + (iph->ihl << 2));
+		if (iph->protocol == IPPROTO_TCP && !tcph->syn && !tcph->fin &&
+		    !tcph->rst &&
+		    (tot_len == (iph->ihl << 2) + (tcph->doff << 2)))
+			ret = 1;
+
+		if (unlikely(ccmni_debug_level & CCMNI_DBG_LEVEL_ACK_SKB))
+			CCMNI_INF_MSG(md_id,
+				      "[SKB] ack=%d: proto=%d syn=%d fin=%d rst=%d ack=%d tot_len=%u ihl=%d doff=%d\n",
+				      ret, iph->protocol, tcph->syn, tcph->fin,
+				      tcph->rst, tcph->ack, tot_len, iph->ihl,
+				      tcph->doff);
+	}
+
+	return ret;
+}
