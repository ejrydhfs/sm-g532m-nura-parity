+static int mt6331_dac_event(struct snd_soc_dapm_widget *w,
+			    struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *cmpnt = snd_soc_dapm_to_component(w->dapm);
+	struct mt6331_priv *priv = snd_soc_component_get_drvdata(cmpnt);
+	int ret = 0;
+
+	mutex_lock(&priv->ana_lock);
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		ret = mt6331_dl_power_up(priv);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		ret = mt6331_dl_power_down(priv);
+		break;
+	}
+	mutex_unlock(&priv->ana_lock);
+
+	return ret;
+}
