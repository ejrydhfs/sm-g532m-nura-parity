+static bool mt6735_afe_volatile_reg(struct device *dev, unsigned int reg)
+{
+	switch (reg) {
+	case AFE_DL1_CUR:
+	case AFE_DL2_CUR:
+	case AFE_VUL_CUR:
+	case AFE_IRQ_MCU_STATUS:
+	case AFE_IRQ_MCU_CLR:
+	case AFE_IRQ_MCU_CNT1:
+	case AFE_IRQ_MCU_CNT2:
+	case AFE_IRQ1_MCU_CNT_MON:
+	case AFE_IRQ2_MCU_CNT_MON:
+	case AFE_MEMIF_MON0:
+	case AFE_MEMIF_MON1:
+	case AFE_MEMIF_MON2:
+	case AFE_MEMIF_MON4:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static const struct regmap_config mt6735_afe_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = MT6735_AFE_SIZE - 4,
+	.cache_type = REGCACHE_RBTREE,
+	.volatile_reg = mt6735_afe_volatile_reg,
+};
+
+/*
+ * Keep AFE_DAC_CON0 bit 0 in sync with the set of enabled memory
+ * interfaces.  This is the register write part of EnableAfe() from
+ * mt_soc_afe_control.c:981,1029: the AFE is only powered when at least one
+ * memory interface needs it.  Callers run in atomic context, so the PMIC bus
+ * pin mux (also part of EnableAfe()) is programmed from the sleepable DAI
+ * prepare/shutdown paths instead.
+ */
+void mt6735_afe_update_power(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	bool enabled = false;
+	int i;
+
+	for (i = 0; i < MT6735_AFE_MEMIF_NUM; i++)
+		enabled |= priv->memif_enabled[i];
+
+	regmap_update_bits(afe->regmap, AFE_DAC_CON0, AFE_DAC_CON0_AFE_ON,
+			   enabled ? AFE_DAC_CON0_AFE_ON : 0);
+}
+
+/*
+ * IRQ1 is shared by DL1 and DL2.  The downstream IRQ manager programs the
+ * counter for the user with the smallest period measured at the highest
+ * supported rate (IRQ_MAX_RATE, mt_soc_digital_type.h:865) and further
+ * rescaled by 100 to avoid overflow (get_tgt_count(),
+ * mt_soc_afe_control.c:3890-3895).  IRQ2 only has the capture interface.
+ */
+int mt6735_afe_irq_update(struct mtk_base_afe *afe, int irq)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	struct snd_pcm_runtime *best = NULL;
+	u64 best_period = U64_MAX;
+	unsigned int cnt_reg, fs_shift, en_bit;
+	int i, fs;
+
+	switch (irq) {
+	case MT6735_AFE_IRQ1:
+		cnt_reg = AFE_IRQ_MCU_CNT1;		/* mt_soc_afe_control.c:2159 */
+		fs_shift = AFE_IRQ_MCU_CON_IRQ1_FS_SHIFT;
+		en_bit = AFE_IRQ_MCU_CON_IRQ1_EN;
+		break;
+	case MT6735_AFE_IRQ2:
+		cnt_reg = AFE_IRQ_MCU_CNT2;		/* mt_soc_afe_control.c:2162 */
+		fs_shift = AFE_IRQ_MCU_CON_IRQ2_FS_SHIFT;
+		en_bit = AFE_IRQ_MCU_CON_IRQ2_EN;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	for (i = 0; i < MT6735_AFE_MEMIF_NUM; i++) {
+		struct snd_pcm_runtime *runtime;
+		u64 period;
+
+		if (afe->memif[i].irq_usage != irq || !priv->memif_enabled[i])
+			continue;
+		if (!afe->memif[i].substream)
+			continue;
+
+		runtime = afe->memif[i].substream->runtime;
+		if (!runtime || !runtime->rate)
+			continue;
+
+		period = div_u64((u64)runtime->period_size *
+				 MT6735_AFE_IRQ_MAX_RATE, runtime->rate);
+		if (period < best_period) {
+			best_period = period;
+			best = runtime;
+		}
+	}
+
+	if (!best) {
+		/* disable and clear, disable_aud_irq(), mt_soc_afe_control.c:3847-3856 */
+		regmap_update_bits(afe->regmap, AFE_IRQ_MCU_CON, en_bit, 0);
+		regmap_write(afe->regmap, cnt_reg, 0);
+		return 0;
+	}
+
+	fs = mt6735_afe_rate_to_fs(best->rate);
+	if (fs < 0)
+		return fs;
+
+	/* SetIrqMcuCounter(), mt_soc_afe_control.c:2154-2178 */
+	regmap_write(afe->regmap, cnt_reg, (unsigned int)best->period_size);
+	/* SetIrqMcuSampleRate(), mt_soc_afe_control.c:2128-2152 */
+	regmap_update_bits(afe->regmap, AFE_IRQ_MCU_CON,
+			   AFE_IRQ_MCU_CON_FS_MASK << fs_shift, fs << fs_shift);
+	/* SetIrqEnable(), mt_soc_afe_control.c:2099-2126 */
+	regmap_update_bits(afe->regmap, AFE_IRQ_MCU_CON, en_bit, en_bit);
+
+	return 0;
+}
+
+/*
+ * AudDrv_IRQ_handler(), mt_soc_afe_control.c:574-642.  IRQ1 serves DL1 and
+ * DL2, IRQ2 serves the capture interface.  AFE_IRQ_MCU_CLR is write-one to
+ * clear for the bits reported in AFE_IRQ_MCU_STATUS.
+ */
+static irqreturn_t mt6735_afe_irq_handler(int irq, void *data)
+{
+	struct mtk_base_afe *afe = data;
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int status;
+	int i;
+
+	if (regmap_read(afe->regmap, AFE_IRQ_MCU_STATUS, &status))
+		return IRQ_HANDLED;
+
+	status &= AFE_IRQ_STATUS_ALL;
+	if (!status) {
+		/*
+		 * Spurious interrupt recovery, mt_soc_afe_control.c:594-610:
+		 * clear every source and stop the MCU interrupts after
+		 * AudioInterruptLimiter (100) consecutive bogus interrupts.
+		 */
+		regmap_write(afe->regmap, AFE_IRQ_MCU_CLR, AFE_IRQ_STATUS_ALL);
+		if (++priv->spurious_irqs > MT6735_AFE_IRQ_LIMIT) {
+			regmap_update_bits(afe->regmap, AFE_IRQ_MCU_CON,
+					   AFE_IRQ_MCU_CON_IRQ1_EN |
+					   AFE_IRQ_MCU_CON_IRQ2_EN, 0);
+			priv->spurious_irqs = 0;
+		}
+		return IRQ_HANDLED;
+	}
+	priv->spurious_irqs = 0;
+
+	if (status & AFE_IRQ_STATUS_IRQ1) {
+		for (i = MT6735_AFE_MEMIF_DL1; i <= MT6735_AFE_MEMIF_DL2; i++) {
+			if (!priv->memif_enabled[i] || !afe->memif[i].substream)
+				continue;
+			snd_pcm_period_elapsed(afe->memif[i].substream);
+		}
+	}
+
+	if ((status & AFE_IRQ_STATUS_IRQ2) &&
+	    priv->memif_enabled[MT6735_AFE_MEMIF_VUL] &&
+	    afe->memif[MT6735_AFE_MEMIF_VUL].substream)
+		snd_pcm_period_elapsed(afe->memif[MT6735_AFE_MEMIF_VUL].substream);
+
+	regmap_write(afe->regmap, AFE_IRQ_MCU_CLR, status);
+
+	return IRQ_HANDLED;
+}
+
+/*
+ * The hardware reports the DMA read (playback) / write (capture) pointer,
+ * mtk_pcm_pointer() in mt_soc_pcm_dl1.c:189-235 does the same computation.
+ */
+static snd_pcm_uframes_t mt6735_afe_pcm_pointer(struct snd_soc_component *component,
+					       struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	const struct mtk_base_memif_data *data;
+	unsigned int hw_ptr = 0, hw_base = 0;
+	int memif_id = snd_soc_rtd_to_cpu(rtd, 0)->id;
+
+	if (memif_id < 0 || memif_id >= afe->memif_size)
+		return 0;
+
+	data = afe->memif[memif_id].data;
+	if (!data || !afe->memif[memif_id].substream)
+		return 0;
+
+	if (regmap_read(afe->regmap, data->reg_ofs_cur, &hw_ptr) ||
+	    regmap_read(afe->regmap, data->reg_ofs_base, &hw_base))
+		return 0;
+
+	if (!hw_ptr || !hw_base || hw_ptr < hw_base)
+		return 0;
+
+	return bytes_to_frames(substream->runtime, hw_ptr - hw_base);
+}
+
+static int mt6735_afe_pcm_new(struct snd_soc_component *component,
+			      struct snd_soc_pcm_runtime *rtd)
+{
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	size_t size = afe->mtk_afe_hardware->buffer_bytes_max;
+
+	snd_pcm_set_managed_buffer_all(rtd->pcm, SNDRV_DMA_TYPE_DEV, afe->dev,
+				       0, size);
+
+	return 0;
+}
+
+static int mt6735_afe_component_probe(struct snd_soc_component *component)
+{
+	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+
+	snd_soc_component_init_regmap(component, afe->regmap);
+
+	return 0;
+}
+
+static const struct snd_soc_component_driver mt6735_afe_component = {
+	.name = "mtk-afe-pcm",
+	.probe = mt6735_afe_component_probe,
+	.pcm_construct = mt6735_afe_pcm_new,
+	.pointer = mt6735_afe_pcm_pointer,
+};
+
+static int mt6735_afe_runtime_suspend(struct device *dev)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dev);
+
+	/* AudDrv_Clk_Off(): clear IRQ status, then gate the audio clocks. */
+	mt6735_afe_disable_clk(afe);
+	regcache_cache_only(afe->regmap, true);
+
+	return 0;
+}
+
+static int mt6735_afe_runtime_resume(struct device *dev)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dev);
+	int ret;
+
+	regcache_cache_only(afe->regmap, false);
+
+	ret = mt6735_afe_enable_clk(afe);
+	if (ret) {
+		regcache_cache_only(afe->regmap, true);
+		return ret;
+	}
+
+	regcache_mark_dirty(afe->regmap);
+
+	return regcache_sync(afe->regmap);
+}
+
+static int mt6735_afe_pcm_dev_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct snd_soc_dai_driver *dais;
+	struct mtk_base_afe *afe;
+	struct mt6735_afe_priv *priv;
+	int ret, irq, i;
+
+	afe = devm_kzalloc(dev, sizeof(*afe), GFP_KERNEL);
+	if (!afe)
+		return -ENOMEM;
+	afe->dev = dev;
+	platform_set_drvdata(pdev, afe);
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+	afe->platform_priv = priv;
+
+	afe->base_addr = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(afe->base_addr))
+		return dev_err_probe(dev, PTR_ERR(afe->base_addr),
+				     "failed to map AFE registers\n");
+
+	afe->regmap = devm_regmap_init_mmio(dev, afe->base_addr,
+					    &mt6735_afe_regmap_config);
+	if (IS_ERR(afe->regmap))
+		return dev_err_probe(dev, PTR_ERR(afe->regmap),
+				     "failed to init regmap\n");
+
+	/*
+	 * The AFE memory interfaces take 32 bit physical addresses; the MSB
+	 * register (AFE_MEMIF_MSB, AudDrv_Afe.h:470) is never programmed by
+	 * the downstream driver.
+	 */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "no 32-bit DMA support\n");
+
+	afe->memif_size = MT6735_AFE_MEMIF_NUM;
+	afe->memif = devm_kcalloc(dev, afe->memif_size, sizeof(*afe->memif),
+				  GFP_KERNEL);
+	if (!afe->memif)
+		return -ENOMEM;
+
+	for (i = 0; i < MT6735_AFE_MEMIF_NUM; i++) {
+		afe->memif[i].data = &mt6735_afe_memif_data[i];
+		afe->memif[i].irq_usage = mt6735_afe_memif_irq[i];
+		afe->memif[i].const_irq = 1;
+	}
+
+	afe->mtk_afe_hardware = &mt6735_afe_hardware;
+
+	ret = mt6735_afe_init_pinctrl(afe);
+	if (ret)
+		return ret;
+
+	ret = mt6735_afe_init_clk(afe);
+	if (ret)
+		return ret;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	/* Power the block up once to make the IRQ request and regmap valid. */
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(dev);
+		return ret;
+	}
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0) {
+		ret = irq;
+		goto err_put;
+	}
+
+	ret = devm_request_irq(dev, irq, mt6735_afe_irq_handler, 0,
+			       "Afe_ISR_Handle", afe);
+	if (ret)
+		goto err_put;
+
+	dais = devm_kcalloc(dev, MT6735_AFE_DAI_NUM, sizeof(*dais),
+			    GFP_KERNEL);
+	if (!dais) {
+		ret = -ENOMEM;
+		goto err_put;
+	}
+
+	memcpy(dais, mt6735_afe_pcm_dais, sizeof(mt6735_afe_pcm_dais));
+	dais[MT6735_AFE_DAI_I2S0] = mt6735_afe_i2s_dai;
+
+	ret = devm_snd_soc_register_component(dev, &mt6735_afe_component,
+					      dais, MT6735_AFE_DAI_NUM);
+	if (ret)
+		goto err_put;
+
+	pm_runtime_put(dev);
+
+	return 0;
+
+err_put:
+	pm_runtime_put_sync(dev);
+	return ret;
+}
+
+static void mt6735_afe_pcm_dev_remove(struct platform_device *pdev)
+{
+	struct mtk_base_afe *afe = platform_get_drvdata(pdev);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	if (!pm_runtime_status_suspended(afe->dev))
+		pm_runtime_force_suspend(afe->dev);
+
+	/* Return the audio pins to their boot state (AudDrv_GPIO_probe()). */
+	if (priv->pinctrl && priv->pins_default)
+		pinctrl_select_state(priv->pinctrl, priv->pins_default);
+}
+
+static const struct of_device_id mt6735_afe_pcm_dt_match[] = {
+	{ .compatible = "mediatek,mt6735-afe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6735_afe_pcm_dt_match);
+
+static const struct dev_pm_ops mt6735_afe_pm_ops = {
+	RUNTIME_PM_OPS(mt6735_afe_runtime_suspend, mt6735_afe_runtime_resume, NULL)
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+};
+
+static struct platform_driver mt6735_afe_pcm_driver = {
+	.driver = {
+		.name = "mt6735-afe-pcm",
+		.of_match_table = mt6735_afe_pcm_dt_match,
+		.pm = pm_ptr(&mt6735_afe_pm_ops),
+	},
+	.probe = mt6735_afe_pcm_dev_probe,
+	.remove = mt6735_afe_pcm_dev_remove,
+};
+
+module_platform_driver(mt6735_afe_pcm_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6735/MT6737T ALSA SoC AFE platform driver");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:mt6735-afe-pcm");
diff --git a/sound/soc/mediatek/mt6735/mt6735-afe-regs.h b/sound/soc/mediatek/mt6735/mt6735-afe-regs.h
new file mode 100644
index 000000000..3f92e7876
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-afe-regs.h
@@ -0,0 +1,203 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * MediaTek MT6735/MT6737T audio front end (AFE) register definitions.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/AudDrv_Afe.h and
+ * sound/soc/mediatek/mt_soc_audio_v3/mt_soc_afe_control.c.
+ *
+ * Every offset below carries the downstream file:line it was transcribed
+ * from.  The AFE register block is mapped at 0x11220000 (AudDrv_Afe.h:361).
+ */
+
+#ifndef _MT6735_AFE_REGS_H_
+#define _MT6735_AFE_REGS_H_
+
+#include <linux/bits.h>
+
+#define MT6735_AFE_PHYS_BASE		0x11220000	/* AudDrv_Afe.h:361 */
+#define MT6735_AFE_SIZE			0x10000		/* rom_dtb_0.dts audio@11220000 */
+
+/* Top level clock/power control */
+#define AUDIO_TOP_CON0			0x0000		/* AudDrv_Afe.h:416 */
+#define AUDIO_TOP_CON1			0x0004		/* AudDrv_Afe.h:423 */
+#define AUDIO_TOP_CON2			0x0008		/* AudDrv_Afe.h:425 */
+#define AUDIO_TOP_CON3			0x000c		/* AudDrv_Afe.h:426 */
+
+/*
+ * AUDIO_TOP_CON0 bit 14 must be set before any other AFE register is
+ * accessed; the bootloader leaves it cleared (AudDrv_Clk.c:265).
+ */
+#define AUDIO_TOP_CON0_AFE_POWER_ON	BIT(14)		/* AudDrv_Clk.c:265,467 */
+
+/* AUDIO_TOP_CON1 */
+#define AUDIO_TOP_CON1_I2S_SOFT_RST	BIT(1)		/* mt_soc_afe_control.c:3749 */
+#define AUDIO_TOP_CON1_I2S0_CG		BIT(4)		/* mt_soc_afe_control.c:3750 */
+#define AUDIO_TOP_CON1_I2S3_CG		BIT(7)		/* mt_soc_afe_control.c:3751 */
+
+/* DAC/memory interface control */
+#define AFE_DAC_CON0			0x0010		/* AudDrv_Afe.h:427 */
+#define AFE_DAC_CON1			0x0014		/* AudDrv_Afe.h:428 */
+
+#define AFE_DAC_CON0_AFE_ON		BIT(0)		/* mt_soc_afe_control.c:981,1029 */
+#define AFE_DAC_CON0_MEMIF_EN(id)	BIT((id) + 1)	/* mt_soc_afe_control.c:1995-1997 */
+
+/* AFE_DAC_CON1 sample rate fields (ftell: mt_soc_afe_control.c:1073-1128) */
+#define AFE_DAC_CON1_DL1_FS_SHIFT	0		/* mt_soc_afe_control.c:1080 */
+#define AFE_DAC_CON1_DL2_FS_SHIFT	4		/* mt_soc_afe_control.c:1084 */
+#define AFE_DAC_CON1_I2S_FS_SHIFT	8		/* mt_soc_afe_control.c:1088 */
+#define AFE_DAC_CON1_AWB_FS_SHIFT	12		/* mt_soc_afe_control.c:1092 */
+#define AFE_DAC_CON1_VUL_FS_SHIFT	16		/* mt_soc_afe_control.c:1096 */
+#define AFE_DAC_CON1_FS_MASK		GENMASK(3, 0)
+
+/* AFE_DAC_CON1 mono (single channel) fields (mt_soc_afe_control.c:1129-1160) */
+#define AFE_DAC_CON1_DL1_MONO_SHIFT	21		/* mt_soc_afe_control.c:1135 */
+#define AFE_DAC_CON1_DL2_MONO_SHIFT	22		/* mt_soc_afe_control.c:1139 */
+#define AFE_DAC_CON1_AWB_MONO_SHIFT	24		/* mt_soc_afe_control.c:1143 */
+#define AFE_DAC_CON1_VUL_MONO_SHIFT	27		/* mt_soc_afe_control.c:1147 */
+
+/* I2S interfaces */
+#define AFE_I2S_CON			0x0018		/* AudDrv_Afe.h:429 */
+#define AFE_I2S_CON1			0x0034		/* AudDrv_Afe.h:438 */
+#define AFE_I2S_CON2			0x0038		/* AudDrv_Afe.h:439 */
+
+/*
+ * AFE_I2S_CON layout, from Enable4pin_I2S0_I2S3() in
+ * mt_soc_afe_control.c:3740-3786 and SetI2SDacOut()/SetI2SDacEnable()
+ * in mt_soc_afe_control.c:1637-1655, 2010-2034.
+ */
+#define AFE_I2S_CON_EN			BIT(0)		/* mt_soc_afe_control.c:3781 */
+#define AFE_I2S_CON_WLEN_SHIFT		1		/* mt_soc_afe_control.c:3760 */
+#define AFE_I2S_CON_SLAVE		BIT(2)		/* mt_soc_pcm_hdmi.c:889 */
+#define AFE_I2S_CON_FMT_SHIFT		3		/* mt_soc_afe_control.c:3759 */
+#define AFE_I2S_CON_LRCK_INV		BIT(5)		/* mt_soc_afe_control.c:3758 */
+#define AFE_I2S_CON_FS_SHIFT		8		/* mt_soc_pcm_dl1_i2s0.c:188 */
+#define AFE_I2S_CON_LOW_JITTER		BIT(12)		/* mt_soc_afe_control.c:3757 */
+#define AFE_I2S_CON_PAD_SEL_IO_MUX	BIT(28)		/* mt_soc_afe_control.c:3755 */
+#define AFE_I2S_CON_PHASE_SHIFT_FIX	BIT(31)		/* mt_soc_afe_control.c:3754 */
+
+#define AFE_I2S_CON1_LR_SWAP		BIT(31)		/* mt_soc_afe_control.c:1645 */
+#define AFE_I2S_CON1_EN			BIT(0)		/* mt_soc_afe_control.c:2018 */
+
+/* I2S format field values (mt_soc_digital_type.h:245-247, 260-263) */
+#define AFE_I2S_FORMAT_EIAJ		0
+#define AFE_I2S_FORMAT_I2S		1
+#define AFE_I2S_WLEN_16BIT		0
+#define AFE_I2S_WLEN_32BIT		1
+
+/* Interconnection (AFE_CONNx) */
+#define AFE_CONN0			0x0020		/* AudDrv_Afe.h:432 */
+#define AFE_CONN1			0x0024		/* AudDrv_Afe.h:433 */
+#define AFE_CONN2			0x0028		/* AudDrv_Afe.h:434 */
+#define AFE_CONN3			0x002c		/* AudDrv_Afe.h:435 */
+#define AFE_CONN_24BIT			0x006c		/* AudDrv_Afe.h:458 */
+
+/*
+ * Bit positions inside the AFE_CONNx registers.  These are entries of the
+ * mConnectionReg/mConnectionbits tables in mt_soc_afe_connection.c.
+ *
+ *	DL1 left  (I05) -> O03 : AFE_CONN1 bit 21
+ *	DL1 right (I06) -> O04 : AFE_CONN2 bit 6
+ *	DL2 left  (I07) -> O03 : AFE_CONN1 bit 23
+ *	DL2 right (I08) -> O04 : AFE_CONN2 bit 8
+ *	ADC left  (I03) -> O09 : AFE_CONN3 bit 0
+ *	ADC right (I04) -> O10 : AFE_CONN3 bit 3
+ */
+#define AFE_CONN_DL1_L_TO_O03		BIT(21)		/* mConnectionReg[I05][O03] :293, bits :188 */
+#define AFE_CONN_DL1_R_TO_O04		BIT(6)		/* mConnectionReg[I06][O04] :295, bits :190 */
+#define AFE_CONN_DL2_L_TO_O03		BIT(23)		/* mConnectionReg[I07][O03] :297, bits :192 */
+#define AFE_CONN_DL2_R_TO_O04		BIT(8)		/* mConnectionReg[I08][O04] :299, bits :194 */
+#define AFE_CONN_ADC_L_TO_O09		BIT(0)		/* mConnectionReg[I03][O09] :289, bits :184 */
+#define AFE_CONN_ADC_R_TO_O10		BIT(3)		/* mConnectionReg[I04][O10] :291, bits :186 */
+
+/*
+ * Physical I2S0 output ports O00/O01, fed from the DL1 interface when the
+ * I2S0 PCM is used (mt_soc_pcm_dl1_i2s0Dl1.c:514-518).
+ */
+#define AFE_CONN_DL1_L_TO_O00		BIT(5)		/* mConnectionReg[I05][O00] :293, bits :187 */
+#define AFE_CONN_DL1_R_TO_O01		BIT(22)		/* mConnectionReg[I06][O01] :295, bits :189 */
+
+/* AFE_CONN_24BIT: bit N selects 24 bit data for output O<N>
+ * (SetoutputConnectionFormat(), mt_soc_afe_control.c:2371-2377).
+ */
+#define AFE_CONN_24BIT_O03		BIT(3)
+#define AFE_CONN_24BIT_O04		BIT(4)
+#define AFE_CONN_24BIT_O09		BIT(9)
+#define AFE_CONN_24BIT_O10		BIT(10)
+
+/* Memory interfaces */
+#define AFE_DL1_BASE			0x0040		/* AudDrv_Afe.h:443 */
+#define AFE_DL1_CUR			0x0044		/* AudDrv_Afe.h:444 */
+#define AFE_DL1_END			0x0048		/* AudDrv_Afe.h:445 */
+#define AFE_DL2_BASE			0x0050		/* AudDrv_Afe.h:454 */
+#define AFE_DL2_CUR			0x0054		/* AudDrv_Afe.h:455 */
+#define AFE_DL2_END			0x0058		/* AudDrv_Afe.h:456 */
+#define AFE_VUL_BASE			0x0080		/* AudDrv_Afe.h:462 */
+#define AFE_VUL_END			0x0088		/* AudDrv_Afe.h:463 */
+#define AFE_VUL_CUR			0x008c		/* AudDrv_Afe.h:464 */
+
+/* Memory interface monitor registers, read only */
+#define AFE_MEMIF_MON0			0x00d0		/* AudDrv_Afe.h:473 */
+#define AFE_MEMIF_MON1			0x00d4		/* AudDrv_Afe.h:474 */
+#define AFE_MEMIF_MON2			0x00d8		/* AudDrv_Afe.h:475 */
+#define AFE_MEMIF_MON4			0x00e0		/* AudDrv_Afe.h:477 */
+
+/*
+ * Per-sample fetch format (16 bit vs 24 bit data) for each memory
+ * interface, SetMemIfFetchFormatPerSample() mt_soc_afe_control.c:2294-2369.
+ */
+#define AFE_MEMIF_PBUF_SIZE		0x03d8		/* AudDrv_Afe.h:611 */
+#define AFE_MEMIF_PBUF_DL1_FMT_SHIFT	16		/* mt_soc_afe_control.c:2303 */
+#define AFE_MEMIF_PBUF_DL2_FMT_SHIFT	18		/* mt_soc_afe_control.c:2315 */
+#define AFE_MEMIF_PBUF_VUL_FMT_SHIFT	22		/* mt_soc_afe_control.c:2332 */
+#define AFE_MEMIF_PBUF_FMT_MASK		GENMASK(1, 0)
+
+/* AFE_WLEN values used in AFE_MEMIF_PBUF_SIZE (mt_soc_digital_type.h:507-509) */
+#define AFE_WLEN_16_BIT			0
+#define AFE_WLEN_24_BIT			1
+
+/* ADDA (PMIC codec) digital interface */
+#define AFE_ADDA_DL_SRC2_CON0		0x0108		/* AudDrv_Afe.h:481 */
+#define AFE_ADDA_DL_SRC2_CON1		0x010c		/* AudDrv_Afe.h:482 */
+#define AFE_ADDA_UL_SRC_CON0		0x0114		/* AudDrv_Afe.h:483 */
+#define AFE_ADDA_TOP_CON0		0x0120		/* AudDrv_Afe.h:485 */
+#define AFE_ADDA_UL_DL_CON0		0x0124		/* AudDrv_Afe.h:486 */
+#define AFE_ADDA_NEWIF_CFG0		0x0138		/* AudDrv_Afe.h:490 */
+#define AFE_ADDA_NEWIF_CFG1		0x013c		/* AudDrv_Afe.h:491 */
+#define AFE_ADDA_PREDIS_CON0		0x0260		/* AudDrv_Afe.h:539 */
+#define AFE_ADDA_PREDIS_CON1		0x0264		/* AudDrv_Afe.h:540 */
+
+#define AFE_ADDA_DL_SRC2_CON0_EN	BIT(0)		/* mt_soc_afe_control.c:2017 */
+#define AFE_ADDA_UL_SRC_CON0_EN		BIT(0)		/* mt_soc_afe_control.c:1560 */
+#define AFE_ADDA_UL_DL_CON0_EN		BIT(0)		/* mt_soc_afe_control.c:2016 */
+#define AFE_ADDA_TOP_CON0_EXT_ADC	BIT(0)		/* mt_soc_afe_control.c:1356,1374 */
+
+/* Interrupt controller */
+#define AFE_IRQ_MCU_CON			0x03a0		/* AudDrv_Afe.h:584 */
+#define AFE_IRQ_MCU_STATUS		0x03a4		/* AudDrv_Afe.h:586 */
+#define AFE_IRQ_MCU_CLR			0x03a8		/* AudDrv_Afe.h:588 */
+#define AFE_IRQ_MCU_CNT1		0x03ac		/* AudDrv_Afe.h:590 */
+#define AFE_IRQ_MCU_CNT2		0x03b0		/* AudDrv_Afe.h:592 */
+#define AFE_IRQ_MCU_EN			0x03b4		/* AudDrv_Afe.h:593 */
+#define AFE_IRQ1_MCU_CNT_MON		0x03c0		/* AudDrv_Afe.h:599 */
+#define AFE_IRQ2_MCU_CNT_MON		0x03c4		/* AudDrv_Afe.h:602 */
+
+/* AFE_IRQ_MCU_CON fields, SetIrqEnable()/SetIrqMcuSampleRate() */
+#define AFE_IRQ_MCU_CON_IRQ1_EN		BIT(0)		/* mt_soc_afe_control.c:2105 */
+#define AFE_IRQ_MCU_CON_IRQ2_EN		BIT(1)		/* mt_soc_afe_control.c:2105 */
+#define AFE_IRQ_MCU_CON_IRQ1_FS_SHIFT	4		/* mt_soc_afe_control.c:2136 */
+#define AFE_IRQ_MCU_CON_IRQ2_FS_SHIFT	8		/* mt_soc_afe_control.c:2139 */
+#define AFE_IRQ_MCU_CON_FS_MASK		GENMASK(3, 0)
+
+/* AFE_IRQ_MCU_STATUS / AFE_IRQ_MCU_CLR bits (AudDrv_Kernel.h:246-251) */
+#define AFE_IRQ_STATUS_IRQ1		BIT(0)
+#define AFE_IRQ_STATUS_IRQ2		BIT(1)
+#define AFE_IRQ_STATUS_IRQ3		BIT(2)
+#define AFE_IRQ_STATUS_IRQ4		BIT(3)
+#define AFE_IRQ_STATUS_IRQ5		BIT(4)
+#define AFE_IRQ_STATUS_IRQ7		BIT(6)
+#define AFE_IRQ_STATUS_ALL		GENMASK(7, 0)
+
+#endif /* _MT6735_AFE_REGS_H_ */
diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-i2s.c b/sound/soc/mediatek/mt6735/mt6735-dai-i2s.c
new file mode 100644
index 000000000..cd7f7a88d
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-i2s.c
@@ -0,0 +1,285 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC AFE I2S0 back-end DAI.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/:
+ *   mt_soc_afe_control.c  - Enable4pin_I2S0_I2S3(), SetCLkMclk()
+ *   mt_soc_pcm_dl1_i2s0.c - I2S0 register programming
+ *   AudDrv_Gpio.c         - audi2s1-mode0/mode1 pin muxing
+ *
+ * The MCLK/BCLK dividers live in the audiosys clock controller
+ * (AUDIO_CLK_AUDDIV_0/1 at 0x1021xxxx, SetCLkMclk()/SetCLkBclk(),
+ * mt_soc_afe_control.c:751-813) and are therefore programmed by the clock
+ * provider, not by this driver.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/* Default MCLK/sample rate ratio, MCLKFS in mt_soc_afe_control.c:137 */
+#define MT6735_AFE_I2S_MCLK_FS	128
+
+static int mt6735_afe_i2s_startup(struct snd_pcm_substream *substream,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	int ret;
+
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		return ret;
+	}
+
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	ret = snd_pcm_hw_constraint_integer(substream->runtime,
+					    SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		pm_runtime_put_noidle(afe->dev);
+
+	return ret;
+}
+
+static void mt6735_afe_i2s_shutdown(struct snd_pcm_substream *substream,
+				    struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	mt6735_afe_select_i2s_pins(afe, false);
+	pm_runtime_put(afe->dev);
+}
+
+/*
+ * Translate the ASoC DAI format into the AFE_I2S_CON format fields.
+ * AFE_I2S_CON bit 2 selects slave mode ("clock from : slave mode",
+ * mt_soc_pcm_hdmi.c:889), bit 5 inverts LRCK and bit 3 selects the I2S
+ * (rather than EIAJ) framing (mt_soc_afe_control.c:3758-3763).
+ */
+static int mt6735_afe_i2s_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int con;
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_CBP_CFP:
+		priv->i2s_slave = false;
+		break;
+	case SND_SOC_DAIFMT_CBC_CFC:
+		priv->i2s_slave = true;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		con = 0;
+		break;
+	case SND_SOC_DAIFMT_NB_IF:
+		con = AFE_I2S_CON_LRCK_INV;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * Fixed settings for the four wire I2S0 interface, from
+	 * Enable4pin_I2S0_I2S3() (mt_soc_afe_control.c:3749-3763): phase
+	 * shift fix, data taken from the IO mux, low jitter clock and I2S
+	 * framing.
+	 */
+	con |= AFE_I2S_CON_PHASE_SHIFT_FIX |
+	       AFE_I2S_CON_PAD_SEL_IO_MUX |
+	       AFE_I2S_CON_LOW_JITTER |
+	       (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT);
+	if (priv->i2s_slave)
+		con |= AFE_I2S_CON_SLAVE;
+
+	priv->i2s_con = con;
+
+	return 0;
+}
+
+/*
+ * MCLK is routed through the audiosys clock mux; only its value is validated
+ * here so that hw_params can check it against the stream rate the same way
+ * SetCLkMclk() derives the divider (mt_soc_afe_control.c:751-786).
+ */
+static int mt6735_afe_i2s_set_sysclk(struct snd_soc_dai *dai, int clk_id,
+				     unsigned int freq, int dir)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	if (clk_id != 0)
+		return -EINVAL;
+	if (dir != SND_SOC_CLOCK_OUT)
+		return -EINVAL;
+
+	priv->i2s_sysclk = freq;
+
+	return 0;
+}
+
+static int mt6735_afe_i2s_hw_params(struct snd_pcm_substream *substream,
+				    struct snd_pcm_hw_params *params,
+				    struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	unsigned int con, wlen;
+	int fs, ret;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return -EINVAL;
+
+	if (channels < MT6735_AFE_CHANNELS_MIN ||
+	    channels > MT6735_AFE_CHANNELS_MAX)
+		return -EINVAL;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		wlen = AFE_I2S_WLEN_16BIT;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+		wlen = AFE_I2S_WLEN_32BIT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (priv->i2s_sysclk) {
+		if (priv->i2s_sysclk % rate)
+			return -EINVAL;
+		if (priv->i2s_sysclk < MT6735_AFE_I2S_MCLK_FS * rate)
+			dev_dbg(afe->dev,
+				"I2S0 MCLK %u Hz below %u x %u Hz\n",
+				priv->i2s_sysclk, MT6735_AFE_I2S_MCLK_FS, rate);
+	}
+
+	con = priv->i2s_con;
+	if (!con)
+		con = AFE_I2S_CON_PHASE_SHIFT_FIX |
+		      AFE_I2S_CON_PAD_SEL_IO_MUX |
+		      AFE_I2S_CON_LOW_JITTER |
+		      (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT);
+
+	con |= (fs << AFE_I2S_CON_FS_SHIFT) |
+	       (wlen << AFE_I2S_CON_WLEN_SHIFT);
+
+	/* AudDrv_GPIO_I2S_Select(true), AudDrv_Gpio.c:238-259 */
+	ret = mt6735_afe_select_i2s_pins(afe, true);
+	if (ret)
+		return ret;
+
+	/*
+	 * Bring-up sequence of Enable4pin_I2S0_I2S3(),
+	 * mt_soc_afe_control.c:3749-3782: soft reset, gate the I2S0 clock,
+	 * program the interface, ungate, release the reset.
+	 */
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1,
+			   AUDIO_TOP_CON1_I2S_SOFT_RST,
+			   AUDIO_TOP_CON1_I2S_SOFT_RST);
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1, AUDIO_TOP_CON1_I2S0_CG,
+			   AUDIO_TOP_CON1_I2S0_CG);
+	regmap_write(afe->regmap, AFE_I2S_CON, con);
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1, AUDIO_TOP_CON1_I2S0_CG,
+			   0);
+	udelay(200);
+	regmap_update_bits(afe->regmap, AUDIO_TOP_CON1,
+			   AUDIO_TOP_CON1_I2S_SOFT_RST, 0);
+
+	return 0;
+}
+
+static int mt6735_afe_i2s_trigger(struct snd_pcm_substream *substream, int cmd,
+				  struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		/*
+		 * When DL1 feeds I2S0 (I2S0DL1 link) the DL1 samples are also
+		 * routed to the physical O00/O01 ports
+		 * (mt_soc_pcm_dl1_i2s0Dl1.c:514-518).
+		 */
+		if (priv->memif_enabled[MT6735_AFE_MEMIF_DL1])
+			regmap_update_bits(afe->regmap, AFE_CONN0,
+					   AFE_CONN_DL1_L_TO_O00 |
+					   AFE_CONN_DL1_R_TO_O01,
+					   AFE_CONN_DL1_L_TO_O00 |
+					   AFE_CONN_DL1_R_TO_O01);
+
+		return regmap_update_bits(afe->regmap, AFE_I2S_CON,
+					  AFE_I2S_CON_EN, AFE_I2S_CON_EN);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		regmap_update_bits(afe->regmap, AFE_I2S_CON, AFE_I2S_CON_EN, 0);
+		regmap_update_bits(afe->regmap, AFE_CONN0,
+				   AFE_CONN_DL1_L_TO_O00 |
+				   AFE_CONN_DL1_R_TO_O01, 0);
+
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_afe_i2s_ops = {
+	.startup = mt6735_afe_i2s_startup,
+	.shutdown = mt6735_afe_i2s_shutdown,
+	.set_fmt = mt6735_afe_i2s_set_fmt,
+	.set_sysclk = mt6735_afe_i2s_set_sysclk,
+	.hw_params = mt6735_afe_i2s_hw_params,
+	.trigger = mt6735_afe_i2s_trigger,
+};
+
+const struct snd_soc_dai_driver mt6735_afe_i2s_dai = {
+	.name = "mt-soc-i2s0dai-driver",
+	.id = MT6735_AFE_DAI_I2S0,
+	.ops = &mt6735_afe_i2s_ops,
+	.playback = {
+		.stream_name = "I2S0 Playback",
+		.channels_min = MT6735_AFE_CHANNELS_MIN,
+		.channels_max = MT6735_AFE_CHANNELS_MAX,
+		.rates = MT6735_AFE_RATES,
+		.rate_min = MT6735_AFE_RATE_MIN,
+		.rate_max = MT6735_AFE_RATE_MAX,
+		.formats = MT6735_AFE_FORMATS,
+	},
+	.capture = {
+		.stream_name = "I2S0 Capture",
+		.channels_min = MT6735_AFE_CHANNELS_MIN,
+		.channels_max = MT6735_AFE_CHANNELS_MAX,
+		.rates = MT6735_AFE_RATES,
+		.rate_min = MT6735_AFE_RATE_MIN,
+		.rate_max = MT6735_AFE_RATE_MAX,
+		.formats = MT6735_AFE_FORMATS,
+	},
+};
diff --git a/sound/soc/mediatek/mt6735/mt6735-dai-pcm.c b/sound/soc/mediatek/mt6735/mt6735-dai-pcm.c
new file mode 100644
index 000000000..72af375dd
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-dai-pcm.c
@@ -0,0 +1,553 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6735/MT6737T ALSA SoC AFE front-end DAIs (DL1, DL2, VUL).
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ * sound/soc/mediatek/mt_soc_audio_v3/:
+ *   mt_soc_pcm_dl1.c      - DL1 playback (codec path)
+ *   mt_soc_pcm_dl2.c      - DL2 playback (codec path)
+ *   mt_soc_pcm_capture.c  - VUL capture
+ *   mt_soc_afe_control.c  - memif/IRQ/rate/channel programming
+ */
+
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mt6735-afe-common.h"
+
+/*
+ * SetDLSrc2() sample rate table, mt_soc_afe_control.c:1596-1616.  Note that
+ * this field uses a dense 0..8 encoding, unlike the AFE_DAC_CON1 / I2S fields
+ * which use the sparse mt_soc_digital_type.h encoding.
+ */
+static const unsigned int mt6735_afe_dlsrc2_rates[] = {
+	8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000,
+};
+
+static bool mt6735_afe_playback_enabled(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	return priv->memif_enabled[MT6735_AFE_MEMIF_DL1] ||
+	       priv->memif_enabled[MT6735_AFE_MEMIF_DL2];
+}
+
+static bool mt6735_afe_capture_enabled(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	return priv->memif_enabled[MT6735_AFE_MEMIF_VUL];
+}
+
+/*
+ * SetMemoryPathEnable(), mt_soc_afe_control.c:1968-2000: the memory
+ * interface enable bit is AFE_DAC_CON0 bit (interface + 1).
+ */
+static int mt6735_afe_memif_enable(struct mtk_base_afe *afe, int id,
+				   bool enable)
+{
+	const struct mtk_base_memif_data *data = afe->memif[id].data;
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int bit = BIT(data->enable_shift);
+
+	regmap_update_bits(afe->regmap, data->enable_reg, bit,
+			   enable ? bit : 0);
+	priv->memif_enabled[id] = enable;
+	mt6735_afe_update_power(afe);
+
+	return 0;
+}
+
+/*
+ * SetConnection(), mt_soc_afe_connection.c:433-500.  Only the four routes
+ * used by this driver are implemented; see the table entries cited in
+ * mt6735-afe-regs.h.
+ */
+static int mt6735_afe_connect(struct mtk_base_afe *afe, int id, bool connect)
+{
+	unsigned int reg, bits;
+
+	switch (id) {
+	case MT6735_AFE_MEMIF_DL1:
+		reg = AFE_CONN1;
+		bits = AFE_CONN_DL1_L_TO_O03;
+		regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+		reg = AFE_CONN2;
+		bits = AFE_CONN_DL1_R_TO_O04;
+		break;
+	case MT6735_AFE_MEMIF_DL2:
+		reg = AFE_CONN1;
+		bits = AFE_CONN_DL2_L_TO_O03;
+		regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+		reg = AFE_CONN2;
+		bits = AFE_CONN_DL2_R_TO_O04;
+		break;
+	case MT6735_AFE_MEMIF_VUL:
+		reg = AFE_CONN3;
+		bits = AFE_CONN_ADC_L_TO_O09 | AFE_CONN_ADC_R_TO_O10;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	regmap_update_bits(afe->regmap, reg, bits, connect ? bits : 0);
+
+	return 0;
+}
+
+/* SetoutputConnectionFormat(), mt_soc_afe_control.c:2371-2377 */
+static void mt6735_afe_set_conn_width(struct mtk_base_afe *afe, int id,
+				      bool wlen24)
+{
+	unsigned int bits;
+
+	switch (id) {
+	case MT6735_AFE_MEMIF_DL1:
+	case MT6735_AFE_MEMIF_DL2:
+		bits = AFE_CONN_24BIT_O03 | AFE_CONN_24BIT_O04;
+		break;
+	case MT6735_AFE_MEMIF_VUL:
+		bits = AFE_CONN_24BIT_O09 | AFE_CONN_24BIT_O10;
+		break;
+	default:
+		return;
+	}
+
+	regmap_update_bits(afe->regmap, AFE_CONN_24BIT, bits,
+			   wlen24 ? bits : 0);
+}
+
+/*
+ * Downstream codec playback interface: SetI2SDacOut()/SetDLSrc2()/
+ * SetI2SDacEnable() from mt_soc_afe_control.c:1592-1655 and 2010-2034.
+ * AFE_I2S_CON1 is the I2S-style bus between the AFE and the PMIC codec.
+ */
+static int mt6735_afe_dac_prepare(struct mtk_base_afe *afe, unsigned int rate,
+				  bool wlen32)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int val;
+	int fs, idx;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return fs;
+
+	for (idx = 0; idx < ARRAY_SIZE(mt6735_afe_dlsrc2_rates); idx++)
+		if (mt6735_afe_dlsrc2_rates[idx] == rate)
+			break;
+	if (idx == ARRAY_SIZE(mt6735_afe_dlsrc2_rates))
+		return -EINVAL;
+
+	/* CleanPreDistortion(), mt_soc_afe_control.c:1583-1590 */
+	regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON0, 0);
+	regmap_write(afe->regmap, AFE_ADDA_PREDIS_CON1, 0);
+
+	/*
+	 * SetDLSrc2(), mt_soc_afe_control.c:1592-1635.  8k and 16k use the
+	 * voice mode configuration; the final 0x1 << 1 applies the -0.3 dB
+	 * speech gain MediaTek recommends for every rate.
+	 */
+	val = (idx << 28) | (0x3 << 24) | (0x3 << 11);
+	if (idx == 0 || idx == 3)
+		val |= (0x1 << 5);
+	val |= (0x1 << 1);
+	regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON0, val);
+	regmap_write(afe->regmap, AFE_ADDA_DL_SRC2_CON1, 0xf74f0000);
+
+	/* SetI2SDacOut(), mt_soc_afe_control.c:1637-1655 */
+	val = (AFE_I2S_FORMAT_I2S << AFE_I2S_CON_FMT_SHIFT) |
+	      ((wlen32 ? AFE_I2S_WLEN_32BIT : AFE_I2S_WLEN_16BIT) <<
+	       AFE_I2S_CON_WLEN_SHIFT) |
+	      (fs << AFE_I2S_CON_FS_SHIFT);
+	regmap_write(afe->regmap, AFE_I2S_CON1, val);
+
+	/* SetSampleRate(MEM_I2S, rate), mt_soc_pcm_dl1.c:337 */
+	regmap_update_bits(afe->regmap, AFE_DAC_CON1,
+			   AFE_DAC_CON1_FS_MASK << AFE_DAC_CON1_I2S_FS_SHIFT,
+			   fs << AFE_DAC_CON1_I2S_FS_SHIFT);
+
+	/* SetI2SDacEnable(true), mt_soc_afe_control.c:2010-2026 */
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+			   AFE_ADDA_UL_DL_CON0_EN, AFE_ADDA_UL_DL_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+			   AFE_ADDA_DL_SRC2_CON0_EN,
+			   AFE_ADDA_DL_SRC2_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_I2S_CON1, AFE_I2S_CON1_EN,
+			   AFE_I2S_CON1_EN);
+
+	priv->dac_path_on = true;
+
+	return 0;
+}
+
+/* SetI2SDacEnable(false), mt_soc_afe_control.c:2010-2034 */
+static void mt6735_afe_dac_disable(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	regmap_update_bits(afe->regmap, AFE_ADDA_DL_SRC2_CON0,
+			   AFE_ADDA_DL_SRC2_CON0_EN, 0);
+	regmap_update_bits(afe->regmap, AFE_I2S_CON1, AFE_I2S_CON1_EN, 0);
+
+	if (!priv->adc_path_on)
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+				   AFE_ADDA_UL_DL_CON0_EN, 0);
+
+	priv->dac_path_on = false;
+}
+
+/*
+ * PMIC codec capture interface: SetI2SAdcIn() internal ADC path and
+ * SetI2SAdcEnable(), mt_soc_afe_control.c:1346-1370 and 1553-1572.
+ */
+static int mt6735_afe_adc_prepare(struct mtk_base_afe *afe, unsigned int rate)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	unsigned int voice_mode;
+	int fs;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return fs;
+
+	/*
+	 * The downstream driver leaves the voice mode selection at 0 for any
+	 * rate that is not 8k/16k/32k/48k (mt_soc_afe_control.c:1352-1366).
+	 */
+	switch (rate) {
+	case 8000:
+		voice_mode = 0;
+		break;
+	case 16000:
+		voice_mode = 1;
+		break;
+	case 32000:
+		voice_mode = 2;
+		break;
+	case 48000:
+		voice_mode = 3;
+		break;
+	default:
+		voice_mode = 0;
+		break;
+	}
+
+	/* SetI2SAdcIn(), mt_soc_afe_control.c:1346-1370 */
+	regmap_update_bits(afe->regmap, AFE_ADDA_TOP_CON0,
+			   AFE_ADDA_TOP_CON0_EXT_ADC, 0);
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0, 0x001e0000,
+			   (voice_mode << 19) | (voice_mode << 17));
+	regmap_write(afe->regmap, AFE_ADDA_NEWIF_CFG0, 0x03f87201);
+	regmap_update_bits(afe->regmap, AFE_ADDA_NEWIF_CFG1, 0x00000c00,
+			   ((voice_mode < 3) ? 1 : 3) << 10);
+
+	/* SetI2SAdcEnable(true), mt_soc_afe_control.c:1553-1566 */
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+			   AFE_ADDA_UL_DL_CON0_EN, AFE_ADDA_UL_DL_CON0_EN);
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+			   AFE_ADDA_UL_SRC_CON0_EN, AFE_ADDA_UL_SRC_CON0_EN);
+
+	priv->adc_path_on = true;
+
+	return 0;
+}
+
+static void mt6735_afe_adc_disable(struct mtk_base_afe *afe)
+{
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+
+	regmap_update_bits(afe->regmap, AFE_ADDA_UL_SRC_CON0,
+			   AFE_ADDA_UL_SRC_CON0_EN, 0);
+
+	if (!priv->dac_path_on)
+		regmap_update_bits(afe->regmap, AFE_ADDA_UL_DL_CON0,
+				   AFE_ADDA_UL_DL_CON0_EN, 0);
+
+	priv->adc_path_on = false;
+}
+
+static int mt6735_afe_fe_startup(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	int id = dai->id;
+	int ret;
+
+	ret = pm_runtime_get_sync(afe->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(afe->dev);
+		return ret;
+	}
+
+	afe->memif[id].substream = substream;
+	snd_soc_set_runtime_hwparams(substream, afe->mtk_afe_hardware);
+
+	/*
+	 * The memory interface consumes whole 64 byte blocks
+	 * (Align64ByteSize(), mt_soc_afe_control.c:3702-3710) and the DL1
+	 * buffer index is masked with 0xffffffc0 in the interrupt handler
+	 * (mt_soc_afe_control.c:3025,3065).
+	 */
+	ret = snd_pcm_hw_constraint_step(runtime, 0,
+					 SNDRV_PCM_HW_PARAM_BUFFER_BYTES, 64);
+	if (ret < 0)
+		goto err_put;
+
+	ret = snd_pcm_hw_constraint_integer(runtime, SNDRV_PCM_HW_PARAM_PERIODS);
+	if (ret < 0)
+		goto err_put;
+
+	/*
+	 * Capture keeps a ping-pong buffer in the AFE, so the reported read
+	 * pointer can trail the interrupt point by up to a period.
+	 */
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		ret = snd_pcm_hw_constraint_minmax(runtime,
+						   SNDRV_PCM_HW_PARAM_PERIODS, 3,
+						   runtime->hw.periods_max);
+		if (ret < 0)
+			goto err_put;
+	}
+
+	return 0;
+
+err_put:
+	afe->memif[id].substream = NULL;
+	pm_runtime_put_noidle(afe->dev);
+	return ret;
+}
+
+static void mt6735_afe_fe_shutdown(struct snd_pcm_substream *substream,
+				   struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	afe->memif[dai->id].substream = NULL;
+
+	/*
+	 * EnableAfe(false) returns the PMIC audio pins to GPIO mode once no
+	 * memory interface is running (AudDrv_Gpio.c:215-236).
+	 */
+	if (!mt6735_afe_playback_enabled(afe) && !mt6735_afe_capture_enabled(afe))
+		mt6735_afe_select_pmic_pins(afe, false);
+
+	pm_runtime_put(afe->dev);
+}
+
+static int mt6735_afe_fe_hw_params(struct snd_pcm_substream *substream,
+				   struct snd_pcm_hw_params *params,
+				   struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct mtk_base_afe_memif *memif = &afe->memif[dai->id];
+	const struct mtk_base_memif_data *data = memif->data;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	unsigned int mono;
+	int fs;
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	    dai->id == MT6735_AFE_DAI_VUL)
+		return -EINVAL;
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE &&
+	    dai->id != MT6735_AFE_DAI_VUL)
+		return -EINVAL;
+
+	fs = mt6735_afe_rate_to_fs(rate);
+	if (fs < 0)
+		return -EINVAL;
+	if (channels < MT6735_AFE_CHANNELS_MIN ||
+	    channels > MT6735_AFE_CHANNELS_MAX)
+		return -EINVAL;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+	case SNDRV_PCM_FORMAT_S24_LE:
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!runtime->dma_bytes || !runtime->dma_addr)
+		return -EINVAL;
+
+	/*
+	 * The AFE memory interfaces only decode 32 bit addresses.  A 33 bit
+	 * address would need AFE_MEMIF_MSB (AudDrv_Afe.h:470), which the
+	 * downstream driver never programs.
+	 */
+	if (upper_32_bits(runtime->dma_addr))
+		return -EINVAL;
+
+	/* SetDL1Buffer()/SetDL2Buffer(), mt_soc_pcm_dl1.c:234-255 */
+	regmap_write(afe->regmap, data->reg_ofs_base,
+		     lower_32_bits(runtime->dma_addr));
+	regmap_write(afe->regmap, data->reg_ofs_end,
+		     lower_32_bits(runtime->dma_addr) + runtime->dma_bytes - 1);
+
+	memif->phys_buf_addr = lower_32_bits(runtime->dma_addr);
+	memif->buffer_size = runtime->dma_bytes;
+	memif->dma_area = runtime->dma_area;
+	memif->dma_addr = runtime->dma_addr;
+	memif->dma_bytes = runtime->dma_bytes;
+
+	/* SetSampleRate(), mt_soc_afe_control.c:1073-1128 */
+	regmap_update_bits(afe->regmap, data->fs_reg,
+			   data->fs_maskbit << data->fs_shift,
+			   fs << data->fs_shift);
+
+	/* SetChannels(), mt_soc_afe_control.c:1129-1160 */
+	mono = (channels == 1) ? 1 : 0;
+	regmap_update_bits(afe->regmap, data->mono_reg,
+			   BIT(data->mono_shift), mono << data->mono_shift);
+
+	return 0;
+}
+
+static int mt6735_afe_fe_prepare(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	const struct mtk_base_memif_data *data = afe->memif[dai->id].data;
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct mt6735_afe_priv *priv = mt6735_afe_priv(afe);
+	bool wlen24 = (runtime->format == SNDRV_PCM_FORMAT_S24_LE);
+	unsigned int wlen;
+
+	/*
+	 * EnableAfe(true) also switches the PMIC audio bus pins to their
+	 * audio function (AudDrv_Gpio.c:215-236, AudDrv_GPIO_PMIC_Select()).
+	 * This runs from prepare because trigger is atomic.
+	 */
+	mt6735_afe_select_pmic_pins(afe, true);
+
+	/* SetMemIfFetchFormatPerSample(), mt_soc_afe_control.c:2294-2369 */
+	wlen = wlen24 ? AFE_WLEN_24_BIT : AFE_WLEN_16_BIT;
+	regmap_update_bits(afe->regmap, data->hd_reg,
+			   AFE_MEMIF_PBUF_FMT_MASK << data->hd_shift,
+			   wlen << data->hd_shift);
+
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+		mt6735_afe_set_conn_width(afe, dai->id, wlen24);
+		if (priv->dac_path_on)
+			return 0;
+		return mt6735_afe_dac_prepare(afe, runtime->rate, wlen24);
+	}
+
+	mt6735_afe_set_conn_width(afe, dai->id, wlen24);
+	if (priv->adc_path_on)
+		return 0;
+	return mt6735_afe_adc_prepare(afe, runtime->rate);
+}
+
+static int mt6735_afe_fe_trigger(struct snd_pcm_substream *substream, int cmd,
+				 struct snd_soc_dai *dai)
+{
+	struct mtk_base_afe *afe = snd_soc_dai_get_drvdata(dai);
+	int id = dai->id;
+	int ret;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		ret = mt6735_afe_connect(afe, id, true);
+		if (ret)
+			return ret;
+
+		ret = mt6735_afe_memif_enable(afe, id, true);
+		if (ret)
+			return ret;
+
+		/*
+		 * irq_add_user(), mt_soc_afe_control.c:4013-4062: program the
+		 * sample rate and counter, then enable the interrupt.
+		 */
+		return mt6735_afe_irq_update(afe, afe->memif[id].irq_usage);
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		mt6735_afe_memif_enable(afe, id, false);
+		mt6735_afe_irq_update(afe, afe->memif[id].irq_usage);
+		mt6735_afe_connect(afe, id, false);
+
+		/* mt_soc_pcm_dl1.c:347-358 / mt_soc_pcm_capture.c:101-116 */
+		if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
+			if (!mt6735_afe_playback_enabled(afe))
+				mt6735_afe_dac_disable(afe);
+		} else {
+			if (!mt6735_afe_capture_enabled(afe))
+				mt6735_afe_adc_disable(afe);
+		}
+
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct snd_soc_dai_ops mt6735_afe_fe_ops = {
+	.startup = mt6735_afe_fe_startup,
+	.shutdown = mt6735_afe_fe_shutdown,
+	.hw_params = mt6735_afe_fe_hw_params,
+	.prepare = mt6735_afe_fe_prepare,
+	.trigger = mt6735_afe_fe_trigger,
+};
+
+/*
+ * The PCM DAI id doubles as the memory interface index.  DL1 must stay the
+ * first entry: ASoC assigns id 0 to the first DAI of an array when its
+ * driver id is 0 (snd_soc_register_dai(), soc-core.c:2728-2735).
+ */
+const struct snd_soc_dai_driver mt6735_afe_pcm_dais[MT6735_AFE_PCM_DAI_NUM] = {
+	[MT6735_AFE_DAI_DL1] = {
+		.name = "mt-soc-dl1dai-driver",
+		.id = MT6735_AFE_DAI_DL1,
+		.ops = &mt6735_afe_fe_ops,
+		.playback = {
+			.stream_name = "DL1 Playback",
+			.channels_min = MT6735_AFE_CHANNELS_MIN,
+			.channels_max = MT6735_AFE_CHANNELS_MAX,
+			.rates = MT6735_AFE_RATES,
+			.rate_min = MT6735_AFE_RATE_MIN,
+			.rate_max = MT6735_AFE_RATE_MAX,
+			.formats = MT6735_AFE_FORMATS,
+		},
+	},
+	[MT6735_AFE_DAI_DL2] = {
+		.name = "mt-soc-dl2dai-driver",
+		.id = MT6735_AFE_DAI_DL2,
+		.ops = &mt6735_afe_fe_ops,
+		.playback = {
+			.stream_name = "DL2 Playback",
+			.channels_min = MT6735_AFE_CHANNELS_MIN,
+			.channels_max = MT6735_AFE_CHANNELS_MAX,
+			.rates = MT6735_AFE_RATES,
+			.rate_min = MT6735_AFE_RATE_MIN,
+			.rate_max = MT6735_AFE_RATE_MAX,
+			.formats = MT6735_AFE_FORMATS,
+		},
+	},
+	[MT6735_AFE_DAI_VUL] = {
+		.name = "mt-soc-ul1dai-driver",
+		.id = MT6735_AFE_DAI_VUL,
+		.ops = &mt6735_afe_fe_ops,
+		.capture = {
+			.stream_name = "UL1 Capture",
+			.channels_min = MT6735_AFE_CHANNELS_MIN,
+			.channels_max = MT6735_AFE_CHANNELS_MAX,
+			.rates = MT6735_AFE_RATES,
+			.rate_min = MT6735_AFE_RATE_MIN,
+			.rate_max = MT6735_AFE_RATE_MAX,
+			.formats = MT6735_AFE_FORMATS,
+		},
+	},
+};
diff --git a/sound/soc/mediatek/mt6735/mt6735-mt6331.c b/sound/soc/mediatek/mt6735/mt6735-mt6331.c
new file mode 100644
index 000000000..7475c2b58
--- /dev/null
+++ b/sound/soc/mediatek/mt6735/mt6735-mt6331.c
@@ -0,0 +1,436 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * mt6735-mt6331.c -- MT6735 / MT6331 sound card machine driver
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * Port from Samsung/MTK downstream
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_machine.c
+ *   sound/soc/mediatek/mt_soc_audio_v3/AudDrv_Def.h
+ *
+ * The downstream driver built its PCM/platform devices from static tables and
+ * registered the card through platform_device_alloc("soc-audio").  This port
+ * keeps the card name, DAI-link names, stream names and CPU/codec DAI names of
+ * the ROM, but registers the card as an ordinary platform driver whose device
+ * is described by "mediatek,mt6735-sound".
+ *
+ * Headset detection: the downstream machine driver had no jack at all; the
+ * ACCDET driver (drivers/misc/mediatek/accdet) registered its own input device
+ * and reported KEY_PLAYPAUSE/KEY_VOLUMEUP/KEY_VOLUMEDOWN/KEY_VOICECOMMAND on
+ * it.  This driver instead owns a single ASoC jack, lets the ASoC jack supply
+ * the input device, and translates the ACCDET blocking-notifier events into
+ * snd_soc_jack_report() calls.  That deliberately avoids the duplicate
+ * reporting path of the downstream driver, where both ACCDET and (on some
+ * projects) the codec reported the same keys.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 as published by
+ * the Free Software Foundation.
+ */
+
+#include <linux/input.h>
+#include <linux/mfd/mt6328/accdet.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/notifier.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <sound/jack.h>
+#include <sound/soc.h>
+
+/* Card name, mt_soc_machine.c:1138 */
+#define MT6735_CARD_NAME	"mt-snd-card"
+
+/* Stream names, AudDrv_Def.h:311-329 */
+#define MT6735_MM1_STREAM	"MultiMedia1_PLayback"
+#define MT6735_MM2_STREAM	"MultiMedia1_Capture"
+#define MT6735_DL2_STREAM	"MultiMedia2_PLayback"
+#define MT6735_I2S0_STREAM	"I2S0_PLayback"
+
+#define MT6735_JACK_BTN_MASK	(SND_JACK_BTN_0 | SND_JACK_BTN_1 | \
+				 SND_JACK_BTN_2 | SND_JACK_BTN_3)
+#define MT6735_JACK_MASK	(SND_JACK_HEADSET | MT6735_JACK_BTN_MASK)
+
+struct mt6735_mt6331_priv {
+	struct snd_soc_card card;
+	struct snd_soc_jack jack;
+	struct notifier_block accdet_nb;
+	struct accdet_state state;
+	struct mutex lock;	/* protects state, have_state, jack_ready */
+	bool have_state;
+	bool jack_ready;
+	bool jack_created;
+	bool accdet_registered;
+	unsigned int button_bit;	/* last pressed key, for its release */
+};
+
+/*
+ * FrontEnd DAI links, mt_soc_machine.c:858-884 and 1098-1106.
+ *
+ * The three multimedia links carry the on-SoC codec (MT6331 downlink/uplink)
+ * and therefore leave .dai_fmt unset: downstream never programmed an interface
+ * format for them, the AFE and the codec DAI selected their own internal
+ * formats.  I2S0 is a real four-wire interface; its format follows the AFE
+ * I2S configuration that downstream writes into AFE_I2S_CON/I2S_CON3
+ * (mt_soc_pcm_dl1_i2s0.c:183-193, mt_soc_digital_type.h:236-262):
+ * I2S mode (Soc_Aud_I2S_FORMAT_I2S), LRCK not inverted
+ * (Soc_Aud_INV_LRCK_NO_INVERSE), no LR swap (Soc_Aud_LR_SWAP_NO_SWAP) and the
+ * AFE as clock master (Soc_Aud_I2S_SRC_MASTER_MODE) => NB_NF | CBC_CFC.
+ */
+SND_SOC_DAILINK_DEFS(mm1,
+	DAILINK_COMP_ARRAY(COMP_CPU("mt-soc-dl1dai-driver")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("mt-soc-codec", "mt-soc-codec-tx-dai")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(mm2,
+	DAILINK_COMP_ARRAY(COMP_CPU("mt-soc-ul1dai-driver")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("mt-soc-codec", "mt-soc-codec-rx-dai")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(dl2,
+	DAILINK_COMP_ARRAY(COMP_CPU("mt-soc-dl2dai-driver")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("mt-soc-codec", "mt-soc-codec-tx-dai2")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+SND_SOC_DAILINK_DEFS(i2s0,
+	DAILINK_COMP_ARRAY(COMP_CPU("mt-soc-i2s0dai-driver")),
+	DAILINK_COMP_ARRAY(COMP_CODEC("snd-soc-dummy", "snd-soc-dummy-dai")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_jack_pin mt6735_mt6331_jack_pins[] = {
+	{
+		.pin = "Headphone",
+		.mask = SND_JACK_HEADPHONE,
+	},
+	{
+		.pin = "Headset Mic",
+		.mask = SND_JACK_MICROPHONE,
+	},
+};
+
+/*
+ * Card-level jack pins.  These are not routing widgets: they are the DAPM
+ * anchors snd_soc_jack_report() toggles when the ACCDET reports a plug event,
+ * exactly like the headset pins of the other MediaTek machine drivers.  All
+ * audio routing stays in the codec and AFE, so no routes are added here.
+ */
+static const struct snd_soc_dapm_widget mt6735_mt6331_jack_widgets[] = {
+	SND_SOC_DAPM_HP("Headphone", NULL),
+	SND_SOC_DAPM_MIC("Headset Mic", NULL),
+};
+
+static int mt6735_mt6331_mm1_init(struct snd_soc_pcm_runtime *rtd);
+static void mt6735_mt6331_mm1_exit(struct snd_soc_pcm_runtime *rtd);
+
+static struct snd_soc_dai_link mt6735_mt6331_dai_links[] = {
+	{
+		.name = "MultiMedia1",
+		.stream_name = MT6735_MM1_STREAM,
+		.init = mt6735_mt6331_mm1_init,
+		.exit = mt6735_mt6331_mm1_exit,
+		.playback_only = 1,
+		SND_SOC_DAILINK_REG(mm1),
+	},
+	{
+		.name = "MultiMedia2",
+		.stream_name = MT6735_MM2_STREAM,
+		.capture_only = 1,
+		SND_SOC_DAILINK_REG(mm2),
+	},
+	{
+		.name = "MultiMedia_DL2",
+		.stream_name = MT6735_DL2_STREAM,
+		.playback_only = 1,
+		SND_SOC_DAILINK_REG(dl2),
+	},
+	{
+		.name = "I2S0OUTPUT",
+		.stream_name = MT6735_I2S0_STREAM,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+			   SND_SOC_DAIFMT_CBC_CFC,
+		SND_SOC_DAILINK_REG(i2s0),
+	},
+};
+
+/*
+ * ACCDET button index -> ASoC jack button.  The indices are ordered by
+ * increasing mic-ADC voltage (accdet.h, enum accdet_button), which matches
+ * the downstream four-key detection (accdet.c:712-769).  The keycodes are the
+ * ones downstream reports on its own input device.
+ */
+static unsigned int mt6735_mt6331_button_bit(int button)
+{
+	switch (button) {
+	case ACCDET_BUTTON_MEDIA:
+		return SND_JACK_BTN_0;	/* KEY_PLAYPAUSE */
+	case ACCDET_BUTTON_VOICE:
+		return SND_JACK_BTN_1;	/* KEY_VOICECOMMAND */
+	case ACCDET_BUTTON_VOLUP:
+		return SND_JACK_BTN_2;	/* KEY_VOLUMEUP */
+	case ACCDET_BUTTON_VOLDOWN:
+		return SND_JACK_BTN_3;	/* KEY_VOLUMEDOWN */
+	case ACCDET_BUTTON_NONE:
+	default:
+		return 0;
+	}
+}
+
+/*
+ * Cable type -> jack status.  The ROM distinguishes a three-pole headphone
+ * (HEADPHONE) from a four-pole headset with microphone (HEADSET_MIC,
+ * accdet.c:989-1057); the MT6328 ACCDET driver additionally reports a
+ * five-pole headset, which is electrically a four-pole cable with a second
+ * ground ring and is reported as a headset.
+ */
+static unsigned int mt6735_mt6331_plug_status(const struct accdet_state *state)
+{
+	if (!state->plugged)
+		return 0;
+
+	switch (state->cable) {
+	case ACCDET_CABLE_HEADPHONE:
+		return SND_JACK_HEADPHONE;
+	case ACCDET_CABLE_HEADSET:
+	case ACCDET_CABLE_HEADSET_5POLE:
+		return SND_JACK_HEADSET;
+	case ACCDET_CABLE_NONE:
+	case ACCDET_CABLE_UNKNOWN:
+	default:
+		return 0;
+	}
+}
+
+/*
+ * ACCDET emits no notification for the state it finds at probe time, so the
+ * machine driver asks for it explicitly.  The call fails with -ENODEV when
+ * ACCDET is not built in or has not probed yet; a later event will update the
+ * cache in that case.
+ */
+static void mt6735_mt6331_seed_state(struct mt6735_mt6331_priv *priv)
+{
+	struct accdet_state state;
+
+	if (priv->have_state)
+		return;
+
+	if (accdet_get_state(&state))
+		return;
+
+	priv->state = state;
+	priv->have_state = true;
+}
+
+static int mt6735_mt6331_accdet_notify(struct notifier_block *nb,
+				       unsigned long event, void *data)
+{
+	struct mt6735_mt6331_priv *priv =
+		container_of(nb, struct mt6735_mt6331_priv, accdet_nb);
+	const struct accdet_state *state = data;
+	unsigned int status, mask;
+
+	if (!state)
+		return NOTIFY_DONE;
+
+	if (event != ACCDET_EVENT_PLUG && event != ACCDET_EVENT_BUTTON)
+		return NOTIFY_DONE;
+
+	/*
+	 * Cache the state so that a notification that arrives before the card
+	 * is bound is replayed when the jack is created in mm1_init().  The
+	 * ACCDET notification is a blocking notifier, so sleeping is fine.
+	 */
+	mutex_lock(&priv->lock);
+	priv->state = *state;
+	priv->have_state = true;
+
+	if (event == ACCDET_EVENT_PLUG) {
+		status = mt6735_mt6331_plug_status(state);
+		mask = MT6735_JACK_MASK;
+		if (!state->plugged)
+			priv->button_bit = 0;
+	} else if (state->button != ACCDET_BUTTON_NONE) {
+		priv->button_bit = mt6735_mt6331_button_bit(state->button);
+		status = priv->button_bit;
+		mask = MT6735_JACK_BTN_MASK;
+	} else {
+		/*
+		 * Release carries ACCDET_BUTTON_NONE; release the key whose
+		 * press we remembered.  Fall back to all buttons if a press
+		 * was missed.
+		 */
+		status = 0;
+		mask = priv->button_bit ? priv->button_bit :
+					 MT6735_JACK_BTN_MASK;
+		priv->button_bit = 0;
+	}
+
+	if (priv->jack_ready)
+		snd_soc_jack_report(&priv->jack, status, mask);
+	mutex_unlock(&priv->lock);
+
+	return NOTIFY_OK;
+}
+
+static int mt6735_mt6331_mm1_init(struct snd_soc_pcm_runtime *rtd)
+{
+	struct snd_soc_card *card = rtd->card;
+	struct mt6735_mt6331_priv *priv = snd_soc_card_get_drvdata(card);
+	struct snd_soc_component *component =
+		snd_soc_rtd_to_codec(rtd, 0)->component;
+	int ret;
+
+	if (!priv->jack_created) {
+		ret = snd_soc_dapm_new_controls(snd_soc_card_to_dapm(card),
+						mt6735_mt6331_jack_widgets,
+						ARRAY_SIZE(mt6735_mt6331_jack_widgets));
+		if (ret) {
+			dev_err(rtd->dev, "failed to add jack pins: %d\n", ret);
+			return ret;
+		}
+
+		ret = snd_soc_card_jack_new_pins(card, "Headset Jack",
+						 MT6735_JACK_MASK, &priv->jack,
+						 mt6735_mt6331_jack_pins,
+						 ARRAY_SIZE(mt6735_mt6331_jack_pins));
+		if (ret) {
+			dev_err(rtd->dev, "failed to create jack: %d\n", ret);
+			return ret;
+		}
+
+		snd_jack_set_key(priv->jack.jack, SND_JACK_BTN_0,
+				 KEY_PLAYPAUSE);
+		snd_jack_set_key(priv->jack.jack, SND_JACK_BTN_1,
+				 KEY_VOICECOMMAND);
+		snd_jack_set_key(priv->jack.jack, SND_JACK_BTN_2,
+				 KEY_VOLUMEUP);
+		snd_jack_set_key(priv->jack.jack, SND_JACK_BTN_3,
+				 KEY_VOLUMEDOWN);
+		priv->jack_created = true;
+	}
+
+	ret = snd_soc_component_set_jack(component, &priv->jack, NULL);
+	if (ret == -ENOTSUPP || ret == -EOPNOTSUPP) {
+		/*
+		 * The codec DAI does not implement jack detection; the jack is
+		 * driven by ACCDET, so the card is still fully usable.
+		 */
+		dev_warn(rtd->dev, "codec %s has no set_jack, using ACCDET only\n",
+			 component->name);
+		ret = 0;
+	} else if (ret) {
+		dev_err(rtd->dev, "failed to set jack on %s: %d\n",
+			component->name, ret);
+		return ret;
+	}
+
+	mutex_lock(&priv->lock);
+	priv->jack_ready = true;
+	mt6735_mt6331_seed_state(priv);
+	if (priv->have_state) {
+		unsigned int status = 0;
+		unsigned int mask = MT6735_JACK_MASK;
+
+		priv->button_bit = 0;
+		if (priv->state.plugged) {
+			status = mt6735_mt6331_plug_status(&priv->state);
+			priv->button_bit =
+				mt6735_mt6331_button_bit(priv->state.button);
+			status |= priv->button_bit;
+		}
+		snd_soc_jack_report(&priv->jack, status, mask);
+	}
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+
+static void mt6735_mt6331_mm1_exit(struct snd_soc_pcm_runtime *rtd)
+{
+	struct mt6735_mt6331_priv *priv = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_component *component =
+		snd_soc_rtd_to_codec(rtd, 0)->component;
+
+	mutex_lock(&priv->lock);
+	priv->jack_ready = false;
+	mutex_unlock(&priv->lock);
+
+	snd_soc_component_set_jack(component, NULL, NULL);
+}
+
+static int mt6735_mt6331_probe(struct platform_device *pdev)
+{
+	struct mt6735_mt6331_priv *priv;
+	int ret;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	mutex_init(&priv->lock);
+	priv->accdet_nb.notifier_call = mt6735_mt6331_accdet_notify;
+
+	priv->card.name = MT6735_CARD_NAME;
+	priv->card.dev = &pdev->dev;
+	priv->card.owner = THIS_MODULE;
+	priv->card.dai_link = mt6735_mt6331_dai_links;
+	priv->card.num_links = ARRAY_SIZE(mt6735_mt6331_dai_links);
+	snd_soc_card_set_drvdata(&priv->card, priv);
+	platform_set_drvdata(pdev, priv);
+
+	/*
+	 * Subscribe before registering the card so that an ACCDET event during
+	 * binding is cached and replayed by mm1_init().
+	 */
+	ret = accdet_register_notifier(&priv->accdet_nb);
+	if (ret) {
+		if (ret != -ENODEV)
+			return ret;
+		dev_warn(&pdev->dev, "ACCDET not available, no jack reporting\n");
+	} else {
+		priv->accdet_registered = true;
+	}
+
+	mutex_lock(&priv->lock);
+	mt6735_mt6331_seed_state(priv);
+	mutex_unlock(&priv->lock);
+
+	ret = devm_snd_soc_register_card(&pdev->dev, &priv->card);
+	if (ret) {
+		if (priv->accdet_registered)
+			accdet_unregister_notifier(&priv->accdet_nb);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void mt6735_mt6331_remove(struct platform_device *pdev)
+{
+	struct mt6735_mt6331_priv *priv = platform_get_drvdata(pdev);
+
+	if (priv->accdet_registered) {
+		accdet_unregister_notifier(&priv->accdet_nb);
+		priv->accdet_registered = false;
+	}
+}
+
+static const struct of_device_id mt6735_mt6331_of_match[] = {
+	{ .compatible = "mediatek,mt6735-sound" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6735_mt6331_of_match);
+
+static struct platform_driver mt6735_mt6331_driver = {
+	.driver = {
+		.name = "mt6735-mt6331-sound",
+		.of_match_table = mt6735_mt6331_of_match,
+	},
+	.probe = mt6735_mt6331_probe,
+	.remove = mt6735_mt6331_remove,
+};
+module_platform_driver(mt6735_mt6331_driver);
