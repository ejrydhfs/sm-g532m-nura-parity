+ */
+
+#include <linux/module.h>
+
+#include "wmt_local.h"
+
+/* Downstream ENUM_WMTTHERM_TYPE_T (wmt_exp.h:71-78). */
+#define WMTTHERM_ENABLE		1
+#define WMTTHERM_READ		2
+#define WMTTHERM_DISABLE	3
+#define WMTTHERM_MAX		4
+
+static bool wmt_public_op(enum wmt_opid op_id, enum mtk_wcn_wmt_drv type)
+{
+	struct wmt_op op = {
+		.op_id = op_id,
+		.data = { type },
+	};
+	bool ret;
+
+	if (!g_wmt.ready)
+		return false;
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	ret = wmt_lib_run_op(&op) == 0;
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ret;
+}
+
+bool mtk_wcn_wmt_func_on(enum mtk_wcn_wmt_drv type)
+{
+	if (type > WMTDRV_WIFI) {
+		wmt_warn("function %d is not supported\n", type);
+		return false;
+	}
+
+	return wmt_public_op(WMT_OPID_FUNC_ON, type);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_func_on);
+
+bool mtk_wcn_wmt_func_off(enum mtk_wcn_wmt_drv type)
+{
+	if (type > WMTDRV_WIFI) {
+		wmt_warn("function %d is not supported\n", type);
+		return false;
+	}
+
+	return wmt_public_op(WMT_OPID_FUNC_OFF, type);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_func_off);
+
+int mtk_wcn_wmt_msgcb_reg(enum mtk_wcn_wmt_drv type, mtk_wcn_wmt_msgcb cb)
+{
+	if (type < 0 || type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	g_wmt.msgcb[type] = cb;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_msgcb_reg);
+
+int mtk_wcn_wmt_msgcb_unreg(enum mtk_wcn_wmt_drv type)
+{
+	if (type < 0 || type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	g_wmt.msgcb[type] = NULL;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_msgcb_unreg);
+
+/* wmt_exp.c:426-462 */
+int mtk_wcn_wmt_wlan_reg(const struct mtk_wcn_wmt_wlan_cb *cb)
+{
+	if (!cb || !cb->probe || !cb->remove)
+		return -EINVAL;
+
+	memcpy(&g_wmt.wlan_cb, cb, sizeof(g_wmt.wlan_cb));
+	wmt_info("WLAN driver registered\n");
+
+	if (g_wmt.wlan_probed) {
+		int ret = cb->probe();
+
+		if (ret) {
+			wmt_err("deferred WLAN probe failed (%d)\n", ret);
+			return ret;
+		}
+		g_wmt.wlan_probed = false;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wlan_reg);
+
+int mtk_wcn_wmt_wlan_unreg(void)
+{
+	memset(&g_wmt.wlan_cb, 0, sizeof(g_wmt.wlan_cb));
+	wmt_info("WLAN driver unregistered\n");
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wlan_unreg);
+
+/* wmt_exp.c:340-400 */
+bool mtk_wcn_wmt_assert(enum mtk_wcn_wmt_drv type, u32 reason)
+{
+	struct wmt_op op = { .op_id = WMT_OPID_ASSERT };
+	unsigned long pa1 = 0, pa2 = 0;
+	bool ret;
+
+	if (type < 0 || type >= WMTDRV_MAX)
+		return false;
+
+	if (!g_wmt.ready)
+		return false;
+
+	wmt_warn("driver %d asserts the firmware (reason %u)\n", type, reason);
+
+	/* Wake the connectivity MCU before sending the assert command; the
+	 * downstream driver does the same through the STP power-saving engine
+	 * (wmt_exp.c:209).
+	 */
+	wmt_core_ctrl(WMT_CTRL_SOC_WAKEUP_CONSYS, &pa1, &pa2);
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	ret = wmt_lib_run_op(&op) == 0;
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_assert);
+
+int mtk_wcn_wmt_system_state_reset(void)
+{
+	g_wmt.func_on_bits = 0;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_system_state_reset);
+
+/* wmt_exp.c:265-335 */
+bool mtk_wcn_wmt_dsns_ctrl(enum mtk_wcn_wmt_dsns type)
+{
+	struct wmt_op op = {
+		.op_id = WMT_OPID_DSNS,
+		.data = { WMTDRV_FM, type },
+	};
+	bool ok;
+
+	if (type >= WMTDSNS_MAX)
+		return false;
+
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready())
+		return false;
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	ok = wmt_lib_run_op(&op) == 0;
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ok;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_dsns_ctrl);
+
+/* wmt_exp.c:180-260 */
+s8 mtk_wcn_wmt_therm_ctrl(u8 type)
+{
+	struct wmt_op op = { .op_id = WMT_OPID_THERM_CTRL };
+	s8 ret;
+
+	if (type < WMTTHERM_ENABLE || type >= WMTTHERM_MAX) {
+		wmt_err("invalid thermal control command %u\n", type);
+		return 0;
+	}
+
+	if (!g_wmt.ready || !mtk_wcn_stp_is_ready()) {
+		wmt_err("thermal control needs a ready STP\n");
+		return 0;
+	}
+
+	op.data[0] = type;
+
+	wmt_plat_wake_lock_ctrl(WL_OP_GET);
+	if (wmt_lib_run_op(&op)) {
+		wmt_warn("thermal command %u failed\n", type);
+		ret = type == WMTTHERM_READ ? (s8)0xff : 0;
+	} else {
+		ret = (s8)op.data[1];
+	}
+	wmt_plat_wake_lock_ctrl(WL_OP_PUT);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_therm_ctrl);
+
+enum mtk_wcn_wmt_hwver mtk_wcn_wmt_hwver_get(void)
+{
+	return wmt_lib_hwver();
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_hwver_get);
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_chrdev_wifi.c b/drivers/misc/mediatek/connectivity/wmt/wmt_chrdev_wifi.c
new file mode 100644
index 000000000..0b3000d04
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_chrdev_wifi.c
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN /dev/wmtWifi power control channel.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pub/wmt_chrdev_wifi.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The Wi-Fi HAL powers the WCN Wi-Fi function by writing '1' (on) or '0'
+ * (off) to /dev/wmtWifi.  The downstream driver also forwarded 'D<n>' debug
+ * level changes and P2P/AP mode reconfiguration to the WLAN driver; neither
+ * is part of the frozen WMT interface, so Wi-Fi recovery after a WCN reset is
+ * left to the WLAN driver's WMTMSG_RESET callback.
+ */
+
+#include <linux/cdev.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "wmt_local.h"
+
+/* wmt_chrdev_wifi.c:39-41 */
+#define WIFI_DRIVER_NAME	"wmtWifi"
+#define WIFI_DEV_MAJOR		153
+
+/* wmt_chrdev_wifi.c:170-180 */
+static int wifi_major = WIFI_DEV_MAJOR;
+module_param(wifi_major, uint, 0444);
+
+static struct cdev wifi_cdev;
+static struct class *wifi_class;
+
+enum wifi_power_state {
+	WIFI_POWER_OFF,
+	WIFI_POWER_ON,
+};
+
+static enum wifi_power_state wifi_powered = WIFI_POWER_OFF;
+static DEFINE_MUTEX(wifi_mutex);
+
+/* wmt_chrdev_wifi.c:185-196 */
+#define WMT_CHECK_DO_CHIP_RESET()					\
+	do {								\
+		wmt_err("Wi-Fi power control failed, asserting CONNSYS\n"); \
+		mtk_wcn_wmt_assert(WMTDRV_WIFI, 0x40);			\
+	} while (0)
+
+static int wifi_open(struct inode *inode, struct file *file)
+{
+	wmt_dbg("wmtWifi open by pid %d\n", current->pid);
+	return 0;
+}
+
+static int wifi_release(struct inode *inode, struct file *file)
+{
+	wmt_dbg("wmtWifi release by pid %d\n", current->pid);
+	return 0;
+}
+
+/* wmt_chrdev_wifi.c:349-470 */
+static ssize_t wifi_write(struct file *file, const char __user *buf,
+			  size_t count, loff_t *ppos)
+{
+	char cmd[16] = { };
+	size_t len = min(count, sizeof(cmd) - 1);
+	ssize_t ret = count;
+
+	if (!len)
+		return -EINVAL;
+
+	if (copy_from_user(cmd, buf, len))
+		return -EFAULT;
+
+	mutex_lock(&wifi_mutex);
+
+	switch (cmd[0]) {
+	case '0':
+		if (wifi_powered == WIFI_POWER_OFF) {
+			wmt_dbg("Wi-Fi already off\n");
+			break;
+		}
+
+		if (!mtk_wcn_wmt_func_off(WMTDRV_WIFI)) {
+			WMT_CHECK_DO_CHIP_RESET();
+			ret = -EIO;
+			break;
+		}
+
+		wifi_powered = WIFI_POWER_OFF;
+		wmt_info("Wi-Fi powered off\n");
+		break;
+
+	case '1':
+		if (wifi_powered == WIFI_POWER_ON) {
+			wmt_dbg("Wi-Fi already on\n");
+			break;
+		}
+
+		if (!mtk_wcn_wmt_func_on(WMTDRV_WIFI)) {
+			WMT_CHECK_DO_CHIP_RESET();
+			ret = -EIO;
+			break;
+		}
+
+		wifi_powered = WIFI_POWER_ON;
+		wmt_info("Wi-Fi powered on\n");
+		break;
+
+	case 'D':
+		/* Dynamic WLAN debug levels are not part of the frozen WMT
+		 * interface.
+		 */
+		ret = -EOPNOTSUPP;
+		break;
+
+	default:
+		wmt_warn("invalid wmtWifi command '%c'\n", cmd[0]);
+		ret = -EINVAL;
+		break;
+	}
+
+	mutex_unlock(&wifi_mutex);
+	return ret;
+}
+
+static const struct file_operations wifi_fops = {
+	.owner = THIS_MODULE,
+	.open = wifi_open,
+	.release = wifi_release,
+	.write = wifi_write,
+};
+
+int mtk_wcn_wmt_wifi_init(void)
+{
+	dev_t dev = MKDEV(wifi_major, 0);
+	int ret;
+
+	ret = register_chrdev_region(dev, 1, WIFI_DRIVER_NAME);
+	if (ret) {
+		wmt_err("failed to register the wmtWifi device (%d)\n", ret);
+		return ret;
+	}
+
+	cdev_init(&wifi_cdev, &wifi_fops);
+	wifi_cdev.owner = THIS_MODULE;
+
+	ret = cdev_add(&wifi_cdev, dev, 1);
+	if (ret)
+		goto err_region;
+
+	wifi_class = class_create("wmtWifi");
+	if (IS_ERR(wifi_class)) {
+		ret = PTR_ERR(wifi_class);
+		wifi_class = NULL;
+		goto err_cdev;
+	}
+
+	if (IS_ERR(device_create(wifi_class, NULL, dev, NULL, "wmtWifi"))) {
+		ret = -ENODEV;
+		goto err_class;
+	}
+
+	wifi_powered = WIFI_POWER_OFF;
+	wmt_info("/dev/wmtWifi registered (major %d)\n", wifi_major);
+	return 0;
+
+err_class:
+	class_destroy(wifi_class);
+	wifi_class = NULL;
+err_cdev:
+	cdev_del(&wifi_cdev);
+err_region:
+	unregister_chrdev_region(dev, 1);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wifi_init);
+
+void mtk_wcn_wmt_wifi_exit(void)
+{
+	dev_t dev = MKDEV(wifi_major, 0);
+
+	device_destroy(wifi_class, dev);
+	class_destroy(wifi_class);
+	wifi_class = NULL;
+	cdev_del(&wifi_cdev);
+	unregister_chrdev_region(dev, 1);
+	wifi_powered = WIFI_POWER_OFF;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_wmt_wifi_exit);
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_conf.c b/drivers/misc/mediatek/connectivity/wmt/wmt_conf.c
new file mode 100644
index 000000000..bd097e785
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_conf.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT_SOC.cfg parser.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_conf.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The configuration file is a plain "key=value" list in
+ * /system/etc/firmware/WMT_SOC.cfg.  Only the keys used by the ported
+ * functionality are consumed; the coexistence keys of the downstream parser
+ * are accepted and ignored because the coexistence engine is not ported.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+#include "wmt_local.h"
+
+static int wmt_conf_parse_u8(const char *val, u8 *dst)
+{
+	unsigned int tmp;
+	int ret;
+
+	ret = kstrtouint(val, 0, &tmp);
+	if (ret || tmp > 0xff)
+		return -EINVAL;
+
+	*dst = tmp;
+	return 0;
+}
+
+static int wmt_conf_parse_u16(const char *val, u16 *dst)
+{
+	unsigned int tmp;
+	int ret;
+
+	ret = kstrtouint(val, 0, &tmp);
+	if (ret || tmp > 0xffff)
+		return -EINVAL;
+
+	*dst = tmp;
+	return 0;
+}
+
+/* wmt_conf.c:520-560 */
+static int wmt_conf_parse_pair(const char *key, const char *val)
+{
+	struct wmt_gen_conf *conf = &g_wmt.gen_conf;
+	int ret;
+
+	if (!strcmp(key, "co_clock_flag"))
+		ret = wmt_conf_parse_u8(val, &conf->co_clock_flag);
+	else if (!strcmp(key, "wmt_gps_lna_pin"))
+		ret = wmt_conf_parse_u8(val, &conf->wmt_gps_lna_pin);
+	else if (!strcmp(key, "wmt_gps_lna_enable"))
+		ret = wmt_conf_parse_u8(val, &conf->wmt_gps_lna_enable);
+	else if (!strcmp(key, "bt_tssi_from_wifi"))
+		ret = wmt_conf_parse_u8(val, &conf->bt_tssi_from_wifi);
+	else if (!strcmp(key, "bt_tssi_target"))
+		ret = wmt_conf_parse_u16(val, &conf->bt_tssi_target);
+	else
+		return -ENOENT;	/* coexistence/debug key, not ported */
+
+	if (ret)
+		wmt_warn("invalid value '%s' for %s\n", val, key);
+
+	return ret;
+}
+
+/* wmt_conf.c:330-470 */
+static int wmt_conf_parse(const u8 *buf, size_t size)
+{
+	char *line, *next, *eq, *key, *val;
+	char *copy;
+	int ret = 0;
+
+	copy = kmemdup_nul((const char *)buf, size, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+
+	for (line = copy; line && *line; line = next) {
+		next = strchr(line, '\n');
+		if (next)
+			*next++ = '\0';
+
+		line = strim(line);
+		if (!*line)
+			continue;
+
+		eq = strchr(line, '=');
+		if (!eq) {
+			wmt_dbg("malformed config line '%s'\n", line);
+			continue;
+		}
+
+		*eq = '\0';
+		key = strim(line);
+		val = strim(eq + 1);
+
+		if (wmt_conf_parse_pair(key, val) == -EINVAL)
+			ret = -EINVAL;
+	}
+
+	kfree(copy);
+	return ret;
+}
+
+int wmt_conf_read_file(void)
+{
+	struct wmt_gen_conf *conf = &g_wmt.gen_conf;
+	u8 *buf = NULL;
+	size_t size = 0;
+	int ret;
+
+	memset(conf, 0, sizeof(*conf));
+
+	ret = wmt_dev_read_file(g_wmt.cfg_name, &buf, &size);
+	if (ret) {
+		wmt_dbg("cannot read %s (%d)\n", g_wmt.cfg_name, ret);
+		return ret;
+	}
+
+	ret = wmt_conf_parse(buf, size);
+	kfree(buf);
+	if (ret) {
+		wmt_err("failed to parse %s\n", g_wmt.cfg_name);
+		return ret;
+	}
+
+	conf->co_clock_flag &= 0x0f;
+	conf->cfg_exist = true;
+
+	wmt_info("%s: co-clock %u, gps lna pin %u enable %u, bt tssi %u/%u\n",
+		 g_wmt.cfg_name, conf->co_clock_flag, conf->wmt_gps_lna_pin,
+		 conf->wmt_gps_lna_enable, conf->bt_tssi_from_wifi,
+		 conf->bt_tssi_target);
+	return 0;
+}
+
+int wmt_conf_set_cfg_file(const char *name)
+{
+	if (!name || !name[0])
+		return -EINVAL;
+
+	strscpy(g_wmt.cfg_name, name, sizeof(g_wmt.cfg_name));
+	wmt_info("WMT config file set to %s\n", g_wmt.cfg_name);
+	return 0;
+}
+
+const struct wmt_gen_conf *wmt_conf_get(void)
+{
+	return g_wmt.gen_conf.cfg_exist ? &g_wmt.gen_conf : NULL;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_core.c b/drivers/misc/mediatek/connectivity/wmt/wmt_core.c
new file mode 100644
index 000000000..02e3ba1df
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_core.c
@@ -0,0 +1,750 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT control protocol engine.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_core.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_func.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * WMT is the management protocol spoken with the connectivity firmware over
+ * the STP WMT channel.  Every exchange is a command PDU followed by an event
+ * PDU:
+ *
+ *	command: type=1, opcode, len, params...
+ *	event:   type=2, opcode, len, status, params...
+ *
+ * All exchanges are serialised by wmt_lib_run_op() and complete when the
+ * event has been received (or the 2000 ms receive timeout expires).
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+
+/* WMT command/event PDUs (wmt_core.c:203-259, wmt_ic_soc.c:100-160). */
+static const u8 wmt_therm_cmd[] = { 0x01, 0x11, 0x01, 0x00, 0x00 };
+static const u8 wmt_therm_ctrl_evt[] = { 0x02, 0x11, 0x01, 0x00, 0x00 };
+static const u8 wmt_therm_read_evt[] = { 0x02, 0x11, 0x02, 0x00, 0x00, 0x00 };
+static const u8 wmt_dsns_evt[] = { 0x02, 0x0e, 0x01, 0x00, 0x00 };
+static const u8 wmt_assert_cmd[] = { 0x01, 0x02, 0x01, 0x00, 0x08 };
+
+/* WMT_SET_REG_CMD / WR_EVT / RD_EVT (wmt_core.c:236-258) */
+static u8 wmt_set_reg_cmd[] = {
+	0x01, 0x08, 0x10, 0x00,	/* length */
+	0x00,			/* op: w(1) & r(2) */
+	0x01,			/* type: reg */
+	0x00,			/* reserved */
+	0x01,			/* one register */
+	0x00, 0x00, 0x00, 0x00,	/* address */
+	0x00, 0x00, 0x00, 0x00,	/* value */
+	0xff, 0xff, 0xff, 0xff,	/* mask */
+};
+static const u8 wmt_set_reg_wr_evt[] = {
+	0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01,
+};
+static const u8 wmt_set_reg_rd_evt[] = {
+	0x02, 0x08, 0x04, 0x00, 0x00, 0x00, 0x00, 0x01,
+	0x00, 0x00, 0x00, 0x00,	/* address */
+	0x00, 0x00, 0x00, 0x00,	/* value */
+};
+
+static int wmt_core_stp_init(void);
+static int wmt_core_stp_deinit(void);
+static int wmt_core_hw_check(void);
+
+/*
+ * Low level WMT transport helpers
+ */
+
+int wmt_core_tx(const u8 *data, u32 size, u32 *written)
+{
+	u32 retry = 0;
+	int ret;
+
+	*written = 0;
+
+	ret = wmt_ctrl_tx_ex(data, size, written, false);
+	while (ret == -EAGAIN && retry < 3) {
+		wmt_warn("no STP window space, retry %u\n", retry + 1);
+		msleep(360);
+		ret = wmt_ctrl_tx_ex(data, size, written, false);
+		retry++;
+	}
+
+	return ret;
+}
+
+int wmt_core_rx(u8 *buf, u32 len, u32 *read_size)
+{
+	struct wmt_ctrl_data data = { };
+
+	if (read_size)
+		*read_size = 0;
+
+	data.ctrl_id = WMT_CTRL_RX;
+	data.data[0] = (unsigned long)buf;
+	data.data[1] = len;
+	data.data[2] = (unsigned long)read_size;
+
+	return wmt_ctrl(&data);
+}
+
+/* wmt_core.c:428-472 */
+int wmt_core_ctrl(enum wmt_ctrl_id id, unsigned long *pa1, unsigned long *pa2)
+{
+	struct wmt_ctrl_data data = { };
+	int ret;
+
+	data.ctrl_id = id;
+	data.data[0] = pa1 ? *pa1 : 0;
+	data.data[1] = pa2 ? *pa2 : 0;
+
+	ret = wmt_ctrl(&data);
+	if (ret) {
+		wmt_err("ctrl %d failed (%d)\n", id, ret);
+		return ret;
+	}
+
+	if (pa1)
+		*pa1 = data.data[0];
+	if (pa2)
+		*pa2 = data.data[1];
+
+	return 0;
+}
+
+/* wmt_core.c:376-426 */
+int wmt_core_func_ctrl_cmd(enum mtk_wcn_wmt_drv type, bool enable)
+{
+	u8 cmd[WMT_HDR_LEN + WMT_FLAG_LEN + WMT_FUNC_CTRL_PARAM_LEN];
+	u8 evt[WMT_HDR_LEN + WMT_STS_LEN];
+	u32 cmd_len = sizeof(cmd);
+	u32 evt_len = sizeof(evt);
+	u32 written = 0, read = 0;
+	int ret;
+
+	cmd[0] = 0x01;			/* PKT_TYPE_CMD */
+	cmd[1] = 0x06;			/* OPCODE_FUNC_CTRL */
+	cmd[2] = WMT_FLAG_LEN + WMT_FUNC_CTRL_PARAM_LEN;
+	cmd[3] = 0x00;
+	cmd[4] = (u8)type;
+	cmd[5] = enable ? 1 : 0;
+
+	ret = wmt_core_tx(cmd, cmd_len, &written);
+	if (ret || written != cmd_len) {
+		wmt_err("func ctrl tx failed (%d, %u/%u)\n", ret, written,
+			cmd_len);
+		return -EIO;
+	}
+
+	ret = wmt_core_rx(evt, evt_len, &read);
+	if (ret || read != evt_len) {
+		wmt_err("func ctrl rx failed (%d, %u/%u)\n", ret, read, evt_len);
+		return -EIO;
+	}
+
+	if (evt[0] != 0x02 /* PKT_TYPE_EVENT */ ||
+	    evt[1] != cmd[1] || evt[4] != 0) {
+		wmt_err("bad func ctrl event %02x %02x %02x %02x %02x\n",
+			evt[0], evt[1], evt[2], evt[3], evt[4]);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/* wmt_core.c:500-562 */
+int wmt_core_reg_rw_raw(u32 is_write, u32 offset, u32 *val, u32 mask)
+{
+	u8 evt[16] = { };
+	u32 evt_len, written = 0, read = 0;
+	const u8 *exp;
+	u32 tx_addr, rx_addr;
+	int ret;
+
+	wmt_set_reg_cmd[4] = is_write ? 0x1 : 0x2;
+	memcpy(&wmt_set_reg_cmd[8], &offset, 4);
+	memcpy(&wmt_set_reg_cmd[12], val, 4);
+	memcpy(&wmt_set_reg_cmd[16], &mask, 4);
+
+	ret = wmt_core_tx(wmt_set_reg_cmd, sizeof(wmt_set_reg_cmd), &written);
+	if (ret || written != sizeof(wmt_set_reg_cmd)) {
+		wmt_err("reg rw tx failed (%d, %u)\n", ret, written);
+		return -EIO;
+	}
+
+	if (is_write) {
+		exp = wmt_set_reg_wr_evt;
+		evt_len = sizeof(wmt_set_reg_wr_evt);
+	} else {
+		exp = wmt_set_reg_rd_evt;
+		evt_len = sizeof(wmt_set_reg_rd_evt);
+	}
+
+	ret = wmt_core_rx(evt, evt_len, &read);
+	if (ret || read != evt_len) {
+		wmt_err("reg rw rx failed (%d, %u/%u)\n", ret, read, evt_len);
+		return -EIO;
+	}
+
+	/* Event type/opcode must echo the command. */
+	if (evt[0] != exp[0] || evt[1] != exp[1]) {
+		wmt_err("bad register event %02x %02x\n", evt[0], evt[1]);
+		return -EIO;
+	}
+
+	if (is_write)
+		return 0;
+
+	memcpy(&tx_addr, &wmt_set_reg_cmd[8], 4);
+	memcpy(&rx_addr, &evt[8], 4);
+	if (tx_addr != rx_addr) {
+		wmt_err("read address mismatch 0x%08x/0x%08x\n",
+			rx_addr, tx_addr);
+		return -EIO;
+	}
+
+	memcpy(val, &evt[12], 4);
+	return 0;
+}
+
+/* wmt_core.c:598-644 */
+int wmt_core_init_script(const struct wmt_init_script *script, int count)
+{
+	u8 evt[256];
+	u32 written = 0, read = 0;
+	int i, ret;
+
+	for (i = 0; i < count; i++) {
+		ret = wmt_core_tx(script[i].cmd, script[i].cmd_sz, &written);
+		if (ret || written != script[i].cmd_sz) {
+			wmt_err("init script %s tx failed (%d, %u/%u)\n",
+				script[i].str, ret, written, script[i].cmd_sz);
+			return -EIO;
+		}
+
+		memset(evt, 0, sizeof(evt));
+		ret = wmt_core_rx(evt, script[i].evt_sz, &read);
+		if (ret || read != script[i].evt_sz) {
+			wmt_err("init script %s rx failed (%d, %u/%u)\n",
+				script[i].str, ret, read, script[i].evt_sz);
+			return -EIO;
+		}
+
+		/* RF calibration events carry chip data; their contents are
+		 * not compared (wmt_core.c:629-640).
+		 */
+		if (script[i].evt_sz > 1 && evt[1] == 0x14)
+			continue;
+
+		if (memcmp(evt, script[i].evt, script[i].evt_sz)) {
+			wmt_err("init script %s unexpected event\n",
+				script[i].str);
+			return -EIO;
+		}
+	}
+
+	return 0;
+}
+
+/* wmt_core.c:660-667 */
+bool wmt_core_patch_check(u32 patch_ver, u32 hw_ver)
+{
+	if (MAJORNUM(hw_ver) != MAJORNUM(patch_ver)) {
+		wmt_err("hw version 0x%x does not match patch 0x%x\n",
+			hw_ver, patch_ver);
+		return false;
+	}
+
+	return true;
+}
+
+/*
+ * STP bring-up / tear-down around the WMT protocol
+ */
+
+/* wmt_core.c:700-790 */
+static int wmt_core_stp_init(void)
+{
+	struct wmt_hif_conf *hif = wmt_lib_hif();
+	unsigned long pa1 = 0, pa2 = 0;
+	int ret;
+
+	if (!wmt_conf_get())
+		wmt_dbg("no WMT_SOC.cfg, using defaults\n");
+
+	if (!(g_wmt.state & WMT_STAT_STP_OPEN)) {
+		ret = wmt_core_ctrl(WMT_CTRL_STP_OPEN, &pa1, &pa2);
+		if (ret)
+			return ret;
+	}
+
+	/* Disable and un-ready STP while the firmware is reconfigured. */
+	pa1 = WMT_STP_CONF_EN;
+	pa2 = 0;
+	ret = wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	pa1 = WMT_STP_CONF_RDY;
+	pa2 = 0;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+
+	/* The firmware always starts in mandatory mode. */
+	pa1 = WMT_STP_CONF_MODE;
+	pa2 = MTKSTP_BTIF_MAND_MODE;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+
+	pa1 = WMT_STP_CONF_EN;
+	pa2 = 1;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	if (ret)
+		return -EIO;
+
+	ret = wmt_core_hw_check();
+	if (ret)
+		return ret;
+
+	wmt_ic_soc_co_clock_ctrl(wmt_lib_co_clock());
+
+	ret = wmt_ic_soc_sw_init(hif);
+	if (ret) {
+		wmt_err("SOC software init failed (%d)\n", ret);
+		return ret;
+	}
+
+	pa1 = WMT_STP_CONF_RDY;
+	pa2 = 1;
+	return wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+}
+
+/* wmt_core.c:792-845 */
+static int wmt_core_stp_deinit(void)
+{
+	struct wmt_hif_conf *hif = wmt_lib_hif();
+	unsigned long pa1, pa2;
+	int ret;
+
+	wmt_ic_soc_sw_deinit(hif);
+
+	pa1 = WMT_STP_CONF_RDY;
+	pa2 = 0;
+	ret = wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	pa1 = WMT_STP_CONF_EN;
+	pa2 = 0;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+	pa1 = 0;
+	pa2 = 0;
+	ret += wmt_core_ctrl(WMT_CTRL_STP_CLOSE, &pa1, &pa2);
+
+	return ret;
+}
+
+/*
+ * Chip identification (wmt_core.c:861-940)
+ */
+static int wmt_core_hw_check(void)
+{
+	u32 chip_id = 0;
+	int ret;
+
+	ret = wmt_core_reg_rw_raw(false, GEN_HCR, &chip_id, GEN_HCR_MASK);
+	if (ret) {
+		wmt_err("failed to read chip id (%d)\n", ret);
+		return ret;
+	}
+
+	wmt_info("chip id 0x%x\n", chip_id);
+
+	switch (chip_id) {
+	case 0x6572:
+	case 0x6582:
+	case 0x6592:
+	case 0x8127:
+	case 0x6571:
+	case 0x6752:
+	case 0x0279:
+	case 0x0326:
+	case 0x0321:
+	case 0x0335:
+	case 0x0337:
+	case 0x8163:
+	case 0x6580:
+		break;
+	default:
+		wmt_err("unsupported chip id 0x%x\n", chip_id);
+		return -ENODEV;
+	}
+
+	g_wmt.chip_id = chip_id;
+
+	ret = wmt_ic_soc_ver_check();
+	if (ret) {
+		wmt_err("chip 0x%x version check failed (%d)\n", chip_id, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+/*
+ * Operation handlers
+ */
+
+static int opfunc_hif_conf(struct wmt_op *op)
+{
+	if (!(op->info_bit & BIT(0)))
+		return -EINVAL;
+
+	memcpy(&g_wmt.hif, &op->data[0], sizeof(g_wmt.hif));
+	return 0;
+}
+
+/* wmt_core.c:947-1029 */
+static int opfunc_pwr_on(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+	int attempt, ret;
+
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_POWER_OFF) {
+		wmt_err("WMT already powered on (status %d)\n",
+			g_wmt.drv_status[WMTDRV_WMT]);
+		return -EALREADY;
+	}
+
+	if (op->info_bit & BIT(0))
+		opfunc_hif_conf(op);
+
+	for (attempt = 0; attempt <= WMT_PWRON_RTY_DFT; attempt++) {
+		ret = wmt_core_ctrl(WMT_CTRL_HW_PWR_ON, &pa1, &pa2);
+		if (ret) {
+			wmt_err("CONSYS power on failed (%d)\n", ret);
+			continue;
+		}
+
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+
+		ret = wmt_core_stp_init();
+		if (!ret) {
+			g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_FUNC_ON;
+			return 0;
+		}
+
+		wmt_err("STP init failed (%d), retry %d\n", ret, attempt);
+		wmt_core_stp_deinit();
+		pa1 = 0;
+		pa2 = 0;
+		wmt_core_ctrl(WMT_CTRL_HW_PWR_OFF, &pa1, &pa2);
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+	}
+
+	return ret;
+}
+
+/* wmt_core.c:1031-1075 */
+static int opfunc_pwr_off(struct wmt_op *op)
+{
+	unsigned long pa1, pa2;
+	int ret = 0;
+
+	if (g_wmt.drv_status[WMTDRV_WMT] == DRV_STS_POWER_OFF) {
+		wmt_warn("WMT already powered off\n");
+		return -EALREADY;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WMT] == DRV_STS_FUNC_ON)
+		ret = wmt_core_stp_deinit();
+
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+	pa1 = 0;
+	pa2 = 0;
+	ret |= wmt_core_ctrl(WMT_CTRL_HW_PWR_OFF, &pa1, &pa2);
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+
+	return ret;
+}
+
+static bool wmt_all_funcs_off(void)
+{
+	int i;
+
+	for (i = 0; i < WMTDRV_WMT; i++)
+		if (g_wmt.drv_status[i] != DRV_STS_POWER_OFF)
+			return false;
+
+	return true;
+}
+
+/* wmt_core.c:1077-1170 */
+static int opfunc_func_on(struct wmt_op *op)
+{
+	unsigned int type = op->data[0];
+	int ret;
+
+	if (type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	if (g_wmt.drv_status[type] == DRV_STS_FUNC_ON) {
+		wmt_warn("function %u already on\n", type);
+		return 0;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_FUNC_ON) {
+		ret = opfunc_pwr_on(op);
+		if (ret)
+			return ret;
+	}
+
+	if (type < WMTDRV_WMT) {
+		ret = wmt_func_on(type);
+		if (ret) {
+			wmt_err("function %u on failed (%d)\n", type, ret);
+			g_wmt.drv_status[type] = DRV_STS_POWER_OFF;
+			if (wmt_all_funcs_off()) {
+				mtk_wcn_wmt_system_state_reset();
+				opfunc_pwr_off(op);
+			}
+			return ret;
+		}
+	}
+
+	g_wmt.drv_status[type] = DRV_STS_FUNC_ON;
+	return 0;
+}
+
+/* wmt_core.c:1172-1265 */
+static int opfunc_func_off(struct wmt_op *op)
+{
+	unsigned int type = op->data[0];
+	int ret = 0;
+
+	if (type >= WMTDRV_MAX)
+		return -EINVAL;
+
+	if (g_wmt.drv_status[type] != DRV_STS_FUNC_ON) {
+		wmt_warn("function %u is not on\n", type);
+		return 0;
+	}
+
+	if (type < WMTDRV_WMT)
+		ret = wmt_func_off(type);
+
+	g_wmt.drv_status[type] = DRV_STS_POWER_OFF;
+
+	if (wmt_all_funcs_off())
+		ret |= opfunc_pwr_off(op);
+
+	return ret;
+}
+
+static int opfunc_reg_rw(struct wmt_op *op)
+{
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_FUNC_ON)
+		return -EPERM;
+
+	return wmt_core_reg_rw_raw(op->data[0], op->data[1],
+				   (u32 *)op->data[2], op->data[3]);
+}
+
+/* wmt_core.c:1420-1520 */
+static int opfunc_hw_rst(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+	int ret;
+
+	g_wmt.drv_status[WMTDRV_FM] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_GPS] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_LPBK] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_STP] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_COREDUMP] = DRV_STS_POWER_OFF;
+
+	if (g_wmt.drv_status[WMTDRV_WMT] == DRV_STS_POWER_OFF) {
+		ret = wmt_core_ctrl(WMT_CTRL_HW_PWR_ON, &pa1, &pa2);
+		if (ret)
+			return ret;
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_BT] == DRV_STS_FUNC_ON) {
+		pa1 = BT_PALDO;
+		pa2 = PALDO_OFF;
+		wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+		g_wmt.drv_status[WMTDRV_BT] = DRV_STS_POWER_OFF;
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WIFI] == DRV_STS_FUNC_ON) {
+		wmt_func_off(WMTDRV_WIFI);
+		g_wmt.drv_status[WMTDRV_WIFI] = DRV_STS_POWER_OFF;
+	}
+
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+
+	ret = wmt_core_ctrl(WMT_CTRL_HW_RST, &pa1, &pa2);
+	if (ret)
+		wmt_err("hardware reset failed (%d)\n", ret);
+
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_ON;
+
+	ret = wmt_core_ctrl(WMT_CTRL_STP_CLOSE, &pa1, &pa2);
+	if (ret)
+		wmt_err("STP close after reset failed (%d)\n", ret);
+
+	return ret;
+}
+
+/* wmt_core.c:1522-1531 */
+static int opfunc_sw_rst(struct wmt_op *op)
+{
+	int ret;
+
+	ret = wmt_core_stp_init();
+	if (!ret)
+		g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_FUNC_ON;
+
+	return ret;
+}
+
+/* wmt_core.c:1533-1537 */
+static int opfunc_stp_rst(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+
+	return wmt_core_ctrl(WMT_CTRL_STP_RST, &pa1, &pa2);
+}
+
+/* wmt_core.c:1539-1590 */
+static int opfunc_therm_ctrl(struct wmt_op *op)
+{
+	u8 cmd[sizeof(wmt_therm_cmd)];
+	u8 evt[16] = { };
+	u32 written = 0, read = 0;
+	int ret;
+
+	memcpy(cmd, wmt_therm_cmd, sizeof(cmd));
+	cmd[4] = op->data[0];
+
+	ret = wmt_core_tx(cmd, sizeof(cmd), &written);
+	if (ret || written != sizeof(cmd))
+		return -EIO;
+
+	ret = wmt_core_rx(evt, sizeof(evt), &read);
+	if (ret || (read != sizeof(wmt_therm_ctrl_evt) &&
+		    read != sizeof(wmt_therm_read_evt)))
+		return -EIO;
+
+	if (read == sizeof(wmt_therm_ctrl_evt)) {
+		op->data[1] = memcmp(evt, wmt_therm_ctrl_evt,
+				     sizeof(wmt_therm_ctrl_evt)) ? 0 : 1;
+	} else {
+		op->data[1] = memcmp(evt, wmt_therm_read_evt,
+				     sizeof(wmt_therm_read_evt) - 1) ?
+			      0xff : evt[5];
+	}
+
+	return 0;
+}
+
+static int opfunc_dsns(struct wmt_op *op)
+{
+	u8 cmd[] = { 0x01, 0x0e, 0x02, 0x00, 0x01, 0x00 };
+	u8 evt[16] = { };
+	u32 written = 0, read = 0;
+	int ret;
+
+	cmd[4] = op->data[0];
+	cmd[5] = op->data[1];
+
+	ret = wmt_core_tx(cmd, sizeof(cmd), &written);
+	if (ret || written != sizeof(cmd))
+		return -EIO;
+
+	ret = wmt_core_rx(evt, sizeof(wmt_dsns_evt), &read);
+	if (ret || read != sizeof(wmt_dsns_evt))
+		return -EIO;
+
+	if (memcmp(evt, wmt_dsns_evt, sizeof(wmt_dsns_evt))) {
+		wmt_err("unexpected desense event\n");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+/* wmt_core.c:1898-1930 */
+static int opfunc_gpio_ctrl(struct wmt_op *op)
+{
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_FUNC_ON)
+		return -EPERM;
+
+	return wmt_ic_soc_pin_ctrl(op->data[0], op->data[1], op->data[2]);
+}
+
+static int opfunc_pin_state(struct wmt_op *op)
+{
+	unsigned long pa1 = 0, pa2 = 0;
+
+	return wmt_core_ctrl(WMT_CTRL_HW_STATE_DUMP, &pa1, &pa2);
+}
+
+/* wmt_core.c:2073-2082, reached through mtk_wcn_wmt_assert() */
+static int opfunc_assert(struct wmt_op *op)
+{
+	u32 written = 0;
+	int ret;
+
+	ret = wmt_core_tx(wmt_assert_cmd, sizeof(wmt_assert_cmd), &written);
+	if (ret || written != sizeof(wmt_assert_cmd))
+		return -EIO;
+
+	/* The firmware asserts; no event is returned (wmt_core.c:1720-1723). */
+	return 0;
+}
+
+static int (*const wmt_core_opfunc[WMT_OPID_MAX])(struct wmt_op *op) = {
+	[WMT_OPID_HIF_CONF] = opfunc_hif_conf,
+	[WMT_OPID_PWR_ON] = opfunc_pwr_on,
+	[WMT_OPID_PWR_OFF] = opfunc_pwr_off,
+	[WMT_OPID_FUNC_ON] = opfunc_func_on,
+	[WMT_OPID_FUNC_OFF] = opfunc_func_off,
+	[WMT_OPID_REG_RW] = opfunc_reg_rw,
+	[WMT_OPID_DSNS] = opfunc_dsns,
+	[WMT_OPID_HW_RST] = opfunc_hw_rst,
+	[WMT_OPID_SW_RST] = opfunc_sw_rst,
+	[WMT_OPID_STP_RST] = opfunc_stp_rst,
+	[WMT_OPID_THERM_CTRL] = opfunc_therm_ctrl,
+	[WMT_OPID_GPIO_CTRL] = opfunc_gpio_ctrl,
+	[WMT_OPID_GPIO_STATE] = opfunc_pin_state,
+	[WMT_OPID_ASSERT] = opfunc_assert,
+};
+
+int wmt_core_opid(struct wmt_op *op)
+{
+	if (!op || op->op_id >= WMT_OPID_MAX || !wmt_core_opfunc[op->op_id]) {
+		wmt_err("invalid operation %d\n", op ? op->op_id : -1);
+		return -EINVAL;
+	}
+
+	return wmt_core_opfunc[op->op_id](op);
+}
+
+int wmt_core_init(void)
+{
+	memset(&g_wmt.hif, 0, sizeof(g_wmt.hif));
+	g_wmt.drv_status[WMTDRV_BT] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_FM] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_GPS] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_WIFI] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_WMT] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_STP] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_LPBK] = DRV_STS_POWER_OFF;
+	g_wmt.drv_status[WMTDRV_COREDUMP] = DRV_STS_POWER_OFF;
+	return 0;
+}
+
+void wmt_core_deinit(void)
+{
+	memset(&g_wmt.drv_status, 0, sizeof(g_wmt.drv_status));
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_ctrl.c b/drivers/misc/mediatek/connectivity/wmt/wmt_ctrl.c
new file mode 100644
index 000000000..912150d09
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_ctrl.c
@@ -0,0 +1,442 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT control dispatch.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_ctrl.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * wmt_ctrl() is the single entry point the WMT core uses to reach the STP
+ * engine, the platform glue and the firmware patch store.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+
+static int wmt_ctrl_hw_pwr_off(struct wmt_ctrl_data *d);
+static int wmt_ctrl_hw_pwr_on(struct wmt_ctrl_data *d);
+static int wmt_ctrl_hw_rst(struct wmt_ctrl_data *d);
+static int wmt_ctrl_stp_close(struct wmt_ctrl_data *d);
+static int wmt_ctrl_stp_open(struct wmt_ctrl_data *d);
+static int wmt_ctrl_stp_conf(struct wmt_ctrl_data *d);
+static int wmt_ctrl_free_patch(struct wmt_ctrl_data *d);
+static int wmt_ctrl_get_patch(struct wmt_ctrl_data *d);
+static int wmt_ctrl_hwidver_set(struct wmt_ctrl_data *d);
+static int wmt_ctrl_stp_rst(struct wmt_ctrl_data *d);
+static int wmt_ctrl_get_wmt_conf(struct wmt_ctrl_data *d);
+static int wmt_ctrl_tx(struct wmt_ctrl_data *d);
+static int wmt_ctrl_rx(struct wmt_ctrl_data *d);
+static int wmt_ctrl_rx_flush(struct wmt_ctrl_data *d);
+static int wmt_ctrl_patch_search(struct wmt_ctrl_data *d);
+static int wmt_ctrl_hw_state_show(struct wmt_ctrl_data *d);
+static int wmt_ctrl_get_patch_num(struct wmt_ctrl_data *d);
+static int wmt_ctrl_get_patch_info(struct wmt_ctrl_data *d);
+static int wmt_ctrl_soc_paldo_ctrl(struct wmt_ctrl_data *d);
+static int wmt_ctrl_soc_wakeup_consys(struct wmt_ctrl_data *d);
+static int wmt_ctrl_evt_err_trg_assert(struct wmt_ctrl_data *d);
+static int wmt_ctrl_gps_sync_set(struct wmt_ctrl_data *d);
+static int wmt_ctrl_gps_lna_set(struct wmt_ctrl_data *d);
+static int wmt_ctrl_others(struct wmt_ctrl_data *d);
+
+/* wmt_ctrl.c:161-197 */
+static int (*const wmt_ctrl_func[WMT_CTRL_MAX])(struct wmt_ctrl_data *d) = {
+	[WMT_CTRL_HW_PWR_OFF] = wmt_ctrl_hw_pwr_off,
+	[WMT_CTRL_HW_PWR_ON] = wmt_ctrl_hw_pwr_on,
+	[WMT_CTRL_HW_RST] = wmt_ctrl_hw_rst,
+	[WMT_CTRL_STP_CLOSE] = wmt_ctrl_stp_close,
+	[WMT_CTRL_STP_OPEN] = wmt_ctrl_stp_open,
+	[WMT_CTRL_STP_CONF] = wmt_ctrl_stp_conf,
+	[WMT_CTRL_FREE_PATCH] = wmt_ctrl_free_patch,
+	[WMT_CTRL_GET_PATCH] = wmt_ctrl_get_patch,
+	[WMT_CTRL_HWIDVER_SET] = wmt_ctrl_hwidver_set,
+	[WMT_CTRL_STP_RST] = wmt_ctrl_stp_rst,
+	[WMT_CTRL_GET_WMT_CONF] = wmt_ctrl_get_wmt_conf,
+	[WMT_CTRL_TX] = wmt_ctrl_tx,
+	[WMT_CTRL_RX] = wmt_ctrl_rx,
+	[WMT_CTRL_RX_FLUSH] = wmt_ctrl_rx_flush,
+	[WMT_CTRL_GPS_SYNC_SET] = wmt_ctrl_gps_sync_set,
+	[WMT_CTRL_GPS_LNA_SET] = wmt_ctrl_gps_lna_set,
+	[WMT_CTRL_PATCH_SEARCH] = wmt_ctrl_patch_search,
+	[WMT_CTRL_HW_STATE_DUMP] = wmt_ctrl_hw_state_show,
+	[WMT_CTRL_GET_PATCH_NUM] = wmt_ctrl_get_patch_num,
+	[WMT_CTRL_GET_PATCH_INFO] = wmt_ctrl_get_patch_info,
+	[WMT_CTRL_SOC_PALDO_CTRL] = wmt_ctrl_soc_paldo_ctrl,
+	[WMT_CTRL_SOC_WAKEUP_CONSYS] = wmt_ctrl_soc_wakeup_consys,
+	[WMT_CTRL_EVT_ERR_TRG_ASSERT] = wmt_ctrl_evt_err_trg_assert,
+};
+
+int wmt_ctrl(struct wmt_ctrl_data *data)
+{
+	if (!data || data->ctrl_id >= WMT_CTRL_MAX)
+		return -EINVAL;
+
+	if (!wmt_ctrl_func[data->ctrl_id])
+		return wmt_ctrl_others(data);
+
+	return wmt_ctrl_func[data->ctrl_id](data);
+}
+
+static int wmt_ctrl_tx(struct wmt_ctrl_data *d)
+{
+	const u8 *data = (const u8 *)d->data[0];
+	u32 size = d->data[1];
+	u32 *written = (u32 *)d->data[2];
+	bool raw = !!d->data[3];
+
+	return wmt_ctrl_tx_ex(data, size, written, raw);
+}
+
+/* wmt_ctrl.c:302-380 */
+int wmt_ctrl_tx_ex(const u8 *data, u32 size, u32 *written, bool raw)
+{
+	int ret;
+
+	if (written)
+		*written = 0;
+
+	if (!size)
+		return -EINVAL;
+
+	if (!(g_wmt.state & WMT_STAT_STP_OPEN) ||
+	    !(g_wmt.state & WMT_STAT_STP_EN)) {
+		wmt_err("STP not open/enabled\n");
+		return -EPIPE;
+	}
+
+	mtk_wcn_stp_flush_rx_queue(WMT_TASK_INDX);
+
+	if (raw)
+		ret = mtk_wcn_stp_send_data_raw(data, size, WMT_TASK_INDX);
+	else
+		ret = mtk_wcn_stp_send_data(data, size, WMT_TASK_INDX);
+
+	if (written)
+		*written = ret > 0 ? ret : 0;
+
+	if (ret != size) {
+		wmt_dbg("tx %d/%u\n", ret, size);
+		if (ret == 0)
+			return -EAGAIN;	/* no STP window space */
+		return ret < 0 ? ret : -EIO;
+	}
+
+	return 0;
+}
+
+/* wmt_ctrl.c:331-425 */
+static int wmt_ctrl_rx(struct wmt_ctrl_data *d)
+{
+	u8 *buf = (u8 *)d->data[0];
+	u32 len = d->data[1];
+	u32 *read_size = (u32 *)d->data[2];
+	int read_len;
+
+	if (read_size)
+		*read_size = 0;
+
+	if (!len)
+		return 0;
+
+	if (!(g_wmt.state & WMT_STAT_STP_OPEN))
+		return -EPIPE;
+
+	wmt_dev_rx_clear();
+	read_len = mtk_wcn_stp_receive_data(buf, len, WMT_TASK_INDX);
+	while (read_len == 0) {
+		if (wmt_dev_wait_rx(WMT_LIB_RX_TIMEOUT)) {
+			wmt_err("WMT rx timeout\n");
+			return -ETIMEDOUT;
+		}
+
+		read_len = mtk_wcn_stp_receive_data(buf, len, WMT_TASK_INDX);
+	}
+
+	if (read_size)
+		*read_size = read_len;
+
+	return 0;
+}
+
+static int wmt_ctrl_rx_flush(struct wmt_ctrl_data *d)
+{
+	mtk_wcn_stp_flush_rx_queue(d->data[0]);
+	return 0;
+}
+
+/* wmt_ctrl.c:427-450 */
+static int wmt_ctrl_hw_pwr_off(struct wmt_ctrl_data *d)
+{
+	if (!test_and_clear_bit(WMT_STAT_PWR, &g_wmt.state)) {
+		wmt_warn("CONSYS already off\n");
+		return 0;
+	}
+
+	return wmt_plat_pwr_ctrl(FUNC_OFF);
+}
+
+/* wmt_ctrl.c:452-467 */
+static int wmt_ctrl_hw_pwr_on(struct wmt_ctrl_data *d)
+{
+	if (test_and_set_bit(WMT_STAT_PWR, &g_wmt.state)) {
+		wmt_warn("CONSYS already on\n");
+		return 0;
+	}
+
+	return wmt_plat_pwr_ctrl(FUNC_ON);
+}
+
+static int wmt_ctrl_hw_rst(struct wmt_ctrl_data *d)
+{
+	return wmt_plat_pwr_ctrl(FUNC_RST);
+}
+
+static int wmt_ctrl_hw_state_show(struct wmt_ctrl_data *d)
+{
+	return wmt_plat_pwr_ctrl(FUNC_STAT);
+}
+
+/* wmt_ctrl.c:506-545 */
+static int wmt_ctrl_stp_close(struct wmt_ctrl_data *d)
+{
+	int ret;
+
+	if (!(g_wmt.state & WMT_STAT_STP_OPEN))
+		return -EALREADY;
+
+	ret = mtk_wcn_stp_register_event_cb(WMT_TASK_INDX, NULL);
+	if (ret)
+		return ret;
+
+	ret = stp_btif_rx_unregister();
+	if (ret)
+		wmt_warn("failed to unregister BTIF rx callback (%d)\n", ret);
+
+	ret = stp_btif_close();
+	if (ret)
+		return ret;
+
+	clear_bit(WMT_STAT_STP_OPEN, &g_wmt.state);
+	return 0;
+}
+
+/* wmt_ctrl.c:547-578 */
+static int wmt_ctrl_stp_open(struct wmt_ctrl_data *d)
+{
+	int ret;
+
+	ret = stp_btif_open();
+	if (ret)
+		return ret;
+
+	ret = stp_btif_rx_register();
+	if (ret) {
+		wmt_err("failed to register BTIF rx callback (%d)\n", ret);
+		return ret;
+	}
+
+	ret = mtk_wcn_stp_register_event_cb(WMT_TASK_INDX,
+					    wmt_dev_rx_event_cb);
+	if (ret)
+		return ret;
+
+	set_bit(WMT_STAT_STP_OPEN, &g_wmt.state);
+	return 0;
+}
+
+/* The downstream handler is empty (wmt_ctrl.c:1005-1008); resetting the STP
+ * state machine is the only meaningful implementation.  [INFERENCE]
+ */
+static int wmt_ctrl_stp_rst(struct wmt_ctrl_data *d)
+{
+	mtk_wcn_stp_flush_context();
+	mtk_wcn_stp_ready(0);
+	return 0;
+}
+
+static int wmt_ctrl_stp_conf_ex(enum wmt_stp_conf_type type, u32 value)
+{
+	switch (type) {
+	case WMT_STP_CONF_EN:
+		return mtk_wcn_stp_enable(value);
+	case WMT_STP_CONF_RDY:
+		return mtk_wcn_stp_ready(value);
+	case WMT_STP_CONF_MODE:
+		mtk_wcn_stp_set_mode(value);
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* wmt_ctrl.c:700-740 */
+static int wmt_ctrl_stp_conf(struct wmt_ctrl_data *d)
+{
+	enum wmt_stp_conf_type type = d->data[0];
+	u32 value = d->data[1];
+	int ret;
+
+	if (!(g_wmt.state & WMT_STAT_STP_OPEN))
+		return -EPIPE;
+
+	ret = wmt_ctrl_stp_conf_ex(type, value);
+	if (ret)
+		return ret;
+
+	if (type == WMT_STP_CONF_EN) {
+		if (value)
+			set_bit(WMT_STAT_STP_EN, &g_wmt.state);
+		else
+			clear_bit(WMT_STAT_STP_EN, &g_wmt.state);
+	}
+
+	return 0;
+}
+
+/*
+ * Patch store
+ */
+
+static int wmt_ctrl_patch_search(struct wmt_ctrl_data *d)
+{
+	/* With the multi-patch ABI the launcher has already provided the patch
+	 * list through WMT_IOCTL_SET_PATCH_NUM/SET_PATCH_INFO before power on
+	 * (wmt_ctrl.c:602-616).  The request is still queued on the command
+	 * channel for compatibility with the launcher protocol.
+	 */
+	wmt_dev_cmd_request("srh_patch");
+	return 0;
+}
+
+static int wmt_ctrl_get_patch_num(struct wmt_ctrl_data *d)
+{
+	d->data[0] = wmt_dev_patch_num();
+	return 0;
+}
+
+/* wmt_ctrl.c:640-665 */
+static int wmt_ctrl_get_patch_info(struct wmt_ctrl_data *d)
+{
+	return wmt_dev_patch_info_get(d->data[0], (u8 *)d->data[1],
+				      (u8 *)d->data[2]);
+}
+
+/* wmt_ctrl.c:718-772 */
+static int wmt_ctrl_get_patch(struct wmt_ctrl_data *d)
+{
+	const char *full_name = (const char *)d->data[1];
+	const char *def_name = (const char *)d->data[0];
+	u8 **pp_buf = (u8 **)d->data[2];
+	size_t *p_size = (size_t *)d->data[3];
+	int ret;
+
+	if (!pp_buf || !p_size)
+		return -EINVAL;
+
+	if (full_name && full_name[0]) {
+		ret = wmt_dev_patch_get(full_name, pp_buf, p_size);
+		if (!ret)
+			return 0;
+	}
+
+	if (def_name && def_name[0]) {
+		ret = wmt_dev_patch_get(def_name, pp_buf, p_size);
+		if (!ret)
+			return 0;
+	}
+
+	return -ENOENT;
+}
+
+/* wmt_ctrl.c:690-706 */
+static int wmt_ctrl_free_patch(struct wmt_ctrl_data *d)
+{
+	u32 seq = d->data[0];
+
+	wmt_dev_patch_put();
+	if (seq && seq >= wmt_dev_patch_num())
+		wmt_dev_patch_info_free_all();
+	return 0;
+}
+
+/* wmt_ctrl.c:864-878 */
+static int wmt_ctrl_hwidver_set(struct wmt_ctrl_data *d)
+{
+	wmt_lib_set_chip_info((d->data[0] & 0xffff0000) >> 16,
+			      d->data[0] & 0x0000ffff,
+			      d->data[1] & 0x0000ffff,
+			      (d->data[1] & 0xffff0000) >> 16);
+	return 0;
+}
+
+static int wmt_ctrl_get_wmt_conf(struct wmt_ctrl_data *d)
+{
+	d->data[0] = (unsigned long)wmt_lib_gen_conf();
+	return 0;
+}
+
+/* wmt_ctrl.c:668-690 */
+static int wmt_ctrl_soc_paldo_ctrl(struct wmt_ctrl_data *d)
+{
+	int ret;
+
+	ret = wmt_plat_soc_paldo_ctrl(d->data[0], d->data[1]);
+	if (ret && d->data[0] == PMIC_CHIPID_PALDO)
+		d->data[2] = ret;
+
+	return ret;
+}
+
+static int wmt_ctrl_soc_wakeup_consys(struct wmt_ctrl_data *d)
+{
+	int ret = stp_btif_wakeup();
+
+	if (ret)
+		wmt_err("failed to wake up CONSYS (%d)\n", ret);
+
+	return ret;
+}
+
+/* wmt_ctrl.c:900-930 */
+static int wmt_ctrl_evt_err_trg_assert(struct wmt_ctrl_data *d)
+{
+	wmt_warn("driver %lu reason %lu triggers a firmware assert\n",
+		 d->data[0], d->data[1]);
+
+	if (mtk_wcn_stp_get_wmt_evt_err_trg_assert()) {
+		wmt_info("assert already triggered\n");
+		return 0;
+	}
+
+	mtk_wcn_stp_set_wmt_evt_err_trg_assert(1);
+	/* The firmware-assert-via-EMI mechanism is not ported; recover by
+	 * resetting CONSYS (see wmt_lib_cmb_rst()).
+	 */
+	wmt_lib_schedule_reset(WMTRSTSRC_RESET_STP);
+	return 0;
+}
+
+/* wmt_ctrl.c:960-985 */
+static int wmt_ctrl_gps_sync_set(struct wmt_ctrl_data *d)
+{
+	wmt_plat_gpio_ctrl(PIN_GPS_SYNC,
+			   d->data[0] ? PIN_STA_MUX : PIN_STA_DEINIT);
+	return 0;
+}
+
+static int wmt_ctrl_gps_lna_set(struct wmt_ctrl_data *d)
+{
+	wmt_plat_gpio_ctrl(PIN_GPS_LNA,
+			   d->data[0] ? PIN_STA_OUT_H : PIN_STA_DEINIT);
+	return 0;
+}
+
+static int wmt_ctrl_others(struct wmt_ctrl_data *d)
+{
+	wmt_err("invalid control id %lu\n", d->ctrl_id);
+	return -EINVAL;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_dev.c b/drivers/misc/mediatek/connectivity/wmt/wmt_dev.c
new file mode 100644
index 000000000..c90e7e6d1
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_dev.c
@@ -0,0 +1,548 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN /dev/stpwmt character device and patch store.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/wmt_dev.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The MTK connectivity launcher owns the firmware patch files.  It tells the
+ * driver which patches to download through WMT_IOCTL_SET_PATCH_NUM and
+ * WMT_IOCTL_SET_PATCH_INFO; this file loads the named files from firmware
+ * storage when the WMT power-on sequence asks for them.  No firmware is
+ * embedded in the driver.
+ */
+
+#include <linux/cdev.h>
+#include <linux/compat.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/firmware.h>
+#include <linux/kernel_read_file.h>
+#include <linux/module.h>
+#include <linux/poll.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/vmalloc.h>
+
+#include "wmt_local.h"
+
+/* wmt_dev.c:72-94 */
+#define WMT_IOC_MAGIC		0xa0
+#define WMT_IOCTL_SET_PATCH_NAME	_IOW(WMT_IOC_MAGIC, 4, char *)
+#define WMT_IOCTL_SET_STP_MODE		_IOW(WMT_IOC_MAGIC, 5, int)
+#define WMT_IOCTL_FUNC_ONOFF_CTRL	_IOW(WMT_IOC_MAGIC, 6, int)
+#define WMT_IOCTL_GET_CHIP_INFO		_IOR(WMT_IOC_MAGIC, 12, int)
+#define WMT_IOCTL_SET_PATCH_NUM		_IOW(WMT_IOC_MAGIC, 14, int)
+#define WMT_IOCTL_SET_PATCH_INFO	_IOW(WMT_IOC_MAGIC, 15, char *)
+#define WMT_IOCTL_PORT_NAME		_IOWR(WMT_IOC_MAGIC, 20, char *)
+#define WMT_IOCTL_WMT_CFG_NAME		_IOWR(WMT_IOC_MAGIC, 21, char *)
+#define WMT_IOCTL_WMT_QUERY_CHIPID	_IOR(WMT_IOC_MAGIC, 22, int)
+#define WMT_IOCTL_WMT_TELL_CHIPID	_IOW(WMT_IOC_MAGIC, 23, int)
+
+#define WMT_DRIVER_NAME		"mtk_stp_wmt"
+#define WMT_DEV_MAJOR		190
+#define WMT_DEV_NUM		1
+
+static int wmt_major = WMT_DEV_MAJOR;
+module_param(wmt_major, uint, 0444);
+
+static struct cdev wmt_cdev;
+static struct class *wmt_class;
+
+/*
+ * Firmware file access
+ */
+
+static int wmt_request_firmware_file(const char *name, u8 **buf, size_t *size)
+{
+	const struct firmware *fw;
+	char fw_name[NAME_MAX + 1];
+	int ret;
+
+	strscpy(fw_name, name, sizeof(fw_name));
+
+	/* request_firmware() resolves names relative to /lib/firmware, so drop
+	 * the leading '/' of Android-style absolute paths.
+	 */
+	if (fw_name[0] == '/')
+		memmove(fw_name, fw_name + 1, strlen(fw_name));
+
+	ret = request_firmware(&fw, fw_name, NULL);
+	if (ret)
+		return ret;
+
+	*buf = kmemdup(fw->data, fw->size, GFP_KERNEL);
+	if (!*buf) {
+		release_firmware(fw);
+		return -ENOMEM;
+	}
+
+	*size = fw->size;
+	release_firmware(fw);
+	return 0;
+}
+
+static int wmt_read_file_path(const char *path, u8 **buf, size_t *size)
+{
+	size_t file_size = 0;
+	void *vbuf = NULL;
+	ssize_t ret;
+
+	ret = kernel_read_file_from_path(path, 0, &vbuf, SIZE_MAX, &file_size,
+					 READING_FIRMWARE);
+	if (ret < 0)
+		return ret;
+
+	*buf = kmemdup(vbuf, file_size, GFP_KERNEL);
+	vfree(vbuf);
+	if (!*buf)
+		return -ENOMEM;
+
+	*size = file_size;
+	return 0;
+}
+
+int wmt_dev_read_file(const char *name, u8 **buf, size_t *size)
+{
+	int ret;
+
+	if (!name || !name[0])
+		return -EINVAL;
+
+	*buf = NULL;
+	*size = 0;
+
+	ret = wmt_request_firmware_file(name, buf, size);
+	if (!ret)
+		return 0;
+
+	wmt_dbg("request_firmware(%s) failed (%d), trying the path directly\n",
+		name, ret);
+	return wmt_read_file_path(name, buf, size);
+}
+
+int wmt_dev_patch_get(const char *name, u8 **buf, size_t *size)
+{
+	u8 *file = NULL;
+	size_t file_size = 0;
+	u8 *patch;
+	int ret;
+
+	if (!name || !name[0])
+		return -EINVAL;
+
+	ret = wmt_dev_read_file(name, &file, &file_size);
+	if (ret)
+		return ret;
+
+	/* Reserve BCNT_PATCH_BUF_HEADROOM bytes in front of the image so that
+	 * the per-fragment WMT header can be written in place
+	 * (wmt_ic_soc.c:2000-2030).
+	 */
+	patch = kmalloc(file_size + BCNT_PATCH_BUF_HEADROOM, GFP_KERNEL);
+	if (!patch) {
+		kfree(file);
+		return -ENOMEM;
+	}
+
+	memcpy(patch + BCNT_PATCH_BUF_HEADROOM, file, file_size);
+	kfree(file);
+
+	wmt_dev_patch_put();
+	g_wmt.patch_buf = patch;
+	g_wmt.patch_size = file_size;
+	strscpy(g_wmt.patch_fw_name, name, sizeof(g_wmt.patch_fw_name));
+
+	*buf = patch;
+	*size = file_size;
+	wmt_dbg("loaded %s (%zu bytes)\n", name, file_size);
+	return 0;
+}
+
+void wmt_dev_patch_put(void)
+{
+	kfree(g_wmt.patch_buf);
+	g_wmt.patch_buf = NULL;
+	g_wmt.patch_size = 0;
+	g_wmt.patch_fw_name[0] = '\0';
+}
+
+/*
+ * Patch list provided by the launcher
+ */
+
+int wmt_dev_patch_set_num(u32 num)
+{
+	struct wmt_patch_info *info;
+
+	if (!num || num > MAX_PATCH_NUM)
+		return -EINVAL;
+
+	info = kcalloc(num, sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+
+	mutex_lock(&g_wmt.patch_lock);
+	kfree(g_wmt.patch_info);
+	g_wmt.patch_info = info;
+	g_wmt.patch_num = num;
+	mutex_unlock(&g_wmt.patch_lock);
+
+	wmt_dbg("patch count set to %u\n", num);
+	return 0;
+}
+
+int wmt_dev_patch_set_info(const struct wmt_patch_info *info)
+{
+	u32 seq;
+
+	if (!info)
+		return -EINVAL;
+
+	seq = info->download_seq;
+	if (!seq || seq > g_wmt.patch_num)
+		return -EINVAL;
+
+	mutex_lock(&g_wmt.patch_lock);
+	memcpy(&g_wmt.patch_info[seq - 1], info, sizeof(*info));
+	g_wmt.patch_info[seq - 1].name[sizeof(info->name) - 1] = '\0';
+	mutex_unlock(&g_wmt.patch_lock);
+
+	wmt_dbg("patch %u: %s\n", seq, g_wmt.patch_info[seq - 1].name);
+	return 0;
+}
+
+u32 wmt_dev_patch_num(void)
+{
+	return g_wmt.patch_num;
+}
+
+int wmt_dev_patch_info_get(u32 seq, u8 *name, u8 addr[4])
+{
+	int ret = 0;
+
+	if (!seq || seq > g_wmt.patch_num || !name || !addr)
+		return -EINVAL;
+
+	mutex_lock(&g_wmt.patch_lock);
+	if (!g_wmt.patch_info) {
+		ret = -ENOENT;
+	} else {
+		memcpy(name, g_wmt.patch_info[seq - 1].name,
+		       sizeof(g_wmt.patch_info[seq - 1].name));
+		memcpy(addr, g_wmt.patch_info[seq - 1].address, 4);
+	}
+	mutex_unlock(&g_wmt.patch_lock);
+
+	return ret;
+}
+
+void wmt_dev_patch_info_free_all(void)
+{
+	mutex_lock(&g_wmt.patch_lock);
+	kfree(g_wmt.patch_info);
+	g_wmt.patch_info = NULL;
+	g_wmt.patch_num = 0;
+	mutex_unlock(&g_wmt.patch_lock);
+}
+
+/*
+ * Kernel -> launcher command channel (read/poll/write)
+ */
+
+void wmt_dev_cmd_request(const char *cmd)
+{
+	strscpy(g_wmt.cmd, cmd, sizeof(g_wmt.cmd));
+	set_bit(WMT_STAT_CMD, &g_wmt.state);
+	wake_up_interruptible(&g_wmt.cmd_wq);
+	wmt_dbg("command '%s' queued\n", cmd);
+}
+
+bool wmt_dev_cmd_pending(void)
+{
+	return test_bit(WMT_STAT_CMD, &g_wmt.state);
+}
+
+const char *wmt_dev_cmd_string(void)
+{
+	return g_wmt.cmd;
+}
+
+void wmt_dev_cmd_ack(int result)
+{
+	clear_bit(WMT_STAT_CMD, &g_wmt.state);
+	if (result)
+		wmt_warn("launcher rejected command '%s'\n", g_wmt.cmd);
+}
+
+/*
+ * STP receive notification (registered on the WMT channel)
+ */
+
+void wmt_dev_rx_event_cb(void)
+{
+	g_wmt.rx_pending = true;
+	wake_up_interruptible(&g_wmt.rx_wq);
+}
+
+void wmt_dev_rx_clear(void)
+{
+	g_wmt.rx_pending = false;
+}
+
+int wmt_dev_wait_rx(u32 timeout_ms)
+{
+	int ret;
+
+	ret = wait_event_interruptible_timeout(g_wmt.rx_wq, g_wmt.rx_pending,
+					       msecs_to_jiffies(timeout_ms));
+	if (ret > 0) {
+		g_wmt.rx_pending = false;
+		return 0;
+	}
+
+	return ret < 0 ? ret : -ETIMEDOUT;
+}
+
+/*
+ * Character device
+ */
+
+static int wmt_open(struct inode *inode, struct file *file)
+{
+	wmt_dbg("open by pid %d\n", current->pid);
+	return 0;
+}
+
+static int wmt_release(struct inode *inode, struct file *file)
+{
+	wmt_dbg("release by pid %d\n", current->pid);
+	return 0;
+}
+
+static ssize_t wmt_read(struct file *file, char __user *buf, size_t count,
+			loff_t *ppos)
+{
+	const char *cmd;
+	size_t len;
+
+	if (!wmt_dev_cmd_pending()) {
+		if (file->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+
+		if (wait_event_interruptible(g_wmt.cmd_wq,
+					     wmt_dev_cmd_pending()))
+			return -ERESTARTSYS;
+	}
+
+	cmd = wmt_dev_cmd_string();
+	len = strnlen(cmd, NAME_MAX);
+	if (count < len)
+		return -EINVAL;
+
+	if (copy_to_user(buf, cmd, len))
+		return -EFAULT;
+
+	return len;
+}
+
+static ssize_t wmt_write(struct file *file, const char __user *buf,
+			 size_t count, loff_t *ppos)
+{
+	char ack[NAME_MAX + 1] = { };
+	size_t len = min(count, (size_t)NAME_MAX);
+
+	if (copy_from_user(ack, buf, len))
+		return -EFAULT;
+
+	wmt_dev_cmd_ack(strncasecmp(ack, "ok", strlen("ok")) ? -1 : 0);
+	return count;
+}
+
+static __poll_t wmt_poll(struct file *file, struct poll_table_struct *wait)
+{
+	__poll_t mask = POLLOUT | POLLWRNORM;
+
+	poll_wait(file, &g_wmt.cmd_wq, wait);
+	if (wmt_dev_cmd_pending())
+		mask |= POLLIN | POLLRDNORM;
+
+	return mask;
+}
+
+static long wmt_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	char name[NAME_MAX + 1] = { };
+	struct wmt_patch_info info;
+	u32 chip_id;
+	int ret = 0;
+
+	switch (cmd) {
+	case WMT_IOCTL_SET_PATCH_NAME:
+		if (copy_from_user(name, (void __user *)arg, NAME_MAX))
+			return -EFAULT;
+		name[NAME_MAX] = '\0';
+		wmt_lib_set_patch_name(name);
+		break;
+
+	case WMT_IOCTL_SET_STP_MODE:
+		ret = wmt_lib_set_hif(arg);
+		break;
+
+	case WMT_IOCTL_FUNC_ONOFF_CTRL:
+		if (arg & 0x80000000)
+			ret = mtk_wcn_wmt_func_on(arg & 0xf) ? 0 : -EIO;
+		else
+			ret = mtk_wcn_wmt_func_off(arg & 0xf) ? 0 : -EIO;
+		break;
+
+	case WMT_IOCTL_GET_CHIP_INFO:
+		if (arg > 2)
+			return -EINVAL;
+		return wmt_lib_get_icinfo(arg);
+
+	case WMT_IOCTL_SET_PATCH_NUM:
+		ret = wmt_dev_patch_set_num(arg);
+		break;
+
+	case WMT_IOCTL_SET_PATCH_INFO:
+		if (copy_from_user(&info, (void __user *)arg, sizeof(info)))
+			return -EFAULT;
+		ret = wmt_dev_patch_set_info(&info);
+		break;
+
+	case WMT_IOCTL_PORT_NAME:
+		/* The STP transport is BTIF on this platform; there is no UART
+		 * port to (re)name.
+		 */
+		ret = -EOPNOTSUPP;
+		break;
+
+	case WMT_IOCTL_WMT_CFG_NAME:
+		if (copy_from_user(name, (void __user *)arg, NAME_MAX))
+			return -EFAULT;
+		name[NAME_MAX] = '\0';
+		ret = wmt_conf_set_cfg_file(name);
+		break;
+
+	case WMT_IOCTL_WMT_QUERY_CHIPID:
+		chip_id = g_wmt.chip_id;
+		if (!chip_id)
+			chip_id = mtk_wcn_consys_soc_chipid_get();
+		return chip_id;
+
+	case WMT_IOCTL_WMT_TELL_CHIPID:
+		if (arg != 0x0321 && arg != 0x0335 && arg != 0x0337)
+			return -EINVAL;
+		g_wmt.chip_id = arg;
+		break;
+
+	default:
+		wmt_warn("unknown ioctl 0x%x\n", cmd);
+		return -EINVAL;
+	}
+
+	return ret;
+}
+
+#ifdef CONFIG_COMPAT
+/* The Android launcher is a 32-bit process on this 64-bit kernel, so the
+ * pointer-sized ioctl numbers differ (wmt_dev.c:63-69).
+ */
+#define COMPAT_WMT_IOCTL_SET_PATCH_NAME	_IOW(WMT_IOC_MAGIC, 4, compat_uptr_t)
+#define COMPAT_WMT_IOCTL_SET_PATCH_INFO	_IOW(WMT_IOC_MAGIC, 15, compat_uptr_t)
+#define COMPAT_WMT_IOCTL_PORT_NAME	_IOWR(WMT_IOC_MAGIC, 20, compat_uptr_t)
+#define COMPAT_WMT_IOCTL_WMT_CFG_NAME	_IOWR(WMT_IOC_MAGIC, 21, compat_uptr_t)
+
+static long wmt_compat_ioctl(struct file *file, unsigned int cmd,
+			     unsigned long arg)
+{
+	switch (cmd) {
+	case COMPAT_WMT_IOCTL_SET_PATCH_NAME:
+		return wmt_ioctl(file, WMT_IOCTL_SET_PATCH_NAME,
+				 (unsigned long)compat_ptr(arg));
+	case COMPAT_WMT_IOCTL_SET_PATCH_INFO:
+		return wmt_ioctl(file, WMT_IOCTL_SET_PATCH_INFO,
+				 (unsigned long)compat_ptr(arg));
+	case COMPAT_WMT_IOCTL_PORT_NAME:
+		return wmt_ioctl(file, WMT_IOCTL_PORT_NAME,
+				 (unsigned long)compat_ptr(arg));
+	case COMPAT_WMT_IOCTL_WMT_CFG_NAME:
+		return wmt_ioctl(file, WMT_IOCTL_WMT_CFG_NAME,
+				 (unsigned long)compat_ptr(arg));
+	default:
+		return wmt_ioctl(file, cmd, arg);
+	}
+}
+#endif
+
+static const struct file_operations wmt_fops = {
+	.owner = THIS_MODULE,
+	.open = wmt_open,
+	.release = wmt_release,
+	.read = wmt_read,
+	.write = wmt_write,
+	.poll = wmt_poll,
+	.unlocked_ioctl = wmt_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = wmt_compat_ioctl,
+#endif
+};
+
+int wmt_dev_stpwmt_register(void)
+{
+	dev_t dev = MKDEV(wmt_major, 0);
+	int ret;
+
+	ret = register_chrdev_region(dev, WMT_DEV_NUM, WMT_DRIVER_NAME);
+	if (ret) {
+		wmt_err("failed to register the char device (%d)\n", ret);
+		return ret;
+	}
+
+	cdev_init(&wmt_cdev, &wmt_fops);
+	wmt_cdev.owner = THIS_MODULE;
+
+	ret = cdev_add(&wmt_cdev, dev, WMT_DEV_NUM);
+	if (ret) {
+		wmt_err("failed to add the char device (%d)\n", ret);
+		goto err_region;
+	}
+
+	wmt_class = class_create("stpwmt");
+	if (IS_ERR(wmt_class)) {
+		ret = PTR_ERR(wmt_class);
+		wmt_class = NULL;
+		goto err_cdev;
+	}
+
+	if (IS_ERR(device_create(wmt_class, NULL, dev, NULL, "stpwmt"))) {
+		ret = -ENODEV;
+		goto err_class;
+	}
+
+	wmt_info("/dev/stpwmt registered (major %d)\n", wmt_major);
+	return 0;
+
+err_class:
+	class_destroy(wmt_class);
+	wmt_class = NULL;
+err_cdev:
+	cdev_del(&wmt_cdev);
+err_region:
+	unregister_chrdev_region(dev, WMT_DEV_NUM);
+	return ret;
+}
+
+void wmt_dev_stpwmt_unregister(void)
+{
+	dev_t dev = MKDEV(wmt_major, 0);
+
+	device_destroy(wmt_class, dev);
+	class_destroy(wmt_class);
+	wmt_class = NULL;
+	cdev_del(&wmt_cdev);
+	unregister_chrdev_region(dev, WMT_DEV_NUM);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_func.c b/drivers/misc/mediatek/connectivity/wmt/wmt_func.c
new file mode 100644
index 000000000..78227fa88
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_func.c
@@ -0,0 +1,279 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN per-function power control (BT / FM / GPS / WIFI).
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_func.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * Every WCN function is enabled by a WMT FUNC_CTRL command to the firmware.
+ * In addition:
+ *   - BT and Wi-Fi use their own VCN33 rail (BT_PALDO / WIFI_PALDO),
+ *   - in co-clock mode FM and GPS share VCN28 (powered here, not by the
+ *     CONSYS power-on sequence),
+ *   - GPS drives the GPS_SYNC handshake pin towards the modem and enables the
+ *     external LNA through a host pinctrl state.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+
+#include "wmt_local.h"
+
+/* Downstream ENUM_BT_GPS_ONOFF_STATE_T bit indices (wmt_exp.h:157-165). */
+#define WMT_BT_ON_BIT	0
+#define WMT_GPS_ON_BIT	1
+#define WMT_WIFI_ON_BIT	2
+#define WMT_FM_ON_BIT	3
+
+#define WMT_GPS_ON	BIT(WMT_GPS_ON_BIT)
+#define WMT_FM_ON	BIT(WMT_FM_ON_BIT)
+
+/* stp_core.c:1481-1495 - the SoC co-clock setting is global. */
+static int wmt_func_bt_on(void)
+{
+	unsigned long pa1, pa2;
+	int ret;
+
+	pa1 = BT_PALDO;
+	pa2 = PALDO_ON;
+	ret = wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+	if (ret) {
+		wmt_err("BT PALDO on failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = wmt_core_func_ctrl_cmd(WMTDRV_BT, true);
+	if (ret) {
+		wmt_err("BT function on failed (%d)\n", ret);
+		pa1 = BT_PALDO;
+		pa2 = PALDO_OFF;
+		wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+		return ret;
+	}
+
+	g_wmt.func_on_bits |= BIT(WMT_BT_ON_BIT);
+	return 0;
+}
+
+static int wmt_func_bt_off(void)
+{
+	unsigned long pa1, pa2;
+	int ret, ret2;
+
+	ret = wmt_core_func_ctrl_cmd(WMTDRV_BT, false);
+	if (ret)
+		wmt_err("BT function off failed (%d)\n", ret);
+
+	pa1 = BT_PALDO;
+	pa2 = PALDO_OFF;
+	ret2 = wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+	if (ret2)
+		wmt_err("BT PALDO off failed (%d)\n", ret2);
+
+	g_wmt.func_on_bits &= ~BIT(WMT_BT_ON_BIT);
+	return ret ? ret : ret2;
+}
+
+/* wmt_func.c:480-540 */
+static int wmt_func_fm_on(void)
+{
+	unsigned long pa1, pa2;
+	int ret;
+
+	if (wmt_lib_co_clock() && !(g_wmt.func_on_bits & WMT_GPS_ON)) {
+		pa1 = FM_PALDO;
+		pa2 = PALDO_ON;
+		wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+	} else if (wmt_lib_co_clock()) {
+		wmt_info("VCN28 already enabled by GPS\n");
+	}
+
+	ret = wmt_core_func_ctrl_cmd(WMTDRV_FM, true);
+	if (ret) {
+		wmt_err("FM function on failed (%d)\n", ret);
+		return ret;
+	}
+
+	if (wmt_lib_co_clock())
+		g_wmt.func_on_bits |= WMT_FM_ON;
+
+	return 0;
+}
+
+static int wmt_func_fm_off(void)
+{
+	unsigned long pa1, pa2;
+	int ret;
+
+	ret = wmt_core_func_ctrl_cmd(WMTDRV_FM, false);
+
+	if (wmt_lib_co_clock()) {
+		if (g_wmt.func_on_bits & WMT_GPS_ON) {
+			wmt_info("VCN28 still needed by GPS\n");
+		} else {
+			pa1 = FM_PALDO;
+			pa2 = PALDO_OFF;
+			wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+		}
+		g_wmt.func_on_bits &= ~WMT_FM_ON;
+	}
+
+	return ret;
+}
+
+/* wmt_func.c:590-660 */
+static int wmt_func_gps_pre_ctrl(bool on)
+{
+	const struct wmt_gen_conf *conf = wmt_lib_gen_conf();
+	int ret;
+
+	/* GPS_SYNC handshake with the modem (host SoC side). */
+	wmt_plat_gpio_ctrl(PIN_GPS_SYNC, on ? PIN_STA_MUX : PIN_STA_DEINIT);
+
+	/* GPS_SYNC pin inside the connectivity SoC (wmt_ic_soc.c:1426-1445). */
+	ret = wmt_ic_soc_pin_ctrl(WMT_IC_PIN_GSYNC,
+				  on ? WMT_IC_PIN_MUX : WMT_IC_PIN_GPIO, 1);
+	if (ret)
+		wmt_err("failed to configure GPS_SYNC (%d)\n", ret);
+
+	if (!conf || conf->wmt_gps_lna_enable) {
+		/* Chip-side LNA control through EEDI/EEDO needs the WMT
+		 * register tables that are not ported; the host side LNA pin
+		 * keeps its default state.
+		 */
+		wmt_warn("chip-side GPS LNA control is not supported\n");
+		return 0;
+	}
+
+	wmt_plat_gpio_ctrl(PIN_GPS_LNA,
+			   on ? PIN_STA_OUT_H : PIN_STA_DEINIT);
+	return 0;
+}
+
+static int wmt_func_gps_on(void)
+{
+	unsigned long pa1, pa2;
+	int ret;
+
+	if (wmt_lib_co_clock() && !(g_wmt.func_on_bits & WMT_FM_ON)) {
+		pa1 = GPS_PALDO;
+		pa2 = PALDO_ON;
+		wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+	} else if (wmt_lib_co_clock()) {
+		wmt_info("VCN28 already enabled by FM\n");
+	}
+
+	ret = wmt_func_gps_pre_ctrl(true);
+	if (ret)
+		return ret;
+
+	ret = wmt_core_func_ctrl_cmd(WMTDRV_GPS, true);
+	if (ret) {
+		wmt_err("GPS function on failed (%d)\n", ret);
+		return ret;
+	}
+
+	if (wmt_lib_co_clock())
+		g_wmt.func_on_bits |= WMT_GPS_ON;
+
+	return 0;
+}
+
+static int wmt_func_gps_off(void)
+{
+	unsigned long pa1, pa2;
+	int ret;
+
+	wmt_func_gps_pre_ctrl(false);
+
+	ret = wmt_core_func_ctrl_cmd(WMTDRV_GPS, false);
+	if (ret)
+		wmt_err("GPS function off failed (%d)\n", ret);
+
+	if (wmt_lib_co_clock()) {
+		if (g_wmt.func_on_bits & WMT_FM_ON) {
+			wmt_info("VCN28 still needed by FM\n");
+		} else {
+			pa1 = GPS_PALDO;
+			pa2 = PALDO_OFF;
+			wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+		}
+		g_wmt.func_on_bits &= ~WMT_GPS_ON;
+	}
+
+	return ret;
+}
+
+/* wmt_func.c:640-712 */
+static int wmt_func_wifi_on(void)
+{
+	int ret;
+
+	if (!g_wmt.wlan_cb.probe) {
+		wmt_err("no WLAN driver registered\n");
+		g_wmt.wlan_probed = true;
+		return -ENODEV;
+	}
+
+	ret = g_wmt.wlan_cb.probe();
+	if (ret) {
+		wmt_err("WLAN probe failed (%d)\n", ret);
+		return ret;
+	}
+
+	g_wmt.func_on_bits |= BIT(WMT_WIFI_ON_BIT);
+	return 0;
+}
+
+static int wmt_func_wifi_off(void)
+{
+	int ret;
+
+	if (!g_wmt.wlan_cb.remove) {
+		wmt_err("no WLAN driver registered\n");
+		return -ENODEV;
+	}
+
+	ret = g_wmt.wlan_cb.remove();
+	if (ret) {
+		wmt_err("WLAN remove failed (%d)\n", ret);
+		return ret;
+	}
+
+	g_wmt.func_on_bits &= ~BIT(WMT_WIFI_ON_BIT);
+	return 0;
+}
+
+int wmt_func_on(int type)
+{
+	switch (type) {
+	case WMTDRV_BT:
+		return wmt_func_bt_on();
+	case WMTDRV_FM:
+		return wmt_func_fm_on();
+	case WMTDRV_GPS:
+		return wmt_func_gps_on();
+	case WMTDRV_WIFI:
+		return wmt_func_wifi_on();
+	default:
+		return -EINVAL;
+	}
+}
+
+int wmt_func_off(int type)
+{
+	switch (type) {
+	case WMTDRV_BT:
+		return wmt_func_bt_off();
+	case WMTDRV_FM:
+		return wmt_func_fm_off();
+	case WMTDRV_GPS:
+		return wmt_func_gps_off();
+	case WMTDRV_WIFI:
+		return wmt_func_wifi_off();
+	default:
+		return -EINVAL;
+	}
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_ic_soc.c b/drivers/misc/mediatek/connectivity/wmt/wmt_ic_soc.c
new file mode 100644
index 000000000..2edb248da
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_ic_soc.c
@@ -0,0 +1,710 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN SOC_CONSYS firmware bring-up: version detection, WMT init
+ * scripts and firmware patch download.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_ic_soc.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The bring-up sequence is the one the downstream driver runs on MT6735/
+ * MT6737T (CFG_WMT_POWER_ON_DLM, CFG_WMT_MULTI_PATCH, CFG_WMT_PATCH_DL_OPTM,
+ * CFG_WMT_FILTER_MODE_SETTING all enabled):
+ *
+ *	query STP defaults -> set STP options -> switch host STP to full mode
+ *	-> power-on DLM patch -> patch download (one PDU fragment chain per
+ *	patch file) -> WMT reset -> RF calibration -> coexistence -> FM strap
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/string.h>
+
+#include "wmt_local.h"
+
+#define DEFAULT_PATCH_FRAG_SIZE	1000
+#define WMT_PATCH_FRAG_1ST	0x1
+#define WMT_PATCH_FRAG_MID	0x2
+#define WMT_PATCH_FRAG_LAST	0x3
+
+/* WMT_STRAP_CONF_CMD / EVT for the FM interface (wmt_ic_soc.c:255-257). */
+static const u8 wmt_query_stp_cmd[] = { 0x01, 0x04, 0x01, 0x00, 0x04 };
+static const u8 wmt_query_stp_evt_default[] = {
+	0x02, 0x04, 0x06, 0x00, 0x00, 0x04, 0x11, 0x00, 0x00, 0x00,
+};
+static const u8 wmt_query_stp_evt[] = {
+	0x02, 0x04, 0x06, 0x00, 0x00, 0x04, 0xdf, 0x0e, 0x68, 0x01,
+};
+static const u8 wmt_set_stp_cmd[] = {
+	0x01, 0x04, 0x05, 0x00, 0x03, 0xdf, 0x0e, 0x68, 0x01,
+};
+static const u8 wmt_set_stp_evt[] = { 0x02, 0x04, 0x02, 0x00, 0x00, 0x03 };
+static const u8 wmt_reset_cmd[] = { 0x01, 0x07, 0x01, 0x00, 0x04 };
