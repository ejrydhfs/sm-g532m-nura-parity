+/* wmt_ic_soc.c:898-1290 */
+int wmt_ic_soc_sw_init(struct wmt_hif_conf *hif)
+{
+	struct wmt_gen_conf *conf = wmt_lib_gen_conf();
+	u8 strap_cmd[sizeof(wmt_strap_fm_cmd)];
+	u8 strap_evt[sizeof(wmt_strap_fm_evt)];
+	struct wmt_init_script strap_script[1];
+	u8 tssi_cmd[sizeof(wmt_bt_tssi_cmd)];
+	struct wmt_init_script tssi_script[1];
+	unsigned long pa1, pa2;
+	u32 patch_num, i;
+	int ret;
+
+	if (!soc_info || !hif) {
+		wmt_err("SOC not identified yet\n");
+		return -EINVAL;
+	}
+
+	if (hif->hif_type == WMT_HIF_BTIF) {
+		/* 1. query chip STP defaults */
+		ret = wmt_core_init_script(query_stp_script,
+					   ARRAY_SIZE(query_stp_script));
+		if (ret) {
+			wmt_err("query STP defaults failed (%d)\n", ret);
+			return ret;
+		}
+
+		/* 2. configure chip STP options */
+		ret = wmt_core_init_script(set_stp_script,
+					   ARRAY_SIZE(set_stp_script));
+		if (ret) {
+			wmt_err("set STP options failed (%d)\n", ret);
+			return ret;
+		}
+
+		/* 3. switch the host to STP full mode */
+		pa1 = WMT_STP_CONF_MODE;
+		pa2 = MTKSTP_BTIF_FULL_MODE;
+		ret = wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+		pa1 = WMT_STP_CONF_EN;
+		pa2 = 1;
+		ret += wmt_core_ctrl(WMT_CTRL_STP_CONF, &pa1, &pa2);
+		if (ret) {
+			wmt_err("failed to enable STP full mode (%d)\n", ret);
+			return ret;
+		}
+
+		/* 4. the chip needs at least 2 ms to switch */
+		msleep(10);
+
+		/* 5. verify the chip STP options */
+		ret = wmt_core_init_script(query_stp_full_script,
+					   ARRAY_SIZE(query_stp_full_script));
+		if (ret) {
+			wmt_err("query STP options failed (%d)\n", ret);
+			return ret;
+		}
+	}
+
+	/* 6. power-on DLM patch */
+	ret = wmt_core_init_script(power_on_dlm_script,
+				   ARRAY_SIZE(power_on_dlm_script));
+	if (ret)
+		wmt_warn("power-on DLM patch failed (%d)\n", ret);
+
+	/* 7. firmware patch download, one file at a time */
+	ret = wmt_ic_soc_patch_info_prepare();
+	if (ret) {
+		wmt_err("patch info prepare failed (%d)\n", ret);
+		return ret;
+	}
+
+	pa1 = 0;
+	pa2 = 0;
+	ret = wmt_core_ctrl(WMT_CTRL_GET_PATCH_NUM, &pa1, &pa2);
+	patch_num = pa1;
+	wmt_dbg("patch count %u\n", patch_num);
+	if (!patch_num)
+		wmt_warn("no patch registered by userspace, the firmware will run from ROM\n");
+
+	ret = wmt_core_init_script(mcu_clk_high_script,
+				   ARRAY_SIZE(mcu_clk_high_script));
+	if (ret)
+		wmt_warn("failed to raise the MCU clock (%d)\n", ret);
+
+	for (i = 0; i < patch_num; i++) {
+		ret = wmt_ic_soc_patch_download(i);
+		if (ret) {
+			wmt_err("patch %u download failed (%d)\n", i, ret);
+			return ret;
+		}
+
+		ret = wmt_core_init_script(wmt_reset_script,
+					   ARRAY_SIZE(wmt_reset_script));
+		if (ret) {
+			wmt_err("WMT reset after patch failed (%d)\n", ret);
+			return ret;
+		}
+	}
+
+	ret = wmt_core_init_script(mcu_clk_low_script,
+				   ARRAY_SIZE(mcu_clk_low_script));
+	if (ret)
+		wmt_warn("failed to restore the MCU clock (%d)\n", ret);
+
+	/* 8. RF calibration with the BT and Wi-Fi rails enabled */
+	pa1 = BT_PALDO;
+	pa2 = PALDO_ON;
+	wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+	pa1 = WIFI_PALDO;
+	pa2 = PALDO_ON;
+	wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+
+	ret = wmt_core_init_script(calibration_script,
+				   ARRAY_SIZE(calibration_script));
+
+	pa1 = BT_PALDO;
+	pa2 = PALDO_OFF;
+	wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+	pa1 = WIFI_PALDO;
+	pa2 = PALDO_OFF;
+	wmt_core_ctrl(WMT_CTRL_SOC_PALDO_CTRL, &pa1, &pa2);
+
+	if (ret) {
+		wmt_err("RF calibration failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* 9. coexistence configuration */
+	ret = wmt_core_init_script(coex_script, ARRAY_SIZE(coex_script));
+	if (ret) {
+		wmt_err("coexistence setup failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* 10. co-clock oscillator type */
+	if (soc_co_clock) {
+		ret = wmt_core_init_script(co_clock_script,
+					   ARRAY_SIZE(co_clock_script));
+		if (ret) {
+			wmt_err("oscillator type setup failed (%d)\n", ret);
+			return ret;
+		}
+	}
+
+	/* 11. FM strap configuration */
+	memcpy(strap_cmd, wmt_strap_fm_cmd, sizeof(strap_cmd));
+	memcpy(strap_evt, wmt_strap_fm_evt, sizeof(strap_evt));
+	strap_cmd[5] = hif->strap_conf[0];
+	strap_evt[5] = hif->strap_conf[0];
+	strap_script[0].cmd = strap_cmd;
+	strap_script[0].cmd_sz = sizeof(strap_cmd);
+	strap_script[0].evt = strap_evt;
+	strap_script[0].evt_sz = sizeof(strap_evt);
+	strap_script[0].str = "configure FM interface";
+	ret = wmt_core_init_script(strap_script, 1);
+	if (ret) {
+		wmt_err("FM strap configuration failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* 12. BT TSSI source (WMT_SOC.cfg) */
+	if (conf && conf->bt_tssi_from_wifi) {
+		memcpy(tssi_cmd, wmt_bt_tssi_cmd, sizeof(tssi_cmd));
+		tssi_cmd[5] = conf->bt_tssi_from_wifi;
+		tssi_cmd[6] = conf->bt_tssi_target & 0xff;
+		tssi_cmd[7] = (conf->bt_tssi_target >> 8) & 0xff;
+		tssi_script[0].cmd = tssi_cmd;
+		tssi_script[0].cmd_sz = sizeof(tssi_cmd);
+		tssi_script[0].evt = wmt_bt_tssi_evt;
+		tssi_script[0].evt_sz = sizeof(wmt_bt_tssi_evt);
+		tssi_script[0].str = "bt tssi from wifi";
+		ret = wmt_core_init_script(tssi_script, 1);
+		if (ret)
+			wmt_warn("BT TSSI configuration failed (%d)\n", ret);
+	}
+
+	return 0;
+}
+
+int wmt_ic_soc_sw_deinit(struct wmt_hif_conf *hif)
+{
+	soc_info = NULL;
+	return 0;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_lib.c b/drivers/misc/mediatek/connectivity/wmt/wmt_lib.c
new file mode 100644
index 000000000..3860c3244
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_lib.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT library: driver state, configuration and recovery.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/wmt_lib.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/wmt_exp.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The WMT protocol is strictly request/event, so all exchanges are executed
+ * one at a time under g_wmt.op_lock.  Downstream serialised them through the
+ * mtk_wmtd kernel thread; with the STP power-saving engine not ported a
+ * mutex around the command engine has the same ordering guarantees and
+ * removes the extra thread.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
+
+#include "wmt_local.h"
+
+struct wmt_dev g_wmt;
+
+static struct work_struct wmt_reset_work;
+
+static void wmt_lib_reset_work_fn(struct work_struct *work)
+{
+	wmt_lib_cmb_rst(WMTRSTSRC_RESET_STP);
+}
+
+void wmt_lib_schedule_reset(enum wmt_rst_src src)
+{
+	wmt_dbg("scheduling CONSYS reset (source %d)\n", src);
+	schedule_work(&wmt_reset_work);
+}
+
+/* wmt_lib.c:1417-1443 */
+void wmt_lib_notify_reset(enum wmt_rst_msg msg)
+{
+	int i;
+
+	for (i = 0; i < WMTDRV_MAX; i++) {
+		if (!g_wmt.msgcb[i])
+			continue;
+
+		g_wmt.msgcb[i](WMTDRV_WMT, i, WMTMSG_RESET, &msg,
+			       sizeof(msg));
+		wmt_dbg("reset message sent to driver %d\n", i);
+	}
+}
+
+/* wmt_lib.c:1617-1712 */
+bool wmt_lib_cmb_rst(enum wmt_rst_src src)
+{
+	struct wmt_op op = { };
+	bool ok = false;
+	int retries = 10;
+	int ret;
+
+	if (test_and_set_bit(WMT_STAT_RST_ON, &g_wmt.state)) {
+		wmt_info("reset already in progress\n");
+		return false;
+	}
+
+	mtk_wcn_stp_enable(0);
+	wmt_lib_notify_reset(WMTRSTMSG_RESET_START);
+
+	while (retries--) {
+		op.op_id = WMT_OPID_HW_RST;
+		ret = wmt_lib_run_op(&op);
+		if (ret) {
+			wmt_err("hardware reset failed (%d)\n", ret);
+			continue;
+		}
+
+		op.op_id = WMT_OPID_SW_RST;
+		ret = wmt_lib_run_op(&op);
+		if (ret) {
+			wmt_err("software reset failed (%d)\n", ret);
+			continue;
+		}
+
+		ok = true;
+		break;
+	}
+
+	clear_bit(WMT_STAT_RST_ON, &g_wmt.state);
+	mtk_wcn_stp_set_wmt_evt_err_trg_assert(0);
+
+	if (ok) {
+		wmt_info("CONSYS reset succeeded\n");
+		wmt_lib_notify_reset(WMTRSTMSG_RESET_END);
+	} else {
+		wmt_err("CONSYS reset failed\n");
+		wmt_lib_notify_reset(WMTRSTMSG_RESET_END_FAIL);
+	}
+
+	return ok;
+}
+
+int wmt_lib_run_op(struct wmt_op *op)
+{
+	int ret;
+
+	if (!op)
+		return -EINVAL;
+
+	mutex_lock(&g_wmt.op_lock);
+	ret = wmt_core_opid(op);
+	mutex_unlock(&g_wmt.op_lock);
+
+	return ret;
+}
+
+int wmt_lib_init(void)
+{
+	int ret;
+
+	memset(&g_wmt, 0, sizeof(g_wmt));
+	mutex_init(&g_wmt.op_lock);
+	init_waitqueue_head(&g_wmt.cmd_wq);
+	init_waitqueue_head(&g_wmt.rx_wq);
+
+	strscpy(g_wmt.patch_name, WMT_DEFAULT_PATCH_NAME,
+		sizeof(g_wmt.patch_name));
+	strscpy(g_wmt.cfg_name, WMT_CFG_PREFIX WMT_CFG_NAME,
+		sizeof(g_wmt.cfg_name));
+
+	g_wmt.hif.hif_type = WMT_HIF_BTIF;
+	g_wmt.hif.strap_conf[0] = WMT_FM_COMM;
+	g_wmt.e_hw_ver = WMTHWVER_INVALID;
+
+	INIT_WORK(&wmt_reset_work, wmt_lib_reset_work_fn);
+
+	ret = wmt_conf_read_file();
+	if (ret)
+		wmt_warn("no usable %s, using defaults\n", g_wmt.cfg_name);
+
+	wmt_core_init();
+
+	ret = wmt_plat_init();
+	if (ret) {
+		wmt_err("platform init failed (%d)\n", ret);
+		wmt_lib_deinit();
+		return ret;
+	}
+
+	g_wmt.ready = true;
+
+	wmt_info("WMT driver initialised\n");
+	return 0;
+}
+
+void wmt_lib_deinit(void)
+{
+	struct wmt_op op = { };
+	int i;
+
+	cancel_work_sync(&wmt_reset_work);
+
+	/* Tear the firmware down before releasing the platform resources so
+	 * that the BTIF channel is closed while the transport still exists.
+	 */
+	for (i = 0; i < WMTDRV_WMT; i++) {
+		if (g_wmt.drv_status[i] != DRV_STS_FUNC_ON)
+			continue;
+		op.op_id = WMT_OPID_FUNC_OFF;
+		op.data[0] = i;
+		wmt_lib_run_op(&op);
+	}
+
+	if (g_wmt.drv_status[WMTDRV_WMT] != DRV_STS_POWER_OFF) {
+		op.op_id = WMT_OPID_PWR_OFF;
+		memset(op.data, 0, sizeof(op.data));
+		wmt_lib_run_op(&op);
+	}
+
+	wmt_plat_deinit();
+	wmt_core_deinit();
+	kfree(g_wmt.patch_info);
+	g_wmt.patch_info = NULL;
+	wmt_dev_patch_put();
+	g_wmt.ready = false;
+	mutex_destroy(&g_wmt.op_lock);
+}
+
+struct wmt_hif_conf *wmt_lib_hif(void)
+{
+	return &g_wmt.hif;
+}
+
+struct wmt_gen_conf *wmt_lib_gen_conf(void)
+{
+	return &g_wmt.gen_conf;
+}
+
+/* wmt_lib.c:393-429 */
+int wmt_lib_set_hif(unsigned long cfg)
+{
+	u32 val = cfg & 0xf;
+
+	switch (val) {
+	case STP_BTIF_FULL:
+		g_wmt.hif.hif_type = WMT_HIF_BTIF;
+		break;
+	case STP_SDIO:
+	case STP_UART_FULL:
+	case STP_UART_MAND:
+		wmt_err("HIF mode 0x%x is not supported on this platform\n",
+			val);
+		return -EOPNOTSUPP;
+	default:
+		wmt_err("invalid STP mode 0x%x\n", val);
+		return -EINVAL;
+	}
+
+	val = (cfg & 0xf0) >> 4;
+	if (val == WMT_FM_COMM || val == WMT_FM_I2C)
+		g_wmt.hif.strap_conf[0] = val;
+	else
+		return -EINVAL;
+
+	wmt_info("HIF mode %u, FM interface %u\n", g_wmt.hif.hif_type,
+		 g_wmt.hif.strap_conf[0]);
+	return 0;
+}
+
+void wmt_lib_set_patch_name(const char *name)
+{
+	if (!name)
+		return;
+
+	strscpy(g_wmt.patch_name, name, sizeof(g_wmt.patch_name));
+}
+
+u32 wmt_lib_get_icinfo(enum wmt_chipinfo_type type)
+{
+	switch (type) {
+	case WMTCHIN_CHIPID:
+		return g_wmt.chip_id;
+	case WMTCHIN_HWVER:
+		return g_wmt.hw_ver;
+	case WMTCHIN_MAPPINGHWVER:
+		return g_wmt.e_hw_ver;
+	case WMTCHIN_FWVER:
+		return g_wmt.fw_ver;
+	default:
+		return 0;
+	}
+}
+
+enum mtk_wcn_wmt_hwver wmt_lib_hwver(void)
+{
+	return g_wmt.e_hw_ver;
+}
+
+void wmt_lib_set_chip_info(u32 chip_id, u32 hw_ver, u32 fw_ver,
+			   enum mtk_wcn_wmt_hwver e_hw_ver)
+{
+	g_wmt.chip_id = chip_id;
+	g_wmt.hw_ver = hw_ver;
+	g_wmt.fw_ver = fw_ver;
+	g_wmt.e_hw_ver = e_hw_ver;
+}
+
+u32 wmt_lib_co_clock(void)
+{
+	return g_wmt.gen_conf.co_clock_flag & 0x0f ? 1 : 0;
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/wmt_local.h b/drivers/misc/mediatek/connectivity/wmt/wmt_local.h
new file mode 100644
index 000000000..3c7ff906f
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/wmt_local.h
@@ -0,0 +1,555 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WCN WMT/CONSYS core - private definitions.
+ *
+ * Port from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/include/
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/include/
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/mt6735/include/mtk_wcn_consys_hw.h
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ */
+
+#ifndef _WMT_LOCAL_H_
+#define _WMT_LOCAL_H_
+
+#include <linux/firmware.h>
+#include <linux/limits.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/timer.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+#include <linux/workqueue.h>
+
+#include <mtk_wcn_consys.h>
+#include <mtk_wcn_stp.h>
+#include <mtk_wcn_wmt.h>
+
+#define WMT_PFX		"WMT: "
+#define WMT_STP_PFX	"STP: "
+
+#define wmt_dbg(fmt, ...)	pr_debug(WMT_PFX fmt, ##__VA_ARGS__)
+#define wmt_info(fmt, ...)	pr_info(WMT_PFX fmt, ##__VA_ARGS__)
+#define wmt_warn(fmt, ...)	pr_warn(WMT_PFX fmt, ##__VA_ARGS__)
+#define wmt_err(fmt, ...)	pr_err(WMT_PFX fmt, ##__VA_ARGS__)
+#define stp_dbg(fmt, ...)	pr_debug(WMT_STP_PFX fmt, ##__VA_ARGS__)
+#define stp_info(fmt, ...)	pr_info(WMT_STP_PFX fmt, ##__VA_ARGS__)
+#define stp_warn(fmt, ...)	pr_warn(WMT_STP_PFX fmt, ##__VA_ARGS__)
+#define stp_err(fmt, ...)	pr_err(WMT_STP_PFX fmt, ##__VA_ARGS__)
+
+/* ------------------------------------------------------------------------- *
+ * STP wire protocol constants
+ * (stp_core.h:118-140, stp_core.c:34)
+ * ------------------------------------------------------------------------- */
+#define STP_DEL_SIZE		2
+#define MTKSTP_CRC_SIZE		2
+#define MTKSTP_HEADER_SIZE	4
+#define MTKSTP_SEQ_SIZE		8
+#define MTKSTP_WINSIZE		7
+#define MTKSTP_TX_TIMEOUT	180	/* ms */
+#define MTKSTP_RETRY_LIMIT	10
+
+#define MTKSTP_UART_FULL_MODE	BIT(0)
+#define MTKSTP_UART_MAND_MODE	BIT(1)
+#define MTKSTP_BTIF_FULL_MODE	BIT(2)
+#define MTKSTP_BTIF_MAND_MODE	BIT(3)
+#define MTKSTP_SDIO_MODE	BIT(4)
+
+/* WMT-LTE coexistence sub-type byte, dropped on non-LTE projects
+ * (stp_core.c:1251-1270).
+ */
+#define WMT_LTE_COEX_FLAG	0x16
+
+/* ------------------------------------------------------------------------- *
+ * WMT wire protocol constants (wmt_core.h:82-91)
+ * ------------------------------------------------------------------------- */
+#define WMT_HDR_LEN		4
+#define WMT_STS_LEN		1
+#define WMT_FLAG_LEN		1
+#define WMT_FUNC_CTRL_PARAM_LEN	1
+#define BCNT_PATCH_BUF_HEADROOM	8
+#define DWCNT_HIF_CONF		4
+#define DWCNT_STRAP_CONF	4
+
+#define WMT_LIB_RX_TIMEOUT	2000	/* ms, wmt_lib.h:69 */
+#define MAX_EACH_WMT_CMD	(WMT_LIB_RX_TIMEOUT + 1000)
+#define MAX_EACH_FUNC_OFF	(WMT_LIB_RX_TIMEOUT + 1000)
+#define MAX_FUNC_ON_TIME	12000
+#define MAX_FUNC_OFF_TIME	12000
+#define MAX_GPIO_CTRL_TIME	2000
+#define WMT_PWRON_RTY_DFT	2
+#define MAX_PATCH_NUM		10
+
+/* Default launcher-supplied patch file name (wmt_core.h:52). */
+#define WMT_DEFAULT_PATCH_NAME	"mt66xx_patch_hdr.bin"
+/* wmt_conf.h:33-34 */
+#define WMT_CFG_PREFIX		"/system/etc/firmware/"
+#define WMT_CFG_NAME		"WMT_SOC.cfg"
+
+/* WMT register space seen from the firmware (wmt_ic.h:54-60). */
+#define GEN_CONFG_BASE		0x80000000
+#define GEN_HVR			(GEN_CONFG_BASE + 0x0)
+#define GEN_FVR			(GEN_CONFG_BASE + 0x4)
+#define GEN_VER_MASK		0x0000ffff
+#define GEN_HCR			(GEN_CONFG_BASE + 0x8)
+#define GEN_HCR_MASK		0x0000ffff
+
+#define MAJORNUM(x)		((x) & 0x00f0)
+#define MINORNUM(x)		((x) & 0x000f)
+
+/* ------------------------------------------------------------------------- *
+ * STP parser states (stp_core.h:229-245)
+ * ------------------------------------------------------------------------- */
+enum stp_parser_state {
+	STP_SYNC = 0,
+	STP_SEQ,
+	STP_ACK,
+	STP_NAK,
+	STP_TYPE,
+	STP_LENGTH,
+	STP_CHECKSUM,
+	STP_DATA,
+	STP_CRC1,
+	STP_CRC2,
+	STP_RESYNC1,
+	STP_RESYNC2,
+	STP_RESYNC3,
+	STP_RESYNC4,
+	STP_FW_MSG,
+};
+
+struct stp_parser {
+	enum stp_parser_state state;
+	u8 seq;
+	u8 ack;
+	u8 nak;
+	u8 type;
+	u16 length;
+	u8 checksum;
+	u16 crc;
+	u8 wmt_subtype;
+};
+
+struct stp_sequence {
+	u8 txseq;		/* last tx pkt's seq + 1 */
+	u8 txack;		/* last tx pkt's ack */
+	u8 rxack;		/* last rx pkt's ack */
+	u8 winspace;		/* current sliding window size */
+	u8 expected_rxseq;	/* last rx pkt's seq + 1 */
+	u8 retry_times;
+};
+
+struct stp_ring {
+	spinlock_t lock;
+	u8 buffer[MTKSTP_BUFFER_SIZE];
+	u32 read_p;
+	u32 write_p;
+};
+
+/* ------------------------------------------------------------------------- *
+ * WMT driver types
+ * ------------------------------------------------------------------------- */
+enum wmt_drv_status {
+	DRV_STS_POWER_OFF = 0,
+	DRV_STS_POWER_ON = 1,
+	DRV_STS_FUNC_ON = 2,
+	DRV_STS_MAX
+};
+
