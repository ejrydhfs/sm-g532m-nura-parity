diff --git a/drivers/misc/mediatek/connectivity/wmt/consys_mt6735.c b/drivers/misc/mediatek/connectivity/wmt/consys_mt6735.c
new file mode 100644
index 000000000..9aa0eb7e6
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/consys_mt6735.c
@@ -0,0 +1,853 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6735/MT6737T CONSYS platform glue.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/mt6735/mtk_wcn_consys_hw.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/mt6735/wmt_plat_alps.c
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * The connectivity subsystem is a separate MCU with its own power domain,
+ * clock gates and LDOs.  Register layout (see the DT binding of
+ * "mediatek,mt6735-consys"):
+ *
+ *	reg[0] CONN_MCU_CONFIG_BASE	chip id, MBIST control, CPUPCR
+ *	reg[1] AP_RGU_BASE		CPU software reset
+ *	reg[2] TOPCKGEN_BASE		EMI remapping window
+ *	reg[3] SPM_BASE			power-on configuration
+ *
+ * The SPM power gate and AXI bus protection of the downstream sequence
+ * (CONSYS_TOP1_PWR_CTRL_REG / CONSYS_TOPAXI_PROT_*) are handled by the
+ * MT6735 power-domain controller declared through "power-domains"; this
+ * driver asserts the reset, powers the rails, gates the clocks and polls the
+ * chip id exactly like the downstream driver does around those steps.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/of_platform.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include "wmt_local.h"
+
+/* mtk_wcn_consys_hw.h:57-86 */
+#define CONSYS_CPU_SW_RST_OFFSET	0x00000018
+#define CONSYS_CPU_SW_RST_BIT		BIT(12)
+#define CONSYS_CPU_SW_RST_CTRL_KEY	(0x88 << 24)
+
+#define CONSYS_PWRON_CONFG_EN_OFFSET	0x00000000
+#define CONSYS_PWRON_CONFG_EN_VALUE	0x0b160001
+
+#define CONSYS_EMI_MAPPING_OFFSET	0x00000320
+#define CONSYS_CHIP_ID_OFFSET		0x00000008
+#define CONSYS_MCU_CFG_ACR_OFFSET	0x00000110
+#define CONSYS_MCU_CFG_ACR_MBIST_BIT	BIT(18)
+#define CONSYS_CPUPCR_OFFSET		0x00000160
+
+/* mtk_wcn_consys_hw.h:171-181 */
+#define CONSYS_EMI_AP_PHY_OFFSET	0x80000
+#define CONSYS_EMI_MEM_SIZE		(343 * 1024)
+#define CONSYS_EMI_MAPPING_EN		BIT(12)
+#define CONSYS_EMI_ADDR_MASK		0xfff00000
+
+/* Accepted CONSYS chip ids (mtk_wcn_consys_hw.c:487-489). */
+#define CONSYS_CHIP_ID_MT6735		0x0321
+#define CONSYS_CHIP_ID_MT6735M		0x0335
+#define CONSYS_CHIP_ID_MT6753		0x0337
+
+/* PMIC LDO voltages, downstream VOL_1800 / VOL_2800 / VOL_3300. */
+#define CONSYS_VCN18_UV			1800000
+#define CONSYS_VCN28_UV			2800000
+#define CONSYS_VCN33_UV			3300000
+
+/* mtk_wcn_consys_hw.c:481-490 (10 retries, 20 ms apart). */
+#define CONSYS_CHIPID_RETRY		10
+#define CONSYS_CHIPID_DELAY_MS		20
+
+struct mtk_consys {
+	struct device *dev;
+	void __iomem *mcu;
+	void __iomem *ap_rgu;
+	void __iomem *topckgen;
+	void __iomem *spm;
+
+	struct clk *clk_conn;
+	struct clk *clk_bus;		/* optional, ROM DT has a second gate */
+
+	struct regulator *vcn18;
+	struct regulator *vcn28;
+	struct regulator *vcn33_bt;
+	struct regulator *vcn33_wifi;
+
+	struct pinctrl *pinctrl;
+
+	int irq_bgf;
+	bool bgf_irq_requested;
+	bool powered;
+	bool probed;
+
+	/* Resources currently enabled by this driver. */
+	bool pm_on;
+	bool clk_conn_on;
+	bool clk_bus_on;
+	bool vcn18_on;
+	bool vcn28_on;
+
+	phys_addr_t emi_phys;
+	void __iomem *emi_virt;
+
+	struct mutex wake_lock;
+	int wake_count;
+};
+
+static struct mtk_consys consys;
+
+static inline u32 consys_read(void __iomem *base, u32 off)
+{
+	return readl(base + off);
+}
+
+static inline void consys_write(void __iomem *base, u32 off, u32 val)
+{
+	writel(val, base + off);
+}
+
+static void consys_read_modify_write(void __iomem *base, u32 off, u32 set,
+				     u32 clr)
+{
+	u32 val = consys_read(base, off);
+
+	val &= ~clr;
+	val |= set;
+	consys_write(base, off, val);
+}
+
+static bool consys_chipid_valid(u32 id)
+{
+	return id == CONSYS_CHIP_ID_MT6735 || id == CONSYS_CHIP_ID_MT6735M ||
+	       id == CONSYS_CHIP_ID_MT6753;
+}
+
+/*
+ * Regulators (mtk_wcn_consys_hw.c:349-410, 900-1050)
+ */
+
+static int consys_regulator_enable(struct regulator *reg, u32 uv,
+				   const char *name)
+{
+	int ret;
+
+	if (!reg)
+		return -ENODEV;
+
+	ret = regulator_set_voltage(reg, uv, uv);
+	if (ret) {
+		wmt_err("failed to set %s to %u uV (%d)\n", name, uv, ret);
+		return ret;
+	}
+
+	ret = regulator_enable(reg);
+	if (ret) {
+		wmt_err("failed to enable %s (%d)\n", name, ret);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void consys_regulator_disable(struct regulator *reg, const char *name)
+{
+	if (reg &&
+	    regulator_disable(reg))
+		wmt_err("failed to disable %s\n", name);
+}
+
+int wmt_plat_soc_paldo_ctrl(enum wmt_paldo_type type, enum wmt_paldo_op op)
+{
+	bool on = op == PALDO_ON;
+	int ret;
+
+	switch (type) {
+	case BT_PALDO:
+		if (on)
+			ret = consys_regulator_enable(consys.vcn33_bt,
+						      CONSYS_VCN33_UV,
+						      "vcn33_bt");
+		else {
+			consys_regulator_disable(consys.vcn33_bt, "vcn33_bt");
+			ret = 0;
+		}
+		break;
+	case WIFI_PALDO:
+		if (on)
+			ret = consys_regulator_enable(consys.vcn33_wifi,
+						      CONSYS_VCN33_UV,
+						      "vcn33_wifi");
+		else {
+			consys_regulator_disable(consys.vcn33_wifi,
+						 "vcn33_wifi");
+			ret = 0;
+		}
+		break;
+	case FM_PALDO:
+	case GPS_PALDO:
+		/* In co-clock mode FM/GPS power VCN28 explicitly
+		 * (mtk_wcn_consys_hw.c:1084-1110).
+		 */
+		if (on)
+			ret = consys_regulator_enable(consys.vcn28,
+						      CONSYS_VCN28_UV,
+						      "vcn28");
+		else {
+			consys_regulator_disable(consys.vcn28, "vcn28");
+			ret = 0;
+		}
+		break;
+	case PMIC_CHIPID_PALDO:
+	case WIFI_5G_PALDO:
+	default:
+		wmt_warn("PALDO %d is not supported\n", type);
+		ret = -EOPNOTSUPP;
+		break;
+	}
+
+	return ret;
+}
+
+/*
+ * Power on / off (mtk_wcn_consys_hw.c:335-845)
+ */
+
+static int consys_reg_ctrl(bool on)
+{
+	u32 chip_id = 0;
+	int retry = CONSYS_CHIPID_RETRY;
+	int ret;
+
+	wmt_dbg("CONSYS register control (%d)\n", on);
+
+	if (on) {
+		/* 1. VCN18 always on (mtk_wcn_consys_hw.c:356-370) */
+		ret = consys_regulator_enable(consys.vcn18, CONSYS_VCN18_UV,
+					      "vcn18");
+		if (ret)
+			return ret;
+		consys.vcn18_on = true;
+		udelay(150);
+
+		/* 2. VCN28: software controlled in co-clock mode, powered
+		 * here otherwise (mtk_wcn_consys_hw.c:372-400).
+		 */
+		if (!wmt_lib_co_clock()) {
+			ret = consys_regulator_enable(consys.vcn28,
+						      CONSYS_VCN28_UV,
+						      "vcn28");
+			if (ret)
+				goto err_vcn18;
+			consys.vcn28_on = true;
+		}
+
+		/* 3. assert the CONNSYS CPU software reset */
+		consys_write(consys.ap_rgu, CONSYS_CPU_SW_RST_OFFSET,
+			     consys_read(consys.ap_rgu,
+					 CONSYS_CPU_SW_RST_OFFSET) |
+			     CONSYS_CPU_SW_RST_BIT |
+			     CONSYS_CPU_SW_RST_CTRL_KEY);
+
+		/* 4. SPM clock gating for the power-on configuration */
+		consys_write(consys.spm, CONSYS_PWRON_CONFG_EN_OFFSET,
+			     CONSYS_PWRON_CONFG_EN_VALUE);
+
+		/* 5. power up the CONN power domain */
+		ret = pm_runtime_get_sync(consys.dev);
+		if (ret < 0) {
+			wmt_err("failed to power on the CONN domain (%d)\n",
+				ret);
+			goto err_vcn28;
+		}
+		consys.pm_on = true;
+
+		/* 6. CONN bus clock.  The downstream driver waits 10 us
+		 * after the domain is powered before enabling it
+		 * (mtk_wcn_consys_hw.c:487-501).
+		 */
+		udelay(10);
+		ret = clk_prepare_enable(consys.clk_conn);
+		if (ret) {
+			wmt_err("failed to enable the conn clock (%d)\n", ret);
+			goto err_pm;
+		}
+		consys.clk_conn_on = true;
+
+		if (consys.clk_bus) {
+			ret = clk_prepare_enable(consys.clk_bus);
+			if (ret) {
+				wmt_err("failed to enable the bus clock (%d)\n",
+					ret);
+				goto err_clk;
+			}
+			consys.clk_bus_on = true;
+		}
+
+		/* 7. wait until the MCU reports its chip id */
+		while (retry-- > 0) {
+			chip_id = consys_read(consys.mcu, CONSYS_CHIP_ID_OFFSET);
+			if (consys_chipid_valid(chip_id)) {
+				wmt_info("CONSYS chip id 0x%08x\n", chip_id);
+				break;
+			}
+			wmt_dbg("CONSYS chip id 0x%08x, retrying\n", chip_id);
+			msleep(CONSYS_CHIPID_DELAY_MS);
+		}
+
+		if (!consys_chipid_valid(chip_id)) {
+			wmt_err("CONSYS did not report a valid chip id (0x%08x)\n",
+				chip_id);
+			wmt_err("RGU 0x%08x SPM 0x%08x\n",
+				consys_read(consys.ap_rgu,
+					    CONSYS_CPU_SW_RST_OFFSET),
+				consys_read(consys.spm,
+					    CONSYS_PWRON_CONFG_EN_OFFSET));
+			ret = -ENODEV;
+			goto err_bus_clk;
+		}
+
+		/* 8. run the memory MBIST at full MCU speed */
+		consys_read_modify_write(consys.mcu,
+					 CONSYS_MCU_CFG_ACR_OFFSET,
+					 CONSYS_MCU_CFG_ACR_MBIST_BIT, 0);
+
+		/* 9. release the CPU software reset */
+		consys_write(consys.ap_rgu, CONSYS_CPU_SW_RST_OFFSET,
+			     (consys_read(consys.ap_rgu,
+					  CONSYS_CPU_SW_RST_OFFSET) &
+			      ~CONSYS_CPU_SW_RST_BIT) |
+			     CONSYS_CPU_SW_RST_CTRL_KEY);
+
+		/* 10. give the firmware time to boot (msleep < 20 ms can
+		 * sleep up to 20 ms, mtk_wcn_consys_hw.c:845).
+		 */
+		msleep(20);
+		return 0;
+	}
+
+	/* Power off in the reverse order (mtk_wcn_consys_hw.c:640-720). */
+	if (consys.clk_bus_on) {
+		clk_disable_unprepare(consys.clk_bus);
+		consys.clk_bus_on = false;
+	}
+	if (consys.clk_conn_on) {
+		clk_disable_unprepare(consys.clk_conn);
+		consys.clk_conn_on = false;
+	}
+	if (consys.pm_on) {
+		pm_runtime_put_sync(consys.dev);
+		consys.pm_on = false;
+	}
+
+	if (consys.vcn28_on) {
+		consys_regulator_disable(consys.vcn28, "vcn28");
+		consys.vcn28_on = false;
+	}
+	if (consys.vcn18_on) {
+		consys_regulator_disable(consys.vcn18, "vcn18");
+		consys.vcn18_on = false;
+	}
+
+	return 0;
+
+err_bus_clk:
+	if (consys.clk_bus_on) {
+		clk_disable_unprepare(consys.clk_bus);
+		consys.clk_bus_on = false;
+	}
+err_clk:
+	if (consys.clk_conn_on) {
+		clk_disable_unprepare(consys.clk_conn);
+		consys.clk_conn_on = false;
+	}
+err_pm:
+	if (consys.pm_on) {
+		pm_runtime_put_sync(consys.dev);
+		consys.pm_on = false;
+	}
+err_vcn28:
+	if (consys.vcn28_on) {
+		consys_regulator_disable(consys.vcn28, "vcn28");
+		consys.vcn28_on = false;
+	}
+err_vcn18:
+	if (consys.vcn18_on) {
+		consys_regulator_disable(consys.vcn18, "vcn18");
+		consys.vcn18_on = false;
+	}
+	return ret;
+}
+
+/*
+ * BGF (BTIF wakeup) interrupt, mtk_wcn_consys_hw.c:800-845 and
+ * wmt_plat_alps.c:224-270.
+ */
+static irqreturn_t consys_bgf_irq(int irq, void *data)
+{
+	/* The downstream handler disables the line and notifies the STP
+	 * power-saving engine.  The power-saving engine is not ported, so the
+	 * line stays disabled and this handler only kicks any waiter.
+	 */
+	wmt_dev_rx_event_cb();
+	return IRQ_HANDLED;
+}
+
+static int consys_irq_init(bool on)
+{
+	int ret;
+
+	if (on) {
+		if (consys.irq_bgf > 0 && !consys.bgf_irq_requested) {
+			ret = request_irq(consys.irq_bgf, consys_bgf_irq,
+					  irq_get_trigger_type(consys.irq_bgf),
+					  "BTIF_WAKEUP_IRQ", NULL);
+			if (ret) {
+				wmt_err("failed to request BGF IRQ %d (%d)\n",
+					consys.irq_bgf, ret);
+				return ret;
+			}
+			consys.bgf_irq_requested = true;
+		}
+
+		/* The downstream driver keeps the wakeup interrupt disabled and
+		 * only enables it from the STP power-saving engine
+		 * (wmt_plat_alps.c:300-330), which is not ported.
+		 */
+		disable_irq_nosync(consys.irq_bgf);
+		wmt_dbg("BGF IRQ registered and disabled\n");
+		return 0;
+	}
+
+	if (consys.bgf_irq_requested) {
+		disable_irq_nosync(consys.irq_bgf);
+		free_irq(consys.irq_bgf, NULL);
+		consys.bgf_irq_requested = false;
+	}
+
+	return 0;
+}
+
+int mtk_wcn_consys_hw_pwr_on(void)
+{
+	int ret;
+
+	if (!consys.probed)
+		return -ENODEV;
+
+	if (consys.powered)
+		return -EALREADY;
+
+	wmt_info("CONSYS power on\n");
+	ret = consys_reg_ctrl(true);
+	if (ret) {
+		wmt_err("CONSYS register control failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = consys_irq_init(true);
+	consys.powered = true;
+	wmt_info("CONSYS power on done (%d)\n", ret);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_pwr_on);
+
+
+int mtk_wcn_consys_hw_pwr_off(void)
+{
+	if (!consys.probed)
+		return -ENODEV;
+
+	if (!consys.powered)
+		return -EALREADY;
+
+	wmt_info("CONSYS power off\n");
+	consys_irq_init(false);
+	consys.powered = false;
+	return consys_reg_ctrl(false);
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_pwr_off);
+
+
+/* mtk_wcn_consys_hw.c:825-845 */
+int mtk_wcn_consys_hw_rst(void)
+{
+	int ret;
+
+	wmt_info("CONSYS hardware reset\n");
+
+	if (!consys.probed)
+		return -ENODEV;
+
+	consys_irq_init(false);
+	ret = consys_reg_ctrl(false);
+	if (ret)
+		wmt_err("CONSYS power off during reset failed (%d)\n", ret);
+
+	consys.powered = false;
+	ret = consys_reg_ctrl(true);
+	if (ret) {
+		wmt_err("CONSYS power on during reset failed (%d)\n", ret);
+		return ret;
+	}
+
+	consys.powered = true;
+	ret = consys_irq_init(true);
+	wmt_info("CONSYS hardware reset done (%d)\n", ret);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_rst);
+
+
+/* mtk_wcn_consys_hw.c:1190-1233 */
+phys_addr_t mtk_wcn_consys_emi_phys_get(void)
+{
+	return consys.emi_phys;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_emi_phys_get);
+
+
+void __iomem *mtk_wcn_consys_emi_virt_get(void)
+{
+	return consys.emi_virt;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_emi_virt_get);
+
+
+/* mtk_wcn_consys_hw.c:1235-1240 */
+u32 mtk_wcn_consys_soc_chipid_get(void)
+{
+	/* Never touch the CONNSYS register window while the power domain is
+	 * off: such an access can stall the AP bus.
+	 */
+	if (!consys.probed || !consys.powered)
+		return 0;
+
+	return consys_read(consys.mcu, CONSYS_CHIP_ID_OFFSET) & 0xffff;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_soc_chipid_get);
+
+
+int mtk_wcn_consys_hw_init(void)
+{
+	struct reserved_mem *rmem;
+	struct device_node *np;
+	u32 addr_phy;
+
+	if (!consys.probed) {
+		wmt_err("CONSYS device not probed\n");
+		return -ENODEV;
+	}
+
+	if (consys.emi_virt)
+		return 0;
+
+	np = of_parse_phandle(consys.dev->of_node, "memory-region", 0);
+	if (!np) {
+		wmt_err("no memory-region for CONSYS\n");
+		return -ENODEV;
+	}
+
+	rmem = of_reserved_mem_lookup(np);
+	of_node_put(np);
+	if (!rmem || !rmem->size) {
+		wmt_err("CONSYS reserved memory is invalid\n");
+		return -ENODEV;
+	}
+
+	consys.emi_phys = rmem->base;
+	wmt_info("CONSYS shared memory at 0x%pa (0x%llx bytes)\n",
+		 &consys.emi_phys, (unsigned long long)rmem->size);
+
+	/* Enable the CONSYS -> AP EMI remapping window
+	 * (mtk_wcn_consys_hw.c:1140-1150).
+	 */
+	addr_phy = ((u32)consys.emi_phys & CONSYS_EMI_ADDR_MASK) >> 20;
+	addr_phy |= CONSYS_EMI_MAPPING_EN;
+	consys_write(consys.topckgen, CONSYS_EMI_MAPPING_OFFSET,
+		     consys_read(consys.topckgen, CONSYS_EMI_MAPPING_OFFSET) |
+		     addr_phy);
+	wmt_info("EMI mapping register 0x%08x\n",
+		 consys_read(consys.topckgen, CONSYS_EMI_MAPPING_OFFSET));
+
+	/* The firmware uses the upper half of the reserved 512 KiB region. */
+	consys.emi_virt = ioremap(consys.emi_phys + CONSYS_EMI_AP_PHY_OFFSET,
+				  CONSYS_EMI_MEM_SIZE);
+	if (!consys.emi_virt) {
+		wmt_err("failed to map the CONSYS shared memory\n");
+		return -ENOMEM;
+	}
+
+	memset_io(consys.emi_virt, 0, CONSYS_EMI_MEM_SIZE);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_init);
+
+
+void mtk_wcn_consys_hw_deinit(void)
+{
+	if (consys.emi_virt) {
+		iounmap(consys.emi_virt);
+		consys.emi_virt = NULL;
+	}
+
+	if (consys.powered)
+		mtk_wcn_consys_hw_pwr_off();
+}
+
+/*
+ * Platform glue
+ */
+EXPORT_SYMBOL_GPL(mtk_wcn_consys_hw_deinit);
+
+
+int wmt_plat_pwr_ctrl(enum wmt_func_state state)
+{
+	switch (state) {
+	case FUNC_ON:
+		return mtk_wcn_consys_hw_pwr_on();
+	case FUNC_OFF:
+		return mtk_wcn_consys_hw_pwr_off();
+	case FUNC_RST:
+		return mtk_wcn_consys_hw_rst();
+	case FUNC_STAT:
+		wmt_info("CONSYS %s, chip id 0x%04x\n",
+			 consys.powered ? "on" : "off",
+			 mtk_wcn_consys_soc_chipid_get());
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/*
+ * The GPS_SYNC/I2S pins of the connectivity SoC are configured through
+ * wmt_ic_soc_pin_ctrl(); the host side only drives the GPS LNA enable pin
+ * through its pinctrl states (wmt_plat_alps.c:700-780).
+ */
+int wmt_plat_gpio_ctrl(enum wmt_pin_id id, enum wmt_pin_state state)
+{
+	static const char * const state_name[] = {
+		[PIN_STA_INIT] = "gps_lna_state_init",
+		[PIN_STA_OUT_H] = "gps_lna_state_oh",
+		[PIN_STA_OUT_L] = "gps_lna_state_ol",
+	};
+	struct pinctrl_state *pstate;
+	const char *name;
+	int ret;
+
+	if (id == PIN_GPS_SYNC || id == PIN_I2S_GRP)
+		return 0;
+
+	if (id != PIN_GPS_LNA)
+		return -EINVAL;
+
+	if (state == PIN_STA_DEINIT)
+		state = PIN_STA_INIT;
+
+	name = state_name[state];
+	if (!name)
+		return -EINVAL;
+
+	if (!consys.pinctrl) {
+		wmt_dbg("no pinctrl for the GPS LNA pin\n");
+		return 0;
+	}
+
+	pstate = pinctrl_lookup_state(consys.pinctrl, name);
+	if (IS_ERR(pstate)) {
+		wmt_err("missing pinctrl state %s\n", name);
+		return PTR_ERR(pstate);
+	}
+
+	ret = pinctrl_select_state(consys.pinctrl, pstate);
+	if (ret)
+		wmt_err("failed to select %s (%d)\n", name, ret);
+
+	return ret;
+}
+
+int wmt_plat_wake_lock_ctrl(enum wmt_wl_op op)
+{
+	int ret = 0;
+
+	mutex_lock(&consys.wake_lock);
+
+	if (op == WL_OP_GET) {
+		if (consys.wake_count++ == 0)
+			pm_stay_awake(consys.dev);
+	} else if (op == WL_OP_PUT) {
+		if (consys.wake_count == 0) {
+			wmt_warn("unbalanced wake lock release\n");
+			ret = -EINVAL;
+		} else if (--consys.wake_count == 0) {
+			pm_relax(consys.dev);
+		}
+	} else {
+		ret = -EINVAL;
+	}
+
+	mutex_unlock(&consys.wake_lock);
+	return ret;
+}
+
+int wmt_plat_init(void)
+{
+	int ret;
+
+	if (!consys.probed)
+		return -ENODEV;
+
+	ret = mtk_wcn_consys_hw_init();
+	wmt_dbg("platform init (%d)\n", ret);
+	return ret;
+}
+
+void wmt_plat_deinit(void)
+{
+	mtk_wcn_consys_hw_deinit();
+}
+
+/*
+ * Platform driver
+ */
+
+static int mtk_consys_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	memset(&consys, 0, sizeof(consys));
+	consys.dev = dev;
+	mutex_init(&consys.wake_lock);
+
+	consys.mcu = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(consys.mcu))
+		return PTR_ERR(consys.mcu);
+
+	consys.ap_rgu = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(consys.ap_rgu))
+		return PTR_ERR(consys.ap_rgu);
+
+	consys.topckgen = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(consys.topckgen))
+		return PTR_ERR(consys.topckgen);
+
+	consys.spm = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(consys.spm))
+		return PTR_ERR(consys.spm);
+
+	consys.clk_conn = devm_clk_get(dev, "conn");
+	if (IS_ERR(consys.clk_conn)) {
+		wmt_err("failed to get the conn clock (%ld)\n",
+			PTR_ERR(consys.clk_conn));
+		return PTR_ERR(consys.clk_conn);
+	}
+
+	consys.clk_bus = devm_clk_get_optional(dev, "bus");
+	if (IS_ERR(consys.clk_bus)) {
+		wmt_err("failed to get the bus clock (%ld)\n",
+			PTR_ERR(consys.clk_bus));
+		return PTR_ERR(consys.clk_bus);
+	}
+
+	consys.vcn18 = devm_regulator_get_optional(dev, "vcn18");
+	if (IS_ERR(consys.vcn18))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn18),
+				     "failed to get vcn18\n");
+	if (!consys.vcn18)
+		wmt_warn("no vcn18 supply, CONSYS may not power up\n");
+
+	consys.vcn28 = devm_regulator_get_optional(dev, "vcn28");
+	if (IS_ERR(consys.vcn28))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn28),
+				     "failed to get vcn28\n");
+
+	consys.vcn33_bt = devm_regulator_get_optional(dev, "vcn33_bt");
+	if (IS_ERR(consys.vcn33_bt))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn33_bt),
+				     "failed to get vcn33_bt\n");
+
+	consys.vcn33_wifi = devm_regulator_get_optional(dev, "vcn33_wifi");
+	if (IS_ERR(consys.vcn33_wifi))
+		return dev_err_probe(dev, PTR_ERR(consys.vcn33_wifi),
+				     "failed to get vcn33_wifi\n");
+
+	consys.pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(consys.pinctrl)) {
+		ret = PTR_ERR(consys.pinctrl);
+		if (ret != -ENODEV) {
+			wmt_err("failed to get pinctrl (%d)\n", ret);
+			return ret;
+		}
+		consys.pinctrl = NULL;
+	}
+
+	consys.irq_bgf = platform_get_irq(pdev, 0);
+	if (consys.irq_bgf < 0) {
+		wmt_err("failed to get the BGF interrupt (%d)\n",
+			consys.irq_bgf);
+		return consys.irq_bgf;
+	}
+
+	pm_runtime_enable(dev);
+	platform_set_drvdata(pdev, &consys);
+	consys.probed = true;
+
+	wmt_info("CONSYS platform probed (irq %d)\n", consys.irq_bgf);
+	return 0;
+}
+
+static void mtk_consys_remove(struct platform_device *pdev)
+{
+	if (consys.powered)
+		mtk_wcn_consys_hw_pwr_off();
+
+	consys_irq_init(false);
+	pm_runtime_disable(&pdev->dev);
+	mutex_destroy(&consys.wake_lock);
+	consys.probed = false;
+}
+
+static const struct of_device_id mtk_consys_of_ids[] = {
+	{ .compatible = "mediatek,mt6735-consys" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mtk_consys_of_ids);
+
+static struct platform_driver mtk_consys_driver = {
+	.probe = mtk_consys_probe,
+	.remove = mtk_consys_remove,
+	.driver = {
+		.name = "mtk-wcn-consys",
+		.of_match_table = mtk_consys_of_ids,
+	},
+};
+
+int wmt_plat_consys_driver_register(void)
+{
+	return platform_driver_register(&mtk_consys_driver);
+}
+
+void wmt_plat_consys_driver_unregister(void)
+{
+	platform_driver_unregister(&mtk_consys_driver);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_btif.c b/drivers/misc/mediatek/connectivity/wmt/stp_btif.c
new file mode 100644
index 000000000..06e3068b3
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_btif.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN STP transport binding for BTIF.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/stp_btif.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * The connectivity SoC is attached to the application processor through the
+ * BTIF DMA controller on MT6735/MC6737T.  This file owns the BTIF channel
+ * used by STP ("CONSYS_STP"), registers the STP transmit path with the STP
+ * engine and forwards received bytes to the STP parser.
+ *
+ * The channel is opened lazily by WMT_CTRL_STP_OPEN and closed by
+ * WMT_CTRL_STP_CLOSE, matching the downstream power-on/off ordering.
+ */
+
+#include <linux/delay.h>
+#include <linux/module.h>
+
+#include <mtk_btif.h>
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+
+#define BTIF_OWNER_NAME		"CONSYS_STP"
+
+/* stp_btif.c:43-46 */
+#define STP_MAX_PACKAGE_ALLOWED	2000
+#define STP_BTIF_TX_RTY_LMT	10
+#define STP_BTIF_TX_RTY_DLY	5	/* ms */
+
+static unsigned long stp_btif_id;
+
+/* stp_btif.c:129-200 */
+static int stp_btif_tx(const u8 *buf, u32 len, u32 *written_len)
+{
+	int retry_left = STP_BTIF_TX_RTY_LMT;
+	int wr_count, written;
+
+	*written_len = 0;
+
+	if (!stp_btif_id) {
+		wmt_warn("no BTIF channel\n");
+		return -ENODEV;
+	}
+
+	if (len == 0)
+		return 0;
+
+	if (len > STP_MAX_PACKAGE_ALLOWED) {
+		wmt_warn("abnormal packet length %u\n", len);
+		return -EMSGSIZE;
+	}
+
+	wr_count = mtk_wcn_btif_write(stp_btif_id, buf, len);
+	if (wr_count < 0) {
+		wmt_err("btif write failed (%d)\n", wr_count);
+		return -EIO;
+	}
+	if (wr_count == len) {
+		*written_len = wr_count;
+		return 0;
+	}
+
+	while (retry_left-- && wr_count < len) {
+		msleep(STP_BTIF_TX_RTY_DLY);
+		written = mtk_wcn_btif_write(stp_btif_id, buf + wr_count,
+					     len - wr_count);
+		if (written < 0) {
+			wmt_err("btif write failed (%d) while recovering\n",
+				written);
+			break;
+		}
+		wr_count += written;
+	}
+
+	if (wr_count == len) {
+		wmt_info("btif write recovered, len %u, retries left %d\n",
+			 len, retry_left);
+		*written_len = wr_count;
+		return 0;
+	}
+
+	wmt_err("btif write %u/%d, retries left %d\n", len, wr_count,
+		retry_left);
+	return -EIO;
+}
+
+static int stp_btif_parser(const unsigned char *buf, unsigned int len)
+{
+	mtk_wcn_stp_parser_data((u8 *)(uintptr_t)buf, len);
+	return len;
+}
+
+int stp_btif_open(void)
+{
+	int ret;
+
+	if (stp_btif_id)
+		return -EALREADY;
+
+	ret = mtk_wcn_btif_open(BTIF_OWNER_NAME, &stp_btif_id);
+	if (ret) {
+		wmt_err("btif open failed (%d)\n", ret);
+		return ret;
+	}
+
+	ret = mtk_wcn_stp_register_if_tx(STP_TX_IF_BTIF, stp_btif_tx);
+	if (ret) {
+		mtk_wcn_btif_close(stp_btif_id);
+		stp_btif_id = 0;
+		return ret;
+	}
+
+	mtk_wcn_stp_set_if_tx_type(STP_TX_IF_BTIF);
+	wmt_dbg("STP BTIF channel opened\n");
+	return 0;
+}
+
+int stp_btif_close(void)
+{
+	int ret;
+
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	ret = mtk_wcn_btif_close(stp_btif_id);
+	if (ret) {
+		wmt_err("btif close failed (%d)\n", ret);
+		return ret;
+	}
+
+	stp_btif_id = 0;
+	return 0;
+}
+
+int stp_btif_rx_register(void)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_rx_cb_register(stp_btif_id, stp_btif_parser);
+}
+
+int stp_btif_rx_unregister(void)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_rx_cb_register(stp_btif_id, NULL);
+}
+
+int stp_btif_wakeup(void)
+{
+	if (!stp_btif_id)
+		return -ENODEV;
+
+	return mtk_wcn_btif_wakeup_consys(stp_btif_id);
+}
diff --git a/drivers/misc/mediatek/connectivity/wmt/stp_core.c b/drivers/misc/mediatek/connectivity/wmt/stp_core.c
new file mode 100644
index 000000000..c622a427b
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/wmt/stp_core.c
@@ -0,0 +1,1311 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN STP (Serial Transport Protocol) engine.
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/core/stp_core.c
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/stp_exp.c
+ *
+ * Copyright (C) 2011-2014 MediaTek Inc.
+ *
+ * STP is a sliding-window protocol carried over the BTIF serial link.  Each
+ * frame is
+ *
+ *	seq/ack | type/len_hi | len_lo | header checksum | payload | crc16
+ *
+ * with an optional 0x55 0x55 delimiter.  Payloads are demultiplexed into one
+ * ring buffer per logical channel (BT/FM/GPS/WIFI/WMT/STP/INFO/ANT) and the
+ * registered channel callback is invoked without any STP lock held.
+ *
+ * The power-saving (PSM) and firmware-coredump (BTM) engines of the
+ * downstream driver are not ported; the corresponding hooks are replaced by
+ * a whole-chip reset request, which is the recovery action the downstream
+ * driver ends up performing when it cannot talk to the firmware anymore.
+ */
+
+#include <linux/crc16.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/timer.h>
+#include <linux/workqueue.h>
+
+#include <mtk_wcn_stp.h>
+
+#include "wmt_local.h"
+
+/* Downstream static configuration: NAK and delimiter generation disabled
+ * (stp_core.c:40-41).
+ */
+#define STP_ENABLE_NAK		0
+#define STP_ENABLE_DELIMITER	0
+
+static const u8 stp_delimiter[STP_DEL_SIZE] = { 0x55, 0x55 };
+
+struct stp_ctx {
+	struct mutex lock;		/* protects tx window, ack state */
+	struct mutex parse_lock;	/* serialises the rx parser */
+	struct stp_ring ring[MTKSTP_MAX_TASK_NUM];
+	struct stp_parser parser;
+	struct stp_sequence sequence;
+
+	u8 rx_buf[MTKSTP_BUFFER_SIZE];
+	u32 rx_counter;
+
+	u8 tx_buf[MTKSTP_BUFFER_SIZE];
+	u32 tx_read;
+	u32 tx_write;
+	u32 tx_start_addr[MTKSTP_SEQ_SIZE];
+	u32 tx_length[MTKSTP_SEQ_SIZE];
+
+	struct timer_list tx_timer;
+	struct work_struct tx_timeout_work;
+	struct work_struct reset_work;
+
+	bool enabled;
+	bool ready;
+	bool bluez;
+	u32 mode;			/* MTKSTP_*_MODE bits */
+	u8 pending_type;
+	u32 wmt_last_close;
+	u32 evt_err_assert;
+};
+
+static struct stp_ctx stp;
+static int stp_ctx_ready;
+static enum stp_parser_state stp_prev_state;
+static int stp_packet_fail_count;
+
+static int (*stp_if_tx[STP_TX_IF_MAX])(const u8 *data, u32 size, u32 *written);
+static mtk_wcn_stp_if_rx stp_if_rx;
+static enum mtk_wcn_stp_tx_if stp_if_type = STP_TX_IF_MAX;
+static mtk_wcn_stp_event_cb stp_event_cb[MTKSTP_MAX_TASK_NUM];
+static mtk_wcn_stp_event_cb stp_tx_event_cb[MTKSTP_MAX_TASK_NUM];
+
+/*
+ * TX side helpers
+ */
+
+static int stp_sys_if_tx(const u8 *data, u32 size, u32 *written)
+{
+	if (stp_if_type >= STP_TX_IF_MAX || !stp_if_tx[stp_if_type])
+		return -EIO;
+
+	return stp_if_tx[stp_if_type](data, size, written);
+}
+
+static bool stp_tx_room(u32 length)
+{
+	u32 room;
+
+	if (stp.tx_read <= stp.tx_write)
+		room = MTKSTP_BUFFER_SIZE - stp.tx_write + stp.tx_read - 1;
+	else
+		room = stp.tx_read - stp.tx_write - 1;
+
+	if (room < length) {
+		stp_err("tx queue room shortage\n");
+		return false;
+	}
+
+	return true;
+}
+
+static void stp_add_to_tx_queue(const u8 *buffer, u32 length)
+{
+	u32 last_len;
+
+	if (length + stp.tx_write < MTKSTP_BUFFER_SIZE) {
+		memcpy(stp.tx_buf + stp.tx_write, buffer, length);
+		stp.tx_write += length;
+	} else {
+		last_len = MTKSTP_BUFFER_SIZE - stp.tx_write;
+		memcpy(stp.tx_buf + stp.tx_write, buffer, last_len);
+		memcpy(stp.tx_buf, buffer + last_len, length - last_len);
+		stp.tx_write = length - last_len;
+	}
+}
+
+/* stp_core.c:267-291 */
+static void stp_update_tx_queue(u32 txseq)
+{
+	u32 tx_read = stp.tx_start_addr[txseq];
+	u8 checksum = 0;
+	int i;
+
+	stp.tx_buf[tx_read] &= 0xf8;
+	stp.tx_buf[tx_read] |= stp.sequence.txack;
+
+	for (i = 0; i < 3; i++) {
+		checksum += stp.tx_buf[tx_read];
+		tx_read++;
+		if (tx_read >= MTKSTP_BUFFER_SIZE)
+			tx_read -= MTKSTP_BUFFER_SIZE;
+	}
+
+	stp.tx_buf[tx_read] = checksum;
+}
+
+/* stp_core.c:712-752 */
+static void stp_send_tx_queue(u32 txseq)
+{
+	u32 ret = 0;
+	u32 tx_read = stp.tx_start_addr[txseq];
+	u32 tx_length = stp.tx_length[txseq];
+	u32 last_len;
+
+	stp_update_tx_queue(txseq);
+
+	if (tx_read + tx_length < MTKSTP_BUFFER_SIZE) {
+		stp_sys_if_tx(&stp.tx_buf[tx_read], tx_length, &ret);
+		if (ret != tx_length)
+			stp_err("stp_send_tx_queue %u/%u\n", tx_length, ret);
+	} else {
+		last_len = MTKSTP_BUFFER_SIZE - tx_read;
+		stp_sys_if_tx(&stp.tx_buf[tx_read], last_len, &ret);
+		if (ret != last_len)
+			stp_err("stp_send_tx_queue %u/%u\n", last_len, ret);
+
+		stp_sys_if_tx(&stp.tx_buf[0], tx_length - last_len, &ret);
+		if (ret != tx_length - last_len)
+			stp_err("stp_send_tx_queue %u/%u\n",
+				tx_length - last_len, ret);
+	}
+}
+
+/* stp_core.c:762-802 */
+static void stp_send_ack(u8 tx_ack, u8 nak)
+{
+	u8 header[MTKSTP_HEADER_SIZE];
+	u32 ret = 0;
+
+	header[0] = 0x80 + (0 << 3) + tx_ack;
+	if (STP_ENABLE_NAK)
+		header[1] = nak ? 0x80 : 0x00;
+	else
+		header[1] = 0x00;
+	header[2] = 0;
+	header[3] = (header[0] + header[1] + header[2]) & 0xff;
+
+	if (STP_ENABLE_DELIMITER)
+		stp_sys_if_tx(stp_delimiter, STP_DEL_SIZE, &ret);
+
+	ret = 0;
+	stp_sys_if_tx(&header[0], MTKSTP_HEADER_SIZE, &ret);
+	if (ret != MTKSTP_HEADER_SIZE)
+		stp_err("stp_send_ack %u/%u\n", MTKSTP_HEADER_SIZE, ret);
+}
+
+/*
+ * RX side helpers
+ */
+
+/* Requires stp.parse_lock and stp.lock. */
+static void stp_rest_ctx_state(void)
+{
+	int i;
+
+	stp.rx_counter = 0;
+
+	for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++) {
+		unsigned long flags;
+
+		spin_lock_irqsave(&stp.ring[i].lock, flags);
+		stp.ring[i].read_p = 0;
+		stp.ring[i].write_p = 0;
+		spin_unlock_irqrestore(&stp.ring[i].lock, flags);
+	}
+
+	stp.tx_write = 0;
+	stp.tx_read = 0;
+
+	stp.parser.state = STP_SYNC;
+	stp.sequence.txseq = 0;
+	stp.sequence.txack = 7;
+	stp.sequence.rxack = 7;
+	stp.sequence.winspace = MTKSTP_WINSIZE;
+	stp.sequence.expected_rxseq = 0;
+	stp.sequence.retry_times = 0;
+}
+
+static void stp_change_rx_state(enum stp_parser_state next)
+{
+	stp_prev_state = stp.parser.state;
+	stp.parser.state = next;
+}
+
+/* stp_core.c:604-652 */
+static int stp_add_to_rx_queue(u8 *buffer, u32 length, u8 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+	u32 room, last_len;
+
+	if (type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+
+	if (ring->read_p <= ring->write_p)
+		room = MTKSTP_BUFFER_SIZE - ring->write_p + ring->read_p - 1;
+	else
+		room = ring->read_p - ring->write_p - 1;
+
+	if (room < length) {
+		spin_unlock_irqrestore(&ring->lock, flags);
+		stp_err("queue %u is full\n", type);
+		return -ENOSPC;
+	}
+
+	if (length + ring->write_p < MTKSTP_BUFFER_SIZE) {
+		memcpy(ring->buffer + ring->write_p, buffer, length);
+		ring->write_p += length;
+	} else {
+		last_len = MTKSTP_BUFFER_SIZE - ring->write_p;
+		memcpy(ring->buffer + ring->write_p, buffer, last_len);
+		memcpy(ring->buffer, buffer + last_len, length - last_len);
+		ring->write_p = length - last_len;
+	}
+
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	return 0;
+}
+
+/* stp_core.c:921-963 */
+static int stp_process_rxack(void)
+{
+	u8 rxack;
+	int j = 0, k = 0;
+
+	if (stp.sequence.rxack == stp.parser.ack)
+		return -1;
+
+	rxack = stp.sequence.rxack;
+	rxack = (rxack + 1) & 0x7;
+	while (rxack != stp.sequence.txseq) {
+		j++;
+		if (rxack == stp.parser.ack) {
+			k = 1;
+			break;
+		}
+		rxack = (rxack + 1) & 0x7;
+	}
+
+	if (k != 1)
+		return -1;
+
+	stp.sequence.rxack = stp.parser.ack;
+	stp.tx_read = stp.tx_start_addr[rxack] + stp.tx_length[rxack];
+	if (stp.tx_read >= MTKSTP_BUFFER_SIZE)
+		stp.tx_read -= MTKSTP_BUFFER_SIZE;
+
+	stp.sequence.winspace += j;
+	stp.sequence.retry_times = 0;
+
+	timer_delete(&stp.tx_timer);
+	if (stp.sequence.winspace != MTKSTP_WINSIZE)
+		mod_timer(&stp.tx_timer,
+			  jiffies + msecs_to_jiffies(MTKSTP_TX_TIMEOUT));
+
+	return 0;
+}
+
+static bool stp_function_active(u8 type)
+{
+	return type < MTKSTP_MAX_TASK_NUM && stp_event_cb[type];
+}
+
+/* stp_core.c:965-1160
+ *
+ * Runs with stp.parse_lock held; the TX window and ack state are protected by
+ * stp.lock inside the critical sections.  Channel callbacks are invoked after
+ * stp.lock has been released, as required by mtk_wcn_stp.h.
+ */
+static void stp_process_packet(void)
+{
+	int trigger_resume = -1;
+	u8 tx_ack = 0;
+	static int rx_ok;
+	bool active;
+	bool notify = false;
+	int ret;
+
+	mutex_lock(&stp.lock);
+
+	if (stp.sequence.expected_rxseq == stp.parser.seq &&
+	    stp.parser.type == BT_TASK_INDX && stp.bluez) {
+		/* BlueZ stack: hand the HCI packet straight to the HCI core. */
+		mutex_unlock(&stp.lock);
+		if (stp_if_rx)
+			stp_if_rx(stp.rx_buf, stp.rx_counter);
+		else
+			stp_err("bluez packet without registered rx handler\n");
+		mutex_lock(&stp.lock);
+
+		trigger_resume = stp_process_rxack();
+		stp.sequence.txack = stp.parser.seq;
+		stp.sequence.expected_rxseq =
+			(stp.sequence.expected_rxseq + 1) & 0x7;
+		tx_ack = stp.sequence.txack;
+		stp_send_ack(tx_ack, 0);
+		rx_ok = 0;
+	} else if (stp.sequence.expected_rxseq == stp.parser.seq) {
+		active = stp_function_active(stp.parser.type);
+
+		trigger_resume = stp_process_rxack();
+		stp.sequence.txack = stp.parser.seq;
+		stp.sequence.expected_rxseq =
+			(stp.sequence.expected_rxseq + 1) & 0x7;
+		tx_ack = stp.sequence.txack;
+		stp_send_ack(tx_ack, 0);
+
+		if (stp.parser.type < MTKSTP_MAX_TASK_NUM && active) {
+			if (stp.parser.type == WMT_TASK_INDX &&
+			    stp.parser.wmt_subtype == WMT_LTE_COEX_FLAG) {
+				stp_warn("LTE coex frame on non-LTE project, dropped\n");
+				rx_ok = 0;
+			} else {
+				ret = stp_add_to_rx_queue(stp.rx_buf,
+							  stp.rx_counter,
+							  stp.parser.type);
+				rx_ok = ret ? -1 : 0;
+			}
+		} else {
+			if (active)
+				stp_err("type %u is invalid, dropped\n",
+					stp.parser.type);
+			else
+				stp_err("function %u is inactive, dropped\n",
+					stp.parser.type);
+			rx_ok = 0;
+		}
+
+		if (!rx_ok) {
+			stp_packet_fail_count = 0;
+			if (stp.parser.type == WMT_TASK_INDX &&
+			    stp.parser.wmt_subtype == WMT_LTE_COEX_FLAG)
+				stp_warn("LTE coex frame dropped\n");
+			else
+				notify = true;
+		} else {
+			stp_packet_fail_count++;
+			/* A full GPS queue is drained rather than retried. */
+			if (stp.parser.type == GPS_TASK_INDX)
+				mtk_wcn_stp_flush_rx_queue(GPS_TASK_INDX);
+			else
+				notify = true;
+			/* Do not ack: let the peer retry. */
+			stp_err("enqueue to rx queue %u failed\n",
+				stp.parser.type);
+		}
+	} else if (!rx_ok) {
+		stp_err("expected_rxseq %u, parser.seq %u\n",
+			stp.sequence.expected_rxseq, stp.parser.seq);
+		stp_packet_fail_count++;
+		stp_send_ack(stp.sequence.txack, 1);
+	} else {
+		stp_packet_fail_count++;
+		stp_err("sequence mismatch after enqueue failure\n");
+	}
+
+	mutex_unlock(&stp.lock);
+
+	if (notify && stp_event_cb[stp.parser.type])
+		stp_event_cb[stp.parser.type]();
+
+	if (trigger_resume == 0) {
+		int i;
+
+		for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++)
+			if (stp_tx_event_cb[i])
+				stp_tx_event_cb[i]();
+	}
+
+	if (stp_packet_fail_count > MTKSTP_RETRY_LIMIT) {
+		stp_packet_fail_count = 0;
+		stp_err("too many packet failures, resetting CONSYS\n");
+		stp.ready = false;
+		schedule_work(&stp.reset_work);
+	}
+}
+
+/* stp_core.c:1956-2210 (mandatory mode, no sequence/ack/crc) */
+static int stp_parser_data_in_mand_mode(u32 length, u8 *p_data)
+{
+	u8 padding_len;
+	int remain_length;
+	int i = length;
+
+	while (i > 0) {
+		switch (stp.parser.state) {
+		case STP_SYNC:
+			if ((*p_data & 0x80) == 0x80) {
+				if (*p_data != 0x80)
+					stp_warn("mandatory mode sync byte 0x%x\n",
+						 *p_data);
+				stp_change_rx_state(STP_NAK);
+				stp.rx_counter++;
+			} else {
+				stp_warn("sync to sync, byte 0x%x\n", *p_data);
+				stp_change_rx_state(STP_SYNC);
+			}
+			break;
+		case STP_NAK:
+			stp_change_rx_state(STP_LENGTH);
+			stp.parser.type = (*p_data & 0x70) >> 4;
+			if (stp.parser.type <= MTKSTP_MAX_TASK_NUM) {
+				stp.parser.length = (*p_data & 0x0f) << 8;
+				stp.rx_counter++;
+			} else {
+				stp_warn("invalid type, back to sync\n");
+				stp_change_rx_state(STP_SYNC);
+			}
+			break;
+		case STP_LENGTH:
+			stp_change_rx_state(STP_CHECKSUM);
+			stp.parser.length += *p_data;
+			if (stp.parser.length < 2000) {
+				stp.rx_counter++;
+			} else {
+				stp_warn("invalid STP length %u\n",
+					 stp.parser.length);
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+			}
+			break;
+		case STP_CHECKSUM:
+			if (stp.parser.type == STP_TASK_INDX ||
+			    stp.parser.type == INFO_TASK_INDX) {
+				stp_change_rx_state(STP_FW_MSG);
+				stp.rx_counter = 0;
+				i -= 1;
+				if (i != 0)
+					p_data += 1;
+				continue;
+			}
+			if (stp.parser.length == 0) {
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+			} else {
+				stp_change_rx_state(STP_DATA);
+				stp.rx_counter = 0;
+			}
+			break;
+		case STP_DATA:
+			if (stp.parser.length < stp.rx_counter) {
+				stp_err("abnormal length %u/%u in DATA\n",
+					stp.parser.length, stp.rx_counter);
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			remain_length = stp.parser.length - stp.rx_counter;
+			if (i >= remain_length) {
+				if (stp.rx_counter + remain_length >=
+				    MTKSTP_BUFFER_SIZE) {
+					stp_err("rx buffer overrun\n");
+					stp_change_rx_state(STP_SYNC);
+					stp.rx_counter = 0;
+					return -1;
+				}
+				memcpy(stp.rx_buf + stp.rx_counter, p_data,
+				       remain_length);
+				i -= remain_length;
+				p_data += remain_length;
+				stp.rx_counter = stp.parser.length;
+				stp.parser.state = STP_CRC1;
+				continue;
+			}
+			if (i + stp.rx_counter >= MTKSTP_BUFFER_SIZE) {
+				stp_err("rx buffer overrun 2\n");
+				stp.rx_counter = 0;
+				return -1;
+			}
+			memcpy(stp.rx_buf + stp.rx_counter, p_data, i);
+			stp.rx_counter += i;
+			i = 0;
+			continue;
+		case STP_CRC1:
+			stp_change_rx_state(STP_CRC2);
+			break;
+		case STP_CRC2:
+			if (stp.parser.type == WMT_TASK_INDX)
+				stp.parser.wmt_subtype = stp.rx_buf[1];
+
+			/* STP packets are 4-byte aligned in mandatory mode. */
+			if (i <= 4) {
+				p_data += (i - 1);
+				i -= (i - 1);
+			} else {
+				padding_len = (0x04 -
+					((stp.parser.length + 6) & 0x03)) & 0x03;
+				p_data += padding_len;
+				i -= padding_len;
+			}
+
+			if (stp.parser.type == BT_TASK_INDX && stp.bluez) {
+				if (stp_if_rx)
+					stp_if_rx(stp.rx_buf, stp.rx_counter);
+				else
+					stp_err("bluez packet without handler\n");
+			} else if (stp_function_active(stp.parser.type)) {
+				if (stp.parser.type == WMT_TASK_INDX &&
+				    stp.parser.wmt_subtype ==
+				    WMT_LTE_COEX_FLAG) {
+					stp_warn("LTE coex frame dropped\n");
+				} else {
+					stp_add_to_rx_queue(stp.rx_buf,
+							    stp.rx_counter,
+							    stp.parser.type);
+					if (stp_event_cb[stp.parser.type])
+						stp_event_cb[stp.parser.type]();
+				}
+			} else {
+				stp_err("function %u inactive, dropped\n",
+					stp.parser.type);
+			}
+
+			stp.rx_counter = 0;
+			stp_change_rx_state(STP_SYNC);
+			break;
+		case STP_FW_MSG:
+			stp_err("firmware message, length %u (not dumped)\n",
+				stp.parser.length);
+			stp.rx_counter = 0;
+			stp_change_rx_state(STP_SYNC);
+			break;
+		default:
+			break;
+		}
+		p_data++;
+		i--;
+	}
+
+	return 0;
+}
+
+/* stp_core.c:1779-1954 (full mode) */
+static int stp_parser_data_in_full_mode(u32 length, u8 *p_data)
+{
+	int remain_length;
+	int i = length;
+
+	while (i > 0) {
+		switch (stp.parser.state) {
+		case STP_RESYNC1:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_RESYNC2 : STP_RESYNC1);
+			break;
+		case STP_RESYNC2:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_RESYNC3 : STP_RESYNC1);
+			break;
+		case STP_RESYNC3:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_RESYNC4 : STP_RESYNC1);
+			break;
+		case STP_RESYNC4:
+			stp_change_rx_state(*p_data == 0x7f ?
+					    STP_SYNC : STP_RESYNC1);
+			break;
+		case STP_SYNC:
+			if ((*p_data & 0x80) == 0x80 &&
+			    (*p_data & 0x40) == 0x00) {
+				stp_change_rx_state(STP_NAK);
+				stp.parser.seq = (*p_data & 0x38) >> 3;
+				stp.parser.ack = *p_data & 0x07;
+				stp.rx_buf[0] = *p_data;
+			} else if (*p_data == 0x7f &&
+				   stp_prev_state == STP_RESYNC4) {
+				stp_err("continuous resync pattern\n");
+			} else if (*p_data == 0x7f) {
+				stp_change_rx_state(STP_RESYNC2);
+				stp_err("resync pattern start\n");
+			} else if (*p_data == 0x55) {
+				/* STP delimiter, ignored */
+			} else {
+				stp_err("unexpected byte 0x%x in sync\n",
+					*p_data);
+			}
+			break;
+		case STP_NAK:
+			stp.parser.nak = STP_ENABLE_NAK ?
+				((*p_data & 0x80) >> 7) : 0;
+			stp.parser.type = (*p_data & 0x70) >> 4;
+			stp.parser.length = (*p_data & 0x0f) << 8;
+			stp.rx_buf[1] = *p_data;
+			if (stp.parser.nak)
+				stp_err("NAK received\n");
+
+			if (stp.parser.type < MTKSTP_MAX_TASK_NUM)
+				stp_change_rx_state(STP_LENGTH);
+			else
+				stp_change_rx_state(STP_SYNC);
+			break;
+		case STP_LENGTH:
+			stp_change_rx_state(STP_CHECKSUM);
+			stp.parser.length += *p_data;
+			if (stp.parser.length > MTKSTP_MAX_PKT_SIZE) {
+				stp_err("invalid STP length %u\n",
+					stp.parser.length);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			stp.rx_buf[2] = *p_data;
+			break;
+		case STP_CHECKSUM:
+			if (stp.parser.type == STP_TASK_INDX ||
+			    stp.parser.type == INFO_TASK_INDX) {
+				stp_change_rx_state(STP_FW_MSG);
+				stp.rx_counter = 0;
+				i -= 1;
+				if (i != 0)
+					p_data += 1;
+				continue;
+			}
+
+			if (((stp.rx_buf[0] + stp.rx_buf[1] +
+			      stp.rx_buf[2]) & 0xff) != *p_data) {
+				stp_err("header checksum error %02x %02x %02x %02x\n",
+					stp.rx_buf[0], stp.rx_buf[1],
+					stp.rx_buf[2], *p_data);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+
+			if (stp.parser.length == 0) {
+				int trigger_resume;
+
+				mutex_lock(&stp.lock);
+				trigger_resume = stp_process_rxack();
+				mutex_unlock(&stp.lock);
+
+				if (trigger_resume == 0) {
+					int t;
+
+					for (t = 0; t < MTKSTP_MAX_TASK_NUM; t++)
+						if (stp_tx_event_cb[t])
+							stp_tx_event_cb[t]();
+				}
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+			} else {
+				stp_change_rx_state(STP_DATA);
+				stp.rx_counter = 0;
+			}
+			break;
+		case STP_DATA:
+			if (stp.parser.length < stp.rx_counter) {
+				stp_err("abnormal length %u/%u in DATA\n",
+					stp.parser.length, stp.rx_counter);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			remain_length = stp.parser.length - stp.rx_counter;
+			if (i >= remain_length) {
+				memcpy(stp.rx_buf + stp.rx_counter, p_data,
+				       remain_length);
+				i -= remain_length;
+				p_data += remain_length;
+				stp.rx_counter = stp.parser.length;
+				stp.parser.state = STP_CRC1;
+				continue;
+			}
+			if (i + stp.rx_counter >= MTKSTP_BUFFER_SIZE) {
+				stp_err("rx buffer overrun\n");
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			memcpy(stp.rx_buf + stp.rx_counter, p_data, i);
+			stp.rx_counter += i;
+			i = 0;
+			continue;
+		case STP_CRC1:
+			stp_change_rx_state(STP_CRC2);
+			stp.parser.crc = *p_data;
+			break;
+		case STP_CRC2:
+			stp_change_rx_state(STP_SYNC);
+			stp.parser.crc += (*p_data) << 8;
+			if (stp.parser.type == WMT_TASK_INDX)
+				stp.parser.wmt_subtype = stp.rx_buf[1];
+
+			if (crc16(0, stp.rx_buf, stp.rx_counter) !=
+			    stp.parser.crc) {
+				stp_err("payload CRC error (len %u)\n",
+					stp.rx_counter);
+				stp_change_rx_state(STP_RESYNC1);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			stp_process_packet();
+			break;
+		case STP_FW_MSG:
+			/* Firmware assert/trace messages are not decoded; the
+			 * payload is consumed so that the stream resynchronises.
+			 * stp_core.c:2035-2165.
+			 */
+			if (stp.parser.length < stp.rx_counter) {
+				stp_err("abnormal length %u/%u in FW_MSG\n",
+					stp.parser.length, stp.rx_counter);
+				stp_change_rx_state(STP_SYNC);
+				stp.rx_counter = 0;
+				return -1;
+			}
+			remain_length = stp.parser.length - stp.rx_counter;
+			if (i < remain_length) {
+				if (i + stp.rx_counter >= MTKSTP_BUFFER_SIZE) {
+					stp_change_rx_state(STP_RESYNC1);
+					stp.rx_counter = 0;
+					return -1;
+				}
+				memcpy(stp.rx_buf + stp.rx_counter, p_data, i);
+				stp.rx_counter += i;
+				i = 0;
+				continue;
+			}
+
+			memcpy(stp.rx_buf + stp.rx_counter, p_data,
+			       remain_length);
+			i -= remain_length;
+			p_data += remain_length;
+			stp.rx_counter = stp.parser.length;
+			stp_change_rx_state(STP_SYNC);
+
+			if (stp.parser.type == STP_TASK_INDX) {
+				stp_warn("firmware assert message (%u bytes), resetting\n",
+					 stp.rx_counter);
+				stp.ready = false;
+				schedule_work(&stp.reset_work);
+			} else {
+				stp_warn("firmware trace message (%u bytes)\n",
+					 stp.rx_counter);
+			}
+			stp.rx_counter = 0;
+
+			if (i >= 2) {
+				i -= 2;
+				if (i > 0)
+					p_data += 2;
+			}
+			continue;
+		default:
+			break;
+		}
+		p_data++;
+		i--;
+	}
+
+	return 0;
+}
+
+/*
+ * TX timeout handling (stp_core.c:345-495)
+ */
+
+static void stp_do_tx_timeout(void)
+{
+	u8 resync[4];
+	u32 seq, ret = 0;
+
+	mutex_lock(&stp.lock);
+
+	if (stp.sequence.retry_times > MTKSTP_RETRY_LIMIT) {
+		stp_info("retry limit reached, stop\n");
+		mutex_unlock(&stp.lock);
+		return;
+	}
+
+	seq = (stp.sequence.rxack + 1) & 0x7;
+	if (seq != stp.sequence.txseq) {
+		memset(resync, 0x7f, sizeof(resync));
+		stp_sys_if_tx(resync, sizeof(resync), &ret);
+		if (ret != sizeof(resync))
+			stp_err("failed to send resync pattern\n");
+
+		do {
+			stp_warn("resend STP packet seq %u\n", seq);
+			stp_send_tx_queue(seq);
+			seq = (seq + 1) & 0x7;
+		} while (seq != stp.sequence.txseq);
+	}
+
+	timer_delete(&stp.tx_timer);
+	if (stp.sequence.winspace != MTKSTP_WINSIZE) {
+		mod_timer(&stp.tx_timer,
+			  jiffies + msecs_to_jiffies(MTKSTP_TX_TIMEOUT));
+		stp.sequence.retry_times++;
+		if (stp.sequence.retry_times > MTKSTP_RETRY_LIMIT) {
+			timer_delete(&stp.tx_timer);
+			stp_err("TX retry limit %d, resetting CONSYS\n",
+				MTKSTP_RETRY_LIMIT);
+			stp.ready = false;
+			mutex_unlock(&stp.lock);
+			schedule_work(&stp.reset_work);
+			return;
+		}
+	}
+
+	mutex_unlock(&stp.lock);
+}
+
+static void stp_tx_timeout_work_fn(struct work_struct *work)
+{
+	stp_do_tx_timeout();
+}
+
+static void stp_tx_timeout_cb(struct timer_list *timer)
+{
+	schedule_work(&stp.tx_timeout_work);
+}
+
+static void stp_reset_work_fn(struct work_struct *work)
+{
+	wmt_lib_schedule_reset(WMTRSTSRC_RESET_STP);
+}
+
+/*
+ * Public STP API
+ */
+
+bool mtk_wcn_stp_is_ready(void)
+{
+	return stp_ctx_ready && stp.ready;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_is_ready);
+
+int mtk_wcn_stp_send_data(const u8 *buffer, u32 length, u8 type)
+{
+	u8 header[MTKSTP_HEADER_SIZE], crc_bytes[2];
+	u16 crc;
+	u32 written = 0;
+	int ret = 0;
+
+	if (!buffer)
+		return -EINVAL;
+	if (length > MTKSTP_MAX_PKT_SIZE)
+		return -EINVAL;
+
+	if (stp.wmt_last_close) {
+		stp_err("link closed by WMT, dropping tx\n");
+		return length;
+	}
+
+	mutex_lock(&stp.lock);
+
+	if (!stp.enabled && type != WMT_TASK_INDX) {
+		mutex_unlock(&stp.lock);
+		return -EAGAIN;
+	}
+
+	if (stp.enabled && mtk_wcn_stp_is_btif_mand_mode()) {
+		/* stp_core.c:2512-2555 */
+		header[0] = 0x80;
+		header[1] = (type << 4) + ((length >> 8) & 0x0f);
+		header[2] = length & 0xff;
+		header[3] = 0x00;
+
+		memcpy(stp.tx_buf, header, MTKSTP_HEADER_SIZE);
+		memcpy(stp.tx_buf + MTKSTP_HEADER_SIZE, buffer, length);
+		crc_bytes[0] = 0;
+		crc_bytes[1] = 0;
+		memcpy(stp.tx_buf + MTKSTP_HEADER_SIZE + length, crc_bytes, 2);
+
+		stp_sys_if_tx(stp.tx_buf,
+			      MTKSTP_HEADER_SIZE + length + MTKSTP_CRC_SIZE,
+			      &written);
+		if (written == MTKSTP_HEADER_SIZE + length + MTKSTP_CRC_SIZE)
+			ret = length;
+		else
+			ret = -EIO;
+		mutex_unlock(&stp.lock);
+		return ret;
+	}
+
+	if (stp.enabled && mtk_wcn_stp_is_btif_fullset_mode()) {
+		if (stp.sequence.winspace > 0 &&
+		    stp_tx_room(MTKSTP_HEADER_SIZE + length +
+				MTKSTP_CRC_SIZE)) {
+			header[0] = 0x80 +
+				    (stp.sequence.txseq << 3) +
+				    stp.sequence.txack;
+			header[1] = (type << 4) + ((length & 0xf00) >> 8);
+			header[2] = length & 0xff;
+			header[3] = (header[0] + header[1] + header[2]) & 0xff;
+
+			stp.tx_start_addr[stp.sequence.txseq] = stp.tx_write;
+			stp.tx_length[stp.sequence.txseq] =
+				MTKSTP_HEADER_SIZE + length + MTKSTP_CRC_SIZE;
+
+			if (STP_ENABLE_DELIMITER) {
+				stp.tx_length[stp.sequence.txseq] +=
+					STP_DEL_SIZE;
+				stp_add_to_tx_queue(stp_delimiter,
+						    STP_DEL_SIZE);
+			}
+
+			stp_add_to_tx_queue(header, MTKSTP_HEADER_SIZE);
+			stp_add_to_tx_queue(buffer, length);
+
+			crc = crc16(0, buffer, length);
+			crc_bytes[0] = crc & 0xff;
+			crc_bytes[1] = (crc & 0xff00) >> 8;
+			stp_add_to_tx_queue(crc_bytes, 2);
+
+			stp_send_tx_queue(stp.sequence.txseq);
+			stp.sequence.txseq =
+				(stp.sequence.txseq + 1) & 0x7;
+			stp.sequence.winspace--;
+
+			timer_delete(&stp.tx_timer);
+			if (stp.sequence.winspace != MTKSTP_WINSIZE)
+				mod_timer(&stp.tx_timer,
+					  jiffies +
+					  msecs_to_jiffies(MTKSTP_TX_TIMEOUT));
+
+			ret = length;
+		} else {
+			stp_err("no window space / tx room\n");
+			ret = 0;
+		}
+	}
+
+	mutex_unlock(&stp.lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_send_data);
+
+/* Raw channel used by WMT before STP is formally enabled (stp_core.c:2653-2700).
+ */
+int mtk_wcn_stp_send_data_raw(const u8 *buffer, u32 length, u8 type)
+{
+	u32 written = 0;
+
+	if (!buffer)
+		return -EINVAL;
+
+	if (stp.wmt_last_close) {
+		stp_err("link closed by WMT, dropping raw tx\n");
+		return length;
+	}
+
+	mutex_lock(&stp.lock);
+	stp.pending_type = type;
+	stp_sys_if_tx(buffer, length, &written);
+	mutex_unlock(&stp.lock);
+
+	if (written == length)
+		return written;
+
+	stp_err("raw tx %u/%u\n", length, written);
+	return -EIO;
+}
+
+int mtk_wcn_stp_receive_data(u8 *buffer, u32 length, u8 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+	u32 copy_len = 0, tail_len;
+
+	if (!buffer || type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+
+	while (ring->read_p != ring->write_p) {
+		if (ring->write_p > ring->read_p) {
+			copy_len = ring->write_p - ring->read_p;
+			if (copy_len > length)
+				copy_len = length;
+			memcpy(buffer, ring->buffer + ring->read_p, copy_len);
+			ring->read_p += copy_len;
+		} else {
+			tail_len = MTKSTP_BUFFER_SIZE - ring->read_p;
+			if (tail_len > length) {
+				copy_len = length;
+				memcpy(buffer, ring->buffer + ring->read_p,
+				       copy_len);
+				ring->read_p += copy_len;
+			} else {
+				memcpy(buffer, ring->buffer + ring->read_p,
+				       tail_len);
+				buffer += tail_len;
+
+				copy_len = length - tail_len;
+				copy_len = min(copy_len, ring->write_p);
+				if (copy_len)
+					memcpy(buffer, ring->buffer, copy_len);
+				ring->read_p = copy_len;
+				copy_len += tail_len;
+			}
+		}
+		break;
+	}
+
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	return copy_len;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_receive_data);
+
+bool mtk_wcn_stp_is_rxqueue_empty(u8 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+	bool empty;
+
+	if (type >= MTKSTP_MAX_TASK_NUM)
+		return true;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+	empty = ring->read_p == ring->write_p;
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	return empty;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_is_rxqueue_empty);
+
+/* stp_core.c:2233-2300 */
+int mtk_wcn_stp_parser_data(u8 *buffer, u32 length)
+{
+	int ret = 0;
+
+	if (!buffer)
+		return -EINVAL;
+
+	if (!stp_ctx_ready)
+		return -ENODEV;
+
+	if (!stp.enabled) {
+		if (stp.pending_type == WMT_TASK_INDX) {
+			/* Raw WMT traffic before STP is enabled. */
+			stp_add_to_rx_queue(buffer, length, WMT_TASK_INDX);
+			if (stp_event_cb[WMT_TASK_INDX])
+				stp_event_cb[WMT_TASK_INDX]();
+		}
+		return 0;
+	}
+
+	mutex_lock(&stp.parse_lock);
+	if (mtk_wcn_stp_is_btif_mand_mode())
+		ret = stp_parser_data_in_mand_mode(length, buffer);
+	else if (mtk_wcn_stp_is_btif_fullset_mode())
+		ret = stp_parser_data_in_full_mode(length, buffer);
+	mutex_unlock(&stp.parse_lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_parser_data);
+
+int mtk_wcn_stp_register_event_cb(int type, mtk_wcn_stp_event_cb func)
+{
+	if (type < 0 || type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	stp_event_cb[type] = func;
+
+	/* stp_exp.c:200-216: a new consumer always starts with an empty queue. */
+	mtk_wcn_stp_flush_rx_queue(type);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_event_cb);
+
+int mtk_wcn_stp_register_tx_event_cb(int type, mtk_wcn_stp_event_cb func)
+{
+	if (type < 0 || type >= MTKSTP_MAX_TASK_NUM)
+		return -EINVAL;
+
+	stp_tx_event_cb[type] = func;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_tx_event_cb);
+
+int mtk_wcn_stp_register_if_rx(mtk_wcn_stp_if_rx func)
+{
+	stp_if_rx = func;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_if_rx);
+
+int mtk_wcn_stp_register_if_tx(enum mtk_wcn_stp_tx_if stp_interface,
+			       mtk_wcn_stp_if_tx func)
+{
+	if (stp_interface >= STP_TX_IF_MAX) {
+		stp_warn("STP_IF_TX(%d) out of boundary\n", stp_interface);
+		return -EINVAL;
+	}
+
+	stp_if_tx[stp_interface] = func;
+	if (func && stp_if_type == STP_TX_IF_MAX)
+		stp_if_type = stp_interface;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_register_if_tx);
+
+/*
+ * Internal STP control used by the WMT core
+ */
+
+int stp_drv_init(void)
+{
+	int i;
+
+	memset(&stp, 0, sizeof(stp));
+	mutex_init(&stp.lock);
+	mutex_init(&stp.parse_lock);
+
+	for (i = 0; i < MTKSTP_MAX_TASK_NUM; i++)
+		spin_lock_init(&stp.ring[i].lock);
+
+	timer_setup(&stp.tx_timer, stp_tx_timeout_cb, 0);
+	INIT_WORK(&stp.tx_timeout_work, stp_tx_timeout_work_fn);
+	INIT_WORK(&stp.reset_work, stp_reset_work_fn);
+
+	stp.enabled = false;
+	stp.ready = false;
+	stp.bluez = false;
+	stp.mode = 0;
+	stp.pending_type = 0;
+	stp.wmt_last_close = 0;
+	stp.evt_err_assert = 0;
+	stp_ctx_ready = 1;
+
+	return 0;
+}
+
+void stp_drv_exit(void)
+{
+	if (!stp_ctx_ready)
+		return;
+
+	stp_ctx_ready = 0;
+	cancel_work_sync(&stp.reset_work);
+	cancel_work_sync(&stp.tx_timeout_work);
+	timer_delete_sync(&stp.tx_timer);
+
+	mutex_lock(&stp.lock);
+	stp.enabled = false;
+	stp.ready = false;
+	memset(stp_event_cb, 0, sizeof(stp_event_cb));
+	memset(stp_tx_event_cb, 0, sizeof(stp_tx_event_cb));
+	memset(stp_if_tx, 0, sizeof(stp_if_tx));
+	stp_if_rx = NULL;
+	stp_if_type = STP_TX_IF_MAX;
+	mutex_unlock(&stp.lock);
+
+	mutex_destroy(&stp.parse_lock);
+	mutex_destroy(&stp.lock);
+}
+
+int mtk_wcn_stp_enable(int value)
+{
+	mutex_lock(&stp.parse_lock);
+	mutex_lock(&stp.lock);
+	stp_rest_ctx_state();
+	stp.enabled = !!value;
+	mutex_unlock(&stp.lock);
+	mutex_unlock(&stp.parse_lock);
+
+	stp_dbg("STP %s\n", value ? "enabled" : "disabled");
+	return 0;
+}
+
+int mtk_wcn_stp_ready(int value)
+{
+	if (!stp_ctx_ready)
+		return -ENODEV;
+
+	stp.ready = !!value;
+	stp_dbg("STP %s\n", value ? "ready" : "not ready");
+	return 0;
+}
+
+void mtk_wcn_stp_flush_rx_queue(u32 type)
+{
+	struct stp_ring *ring;
+	unsigned long flags;
+
+	if (type >= MTKSTP_MAX_TASK_NUM)
+		return;
+
+	ring = &stp.ring[type];
+	spin_lock_irqsave(&ring->lock, flags);
+	ring->read_p = 0;
+	ring->write_p = 0;
+	spin_unlock_irqrestore(&ring->lock, flags);
+}
+
+void mtk_wcn_stp_flush_context(void)
+{
+	if (!stp_ctx_ready)
+		return;
+
+	mutex_lock(&stp.parse_lock);
+	mutex_lock(&stp.lock);
+	stp_rest_ctx_state();
+	mutex_unlock(&stp.lock);
+	mutex_unlock(&stp.parse_lock);
+}
+
+void mtk_wcn_stp_set_mode(u32 mode)
+{
+	stp.mode = mode;
+	stp_dbg("STP mode 0x%08x\n", mode);
+}
+
+void mtk_wcn_stp_set_if_tx_type(enum mtk_wcn_stp_tx_if type)
+{
+	if (type >= STP_TX_IF_MAX) {
+		stp_err("invalid tx interface %d\n", type);
+		return;
+	}
+
+	stp_if_type = type;
+}
+
+void mtk_wcn_stp_set_bluez(bool bluez)
+{
+	stp.bluez = bluez;
+}
+EXPORT_SYMBOL_GPL(mtk_wcn_stp_set_bluez);
+
+bool mtk_wcn_stp_is_btif_fullset_mode(void)
+{
+	return stp.mode & MTKSTP_BTIF_FULL_MODE;
+}
+
+bool mtk_wcn_stp_is_btif_mand_mode(void)
+{
+	return stp.mode & MTKSTP_BTIF_MAND_MODE;
+}
+
+int mtk_wcn_stp_set_wmt_last_close(u32 value)
+{
+	stp.wmt_last_close = value;
+	stp_dbg("wmt_last_close %u\n", value);
+	return 0;
+}
+
+/* stp_core.c:3300-3330 */
+u32 mtk_wcn_stp_get_wmt_evt_err_trg_assert(void)
+{
+	return stp.evt_err_assert;
+}
+
+void mtk_wcn_stp_set_wmt_evt_err_trg_assert(u32 value)
+{
+	stp_info("event error assert flag %u\n", value);
+	stp.evt_err_assert = value;
+}
