+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN WMT public API (frozen mtk_wcn_wmt.h).
+ *
+ * Port from Samsung/MTK downstream
+ *   drivers/misc/mediatek/connectivity/common/conn_soc/linux/pri/wmt_exp.c
+ *
