new file mode 100644
index 000000000..2e600c8cd
--- /dev/null
+++ b/drivers/media/platform/mediatek/imgsys/Kconfig
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config VIDEO_MTK_IMGSYS
+	tristate "MediaTek MT6735 IMGSYS/ISP platform driver"
+	depends on MEDIA_SUPPORT
+	depends on VIDEO_DEV
+	depends on COMMON_CLK
+	depends on OF
+	depends on PM
+	help
+	  Platform, clock, power and reset driver for the MediaTek MT6735 /
+	  MT6737T image signal processor (IMGSYS) block.
+
+	  The driver owns the ISP core register windows, the six IMGSYS clock
+	  gates and the ISP power domain, performs the documented Pass 1 soft
+	  reset on probe and resume, and exposes the mapped register windows
+	  through debugfs for diagnostics.
+
+	  The ISP capture pipeline itself is not implemented: running the
+	  Pass 1 / Pass 2 / CAM_SV / DSP pipelines requires the proprietary
+	  MTK camera userspace ABI (libcamdrv) plus the ISP firmware images,
+	  neither of which is available.  This driver therefore provides no
+	  V4L2 entity and no video node.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called mtk-imgsys.
