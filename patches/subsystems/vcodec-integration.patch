diff --git a/Documentation/devicetree/bindings/media/mediatek,mt6735-vcodec.yaml b/Documentation/devicetree/bindings/media/mediatek,mt6735-vcodec.yaml
new file mode 100644
index 000000000..a0fa5d93f
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/mediatek,mt6735-vcodec.yaml
@@ -0,0 +1,178 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/mediatek,mt6735-vcodec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6735 video codec engines
+
+maintainers:
+  - MediaTek SoC maintainers <linux-mediatek@lists.infradead.org>
+
+description: |
+  The MT6735 contains two independent video codec engines, a decoder (VDEC)
+  and an encoder (VENC).  Neither engine runs firmware and neither is driven
+  by a kernel-side bitstream parser: the vendor codec libraries program the
+  register windows from userspace through the mmap() interface of the
+  "Vcodec" character device.  The kernel owns the clock trees, the power
+  domains, the engine interrupts, the hardware ownership lock, the interrupt
+  wait and the register-window mappings.
+
+  Both nodes are consumed by the shared MT6735 video codec hardware service;
+  the encoder and the decoder are separate devices that register themselves
+  with that service.
+
+properties:
+  compatible:
+    enum:
+      - mediatek,mt6735-vdec
+      - mediatek,mt6735-venc
+
+  reg:
+    minItems: 1
+    maxItems: 2
+
+  reg-names:
+    minItems: 1
+    maxItems: 2
+    items:
+      enum: [vdec, gcon]
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 3
+    maxItems: 4
+    description: |
+      Clock tree of the engine, in the order the driver enables it.  The
+      driver takes the clocks in device tree order and disables them in
+      reverse order, so the list must follow the enable sequence of the
+      hardware: the SMI common clock of the mmsys first, then the engine
+      clock and its SMI LARB clock, followed by the topckgen VDEC clock mux
+      for the decoder.
+
+  clock-names:
+    minItems: 3
+    maxItems: 4
+    items:
+      enum: [smi-common, smi-larb1, smi-larb3, vdec, venc, vdec-sel]
+    description:
+      Descriptive names for the clocks; the driver enables all described
+      clocks in order and does not look them up by name.
+
+  power-domains:
+    minItems: 2
+    maxItems: 2
+    description:
+      The display subsystem power domain (DIS) followed by the power domain
+      of the engine itself (VDE for the decoder, VEN for the encoder).  The
+      order is the order in which they are powered on.
+
+  resets:
+    maxItems: 1
+    description:
+      Optional block reset of the engine.
+
+  reset-names:
+    const: vdec
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - power-domains
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: mediatek,mt6735-vdec
+    then:
+      properties:
+        reg:
+          items:
+            - description: VDEC decoder register window
+            - description: VDEC general control (gcon) register window
+        reg-names:
+          items:
+            - const: vdec
+            - const: gcon
+        clocks:
+          items:
+            - description: mmsys SMI common clock
+            - description: vdecsys VDEC clock
+            - description: vdecsys SMI LARB1 clock
+            - description: topckgen VDEC clock mux
+        clock-names:
+          items:
+            - const: smi-common
+            - const: vdec
+            - const: smi-larb1
+            - const: vdec-sel
+      required:
+        - reg-names
+    else:
+      properties:
+        reg:
+          items:
+            - description: VENC encoder register window
+        reg-names:
+          items:
+            - const: venc
+        clocks:
+          items:
+            - description: mmsys SMI common clock
+            - description: vencsys VENC clock
+            - description: vencsys SMI LARB3 clock
+        clock-names:
+          items:
+            - const: smi-common
+            - const: venc
+            - const: smi-larb3
+        resets: false
+        reset-names: false
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/mediatek,mt6735-mmsys.h>
+    #include <dt-bindings/clock/mediatek,mt6735-topckgen.h>
+    #include <dt-bindings/clock/mediatek,mt6735-vdecsys.h>
+    #include <dt-bindings/clock/mediatek,mt6735-vencsys.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    #include <dt-bindings/power/mt6735-power.h>
+    #include <dt-bindings/reset/mediatek,mt6735-vdecsys.h>
+
+    vdec: vcodec@16020000 {
+        compatible = "mediatek,mt6735-vdec";
+        reg = <0x16020000 0x10000>, <0x16000000 0x1000>;
+        reg-names = "vdec", "gcon";
+        interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_LOW>;
+        clocks = <&mmsys CLK_MM_SMI_COMMON>,
+                 <&vdecsys CLK_VDEC_VDEC>,
+                 <&vdecsys CLK_VDEC_SMI_LARB1>,
+                 <&topckgen CLK_TOP_VDEC_SEL>;
+        clock-names = "smi-common", "vdec", "smi-larb1", "vdec-sel";
+        power-domains = <&spm MT6735_POWER_DOMAIN_DIS>,
+                        <&spm MT6735_POWER_DOMAIN_VDE>;
+        resets = <&vdecsys MT6735_VDEC_RST0_VDEC>;
+        reset-names = "vdec";
+    };
+
+    venc: vcodec@17002000 {
+        compatible = "mediatek,mt6735-venc";
+        reg = <0x17002000 0x1000>;
+        reg-names = "venc";
+        interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_LOW>;
+        clocks = <&mmsys CLK_MM_SMI_COMMON>,
+                 <&vencsys CLK_VENC_VENC>,
+                 <&vencsys CLK_VENC_SMI_LARB3>;
+        clock-names = "smi-common", "venc", "smi-larb3";
+        power-domains = <&spm MT6735_POWER_DOMAIN_DIS>,
+                        <&spm MT6735_POWER_DOMAIN_VEN>;
+    };
