diff --git a/drivers/misc/mediatek/vcodec/vcodec-core.c b/drivers/misc/mediatek/vcodec/vcodec-core.c
new file mode 100644
index 000000000..a21a49c15
--- /dev/null
+++ b/drivers/misc/mediatek/vcodec/vcodec-core.c
@@ -0,0 +1,1159 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6735 video codec hardware service core.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * The MT6735 VENC/VDEC register programming is done by the vendor codec
+ * libraries in userspace through the register windows exported here.  This
+ * driver only owns the clocks, the power domains, the engine interrupts,
+ * the hardware ownership lock, the interrupt wait and the register-window
+ * mappings.  It serves both engines as one character device.
+ *
+ * Port from Samsung/MediaTek downstream
+ * drivers/misc/mediatek/videocodec/mt6735/videocodec_kernel_driver_D1.c
+ * (lock: 688-1119, unlock: 1120-1243, waitisr: 1244-1395, ioctl: 1397-1665,
+ *  compat: 1667-2030, open/release: 2030-2158, mmap: 2158-2200,
+ *  init/exit: 2350-2611).
+ */
+#define pr_fmt(fmt)	"vcodec: " fmt
+
+#include <linux/compat.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/ioctl.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/kernel_stat.h>
+#include <linux/list.h>
+#include <linux/math64.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/sched.h>
+#include <linux/sched/clock.h>
+#include <linux/sched/mm.h>
+#include <linux/spinlock.h>
+#include <linux/threads.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+
+#include <asm/barrier.h>
+
+#include <uapi/linux/vcodec.h>
+
+#include "vcodec.h"
+
+/* Downstream VCODEC_DEVNAME, videocodec_kernel_driver_D1.c:266 */
+#define VCODEC_DEVNAME			"Vcodec"
+
+/*
+ * Downstream waits 1000 ms for the hardware lock whenever the caller did not
+ * ask for a specific timeout (videocodec_kernel_driver_D1.c:886, 915).
+ */
+#define VCODEC_HWLOCK_DEFAULT_TIMEOUT_MS	1000
+
+/* Engine registry, protected by vcodec_engines_lock. */
+static LIST_HEAD(vcodec_engines);
+static DEFINE_MUTEX(vcodec_engines_lock);
+
+/* Number of open file descriptors on /dev/Vcodec, see vcodec_release(). */
+static DEFINE_MUTEX(vcodec_open_lock);
+static unsigned int vcodec_open_count;
+
+/* Per-codec EMI user counters, downstream gu4EncEMICounter/gu4DecEMICounter. */
+static DEFINE_MUTEX(vcodec_emi_lock);
+static u32 vcodec_enc_emi_users;
+static u32 vcodec_dec_emi_users;
+
+/* Per-engine power user counters, downstream gu4L2CCounter accounting. */
+static DEFINE_MUTEX(vcodec_pwr_lock);
+static u32 vcodec_power_users[VCODEC_ENGINE_MAX];
+
+/* Per-CPU load sampling, downstream get_cpu_load() is not available here. */
+static DEFINE_MUTEX(vcodec_cpu_load_lock);
+static u64 vcodec_cpu_prev_busy[NR_CPUS];
+static u64 vcodec_cpu_prev_total[NR_CPUS];
+static bool vcodec_cpu_prev_valid[NR_CPUS];
+
+static bool vcodec_driver_type_is_dec(u32 driver_type)
+{
+	switch (driver_type) {
+	case VCODEC_DRV_TYPE_MP4_DEC:
+	case VCODEC_DRV_TYPE_HEVC_DEC:
+	case VCODEC_DRV_TYPE_H264_DEC:
+	case VCODEC_DRV_TYPE_MP1_MP2_DEC:
+	case VCODEC_DRV_TYPE_VC1_DEC:
+	case VCODEC_DRV_TYPE_VC1_ADV_DEC:
+	case VCODEC_DRV_TYPE_VP8_DEC:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool vcodec_driver_type_is_enc(u32 driver_type)
+{
+	switch (driver_type) {
+	case VCODEC_DRV_TYPE_H264_ENC:
+	case VCODEC_DRV_TYPE_HEVC_ENC:
+	case VCODEC_DRV_TYPE_JPEG_ENC:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/*
+ * Translate a user handle into a physical address used as the lock owner
+ * identity.  Downstream walks the page tables (pmem_user_v2p_video(),
+ * videocodec_kernel.c:42-90); pinning the page is the equivalent stable
+ * identity here.  If the page cannot be pinned (for example the handle lives
+ * in a device mapping) the raw value is used unchanged, which keeps the
+ * owner comparison self-consistent.
+ */
+static phys_addr_t vcodec_user_v2p(u64 uaddr)
+{
+	struct page *page = NULL;
+	phys_addr_t pa;
+	int ret;
+
+	if (!uaddr)
+		return 0;
+	if (!current->mm)
+		return (phys_addr_t)uaddr;
+
+	ret = pin_user_pages_fast(uaddr & PAGE_MASK, 1, FOLL_WRITE, &page);
+	if (ret != 1)
+		ret = pin_user_pages_fast(uaddr & PAGE_MASK, 1, 0, &page);
+	if (ret != 1) {
+		pr_debug("handle 0x%llx is not pinnable, using it as identity\n",
+			 (unsigned long long)uaddr);
+		return (phys_addr_t)uaddr;
+	}
+
+	pa = page_to_phys(page) | offset_in_page(uaddr);
+	unpin_user_page(page);
+
+	return pa;
+}
+
+/*
+ * Look up the engine serving @driver_type.  Returns an ERR_PTR() for a
+ * driver type that no engine handles (-EINVAL) or an engine that is not
+ * registered right now (-ENODEV).
+ */
+static struct vcodec_engine *vcodec_lookup_engine(u32 driver_type)
+{
+	enum vcodec_engine_id id;
+	struct vcodec_engine *eng, *found = NULL;
+
+	if (vcodec_driver_type_is_dec(driver_type))
+		id = VCODEC_ENGINE_DEC;
+	else if (vcodec_driver_type_is_enc(driver_type))
+		id = VCODEC_ENGINE_ENC;
+	else
+		return ERR_PTR(-EINVAL);
+
+	mutex_lock(&vcodec_engines_lock);
+	list_for_each_entry(eng, &vcodec_engines, node) {
+		if (eng->id == id && eng->registered) {
+			found = eng;
+			break;
+		}
+	}
+	mutex_unlock(&vcodec_engines_lock);
+
+	return found ? found : ERR_PTR(-ENODEV);
+}
+
+static unsigned int vcodec_engine_inst_count(void)
+{
+	struct vcodec_engine *eng;
+	unsigned int count = 0;
+
+	mutex_lock(&vcodec_engines_lock);
+	list_for_each_entry(eng, &vcodec_engines, node) {
+		if (READ_ONCE(eng->hw_locked))
+			count++;
+	}
+	mutex_unlock(&vcodec_engines_lock);
+
+	return count;
+}
+
+int vcodec_engine_register(struct vcodec_engine *eng)
+{
+	struct vcodec_engine *iter;
+	int ret = 0;
+
+	if (!eng || !eng->name || !eng->dev || !eng->ops)
+		return -EINVAL;
+	if (!eng->ops->power_on || !eng->ops->power_off ||
+	    !eng->ops->enable_irq || !eng->ops->disable_irq)
+		return -EINVAL;
+	if (eng->id >= VCODEC_ENGINE_MAX)
+		return -EINVAL;
+	if (eng->num_regions > VCODEC_MAX_MMAP_REGIONS)
+		return -EINVAL;
+
+	mutex_init(&eng->lock);
+	init_waitqueue_head(&eng->hwlock_wq);
+	init_waitqueue_head(&eng->isr_wq);
+	spin_lock_init(&eng->irq_lock);
+	eng->hw_locked = false;
+	eng->powered = false;
+	eng->irq_enabled = false;
+	eng->owner = 0;
+	eng->driver_type = VCODEC_DRV_TYPE_NONE;
+	eng->isr_seq = 0;
+	eng->irq_status = 0;
+
+	mutex_lock(&vcodec_engines_lock);
+	list_for_each_entry(iter, &vcodec_engines, node) {
+		if (iter->id == eng->id) {
+			ret = -EBUSY;
+			break;
+		}
+	}
+	if (!ret) {
+		eng->registered = true;
+		list_add_tail(&eng->node, &vcodec_engines);
+	}
+	mutex_unlock(&vcodec_engines_lock);
+
+	if (ret)
+		dev_err(eng->dev, "engine %s already registered\n", eng->name);
+	else
+		dev_dbg(eng->dev, "engine %s registered\n", eng->name);
+
+	return ret;
+}
+
+void vcodec_engine_unregister(struct vcodec_engine *eng)
+{
+	if (!eng)
+		return;
+
+	mutex_lock(&vcodec_engines_lock);
+	if (!eng->registered) {
+		mutex_unlock(&vcodec_engines_lock);
+		return;
+	}
+
+	mutex_lock(&eng->lock);
+	if (eng->irq_enabled) {
+		eng->ops->disable_irq(eng);
+		eng->irq_enabled = false;
+	}
+	if (eng->powered) {
+		eng->ops->power_off(eng);
+		eng->powered = false;
+	}
+	eng->hw_locked = false;
+	eng->owner = 0;
+	eng->driver_type = VCODEC_DRV_TYPE_NONE;
+	mutex_unlock(&eng->lock);
+
+	list_del(&eng->node);
+	eng->registered = false;
+	mutex_unlock(&vcodec_engines_lock);
+
+	dev_dbg(eng->dev, "engine %s unregistered\n", eng->name);
+}
+
+void vcodec_engine_irq(struct vcodec_engine *eng, u32 status)
+{
+	unsigned long flags;
+
+	if (!eng)
+		return;
+
+	spin_lock_irqsave(&eng->irq_lock, flags);
+	eng->irq_status = status;
+	eng->isr_seq++;
+	spin_unlock_irqrestore(&eng->irq_lock, flags);
+
+	wake_up_interruptible_all(&eng->isr_wq);
+}
+
+bool vcodec_engine_is_locked(struct vcodec_engine *eng)
+{
+	return eng && READ_ONCE(eng->hw_locked);
+}
+
+u32 vcodec_engine_get_driver_type(struct vcodec_engine *eng)
+{
+	return eng ? READ_ONCE(eng->driver_type) : VCODEC_DRV_TYPE_NONE;
+}
+
+/*
+ * Take the hardware ownership lock of the engine @driver_type serves.
+ * Downstream: videocodec_kernel_driver_D1.c:688-1119.
+ */
+static long vcodec_ioc_lockhw(u64 handle, u32 timeout_ms, u32 driver_type,
+			      bool secure)
+{
+	struct vcodec_engine *eng;
+	phys_addr_t owner;
+	unsigned long timeout, left;
+	int ret;
+
+	eng = vcodec_lookup_engine(driver_type);
+	if (IS_ERR(eng))
+		return PTR_ERR(eng);
+
+	owner = vcodec_user_v2p(handle);
+	if (!owner)
+		return -EINVAL;
+
+	if (!timeout_ms)
+		timeout_ms = VCODEC_HWLOCK_DEFAULT_TIMEOUT_MS;
+	timeout = msecs_to_jiffies(timeout_ms);
+
+	for (;;) {
+		mutex_lock(&eng->lock);
+		if (!eng->hw_locked)
+			break;
+		mutex_unlock(&eng->lock);
+
+		left = wait_event_interruptible_timeout(eng->hwlock_wq,
+							!READ_ONCE(eng->hw_locked),
+							timeout);
+		if (!left) {
+			dev_dbg(eng->dev, "hw lock timeout after %u ms\n",
+				timeout_ms);
+			return -ETIMEDOUT;
+		}
+		if (left < 0) {
+			dev_dbg(eng->dev, "hw lock interrupted\n");
+			return -ERESTARTSYS;
+		}
+
+		/* Spurious wakeup: keep the remaining part of the budget. */
+		timeout = left;
+	}
+
+	/*
+	 * Downstream acquires the lock for the JPEG encoder too but guards the
+	 * power on and the interrupt unmask with H264_ENC/HEVC_ENC only
+	 * (videocodec_kernel_driver_D1.c:953-957 and 971-977); enc_isr() then
+	 * reports a JPEG holder as an invalid lock holder (lines 664-667).
+	 */
+	if (driver_type == VCODEC_DRV_TYPE_JPEG_ENC) {
+		eng->owner = owner;
+		eng->driver_type = driver_type;
+		/* Pairs with the READ_ONCE() in the wait condition above. */
+		smp_store_release(&eng->hw_locked, true);
+		mutex_unlock(&eng->lock);
+
+		dev_dbg(eng->dev, "jpeg encoder lock recorded\n");
+
+		return 0;
+	}
+
+	ret = eng->ops->power_on(eng);
+	if (ret) {
+		mutex_unlock(&eng->lock);
+		dev_err(eng->dev, "power on failed: %d\n", ret);
+		return ret;
+	}
+	eng->powered = true;
+
+	eng->owner = owner;
+	eng->driver_type = driver_type;
+	/*
+	 * Publish the owner before the line is unmasked: a level-low
+	 * completion may already be pending, and the engine ISR must
+	 * attribute it to this instance instead of acking it as spurious.
+	 * Waiters only look at hw_locked, so publishing this early is safe.
+	 */
+	smp_store_release(&eng->hw_locked, true);
+
+	if (!secure) {
+		ret = eng->ops->enable_irq(eng);
+		if (ret) {
+			/* Withdraw the publication, the lock was not taken. */
+			smp_store_release(&eng->hw_locked, false);
+			eng->owner = 0;
+			eng->driver_type = VCODEC_DRV_TYPE_NONE;
+			eng->ops->power_off(eng);
+			eng->powered = false;
+			mutex_unlock(&eng->lock);
+			wake_up_interruptible_all(&eng->hwlock_wq);
+			dev_err(eng->dev, "enabling the irq failed: %d\n", ret);
+			return ret;
+		}
+		eng->irq_enabled = true;
+	}
+
+	mutex_unlock(&eng->lock);
+
+	dev_dbg(eng->dev, "engine locked by type %u (secure %d)\n",
+		driver_type, secure);
+
+	return 0;
+}
+
+/*
+ * Release the hardware ownership lock.  Only the recorded owner may do so.
+ * Downstream: videocodec_kernel_driver_D1.c:1120-1243.
+ */
+static long vcodec_ioc_unlockhw(u64 handle, u32 driver_type)
+{
+	struct vcodec_engine *eng;
+	phys_addr_t owner;
+
+	eng = vcodec_lookup_engine(driver_type);
+	if (IS_ERR(eng))
+		return PTR_ERR(eng);
+
+	owner = vcodec_user_v2p(handle);
+	if (!owner)
+		return -EINVAL;
+
+	mutex_lock(&eng->lock);
+	if (!eng->hw_locked || eng->owner != owner) {
+		mutex_unlock(&eng->lock);
+		dev_warn(eng->dev, "handle 0x%llx is not the engine owner\n",
+			 (unsigned long long)handle);
+		return -EPERM;
+	}
+
+	if (eng->irq_enabled) {
+		eng->ops->disable_irq(eng);
+		eng->irq_enabled = false;
+	}
+	if (eng->powered) {
+		eng->ops->power_off(eng);
+		eng->powered = false;
+	}
+
+	/* Publish the release after the engine is quiescent. */
+	smp_store_release(&eng->hw_locked, false);
+	eng->owner = 0;
+	eng->driver_type = VCODEC_DRV_TYPE_NONE;
+	eng->irq_status = 0;
+	mutex_unlock(&eng->lock);
+
+	wake_up_interruptible_all(&eng->hwlock_wq);
+
+	dev_dbg(eng->dev, "engine unlocked\n");
+
+	return 0;
+}
+
+/*
+ * Wait for the engine interrupt.  Downstream: videocodec_kernel_driver_D1.c:
+ * 1244-1395.  A timeout is reported as -EFAULT because downstream's
+ * dispatcher turns every failure of vcodec_waitisr() into -EFAULT before it
+ * reaches userspace (lines 1443-1448), so the vendor libraries never see the
+ * internal -2.  @status is only filled in for the encoder, matching
+ * downstream which only returns status words for VENC (lines 1183-1197).
+ */
+static long vcodec_ioc_waitisr(u64 handle, u32 driver_type, u32 timeout_ms,
+			       u32 irq_status_num, u32 *status)
+{
+	struct vcodec_engine *eng;
+	phys_addr_t owner;
+	unsigned long seq;
+	long ret;
+
+	/*
+	 * Downstream's WAITISR knows the decode types and H264_ENC/HEVC_ENC
+	 * only; the JPEG encoder falls into its "Unknown instance" branch
+	 * (videocodec_kernel_driver_D1.c:1233-1236).  Report that as -EINVAL
+	 * rather than downstream's -EFAULT.
+	 */
+	if (driver_type == VCODEC_DRV_TYPE_JPEG_ENC) {
+		pr_debug("waitisr does not apply to the jpeg encoder\n");
+		return -EINVAL;
+	}
+
+	eng = vcodec_lookup_engine(driver_type);
+	if (IS_ERR(eng))
+		return PTR_ERR(eng);
+
+	owner = vcodec_user_v2p(handle);
+
+	mutex_lock(&eng->lock);
+	if (!eng->hw_locked || eng->owner != owner) {
+		mutex_unlock(&eng->lock);
+		dev_warn(eng->dev, "waitisr without holding the engine\n");
+		return -EPERM;
+	}
+	seq = READ_ONCE(eng->isr_seq);
+	mutex_unlock(&eng->lock);
+
+	ret = wait_event_interruptible_timeout(eng->isr_wq,
+					       READ_ONCE(eng->isr_seq) != seq,
+					       msecs_to_jiffies(timeout_ms));
+	if (!ret) {
+		dev_dbg(eng->dev, "isr timeout after %u ms\n", timeout_ms);
+		return -EFAULT;
+	}
+	if (ret < 0) {
+		dev_dbg(eng->dev, "isr wait interrupted\n");
+		return -ERESTARTSYS;
+	}
+
+	if (status && irq_status_num &&
+	    eng->id == VCODEC_ENGINE_ENC)
+		*status = READ_ONCE(eng->irq_status);
+
+	return 0;
+}
+
+static long vcodec_ioc_emi_user(bool enc, bool increment, u32 __user *uval)
+{
+	u32 value;
+
+	mutex_lock(&vcodec_emi_lock);
+	if (enc) {
+		if (increment)
+			vcodec_enc_emi_users++;
+		else if (vcodec_enc_emi_users)
+			vcodec_enc_emi_users--;
+		value = vcodec_enc_emi_users;
+	} else {
+		if (increment)
+			vcodec_dec_emi_users++;
+		else if (vcodec_dec_emi_users)
+			vcodec_dec_emi_users--;
+		value = vcodec_dec_emi_users;
+	}
+	mutex_unlock(&vcodec_emi_lock);
+
+	if (put_user(value, uval))
+		return -EFAULT;
+
+	return 0;
+}
+
+static long vcodec_ioc_pwr_user(u32 driver_type, bool increment)
+{
+	enum vcodec_engine_id id;
+
+	if (vcodec_driver_type_is_dec(driver_type))
+		id = VCODEC_ENGINE_DEC;
+	else if (vcodec_driver_type_is_enc(driver_type))
+		id = VCODEC_ENGINE_ENC;
+	else
+		return -EINVAL;
+
+	mutex_lock(&vcodec_pwr_lock);
+	if (increment)
+		vcodec_power_users[id]++;
+	else if (vcodec_power_users[id])
+		vcodec_power_users[id]--;
+	pr_debug("engine %d power users: %u\n", id, vcodec_power_users[id]);
+	mutex_unlock(&vcodec_pwr_lock);
+
+	return 0;
+}
+
+static long vcodec_ioc_core_number(s32 __user *unr)
+{
+	s32 nr = nr_cpu_ids;
+
+	if (put_user(nr, unr))
+		return -EFAULT;
+
+	return 0;
+}
+
+/*
+ * Per-CPU load in percent over the interval since the previous query of the
+ * same CPU.  Downstream called get_cpu_load() which does not exist here;
+ * the same numbers are derived from the per-CPU kcpustat counters.
+ */
+static void vcodec_cpu_sample(int cpu, u64 *busy, u64 *total)
+{
+	struct kernel_cpustat kcs;
+	u64 sum = 0, idle;
+	int i;
+
+	kcpustat_cpu_fetch(&kcs, cpu);
+	for (i = 0; i < NR_STATS; i++)
+		sum += kcpustat_field(&kcs, i, cpu);
+
+	idle = kcpustat_field(&kcs, CPUTIME_IDLE, cpu) +
+	       kcpustat_field(&kcs, CPUTIME_IOWAIT, cpu);
+
+	*total = sum;
+	*busy = sum > idle ? sum - idle : 0;
+}
+
+static long vcodec_ioc_core_loading(struct vcodec_core_loading *loading)
+{
+	u64 busy, total;
+	s32 cpu = loading->cpu_id;
+
+	/* nr_cpu_ids never exceeds NR_CPUS, so this bounds the arrays too. */
+	if (cpu < 0 || cpu >= nr_cpu_ids)
+		return -EINVAL;
+
+	vcodec_cpu_sample(cpu, &busy, &total);
+
+	mutex_lock(&vcodec_cpu_load_lock);
+	if (!vcodec_cpu_prev_valid[cpu]) {
+		/* First sample for this CPU only provides the baseline. */
+		loading->loading = 0;
+		vcodec_cpu_prev_valid[cpu] = true;
+	} else if (total > vcodec_cpu_prev_total[cpu] &&
+		   busy >= vcodec_cpu_prev_busy[cpu]) {
+		u64 d_total = total - vcodec_cpu_prev_total[cpu];
+		u64 d_busy = busy - vcodec_cpu_prev_busy[cpu];
+
+		loading->loading = d_busy >= d_total ? 100 :
+				   (s32)div_u64(100 * d_busy, d_total);
+	} else {
+		loading->loading = 0;
+	}
+	vcodec_cpu_prev_busy[cpu] = busy;
+	vcodec_cpu_prev_total[cpu] = total;
+	mutex_unlock(&vcodec_cpu_load_lock);
+
+	return 0;
+}
+
+static void vcodec_ioc_cpu_loading_info(struct vcodec_cpu_loading_info *info)
+{
+	/*
+	 * Downstream copied an uninitialised stack struct here
+	 * (videocodec_kernel_driver_D1.c:1595-1620); only the fields the
+	 * kernel can actually provide are filled in.
+	 */
+	memset(info, 0, sizeof(*info));
+	info->sched_clock = sched_clock();
+	info->inst_count = vcodec_engine_inst_count();
+}
+
+static long vcodec_ioc_thread_id(const struct vcodec_thread_id *tid)
+{
+	if (tid->thread_num > VCODEC_THREAD_MAX_NUM)
+		return -EINVAL;
+
+	/* Downstream only logs the ids, there is no hardware action. */
+	pr_debug("thread ids %u/%u, count %u\n", tid->tid1, tid->tid2,
+		 tid->thread_num);
+
+	return 0;
+}
+
+static int vcodec_open(struct inode *inode, struct file *file)
+{
+	mutex_lock(&vcodec_open_lock);
+	vcodec_open_count++;
+	pr_debug("open by %s, %u open now\n", current->comm,
+		 vcodec_open_count);
+	mutex_unlock(&vcodec_open_lock);
+
+	return 0;
+}
+
+static void vcodec_reset_counters(void)
+{
+	mutex_lock(&vcodec_emi_lock);
+	vcodec_enc_emi_users = 0;
+	vcodec_dec_emi_users = 0;
+	mutex_unlock(&vcodec_emi_lock);
+
+	mutex_lock(&vcodec_pwr_lock);
+	memset(vcodec_power_users, 0, sizeof(vcodec_power_users));
+	mutex_unlock(&vcodec_pwr_lock);
+
+	mutex_lock(&vcodec_cpu_load_lock);
+	memset(vcodec_cpu_prev_busy, 0, sizeof(vcodec_cpu_prev_busy));
+	memset(vcodec_cpu_prev_total, 0, sizeof(vcodec_cpu_prev_total));
+	memset(vcodec_cpu_prev_valid, 0, sizeof(vcodec_cpu_prev_valid));
+	mutex_unlock(&vcodec_cpu_load_lock);
+}
+
+/*
+ * Force both engines back to their idle state.  Downstream does the same
+ * bookkeeping when the last file descriptor is closed
+ * (videocodec_kernel_driver_D1.c:2042-2158).
+ */
+static void vcodec_cleanup_engines(void)
+{
+	struct vcodec_engine *eng;
+
+	mutex_lock(&vcodec_engines_lock);
+	list_for_each_entry(eng, &vcodec_engines, node) {
+		mutex_lock(&eng->lock);
+		if (eng->irq_enabled) {
+			eng->ops->disable_irq(eng);
+			eng->irq_enabled = false;
+		}
+		if (eng->powered) {
+			eng->ops->power_off(eng);
+			eng->powered = false;
+		}
+		eng->hw_locked = false;
+		eng->owner = 0;
+		eng->driver_type = VCODEC_DRV_TYPE_NONE;
+		eng->irq_status = 0;
+		mutex_unlock(&eng->lock);
+		wake_up_interruptible_all(&eng->hwlock_wq);
+	}
+	mutex_unlock(&vcodec_engines_lock);
+
+	vcodec_reset_counters();
+}
+
+static int vcodec_release(struct inode *inode, struct file *file)
+{
+	bool last = false;
+
+	mutex_lock(&vcodec_open_lock);
+	if (vcodec_open_count)
+		vcodec_open_count--;
+	if (!vcodec_open_count)
+		last = true;
+	pr_debug("release by %s, %u open left\n", current->comm,
+		 vcodec_open_count);
+	mutex_unlock(&vcodec_open_lock);
+
+	if (last) {
+		pr_debug("last user gone, forcing engines idle\n");
+		vcodec_cleanup_engines();
+	}
+
+	return 0;
+}
+
+/*
+ * Map a codec register window.  Only ranges that lie completely inside one
+ * of the regions an engine registered are accepted.
+ *
+ * Downstream additionally allowed any address inside four hardcoded
+ * physical windows (videocodec_kernel_driver_D1.c:2178-2205), which lets
+ * userspace map unrelated MMIO.  That is not reproduced here.
+ */
+static int vcodec_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	unsigned long length = vma->vm_end - vma->vm_start;
+	phys_addr_t start = (phys_addr_t)vma->vm_pgoff << PAGE_SHIFT;
+	phys_addr_t end;
+	struct vcodec_engine *eng;
+	bool allowed = false;
+
+	if (!length || !PAGE_ALIGNED(vma->vm_start) || !PAGE_ALIGNED(length))
+		return -EINVAL;
+
+	end = start + length;
+	if (end < start)
+		return -EINVAL;
+
+	mutex_lock(&vcodec_engines_lock);
+	list_for_each_entry(eng, &vcodec_engines, node) {
+		unsigned int i;
+
+		for (i = 0; i < eng->num_regions; i++) {
+			phys_addr_t rstart = eng->regions[i].phys;
+			phys_addr_t rend = rstart + eng->regions[i].size;
+
+			if (start >= rstart && end <= rend) {
+				allowed = true;
+				break;
+			}
+		}
+		if (allowed)
+			break;
+	}
+	mutex_unlock(&vcodec_engines_lock);
+
+	if (!allowed) {
+		pr_debug("rejecting mmap of 0x%llx+0x%lx\n",
+			 (u64)start, length);
+		return -EINVAL;
+	}
+
+	vma->vm_page_prot = pgprot_noncached(vma->vm_page_prot);
+	if (remap_pfn_range(vma, vma->vm_start, vma->vm_pgoff, length,
+			    vma->vm_page_prot))
+		return -EAGAIN;
+
+	pr_debug("mapped 0x%llx+0x%lx\n", (u64)start, length);
+
+	return 0;
+}
+
+/*
+ * Commands whose downstream handlers never did anything.  They are refused
+ * instead of silently succeeding, so userspace can tell that the service is
+ * not available on this kernel.
+ */
+static const unsigned int vcodec_unsupported_cmds[] = {
+	MFV_TEST_CMD,
+	MFV_INIT_CMD,
+	MFV_DEINIT_CMD,
+	MFV_SET_CMD_CMD,
+	MFV_SET_PWR_CMD,
+	MFV_SET_ISR_CMD,
+	MFV_ALLOC_MEM_CMD,
+	MFV_FREE_MEM_CMD,
+	MFV_MAKE_PMEM_TO_NONCACHED,
+	MFV_ALLOC_INT_MEM_CMD,
+	MFV_FREE_INT_MEM_CMD,
+	VCODEC_PMEM_FLUSH,
+	VCODEC_PMEM_CLEAN,
+	VCODEC_INC_SYSRAM_USER,
+	VCODEC_DEC_SYSRAM_USER,
+	VCODEC_SET_SYSRAM_INFO,
+	VCODEC_GET_SYSRAM_INFO,
+	VCODEC_ALLOC_NON_CACHE_BUFFER,
+	VCODEC_FREE_NON_CACHE_BUFFER,
+	VCODEC_SET_CPU_OPP_LIMIT,
+};
+
+static bool vcodec_cmd_is_unsupported(unsigned int cmd)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(vcodec_unsupported_cmds); i++)
+		if (vcodec_unsupported_cmds[i] == cmd)
+			return true;
+
+	return false;
+}
+
+static long vcodec_unlocked_ioctl(struct file *file, unsigned int cmd,
+				  unsigned long arg)
+{
+	void __user *uarg = (void __user *)arg;
+	struct vcodec_hw_lock hwlock;
+	struct vcodec_power power;
+	struct vcodec_isr isr;
+	struct vcodec_thread_id thread_id;
+	struct vcodec_core_loading loading;
+	struct vcodec_cpu_loading_info info;
+	u32 status = 0;
+	long ret;
+
+	switch (cmd) {
+	case VCODEC_LOCKHW:
+		if (copy_from_user(&hwlock, uarg, sizeof(hwlock)))
+			return -EFAULT;
+		return vcodec_ioc_lockhw(hwlock.pv_handle, hwlock.timeout_ms,
+					 hwlock.driver_type,
+					 !!hwlock.secure_inst);
+	case VCODEC_UNLOCKHW:
+		if (copy_from_user(&hwlock, uarg, sizeof(hwlock)))
+			return -EFAULT;
+		return vcodec_ioc_unlockhw(hwlock.pv_handle,
+					   hwlock.driver_type);
+	case VCODEC_WAITISR:
+		if (copy_from_user(&isr, uarg, sizeof(isr)))
+			return -EFAULT;
+		ret = vcodec_ioc_waitisr(isr.pv_handle, isr.driver_type,
+					 isr.timeout_ms, isr.irq_status_num,
+					 &status);
+		if (ret)
+			return ret;
+		if (isr.irq_status_num &&
+		    vcodec_driver_type_is_enc(isr.driver_type)) {
+			isr.irq_status[0] = status;
+			if (copy_to_user(uarg, &isr, sizeof(isr)))
+				return -EFAULT;
+		}
+		return 0;
+	case VCODEC_INC_ENC_EMI_USER:
+		return vcodec_ioc_emi_user(true, true, uarg);
+	case VCODEC_DEC_ENC_EMI_USER:
+		return vcodec_ioc_emi_user(true, false, uarg);
+	case VCODEC_INC_DEC_EMI_USER:
+		return vcodec_ioc_emi_user(false, true, uarg);
+	case VCODEC_DEC_DEC_EMI_USER:
+		return vcodec_ioc_emi_user(false, false, uarg);
+	case VCODEC_INC_PWR_USER:
+	case VCODEC_DEC_PWR_USER:
+		if (copy_from_user(&power, uarg, sizeof(power)))
+			return -EFAULT;
+		return vcodec_ioc_pwr_user(power.driver_type,
+					   cmd == VCODEC_INC_PWR_USER);
+	case VCODEC_GET_CORE_NUMBER:
+		return vcodec_ioc_core_number(uarg);
+	case VCODEC_GET_CORE_LOADING:
+		if (copy_from_user(&loading, uarg, sizeof(loading)))
+			return -EFAULT;
+		ret = vcodec_ioc_core_loading(&loading);
+		if (ret)
+			return ret;
+		if (copy_to_user(uarg, &loading, sizeof(loading)))
+			return -EFAULT;
+		return 0;
+	case VCODEC_GET_CPU_LOADING_INFO:
+		vcodec_ioc_cpu_loading_info(&info);
+		if (copy_to_user(uarg, &info, sizeof(info)))
+			return -EFAULT;
+		return 0;
+	case VCODEC_SET_THREAD_ID:
+		if (copy_from_user(&thread_id, uarg, sizeof(thread_id)))
+			return -EFAULT;
+		return vcodec_ioc_thread_id(&thread_id);
+	case VCODEC_INITHWLOCK:
+	case VCODEC_DEINITHWLOCK:
+		/* Downstream only logs these, the lock is owned by this file. */
+		pr_debug("cmd 0x%x accepted\n", cmd);
+		return 0;
+	case VCODEC_MB:
+		/* Downstream: full barrier, no other effect. */
+		mb();
+		return 0;
+	default:
+		if (vcodec_cmd_is_unsupported(cmd)) {
+			pr_debug("cmd 0x%x is not supported\n", cmd);
+			return -EOPNOTSUPP;
+		}
+		pr_debug("unknown cmd 0x%x\n", cmd);
+		return -ENOTTY;
+	}
+}
+
+#if IS_ENABLED(CONFIG_COMPAT)
+/*
+ * 32-bit layouts, mirroring COMPAT_VAL_HW_LOCK_T, COMPAT_VAL_POWER_T and
+ * COMPAT_VAL_ISR_T of videocodec_kernel_driver_D1.c:1672-1740.  They are
+ * read field by field so no padding assumptions are made.
+ */
+struct vcodec_compat_hw_lock {
+	__u32 pv_handle;
+	__u32 handle_size;
+	__u32 pv_lock;
+	__u32 timeout_ms;
+	__u32 pv_reserved;
+	__u32 reserved_size;
+	__u32 driver_type;
+	__u8 secure_inst;
+};
+
+struct vcodec_compat_power {
+	__u32 pv_handle;
+	__u32 handle_size;
+	__u32 driver_type;
+	__u8 enable;
+	__u32 pv_reserved;
+	__u32 reserved_size;
+};
+
+struct vcodec_compat_isr {
+	__u32 pv_handle;
+	__u32 handle_size;
+	__u32 driver_type;
+	__u32 pv_isr_function;
+	__u32 pv_reserved;
+	__u32 reserved_size;
+	__u32 timeout_ms;
+	__u32 irq_status_num;
+	__u32 irq_status[VCODEC_IRQ_STATUS_MAX_NUM];
+};
+
+/*
+ * VCODEC_GET_CPU_LOADING_INFO payload of a 32-bit caller: three u64 followed
+ * by one u32, with no trailing field of our own.  Kept separate from the
+ * native struct so nothing beyond @inst_count is ever written.
+ */
+struct vcodec_compat_cpu_loading_info {
+	__u64 cpu_idle_time;
+	__u64 thread_cpu_time;
+	__u64 sched_clock;
+	__u32 inst_count;
+};
+
+static long vcodec_compat_lockhw(struct vcodec_compat_hw_lock __user *ucompat)
+{
+	u32 handle, timeout_ms, driver_type;
+	u8 secure;
+
+	if (get_user(handle, &ucompat->pv_handle) ||
+	    get_user(timeout_ms, &ucompat->timeout_ms) ||
+	    get_user(driver_type, &ucompat->driver_type) ||
+	    get_user(secure, &ucompat->secure_inst))
+		return -EFAULT;
+
+	return vcodec_ioc_lockhw(handle, timeout_ms, driver_type, !!secure);
+}
+
+static long vcodec_compat_unlockhw(struct vcodec_compat_hw_lock __user *ucompat)
+{
+	u32 handle, driver_type;
+
+	if (get_user(handle, &ucompat->pv_handle) ||
+	    get_user(driver_type, &ucompat->driver_type))
+		return -EFAULT;
+
+	return vcodec_ioc_unlockhw(handle, driver_type);
+}
+
+static long vcodec_compat_waitisr(struct vcodec_compat_isr __user *ucompat)
+{
+	u32 handle, driver_type, timeout_ms, irq_status_num;
+	u32 status = 0;
+	long ret;
+
+	if (get_user(handle, &ucompat->pv_handle) ||
+	    get_user(driver_type, &ucompat->driver_type) ||
+	    get_user(timeout_ms, &ucompat->timeout_ms) ||
+	    get_user(irq_status_num, &ucompat->irq_status_num))
+		return -EFAULT;
+
+	ret = vcodec_ioc_waitisr(handle, driver_type, timeout_ms,
+				 irq_status_num, &status);
+	if (ret)
+		return ret;
+
+	if (irq_status_num && vcodec_driver_type_is_enc(driver_type)) {
+		if (put_user(status, &ucompat->irq_status[0]))
+			return -EFAULT;
+	}
+
+	return 0;
+}
+
+static long vcodec_compat_ioctl(struct file *file, unsigned int cmd,
+				unsigned long arg)
+{
+	void __user *uarg = compat_ptr(arg);
+	struct vcodec_core_loading loading;
+	struct vcodec_cpu_loading_info info;
+	struct vcodec_thread_id thread_id;
+	long ret;
+
+	switch (cmd) {
+	case VCODEC_LOCKHW:
+		return vcodec_compat_lockhw(uarg);
+	case VCODEC_UNLOCKHW:
+		return vcodec_compat_unlockhw(uarg);
+	case VCODEC_WAITISR:
+		return vcodec_compat_waitisr(uarg);
+	case VCODEC_INC_PWR_USER:
+	case VCODEC_DEC_PWR_USER: {
+		u32 driver_type;
+
+		if (get_user(driver_type,
+			     &((struct vcodec_compat_power __user *)uarg)->driver_type))
+			return -EFAULT;
+		return vcodec_ioc_pwr_user(driver_type,
+					   cmd == VCODEC_INC_PWR_USER);
+	}
+	case VCODEC_INC_ENC_EMI_USER:
+		return vcodec_ioc_emi_user(true, true, uarg);
+	case VCODEC_DEC_ENC_EMI_USER:
+		return vcodec_ioc_emi_user(true, false, uarg);
+	case VCODEC_INC_DEC_EMI_USER:
+		return vcodec_ioc_emi_user(false, true, uarg);
+	case VCODEC_DEC_DEC_EMI_USER:
+		return vcodec_ioc_emi_user(false, false, uarg);
+	case VCODEC_GET_CORE_NUMBER:
+		return vcodec_ioc_core_number(uarg);
+	case VCODEC_GET_CORE_LOADING:
+		/* Two s32 fields, identical on both word sizes. */
+		if (copy_from_user(&loading, uarg, sizeof(loading)))
+			return -EFAULT;
+		ret = vcodec_ioc_core_loading(&loading);
+		if (ret)
+			return ret;
+		if (copy_to_user(uarg, &loading, sizeof(loading)))
+			return -EFAULT;
+		return 0;
+	case VCODEC_GET_CPU_LOADING_INFO: {
+		struct vcodec_compat_cpu_loading_info __user *uinfo = uarg;
+
+		vcodec_ioc_cpu_loading_info(&info);
+		/*
+		 * Field by field: the fields sit at the same offsets on both
+		 * word sizes, but the tail padding after @inst_count belongs
+		 * to the caller's struct and must not be written from here.
+		 */
+		if (put_user(info.cpu_idle_time, &uinfo->cpu_idle_time) ||
+		    put_user(info.thread_cpu_time, &uinfo->thread_cpu_time) ||
+		    put_user(info.sched_clock, &uinfo->sched_clock) ||
+		    put_user(info.inst_count, &uinfo->inst_count))
+			return -EFAULT;
+		return 0;
+	}
+	case VCODEC_SET_THREAD_ID:
+		/* u32 only, identical on both word sizes. */
+		if (copy_from_user(&thread_id, uarg, sizeof(thread_id)))
+			return -EFAULT;
+		return vcodec_ioc_thread_id(&thread_id);
+	case VCODEC_MB:
+		/* Downstream: full barrier, no other effect. */
+		mb();
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+#endif /* CONFIG_COMPAT */
+
+static const struct file_operations vcodec_fops = {
+	.owner		= THIS_MODULE,
+	.open		= vcodec_open,
+	.release	= vcodec_release,
+	.unlocked_ioctl	= vcodec_unlocked_ioctl,
+#if IS_ENABLED(CONFIG_COMPAT)
+	.compat_ioctl	= vcodec_compat_ioctl,
+#endif
+	.mmap		= vcodec_mmap,
+};
+
+static struct miscdevice vcodec_miscdev = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= VCODEC_DEVNAME,
+	.fops	= &vcodec_fops,
+	.mode	= 0660,
+};
+
+static int __init vcodec_core_init(void)
+{
+	int ret;
+
+	vcodec_reset_counters();
+
+	ret = misc_register(&vcodec_miscdev);
+	if (ret) {
+		pr_err("cannot register /dev/%s: %d\n", VCODEC_DEVNAME, ret);
+		return ret;
+	}
+
+	ret = vcodec_vdec_register();
+	if (ret) {
+		pr_err("cannot register the decoder engine: %d\n", ret);
+		goto err_misc;
+	}
+
+	ret = vcodec_venc_register();
+	if (ret) {
+		pr_err("cannot register the encoder engine: %d\n", ret);
+		goto err_vdec;
+	}
+
+	pr_info("/dev/%s ready\n", VCODEC_DEVNAME);
+
+	return 0;
+
+err_vdec:
+	vcodec_vdec_unregister();
+err_misc:
+	misc_deregister(&vcodec_miscdev);
+
+	return ret;
+}
+
+static void __exit vcodec_core_exit(void)
+{
+	vcodec_venc_unregister();
+	vcodec_vdec_unregister();
+	misc_deregister(&vcodec_miscdev);
+}
+
+module_init(vcodec_core_init);
+module_exit(vcodec_core_exit);
+
+MODULE_AUTHOR("Legis, Lu <legis.lu@mediatek.com>");
+MODULE_DESCRIPTION("MediaTek MT6735 video codec hardware service");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/mediatek/vcodec/vcodec-vdec.c b/drivers/misc/mediatek/vcodec/vcodec-vdec.c
new file mode 100644
index 000000000..bf48b93c5
--- /dev/null
+++ b/drivers/misc/mediatek/vcodec/vcodec-vdec.c
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6735 VDEC engine driver.
+ *
+ * The VDEC register windows are mapped into the vendor userspace codec
+ * libraries by the shared core; this driver only owns the clock tree, the
+ * power domains, the optional block reset, the IRQ line and the decoder
+ * ISR validation/acknowledgment sequence.
+ *
+ * Port from Samsung/MediaTek downstream
+ * drivers/misc/mediatek/videocodec/mt6735/videocodec_kernel_driver_D1.c
+ * (Android 6.0.1, kernel 3.18.19, SM-G532M).
+ */
+
+#include <linux/clk.h>
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/reset.h>
+#include <linux/slab.h>
+
+#include "vcodec.h"
+
+/* Downstream videocodec_kernel_driver_D1.c:557 */
+#define VCODEC_VDEC_DEC_DONE		0xA4
+#define VCODEC_VDEC_DEC_DONE_BIT	BIT(16)
+/* Downstream videocodec_kernel_driver_D1.c:582-584 */
+#define VCODEC_VDEC_IRQ_ACK		(BIT(0) | BIT(4))
+#define VCODEC_VDEC_IRQ_CLR		BIT(4)
+/* Downstream videocodec_kernel_driver_D1.c:553 */
+#define VCODEC_VDEC_GCON_VDEC_ACTIVE	BIT(4)
+
+/*
+ * Downstream videocodec_kernel_driver_D1.c:337-338 (VDEC_BASE_PHY 0x16000000,
+ * VDEC_REGION 0x29000) and :2175-2176 (mmap accepts a start anywhere in that
+ * window).  The whole window is published to userspace, including the SMI
+ * LARB1 block at 0x16010000 that the vendor HAL is allowed to map.
+ */
+#define VCODEC_VDEC_MMAP_SIZE		0x29000
+
+struct vcodec_vdec {
+	struct device *dev;
+	void __iomem *vdec;
+	void __iomem *gcon;
+	phys_addr_t gcon_phys;
+	struct clk_bulk_data *clks;
+	int nclks;
+	struct reset_control *rst;
+	int irq;
+	bool registered;
+	struct vcodec_engine engine;
+};
+
+static int vcodec_vdec_power_on(struct vcodec_engine *eng)
+{
+	struct vcodec_vdec *vdec = eng->priv;
+	int ret;
+
+	/*
+	 * Resuming the device also resumes the power domains attached in
+	 * probe, in device-tree order (DIS, then VDE), through the PM
+	 * runtime device links.  Downstream
+	 * videocodec_kernel_driver_D1.c:402-431 powers SCP_SYS_DIS before
+	 * SCP_SYS_VDE.
+	 */
+	ret = pm_runtime_resume_and_get(vdec->dev);
+	if (ret) {
+		dev_err(vdec->dev, "failed to resume VDEC power domains: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * Downstream videocodec_kernel_driver_D1.c:395-397,402-431 enables the
+	 * SCP_SYS_DIS, DISP0_SMI_COMMON, SCP_SYS_VDE, VDEC0_VDEC and
+	 * VDEC1_LARB clocks in this order.
+	 */
+	ret = clk_bulk_prepare_enable(vdec->nclks, vdec->clks);
+	if (ret) {
+		dev_err(vdec->dev, "failed to enable VDEC clocks: %d\n", ret);
+		pm_runtime_put_sync(vdec->dev);
+		return ret;
+	}
+
+	if (vdec->rst) {
+		ret = reset_control_deassert(vdec->rst);
+		if (ret) {
+			dev_err(vdec->dev, "failed to deassert VDEC reset: %d\n", ret);
+			clk_bulk_disable_unprepare(vdec->nclks, vdec->clks);
+			pm_runtime_put_sync(vdec->dev);
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static void vcodec_vdec_power_off(struct vcodec_engine *eng)
+{
+	struct vcodec_vdec *vdec = eng->priv;
+
+	/*
+	 * Downstream videocodec_kernel_driver_D1.c:444-455 disables the same
+	 * clocks in reverse order and never touches the block reset; the
+	 * reset is kept asserted here so that userspace always starts from
+	 * a defined block state on the next power_on.
+	 */
+	if (vdec->rst)
+		reset_control_assert(vdec->rst);
+
+	clk_bulk_disable_unprepare(vdec->nclks, vdec->clks);
+
+	/*
+	 * Drop the power domain references last, after the clock gates are
+	 * off, as downstream does at
+	 * videocodec_kernel_driver_D1.c:451-455.
+	 */
+	pm_runtime_put_sync(vdec->dev);
+}
+
+static int vcodec_vdec_enable_irq(struct vcodec_engine *eng)
+{
+	struct vcodec_vdec *vdec = eng->priv;
+
+	/* Downstream videocodec_kernel_driver_D1.c:855 */
+	enable_irq(vdec->irq);
+
+	return 0;
+}
+
+static void vcodec_vdec_disable_irq(struct vcodec_engine *eng)
+{
+	struct vcodec_vdec *vdec = eng->priv;
+
+	/* Downstream videocodec_kernel_driver_D1.c:848 */
+	disable_irq(vdec->irq);
+}
+
+static const struct vcodec_engine_ops vcodec_vdec_ops = {
+	.power_on = vcodec_vdec_power_on,
+	.power_off = vcodec_vdec_power_off,
+	.enable_irq = vcodec_vdec_enable_irq,
+	.disable_irq = vcodec_vdec_disable_irq,
+};
+
+/*
+ * Downstream videocodec_kernel_driver_D1.c:541-594 (dec_isr): a valid
+ * decoder interrupt requires the VDEC GCON "active" bit to be clear and the
+ * decode-done bit to be set; the status is cleared by first setting bit 0
+ * together with bit 4 and then clearing bit 4 again.
+ */
+static irqreturn_t vcodec_vdec_isr(int irq, void *data)
+{
+	struct vcodec_vdec *vdec = data;
+	u32 cg_status, dec_status;
+
+	cg_status = readl(vdec->gcon);
+	if (cg_status & VCODEC_VDEC_GCON_VDEC_ACTIVE) {
+		dev_err_ratelimited(vdec->dev,
+				    "DEC ISR, VDEC active is not 0x0 (0x%08x)\n",
+				    cg_status);
+		return IRQ_HANDLED;
+	}
+
+	dec_status = readl(vdec->vdec + VCODEC_VDEC_DEC_DONE);
+	if (!(dec_status & VCODEC_VDEC_DEC_DONE_BIT)) {
+		dev_err_ratelimited(vdec->dev,
+				    "DEC ISR, decode done status is not 0x1 (0x%08x)\n",
+				    dec_status);
+		return IRQ_HANDLED;
+	}
+
+	writel(readl(vdec->vdec + VCODEC_VDEC_DEC_DONE) | VCODEC_VDEC_IRQ_ACK,
+	       vdec->vdec + VCODEC_VDEC_DEC_DONE);
+	writel(readl(vdec->vdec + VCODEC_VDEC_DEC_DONE) & ~VCODEC_VDEC_IRQ_CLR,
+	       vdec->vdec + VCODEC_VDEC_DEC_DONE);
+
+	vcodec_engine_irq(&vdec->engine, 0);
+
+	return IRQ_HANDLED;
+}
+
+static int vcodec_vdec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct dev_pm_domain_list *pd_list = NULL;
+	struct vcodec_vdec *vdec;
+	struct resource *res;
+	int ret;
+
+	vdec = devm_kzalloc(dev, sizeof(*vdec), GFP_KERNEL);
+	if (!vdec)
+		return -ENOMEM;
+
+	vdec->dev = dev;
+	platform_set_drvdata(pdev, vdec);
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "vdec");
+	if (!res) {
+		dev_err(dev, "missing \"vdec\" register window\n");
+		return -ENODEV;
+	}
+	vdec->vdec = devm_ioremap_resource(dev, res);
+	if (IS_ERR(vdec->vdec))
+		return dev_err_probe(dev, PTR_ERR(vdec->vdec),
+				     "failed to map \"vdec\" register window\n");
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "gcon");
+	if (!res) {
+		dev_err(dev, "missing \"gcon\" register window\n");
+		return -ENODEV;
+	}
+	vdec->gcon_phys = res->start;
+	vdec->gcon = devm_ioremap_resource(dev, res);
+	if (IS_ERR(vdec->gcon))
+		return dev_err_probe(dev, PTR_ERR(vdec->gcon),
+				     "failed to map \"gcon\" register window\n");
+
+	/* Downstream videocodec_kernel_driver_D1.c:2290-2357 */
+	ret = devm_clk_bulk_get_all(dev, &vdec->clks);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get VDEC clocks\n");
+	if (!ret) {
+		dev_err(dev, "no VDEC clocks described in device tree\n");
+		return -ENODEV;
+	}
+	vdec->nclks = ret;
+
+	/*
+	 * The PM core only attaches a single power domain per device
+	 * (drivers/pmdomain/core.c: genpd_dev_pm_attach() bails out when the
+	 * node has more than one), so attach the DIS and VDE domains of the
+	 * DT node here.  The device links created for them make the
+	 * pm_runtime calls in power_on/power_off drive both domains in DT
+	 * order.  Downstream videocodec_kernel_driver_D1.c:402-455 powers
+	 * and gates SCP_SYS_DIS and SCP_SYS_VDE around the VDEC clocks.
+	 *
+	 * -EEXIST means the node has a single domain, already attached to
+	 * @dev by the platform bus; the pm_runtime calls then drive it
+	 * directly.
+	 */
+	ret = devm_pm_domain_attach_list(dev, NULL, &pd_list);
+	if (ret < 0 && ret != -EEXIST)
+		return dev_err_probe(dev, ret, "failed to attach VDEC power domains\n");
+	if (!ret) {
+		dev_err(dev, "no VDEC power domains described in device tree\n");
+		return -ENODEV;
+	}
+
+	/*
+	 * Downstream has no block reset handling.  The MT6735 vdecsys clock
+	 * driver exports MT6735_VDEC_RST0_VDEC, so use it when the board
+	 * describes it and work without it otherwise.
+	 */
+	vdec->rst = devm_reset_control_get_optional_exclusive(dev, "vdec");
+	if (IS_ERR(vdec->rst))
+		return dev_err_probe(dev, PTR_ERR(vdec->rst),
+				     "failed to get VDEC reset\n");
+
+	vdec->irq = platform_get_irq(pdev, 0);
+	if (vdec->irq < 0)
+		return vdec->irq;
+
+	pm_runtime_enable(dev);
+
+	/* Downstream videocodec_kernel_driver_D1.c:2272-2286 */
+	ret = devm_request_irq(dev, vdec->irq, vcodec_vdec_isr, 0,
+			       dev_name(dev), vdec);
+	if (ret) {
+		dev_err(dev, "failed to request VDEC IRQ %d: %d\n", vdec->irq, ret);
+		goto err_pm;
+	}
+
+	/* The core unmasks the line from its LOCKHW ioctl. */
+	disable_irq(vdec->irq);
+
+	vdec->engine.name = "vdec";
+	vdec->engine.id = VCODEC_ENGINE_DEC;
+	vdec->engine.dev = dev;
+	vdec->engine.ops = &vcodec_vdec_ops;
+	vdec->engine.priv = vdec;
+	vdec->engine.regions[0].phys = vdec->gcon_phys;
+	vdec->engine.regions[0].size = VCODEC_VDEC_MMAP_SIZE;
+	vdec->engine.num_regions = 1;
+
+	ret = vcodec_engine_register(&vdec->engine);
+	if (ret) {
+		dev_err(dev, "failed to register VDEC engine: %d\n", ret);
+		goto err_pm;
+	}
+	vdec->registered = true;
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	return ret;
+}
+
+static void vcodec_vdec_remove(struct platform_device *pdev)
+{
+	struct vcodec_vdec *vdec = platform_get_drvdata(pdev);
+
+	if (vdec->registered) {
+		vcodec_engine_unregister(&vdec->engine);
+		vdec->registered = false;
+	}
+
+	pm_runtime_disable(vdec->dev);
+}
+
+static const struct of_device_id vcodec_vdec_of_match[] = {
+	{ .compatible = "mediatek,mt6735-vdec" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, vcodec_vdec_of_match);
+
+static struct platform_driver vcodec_vdec_driver = {
+	.probe = vcodec_vdec_probe,
+	.remove = vcodec_vdec_remove,
+	.driver = {
+		.name = "mtk-vcodec-vdec",
+		.of_match_table = vcodec_vdec_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+
+int vcodec_vdec_register(void)
+{
+	return platform_driver_register(&vcodec_vdec_driver);
+}
+
+void vcodec_vdec_unregister(void)
+{
+	platform_driver_unregister(&vcodec_vdec_driver);
+}
diff --git a/drivers/misc/mediatek/vcodec/vcodec-venc.c b/drivers/misc/mediatek/vcodec/vcodec-venc.c
new file mode 100644
index 000000000..75cfd9291
--- /dev/null
+++ b/drivers/misc/mediatek/vcodec/vcodec-venc.c
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek MT6735 VENC (video encoder) platform driver.
+ *
+ * Port from Samsung/MediaTek downstream
+ * drivers/misc/mediatek/videocodec/mt6735/videocodec_kernel_driver_D1.c
+ *
+ * The MT6735 encoder register file is programmed by the vendor userspace
+ * codec libraries through the register window that vcodec-core.c exports
+ * through mmap(2).  The kernel side only owns the encoder clocks, the VENC
+ * power domains and the encoder interrupt; there is no codec firmware and
+ * no bitstream/frame register programming here.  See
+ * videocodec_kernel_driver_D1.c:461-540 (power) and :596-681 (enc_isr).
+ */
+
+#include <linux/clk.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+
+#include "vcodec.h"
+
+/*
+ * Register offsets inside the 4 KiB VENC window at 0x17002000.
+ * videocodec_kernel_driver_D1.c:333-334,347-348
+ */
+#define VENC_IRQ_STATUS_OFS	0x05c
+#define VENC_IRQ_ACK_OFS	0x060
+
+/* videocodec_kernel_driver_D1.c:360-365 */
+#define VENC_IRQ_STAT_SPS	0x1
+#define VENC_IRQ_STAT_PPS	0x2
+#define VENC_IRQ_STAT_FRM	0x4
+#define VENC_IRQ_STAT_DRAM	0x8
+#define VENC_IRQ_STAT_PAUSE	0x10
+#define VENC_IRQ_STAT_SWITCH	0x20
+
+/**
+ * struct vcodec_venc - MT6735 encoder engine instance
+ * @dev: platform device of the "mediatek,mt6735-venc" node
+ * @base: mapped VENC register window
+ * @clks: clocks described by the "clocks" property
+ * @nclks: number of entries in @clks
+ * @irq: VENC interrupt number
+ * @engine: engine handed to the shared codec core
+ */
+struct vcodec_venc {
+	struct device *dev;
+	void __iomem *base;
+	struct clk_bulk_data *clks;
+	int nclks;
+	int irq;
+	struct vcodec_engine engine;
+};
+
+static int vcodec_venc_power_on(struct vcodec_engine *eng)
+{
+	struct vcodec_venc *venc = eng->priv;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(venc->dev);
+	if (ret) {
+		dev_err(venc->dev, "failed to power on VENC domains: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_bulk_prepare_enable(venc->nclks, venc->clks);
+	if (ret) {
+		dev_err(venc->dev, "failed to enable VENC clocks: %d\n", ret);
+		pm_runtime_put_sync(venc->dev);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void vcodec_venc_power_off(struct vcodec_engine *eng)
+{
+	struct vcodec_venc *venc = eng->priv;
+
+	clk_bulk_disable_unprepare(venc->nclks, venc->clks);
+	pm_runtime_put_sync(venc->dev);
+}
+
+static int vcodec_venc_enable_irq(struct vcodec_engine *eng)
+{
+	struct vcodec_venc *venc = eng->priv;
+
+	enable_irq(venc->irq);
+
+	return 0;
+}
+
+static void vcodec_venc_disable_irq(struct vcodec_engine *eng)
+{
+	struct vcodec_venc *venc = eng->priv;
+
+	disable_irq(venc->irq);
+}
+
+/*
+ * Acknowledge one status bit.  The downstream driver writes a single bit
+ * per access (videocodec_kernel_driver_D1.c:640-661), so the write is not
+ * merged into one register update here either.
+ */
+static void vcodec_venc_ack(struct vcodec_venc *venc, u32 status)
+{
+	writel(status, venc->base + VENC_IRQ_ACK_OFS);
+}
+
+static irqreturn_t vcodec_venc_isr(int irq, void *data)
+{
+	struct vcodec_venc *venc = data;
+	struct vcodec_engine *eng = &venc->engine;
+	u32 status;
+
+	/* videocodec_kernel_driver_D1.c:637 */
+	status = readl(venc->base + VENC_IRQ_STATUS_OFS);
+
+	if (!vcodec_engine_is_locked(eng)) {
+		/*
+		 * Nobody owns the encoder: the interrupt is spurious.  Clear
+		 * every status bit so the level-triggered line drops, exactly
+		 * as videocodec_kernel_driver_D1.c:621-633 does, and do not
+		 * wake any waiter because there is none.
+		 */
+		dev_err_ratelimited(venc->dev,
+				    "VENC interrupt without a hardware owner, status 0x%08x\n",
+				    status);
+		vcodec_venc_ack(venc, VENC_IRQ_STAT_PAUSE);
+		vcodec_venc_ack(venc, VENC_IRQ_STAT_SWITCH);
+		vcodec_venc_ack(venc, VENC_IRQ_STAT_DRAM);
+		vcodec_venc_ack(venc, VENC_IRQ_STAT_SPS);
+		vcodec_venc_ack(venc, VENC_IRQ_STAT_PPS);
+		vcodec_venc_ack(venc, VENC_IRQ_STAT_FRM);
+
+		return IRQ_HANDLED;
+	}
+
+	switch (vcodec_engine_get_driver_type(eng)) {
+	case VCODEC_DRIVER_TYPE_H264_ENC:
+		/* videocodec_kernel_driver_D1.c:637-662 */
+		if (status & VENC_IRQ_STAT_PAUSE)
+			vcodec_venc_ack(venc, VENC_IRQ_STAT_PAUSE);
+		if (status & VENC_IRQ_STAT_SWITCH)
+			vcodec_venc_ack(venc, VENC_IRQ_STAT_SWITCH);
+		if (status & VENC_IRQ_STAT_DRAM)
+			vcodec_venc_ack(venc, VENC_IRQ_STAT_DRAM);
+		if (status & VENC_IRQ_STAT_SPS)
+			vcodec_venc_ack(venc, VENC_IRQ_STAT_SPS);
+		if (status & VENC_IRQ_STAT_PPS)
+			vcodec_venc_ack(venc, VENC_IRQ_STAT_PPS);
+		if (status & VENC_IRQ_STAT_FRM)
+			vcodec_venc_ack(venc, VENC_IRQ_STAT_FRM);
+		break;
+	case VCODEC_DRIVER_TYPE_HEVC_ENC:
+		/*
+		 * videocodec_kernel_driver_D1.c:663-665 keeps the status
+		 * untouched for HEVC and only logs.  The vendor HEVC library
+		 * acknowledges the encoder through its mmap'ed window.
+		 */
+		dev_err_ratelimited(venc->dev,
+				    "VENC HEVC interrupt not acknowledged by the kernel, status 0x%08x\n",
+				    status);
+		break;
+	default:
+		/* videocodec_kernel_driver_D1.c:666-669 */
+		dev_err_ratelimited(venc->dev,
+				    "VENC interrupt from invalid lock holder type %u, status 0x%08x\n",
+				    vcodec_engine_get_driver_type(eng), status);
+		break;
+	}
+
+	/* videocodec_kernel_driver_D1.c:671 */
+	vcodec_engine_irq(eng, status);
+
+	return IRQ_HANDLED;
+}
+
+static const struct vcodec_engine_ops vcodec_venc_ops = {
+	.power_on = vcodec_venc_power_on,
+	.power_off = vcodec_venc_power_off,
+	.enable_irq = vcodec_venc_enable_irq,
+	.disable_irq = vcodec_venc_disable_irq,
+};
+
+static int vcodec_venc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct dev_pm_domain_list *pd_list = NULL;
+	struct vcodec_venc *venc;
+	struct resource *res;
+	int ret;
+
+	venc = devm_kzalloc(dev, sizeof(*venc), GFP_KERNEL);
+	if (!venc)
+		return -ENOMEM;
+
+	venc->dev = dev;
+	platform_set_drvdata(pdev, venc);
+
+	venc->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(venc->base))
+		return dev_err_probe(dev, PTR_ERR(venc->base),
+				     "failed to map VENC registers\n");
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return dev_err_probe(dev, -ENODEV, "missing VENC register resource\n");
+
+	venc->nclks = devm_clk_bulk_get_all(dev, &venc->clks);
+	if (venc->nclks < 0)
+		return dev_err_probe(dev, venc->nclks, "failed to get VENC clocks\n");
+
+	/*
+	 * The node describes two power domains (DIS then VEN).  The bus only
+	 * attaches a single domain, so attach the list explicitly: the device
+	 * links created here make the pm_runtime_get/put calls in
+	 * vcodec_venc_power_on()/vcodec_venc_power_off() drive both MTCMOS
+	 * domains.  -EEXIST means the bus already attached the sole domain.
+	 */
+	ret = devm_pm_domain_attach_list(dev, NULL, &pd_list);
+	if (ret < 0 && ret != -EEXIST)
+		return dev_err_probe(dev, ret, "failed to attach VENC power domains\n");
+	if (!ret)
+		return dev_err_probe(dev, -ENODEV,
+				     "no VENC power domains described in device tree\n");
+
+	venc->irq = platform_get_irq(pdev, 0);
+	if (venc->irq < 0)
+		return venc->irq;
+
+	ret = devm_request_irq(dev, venc->irq, vcodec_venc_isr, 0,
+			       dev_name(dev), venc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request VENC irq\n");
+
+	/*
+	 * videocodec_kernel_driver_D1.c:2279-2287 requests the encoder IRQ at
+	 * probe time and masks it straight away; LOCKHW enables it on demand.
+	 */
+	disable_irq(venc->irq);
+
+	pm_runtime_enable(dev);
+
+	venc->engine.name = "venc";
+	venc->engine.id = VCODEC_ENGINE_ENC;
+	venc->engine.dev = dev;
+	venc->engine.ops = &vcodec_venc_ops;
+	venc->engine.priv = venc;
+	venc->engine.regions[0].phys = res->start;
+	venc->engine.regions[0].size = resource_size(res);
+	venc->engine.num_regions = 1;
+
+	ret = vcodec_engine_register(&venc->engine);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to register VENC engine\n");
+		pm_runtime_disable(dev);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void vcodec_venc_remove(struct platform_device *pdev)
+{
+	struct vcodec_venc *venc = platform_get_drvdata(pdev);
+
+	vcodec_engine_unregister(&venc->engine);
+	pm_runtime_disable(&pdev->dev);
+}
+
+static const struct of_device_id vcodec_venc_of_match[] = {
+	{ .compatible = "mediatek,mt6735-venc" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, vcodec_venc_of_match);
+
+static struct platform_driver vcodec_venc_driver = {
+	.probe = vcodec_venc_probe,
+	.remove = vcodec_venc_remove,
+	.driver = {
+		.name = "mtk-vcodec-venc",
+		.of_match_table = vcodec_venc_of_match,
+	},
+};
+
+static bool vcodec_venc_registered;
+
+int vcodec_venc_register(void)
+{
+	int ret;
+
+	ret = platform_driver_register(&vcodec_venc_driver);
+	if (ret)
+		return ret;
+
+	vcodec_venc_registered = true;
+
+	return 0;
+}
+
+void vcodec_venc_unregister(void)
+{
+	if (!vcodec_venc_registered)
+		return;
+
+	platform_driver_unregister(&vcodec_venc_driver);
+	vcodec_venc_registered = false;
+}
diff --git a/drivers/misc/mediatek/vcodec/vcodec.h b/drivers/misc/mediatek/vcodec/vcodec.h
new file mode 100644
index 000000000..8e44773c8
--- /dev/null
+++ b/drivers/misc/mediatek/vcodec/vcodec.h
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek MT6735 video codec shared hardware service core.
+ *
+ * The MT6735 VENC/VDEC engines are register-programmed by the vendor
+ * userspace codec libraries; the kernel side owns power, clocks, the
+ * engine interrupts and the hardware ownership lock.  This header is the
+ * contract between the shared core (vcodec-core.c) and the two engine
+ * platform drivers (vcodec-vdec.c, vcodec-venc.c).
+ *
+ * Port from Samsung/MediaTek downstream
+ * drivers/misc/mediatek/videocodec/mt6735/videocodec_kernel_driver_D1.c
+ */
+
+#ifndef _MTK_VCODEC_MT6735_H_
+#define _MTK_VCODEC_MT6735_H_
+
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <linux/wait.h>
+
+/* Register windows a single engine may expose through mmap(2). */
+#define VCODEC_MAX_MMAP_REGIONS		4
+
+/*
+ * Values of the driver-type argument of the ioctl ABI.  The full enum
+ * (all codecs) lives in include/uapi/linux/vcodec.h; the engines only need
+ * the two encoder types they have to recognise in their interrupt path.
+ */
+#define VCODEC_DRIVER_TYPE_H264_ENC	5
+#define VCODEC_DRIVER_TYPE_HEVC_ENC	28
+
+enum vcodec_engine_id {
+	VCODEC_ENGINE_DEC = 0,
+	VCODEC_ENGINE_ENC,
+	VCODEC_ENGINE_MAX,
+};
+
+struct vcodec_engine;
+
+/**
+ * struct vcodec_engine_ops - hardware operations of one codec engine
+ * @power_on: enable the engine clock tree and power domain.  Called with
+ *            the core engine mutex held, in process context.
+ * @power_off: undo @power_on.
+ * @enable_irq: unmask the engine interrupt.
+ * @disable_irq: mask the engine interrupt and wait for a running handler.
+ *
+ * All callbacks are mandatory.  They must be idempotent-safe in the sense
+ * that the core only calls them on a state transition (see the core's
+ * ->powered/->irq_enabled bookkeeping).
+ */
+struct vcodec_engine_ops {
+	int (*power_on)(struct vcodec_engine *eng);
+	void (*power_off)(struct vcodec_engine *eng);
+	int (*enable_irq)(struct vcodec_engine *eng);
+	void (*disable_irq)(struct vcodec_engine *eng);
+};
+
+/**
+ * struct vcodec_mmap_region - physical register window exposed to userspace
+ * @phys: physical base address
+ * @size: window size in bytes
+ */
+struct vcodec_mmap_region {
+	phys_addr_t phys;
+	resource_size_t size;
+};
+
+/**
+ * struct vcodec_engine - one MT6735 codec engine
+ *
+ * The fields above the "core private" marker are filled in by the engine
+ * platform driver before vcodec_engine_register().  Everything below the
+ * marker is owned by vcodec-core.c.
+ */
+struct vcodec_engine {
+	const char *name;
+	enum vcodec_engine_id id;
+	struct device *dev;
+	const struct vcodec_engine_ops *ops;
+	void *priv;
+
+	struct vcodec_mmap_region regions[VCODEC_MAX_MMAP_REGIONS];
+	unsigned int num_regions;
+
+	/* core private */
+	struct list_head node;
+	/* protects the fields below and serialises engine power/lock state */
+	struct mutex lock;
+	wait_queue_head_t hwlock_wq;
+	wait_queue_head_t isr_wq;
+	/* protects the interrupt completion counters below (hardirq) */
+	spinlock_t irq_lock;
+	bool registered;
+	bool hw_locked;
+	bool powered;
+	bool irq_enabled;
+	phys_addr_t owner;
+	u32 driver_type;
+	unsigned long isr_seq;
+	u32 irq_status;
+};
+
+int vcodec_engine_register(struct vcodec_engine *eng);
+void vcodec_engine_unregister(struct vcodec_engine *eng);
+
+/**
+ * vcodec_engine_irq() - report a completed hardware job
+ * @eng: engine that raised the interrupt
+ * @status: raw interrupt status word captured by the engine ISR
+ *
+ * Called from the engine hardirq handler after it has validated and
+ * acknowledged the hardware interrupt.  Wakes VCODEC_WAITISR waiters.
+ */
+void vcodec_engine_irq(struct vcodec_engine *eng, u32 status);
+
+bool vcodec_engine_is_locked(struct vcodec_engine *eng);
+u32 vcodec_engine_get_driver_type(struct vcodec_engine *eng);
+
+/* Implemented by vcodec-vdec.c / vcodec-venc.c, called by the core. */
+int vcodec_vdec_register(void);
+void vcodec_vdec_unregister(void);
+int vcodec_venc_register(void);
+void vcodec_venc_unregister(void);
+
+#endif /* _MTK_VCODEC_MT6735_H_ */
diff --git a/include/uapi/linux/vcodec.h b/include/uapi/linux/vcodec.h
new file mode 100644
index 000000000..d6cf6c202
--- /dev/null
+++ b/include/uapi/linux/vcodec.h
@@ -0,0 +1,227 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * Copyright (C) 2015 MediaTek Inc.
+ *
+ * MediaTek MT6735 video codec hardware service ABI.
+ *
+ * The vendor codec userspace libraries program the VENC/VDEC register
+ * windows themselves; this ABI only covers the services the kernel does
+ * provide: hardware ownership (lock/unlock), power/user accounting,
+ * interrupt wait and the register-window mappings.
+ *
+ * The command numbers, their encodings and the driver-type enumeration
+ * are ROM compatible and must never be renumbered.  Port from
+ * Samsung/MediaTek downstream
+ * drivers/misc/mediatek/videocodec/mt6735/videocodec_kernel_driver.h:19-52
+ * and drivers/misc/mediatek/videocodec/include/val_types_public.h:135-170.
+ */
+
+#ifndef _UAPI_LINUX_VCODEC_H
+#define _UAPI_LINUX_VCODEC_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define MFV_IOC_MAGIC		'M'
+
+/* Control messages; payload pointers are passed as 32-bit integers. */
+#define MFV_TEST_CMD			_IO(MFV_IOC_MAGIC, 0x00)
+#define MFV_INIT_CMD			_IO(MFV_IOC_MAGIC, 0x01)
+#define MFV_DEINIT_CMD			_IO(MFV_IOC_MAGIC, 0x02)
+#define MFV_SET_CMD_CMD			_IOW(MFV_IOC_MAGIC, 0x03, __u32)
+#define MFV_SET_PWR_CMD			_IOW(MFV_IOC_MAGIC, 0x04, __u32)
+#define MFV_SET_ISR_CMD			_IOW(MFV_IOC_MAGIC, 0x05, __u32)
+#define MFV_ALLOC_MEM_CMD		_IOW(MFV_IOC_MAGIC, 0x06, __u32)
+#define MFV_FREE_MEM_CMD		_IOW(MFV_IOC_MAGIC, 0x07, __u32)
+#define MFV_MAKE_PMEM_TO_NONCACHED	_IOW(MFV_IOC_MAGIC, 0x08, __u32)
+#define MFV_ALLOC_INT_MEM_CMD		_IOW(MFV_IOC_MAGIC, 0x09, __u32)
+#define MFV_FREE_INT_MEM_CMD		_IOW(MFV_IOC_MAGIC, 0x0a, __u32)
+#define VCODEC_WAITISR			_IOW(MFV_IOC_MAGIC, 0x0b, __u32)
+#define VCODEC_LOCKHW			_IOW(MFV_IOC_MAGIC, 0x0d, __u32)
+#define VCODEC_PMEM_FLUSH		_IOW(MFV_IOC_MAGIC, 0x10, __u32)
+#define VCODEC_PMEM_CLEAN		_IOW(MFV_IOC_MAGIC, 0x11, __u32)
+#define VCODEC_INC_SYSRAM_USER		_IOW(MFV_IOC_MAGIC, 0x13, __u32)
+#define VCODEC_DEC_SYSRAM_USER		_IOW(MFV_IOC_MAGIC, 0x14, __u32)
+#define VCODEC_INC_ENC_EMI_USER		_IOW(MFV_IOC_MAGIC, 0x15, __u32)
+#define VCODEC_DEC_ENC_EMI_USER		_IOW(MFV_IOC_MAGIC, 0x16, __u32)
+#define VCODEC_INC_DEC_EMI_USER		_IOW(MFV_IOC_MAGIC, 0x17, __u32)
+#define VCODEC_DEC_DEC_EMI_USER		_IOW(MFV_IOC_MAGIC, 0x18, __u32)
+#define VCODEC_INITHWLOCK		_IOW(MFV_IOC_MAGIC, 0x20, __u32)
+#define VCODEC_DEINITHWLOCK		_IOW(MFV_IOC_MAGIC, 0x21, __u32)
+#define VCODEC_ALLOC_NON_CACHE_BUFFER	_IOW(MFV_IOC_MAGIC, 0x22, __u32)
+#define VCODEC_FREE_NON_CACHE_BUFFER	_IOW(MFV_IOC_MAGIC, 0x23, __u32)
+#define VCODEC_SET_THREAD_ID		_IOW(MFV_IOC_MAGIC, 0x24, __u32)
+#define VCODEC_SET_SYSRAM_INFO		_IOW(MFV_IOC_MAGIC, 0x25, __u32)
+#define VCODEC_GET_SYSRAM_INFO		_IOW(MFV_IOC_MAGIC, 0x26, __u32)
+#define VCODEC_INC_PWR_USER		_IOW(MFV_IOC_MAGIC, 0x27, __u32)
+#define VCODEC_DEC_PWR_USER		_IOW(MFV_IOC_MAGIC, 0x28, __u32)
+#define VCODEC_GET_CPU_LOADING_INFO	_IOW(MFV_IOC_MAGIC, 0x29, __u32)
+#define VCODEC_GET_CORE_LOADING		_IOW(MFV_IOC_MAGIC, 0x30, __u32)
+#define VCODEC_GET_CORE_NUMBER		_IOW(MFV_IOC_MAGIC, 0x31, __u32)
+#define VCODEC_SET_CPU_OPP_LIMIT	_IOW(MFV_IOC_MAGIC, 0x32, __u32)
+#define VCODEC_UNLOCKHW			_IOW(MFV_IOC_MAGIC, 0x33, __u32)
+#define VCODEC_MB			_IOW(MFV_IOC_MAGIC, 0x34, __u32)
+
+/*
+ * Driver types.  Order and values are the downstream ones, see
+ * VAL_DRIVER_TYPE_T; the vendor libraries pass these numbers verbatim.
+ */
+enum vcodec_driver_type {
+	VCODEC_DRV_TYPE_NONE = 0,
+	VCODEC_DRV_TYPE_MP4_ENC,
+	VCODEC_DRV_TYPE_MP4_DEC,
+	VCODEC_DRV_TYPE_H263_ENC,
+	VCODEC_DRV_TYPE_H263_DEC,
+	VCODEC_DRV_TYPE_H264_ENC = 5,
+	VCODEC_DRV_TYPE_H264_DEC = 6,
+	VCODEC_DRV_TYPE_SORENSON_SPARK_DEC,
+	VCODEC_DRV_TYPE_VC1_SP_DEC,
+	VCODEC_DRV_TYPE_RV9_DEC,
+	VCODEC_DRV_TYPE_MP1_MP2_DEC,
+	VCODEC_DRV_TYPE_XVID_DEC,
+	VCODEC_DRV_TYPE_DIVX4_DIVX5_DEC,
+	VCODEC_DRV_TYPE_VC1_MP_WMV9_DEC,
+	VCODEC_DRV_TYPE_RV8_DEC,
+	VCODEC_DRV_TYPE_WMV7_DEC,
+	VCODEC_DRV_TYPE_WMV8_DEC,
+	VCODEC_DRV_TYPE_AVS_DEC,
+	VCODEC_DRV_TYPE_DIVX_3_11_DEC,
+	VCODEC_DRV_TYPE_H264_DEC_MAIN,
+	VCODEC_DRV_TYPE_H264_DEC_MAIN_CABAC,
+	VCODEC_DRV_TYPE_VP8_DEC,
+	VCODEC_DRV_TYPE_MP2_DEC,
+	VCODEC_DRV_TYPE_VP9_DEC,
+	VCODEC_DRV_TYPE_VP8_ENC,
+	VCODEC_DRV_TYPE_VC1_ADV_DEC,
+	VCODEC_DRV_TYPE_VC1_DEC,
+	VCODEC_DRV_TYPE_JPEG_ENC,
+	VCODEC_DRV_TYPE_HEVC_ENC = 28,
+	VCODEC_DRV_TYPE_HEVC_DEC,
+	VCODEC_DRV_TYPE_H264_ENC_LIVEPHOTO,
+	VCODEC_DRV_TYPE_MMDVFS,
+	VCODEC_DRV_TYPE_MAX = 0xffffffff,
+};
+
+/* Maximum number of status words returned for one completed hardware job. */
+#define VCODEC_IRQ_STATUS_MAX_NUM	16
+/* Maximum number of cooperating threads an instance may register. */
+#define VCODEC_THREAD_MAX_NUM		16
+
+/**
+ * struct vcodec_hw_lock - argument of VCODEC_LOCKHW / VCODEC_UNLOCKHW
+ * @pv_handle: handle of the codec instance; identifies the lock owner
+ * @handle_size: size of the handle structure
+ * @pv_lock: lock descriptor, unused by the kernel
+ * @timeout_ms: how long to wait for the engine, 0 means driver default
+ * @pv_reserved: reserved, unused
+ * @reserved_size: size of the reserved structure
+ * @driver_type: one of &enum vcodec_driver_type, selects the engine
+ * @secure_inst: secure instance, do not expose its interrupt to Linux
+ */
+struct vcodec_hw_lock {
+	__u64 pv_handle;
+	__u32 handle_size;
+	__u64 pv_lock;
+	__u32 timeout_ms;
+	__u64 pv_reserved;
+	__u32 reserved_size;
+	__u32 driver_type;
+	__u8 secure_inst;
+	__u8 pad[7];
+};
+
+/**
+ * struct vcodec_power - argument of VCODEC_INC_PWR_USER / VCODEC_DEC_PWR_USER
+ * @pv_handle: handle of the codec instance
+ * @handle_size: size of the handle structure
+ * @driver_type: one of &enum vcodec_driver_type
+ * @enable: power user count enable flag
+ * @pv_reserved: reserved, unused
+ * @reserved_size: size of the reserved structure
+ */
+struct vcodec_power {
+	__u64 pv_handle;
+	__u32 handle_size;
+	__u32 driver_type;
+	__u8 enable;
+	__u8 pad[7];
+	__u64 pv_reserved;
+	__u32 reserved_size;
+};
+
+/**
+ * struct vcodec_isr - argument of VCODEC_WAITISR
+ * @pv_handle: handle of the codec instance, must currently own the engine
+ * @handle_size: size of the handle structure
+ * @driver_type: one of &enum vcodec_driver_type
+ * @pv_isr_function: userspace ISR callback, unused by the kernel
+ * @pv_reserved: reserved, unused
+ * @reserved_size: size of the reserved structure
+ * @timeout_ms: how long to wait for the interrupt, 0 fails immediately
+ * @irq_status_num: number of status words the caller can accept
+ * @irq_status: status words read from the hardware by the kernel ISR
+ */
+struct vcodec_isr {
+	__u64 pv_handle;
+	__u32 handle_size;
+	__u32 driver_type;
+	__u64 pv_isr_function;
+	__u64 pv_reserved;
+	__u32 reserved_size;
+	__u32 timeout_ms;
+	__u32 irq_status_num;
+	__u32 irq_status[VCODEC_IRQ_STATUS_MAX_NUM];
+};
+
+/**
+ * struct vcodec_core_loading - argument of VCODEC_GET_CORE_LOADING
+ * @cpu_id: CPU to query, 0 .. nr_cpu_ids - 1
+ * @loading: CPU load in percent since the previous query
+ */
+struct vcodec_core_loading {
+	__s32 cpu_id;
+	__s32 loading;
+};
+
+/**
+ * struct vcodec_cpu_opp_limit - argument of VCODEC_SET_CPU_OPP_LIMIT
+ * @limited_freq: frequency ceiling in kHz
+ * @limited_cpu: CPU mask the limit applies to
+ * @enable: 0 disables the limit, 1 enables it
+ */
+struct vcodec_cpu_opp_limit {
+	__s32 limited_freq;
+	__s32 limited_cpu;
+	__s32 enable;
+};
+
+/**
+ * struct vcodec_cpu_loading_info - argument of VCODEC_GET_CPU_LOADING_INFO
+ * @cpu_idle_time: unused, always 0
+ * @thread_cpu_time: unused, always 0
+ * @sched_clock: value of the kernel scheduler clock
+ * @inst_count: number of engines currently owned by userspace
+ */
+struct vcodec_cpu_loading_info {
+	__u64 cpu_idle_time;
+	__u64 thread_cpu_time;
+	__u64 sched_clock;
+	__u32 inst_count;
+	__u32 pad;
+};
+
+/**
+ * struct vcodec_thread_id - argument of VCODEC_SET_THREAD_ID
+ * @tid1: first thread id
+ * @tid2: second thread id
+ * @thread_num: number of valid entries in @thread_id
+ * @thread_id: cooperating thread ids
+ */
+struct vcodec_thread_id {
+	__u32 tid1;
+	__u32 tid2;
+	__u32 thread_num;
+	__u32 thread_id[VCODEC_THREAD_MAX_NUM];
+};
+
+#endif /* _UAPI_LINUX_VCODEC_H */
