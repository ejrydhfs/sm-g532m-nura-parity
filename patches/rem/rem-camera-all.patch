+/* Index of the lowest set bit; my_get_pow_idx(), camera_isp_D1.c:867-880. */
+static int mtk_isp_pow_idx(u32 value)
+{
+	int i;
+
+	for (i = 0; i < 32; i++)
+		if ((value >> i) & 0x1)
+			return i;
+	return 32;
+}
