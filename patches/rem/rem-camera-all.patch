+static int mtk_smi_larb_config_port_mt6735(struct device *dev)
+{
+	struct mtk_smi_larb *larb = dev_get_drvdata(dev);
+	const u8 *ostd = larb->larb_gen->ostd ?
+			 larb->larb_gen->ostd[larb->larbid] : NULL;
