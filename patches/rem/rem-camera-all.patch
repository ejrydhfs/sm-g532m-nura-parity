@@ -0,0 +1,697 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * camotp - read-only camera calibration dump for the Samsung grandpplte.
+ *
+ * Source selection:
+ *   imx219    /sys/bus/nvmem/devices/imx219-eeprom<n>/nvmem (or --file)
+ *   s5k5e3yx  /sys/bus/i2c/devices/<bus>-00xx/otp        (or --sysfs/--raw)
