+ *   llvm-objdump -d --triple=thumbv7-none-eabi libcam.halsensor.so
  */
 
 #ifndef __MTK_SENINF_REGS_H__
@@ -35,6 +45,10 @@
  * 0x400 apart: SENINFn_IRQ_INTSTA is ISP_ADDR + 0x4128/0x4528/0x4928/0x4D28
