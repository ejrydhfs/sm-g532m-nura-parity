+	for (i = 0; i < SMI_LARB_PORT_NR_MAX && ostd && ostd[i]; i++)
+		writel_relaxed(ostd[i], larb->base + SMI_LARB_OSTDL_PORTx(i));
+
+	return 0;
+}
