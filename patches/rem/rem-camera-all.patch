+static enum mtk_isp_irq_dom mtk_isp_dom_of_dma(unsigned int dma)
+{
+	switch (dma) {
+	case _imgo_:
+	case _rrzo_:
+		return MTK_ISP_IRQ_CAM;
+	case _imgo_d_:
+	case _rrzo_d_:
+		return MTK_ISP_IRQ_CAM_D;
+	case _camsv_imgo_:
+		return MTK_ISP_IRQ_CAMSV;
+	case _camsv2_imgo_:
+		return MTK_ISP_IRQ_CAMSV2;
+	default:
+		return MTK_ISP_IRQ_CAM;
+	}
+}
