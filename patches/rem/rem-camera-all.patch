+static enum mtk_isp_channel mtk_isp_channel_of_dma(unsigned int dma)
+{
+	switch (dma) {
+	case _imgo_:
+	case _rrzo_:
+		return MTK_ISP_CH_P1;
+	case _imgo_d_:
+	case _rrzo_d_:
+		return MTK_ISP_CH_P1_D;
+	case _camsv_imgo_:
+		return MTK_ISP_CH_CAMSV;
+	case _camsv2_imgo_:
+		return MTK_ISP_CH_CAMSV_D;
+	default:
+		return MTK_ISP_CH_P1;
