+	if (larb->larbid == 2) {
+		reg = readl_relaxed(larb->base + SMI_LARB_CMD_THRT_CON);
+		reg &= ~BIT(27);
+		writel_relaxed(reg, larb->base + SMI_LARB_CMD_THRT_CON);
+	}
