+/* ------------------------------------------------------------------ */
+/* Capture flow                                                        */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Register addresses used below, all offsets from 0x15000000 (the address
+ * space ISP_REG_STRUCT.Addr uses, camera_isp_D1.c:3387-3455):
+ *
+ *   0x4414  TG_VF_CON      stream on/off, bit 0
+ *                         (libcamdrv.so writeReg(0x4414, 1) @0xcc32-0xcc42)
+ *   0x40f0  IMGO_FBC       frame buffer control
+ *   0x40f4  RRZO_FBC
+ *   0x40b4  CQ0C base      head of the CQ0C ring
+ *   0xf308  IMGO_XSIZE     inner (TPIPE) DMA destination width
+ *   0xf30c  IMGO_YSIZE
+ *   0xf310  IMGO_STRIDE
+ */
+#define CAM_TG_VF_CON		0x4414
+#define CAM_IMGO_FBC		0x40f0
+#define CAM_CQ0C_BASE		0x40b4
+#define CAM_IMGO_XSIZE		0xf308
+#define CAM_IMGO_YSIZE		0xf30c
+#define CAM_IMGO_STRIDE		0xf310
+
+struct capture_cfg {
+	uint64_t frames;
+	unsigned int buffers;
+	uint32_t width;
+	uint32_t height;
+	uint32_t stride;
+	uint32_t timeout;
+	int key;
+	bool quiet;
+};
+
+static int cap_write(struct camdrv *d, uint32_t addr, uint32_t val,
+		     const char *what)
+{
+	int ret = camdrv_write_reg(d, addr, val);
+
+	if (ret) {
+		fprintf(stderr, "camservice: write %s (0x%08x) failed: %s\n",
+			what, addr, camdrv_errname(ret));
+		return ret;
+	}
+	return 0;
+}
