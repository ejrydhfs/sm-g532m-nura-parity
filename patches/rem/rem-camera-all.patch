+	u32 interval_us;
+	u32 compensation_us;
+	u64 t_ns;
+	u32 fcnt;
+};
+
+struct mtk_isp_edbuf {
+	u32 process_id;
+	u32 caller_id;
+	s32 dup_cq_idx;
+	s32 state;
+};
+
+struct mtk_isp_edmgr {
+	u32 process_id;
+	u32 caller_id;
+	s32 dup_cq_idx;
+	s32 dequed_num;
+};
+
+struct mtk_isp_file {
+	struct mtk_isp *isp;
+	pid_t pid;
+};
+
+struct mtk_isp {
+	struct device *dev;
+	void __iomem *isp;		/* 0x15004000, 0x9000 */
+	void __iomem *cam;		/* 0x15000000, 0x10000 */
+	phys_addr_t isp_phys;
+	phys_addr_t cam_phys;
+	int irq_cam;
+	int irq_camsv;
+	int irq_camsv2;
+	struct miscdevice misc;
+
+	struct clk *clks[6];
+	int clk_num;
+
+	struct mutex power_lock;
+	int open_count;
+
+	spinlock_t rtbc_lock;		/* real-time buffer rings */
+	spinlock_t reg_lock;
+	spinlock_t irq_lock;
+	spinlock_t hold_lock;
+	spinlock_t userkey_lock;
+	spinlock_t edbuf_lock;
+	spinlock_t scen_lock;
+
+	wait_queue_head_t waitq;
