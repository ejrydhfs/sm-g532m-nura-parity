+	if (ret || written != sizeof(cmd)) {
+		wmt_err("bgw desense tx failed (%d, %u)\n", ret, written);
+		return -EIO;
+	}
+
+	ret = wmt_core_rx(evt, sizeof(wmt_bgw_ds_evt), &read);
+	if (ret || read != sizeof(wmt_bgw_ds_evt) ||
+	    memcmp(evt, wmt_bgw_ds_evt, sizeof(wmt_bgw_ds_evt))) {
