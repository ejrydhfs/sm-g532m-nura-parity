+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Offline self-test for the STP_DBG chunk parser.
+ *
+ * The test builds synthetic records with the exact framing the kernel
+ * produces (see stp_dbg_parse.h) and drives the parser the same way the
+ * netlink client does, so `make check` exercises the real code path without
+ * a device.
+ *
+ * Copyright (C) 2024 The Nura project
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "stp_dbg_parse.h"
+
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+
+struct capture {
+	unsigned long chunks;
+	size_t last_len;
+	unsigned long long total;
+	unsigned int sum;
+	int fail_on_chunk;	/* abort on this chunk index (0 = never) */
+};
+
+static int capture_cb(const unsigned char *data, size_t len, void *ctx)
+{
+	struct capture *cap = ctx;
+	size_t i;
+
+	cap->chunks++;
+	cap->last_len = len;
+	cap->total += len;
+	for (i = 0; i < len; i++)
+		cap->sum = (cap->sum * 31) + data[i];
+
+	if (cap->fail_on_chunk && cap->chunks == (unsigned long)cap->fail_on_chunk)
+		return 42;
+
+	return 0;
+}
+
+static size_t mk_frame(unsigned char *dst, const unsigned char *payload,
+		       size_t len)
+{
+	dst[0] = STP_DBG_FRAME_MAGIC0;
+	dst[1] = STP_DBG_FRAME_MAGIC1;
+	dst[2] = STP_DBG_FRAME_MAGIC2;
+	dst[3] = (unsigned char)(len & 0xff);
+	dst[4] = (unsigned char)((len >> 8) & 0xff);
+	if (len && payload)
+		memcpy(dst + STP_DBG_FRAME_HDR, payload, len);
+	return STP_DBG_FRAME_HDR + len;
+}
+
+static unsigned int sum_bytes(const unsigned char *data, size_t len)
+{
+	unsigned int sum = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++)
+		sum = (sum * 31) + data[i];
+
+	return sum;
+}
+
+#define CHECK(cond, msg)						\
+	do {								\
+		if (!(cond)) {						\
+			fprintf(stderr, "FAIL: %s (%s:%d)\n", msg,	\
+				__FILE__, __LINE__);			\
+			return 1;					\
+		}							\
+	} while (0)
+
+static int test_single_frame(void)
+{
+	const unsigned char payload[] = { 0xde, 0xad, 0xbe, 0xef };
+	unsigned char frame[64];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	size_t n;
+	int ret;
+
+	n = mk_frame(frame, payload, sizeof(payload));
+	stp_dbg_parser_init(&p);
+	ret = stp_dbg_parser_feed(&p, frame, n, capture_cb, &cap);
+	CHECK(ret == 0, "single frame accepted");
+	CHECK(cap.chunks == 1, "single frame yields one chunk");
+	CHECK(cap.last_len == sizeof(payload), "single frame length");
+	CHECK(cap.sum == sum_bytes(payload, sizeof(payload)), "payload intact");
+	CHECK(p.chunks == 1 && p.bytes == sizeof(payload), "parser counters");
+	CHECK(stp_dbg_parser_finish(&p) == 0, "stream ends cleanly");
+	return 0;
+}
+
+static int test_two_frames_in_one_buffer(void)
+{
+	unsigned char payload_a[8], payload_b[3];
+	unsigned char buf[128];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	size_t off = 0;
+	int ret;
+
+	memset(payload_a, 0xa5, sizeof(payload_a));
+	memset(payload_b, 0x5a, sizeof(payload_b));
+
+	off += mk_frame(buf + off, payload_a, sizeof(payload_a));
+	off += mk_frame(buf + off, payload_b, sizeof(payload_b));
+
+	stp_dbg_parser_init(&p);
+	ret = stp_dbg_parser_feed(&p, buf, off, capture_cb, &cap);
+	CHECK(ret == 0, "two frames accepted");
+	CHECK(cap.chunks == 2, "two frames yield two chunks");
+	CHECK(cap.total == sizeof(payload_a) + sizeof(payload_b), "total bytes");
+	CHECK(p.len == 0, "no residue after two frames");
+	return 0;
+}
+
+static int test_split_frame(void)
+{
+	const unsigned char payload[] = { 1, 2, 3, 4, 5, 6, 7 };
+	unsigned char frame[64];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	size_t n;
+	int ret;
+
+	n = mk_frame(frame, payload, sizeof(payload));
+	stp_dbg_parser_init(&p);
+
+	ret = stp_dbg_parser_feed(&p, frame, 3, capture_cb, &cap);
+	CHECK(ret == 0 && cap.chunks == 0, "partial header buffered");
+	ret = stp_dbg_parser_feed(&p, frame + 3, n - 3, capture_cb, &cap);
+	CHECK(ret == 0 && cap.chunks == 1, "frame completed across feeds");
+	CHECK(cap.sum == sum_bytes(payload, sizeof(payload)), "split payload");
+	return 0;
+}
+
+static int test_max_chunk_byte_at_a_time(void)
+{
+	static unsigned char payload[STP_DBG_CHUNK_MAX];
+	static unsigned char frame[STP_DBG_CHUNK_MAX + STP_DBG_FRAME_HDR];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	size_t i, n;
+	int ret;
+
+	for (i = 0; i < sizeof(payload); i++)
+		payload[i] = (unsigned char)(i * 7 + 3);
+
+	n = mk_frame(frame, payload, sizeof(payload));
+	stp_dbg_parser_init(&p);
+	for (i = 0; i < n; i++) {
+		ret = stp_dbg_parser_feed(&p, frame + i, 1, capture_cb, &cap);
+		CHECK(ret == 0, "byte-at-a-time feed");
+	}
+
+	CHECK(cap.chunks == 1, "max-size frame yields one chunk");
+	CHECK(cap.last_len == STP_DBG_CHUNK_MAX, "max chunk length");
+	CHECK(cap.sum == sum_bytes(payload, sizeof(payload)), "max chunk data");
+	return 0;
+}
+
+static int test_bad_magic(void)
+{
+	unsigned char frame[16];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	int ret;
+
+	memset(frame, 0, sizeof(frame));
+	frame[0] = '[';
+	frame[1] = 'X';
+	frame[2] = ']';
+
+	stp_dbg_parser_init(&p);
+	ret = stp_dbg_parser_feed(&p, frame, sizeof(frame), capture_cb, &cap);
+	CHECK(ret == -EPROTO, "bad magic rejected");
+	CHECK(cap.chunks == 0, "no chunk from bad magic");
+	return 0;
+}
+
+static int test_oversized_length(void)
+{
+	unsigned char frame[16];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	int ret;
+
+	memset(frame, 0, sizeof(frame));
+	frame[0] = STP_DBG_FRAME_MAGIC0;
+	frame[1] = STP_DBG_FRAME_MAGIC1;
+	frame[2] = STP_DBG_FRAME_MAGIC2;
+	frame[3] = (STP_DBG_CHUNK_MAX + 1) & 0xff;
+	frame[4] = (STP_DBG_CHUNK_MAX + 1) >> 8;
+
+	stp_dbg_parser_init(&p);
+	ret = stp_dbg_parser_feed(&p, frame, sizeof(frame), capture_cb, &cap);
+	CHECK(ret == -EPROTO, "oversized declared length rejected");
+	CHECK(p.len == 0 || p.len <= sizeof(p.buf), "buffer unaffected");
+	return 0;
+}
+
+static int test_truncated_stream(void)
+{
+	const unsigned char payload[] = { 9, 8, 7, 6, 5 };
+	unsigned char frame[64];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	size_t n;
+	int ret;
+
+	n = mk_frame(frame, payload, sizeof(payload));
+	stp_dbg_parser_init(&p);
+
+	ret = stp_dbg_parser_feed(&p, frame, n - 2, capture_cb, &cap);
+	CHECK(ret == 0 && cap.chunks == 0, "truncated frame buffered");
+	CHECK(stp_dbg_parser_finish(&p) == -EPROTO, "truncated stream flagged");
+	return 0;
+}
+
+static int test_zero_length_chunk(void)
+{
+	unsigned char frame[16];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	size_t n;
+	int ret;
+
+	n = mk_frame(frame, NULL, 0);
+	CHECK(n == STP_DBG_FRAME_HDR, "zero-length frame size");
+
+	stp_dbg_parser_init(&p);
+	ret = stp_dbg_parser_feed(&p, frame, n, capture_cb, &cap);
+	CHECK(ret == 0, "zero-length frame accepted");
+	CHECK(cap.chunks == 1 && cap.last_len == 0, "zero-length chunk");
+	return 0;
+}
+
+static int test_many_small_frames(void)
+{
+	unsigned char payload[7];
+	unsigned char frame[32];
+	struct stp_dbg_parser p;
+	struct capture cap = { };
+	unsigned int i, sum = 0;
+	size_t n;
+	int ret;
+
+	memset(payload, 0x33, sizeof(payload));
+	n = mk_frame(frame, payload, sizeof(payload));
+
+	stp_dbg_parser_init(&p);
+	for (i = 0; i < 300; i++) {
+		size_t b;
+
+		ret = stp_dbg_parser_feed(&p, frame, n, capture_cb, &cap);
+		CHECK(ret == 0, "many-frame feed");
+		for (b = 0; b < sizeof(payload); b++)
+			sum = (sum * 31) + payload[b];
+	}
+
+	CHECK(cap.chunks == 300, "all frames parsed");
+	CHECK(cap.sum == sum, "frame contents");
+	return 0;
+}
+
+static int test_callback_abort(void)
+{
+	const unsigned char payload[] = { 1, 2, 3 };
+	unsigned char frame[32];
+	struct stp_dbg_parser p;
+	struct capture cap = { .fail_on_chunk = 1 };
+	size_t n;
+	int ret;
+
+	n = mk_frame(frame, payload, sizeof(payload));
+	stp_dbg_parser_init(&p);
+	ret = stp_dbg_parser_feed(&p, frame, n, capture_cb, &cap);
+	CHECK(ret == 42, "callback error propagated");
+	return 0;
+}
+
+int stp_dbg_selftest(void)
+{
+	static const struct {
+		const char *name;
+		int (*fn)(void);
+	} tests[] = {
+		{ "single frame", test_single_frame },
+		{ "two frames", test_two_frames_in_one_buffer },
+		{ "split frame", test_split_frame },
+		{ "max chunk byte-at-a-time", test_max_chunk_byte_at_a_time },
+		{ "bad magic", test_bad_magic },
+		{ "oversized length", test_oversized_length },
+		{ "truncated stream", test_truncated_stream },
+		{ "zero-length chunk", test_zero_length_chunk },
+		{ "many small frames", test_many_small_frames },
+		{ "callback abort", test_callback_abort },
+	};
+	size_t i;
+	int failed = 0;
+
+	for (i = 0; i < ARRAY_SIZE(tests); i++) {
+		if (tests[i].fn()) {
+			fprintf(stderr, "selftest: %s FAILED\n", tests[i].name);
+			failed++;
+		} else {
+			printf("selftest: %s ok\n", tests[i].name);
+		}
+	}
+
+	if (failed) {
+		fprintf(stderr, "selftest: %d/%zu checks failed\n", failed,
+			ARRAY_SIZE(tests));
+		return 1;
+	}
+
+	printf("selftest: all %zu checks passed\n", ARRAY_SIZE(tests));
+	return 0;
+}
diff --git a/tools/mediatek/wcn/stp_dbg/stp_dbg.c b/tools/mediatek/wcn/stp_dbg/stp_dbg.c
new file mode 100644
index 000000000..4ad709360
--- /dev/null
+++ b/tools/mediatek/wcn/stp_dbg/stp_dbg.c
@@ -0,0 +1,544 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * stp_dbg - receive MediaTek WCN firmware coredumps over the STP_DBG
+ * generic-netlink family and write them as a readable hex dump.
+ *
+ * Copyright (C) 2024 The Nura project
+ *
+ * Kernel side: drivers/misc/mediatek/connectivity/wmt/stp_dbg.c and
+ * stp_btm.c.  The ABI is the Samsung/MTK downstream one:
+ *
+ *	family name : "STP_DBG"		(stp_dbg.c:83)
+ *	version     : 1
+ *	commands    : 1 STP_DBG_COMMAND_BIND, 2 STP_DBG_COMMAND_RESET
+ *	attributes  : 1 STP_DBG_ATTR_MSG
+ *
+ * A consumer binds once (command 1) and from then on receives command 2
+ * messages whose STP_DBG_ATTR_MSG payload is one '[M]' framed chunk.  The
+ * chunks are parsed by stp_dbg_parse.c; `--selftest` exercises that parser
+ * offline.
+ *
+ * Usage:
+ *	stp_dbg [-o FILE] [-n CHUNKS] [-t TIMEOUT_MS] [-v]
+ *	stp_dbg --selftest
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <linux/genetlink.h>
+#include <linux/netlink.h>
+
+#include "stp_dbg_parse.h"
+
+#ifndef NLA_DATA
+#define NLA_DATA(na) ((void *)((char *)(na) + NLA_HDRLEN))
+#endif
+
+/* Must match the kernel definitions (stp_dbg.c:41-55). */
+#define STP_DBG_FAMILY_NAME	"STP_DBG"
+#define STP_DBG_FAMILY_VERSION	1
+#define STP_DBG_CMD_BIND	1
+#define STP_DBG_CMD_RESET	2
+#define STP_DBG_ATTR_MSG	1
+
+#define NL_BUFSIZE		8192
+
+int stp_dbg_selftest(void);
+
+static volatile sig_atomic_t stop_requested;
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	stop_requested = 1;
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"usage: %s [-o FILE] [-n CHUNKS] [-t TIMEOUT_MS] [-v]\n"
+		"       %s --selftest\n"
+		"\n"
+		"  -o FILE        write the hex dump to FILE (default: stdout)\n"
+		"  -n CHUNKS      stop after CHUNKS coredump chunks\n"
+		"  -t TIMEOUT_MS  netlink receive timeout in milliseconds "
+		"(default 500)\n"
+		"  -v             print one line per received chunk to stderr\n"
+		"  --selftest     run the chunk parser self-test and exit\n",
+		prog, prog);
+}
+
+/*
+ * Generic netlink helpers
+ */
+
+static int nl_send(int fd, const void *buf, size_t len)
+{
+	struct sockaddr_nl dst = { .nl_family = AF_NETLINK };
+	struct iovec iov = { .iov_base = (void *)buf, .iov_len = len };
+	struct msghdr msg = {
+		.msg_name = &dst,
+		.msg_namelen = sizeof(dst),
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+	};
+	ssize_t ret;
+
+	do {
+		ret = sendmsg(fd, &msg, 0);
+	} while (ret < 0 && errno == EINTR);
+
+	return ret < 0 ? -errno : 0;
+}
+
+/* Parse the attributes of a generic netlink message looking for @want and
+ * copy at most @size bytes of its payload.  Returns the payload length, or
+ * -ENOENT.
+ */
+static int find_attr(const struct nlmsghdr *nlh, int want, void *out,
+		     size_t size)
+{
+	int remaining = (int)nlh->nlmsg_len - NLMSG_HDRLEN - GENL_HDRLEN;
+	const struct nlattr *na;
+
+	if (remaining < 0)
+		return -EPROTO;
+
+	na = (const struct nlattr *)((const char *)NLMSG_DATA(nlh) +
+				     GENL_HDRLEN);
+
+	while (remaining >= (int)sizeof(*na) && na->nla_len >= sizeof(*na) &&
+	       (int)na->nla_len <= remaining) {
+		int type = na->nla_type & NLA_TYPE_MASK;
+		size_t payload = na->nla_len - NLA_HDRLEN;
+
+		if (type == want) {
+			if (payload > size)
+				payload = size;
+			memcpy(out, NLA_DATA(na), payload);
+			return (int)payload;
+		}
+
+		remaining -= NLA_ALIGN(na->nla_len);
+		na = (const struct nlattr *)((const char *)na +
+					     NLA_ALIGN(na->nla_len));
+	}
+
+	return -ENOENT;
+}
+
+static int genl_resolve_family(int fd, const char *name, uint16_t *family)
+{
+	char req[NLMSG_SPACE(GENL_HDRLEN) + 256];
+	char reply[NL_BUFSIZE];
+	struct nlmsghdr *nlh = (struct nlmsghdr *)req;
+	struct genlmsghdr *ghdr;
+	struct nlattr *na;
+	size_t name_len = strlen(name) + 1;
+	int len, ret;
+	ssize_t n;
+
+	memset(req, 0, sizeof(req));
+	nlh->nlmsg_len = NLMSG_LENGTH(GENL_HDRLEN);
+	nlh->nlmsg_type = GENL_ID_CTRL;
+	nlh->nlmsg_flags = NLM_F_REQUEST;
+	nlh->nlmsg_seq = 1;
+	nlh->nlmsg_pid = (uint32_t)getpid();
+
+	ghdr = NLMSG_DATA(nlh);
+	ghdr->cmd = CTRL_CMD_GETFAMILY;
+	ghdr->version = 1;
+
+	na = (struct nlattr *)((char *)NLMSG_DATA(nlh) + GENL_HDRLEN);
+	na->nla_type = CTRL_ATTR_FAMILY_NAME;
+	na->nla_len = NLA_HDRLEN + (uint16_t)name_len;
+	memcpy(NLA_DATA(na), name, name_len);
+
+	nlh->nlmsg_len = NLMSG_LENGTH(GENL_HDRLEN) + NLA_ALIGN(na->nla_len);
+
+	ret = nl_send(fd, nlh, nlh->nlmsg_len);
+	if (ret)
+		return ret;
+
+	n = recv(fd, reply, sizeof(reply), 0);
+	if (n < 0)
+		return -errno;
+
+	len = (int)n;
+	for (nlh = (struct nlmsghdr *)reply; NLMSG_OK(nlh, len);
+	     nlh = NLMSG_NEXT(nlh, len)) {
+		uint16_t id = 0;
+
+		if (nlh->nlmsg_type == NLMSG_ERROR) {
+			const struct nlmsgerr *err = NLMSG_DATA(nlh);
+
+			return err->error ? err->error : -ENOENT;
+		}
+
+		if (nlh->nlmsg_len < NLMSG_HDRLEN + GENL_HDRLEN)
+			continue;
+
+		ret = find_attr(nlh, CTRL_ATTR_FAMILY_ID, &id, sizeof(id));
+		if (ret == (int)sizeof(id)) {
+			*family = id;
+			return 0;
+		}
+	}
+
+	return -ENOENT;
+}
+
+static int genl_wait_ack(int fd, uint32_t seq)
+{
+	char reply[NL_BUFSIZE];
+	struct nlmsghdr *nlh;
+	int len;
+	ssize_t n;
+
+	n = recv(fd, reply, sizeof(reply), 0);
+	if (n < 0)
+		return -errno;
+
+	len = (int)n;
+	for (nlh = (struct nlmsghdr *)reply; NLMSG_OK(nlh, len);
+	     nlh = NLMSG_NEXT(nlh, len)) {
+		if (nlh->nlmsg_type != NLMSG_ERROR)
+			continue;
+		if (nlh->nlmsg_seq != seq)
+			continue;
+
+		return ((const struct nlmsgerr *)NLMSG_DATA(nlh))->error;
+	}
+
+	return -ENOENT;
+}
+
+static int genl_bind(int fd, uint16_t family)
+{
+	char req[NLMSG_SPACE(GENL_HDRLEN)];
+	struct nlmsghdr *nlh = (struct nlmsghdr *)req;
+	struct genlmsghdr *ghdr;
+	int ret;
+
+	memset(req, 0, sizeof(req));
+	nlh->nlmsg_len = NLMSG_LENGTH(GENL_HDRLEN);
+	nlh->nlmsg_type = family;
+	nlh->nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK;
+	nlh->nlmsg_seq = 2;
+	nlh->nlmsg_pid = (uint32_t)getpid();
+
+	ghdr = NLMSG_DATA(nlh);
+	ghdr->cmd = STP_DBG_CMD_BIND;
+	ghdr->version = STP_DBG_FAMILY_VERSION;
+
+	ret = nl_send(fd, nlh, nlh->nlmsg_len);
+	if (ret)
+		return ret;
+
+	return genl_wait_ack(fd, nlh->nlmsg_seq);
+}
+
+static int open_netlink(void)
+{
+	struct sockaddr_nl local = { .nl_family = AF_NETLINK };
+	struct timeval tv = { .tv_sec = 0, .tv_usec = 500 * 1000 };
+	int fd;
+
+	fd = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_GENERIC);
+	if (fd < 0)
+		return -errno;
+
+	if (bind(fd, (struct sockaddr *)&local, sizeof(local)) < 0) {
+		int err = -errno;
+
+		close(fd);
+		return err;
+	}
+
+	/* Used to poll the stop flag; handled in the receive loop. */
+	setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	return fd;
+}
+
+/*
+ * Dump writer
+ */
+
+struct dump_ctx {
+	FILE *out;
+	unsigned long long offset;
+	unsigned long long chunks;
+	unsigned long long limit;
+	bool verbose;
+};
+
+static void hexdump_line(FILE *out, unsigned long long off,
+			 const unsigned char *data, size_t len)
+{
+	char ascii[17];
+	size_t i;
+
+	memset(ascii, 0, sizeof(ascii));
+	fprintf(out, "%08llx  ", off);
+
+	for (i = 0; i < 16; i++) {
+		if (i < len) {
+			unsigned char c = data[i];
+
+			fprintf(out, "%02x ", c);
+			ascii[i] = (c >= 0x20 && c < 0x7f) ? (char)c : '.';
+		} else {
+			fprintf(out, "   ");
+			ascii[i] = ' ';
+		}
+		if (i == 7)
+			fputc(' ', out);
+	}
+
+	fprintf(out, " |%s|\n", ascii);
+}
+
+static int dump_chunk(const unsigned char *data, size_t len, void *ctx)
+{
+	struct dump_ctx *d = ctx;
+	size_t done = 0;
+
+	d->chunks++;
+
+	if (d->verbose)
+		fprintf(stderr, "chunk %llu: %zu bytes at 0x%08llx\n",
+			d->chunks - 1, len, d->offset);
+
+	fprintf(d->out, "\n== chunk %llu, %zu bytes, offset 0x%08llx ==\n",
+		d->chunks - 1, len, d->offset);
+
+	while (done < len) {
+		size_t n = len - done;
+
+		if (n > 16)
+			n = 16;
+		hexdump_line(d->out, d->offset + done, data + done, n);
+		done += n;
+	}
+
+	d->offset += len;
+
+	if (d->limit && d->chunks >= d->limit)
+		stop_requested = 1;
+
+	return 0;
+}
+
+/*
+ * Main
+ */
+
+static int run_client(const char *out_path, unsigned long long limit,
+		      unsigned int timeout_ms, bool verbose)
+{
+	struct stp_dbg_parser parser;
+	struct dump_ctx dump = {
+		.out = stdout,
+		.limit = limit,
+		.verbose = verbose,
+	};
+	char buf[NL_BUFSIZE];
+	uint16_t family = 0;
+	int fd, ret;
+
+	fd = open_netlink();
+	if (fd < 0) {
+		fprintf(stderr, "stp_dbg: netlink socket: %s\n",
+			strerror(-fd));
+		return 1;
+	}
+
+	{
+		struct timeval tv = {
+			.tv_sec = timeout_ms / 1000,
+			.tv_usec = (timeout_ms % 1000) * 1000,
+		};
+
+		setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	}
+
+	ret = genl_resolve_family(fd, STP_DBG_FAMILY_NAME, &family);
+	if (ret) {
+		fprintf(stderr, "stp_dbg: family \"%s\" not available: %s\n",
+			STP_DBG_FAMILY_NAME, strerror(-ret));
+		close(fd);
+		return 1;
+	}
+
+	ret = genl_bind(fd, family);
+	if (ret) {
+		fprintf(stderr, "stp_dbg: binding to \"%s\" failed: %s\n",
+			STP_DBG_FAMILY_NAME, strerror(-ret));
+		close(fd);
+		return 1;
+	}
+
+	if (out_path && strcmp(out_path, "-")) {
+		dump.out = fopen(out_path, "w");
+		if (!dump.out) {
+			fprintf(stderr, "stp_dbg: %s: %s\n", out_path,
+				strerror(errno));
+			close(fd);
+			return 1;
+		}
+	}
+
+	fprintf(dump.out,
+		"# STP_DBG dump, family \"%s\" version %d\n"
+		"# records are '[M]' | u16 length | data\n",
+		STP_DBG_FAMILY_NAME, STP_DBG_FAMILY_VERSION);
+
+	stp_dbg_parser_init(&parser);
+
+	while (!stop_requested) {
+		struct nlmsghdr *nlh;
+		ssize_t n;
+		int len;
+
+		n = recv(fd, buf, sizeof(buf), 0);
+		if (n < 0) {
+			if (errno == EAGAIN || errno == EWOULDBLOCK ||
+			    errno == EINTR)
+				continue;
+			fprintf(stderr, "stp_dbg: recv: %s\n", strerror(errno));
+			ret = 1;
+			goto out;
+		}
+
+		len = (int)n;
+		for (nlh = (struct nlmsghdr *)buf; NLMSG_OK(nlh, len);
+		     nlh = NLMSG_NEXT(nlh, len)) {
+			const struct genlmsghdr *ghdr;
+			unsigned char payload[STP_DBG_CHUNK_MAX +
+					      STP_DBG_FRAME_HDR];
+			int plen;
+
+			if (nlh->nlmsg_type == NLMSG_ERROR) {
+				const struct nlmsgerr *err = NLMSG_DATA(nlh);
+
+				if (err->error) {
+					fprintf(stderr,
+						"stp_dbg: netlink error: %s\n",
+						strerror(-err->error));
+					ret = 1;
+					goto out;
+				}
+				continue;
+			}
+
+			if (nlh->nlmsg_type != family)
+				continue;
+			if (nlh->nlmsg_len <
+			    NLMSG_HDRLEN + GENL_HDRLEN)
+				continue;
+
+			ghdr = NLMSG_DATA(nlh);
+			if (ghdr->cmd != STP_DBG_CMD_RESET ||
+			    ghdr->version != STP_DBG_FAMILY_VERSION)
+				continue;
+
+			plen = find_attr(nlh, STP_DBG_ATTR_MSG, payload,
+					 sizeof(payload));
+			if (plen < 0) {
+				fprintf(stderr,
+					"stp_dbg: message without %s: %s\n",
+					"STP_DBG_ATTR_MSG", strerror(-plen));
+				continue;
+			}
+
+			ret = stp_dbg_parser_feed(&parser, payload,
+						  (size_t)plen, dump_chunk,
+						  &dump);
+			if (ret) {
+				fprintf(stderr,
+					"stp_dbg: bad chunk stream: %s\n",
+					ret == -EPROTO ? "framing error" :
+					strerror(-ret));
+				ret = 2;
+				goto out;
+			}
+		}
+	}
+
+	ret = 0;
+	if (!stop_requested && parser.len) {
+		fprintf(stderr, "stp_dbg: stream ended mid-record (%zu bytes)\n",
+			parser.len);
+		ret = 2;
+	}
+
+out:
+	fprintf(stderr,
+		"stp_dbg: %llu chunks, %llu bytes written\n",
+		dump.chunks, dump.offset);
+	fprintf(dump.out, "\n# end of dump\n");
+
+	if (dump.out != stdout)
+		fclose(dump.out);
+	close(fd);
+	return ret;
+}
+
+int main(int argc, char **argv)
+{
+	static const struct option long_opts[] = {
+		{ "selftest", no_argument, NULL, 'S' },
+		{ "help", no_argument, NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	const char *out_path = "-";
+	unsigned long long limit = 0;
+	unsigned int timeout_ms = 500;
+	bool verbose = false;
+	int opt;
+
+	while ((opt = getopt_long(argc, argv, "ho:n:t:v", long_opts,
+				  NULL)) != -1) {
+		switch (opt) {
+		case 'o':
+			out_path = optarg;
+			break;
+		case 'n':
+			limit = strtoull(optarg, NULL, 0);
+			break;
+		case 't':
+			timeout_ms = (unsigned int)strtoul(optarg, NULL, 0);
+			break;
+		case 'v':
+			verbose = true;
+			break;
+		case 'S':
+			return stp_dbg_selftest();
+		case 'h':
+			usage(argv[0]);
+			return 0;
+		default:
+			usage(argv[0]);
+			return 1;
+		}
+	}
+
+	if (timeout_ms < 10)
+		timeout_ms = 10;
+
+	signal(SIGINT, on_signal);
+	signal(SIGTERM, on_signal);
+
+	return run_client(out_path, limit, timeout_ms, verbose);
+}
diff --git a/tools/mediatek/wcn/stp_dbg/stp_dbg_parse.c b/tools/mediatek/wcn/stp_dbg/stp_dbg_parse.c
new file mode 100644
index 000000000..a67393a73
--- /dev/null
+++ b/tools/mediatek/wcn/stp_dbg/stp_dbg_parse.c
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Parser for the MediaTek WCN STP_DBG coredump chunk stream.
+ *
+ * Copyright (C) 2024 The Nura project
+ *
+ * Ported from the framing used by the Samsung/MTK downstream driver,
+ * btm_core.c:186-242 (_stp_btm_put_emi_dump_to_nl()):
+ *
+ *	static UINT8 tmp[SUB_PKT_SIZE + SUB_PKT_HEADER];
+ *	tmp[0] = '['; tmp[1] = 'M'; tmp[2] = ']';
+ *	osal_memcpy(&tmp[3], &len, 2);
+ *	osal_memcpy(&tmp[5], data, len);
+ *	stp_dbg_nl_send(&tmp[0], 2, len + 5);
+ *
+ * All arithmetic is bounded by STP_DBG_CHUNK_MAX so a corrupt stream can
+ * never make the parser write past its buffer.
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include "stp_dbg_parse.h"
+
+void stp_dbg_parser_init(struct stp_dbg_parser *p)
+{
+	memset(p, 0, sizeof(*p));
+}
+
+/* Consume every complete record currently buffered. */
+static int stp_dbg_parser_drain(struct stp_dbg_parser *p, stp_dbg_chunk_cb cb,
+				void *ctx)
+{
+	while (p->len >= STP_DBG_FRAME_HDR) {
+		unsigned int declared;
+		size_t frame_len;
+		int ret;
+
+		if (p->buf[0] != STP_DBG_FRAME_MAGIC0 ||
+		    p->buf[1] != STP_DBG_FRAME_MAGIC1 ||
+		    p->buf[2] != STP_DBG_FRAME_MAGIC2)
+			return -EPROTO;
+
+		declared = (unsigned int)p->buf[3] |
+			   ((unsigned int)p->buf[4] << 8);
+		if (declared > STP_DBG_CHUNK_MAX)
+			return -EPROTO;
+
+		frame_len = STP_DBG_FRAME_HDR + declared;
+		if (p->len < frame_len)
+			return 0;	/* need more bytes */
+
+		ret = cb(p->buf + STP_DBG_FRAME_HDR, declared, ctx);
+		if (ret)
+			return ret;
+
+		p->chunks++;
+		p->bytes += declared;
+
+		p->len -= frame_len;
+		memmove(p->buf, p->buf + frame_len, p->len);
+	}
+
+	return 0;
+}
+
+int stp_dbg_parser_feed(struct stp_dbg_parser *p, const void *data, size_t len,
+			stp_dbg_chunk_cb cb, void *ctx)
+{
+	const unsigned char *cur = data;
+	int ret;
+
+	while (len) {
+		size_t space = sizeof(p->buf) - p->len;
+		size_t take = len < space ? len : space;
+
+		memcpy(p->buf + p->len, cur, take);
+		p->len += take;
+		cur += take;
+		len -= take;
+
+		ret = stp_dbg_parser_drain(p, cb, ctx);
+		if (ret)
+			return ret;
+
+		/* A full buffer that still does not hold a complete record is
+		 * only possible for a corrupt length, which drain() rejects
+		 * before we get here.  Keep the guard anyway.
+		 */
+		if (p->len == sizeof(p->buf))
+			return -EPROTO;
+	}
+
+	return 0;
+}
+
+int stp_dbg_parser_finish(struct stp_dbg_parser *p)
+{
+	return p->len ? -EPROTO : 0;
+}
diff --git a/tools/mediatek/wcn/stp_dbg/stp_dbg_parse.h b/tools/mediatek/wcn/stp_dbg/stp_dbg_parse.h
new file mode 100644
index 000000000..fafd947dc
--- /dev/null
+++ b/tools/mediatek/wcn/stp_dbg/stp_dbg_parse.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Parser for the MediaTek WCN STP_DBG coredump chunk stream.
+ *
+ * The kernel pushes coredump records as generic-netlink messages of the
+ * "STP_DBG" family (command STP_DBG_COMMAND_RESET = 2, attribute
+ * STP_DBG_ATTR_MSG = 1).  Each attribute payload is one record:
+ *
+ *	'[' 'M' ']' | u16 length (little endian) | length bytes of data
+ *
+ * with length <= 1024 (drivers/misc/mediatek/connectivity/wmt/stp_btm.c,
+ * downstream btm_core.c:186-242 _stp_btm_put_emi_dump_to_nl()).
+ */
+
+#ifndef STP_DBG_PARSE_H
+#define STP_DBG_PARSE_H
+
+#include <stddef.h>
+
+#define STP_DBG_FRAME_MAGIC0	'['
+#define STP_DBG_FRAME_MAGIC1	'M'
+#define STP_DBG_FRAME_MAGIC2	']'
+#define STP_DBG_FRAME_HDR	5	/* '[' 'M' ']' + u16 length */
+#define STP_DBG_CHUNK_MAX	1024
+
+/* Callback invoked once per complete chunk.  @len is zero for a valid
+ * zero-length record.  Must return 0 to continue, non-zero to abort.
+ */
+typedef int (*stp_dbg_chunk_cb)(const unsigned char *data, size_t len,
+				void *ctx);
+
+struct stp_dbg_parser {
+	unsigned char buf[STP_DBG_CHUNK_MAX + STP_DBG_FRAME_HDR];
+	size_t len;
+	unsigned long chunks;
+	unsigned long long bytes;
+};
+
+void stp_dbg_parser_init(struct stp_dbg_parser *p);
+
+/* Feed raw netlink attribute data.  Returns 0, -EPROTO for a framing error
+ * (bad magic, declared length above STP_DBG_CHUNK_MAX) or the callback's
+ * non-zero return value.
+ */
+int stp_dbg_parser_feed(struct stp_dbg_parser *p, const void *data, size_t len,
+			stp_dbg_chunk_cb cb, void *ctx);
+
+/* Returns 0 when the stream ended on a chunk boundary, -EPROTO if a partial
+ * record is still buffered.
+ */
+int stp_dbg_parser_finish(struct stp_dbg_parser *p);
+
+#endif /* STP_DBG_PARSE_H */
