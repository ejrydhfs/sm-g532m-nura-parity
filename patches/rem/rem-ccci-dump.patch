diff --git a/tools/mediatek/ccci/Makefile b/tools/mediatek/ccci/Makefile
new file mode 100644
index 000000000..88509afc0
--- /dev/null
+++ b/tools/mediatek/ccci/Makefile
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# ccci-dump, the CCCI modem dump recorder/decoder.
+#
+# This is a host build with the system compiler.  It consumes no kernel
+# header and no proprietary blob; ccci_exrec.h is a cited copy of the wire
+# layout in drivers/misc/mediatek/ccci/ccci_exception.h (see that file and
+# the ports in drivers/misc/mediatek/eccci/ccci_core.h).
+#
+#   make            build build/bin/ccci-dump
+#   make check      help, argument validation and no-device behaviour
+#   make clean
+
+CC ?= gcc
+CFLAGS ?= -O2
+CFLAGS += -Wall -Wextra -std=gnu11
+CPPFLAGS +=
+
+BUILD := build
+OBJ := $(BUILD)/obj
+BIN := $(BUILD)/bin
+
+SRCS := ccci-dump.c
+OBJS := $(SRCS:%.c=$(OBJ)/%.o)
+
+.PHONY: all check clean
+
+all: $(BIN)/ccci-dump
+
+$(OBJ)/%.o: %.c ccci_exrec.h
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+$(BIN)/ccci-dump: $(OBJS)
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -o $@ $(OBJS) $(LDFLAGS) $(LDLIBS)
+
+# No device is assumed.  The tool must explain a missing interface instead of
+# pretending it recorded something.
+check: all
+	@$(BIN)/ccci-dump -h >/dev/null
+	@if $(BIN)/ccci-dump -D $(BUILD)/does-not-exist >/dev/null 2>&1; then \
+		echo "check: decoding a missing file unexpectedly succeeded"; \
+		exit 1; \
+	fi
+	@if $(BIN)/ccci-dump -m 9 >/dev/null 2>&1; then \
+		echo "check: modem 9 was accepted"; \
+		exit 1; \
+	fi
+	@echo "check: help, input validation and error paths OK"
+
+clean:
+	rm -rf $(BUILD)
diff --git a/tools/mediatek/ccci/ccci-dump.c b/tools/mediatek/ccci/ccci-dump.c
new file mode 100644
index 000000000..aa53cda37
--- /dev/null
+++ b/tools/mediatek/ccci/ccci-dump.c
@@ -0,0 +1,529 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ccci-dump - record and decode the MediaTek CCCI modem exception dump.
+ *
+ * Interfaces consumed (both are implemented by this kernel tree):
+ *
+ *  - /dev/ccci_dump, the per-modem dump ring exposed by
+ *    drivers/misc/mediatek/ccci_util/ccci_util_log.c:269-435.
+ *    A read returns a text snapshot of every dump ring of the selected
+ *    modem.  The modem is selected with
+ *    CCCI_UTIL_IOC_SET_MD/_GET_MD (ccci_util_log.c:274-275):
+ *
+ *        #define CCCI_UTIL_IOC_MAGIC   'C'
+ *        #define CCCI_UTIL_IOC_SET_MD  _IOW('C', 0x40, __u32)
+ *        #define CCCI_UTIL_IOC_GET_MD  _IOR('C', 0x41, __u32)
+ *
+ *  - debugfs, created by the CCCI core and the exception engine:
+ *      /sys/kernel/debug/ccci/mdN/exception_packet  raw MD_EX_REC_OK packet
+ *                                                   (16 byte ccci_header +
+ *                                                    512 byte EX_LOG_T)
+ *      /sys/kernel/debug/ccci/mdN/exception_stage   textual state
+ *      /sys/kernel/debug/ccci/mdN/exception_dump    text snapshot
+ *    The mdN directory is shared with the util driver, whose "dump" file is
+ *    the ring view, hence the "exception_" prefix.
+ *
+ * The record layout is in ccci_exrec.h (a cited copy of the kernel header).
+ * Nothing here is synthesised: when an interface is absent or empty the tool
+ * reports it and exits non-zero instead of printing a made-up record.
+ *
+ * Ported from the Samsung/MTK 3.18 userspace AEE/meta dump convention; the
+ * ROM kernel side is aee_dump_ccci_debug_info() (vmlinux.elf 0xc0508b54) and
+ * aed_md_exception_api() (vmlinux.elf 0xc0628298).
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <getopt.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "ccci_exrec.h"
+
+#define DUMP_DEV		"/dev/ccci_dump"
+#define DEBUGFS_DEFAULT		"/sys/kernel/debug"
+
+#define CCCI_UTIL_IOC_MAGIC	'C'
+#define CCCI_UTIL_IOC_SET_MD	_IOW(CCCI_UTIL_IOC_MAGIC, 0x40, uint32_t)
+#define CCCI_UTIL_IOC_GET_MD	_IOR(CCCI_UTIL_IOC_MAGIC, 0x41, uint32_t)
+
+#define MBUF_MAX		(8u * 1024u * 1024u)
+#define DEBUGFS_READ_MAX	(256u * 1024u)
+
+struct mbuf {
+	uint8_t *data;
+	size_t len;
+};
+
+static void die(const char *fmt, ...)
+{
+	va_list ap;
+
+	fputs("ccci-dump: ", stderr);
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+}
+
+static int mbuf_reserve(struct mbuf *b, size_t want)
+{
+	size_t cap = b->len ? b->len : 4096;
+	uint8_t *n;
+
+	if (want <= b->len)
+		return 0;
+	if (want > MBUF_MAX) {
+		die("dump larger than %u bytes, refusing", MBUF_MAX);
+		return -1;
+	}
+	while (cap < want)
+		cap *= 2;
+	if (cap > MBUF_MAX)
+		cap = MBUF_MAX;
+	n = realloc(b->data, cap);
+	if (!n) {
+		die("out of memory");
+		return -1;
+	}
+	b->data = n;
+	return 0;
+}
+
+static int read_all_fd(int fd, struct mbuf *b)
+{
+	for (;;) {
+		ssize_t n;
+
+		if (mbuf_reserve(b, b->len + 4096))
+			return -1;
+		n = read(fd, b->data + b->len, 4096);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		if (!n)
+			return 0;
+		b->len += (size_t)n;
+	}
+}
+
+static int read_all_path(const char *path, struct mbuf *b, size_t max)
+{
+	int fd;
+	int ret;
+
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		return -1;
+	for (;;) {
+		ssize_t n;
+
+		if (b->len >= max)
+			break;
+		if (mbuf_reserve(b, b->len + 4096))
+			break;
+		n = read(fd, b->data + b->len, 4096);
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			close(fd);
+			return -1;
+		}
+		if (!n)
+			break;
+		b->len += (size_t)n;
+	}
+	ret = 0;
+	close(fd);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Record decoding                                                     */
+/* ------------------------------------------------------------------ */
+
+static const char *type_name(unsigned int type)
+{
+	switch (type) {
+	case CCCI_EX_TYPE_INVALID:		return "INVALID";
+	case CCCI_EX_TYPE_UNDEF:		return "Fatal error (undefine)";
+	case CCCI_EX_TYPE_SWI:			return "Fatal error (swi)";
+	case CCCI_EX_TYPE_PREF_ABT:		return "Fatal error (prefetch abort)";
+	case CCCI_EX_TYPE_DATA_ABT:		return "Fatal error (data abort)";
+	case CCCI_EX_TYPE_ASSERT:		return "ASSERT";
+	case CCCI_EX_TYPE_FATALERR_TASK:	return "Fatal error (task)";
+	case CCCI_EX_TYPE_FATALERR_BUF:		return "Fatal error (buff)";
+	case CCCI_EX_TYPE_LOCKUP:		return "Lockup";
+	case CCCI_EX_TYPE_ASSERT_DUMP:		return "ASSERT DUMP";
+	case CCCI_EX_TYPE_ASSERT_FAIL:		return "ASSERT FAIL";
+	case CCCI_EX_TYPE_DSP_ASSERT:		return "MD DMD ASSERT";
+	case CCCI_EX_TYPE_DSP_EXCEPTION:	return "MD DMD Exception";
+	case CCCI_EX_TYPE_DSP_FATAL_ERROR:	return "MD DMD FATAL ERROR";
+	case CCCI_EX_TYPE_CROSS_CORE:		return "Fatal error (LTE_EXP)";
+	case CCCI_EX_TYPE_C2K_ERROR:		return "Fatal error (C2K_EXP)";
+	case CCCI_EX_TYPE_EMI_MPU_VIOLATION:	return "Fatal error (rmpu violation)";
+	case CCCI_EX_TYPE_EMI_CHECK:		return "EMI_CHK";
+	default:				return "UNKNOWN Exception";
+	}
+}
+
+static bool type_is_assert(unsigned int type)
+{
+	/* port_kernel.c:3153-3215 plus DSP_EX_TYPE_ASSERT */
+	return type == CCCI_EX_TYPE_ASSERT ||
+	       type == CCCI_EX_TYPE_ASSERT_DUMP ||
+	       type == CCCI_EX_TYPE_ASSERT_FAIL ||
+	       type == CCCI_EX_TYPE_DSP_ASSERT;
+}
+
+static void print_ascii(const char *label, const uint8_t *src, size_t len)
+{
+	char out[128];
+	size_t i;
+
+	if (len >= sizeof(out))
+		len = sizeof(out) - 1;
+	for (i = 0; i < len && src[i]; i++)
+		out[i] = (src[i] >= 0x20 && src[i] <= 0x7e) ? (char)src[i] : '.';
+	out[i] = '\0';
+	printf("  %-18s \"%s\"\n", label, out);
+}
+
+/*
+ * @buf may be a raw 512 byte record or a captured MD_EX_REC_OK packet
+ * (16 byte ccci_header + record).  Return the offset of the record.
+ */
+static int record_offset(const uint8_t *buf, size_t len)
+{
+	const struct ccci_header_wire *h = (const void *)buf;
+
+	if (len >= CCCI_HEADER_SIZE + sizeof(struct ccci_ex_log) &&
+	    ccci_ex_le16(h->channel) == CCCI_CONTROL_RX &&
+	    ccci_ex_le32(h->reserved) == CCCI_MD_EX_REC_OK_CHK_ID)
+		return CCCI_HEADER_SIZE;
+	return 0;
+}
+
+static int decode_record(const char *source, const uint8_t *buf, size_t len)
+{
+	const struct ccci_ex_log *log;
+	const uint8_t *rec;
+	size_t off;
+	unsigned int type;
+	uint32_t code1, code2;
+
+	off = record_offset(buf, len);
+	if (len - off < sizeof(*log)) {
+		die("%s: %zu bytes is shorter than the %zu byte EX_LOG_T",
+		    source, len, sizeof(*log));
+		return -1;
+	}
+	rec = buf + off;
+	log = (const struct ccci_ex_log *)rec;
+	type = log->header.ex_type;
+
+	printf("CCCI exception record from %s (%zu of %zu bytes used)\n",
+	       source, sizeof(*log), len - off);
+	printf("  %-18s %u (0x%02x, %s)\n", "ex_type", type, type,
+	       type_name(type));
+	printf("  %-18s %u\n", "ex_nvram", log->header.ex_nvram);
+	printf("  %-18s %u\n", "ex_serial_num",
+	       ccci_ex_le16(log->header.ex_serial_num));
+	printf("  %-18s %u\n", "boot_mode", log->envinfo.boot_mode);
+	print_ascii("execution_unit", log->envinfo.execution_unit,
+		    sizeof(log->envinfo.execution_unit));
+	printf("  %-18s 0x%02x\n", "status", log->envinfo.status);
+	printf("  %-18s 0x%02x\n", "ELM_status", log->envinfo.elm_status);
+
+	code1 = ccci_ex_le32(log->content.fatalerr.error_code.code1);
+	code2 = ccci_ex_le32(log->content.fatalerr.error_code.code2);
+	if (type_is_assert(type)) {
+		print_ascii("assert file", log->content.assert.filename,
+			    sizeof(log->content.assert.filename));
+		printf("  %-18s %u\n", "assert line",
+		       ccci_ex_le32(log->content.assert.linenumber));
+		printf("  %-18s 0x%08x 0x%08x 0x%08x\n", "assert params",
+		       ccci_ex_le32(log->content.assert.parameters[0]),
+		       ccci_ex_le32(log->content.assert.parameters[1]),
+		       ccci_ex_le32(log->content.assert.parameters[2]));
+	} else {
+		printf("  %-18s 0x%08x\n", "error code1", code1);
+		printf("  %-18s 0x%08x\n", "error code2", code2);
+	}
+	if (type == CCCI_EX_TYPE_EMI_MPU_VIOLATION)
+		printf("  %-18s EMI MPU / RMPU region violation (ECT_SRC_RMPU, ccci_core.h:352)\n",
+		       "rmpu");
+	if (type == CCCI_EX_TYPE_C2K_ERROR)
+		printf("  %-18s C2K exception, no AEE dump for this class (port_kernel.c:3100-3104)\n",
+		       "c2k");
+
+	if (rec[CCCI_EXREC_OFFSET_OFFENDER] == CCCI_EX_OFFENDER_NONE)
+		printf("  %-18s none (0x%02x marker, port_kernel.c:3138)\n",
+		       "offender", CCCI_EX_OFFENDER_NONE);
+	else
+		print_ascii("offender", rec + CCCI_EXREC_OFFSET_OFFENDER,
+			    CCCI_EX_OFFENDER_LEN);
+
+	return 0;
+}
+
+static void hexdump(const uint8_t *p, size_t len)
+{
+	size_t i, j;
+
+	for (i = 0; i < len; i += 16) {
+		printf("  %08zx:", i);
+		for (j = 0; j < 16 && i + j < len; j++)
+			printf(" %02x", p[i + j]);
+		printf("\n");
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Interfaces                                                          */
+/* ------------------------------------------------------------------ */
+
+static int md_number(const char *arg)
+{
+	long v;
+	char *end;
+
+	if (!strncasecmp(arg, "md", 2))
+		arg += 2;
+	v = strtol(arg, &end, 10);
+	if (*arg == '\0' || *end != '\0' || v < 1 || v > 5) {
+		die("invalid modem \"%s\": expected 1..5 or md1..md5", arg);
+		return -1;
+	}
+	return (int)v;
+}
+
+static int record_snapshot(int md1, const char *out, const char *dbgroot)
+{
+	struct mbuf b = { 0 };
+	uint32_t md0 = (uint32_t)(md1 - 1);
+	int fd, ret = -1;
+	FILE *f = NULL;
+
+	fd = open(DUMP_DEV, O_RDONLY);
+	if (fd < 0) {
+		die("%s: %s", DUMP_DEV, strerror(errno));
+		return -1;
+	}
+	if (ioctl(fd, CCCI_UTIL_IOC_SET_MD, &md0) < 0) {
+		die("%s: CCCI_UTIL_IOC_SET_MD(md%d): %s", DUMP_DEV, md1,
+		    strerror(errno));
+		close(fd);
+		return -1;
+	}
+	if (read_all_fd(fd, &b) < 0) {
+		die("%s: read: %s", DUMP_DEV, strerror(errno));
+		close(fd);
+		return -1;
+	}
+	close(fd);
+
+	if (!b.len) {
+		die("%s: md%d has no dump data yet", DUMP_DEV, md1);
+		free(b.data);
+		return -1;
+	}
+
+	if (out && strcmp(out, "-")) {
+		f = fopen(out, "w");
+		if (!f) {
+			die("%s: %s", out, strerror(errno));
+			free(b.data);
+			return -1;
+		}
+	}
+	printf("ccci-dump: md%d snapshot: %zu bytes recorded from %s\n",
+	       md1, b.len, DUMP_DEV);
+	if (f)
+		printf("ccci-dump: written to %s\n", out);
+	if (fwrite(b.data, 1, b.len, f ? f : stdout) != b.len) {
+		die("short write");
+		goto out;
+	}
+	if (f && fflush(f)) {
+		die("%s: %s", out, strerror(errno));
+		goto out;
+	}
+
+	/* Decode the exception record when debugfs has one; the recorded file
+	 * keeps the kernel snapshot verbatim.
+	 */
+	{
+		char path[512];
+		struct mbuf pkt = { 0 };
+
+		snprintf(path, sizeof(path), "%s/ccci/md%d/exception_packet",
+			 dbgroot, md1);
+		if (read_all_path(path, &pkt, DEBUGFS_READ_MAX) == 0 &&
+		    pkt.len) {
+			printf("\n=== decoded exception packet ===\n");
+			if (decode_record(path, pkt.data, pkt.len)) {
+				free(pkt.data);
+				goto out;
+			}
+			hexdump(pkt.data, pkt.len);
+		} else {
+			printf("ccci-dump: %s: no exception packet captured\n",
+			       path);
+		}
+		free(pkt.data);
+	}
+	ret = 0;
+out:
+	if (f && fclose(f) && ret == 0) {
+		die("%s: %s", out, strerror(errno));
+		ret = -1;
+	}
+	free(b.data);
+	return ret;
+}
+
+static int show_stage(int md1, const char *dbgroot)
+{
+	char path[512];
+	struct mbuf b = { 0 };
+
+	snprintf(path, sizeof(path), "%s/ccci/md%d/exception_stage",
+		 dbgroot, md1);
+	if (read_all_path(path, &b, DEBUGFS_READ_MAX) < 0) {
+		die("%s: %s", path, strerror(errno));
+		return -1;
+	}
+	if (!b.len) {
+		die("%s: empty", path);
+		free(b.data);
+		return -1;
+	}
+	fwrite(b.data, 1, b.len, stdout);
+	free(b.data);
+	return 0;
+}
+
+static int show_packet(int md1, const char *dbgroot)
+{
+	char path[512];
+	struct mbuf b = { 0 };
+	int ret;
+
+	snprintf(path, sizeof(path), "%s/ccci/md%d/exception_packet",
+		 dbgroot, md1);
+	if (read_all_path(path, &b, DEBUGFS_READ_MAX) < 0) {
+		die("%s: %s", path, strerror(errno));
+		return -1;
+	}
+	if (!b.len) {
+		die("%s: no exception packet captured", path);
+		free(b.data);
+		return -1;
+	}
+	ret = decode_record(path, b.data, b.len);
+	if (!ret)
+		hexdump(b.data, b.len);
+	free(b.data);
+	return ret;
+}
+
+static int decode_file(const char *path)
+{
+	struct mbuf b = { 0 };
+	int ret;
+
+	if (read_all_path(path, &b, MBUF_MAX) < 0) {
+		die("%s: %s", path, strerror(errno));
+		return -1;
+	}
+	if (!b.len) {
+		die("%s: empty", path);
+		free(b.data);
+		return -1;
+	}
+	ret = decode_record(path, b.data, b.len);
+	free(b.data);
+	return ret;
+}
+
+static void usage(FILE *out)
+{
+	fprintf(out,
+"Usage: ccci-dump [options]\n"
+"\n"
+"Record the CCCI modem dump from /dev/ccci_dump and decode the exception\n"
+"record the kernel collected (EX_LOG_T, 512 bytes).\n"
+"\n"
+"  -m N          modem number, 1-based (default 1, i.e. md1)\n"
+"  -o FILE       record the dump snapshot to FILE ('-' = stdout)\n"
+"  -s            print the debugfs exception stage and exit\n"
+"  -p            print/decode the debugfs exception packet and exit\n"
+"  -D FILE       decode a saved packet or record file and exit\n"
+"  -R DIR        debugfs root (default %s)\n"
+"  -h            this help\n"
+"\n"
+"Without -o the snapshot goes to stdout.  Exit status is 0 only when the\n"
+"requested interface produced data; a missing device or an empty record is\n"
+"reported on stderr and returns 1.\n", DEBUGFS_DEFAULT);
+}
+
+int main(int argc, char **argv)
+{
+	const char *out = NULL, *decode = NULL, *dbgroot = DEBUGFS_DEFAULT;
+	int do_stage = 0, do_packet = 0;
+	int md1 = 1;
+	int opt;
+
+	while ((opt = getopt(argc, argv, "m:o:spD:R:h")) != -1) {
+		switch (opt) {
+		case 'm':
+			md1 = md_number(optarg);
+			if (md1 < 0)
+				return 1;
+			break;
+		case 'o':
+			out = optarg;
+			break;
+		case 's':
+			do_stage = 1;
+			break;
+		case 'p':
+			do_packet = 1;
+			break;
+		case 'D':
+			decode = optarg;
+			break;
+		case 'R':
+			dbgroot = optarg;
+			break;
+		case 'h':
+			usage(stdout);
+			return 0;
+		default:
+			usage(stderr);
+			return 1;
+		}
+	}
+	if (optind != argc) {
+		usage(stderr);
+		return 1;
+	}
+
+	if (decode)
+		return decode_file(decode) ? 1 : 0;
+	if (do_stage)
+		return show_stage(md1, dbgroot) ? 1 : 0;
+	if (do_packet)
+		return show_packet(md1, dbgroot) ? 1 : 0;
+	return record_snapshot(md1, out, dbgroot) ? 1 : 0;
+}
diff --git a/tools/mediatek/ccci/ccci_exrec.h b/tools/mediatek/ccci/ccci_exrec.h
new file mode 100644
index 000000000..146495106
--- /dev/null
+++ b/tools/mediatek/ccci/ccci_exrec.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Modem exception record layout shared by the CCCI dump tooling.
+ *
+ * This is a userspace copy of the on-wire record the modem writes into the
+ * AP<->MD shared memory.  It must stay byte-identical to
+ * drivers/misc/mediatek/ccci/ccci_exception.h, which in turn is a port of the
+ * Samsung/MTK 3.18 kernel:
+ *
+ *   drivers/misc/mediatek/eccci/ccci_core.h:86-135   EX_HEADER_T, EX_ENVINFO_T,
+ *                                                    EX_FATALERR_T,
+ *                                                    EX_ASSERTFAIL_T, EX_LOG_T
+ *   drivers/misc/mediatek/eccci/port_kernel.h:29     CCCI_EXREC_OFFSET_OFFENDER
+ *   drivers/misc/mediatek/eccci/port_kernel.h:31-58  MD_EX_TYPE_*
+ *   drivers/misc/mediatek/eccci/ccci_core.h:246      EMI_MPU_VIOLATION
+ *   drivers/misc/mediatek/eccci/ccci_core.h:352      ECT_SRC_RMPU
+ *   drivers/misc/mediatek/eccci/port_kernel.c:3138   offender 0xCC marker
+ *
+ * The record is 512 bytes.  Everything is little endian on the wire; the
+ * helpers use the byte-order macros so the tool also works on a big-endian
+ * host.
+ */
+#ifndef CCCI_EXREC_H
+#define CCCI_EXREC_H
+
+#include <endian.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* MODEM MAUI Exception header (4 bytes), ccci_core.h:86-91 */
+struct ccci_ex_header {
+	uint8_t ex_type;
+	uint8_t ex_nvram;
+	uint16_t ex_serial_num;
+} __attribute__((packed));
+
+/* MODEM MAUI Environment information (164 bytes), ccci_core.h:93-101 */
+struct ccci_ex_env_info {
+	uint8_t boot_mode;		/* offset +0x10 */
+	uint8_t reserved1[8];
+	uint8_t execution_unit[8];
+	uint8_t status;			/* offset +0x21 */
+	uint8_t elm_status;		/* offset +0x22 */
+	uint8_t reserved2[145];
+} __attribute__((packed));
+
+/* MODEM MAUI fatal error code (8 bytes), ccci_core.h:103-107 */
+struct ccci_ex_fatalerr_code {
+	uint32_t code1;
+	uint32_t code2;
+} __attribute__((packed));
+
+/* MODEM MAUI fatal error (296 bytes), ccci_core.h:109-113 */
+struct ccci_ex_fatalerr {
+	struct ccci_ex_fatalerr_code error_code;
+	uint8_t reserved1[288];
+} __attribute__((packed));
+
+/* MODEM MAUI assert fail (296 bytes), ccci_core.h:115-121 */
+struct ccci_ex_assert_fail {
+	uint8_t filename[24];
+	uint32_t linenumber;
+	uint32_t parameters[3];
+	uint8_t reserved1[256];
+} __attribute__((packed));
+
+/* ccci_core.h:123-128 */
+union ccci_ex_content {
+	struct ccci_ex_fatalerr fatalerr;
+	struct ccci_ex_assert_fail assert;
+} __attribute__((packed));
+
+/* MODEM MAUI standard exception log (512 bytes), ccci_core.h:130-135 */
+struct ccci_ex_log {
+	struct ccci_ex_header header;
+	uint8_t reserved1[12];
+	struct ccci_ex_env_info envinfo;
+	uint8_t reserved2[36];
+	union ccci_ex_content content;
+} __attribute__((packed));
+
+/* Downstream port_kernel.h:29.  The offender string is stored in the content
+ * reserved area, 288 bytes from the start of the record.
+ */
+#define CCCI_EXREC_OFFSET_OFFENDER	288
+/* Downstream port_kernel.c:3138: a 0xCC lead byte means "no offender". */
+#define CCCI_EX_OFFENDER_NONE		0xCC
+/* Offender field size in downstream DEBUG_INFO_T (fatal_error.offender). */
+#define CCCI_EX_OFFENDER_LEN		64
+
+/* EX_LOG_T.ex_type, downstream port_kernel.h:31-58 and ccci_core.h:230-246 */
+#define CCCI_EX_TYPE_INVALID		0
+#define CCCI_EX_TYPE_UNDEF		1
+#define CCCI_EX_TYPE_SWI		2
+#define CCCI_EX_TYPE_PREF_ABT		3
+#define CCCI_EX_TYPE_DATA_ABT		4
+#define CCCI_EX_TYPE_ASSERT		5
+#define CCCI_EX_TYPE_FATALERR_TASK	6
+#define CCCI_EX_TYPE_FATALERR_BUF	7
+#define CCCI_EX_TYPE_LOCKUP		8
+#define CCCI_EX_TYPE_ASSERT_DUMP	9
+#define CCCI_EX_TYPE_ASSERT_FAIL	10
+#define CCCI_EX_TYPE_DSP_ASSERT		11
+#define CCCI_EX_TYPE_DSP_EXCEPTION	12
+#define CCCI_EX_TYPE_DSP_FATAL_ERROR	13
+#define CCCI_EX_TYPE_CROSS_CORE		15
+#define CCCI_EX_TYPE_C2K_ERROR		0x25
+#define CCCI_EX_TYPE_EMI_MPU_VIOLATION	0x30	/* ccci_core.h:246 */
+#define CCCI_EX_TYPE_EMI_CHECK		99
+
+/* Downstream mt-plat/mt_ccci_common.h:590-591 */
+#define CCCI_MD_EX_CHK_ID		0x45584350u
+#define CCCI_MD_EX_REC_OK_CHK_ID	0x45524543u
+/* Control channel message ids, mt_ccci_common.h:580-589 */
+#define CCCI_MD_EX_REC_OK		0x6
+
+/* ccci_header, 16 bytes: it precedes the record in an MD_EX_REC_OK packet. */
+struct ccci_header_wire {
+	uint32_t data[2];
+	uint16_t channel;
+	uint16_t seq_num;
+	uint32_t reserved;
+} __attribute__((packed));
+
+#define CCCI_HEADER_SIZE	16
+#define CCCI_CONTROL_RX		0
+
+_Static_assert(sizeof(struct ccci_ex_header) == 4, "EX_HEADER_T size");
+_Static_assert(sizeof(struct ccci_ex_env_info) == 164, "EX_ENVINFO_T size");
+_Static_assert(sizeof(struct ccci_ex_fatalerr) == 296, "EX_FATALERR_T size");
+_Static_assert(sizeof(struct ccci_ex_assert_fail) == 296, "EX_ASSERTFAIL_T size");
+_Static_assert(sizeof(union ccci_ex_content) == 296, "EX_CONTENT_T size");
+_Static_assert(sizeof(struct ccci_ex_log) == 512, "EX_LOG_T size");
+_Static_assert(offsetof(struct ccci_ex_log, envinfo) == 0x10,
+	       "EX_LOG_T envinfo offset");
+_Static_assert(offsetof(struct ccci_ex_log, content) == 0xd8,
+	       "EX_LOG_T content offset");
+_Static_assert(sizeof(struct ccci_header_wire) == CCCI_HEADER_SIZE,
+	       "ccci_header size");
+_Static_assert(CCCI_EXREC_OFFSET_OFFENDER < sizeof(struct ccci_ex_log),
+	       "offender inside record");
+
+static inline uint16_t ccci_ex_le16(uint16_t v)
+{
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+	return v;
+#else
+	return __builtin_bswap16(v);
+#endif
+}
+
+static inline uint32_t ccci_ex_le32(uint32_t v)
+{
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+	return v;
+#else
+	return __builtin_bswap32(v);
+#endif
+}
+
+#endif /* CCCI_EXREC_H */
