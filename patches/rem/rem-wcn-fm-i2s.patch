 	mutex_unlock(&fm->lock);
 
 	return ret;
@@ -448,6 +469,94 @@ static int mtk_wcn_fm_subscribe_event(struct v4l2_fh *fh,
 	}
 }
 
+/*
+ * Downstream private FM I2S ioctls (core/fm_module.c:294-315, 735-757).
+ *
+ * They are handled in the file operations instead of vidioc_default because
+ * the downstream command word encodes _IOC_SIZE == 4 (the headers use a
+ * pointer type in _IOWR, fm_ioctl.h:70,81) while the payload is 12 bytes.
+ * video_ioctl2() would copy only the four bytes of _IOC_SIZE into the kernel
+ * buffer handed to vidioc_default(); the downstream character driver instead
+ * copied sizeof(struct) itself, which is what is done here.
+ */
+static int mtk_wcn_fm_ioctl_i2s_setting(struct mtk_wcn_fm_dev *fm,
+					void __user *arg)
+{
+	struct fm_i2s_setting cfg;
+	int ret;
+
+	if (copy_from_user(&cfg, arg, sizeof(cfg)))
+		return -EFAULT;
+
+	if (cfg.onoff != FM_I2S_ON && cfg.onoff != FM_I2S_OFF)
+		return -EINVAL;
+	/*
+	 * The MT6627 audio port is wired as the connectivity I2S master with a
+	 * fixed 32 kHz frame (mt6627_fm_config.c:116-118) and there is no
+	 * downstream register sequence that changes either
+	 * (mt6627_I2s_Setting() has no body, mt6627_fm_lib.c:88-90).  A request
+	 * for any other mode or rate is rejected rather than accepted and
+	 * ignored.
+	 */
+	if (cfg.mode != FM_I2S_MASTER || cfg.sample != FM_I2S_32K)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&fm->lock);
+	if (!fm->powered) {
+		ret = -EAGAIN;
+	} else {
+		/*
+		 * Programs the chip port and keeps the ASoC route state in
+		 * step.  Without CONFIG_SND_SOC this is the chip write itself;
+		 * with ASoC but no machine link using the codec, an enable is
+		 * rejected with -ENODEV because no PCM could reach the port.
+		 */
+		ret = mtk_wcn_fm_i2s_route(fm, cfg.onoff == FM_I2S_ON);
+	}
+	mutex_unlock(&fm->lock);
+
+	return ret;
+}
+
+static int mtk_wcn_fm_ioctl_get_i2s_info(struct mtk_wcn_fm_dev *fm,
+					 void __user *arg)
+{
+	struct fm_i2s_info info;
+	int ret;
+
+	memset(&info, 0, sizeof(info));
+
+	mutex_lock(&fm->lock);
+	ret = mtk_wcn_fm_chip_i2s_info(fm, &info);
+	mutex_unlock(&fm->lock);
+
+	if (ret)
+		return ret;
+	if (copy_to_user(arg, &info, sizeof(info)))
+		return -EFAULT;
+
+	return 0;
+}
+
+/*
+ * Private ioctl dispatch.  Everything that is not an FM I2S ioctl goes back
+ * to the V4L2 core.
+ */
+static long mtk_wcn_fm_fops_ioctl(struct file *file, unsigned int cmd,
+				  unsigned long arg)
+{
+	struct mtk_wcn_fm_dev *fm = video_drvdata(file);
+
+	switch (cmd) {
+	case FM_IOCTL_I2S_SETTING:
+		return mtk_wcn_fm_ioctl_i2s_setting(fm, (void __user *)arg);
+	case FM_IOCTL_GET_I2S_INFO:
+		return mtk_wcn_fm_ioctl_get_i2s_info(fm, (void __user *)arg);
+	default:
+		return video_ioctl2(file, cmd, arg);
+	}
+}
+
 static const struct v4l2_ioctl_ops mtk_wcn_fm_ioctl_ops = {
 	.vidioc_querycap	= mtk_wcn_fm_querycap,
 	.vidioc_g_tuner		= mtk_wcn_fm_g_tuner,
@@ -585,7 +694,11 @@ static const struct v4l2_file_operations mtk_wcn_fm_fops = {
 	.release	= mtk_wcn_fm_fops_release,
 	.read		= mtk_wcn_fm_fops_read,
 	.poll		= mtk_wcn_fm_fops_poll,
-	.unlocked_ioctl	= video_ioctl2,
+	.unlocked_ioctl	= mtk_wcn_fm_fops_ioctl,
+#ifdef CONFIG_COMPAT
+	/* Same layout for 32-bit callers (three s32 words, no pointers). */
+	.compat_ioctl32	= mtk_wcn_fm_fops_ioctl,
+#endif
 };
 
 /*
@@ -608,6 +721,7 @@ static int mtk_wcn_fm_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	fm->dev = &pdev->dev;
+	platform_set_drvdata(pdev, fm);
 	mutex_init(&fm->lock);
 	mutex_init(&fm->cmd_lock);
 	spin_lock_init(&fm->evt_lock);
@@ -728,7 +842,18 @@ static int mtk_wcn_fm_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_video;
 
-	platform_set_drvdata(pdev, fm);
+	/*
+	 * ASoC glue: the FM codec component only.  No sound card is registered
+	 * here - the board machine driver owns the single card and may link
+	 * this component.  A registration failure (for example the audio
+	 * component being unavailable) only removes the ALSA route; tuning and
+	 * the chip level I2S controls keep working.
+	 */
+	ret = mtk_wcn_fm_i2s_init(fm);
+	if (ret)
+		dev_warn(&pdev->dev,
+			 "FM I2S ALSA route unavailable (%d), continuing\n",
+			 ret);
 
 	dev_info(&pdev->dev, "MT6627 FM radio on %s\n",
 		 video_device_node_name(&fm->vdev));
@@ -761,6 +886,9 @@ static void mtk_wcn_fm_remove(struct platform_device *pdev)
 	}
 	mutex_unlock(&fm->lock);
 
+	/* Drop the codec component before the chip and its registers go away. */
+	mtk_wcn_fm_i2s_exit(fm);
+
 	/* Stop the reset worker before the WMT/STP callbacks go away. */
 	cancel_work_sync(&fm->rst_work);
 	mtk_wcn_fm_link_exit(fm);
diff --git a/include/uapi/linux/mtk_fm_i2s.h b/include/uapi/linux/mtk_fm_i2s.h
new file mode 100644
index 000000000..31c0bac4b
--- /dev/null
+++ b/include/uapi/linux/mtk_fm_i2s.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * MediaTek WCN FM radio - MT6627 I2S control ABI.
+ *
+ * Port from Samsung/MTK downstream:
+ *   drivers/misc/mediatek/fmradio/inc/fm_interface.h:59-90
+ *   drivers/misc/mediatek/fmradio/inc/fm_ioctl.h:19-20,70,81
+ *   drivers/misc/mediatek/fmradio/core/fm_module.c:294-315,735-757
+ *
+ * The two ioctls carry a 12 byte payload made of three little endian 32 bit
+ * words.  Downstream declares the command with a pointer type in _IOWR()
+ * ("struct fm_i2s_setting *"), so its 32-bit command word encodes
+ * _IOC_SIZE == 4 even though twelve bytes are transferred; the kernel driver
+ * copies the full structure itself.  The __u32 payload type below reproduces
+ * that command word on both 32-bit and 64-bit builds, which keeps the ABI of
+ * the shipped 32-bit ROM.
+ */
+
+#ifndef _UAPI_LINUX_MTK_FM_I2S_H
+#define _UAPI_LINUX_MTK_FM_I2S_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* fm_interface.h:59-63 */
+struct fm_i2s_setting {
+	__s32 onoff;		/* fm_i2s_state_e */
+	__s32 mode;		/* fm_i2s_mode_e */
+	__s32 sample;		/* fm_i2s_sample_e */
+};
+
+/* fm_interface.h:82-87 */
+struct fm_i2s_info {
+	__s32 status;		/* fm_i2s_state_e, FM_I2S_STATE_ERR on error */
+	__s32 mode;		/* fm_i2s_mode_e, FM_I2S_MODE_ERR on error */
+	__s32 rate;		/* fm_i2s_sample_e, FM_I2S_SR_ERR on error */
+};
+
+/* fm_interface.h:64-68 */
+#define FM_I2S_ON		0
+#define FM_I2S_OFF		1
+#define FM_I2S_STATE_ERR	2
+
+/* fm_interface.h:70-74 */
+#define FM_I2S_MASTER		0
+#define FM_I2S_SLAVE		1
+#define FM_I2S_MODE_ERR		2
+
+/* fm_interface.h:76-80 */
+#define FM_I2S_32K		0
+#define FM_I2S_44K		1
+#define FM_I2S_48K		2
+#define FM_I2S_SR_ERR		3
+
+/* fm_ioctl.h:19-20,70,81 */
+#define FM_IOC_MAGIC		0xf5
+#define FM_IOCTL_I2S_SETTING	_IOWR(FM_IOC_MAGIC, 33, __u32)
+#define FM_IOCTL_GET_I2S_INFO	_IOWR(FM_IOC_MAGIC, 41, __u32)
+
+#endif /* _UAPI_LINUX_MTK_FM_I2S_H */
diff --git a/tools/mediatek/wcn/fm_i2s/Makefile b/tools/mediatek/wcn/fm_i2s/Makefile
new file mode 100644
index 000000000..aeee3eba1
--- /dev/null
+++ b/tools/mediatek/wcn/fm_i2s/Makefile
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Host build for the MT6627 FM I2S control helper.
+#
+# The UAPI header is taken from the kernel tree this tool ships with.  It is
+# added with -idirafter so that the host's <linux/types.h> and <linux/ioctl.h>
+# are used while <linux/mtk_fm_i2s.h> comes from include/uapi.
+
+CC ?= cc
+KERNEL_UAPI ?= $(abspath $(CURDIR)/../../../../include/uapi)
+
+# Keep the compiler's intermediate files in the build tree: the host /tmp may
+# be small (or full) and it is not part of the deliverable.  An explicit
+# TMPDIR from the environment still wins.
+TMPDIR ?= $(CURDIR)/.tmp
+export TMPDIR
+
+CPPFLAGS += -idirafter $(KERNEL_UAPI)
+CFLAGS ?= -O2 -g
+CFLAGS += -Wall -Wextra -Werror -std=gnu11
+
+all: fm_i2s
+
+fm_i2s: fm_i2s.c selftest.c | $(TMPDIR)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ fm_i2s.c selftest.c
+
+$(TMPDIR):
+	mkdir -p $@
+
+check: fm_i2s
+	./fm_i2s --selftest
+
+clean:
+	rm -rf fm_i2s .tmp
+
+.PHONY: all check clean
diff --git a/tools/mediatek/wcn/fm_i2s/fm_i2s.c b/tools/mediatek/wcn/fm_i2s/fm_i2s.c
new file mode 100644
index 000000000..44d00c051
--- /dev/null
+++ b/tools/mediatek/wcn/fm_i2s/fm_i2s.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6627 FM I2S control helper.
+ *
+ * Exercises the two private ioctls of the mtk_wcn_fm driver through the
+ * shared UAPI header (include/uapi/linux/mtk_fm_i2s.h):
+ *
+ *   FM_IOCTL_I2S_SETTING  enable/disable the chip I2S port
+ *   FM_IOCTL_GET_I2S_INFO read back status, mode and sample rate
+ *
+ * The ioctl numbers are the downstream ones (fm_ioctl.h:70,81) and the payload
+ * is the downstream 12 byte structure.  The driver rejects a mode or rate other
+ * than the fixed MT6627 configuration (master, 32 kHz) with -EOPNOTSUPP.
+ *
+ * The radio device is a V4L2 radio node, normally /dev/radio0.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <linux/mtk_fm_i2s.h>
+
+/* Offline ABI self-test, selftest.c. */
+int fm_i2s_selftest(void);
+
+#define DEFAULT_DEVICE	"/dev/radio0"
+
+static const char *const state_names[] = {
+	[FM_I2S_ON] = "on",
+	[FM_I2S_OFF] = "off",
+	[FM_I2S_STATE_ERR] = "error",
+};
+
+static const char *const mode_names[] = {
+	[FM_I2S_MASTER] = "master",
+	[FM_I2S_SLAVE] = "slave",
+	[FM_I2S_MODE_ERR] = "error",
+};
+
+static const char *const rate_names[] = {
+	[FM_I2S_32K] = "32k",
+	[FM_I2S_44K] = "44k",
+	[FM_I2S_48K] = "48k",
+	[FM_I2S_SR_ERR] = "error",
+};
+
+static const char *lookup(const char *const *names, size_t n, int value)
+{
+	if (value < 0 || (size_t)value >= n)
+		return "invalid";
+	return names[value];
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr,
+		"usage: %s [device] get\n"
+		"       %s [device] set <on|off> [master|slave] [32k|44k|48k]\n"
+		"       %s --selftest\n"
+		"\n"
+		"Defaults: device %s, mode master, rate 32k.\n",
+		prog, prog, prog, DEFAULT_DEVICE);
+}
+
+static int do_get(int fd)
+{
+	struct fm_i2s_info info;
+	int ret;
+
+	memset(&info, 0, sizeof(info));
+	ret = ioctl(fd, FM_IOCTL_GET_I2S_INFO, &info);
+	if (ret < 0) {
+		fprintf(stderr, "FM_IOCTL_GET_I2S_INFO: %s\n",
+			strerror(errno));
+		return 1;
+	}
+
+	printf("status: %s (%d)\n", lookup(state_names,
+					  sizeof(state_names) /
+					  sizeof(state_names[0]),
+					  info.status), info.status);
+	printf("mode:   %s (%d)\n", lookup(mode_names,
+					  sizeof(mode_names) /
+					  sizeof(mode_names[0]),
+					  info.mode), info.mode);
+	printf("rate:   %s (%d)\n", lookup(rate_names,
+					  sizeof(rate_names) /
+					  sizeof(rate_names[0]),
+					  info.rate), info.rate);
+
+	return 0;
+}
+
+static int parse_mode(const char *arg)
+{
+	if (!strcmp(arg, "master"))
+		return FM_I2S_MASTER;
+	if (!strcmp(arg, "slave"))
+		return FM_I2S_SLAVE;
+	return -1;
+}
+
+static int parse_rate(const char *arg)
+{
+	if (!strcmp(arg, "32k"))
+		return FM_I2S_32K;
+	if (!strcmp(arg, "44k"))
+		return FM_I2S_44K;
+	if (!strcmp(arg, "48k"))
+		return FM_I2S_48K;
+	return -1;
+}
+
+static int do_set(int fd, const char *onoff, const char *modearg,
+		  const char *ratearg)
+{
+	struct fm_i2s_setting cfg;
+	int ret;
+
+	memset(&cfg, 0, sizeof(cfg));
+
+	if (!strcmp(onoff, "on"))
+		cfg.onoff = FM_I2S_ON;
+	else if (!strcmp(onoff, "off"))
+		cfg.onoff = FM_I2S_OFF;
+	else {
+		fprintf(stderr, "invalid on/off value \"%s\"\n", onoff);
+		return 2;
+	}
+
+	if (modearg) {
+		cfg.mode = parse_mode(modearg);
+		if (cfg.mode < 0) {
+			fprintf(stderr, "invalid mode \"%s\"\n", modearg);
+			return 2;
+		}
+	}
+
+	if (ratearg) {
+		cfg.sample = parse_rate(ratearg);
+		if (cfg.sample < 0) {
+			fprintf(stderr, "invalid rate \"%s\"\n", ratearg);
+			return 2;
+		}
+	}
+
+	ret = ioctl(fd, FM_IOCTL_I2S_SETTING, &cfg);
+	if (ret < 0) {
+		fprintf(stderr, "FM_IOCTL_I2S_SETTING(%s, %s, %s): %s\n",
+			onoff,
+			lookup(mode_names, sizeof(mode_names) /
+			       sizeof(mode_names[0]), cfg.mode),
+			lookup(rate_names, sizeof(rate_names) /
+			       sizeof(rate_names[0]), cfg.sample),
+			strerror(errno));
+		return 1;
+	}
+
+	printf("FM I2S port set to %s\n", onoff);
+
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	const char *device = DEFAULT_DEVICE;
+	const char *command;
+	int fd, ret;
+
+	if (argc >= 2 && !strcmp(argv[1], "--selftest"))
+		return fm_i2s_selftest();
+
+	if (argc < 2) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	/* First argument may be the device node. */
+	if (argv[1][0] == '/') {
+		device = argv[1];
+		argc--;
+		argv++;
+	}
+
+	if (argc < 2) {
+		usage(device);
+		return 2;
+	}
+	command = argv[1];
+
+	fd = open(device, O_RDONLY | O_NONBLOCK);
+	if (fd < 0) {
+		fprintf(stderr, "cannot open %s: %s\n", device,
+			strerror(errno));
+		return 1;
+	}
+
+	if (!strcmp(command, "get")) {
+		ret = do_get(fd);
+	} else if (!strcmp(command, "set")) {
+		if (argc < 3 || argc > 5) {
+			usage(device);
+			close(fd);
+			return 2;
+		}
+		ret = do_set(fd, argv[2], argc > 3 ? argv[3] : NULL,
+			     argc > 4 ? argv[4] : NULL);
+	} else {
+		usage(device);
+		ret = 2;
+	}
+
+	close(fd);
+
+	return ret;
+}
diff --git a/tools/mediatek/wcn/fm_i2s/selftest.c b/tools/mediatek/wcn/fm_i2s/selftest.c
new file mode 100644
index 000000000..4bc73a1ad
--- /dev/null
+++ b/tools/mediatek/wcn/fm_i2s/selftest.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Offline self-test for the MT6627 FM I2S control ABI.
+ *
+ * Checks the parts that must not drift from the driver and from the shipped
+ * 32-bit ROM: structure size and offsets, the enum values, and the exact ioctl
+ * command words (FM_IOC_MAGIC 0xf5, numbers 33 and 41, _IOC_SIZE 4 because
+ * downstream declares the payload as a pointer).  No radio device is needed.
+ */
+
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+#include <linux/mtk_fm_i2s.h>
+
+static unsigned int checks;
+static unsigned int failures;
+
+#define CHECK(cond)							\
+	do {								\
+		checks++;						\
+		if (!(cond)) {						\
+			fprintf(stderr, "FAIL: %s\n", #cond);		\
+			failures++;					\
+		}							\
+	} while (0)
+
+static void check_layout(void)
+{
+	CHECK(sizeof(struct fm_i2s_setting) == 12);
+	CHECK(offsetof(struct fm_i2s_setting, onoff) == 0);
+	CHECK(offsetof(struct fm_i2s_setting, mode) == 4);
+	CHECK(offsetof(struct fm_i2s_setting, sample) == 8);
+
+	CHECK(sizeof(struct fm_i2s_info) == 12);
+	CHECK(offsetof(struct fm_i2s_info, status) == 0);
+	CHECK(offsetof(struct fm_i2s_info, mode) == 4);
+	CHECK(offsetof(struct fm_i2s_info, rate) == 8);
+}
+
+static void check_enums(void)
+{
+	/* fm_interface.h:64-80 */
+	CHECK(FM_I2S_ON == 0);
+	CHECK(FM_I2S_OFF == 1);
+	CHECK(FM_I2S_STATE_ERR == 2);
+	CHECK(FM_I2S_MASTER == 0);
+	CHECK(FM_I2S_SLAVE == 1);
+	CHECK(FM_I2S_MODE_ERR == 2);
+	CHECK(FM_I2S_32K == 0);
+	CHECK(FM_I2S_44K == 1);
+	CHECK(FM_I2S_48K == 2);
+	CHECK(FM_I2S_SR_ERR == 3);
+}
+
+static void check_commands(void)
+{
+	/*
+	 * Downstream fm_ioctl.h:70,81 builds the command from a pointer type,
+	 * which is 4 bytes in the 32-bit ROM userspace, so the wire command is
+	 * _IOC(_IOC_READ | _IOC_WRITE, 0xf5, nr, 4).
+	 */
+	CHECK(_IOC_TYPE(FM_IOCTL_I2S_SETTING) == FM_IOC_MAGIC);
+	CHECK(_IOC_NR(FM_IOCTL_I2S_SETTING) == 33);
+	CHECK(_IOC_SIZE(FM_IOCTL_I2S_SETTING) == 4);
+	CHECK((_IOC_DIR(FM_IOCTL_I2S_SETTING) & (_IOC_READ | _IOC_WRITE)) ==
+	      (_IOC_READ | _IOC_WRITE));
+	CHECK(FM_IOCTL_I2S_SETTING == 0xc004f521U);
+
+	CHECK(_IOC_TYPE(FM_IOCTL_GET_I2S_INFO) == FM_IOC_MAGIC);
+	CHECK(_IOC_NR(FM_IOCTL_GET_I2S_INFO) == 41);
+	CHECK(_IOC_SIZE(FM_IOCTL_GET_I2S_INFO) == 4);
+	CHECK((_IOC_DIR(FM_IOCTL_GET_I2S_INFO) & (_IOC_READ | _IOC_WRITE)) ==
+	      (_IOC_READ | _IOC_WRITE));
+	CHECK(FM_IOCTL_GET_I2S_INFO == 0xc004f529U);
+}
+
+static void check_request(const struct fm_i2s_setting *cfg,
+			  const unsigned char *wire)
+{
+	/* Three little endian s32 words, in structure order. */
+	CHECK(wire[0] == (unsigned char)(cfg->onoff & 0xff));
+	CHECK(wire[4] == (unsigned char)(cfg->mode & 0xff));
+	CHECK(wire[8] == (unsigned char)(cfg->sample & 0xff));
+	CHECK(((unsigned int)wire[3] << 24 | (unsigned int)wire[2] << 16 |
+	       (unsigned int)wire[1] << 8 | wire[0]) ==
+	      (unsigned int)cfg->onoff);
+	CHECK(((unsigned int)wire[7] << 24 | (unsigned int)wire[6] << 16 |
+	       (unsigned int)wire[5] << 8 | wire[4]) ==
+	      (unsigned int)cfg->mode);
+	CHECK(((unsigned int)wire[11] << 24 | (unsigned int)wire[10] << 16 |
+	       (unsigned int)wire[9] << 8 | wire[8]) ==
+	      (unsigned int)cfg->sample);
+}
+
+static void check_payload(void)
+{
+	struct fm_i2s_setting cfg = {
+		.onoff = FM_I2S_OFF,
+		.mode = FM_I2S_MASTER,
+		.sample = FM_I2S_32K,
+	};
+	struct fm_i2s_info info = {
+		.status = FM_I2S_ON,
+		.mode = FM_I2S_MASTER,
+		.rate = FM_I2S_32K,
+	};
+	unsigned char wire[12];
+
+	memset(wire, 0, sizeof(wire));
+	memcpy(wire, &cfg, sizeof(cfg));
+	check_request(&cfg, wire);
+
+	memset(wire, 0, sizeof(wire));
+	memcpy(wire, &info, sizeof(info));
+	CHECK(wire[0] == FM_I2S_ON);
+	CHECK(wire[4] == FM_I2S_MASTER);
+	CHECK(wire[8] == FM_I2S_32K);
+}
