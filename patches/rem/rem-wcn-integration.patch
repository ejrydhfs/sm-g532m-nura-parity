@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Userspace consumer for the MediaTek WCN STP_DBG coredump netlink family.
+# Host build: plain libc only.
+
+CC	?= cc
+CFLAGS	?= -O2
+CFLAGS	+= -Wall -Wextra -Werror -std=c11 -D_POSIX_C_SOURCE=200809L
+LDFLAGS	?=
+
+PROG	= stp_dbg
+OBJS	= stp_dbg.o stp_dbg_parse.o selftest.o
+
+all: $(PROG)
+
+$(PROG): $(OBJS)
+	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(OBJS)
+
+%.o: %.c
+	$(CC) $(CFLAGS) -c -o $@ $<
+
+stp_dbg.o: stp_dbg.c stp_dbg_parse.h
+stp_dbg_parse.o: stp_dbg_parse.c stp_dbg_parse.h
+selftest.o: selftest.c stp_dbg_parse.h
+
+check: $(PROG)
