diff --git a/drivers/misc/mediatek/connectivity/fm/Makefile b/drivers/misc/mediatek/connectivity/fm/Makefile
index 80c9a20a5..1b1fd05f4 100644
--- a/drivers/misc/mediatek/connectivity/fm/Makefile
+++ b/drivers/misc/mediatek/connectivity/fm/Makefile
@@ -9,3 +9,16 @@ obj-$(CONFIG_MTK_WCN_FM) += mtk_wcn_fm.o
 mtk_wcn_fm-y := mtk_wcn_fm_link.o \
 		mtk_wcn_fm_chip.o \
 		mtk_wcn_fm_v4l2.o
+
+# The ASoC glue (FM codec component; no sound card) is built when the SoC
+# audio core is present and can be linked from this driver.  Without it the FM
+# driver uses the chip level I2S hooks and the inline fallbacks of
+# mtk_wcn_fm_i2s.h.  A built-in FM driver cannot reference the symbols of a
+# modular snd-soc-core, so CONFIG_MTK_WCN_FM=y with CONFIG_SND_SOC=m takes the
+# fallback path exactly like CONFIG_SND_SOC=n (mtk_wcn_fm_i2s.h implements the
+# same rule for the C code).
+ifeq ($(CONFIG_MTK_WCN_FM)$(CONFIG_SND_SOC),ym)
+# no ASoC glue: snd-soc-core is a module and this driver is built in
+else ifneq ($(CONFIG_SND_SOC),)
+mtk_wcn_fm-y += mtk_wcn_fm_i2s.o
+endif
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm.h b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm.h
index 99aa68ac1..0f431b6e7 100644
--- a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm.h
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm.h
@@ -28,6 +28,7 @@
 #include <linux/workqueue.h>
 #include <linux/videodev2.h>
 
+#include <uapi/linux/mtk_fm_i2s.h>
 #include <uapi/linux/mtk_fm_rds.h>
 
 #include <media/v4l2-ctrls.h>
@@ -284,6 +285,16 @@
 #define V4L2_CID_MTK_WCN_FM_SOFTMUTE_GAIN	(V4L2_CID_USER_MTK_WCN_FM_BASE + 2)
 #define V4L2_CID_MTK_WCN_FM_BLEND		(V4L2_CID_USER_MTK_WCN_FM_BASE + 3)
 
+struct mtk_wcn_fm_i2s;
+
+/*
+ * FM I2S control ABI (include/uapi/linux/mtk_fm_i2s.h, shared with
+ * tools/mediatek/wcn/fm_i2s).  The layouts are fixed: three little endian
+ * 32 bit words, 12 bytes per structure.
+ */
+static_assert(sizeof(struct fm_i2s_setting) == 12);
+static_assert(sizeof(struct fm_i2s_info) == 12);
+
 /* Maximum number of raw RDS records buffered for read(). */
 #define MTK_WCN_FM_RDS_FIFO_RECORDS	32
 
@@ -349,6 +360,11 @@ struct mtk_wcn_fm_dev {
 	bool powered;
 	bool opened;
 
+	/* MT6627 I2S audio port state (FM_REG_AUDIO_CTRL0 + host reg). */
+	bool i2s_on;
+	/* ASoC glue state, NULL when CONFIG_SND_SOC is disabled. */
+	struct mtk_wcn_fm_i2s *i2s;
+
 	u16 cur_freq;		/* 10 kHz units */
 	u8 band;
 	u8 antenna;		/* 0: long, 1: short */
@@ -388,4 +404,34 @@ int mtk_wcn_fm_chip_mono(struct mtk_wcn_fm_dev *fm, bool mono);
 int mtk_wcn_fm_chip_smg(struct mtk_wcn_fm_dev *fm, u8 value);
 int mtk_wcn_fm_chip_blend(struct mtk_wcn_fm_dev *fm, bool on);
 
+/*
+ * MT6627 FM I2S audio port.
+ *
+ * mtk_wcn_fm_chip_i2s_set() enables/disables the port with the exact
+ * downstream register writes:
+ *   enable : FM_REG_AUDIO_CTRL0 = 0xf9ab and host 0x80101054 = 0x00003f35
+ *            (mt6627_fm_lib.c:1023-1024 after every retune, :850-851 in the
+ *            power up sequence and :1511,1513 after a soft-mute scan);
+ *   disable: host 0x80101054 bits 13:14 cleared (mt6627_PowerDown(),
+ *            mt6627_fm_lib.c:892-894) and FM_REG_AUDIO_CTRL0 bits 15:3
+ *            cleared (mt6627_pwrdown(), mt6627_fm_cmd.c:523).
+ * Both require the FM function to be powered.  The ASoC glue
+ * (mtk_wcn_fm_i2s.c) and its inline fallback are the only callers; the power
+ * up and power down sequences of this file program the same registers
+ * themselves.
+ */
+int mtk_wcn_fm_chip_i2s_set(struct mtk_wcn_fm_dev *fm, bool on);
+/* Read the real port state back from the chip.  -EAGAIN if unpowered. */
+int mtk_wcn_fm_chip_i2s_get(struct mtk_wcn_fm_dev *fm, bool *on);
+/*
+ * Fill a downstream struct fm_i2s_info.  The status is the real port state
+ * (FM_I2S_OFF while the FM function is unpowered); mode and rate are the fixed
+ * MT6627 values, mt6627_fm_config.c:116-118.
+ */
+int mtk_wcn_fm_chip_i2s_info(struct mtk_wcn_fm_dev *fm,
+			     struct fm_i2s_info *info);
+
+/* ASoC glue; must stay the last include of this header. */
+#include "mtk_wcn_fm_i2s.h"
+
 #endif /* _MTK_WCN_FM_H_ */
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_chip.c b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_chip.c
index 601c01864..ddf1ccdf1 100644
--- a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_chip.c
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_chip.c
@@ -1060,6 +1060,9 @@ static int mtk_wcn_fm_power_up_seq(struct mtk_wcn_fm_dev *fm)
 	if (ret)
 		return ret;
 
+	/* The power up sequence leaves the I2S port enabled. */
+	fm->i2s_on = true;
+
 	return 0;
 }
 
@@ -1145,6 +1148,10 @@ int mtk_wcn_fm_chip_power_down(struct mtk_wcn_fm_dev *fm)
 
 	fm->powered = false;
 	fm->rds_on = false;
+	/* The power down sequence turned the I2S port off (mt6627_fm_lib.c:
+	 * 892-894, mt6627_fm_cmd.c:523) and the registers are gone.
+	 */
+	fm->i2s_on = false;
 
 	return ret;
 }
@@ -1281,6 +1288,8 @@ int mtk_wcn_fm_chip_tune(struct mtk_wcn_fm_dev *fm, u16 freq)
 	ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL, 0x00003f35);
 	if (ret)
 		return ret;
+	/* Every retune re-enables the I2S port (mt6627_fm_lib.c:1023-1024). */
+	fm->i2s_on = true;
 
 	ret = mtk_wcn_fm_send_tune(fm);
 	if (ret) {
@@ -1642,3 +1651,132 @@ int mtk_wcn_fm_chip_rds(struct mtk_wcn_fm_dev *fm, bool on)
 
 	return ret;
 }
+/*
+ * MT6627 FM I2S audio port.
+ *
+ * The port is enabled by two register writes that the downstream driver
+ * issues on every power up and on every retune:
+ *
+ *	mt6627_write(0x9B, 0xF9AB);  -- FM_REG_AUDIO_CTRL0
+ *	mt6627_host_write(0x80101054, 0x00003f35);  -- host audio ctrl
+ *
+ * (mt6627_fm_lib.c:1023-1024 after a retune, :850-851 in the power up
+ * sequence, :1511,1513 after a soft-mute scan).  The matching disable is what
+ * mt6627_PowerDown()/mt6627_pwrdown() do before the DSP clocks are gated: host
+ * bits 13:14 are cleared (mt6627_fm_lib.c:892-894) and FM_REG_AUDIO_CTRL0 bits
+ * 15:3 are cleared (mt6627_fm_cmd.c:523).  There is no downstream or ROM
+ * register sequence that changes the MT6627 I2S clock mode or sample rate
+ * (mt6627_I2s_Setting() has no body, mt6627_fm_lib.c:88-90,1825-1827), so this
+ * file only ever enables or disables the port.
+ */
+#define FM_MT6627_I2S_CTRL0_ON		0xf9ab	/* mt6627_fm_lib.c:1023 */
+#define FM_MT6627_HOST_AUDIO_ON		0x00003f35 /* mt6627_fm_lib.c:851 */
+/* Bits 13:14: cleared by mt6627_PowerDown(), mt6627_fm_lib.c:893. */
+#define FM_HOST_AUDIO_I2S_MASK		0x00006000
+/* Bits 15:3: cleared by mt6627_pwrdown(), mt6627_fm_cmd.c:523. */
+#define FM_AUDIO_CTRL0_I2S_MASK		0xfff8
+/*
+ * The enable value only sets bit 13 of that field, so the read back comparison
+ * has to use the pattern of the ON value rather than the whole mask.
+ */
+#define FM_HOST_AUDIO_I2S_ON_BITS \
+	(FM_MT6627_HOST_AUDIO_ON & FM_HOST_AUDIO_I2S_MASK)
+
+int mtk_wcn_fm_chip_i2s_set(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	u32 host;
+	int ret;
+
+	if (!fm->powered)
+		return -EAGAIN;
+
+	if (on) {
+		ret = mtk_wcn_fm_reg_write(fm, FM_REG_AUDIO_CTRL0,
+					   FM_MT6627_I2S_CTRL0_ON);
+		if (ret)
+			return ret;
+		ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL,
+					    FM_MT6627_HOST_AUDIO_ON);
+		if (ret)
+			return ret;
+		fm->i2s_on = true;
+		return 0;
+	}
+
+	/* mt6627_PowerDown(), mt6627_fm_lib.c:892-894 */
+	ret = mtk_wcn_fm_host_read(fm, FM_HOST_REG_AUDIO_CTRL, &host);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_host_write(fm, FM_HOST_REG_AUDIO_CTRL,
+				    host & ~FM_HOST_AUDIO_I2S_MASK);
+	if (ret)
+		return ret;
+
+	/* mt6627_pwrdown(), mt6627_fm_cmd.c:523 */
+	ret = mtk_wcn_fm_reg_set_bits(fm, FM_REG_AUDIO_CTRL0, 0x0000,
+				      FM_AUDIO_CTRL0_I2S_MASK);
+	if (ret)
+		return ret;
+
+	fm->i2s_on = false;
+
+	return 0;
+}
+
+int mtk_wcn_fm_chip_i2s_get(struct mtk_wcn_fm_dev *fm, bool *on)
+{
+	u16 ctrl0;
+	u32 host;
+	int ret;
+
+	if (!on)
+		return -EINVAL;
+	if (!fm->powered)
+		return -EAGAIN;
+
+	ret = mtk_wcn_fm_reg_read(fm, FM_REG_AUDIO_CTRL0, &ctrl0);
+	if (ret)
+		return ret;
+	ret = mtk_wcn_fm_host_read(fm, FM_HOST_REG_AUDIO_CTRL, &host);
+	if (ret)
+		return ret;
+
+	*on = (ctrl0 & FM_AUDIO_CTRL0_I2S_MASK) != 0 &&
+	      (host & FM_HOST_AUDIO_I2S_MASK) == FM_HOST_AUDIO_I2S_ON_BITS;
+	fm->i2s_on = *on;
+
+	return 0;
+}
+
+int mtk_wcn_fm_chip_i2s_info(struct mtk_wcn_fm_dev *fm,
+			     struct fm_i2s_info *info)
+{
+	bool on;
+	int ret;
+
+	if (!info)
+		return -EINVAL;
+
+	/* mt6627_fm_config.c:116-118: fixed master / 32 kHz configuration. */
+	info->mode = FM_I2S_MASTER;
+	info->rate = FM_I2S_32K;
+
+	if (!fm->powered) {
+		/*
+		 * The port cannot be on while the FM function is off, and the
+		 * registers are not reachable, so report the known state.
+		 */
+		info->status = FM_I2S_OFF;
+		return 0;
+	}
+
+	ret = mtk_wcn_fm_chip_i2s_get(fm, &on);
+	if (ret) {
+		info->status = FM_I2S_STATE_ERR;
+		return ret;
+	}
+
+	info->status = on ? FM_I2S_ON : FM_I2S_OFF;
+
+	return 0;
+}
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.c b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.c
new file mode 100644
index 000000000..87928e4c6
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.c
@@ -0,0 +1,560 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MediaTek WCN FM radio - MT6627 FM I2S audio path (ALSA SoC codec).
+ *
+ * Port from Samsung/MTK downstream:
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_machine.c:1068-1086
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_pcm_fm_i2s.c:279-323
+ *   sound/soc/mediatek/mt_soc_audio_v3/mt_soc_afe_control.c:2214-2296
+ *   sound/soc/mediatek/mt_soc_audio_v3/AudDrv_Def.h:230-231,302-307,325-343
+ *
+ * Downstream wires the FM I2S port into the single machine card ("mt-snd-card")
+ * with the DAI links "FM_I2S_RX_Playback"/"FM_I2S_RX_Capture", the CPU DAI
+ * "mt-soc-fmi2S-driver" and the codec DAIs "mt-soc-fm-i2s-dai-codec" /
+ * "mt-soc-fm-i2s-dummy-dai-codec".  The data path is the AFE "2nd I2S in"
+ * block, programmed from mtk_pcm_fm_i2s_prepare() as a consumer of the
+ * connectivity I2S clocks (mI2S_SLAVE = Soc_Aud_I2S_SRC_SLAVE_MODE), at a fixed
+ * 32000 Hz, 16 bit words, I2S framing, LRCK not inverted and the input pads
+ * taken from CONNSYS (mI2S_IN_PAD_SEL = false), mt_soc_pcm_fm_i2s.c:303-320,
+ * mt_soc_afe_control.c:2214-2248.
+ *
+ * This file owns the *chip* side of that port: a codec component named
+ * "mt6627-fm-i2s" carrying the DAI "mt-soc-fm-i2s-dai-codec" that enforces the
+ * real MT6627 constraints (master mode, a fixed 32 kHz, 16 bit, stereo I2S
+ * frame) and enables/disables the port through mtk_wcn_fm_chip_i2s_set().
+ * The AP side - the AFE 2nd I2S input, its
+ * connections and the ASRC that downstream used to reach 44.1/48 kHz - belongs
+ * to the audio subsystem and is specified in
+ * $M/logs/rem-wcn-fm-i2s.md ("AUDIO-FRAGMENT"), because this kernel's
+ * mt6735 AFE implements I2S0 only (sound/soc/mediatek/mt6735/mt6735-dai-i2s.c)
+ * and remapping AFE registers from the FM driver would be a second, competing
+ * audio driver.
+ *
+ * This driver registers no sound card.  A card can only be owned by the board
+ * machine driver (mt6735-mt6331-sound), and ASoC binds a component to exactly
+ * one card (soc_probe_component(), soc-core.c:1602-1622), so a second card
+ * that shares the AFE would always fail.  Instead the machine driver references
+ * "mt6627-fm-i2s" as the codec of the FM link; until it does, the component
+ * stays unbound and FM_IOCTL_I2S_SETTING reports -ENODEV.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "mtk_wcn_fm.h"
+
+/*
+ * Codec/DAI name and stream names.  The stream names follow downstream
+ * MT_SOC_FM_I2S_PLAYBACK_STREAM_NAME / MT_SOC_FM_I2S_CAPTURE_STREAM_NAME
+ * (AudDrv_Def.h:342-343) and the DAI name is downstream
+ * MT_SOC_CODEC_FM_I2S_DAI_NAME (AudDrv_Def.h:307), which is the name the
+ * machine link in mt_soc_machine.c:1068-1086 binds.  The component name is new
+ * because this kernel has no MT63xx codec driver: ASoC binds a component by
+ * name, and "mt6627-fm-i2s" is the name the board machine driver has to put in
+ * its FM DAI link (COMP_CODEC("mt6627-fm-i2s", "mt-soc-fm-i2s-dai-codec")).
+ */
+#define MTK_WCN_FM_I2S_CODEC_NAME	"mt6627-fm-i2s"
+#define MTK_WCN_FM_I2S_DAI_NAME		"mt-soc-fm-i2s-dai-codec"
+#define MTK_WCN_FM_I2S_PB_STREAM	"FM_I2S_Playback"
+#define MTK_WCN_FM_I2S_CAP_STREAM	"FM_I2S_Capture"
+
+/*
+ * The MT6627 I2S port is fixed at master mode with a 32000 Hz frame:
+ * mt6627_fm_config.c:116-118 initialises the audio path to FM_AUD_I2S with
+ * i2s_info = {FM_I2S_OFF, FM_I2S_MASTER, FM_I2S_32K}, and the AP side is
+ * configured for mI2S_SAMPLERATE = 32000 with 16 bit words
+ * (mt_soc_pcm_fm_i2s.c:308-312).  No downstream or ROM sequence changes either
+ * (mt6627_I2s_Setting() has no implementation, mt6627_fm_lib.c:88-90,1825-1827).
+ * The port is a stereo I2S frame (mI2S_IN_PAD_SEL = false feeds both pads from
+ * CONNSYS, mt_soc_pcm_fm_i2s.c:306-307); FM mono content is carried inside it
+ * and selected by the chip's mono/stereo control (FM_REG_AUDIO_MONO).
+ */
+#define MTK_WCN_FM_I2S_RATE		32000
+#define MTK_WCN_FM_I2S_CHANNELS		2
+
+/*
+ * The only DAI format the FM link can carry: I2S framing, no BCLK/LRCK
+ * inversion, and the AP side as the bit clock/frame clock consumer while the
+ * MT6627 drives BCLK/LRCK (downstream mI2S_SLAVE = Soc_Aud_I2S_SRC_SLAVE_MODE,
+ * mt_soc_pcm_fm_i2s.c:309).  This kernel's AFE DAI maps
+ * SND_SOC_DAIFMT_CBC_CFC to AFE_I2S_CON_SLAVE (mt6735-dai-i2s.c:79-89) and the
+ * audio machine card spells the same interface the same way
+ * (mt6735-mt6331.c:152-155); the machine link must therefore use this value.
+ */
+#define MTK_WCN_FM_I2S_DAIFMT \
+	(SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC)
+
+struct mtk_wcn_fm_i2s {
+	struct mtk_wcn_fm_dev *fm;
+	/* Serialises the state below and every chip access of this file. */
+	struct mutex lock;
+	/* A card bound the component: a machine link uses this DAI. */
+	bool bound;
+	/* The FM function is powered (mirror of fm->powered). */
+	bool powered;
+	/* Userspace enabled the audio path (FM_IOCTL_I2S_SETTING). */
+	bool route;
+	/* Bitmask of substreams set up with hw_params(). */
+	unsigned int armed;
+	/* Port state last written to the chip. */
+	bool chip_on;
+};
+
+static struct mtk_wcn_fm_i2s *mtk_wcn_fm_i2s_from_component(
+					struct snd_soc_component *component)
+{
+	struct mtk_wcn_fm_dev *fm = snd_soc_component_get_drvdata(component);
+
+	return fm ? fm->i2s : NULL;
+}
+
+/*
+ * The port has to be on while the chip is powered and either userspace asked
+ * for audio or a PCM is set up.  The chip power up sequence enables it anyway
+ * (mtk_wcn_fm_chip.c, mt6627_fm_lib.c:849-851), so the state only has to be
+ * written when it actually differs.  Called with i2s->lock held.
+ */
+static bool mtk_wcn_fm_i2s_wanted(struct mtk_wcn_fm_i2s *i2s)
+{
+	return i2s->powered && (i2s->route || i2s->armed);
+}
+
+/*
+ * Bring the chip port in line with the wanted state.  Called with i2s->lock
+ * held from the sleepable ASoC callbacks (component probe/remove, startup,
+ * hw_params, hw_free, mute) and from the V4L2 paths; never from an atomic
+ * context - the register access goes over STP and sleeps.
+ */
+static int mtk_wcn_fm_i2s_apply_locked(struct mtk_wcn_fm_i2s *i2s, bool force)
+{
+	struct mtk_wcn_fm_dev *fm = i2s->fm;
+	bool on;
+	int ret;
+
+	on = mtk_wcn_fm_i2s_wanted(i2s);
+
+	/*
+	 * fm->i2s_on is the last port state known to the chip layer; the power
+	 * up, retune and power down sequences update it too, which is how a
+	 * retune that re-enabled the port behind our back is caught.
+	 */
+	if (!force && on == i2s->chip_on && on == READ_ONCE(fm->i2s_on))
+		return 0;
+
+	if (!i2s->powered) {
+		/* The chip is off: its registers are gone, nothing to write. */
+		i2s->chip_on = false;
+		return 0;
+	}
+
+	ret = mtk_wcn_fm_chip_i2s_set(fm, on);
+	if (ret) {
+		dev_warn(fm->dev, "FM I2S port %s failed (%d)\n",
+			 on ? "enable" : "disable", ret);
+		return ret;
+	}
+
+	i2s->chip_on = on;
+
+	return 0;
+}
+
+static int mtk_wcn_fm_i2s_apply(struct mtk_wcn_fm_i2s *i2s, bool force)
+{
+	int ret;
+
+	mutex_lock(&i2s->lock);
+	ret = mtk_wcn_fm_i2s_apply_locked(i2s, force);
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+/*
+ * Codec DAI
+ */
+static int mtk_wcn_fm_i2s_dai_startup(struct snd_pcm_substream *substream,
+				      struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	int ret = 0;
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	if (!i2s->powered)
+		ret = -ENODEV;
+	mutex_unlock(&i2s->lock);
+
+	if (ret)
+		dev_dbg(i2s->fm->dev,
+			"FM I2S stream opened while the FM function is off\n");
+
+	return ret;
+}
+
+static int mtk_wcn_fm_i2s_dai_hw_params(struct snd_pcm_substream *substream,
+					struct snd_pcm_hw_params *params,
+					struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	unsigned int rate = params_rate(params);
+	unsigned int channels = params_channels(params);
+	int ret = 0;
+
+	if (!i2s)
+		return -ENODEV;
+
+	if (rate != MTK_WCN_FM_I2S_RATE) {
+		dev_err(i2s->fm->dev,
+			"MT6627 I2S is fixed at %u Hz, %u Hz rejected\n",
+			MTK_WCN_FM_I2S_RATE, rate);
+		return -EINVAL;
+	}
+	if (channels != MTK_WCN_FM_I2S_CHANNELS) {
+		dev_err(i2s->fm->dev,
+			"MT6627 I2S is a stereo frame, %u channels rejected\n",
+			channels);
+		return -EINVAL;
+	}
+	if (params_format(params) != SNDRV_PCM_FORMAT_S16_LE) {
+		dev_err(i2s->fm->dev,
+			"MT6627 I2S is 16 bit, format %u rejected\n",
+			params_format(params));
+		return -EINVAL;
+	}
+
+	mutex_lock(&i2s->lock);
+	if (!i2s->powered) {
+		ret = -ENODEV;
+	} else {
+		i2s->armed |= BIT(substream->stream);
+		ret = mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	}
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+static int mtk_wcn_fm_i2s_dai_hw_free(struct snd_pcm_substream *substream,
+				      struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	int ret;
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	i2s->armed &= ~BIT(substream->stream);
+	ret = mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+/*
+ * shutdown() is the safety net for a stream that was closed without hw_free();
+ * it is idempotent with hw_free().
+ */
+static void mtk_wcn_fm_i2s_dai_shutdown(struct snd_pcm_substream *substream,
+					struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+
+	if (!i2s)
+		return;
+
+	mutex_lock(&i2s->lock);
+	i2s->armed &= ~BIT(substream->stream);
+	mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	mutex_unlock(&i2s->lock);
+}
+
+/*
+ * trigger() runs with the PCM stream lock held (Documentation/sound/kernel-api/
+ * writing-an-alsa-driver.rst:1870-1874: "the trigger callback is atomic"), so
+ * it must not touch the chip.  It only refuses to start a stream on a chip that
+ * has been powered down under it; the port itself is programmed in hw_params().
+ */
+static int mtk_wcn_fm_i2s_dai_trigger(struct snd_pcm_substream *substream,
+				      int cmd, struct snd_soc_dai *dai)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+
+	if (!i2s)
+		return -ENODEV;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+		if (!READ_ONCE(i2s->powered))
+			return -ENODEV;
+		return 0;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int mtk_wcn_fm_i2s_dai_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+
+	if (!i2s)
+		return -ENODEV;
+
+	/*
+	 * Only the fixed MT6627 configuration can be carried: I2S framing, no
+	 * BCLK/LRCK inversion, and the AFE as clock consumer while the chip
+	 * drives the clocks.  Anything else is rejected instead of being
+	 * accepted and ignored, because there is no register that could change
+	 * the chip's I2S mode (see the file header).
+	 */
+	if ((fmt & SND_SOC_DAIFMT_FORMAT_MASK) != SND_SOC_DAIFMT_I2S)
+		return -EOPNOTSUPP;
+	if ((fmt & SND_SOC_DAIFMT_INV_MASK) != SND_SOC_DAIFMT_NB_NF)
+		return -EOPNOTSUPP;
+	if ((fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) !=
+	    SND_SOC_DAIFMT_CBC_CFC)
+		return -EOPNOTSUPP;
+
+	return 0;
+}
+
+static int mtk_wcn_fm_i2s_dai_mute(struct snd_soc_dai *dai, int mute,
+				   int stream)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(dai->component);
+	int ret = 0;
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	if (i2s->powered)
+		ret = mtk_wcn_fm_chip_mute(i2s->fm, mute);
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
+
+static const struct snd_soc_dai_ops mtk_wcn_fm_i2s_dai_ops = {
+	.startup = mtk_wcn_fm_i2s_dai_startup,
+	.shutdown = mtk_wcn_fm_i2s_dai_shutdown,
+	.hw_params = mtk_wcn_fm_i2s_dai_hw_params,
+	.hw_free = mtk_wcn_fm_i2s_dai_hw_free,
+	.trigger = mtk_wcn_fm_i2s_dai_trigger,
+	.set_fmt = mtk_wcn_fm_i2s_dai_set_fmt,
+	.mute_stream = mtk_wcn_fm_i2s_dai_mute,
+};
+
+static struct snd_soc_dai_driver mtk_wcn_fm_i2s_dai = {
+	.name = MTK_WCN_FM_I2S_DAI_NAME,
+	.id = 0,
+	.ops = &mtk_wcn_fm_i2s_dai_ops,
+	.playback = {
+		.stream_name = MTK_WCN_FM_I2S_PB_STREAM,
+		.channels_min = MTK_WCN_FM_I2S_CHANNELS,
+		.channels_max = MTK_WCN_FM_I2S_CHANNELS,
+		.rates = SNDRV_PCM_RATE_32000,
+		.rate_min = MTK_WCN_FM_I2S_RATE,
+		.rate_max = MTK_WCN_FM_I2S_RATE,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.capture = {
+		.stream_name = MTK_WCN_FM_I2S_CAP_STREAM,
+		.channels_min = MTK_WCN_FM_I2S_CHANNELS,
+		.channels_max = MTK_WCN_FM_I2S_CHANNELS,
+		.rates = SNDRV_PCM_RATE_32000,
+		.rate_min = MTK_WCN_FM_I2S_RATE,
+		.rate_max = MTK_WCN_FM_I2S_RATE,
+		.formats = SNDRV_PCM_FMTBIT_S16_LE,
+	},
+	.symmetric_rate = 1,
+	.symmetric_channels = 1,
+	.symmetric_sample_bits = 1,
+};
+
+/*
+ * Component.  No DAPM widgets: the codec holds no analog switch, the whole FM
+ * audio path is the AFE's 2nd I2S input, so the routing the DAI widgets of this
+ * component would drive is empty.
+ */
+static int mtk_wcn_fm_i2s_component_probe(struct snd_soc_component *component)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(component);
+
+	if (!i2s)
+		return -ENODEV;
+
+	mutex_lock(&i2s->lock);
+	i2s->bound = true;
+	mutex_unlock(&i2s->lock);
+
+	dev_info(i2s->fm->dev,
+		 "FM I2S codec bound to sound card \"%s\"\n",
+		 component->card->name);
+
+	return 0;
+}
+
+static void mtk_wcn_fm_i2s_component_remove(struct snd_soc_component *component)
+{
+	struct mtk_wcn_fm_i2s *i2s = mtk_wcn_fm_i2s_from_component(component);
+
+	if (!i2s)
+		return;
+
+	mutex_lock(&i2s->lock);
+	i2s->bound = false;
+	i2s->route = false;
+	i2s->armed = 0;
+	mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	mutex_unlock(&i2s->lock);
+}
+
+static const struct snd_soc_component_driver mtk_wcn_fm_i2s_component = {
+	.name = MTK_WCN_FM_I2S_CODEC_NAME,
+	.probe = mtk_wcn_fm_i2s_component_probe,
+	.remove = mtk_wcn_fm_i2s_component_remove,
+};
+
+/*
+ * FM driver interface
+ */
+int mtk_wcn_fm_i2s_init(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_i2s *i2s;
+	int ret;
+
+	i2s = devm_kzalloc(fm->dev, sizeof(*i2s), GFP_KERNEL);
+	if (!i2s)
+		return -ENOMEM;
+
+	i2s->fm = fm;
+	mutex_init(&i2s->lock);
+	i2s->chip_on = READ_ONCE(fm->i2s_on);
+	fm->i2s = i2s;
+
+	ret = snd_soc_register_component(fm->dev, &mtk_wcn_fm_i2s_component,
+					 &mtk_wcn_fm_i2s_dai, 1);
+	if (ret) {
+		dev_err(fm->dev, "cannot register the FM I2S codec (%d)\n", ret);
+		fm->i2s = NULL;
+		return ret;
+	}
+
+	dev_dbg(fm->dev, "FM I2S codec \"%s\" registered\n",
+		MTK_WCN_FM_I2S_CODEC_NAME);
+
+	return 0;
+}
+
+void mtk_wcn_fm_i2s_exit(struct mtk_wcn_fm_dev *fm)
+{
+	if (!fm->i2s)
+		return;
+
+	/*
+	 * A card that bound this component holds a module reference on this
+	 * driver (snd_soc_component_module_get_when_probe()), so the codec can
+	 * only disappear once that card released it - or when the component was
+	 * never bound, in which case removing it is trivially safe.
+	 */
+	snd_soc_unregister_component_by_driver(fm->dev, &mtk_wcn_fm_i2s_component);
+	fm->i2s = NULL;
+}
+
+/*
+ * mtk_wcn_fm_i2s_power - chip power transition notification.
+ *
+ * Ordering (mtk_wcn_fm_v4l2.c): power_on calls this after
+ * mtk_wcn_fm_chip_power_up() succeeded, power_off calls it before
+ * mtk_wcn_fm_chip_power_down().  The chip layer owns the register sequence in
+ * both directions (the power up sequence enables the port, mt6627_fm_lib.c:
+ * 849-851; the power down sequence clears it, mt6627_fm_lib.c:877-880 and
+ * mt6627_fm_cmd.c:512-517), so this callback only has to keep the ASoC view in
+ * step.  Taking i2s->lock means a stream callback that is already inside
+ * mtk_wcn_fm_i2s_apply_locked() completes before the chip starts powering
+ * down, and no later callback issues a chip access for the dead function.
+ */
+void mtk_wcn_fm_i2s_power(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	struct mtk_wcn_fm_i2s *i2s = fm->i2s;
+
+	if (!i2s)
+		return;
+
+	mutex_lock(&i2s->lock);
+	if (on) {
+		i2s->powered = true;
+		/*
+		 * The power up sequence leaves the port enabled, which is what
+		 * downstream userspace expects; FM_IOCTL_I2S_SETTING(OFF) turns
+		 * it off again.
+		 */
+		i2s->route = true;
+		i2s->armed = 0;
+		i2s->chip_on = true;
+	} else {
+		i2s->powered = false;
+		i2s->route = false;
+		i2s->armed = 0;
+		i2s->chip_on = false;
+	}
+	mutex_unlock(&i2s->lock);
+}
+
+/*
+ * The chip re-enables the I2S port on every retune (mtk_wcn_fm_chip_tune()),
+ * so re-apply the wanted state afterwards.
+ */
+void mtk_wcn_fm_i2s_resync(struct mtk_wcn_fm_dev *fm)
+{
+	struct mtk_wcn_fm_i2s *i2s = fm->i2s;
+
+	if (!i2s)
+		return;
+
+	mtk_wcn_fm_i2s_apply(i2s, false);
+}
+
+int mtk_wcn_fm_i2s_route(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	struct mtk_wcn_fm_i2s *i2s = fm->i2s;
+	int ret = 0;
+
+	if (!i2s)
+		/* Registration failed: the chip side still works. */
+		return mtk_wcn_fm_chip_i2s_set(fm, on);
+
+	mutex_lock(&i2s->lock);
+	if (!i2s->powered) {
+		ret = -EAGAIN;
+	} else if (on && !i2s->bound) {
+		/*
+		 * No machine link uses this codec, so enabling the chip port
+		 * could not produce audio: report the missing link instead of
+		 * succeeding silently.
+		 */
+		ret = -ENODEV;
+	} else {
+		i2s->route = on;
+		ret = mtk_wcn_fm_i2s_apply_locked(i2s, false);
+	}
+	mutex_unlock(&i2s->lock);
+
+	return ret;
+}
diff --git a/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.h b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.h
new file mode 100644
index 000000000..3eec2aa11
--- /dev/null
+++ b/drivers/misc/mediatek/connectivity/fm/mtk_wcn_fm_i2s.h
@@ -0,0 +1,138 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * MediaTek WCN FM radio - MT6627 FM I2S audio path (ALSA SoC codec).
+ *
+ * The MT6627 FM receiver outputs its demodulated audio on the connectivity
+ * "2 wire" I2S port.  Downstream exposes that port as the DAI links
+ * "FM_I2S_RX_Playback"/"FM_I2S_RX_Capture" of the mt-snd-card machine driver
+ * and as the codec DAIs "mt-soc-fm-i2s-dai-codec"/"mt-soc-fm-i2s-dummy-dai-
+ * codec" of the MT63xx codec driver (sound/soc/mediatek/mt_soc_audio_v3/
+ * AudDrv_Def.h:230-231,302-307,325-343, mt_soc_machine.c:1068-1086).  The FM
+ * register sequences only ever enable or disable that port; neither the
+ * downstream source nor the ROM image contains a sequence that changes the
+ * MT6627 I2S clock mode or sample rate (mt6627_I2s_Setting() has no
+ * implementation: declaration and use are both inside #if 0,
+ * mt6627_fm_lib.c:88-90,1825-1827).
+ *
+ * This file declares the kernel-internal interface of the ASoC glue.  When
+ * CONFIG_SND_SOC is disabled the glue is compiled out (see the Makefile) and
+ * the inline fallbacks below keep the FM driver building and running with the
+ * chip level I2S hooks only.
+ *
+ * Copyright (C) 2015 MediaTek Inc.
+ */
+
+#ifndef _MTK_WCN_FM_I2S_H_
+#define _MTK_WCN_FM_I2S_H_
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+
+struct mtk_wcn_fm_dev;
+
+/*
+ * Opaque FM I2S/ASoC state.  One instance per FM device, allocated by
+ * mtk_wcn_fm_i2s_init() and reachable through mtk_wcn_fm_dev.i2s.
+ */
+struct mtk_wcn_fm_i2s;
+
+/*
+ * The ASoC glue can only be used when the sound core is present and linkable
+ * from this driver: built-in code cannot reference the symbols of a modular
+ * snd-soc-core, so a built-in FM driver with SND_SOC=m falls back to the chip
+ * level hooks.  The Makefile implements the same rule for the object list.
+ */
+#define MTK_WCN_FM_ASOC_ENABLED						\
+	(IS_ENABLED(CONFIG_SND_SOC) &&					\
+	 !(IS_BUILTIN(CONFIG_MTK_WCN_FM) && IS_MODULE(CONFIG_SND_SOC)))
+
+#if MTK_WCN_FM_ASOC_ENABLED
+
+/*
+ * mtk_wcn_fm_i2s_init - register the MT6627 FM I2S codec component
+ * @fm: FM device
+ *
+ * Registers a codec component named "mt6627-fm-i2s" carrying the DAI
+ * "mt-soc-fm-i2s-dai-codec" (downstream MT_SOC_CODEC_FM_I2S_DAI_NAME,
+ * AudDrv_Def.h:307).  No sound card is registered: the board machine driver
+ * owns the card, and has to reference this codec in its FM DAI link (see
+ * $M/logs/rem-wcn-fm-i2s.md, "AUDIO-FRAGMENT").  Until it does, the component
+ * stays unbound and FM_IOCTL_I2S_SETTING reports -ENODEV.
+ *
+ * Returns 0 on success, a negative errno otherwise.
+ */
+int mtk_wcn_fm_i2s_init(struct mtk_wcn_fm_dev *fm);
+
+/*
+ * mtk_wcn_fm_i2s_exit - unregister the codec component
+ * @fm: FM device
+ */
+void mtk_wcn_fm_i2s_exit(struct mtk_wcn_fm_dev *fm);
+
+/*
+ * mtk_wcn_fm_i2s_power - notify the ASoC glue about an FM power transition
+ * @on: true after a successful chip power up, false before a chip power down
+ *
+ * Only bookkeeping: the chip layer programs the port in both directions.  Call
+ * with @on == true after mtk_wcn_fm_chip_power_up() and with @on == false
+ * before mtk_wcn_fm_chip_power_down() so that no stream callback can reach the
+ * chip while it is powering down.
+ */
+void mtk_wcn_fm_i2s_power(struct mtk_wcn_fm_dev *fm, bool on);
+
+/*
+ * mtk_wcn_fm_i2s_resync - re-apply the wanted port state
+ * @fm: FM device
+ *
+ * Called after mtk_wcn_fm_chip_tune(), which re-enables the chip I2S port.
+ */
+void mtk_wcn_fm_i2s_resync(struct mtk_wcn_fm_dev *fm);
+
+/*
+ * mtk_wcn_fm_i2s_route - apply an FM_IOCTL_I2S_SETTING request
+ * @fm: FM device
+ * @on: true for FM_I2S_ON, false for FM_I2S_OFF
+ *
+ * Programs the chip port through mtk_wcn_fm_chip_i2s_set() and keeps the
+ * route state used by the stream callbacks in step.  Returns 0 on success,
+ * -ENODEV when @on is requested but no machine link bound the codec (the
+ * request is then rejected instead of enabling a port that cannot produce
+ * audio) and the negative errno of the chip access otherwise.
+ */
+int mtk_wcn_fm_i2s_route(struct mtk_wcn_fm_dev *fm, bool on);
+
+#else /* !MTK_WCN_FM_ASOC_ENABLED */
+
+/* Provided by mtk_wcn_fm_chip.c; also declared by mtk_wcn_fm.h. */
+int mtk_wcn_fm_chip_i2s_set(struct mtk_wcn_fm_dev *fm, bool on);
+
+static inline int mtk_wcn_fm_i2s_init(struct mtk_wcn_fm_dev *fm)
+{
+	return -EOPNOTSUPP;
+}
+
+static inline void mtk_wcn_fm_i2s_exit(struct mtk_wcn_fm_dev *fm)
+{
+}
+
+static inline void mtk_wcn_fm_i2s_power(struct mtk_wcn_fm_dev *fm, bool on)
+{
+}
+
+static inline void mtk_wcn_fm_i2s_resync(struct mtk_wcn_fm_dev *fm)
+{
+}
+
+/*
+ * Without ASoC there is no route to keep in step, but the chip port itself is
+ * still controllable: the ioctl keeps programming the real registers.
+ */
+static inline int mtk_wcn_fm_i2s_route(struct mtk_wcn_fm_dev *fm, bool on)
+{
+	return mtk_wcn_fm_chip_i2s_set(fm, on);
+}
+
+#endif /* MTK_WCN_FM_ASOC_ENABLED */
+
+#endif /* _MTK_WCN_FM_I2S_H_ */
