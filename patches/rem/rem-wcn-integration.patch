+
 /*
  * Largest frame the firmware can hand up: CFG_RX_MAX_PKT_SIZE,
  * config.h:1179 (28 + 2312 + 12).
  */
 #define MTK_WLAN_RX_MAX_PKT_SIZE	2352
 
