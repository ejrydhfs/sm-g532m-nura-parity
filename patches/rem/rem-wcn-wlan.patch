@@ -198,6 +212,7 @@ struct mtk_wlan_hif {
 	u8 cmd_seq;
 	struct mutex io_lock;		/* serializes port/DMA transactions */
 	struct mutex state_lock;	/* serializes bring-up and teardown */
+	struct mtk_wlan_mac *mac;	/* 802.11 MAC/cfg80211 instance */
