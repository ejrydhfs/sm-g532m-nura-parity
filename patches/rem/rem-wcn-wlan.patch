+/*
+ * Traffic classes, nic_tx.h:357-363.  TC0..TC3 carry WMM access categories
+ * on HIF TX port 0, TC4 carries commands and management frames on port 1,
+ * TC5 carries broadcast/data frames that have no peer record.
+ */
+enum mtk_wlan_tc {
+	MTK_WLAN_TC0 = 0,
+	MTK_WLAN_TC1,
+	MTK_WLAN_TC2,
+	MTK_WLAN_TC3,
+	MTK_WLAN_TC4,
+	MTK_WLAN_TC5,
+	MTK_WLAN_TC_NUM
+};
