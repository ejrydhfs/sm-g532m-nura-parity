+/*
+ * Convert an RCPI value from the HIF RX header to dBm.  RCPI_TO_dBm()
+ * mac.h:2533-2534 with RCPI_HIGH_BOUND (220) and NDBM_LOW_BOUND_FOR_RCPI
+ * (110) from mac.h:265-267.
+ */
+static inline int mtk_wlan_rcpi_to_dbm(u8 rcpi)
+{
+	if (rcpi > 220)
+		rcpi = 220;
+	return (rcpi >> 1) - 110;
+}
