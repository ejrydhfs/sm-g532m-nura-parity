+# SPDX-License-Identifier: GPL-2.0
+#
+# seninf-dphy-extract: offline evidence extractor for the MT6735 SENINF
+# CSI-2 / MIPI D-PHY register programming of the vendor camera HAL
+# (libcam.halsensor.so).  Host tool, never part of kernel or device runtime.
+#
+#   make            build build/seninf-dphy-extract
+#   make check      run it against $(SENINF_LIB) and verify the proof addresses
+#   make clean
+#
+# The extractor needs a disassembly of the library.  $(OBJDUMP) is used to
+# produce it; any objdump that understands ARM/Thumb-2 works, for example
+#   OBJDUMP="$(M)/llvmpkg/usr/bin/llvm-objdump --triple=thumbv7-none-eabi -d"
+# The default path is the vendor library of this device.  When either the
+# library or the disassembler is unavailable, `make check` skips instead of
+# pretending to pass.
+
+CC ?= gcc
+CFLAGS ?= -O2
+CFLAGS += -Wall -Wextra -std=gnu11
+BUILD := build
+
+SENINF_LIB ?= /run/media/asdf/30620d0d-1e41-4d55-af08-b4de2fb9c517/g532m_work/zip/vendor-libs/libcam.halsensor.so
+OBJDUMP ?= llvm-objdump
+
+BIN := $(BUILD)/seninf-dphy-extract
+DIS := $(BUILD)/libcam.halsensor.dis
+LOG := $(BUILD)/extract.log
+
+all: $(BIN)
+
+$(BUILD):
+	mkdir -p $(BUILD)
+
+$(BIN): seninf-dphy-extract.c | $(BUILD)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)
+
+check: $(BIN)
+	@if [ ! -f "$(SENINF_LIB)" ]; then \
+		echo "SKIP: $(SENINF_LIB) not present"; exit 0; \
+	fi
+	@if ! command -v $(firstword $(OBJDUMP)) >/dev/null 2>&1; then \
+		echo "SKIP: $(firstword $(OBJDUMP)) not available"; exit 0; \
+	fi
+	$(OBJDUMP) -d $(SENINF_LIB) > $(DIS)
+	./$(BIN) $(SENINF_LIB) $(DIS) > $(LOG)
+	@echo "--- window proofs ---"
+	@grep -E '^(  \[this|  (ISP|SENINF|PLL|MIPI_ANA|GPIO) )' $(LOG) || true
+	@echo "--- CSI-2 stores ---"
+	@grep -E '^  0x0001[0-9a-f]{4} (SENINF|MIPI_ANA)' $(LOG) || true
+	@if grep -q 'PROOF MISMATCH' $(LOG); then \
+		echo "FAIL: a documented proof address moved"; exit 1; \
+	fi
+	@echo "OK: all proof addresses verified ($(LOG))"
+
+clean:
+	rm -rf $(BUILD)
+
+.PHONY: all check clean
diff --git a/tools/mediatek/camera/seninf-dphy/seninf-dphy-extract.c b/tools/mediatek/camera/seninf-dphy/seninf-dphy-extract.c
new file mode 100644
index 000000000..7a62c5c19
--- /dev/null
+++ b/tools/mediatek/camera/seninf-dphy/seninf-dphy-extract.c
@@ -0,0 +1,1569 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * seninf-dphy-extract - offline evidence extractor for the MT6735 SENINF
+ * CSI-2 / MIPI D-PHY register programming of the vendor camera HAL.
+ *
+ * The MT6735 SENINF CSI-2 receiver and MIPI D-PHY are programmed by the
+ * proprietary userspace component "seninf_drv", which ships as
+ * libcam.halsensor.so (class SeninfDrvImp).  The downstream GPL kernel source
+ * contains no equivalent, so the register programming of the driver in
+ * drivers/media/platform/mediatek/seninf/ had to be recovered from that
+ * binary.  This tool reproduces that recovery: it reads the library and a
+ * disassembly of it, and prints, for every store instruction of the relevant
+ * functions, the destination window, the window relative and absolute MMIO
+ * address, the value expression and the instruction address that proves it.
+ *
+ * Values the tool cannot derive are printed as "<unprovable>"; nothing is
+ * guessed and nothing is filled in.  The tool is an offline analysis aid: it
+ * is never used at kernel runtime and it does not touch hardware.
+ *
+ * Usage:
+ *   seninf-dphy-extract <libcam.halsensor.so> <disassembly.txt>
+ *
+ * The disassembly must be produced with
+ *   llvm-objdump -d --triple=thumbv7-none-eabi libcam.halsensor.so
+ * (any objdump that prints " <addr>: <hex bytes> <mnemonic> <operands>" lines
+ * works).  The tool fails loudly if a documented proof address does not hold
+ * the instruction it is supposed to hold.
+ *
+ * Copyright (C) 2026
+ */
+
+#define _GNU_SOURCE
+#include <ctype.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define EXPR_LEN 128
+#define MAX_WIN 8
+#define MAX_INSN 8192
+#define MAX_STACK 1024
+
+/* ------------------------------------------------------------------ */
+/* ELF image                                                          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * All expression formatting goes through a va_list formatter: the buffers are
+ * deliberately fixed size and truncated, which is fine for a diagnostic string
+ * but would trip -Wformat-truncation at every literal call site.
+ */
+static void set_fmt(char *dst, size_t sz, const char *fmt, ...)
+{
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(dst, sz, fmt, ap);
+	va_end(ap);
+}
+
+
+
+struct section {
+	char name[32];
+	uint32_t addr;
+	uint32_t off;
+	uint32_t size;
+	bool alloc;
+};
+
+struct symbol {
+	char name[128];
+	uint32_t addr;
+	uint32_t size;
+};
+
+struct elf {
+	const uint8_t *data;
+	size_t len;
+	struct section sec[40];
+	unsigned int nsec;
+	struct symbol sym[256];
+	unsigned int nsym;
+};
+
+static uint32_t rd32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint16_t rd16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static bool elf_load(struct elf *e, const char *path)
+{
+	FILE *f = fopen(path, "rb");
+	long size;
+	uint32_t shoff, shnum, shstrndx, symtab = 0, strtab = 0;
+	unsigned int i;
+
+	memset(e, 0, sizeof(*e));
+	if (!f) {
+		fprintf(stderr, "cannot open %s: %s\n", path, strerror(errno));
+		return false;
+	}
+	if (fseek(f, 0, SEEK_END) || (size = ftell(f)) < 0 ||
+	    fseek(f, 0, SEEK_SET)) {
+		fprintf(stderr, "cannot size %s\n", path);
+		fclose(f);
+		return false;
+	}
+	e->data = malloc((size_t)size);
+	if (!e->data || fread((void *)e->data, 1, (size_t)size, f) != (size_t)size) {
+		fprintf(stderr, "cannot read %s\n", path);
+		fclose(f);
+		return false;
+	}
+	fclose(f);
+	e->len = (size_t)size;
+
+	if (e->len < 52 || memcmp(e->data, "\177ELF", 4) != 0 ||
+	    e->data[4] != 1 /* ELFCLASS32 */) {
+		fprintf(stderr, "%s: not an ELF32 file\n", path);
+		return false;
+	}
+	if (rd16(e->data + 18) != 40 /* EM_ARM */) {
+		fprintf(stderr, "%s: not an ARM file\n", path);
+		return false;
+	}
+
+	shoff = rd32(e->data + 32);
+	shnum = rd16(e->data + 48);
+	shstrndx = rd16(e->data + 50);
+	if (shoff + shnum * 40 > e->len || shnum > ARRAY_SIZE(e->sec)) {
+		fprintf(stderr, "%s: implausible section table\n", path);
+		return false;
+	}
+	e->nsec = shnum;
+	for (i = 0; i < shnum; i++) {
+		const uint8_t *sh = e->data + shoff + i * 40;
+
+		e->sec[i].addr = rd32(sh + 12);
+		e->sec[i].off = rd32(sh + 16);
+		e->sec[i].size = rd32(sh + 20);
+		e->sec[i].alloc = (rd32(sh + 8) & 0x2) != 0;
+		e->sec[i].name[0] = '\0';
+	}
+
+	/* Section names can only be resolved once every section header is read. */
+	if (shstrndx < shnum) {
+		uint32_t so = e->sec[shstrndx].off;
+
+		for (i = 0; i < shnum; i++) {
+			uint32_t nameoff = rd32(e->data + shoff + i * 40);
+			size_t n = 0;
+
+			while (so + nameoff + n < e->len &&
+			       e->data[so + nameoff + n] &&
+			       n < sizeof(e->sec[i].name) - 1) {
+				e->sec[i].name[n] =
+					(char)e->data[so + nameoff + n];
+				n++;
+			}
+			e->sec[i].name[n] = '\0';
+			if (!strcmp(e->sec[i].name, ".dynsym"))
+				symtab = i;
+		}
+	}
+
+	if (symtab) {
+		uint32_t strndx = rd32(e->data + shoff + symtab * 40 + 24);
+		uint32_t count = e->sec[symtab].size / 16;
+		unsigned int j;
+		const struct section *st = &e->sec[symtab];
+
+		if (strndx < shnum) {
+			strtab = e->sec[strndx].off;
+			for (j = 0; j < count && e->nsym < ARRAY_SIZE(e->sym); j++) {
+				const uint8_t *s = e->data + st->off + j * 16;
+				uint32_t nameoff = rd32(s);
+				uint32_t addr = rd32(s + 4);
+				uint32_t sz = rd32(s + 8);
+				size_t n = 0;
+
+				if (!addr || st->off + j * 16 + 16 > e->len)
+					continue;
+				while (strtab + nameoff + n < e->len &&
+				       e->data[strtab + nameoff + n] && n < sizeof(e->sym[e->nsym].name) - 1) {
+					e->sym[e->nsym].name[n] =
+						(char)e->data[strtab + nameoff + n];
+					n++;
+				}
+				e->sym[e->nsym].name[n] = '\0';
+				e->sym[e->nsym].addr = addr & ~1U;	/* drop Thumb bit */
+				e->sym[e->nsym].size = sz;
+				e->nsym++;
+			}
+		}
+	}
+
+	if (!e->nsym) {
+		fprintf(stderr, "%s: no .dynsym\n", path);
+		return false;
+	}
+	return true;
+}
+
+/* Map a virtual address to a file offset. */
+static const uint8_t *vaddr_to_ptr(const struct elf *e, uint32_t addr, size_t need)
+{
+	unsigned int i;
+
+	for (i = 0; i < e->nsec; i++) {
+		const struct section *s = &e->sec[i];
+
+		if (!s->alloc || addr < s->addr)
+			continue;
+		if (addr - s->addr + need > s->size)
+			continue;
+		if (s->off + (addr - s->addr) + need > e->len)
+			continue;
+		return e->data + s->off + (addr - s->addr);
+	}
+	return NULL;
+}
+
+static const struct symbol *find_sym(const struct elf *e, const char *name)
+{
+	unsigned int i;
+
+	for (i = 0; i < e->nsym; i++)
+		if (!strcmp(e->sym[i].name, name))
+			return &e->sym[i];
+	return NULL;
+}
+
+/* Print a C string stored in .rodata, or NULL when the address is not text. */
+static const char *rodata_str(const struct elf *e, uint32_t addr)
+{
+	const uint8_t *p = vaddr_to_ptr(e, addr, 1);
+	static char buf[160];
+	size_t n = 0;
+
+	if (!p || !isprint(*p))
+		return NULL;
+	while (n < sizeof(buf) - 1 && p[n] && isprint(p[n])) {
+		buf[n] = (char)p[n];
+		n++;
+	}
+	buf[n] = '\0';
+	return n > 1 ? buf : NULL;
+}
+
+/* ------------------------------------------------------------------ */
+/* Disassembly                                                        */
+/* ------------------------------------------------------------------ */
+
+struct insn {
+	uint32_t addr;
+	char mnem[16];
+	char ops[128];
+};
+
+struct disasm {
+	struct insn *v;
+	unsigned int n;
+};
+
+static int insn_cmp(const void *a, const void *b)
+{
+	const struct insn *x = a, *y = b;
+
+	return x->addr < y->addr ? -1 : (x->addr > y->addr ? 1 : 0);
+}
+
+static bool disasm_load(struct disasm *d, const char *path)
+{
+	FILE *f = fopen(path, "r");
+	char line[512];
+	unsigned int cap = 4096;
+
+	if (!f) {
+		fprintf(stderr, "cannot open %s: %s\n", path, strerror(errno));
+		return false;
+	}
+	d->v = calloc(cap, sizeof(*d->v));
+	if (!d->v) {
+		fclose(f);
+		return false;
+	}
+
+	while (fgets(line, sizeof(line), f)) {
+		char *p = strchr(line, ':');
+		char *q;
+		unsigned long addr;
+		size_t n;
+
+		if (!p || (!isxdigit((unsigned char)line[0]) &&
+			   !isspace((unsigned char)line[0])))
+			continue;
+		errno = 0;
+		addr = strtoul(line, NULL, 16);
+		if (errno || addr > 0xffffffffUL)
+			continue;
+
+		/* Skip the hex byte column that objdump prints after the colon. */
+		for (q = p + 1; *q && (isxdigit((unsigned char)*q) || *q == ' '); q++)
+			;
+		while (*q == ' ' || *q == '\t')
+			q++;
+		if (!*q)
+			continue;
+
+		if (d->n == cap) {
+			struct insn *nv;
+
+			cap *= 2;
+			nv = realloc(d->v, cap * sizeof(*d->v));
+			if (!nv) {
+				fclose(f);
+				return false;
+			}
+			d->v = nv;
+		}
+
+		n = 0;
+		while (*q && !isspace((unsigned char)*q) && n < sizeof(d->v[d->n].mnem) - 1)
+			d->v[d->n].mnem[n++] = *q++;
+		d->v[d->n].mnem[n] = '\0';
+		while (*q == ' ' || *q == '\t')
+			q++;
+
+		/* Drop a trailing comment ("@ 0x1234 <sym>"). */
+		{
+			char *at = strstr(q, " @");
+			if (at)
+				*at = '\0';
+		}
+		n = strlen(q);
+		while (n && (q[n - 1] == '\n' || q[n - 1] == ' ' || q[n - 1] == '\t'))
+			q[--n] = '\0';
+		set_fmt(d->v[d->n].ops, sizeof(d->v[d->n].ops), "%s", q);
+		d->v[d->n].addr = (uint32_t)addr;
+		d->n++;
+	}
+	fclose(f);
+
+	qsort(d->v, d->n, sizeof(*d->v), insn_cmp);
+	return d->n > 0;
+}
+
+static const struct insn *insn_at(const struct disasm *d, uint32_t addr)
+{
+	unsigned int lo = 0, hi = d->n;
+
+	while (lo < hi) {
+		unsigned int mid = (lo + hi) / 2;
+
+		if (d->v[mid].addr == addr)
+			return &d->v[mid];
+		if (d->v[mid].addr < addr)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return NULL;
+}
