+/* ------------------------------------------------------------------ */
+/* MMIO windows                                                       */
+/* ------------------------------------------------------------------ */
+
+struct window {
+	const char *name;
+	uint32_t base;
+	uint32_t len;
+	/* proof of the length: instruction holding the immediate */
+	uint32_t proof;
+	const char *proof_expect;
+	/* proof of the base: literal pool slot holding it (0 when immediate) */
+	uint32_t lit_addr;
+};
+
+/*
+ * The five mmap() calls of SeninfDrvImp::init() and the derived per-instance
+ * pointers.  Every entry carries the address of the instruction that sets the
+ * immediate it is built from; verify_windows() checks each one.
+ */
+static const struct window windows[] = {
+	{ "ISP",      0x15000000, 0xa000, 0x18176, "mov.w\tr1, #0xa000", 0 },
+	{ "ISP",      0x15000000, 0xa000, 0x1816a, "mov.w\tr2, #0x15000000", 0 },
+	{ "SENINF",   0x15008000, 0x4000, 0x181b0, "mov.w\tr1, #0x4000", 0x18404 },
+	{ "PLL",      0x10000000, 0x100,  0x18200, "mov.w\tr1, #0x100", 0 },
+	{ "PLL",      0x10000000, 0x100,  0x181f4, "mov.w\tr2, #0x10000000", 0 },
+	{ "MIPI_ANA", 0x10215000, 0x3000, 0x1823e, "mov.w\tr1, #0x3000", 0x18408 },
+	{ "GPIO",     0x10211000, 0x1000, 0x18288, "mov.w\tr1, #0x1000", 0x1840c },
+};
+
+/* this-offsets holding a mapped window pointer (init() @0x18180..0x18356) */
+struct member {
+	const char *name;
+	uint32_t member;
+	const struct window *win;
+	uint32_t proof;
+	const char *proof_expect;
+};
+
+static const struct member members[] = {
+	{ "ISP",      0x14, &windows[0], 0x18180, "str\tr0, [r4, #0x14]" },
+	{ "SENINF",   0x18, &windows[2], 0x181c4, "str\tr0, [r4, #0x18]" },
+	{ "GPIO",     0x38, &windows[6], 0x1829a, "str\tr0, [r4, #0x38]" },
+	{ "MIPI_ANA", 0x28, &windows[5], 0x18250, "str\tr0, [r4, #0x28]" },
+	{ "PLL",      0x3c, &windows[3], 0x1820a, "str\tr0, [r4, #0x3c]" },
+};
+
+/* Derived pointers: [this+0x24] = [this+0x28] + 0x800, etc. */
+struct derived {
+	const char *name;
+	uint32_t member;
+	uint32_t from;
+	uint32_t add;
+	uint32_t proof;
+	const char *proof_expect;
+};
+
+static const struct derived derived_members[] = {
+	{ "MIPI_ANA+0x800", 0x24, 0x28, 0x800, 0x1827e, "add.w\tr1, r0, #0x800" },
+	{ "MIPI_ANA+0x800", 0x2c, 0x24, 0x000, 0x18348, "str\tr6, [r4, #0x2c]" },
+	{ "MIPI_ANA+0xc00", 0x30, 0x24, 0x400, 0x1834a, "add.w\tr0, r6, #0x400" },
+	{ "MIPI_ANA+0x1000", 0x34, 0x24, 0x800, 0x18350, "add.w\tr5, r6, #0x800" },
+	{ "GPIO+0x970",     0x1c, 0x38, 0x970, 0x182c8, "add.w\tr2, r0, #0x970" },
+	{ "PLL+0x60",       0x40, 0x3c, 0x060, 0x182d0, "adds\tr1, #0x60" },
+};
+
+static bool verify_windows(const struct elf *e, const struct disasm *d)
+{
+	unsigned int i;
+	bool ok = true;
+
+	printf("== mapped windows (SeninfDrvImp::init) ==\n");
+	for (i = 0; i < ARRAY_SIZE(windows); i++) {
+		const struct window *w = &windows[i];
+		const struct insn *in = insn_at(d, w->proof);
+		const uint8_t *lit = w->lit_addr ?
+			vaddr_to_ptr(e, w->lit_addr, 4) : NULL;
+		char want[64];
+		bool base_ok = true;
+
+		if (w->lit_addr)
+			base_ok = lit && rd32(lit) == w->base;
+		set_fmt(want, sizeof(want), "%s\t%s", in ? in->mnem : "?", in ? in->ops : "");
+		if (!in || !strstr(want, strchr(w->proof_expect, '\t') ?
+				   strchr(w->proof_expect, '\t') + 1 : w->proof_expect) ||
+		    !base_ok) {
+			printf("  %-9s base 0x%08x len 0x%05x  PROOF MISMATCH at 0x%x (%s)%s\n",
+			       w->name, w->base, w->len, w->proof, in ? want : "missing",
+			       base_ok ? "" : " base literal mismatch");
+			ok = false;
+			continue;
+		}
+		printf("  %-9s base 0x%08x len 0x%05x  proof 0x%x: %s%s\n",
+		       w->name, w->base, w->len, w->proof, want,
+		       w->lit_addr ? " (base from literal pool)" : "");
+	}
+
+	printf("== windows bound to SeninfDrvImp members ==\n");
+	for (i = 0; i < ARRAY_SIZE(members); i++) {
+		const struct member *m = &members[i];
+		const struct insn *in = insn_at(d, m->proof);
+		char want[64];
+
+		set_fmt(want, sizeof(want), "%s\t%s", in ? in->mnem : "?", in ? in->ops : "");
+		if (!in || !strstr(want, m->proof_expect)) {
+			printf("  [this+0x%02x] = %-12s PROOF MISMATCH at 0x%x\n",
+			       m->member, m->name, m->proof);
+			ok = false;
+			continue;
+		}
+		printf("  [this+0x%02x] = %-12s (0x%08x + 0x%x)  proof %s\n",
+		       m->member, m->name, m->win->base, m->win->len, want);
+	}
+
+	printf("== derived per-instance pointers ==\n");
+	for (i = 0; i < ARRAY_SIZE(derived_members); i++) {
+		const struct derived *x = &derived_members[i];
+		const struct insn *in = insn_at(d, x->proof);
+		char want[64];
+
+		set_fmt(want, sizeof(want), "%s\t%s", in ? in->mnem : "?", in ? in->ops : "");
+		if (!in || !strstr(want, x->proof_expect)) {
+			printf("  [this+0x%02x] = %-14s PROOF MISMATCH at 0x%x\n",
+			       x->member, x->name, x->proof);
+			ok = false;
+			continue;
+		}
+		printf("  [this+0x%02x] = %-14s ([this+0x%02x] + 0x%x)  proof 0x%x: %s\n",
+		       x->member, x->name, x->from, x->add, x->proof, want);
+	}
+	printf("\n");
+
+	return ok;
+}
+
+/*
+ * Combined map of the pointers held by a SeninfDrvImp instance: the five
+ * mmap() results and the per-instance pointers derived from them.
+ */
+struct ptrent {
+	const char *name;
+	uint32_t member;
+	uint32_t base;
+	uint32_t span;
+};
+
+static struct ptrent ptr_map[16];
+static unsigned int ptr_n;
+
+static void build_ptr_map(void)
+{
+	unsigned int i;
+
+	ptr_n = 0;
+	for (i = 0; i < ARRAY_SIZE(members); i++) {
+		ptr_map[ptr_n].name = members[i].name;
+		ptr_map[ptr_n].member = members[i].member;
+		ptr_map[ptr_n].base = members[i].win->base;
+		ptr_map[ptr_n].span = members[i].win->len;
+		ptr_n++;
+	}
+	for (i = 0; i < ARRAY_SIZE(derived_members); i++) {
+		const struct derived *x = &derived_members[i];
+		unsigned int j;
+		uint32_t base = 0, span = 0;
+
+		for (j = 0; j < ptr_n; j++) {
+			if (ptr_map[j].member == x->from) {
+				base = ptr_map[j].base + x->add;
+				span = ptr_map[j].span - x->add;
+				break;
+			}
+		}
+		ptr_map[ptr_n].name = x->name;
+		ptr_map[ptr_n].member = x->member;
+		ptr_map[ptr_n].base = base;
+		ptr_map[ptr_n].span = span;
+		ptr_n++;
+	}
+}
+
+static int member_index(uint32_t off)
+{
+	unsigned int i;
+
+	for (i = 0; i < ptr_n; i++)
+		if (ptr_map[i].member == off)
+			return (int)i;
+	return -1;
+}
+
+static const char *win_name(int win)
+{
+	return (win >= 0 && win < (int)ptr_n) ? ptr_map[win].name : "?";
+}
+
+static uint32_t win_base(int win)
+{
+	return (win >= 0 && win < (int)ptr_n) ? ptr_map[win].base : 0;
+}
+/* ------------------------------------------------------------------ */
+/* Symbolic interpreter                                               */
+/* ------------------------------------------------------------------ */
+
+enum kind {
+	K_UNK,		/* not derivable */
+	K_CONST,	/* integer constant */
+	K_WIN,		/* pointer into a mapped window */
+	K_ARG,		/* function argument */
+	K_SYM,		/* pointer to a .rodata string */
+};
+
+struct val {
+	enum kind kind;
+	long long c;
+	int win;
+	char e[EXPR_LEN];
+};
+
+static struct val v_unk(const char *fmt, ...)
+{
+	struct val v;
+	va_list ap;
+
+	memset(&v, 0, sizeof(v));
+	v.kind = K_UNK;
+	va_start(ap, fmt);
+	vsnprintf(v.e, sizeof(v.e), fmt, ap);
+	va_end(ap);
+	return v;
+}
+
+static struct val v_const(long long c)
+{
+	struct val v;
+
+	memset(&v, 0, sizeof(v));
+	v.kind = K_CONST;
+	v.c = c;
+	set_fmt(v.e, sizeof(v.e), "0x%llx", (unsigned long long)c);
+	return v;
+}
+
+static struct val v_win(int win, long long off)
+{
+	struct val v;
+
+	memset(&v, 0, sizeof(v));
+	v.kind = K_WIN;
+	v.win = win;
+	v.c = off;
+	set_fmt(v.e, sizeof(v.e), "[this+0x%02x]%+lld",
+		 (win >= 0 && win < (int)ptr_n) ? ptr_map[win].member : 0, off);
+	return v;
+}
+
+static struct val v_arg(int n)
+{
+	struct val v;
+
+	memset(&v, 0, sizeof(v));
+	v.kind = K_ARG;
+	v.c = n;
+	set_fmt(v.e, sizeof(v.e), "arg%d", n);
+	return v;
+}
+
+static struct val v_sym(uint32_t addr, const char *str)
+{
+	struct val v;
+
+	memset(&v, 0, sizeof(v));
+	v.kind = K_SYM;
+	v.c = addr;
+	set_fmt(v.e, sizeof(v.e), "\"%.120s\"", str);
+	return v;
+}
+
+
+/* Number of operands, ignoring separators inside [] or {}. */
+static int count_ops(const char *ops)
+{
+	int n = 1, depth = 0;
+
+	for (; *ops; ops++) {
+		if (*ops == '[' || *ops == '{')
+			depth++;
+		else if ((*ops == ']' || *ops == '}') && depth)
+			depth--;
+		else if (*ops == ',' && !depth)
+			n++;
+	}
+	return *ops == '\0' && n > 0 ? n : n;
+}
+
+/* Value of an immediate operand such as "#0x1e" or "#-0x4". */
+static bool imm_value(const char *s, long long *out)
+{
+	char *end;
+	long long v;
+
+	while (*s == ' ')
+		s++;
+	if (*s != '#')
+		return false;
+	s++;
+	errno = 0;
+	v = strtoll(s, &end, 0);
+	if (end == s || errno)
+		return false;
+	*out = v;
+	return true;
+}
+
+/* Register name to index, -1 if not a plain register. */
+static int reg_index(const char *s, size_t len)
+{
+	char b[8];
+	int n;
+
+	if (len == 0 || len >= sizeof(b))
+		return -1;
+	memcpy(b, s, len);
+	b[len] = '\0';
+	if (!strcmp(b, "sp"))
+		return 13;
+	if (!strcmp(b, "lr"))
+		return 14;
+	if (!strcmp(b, "pc"))
+		return 15;
+	if (b[0] != 'r')
+		return -1;
+	n = atoi(b + 1);
+	return (n >= 0 && n <= 12) ? n : -1;
+}
+
+
+struct frame {
+	const struct elf *elf;
+	const struct disasm *dis;
+	const char *fname;
+	struct val r[16];
+	struct val stack[MAX_STACK];
+	long long sp_key_base;	/* -frame */
+	bool stack_valid[MAX_STACK];
+	/* condition tracking */
+	char last_cmp[96];
+	char it_cond[24];
+	int it_left;
+	int it_idx;
+	int this_reg;		/* register that still holds "this" */
+	bool this_moved;
+	unsigned int dead_writes;
+	/* conditional branch targets reached later in the linear sweep */
+	struct {
+		uint32_t addr;
+		struct val r[16];
+	} target[32];
+	int ntarget;
+	unsigned int stores;
+};
+
+static int slot_of(long long key)
+{
+	long long idx = (key + 2048) / 4;
+
+	if (idx < 0 || idx >= MAX_STACK || (key & 3))
+		return -1;
+	return (int)idx;
+}
+
+static struct val get_reg(struct frame *f, int r)
+{
+	if (r < 0 || r > 15)
+		return v_unk("<bad reg>");
+	return f->r[r];
+}
+
+static void set_reg(struct frame *f, int r, struct val v)
+{
+	if (r < 0 || r > 15)
+		return;
+	/*
+	 * The object pointer ("this") is loaded once and then kept in one
+	 * register for the whole function.  The inline error handling of these
+	 * functions reloads that register from unrelated pointers; those writes
+	 * belong to branches that are not taken on a successful call, so they
+	 * are dropped (and counted) instead of corrupting the window base.
+	 */
+	if (r == f->this_reg && !(v.kind == K_ARG && v.c == 0)) {
+		f->dead_writes++;
+		return;
+	}
+	f->r[r] = v;
+}
+
+static void clobber(struct frame *f)
+{
+	int i;
+
+	for (i = 0; i <= 3; i++)
+		f->r[i] = v_unk("<call>");
+	f->r[12] = v_unk("<call>");
+	f->r[14] = v_unk("<call>");
+}
+
+static void emit_store(struct frame *f, struct val base, long long off,
+		       struct val val, uint32_t addr, const char *insn_text)
+{
+	f->stores++;
+	if (base.kind == K_WIN) {
+		uint32_t abs = win_base(base.win) + (uint32_t)(base.c + off);
+
+		printf("  0x%08x %-12s + 0x%03llx = 0x%08x  <=  %s\n",
+		       addr, win_name(base.win), (unsigned long long)(base.c + off),
+		       abs, val.e);
+	} else {
+		printf("  0x%08x %-12s + 0x%s  = <unprovable>  <=  %s\n",
+		       addr, "?", "?", val.e);
+	}
+	(void)insn_text;
+}
+
+/* Resolve a pc relative literal load: ldr rX, [pc, #imm]. */
+static struct val literal(struct frame *f, uint32_t addr, long long off)
+{
+	uint32_t lit = (uint32_t)((addr + 4) & ~3U) + (uint32_t)off;
+	const uint8_t *p = vaddr_to_ptr(f->elf, lit, 4);
+
+	if (!p)
+		return v_unk("<no literal at 0x%x>", lit);
+	return v_const((long long)rd32(p));
+}
+
+static bool is_cond_branch(const char *m)
+{
+	static const char *cm[] = {
+		"beq", "bne", "bhs", "blo", "bmi", "bpl", "bvs", "bvc",
+		"bhi", "bls", "bge", "blt", "bgt", "ble", "bcs", "bcc",
+		"beq.w", "bne.w", "bhs.w", "blo.w", "bhi.w", "bls.w",
+		"bge.w", "blt.w", "bgt.w", "ble.w", "bcs.w", "bcc.w",
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cm); i++)
+		if (!strcmp(m, cm[i]))
+			return true;
+	return false;
+}
+
+static void note_cond(struct frame *f, const char *what, uint32_t addr)
+{
+	if (f->it_left > 0)
+		printf("  (%s conditional, %s @0x%x)\n", what, f->it_cond, addr);
+}
+
+/*
+ * Interpret one instruction.  Returns false to stop the sweep.
+ */
+static bool step(struct frame *f, const struct insn *in)
+{
+	char op1[32] = "", op2[32] = "", op3[32] = "", op4[32] = "";
+	const char *m = in->mnem;
+	const char *ops = in->ops;
+	size_t base_len;
+	int r1 = -1, r2 = -1, r3 = -1;
+	long long imm = 0, imm2 = 0;
+	bool have = false, have2 = false;
+	int nops;
+	struct val a, b, res;
+	uint32_t target;
+
+	/* Strip a condition suffix of an IT block: beq -> b + eq. */
+	if (f->it_left > 0) {
+		const char *sfx = NULL;
+
+		if (strlen(m) > 2) {
+			static const char *sfxs[] = { "eq", "ne", "hs", "lo", "mi",
+						      "pl", "vs", "vc", "hi", "ls",
+						      "ge", "lt", "gt", "le", "cs", "cc" };
+			unsigned int i;
+
+			sfx = m + strlen(m) - 2;
+			for (i = 0; i < ARRAY_SIZE(sfxs); i++)
+				if (!strcmp(sfx, sfxs[i]))
+					note_cond(f, m, in->addr);
+		}
+	}
+
+	/* Parse "#imm" operands; op2 may itself be the immediate. */
+	have = imm_value(ops, &imm);
+	sscanf(ops, "%31[^,], %31[^,], %31[^,], %31[^ ]", op1, op2, op3, op4);
+	have2 = imm_value(op2, &imm2);
+	nops = count_ops(ops);
+	base_len = strcspn(op1, " ,");
+	r1 = reg_index(op1, base_len);
+
+	if (!strcmp(m, "push") || !strcmp(m, "push.w")) {
+		unsigned int n = 0;
+		const char *p;
+
+		for (p = ops; *p; p++)
+			if (*p == ',')
+				n++;
+		if (*ops)
+			n++;			/* registers = commas + 1 */
+		f->sp_key_base -= (long long)n * 4;
+		return true;
+	}
+	if (!strcmp(m, "pop") || !strcmp(m, "pop.w")) {
+		if (strstr(ops, "pc"))
+			return false;
+		return true;
+	}
+	if (!strcmp(m, "bx") || !strcmp(m, "bx.w")) {
+		if (strstr(ops, "lr") || strstr(ops, "pc"))
+			return false;
+		return true;
+	}
+	if (!strcmp(m, "sub") || !strcmp(m, "subs") || !strcmp(m, "sub.w")) {
+		if (strstr(op1, "sp") && (have || have2)) {
+			f->sp_key_base -= have2 ? imm2 : imm;
+			return true;
+		}
+	}
+	if (!strcmp(m, "add") || !strcmp(m, "adds") || !strcmp(m, "add.w")) {
+		/* add rX, pc  : pc relative address of a string/table */
+		if (r1 >= 0 && !strcmp(op2, "pc")) {
+			struct val old = get_reg(f, r1);
+			long long pcval = (long long)((in->addr + 4) & ~3U);
+			long long v = (old.kind == K_CONST ? old.c : 0) + pcval;
+			const char *s;
+
+			if (old.kind != K_CONST)
+				return true;
+			s = rodata_str(f->elf, (uint32_t)v);
+			if (s)
+				set_reg(f, r1, v_sym((uint32_t)v, s));
+			else
+				set_reg(f, r1, v_const(v));
+			return true;
+		}
+		if (r1 >= 0 && (have || have2)) {
+			long long av = have2 ? imm2 : imm;
+			unsigned int l2 = strcspn(op2, " ,");
+
+			if (have2) {	/* add rX, #imm */
+				a = get_reg(f, r1);
+				if (a.kind == K_CONST) {
+					set_reg(f, r1, v_const(a.c + av));
+				} else if (a.kind == K_WIN) {
+					set_reg(f, r1, v_win(a.win, a.c + av));
+				} else if (a.kind == K_ARG && a.c == 0) {
+					set_reg(f, r1, v_unk("this + %lld", av));
+				} else {
+					set_reg(f, r1, v_unk("%s + %lld", a.e, av));
+				}
+				return true;
+			}
+			r2 = reg_index(op2, l2);
+			if (r2 >= 0) {
+				a = get_reg(f, r2);
+				if (a.kind == K_CONST) {
+					set_reg(f, r1, v_const(a.c + imm));
+				} else if (a.kind == K_WIN) {
+					set_reg(f, r1, v_win(a.win, a.c + imm));
+				} else {
+					set_reg(f, r1, v_unk("%s + %lld", a.e, imm));
+				}
+				return true;
+			}
+		}
+	}
+	if (!strcmp(m, "ldr") || !strcmp(m, "ldr.w") ||
+	    !strcmp(m, "ldrh") || !strcmp(m, "ldrh.w")) {
+		/* ldr rX, [pc, #imm] */
+		if (r1 >= 0 && !strncmp(op2, "[pc", 3)) {
+			imm_value(strchr(ops, '#') ? strchr(ops, '#') : "#0", &imm);
+			set_reg(f, r1, literal(f, in->addr, imm));
+			return true;
+		}
+		if (r1 >= 0 && !strncmp(op2, "[sp", 3)) {
+			long long key;
+			int slot;
+
+			imm_value(strchr(ops, '#') ? strchr(ops, '#') : "#0", &imm);
+			key = f->sp_key_base + imm;
+			slot = slot_of(key);
+			set_reg(f, r1, (slot >= 0 && f->stack_valid[slot]) ?
+				f->stack[slot] : v_unk("<stack+%lld>", imm));
+			return true;
+		}
+		if (r1 >= 0 && op2[0] == '[') {
+			unsigned int l2 = strcspn(op2 + 1, " ,]");
+			struct val bv;
+
+			r2 = reg_index(op2 + 1, l2);
+			imm_value(strchr(ops, '#') ? strchr(ops, '#') : "#0", &imm);
+			bv = get_reg(f, r2);
+			if (bv.kind == K_ARG && bv.c == 0) {
+				int mi = member_index((uint32_t)imm);
+
+				if (mi >= 0) {
+					set_reg(f, r1, v_win(mi, 0));
+					return true;
+				}
+				set_reg(f, r1, v_unk("this[0x%llx]",
+						     (unsigned long long)imm));
+				return true;
+			}
+			if (bv.kind == K_WIN) {
+				set_reg(f, r1, v_unk("*(%s+0x%llx)", win_name(bv.win),
+						     (unsigned long long)(bv.c + imm)));
+			} else {
+				set_reg(f, r1, v_unk("*(%s)", bv.e));
+			}
+			return true;
+		}
+		set_reg(f, r1, v_unk("<ldr>"));
+		return true;
+	}
+	if (!strcmp(m, "str") || !strcmp(m, "str.w") || !strcmp(m, "strh") ||
+	    !strcmp(m, "strh.w") || !strcmp(m, "strex")) {
+		struct val src;
+		unsigned int l2;
+
+		if (!strncmp(op2, "[sp", 3)) {
+			long long key;
+			int slot;
+
+			imm_value(strchr(ops, '#') ? strchr(ops, '#') : "#0", &imm);
+			key = f->sp_key_base + imm;
+			slot = slot_of(key);
+			if (slot >= 0) {
+				f->stack[slot] = get_reg(f, r1);
+				f->stack_valid[slot] = true;
+			}
+			return true;
+		}
+		if (op2[0] != '[')
+			return true;
+		l2 = strcspn(op2 + 1, " ,]");
+		r2 = reg_index(op2 + 1, l2);
+		imm_value(strchr(ops, '#') ? strchr(ops, '#') : "#0", &imm);
+		src = get_reg(f, r1);
+		b = get_reg(f, r2);
+		if (b.kind == K_ARG && b.c == 0 && member_index((uint32_t)imm) >= 0) {
+			printf("  [this+0x%02llx] := %s  @0x%x (window pointer)\n",
+			       (unsigned long long)imm, src.e, in->addr);
+			return true;
+		}
+		emit_store(f, b, imm, src, in->addr, m);
+		return true;
+	}
+	if (!strcmp(m, "stm.w") || !strcmp(m, "stm") || !strcmp(m, "stmdb")) {
+		/* stm.w sp, {r3, r7, r11} : consecutive vararg slots */
+		char list[64];
+		const char *p = strchr(ops, '{');
+		unsigned int k = 0;
+		char *tok;
+
+		if (!p || !strstr(op1, "sp"))
+			return true;
+		set_fmt(list, sizeof(list), "%s", p);
+		for (tok = strtok(list, "{}, "); tok; tok = strtok(NULL, "{}, ")) {
+			int r = reg_index(tok, strlen(tok));
+			long long key = f->sp_key_base + (long long)k * 4;
+			int slot = slot_of(key);
+
+			if (r >= 0 && slot >= 0) {
+				f->stack[slot] = get_reg(f, r);
+				f->stack_valid[slot] = true;
+			}
+			k++;
+		}
+		return true;
+	}
+	if (!strcmp(m, "mov") || !strcmp(m, "movs") || !strcmp(m, "mov.w") ||
+	    !strcmp(m, "movw")) {
+		unsigned int l2 = strcspn(op2, " ,");
+
+		if (have2 || have) {
+			set_reg(f, r1, v_const(have2 ? imm2 : imm));
+			return true;
+		}
+		r2 = reg_index(op2, l2);
+		if (r2 == f->this_reg && f->this_reg >= 0 && !f->this_moved &&
+		    get_reg(f, r2).kind == K_ARG && get_reg(f, r2).c == 0) {
+			/* prologue copies the object pointer, e.g. mov r4, r0 */
+			f->this_reg = r1;
+			f->this_moved = true;
+			set_reg(f, r1, v_arg(0));
+			return true;
+		}
+		set_reg(f, r1, get_reg(f, r2));
+		return true;
+	}
+	if (!strcmp(m, "movt")) {
+		long long hi = 0;
+
+		imm_value(strchr(op2, '#') ? strchr(op2, '#') : "#0", &hi);
+		a = get_reg(f, r1);
+		if (a.kind == K_CONST)
+			set_reg(f, r1, v_const(((a.c & 0xffff) | (hi << 16))));
+		else
+			set_reg(f, r1, v_unk("<movt>"));
+		return true;
+	}
+	if (!strcmp(m, "and") || !strcmp(m, "ands") || !strcmp(m, "bic") ||
+	    !strcmp(m, "orr") || !strcmp(m, "orrs") || !strcmp(m, "orr.w") ||
+	    !strcmp(m, "eor") || !strcmp(m, "add") || !strcmp(m, "adds") ||
+	    !strcmp(m, "add.w") || !strcmp(m, "adds.w") ||
+	    !strcmp(m, "sub") || !strcmp(m, "subs") || !strcmp(m, "sub.w")) {
+		long long iv = 0;
+		int s1, s2 = -1;
+		bool ivok;
+
+		/*
+		 * Two operand forms are Rd = Rd op Rm, three operand forms are
+		 * Rd = Rn op <Rm|#imm>.
+		 */
+		if (nops >= 3) {
+			s1 = reg_index(op2, strcspn(op2, " ,"));
+			ivok = imm_value(op3, &iv);
+			if (!ivok)
+				s2 = reg_index(op3, strcspn(op3, " ,"));
+		} else {
+			s1 = r1;
+			ivok = imm_value(op2, &iv);
+			if (!ivok)
+				s2 = reg_index(op2, strcspn(op2, " ,"));
+		}
+
+		a = get_reg(f, s1);
+		if (ivok) {
+			if (a.kind == K_CONST) {
+				long long nv;
+
+				if (!strncmp(m, "and", 3))
+					nv = a.c & iv;
+				else if (!strncmp(m, "bic", 3))
+					nv = a.c & ~iv;
+				else if (!strncmp(m, "orr", 3))
+					nv = a.c | iv;
+				else if (!strncmp(m, "eor", 3))
+					nv = a.c ^ iv;
+				else if (!strncmp(m, "sub", 3))
+					nv = a.c - iv;
+				else
+					nv = a.c + iv;
+				set_reg(f, r1, v_const(nv));
+				return true;
+			}
+			if (!strncmp(m, "and", 3))
+				res = v_unk("(%s & 0x%llx)", a.e, (unsigned long long)iv);
+			else if (!strncmp(m, "bic", 3))
+				res = v_unk("(%s & ~0x%llx)", a.e, (unsigned long long)iv);
+			else if (!strncmp(m, "orr", 3))
+				res = v_unk("(%s | 0x%llx)", a.e, (unsigned long long)iv);
+			else if (!strncmp(m, "eor", 3))
+				res = v_unk("(%s ^ 0x%llx)", a.e, (unsigned long long)iv);
+			else if (!strncmp(m, "sub", 3))
+				res = v_unk("(%s - 0x%llx)", a.e, (unsigned long long)iv);
+			else
+				res = v_unk("(%s + 0x%llx)", a.e, (unsigned long long)iv);
+			set_reg(f, r1, res);
+			return true;
+		}
+		b = get_reg(f, s2);
+		if (a.kind == K_CONST && b.kind == K_CONST) {
+			long long nv;
+
+			if (!strncmp(m, "and", 3))
+				nv = a.c & b.c;
+			else if (!strncmp(m, "bic", 3))
+				nv = a.c & ~b.c;
+			else if (!strncmp(m, "orr", 3))
+				nv = a.c | b.c;
+			else if (!strncmp(m, "eor", 3))
+				nv = a.c ^ b.c;
+			else if (!strncmp(m, "sub", 3))
+				nv = a.c - b.c;
+			else
+				nv = a.c + b.c;
+			set_reg(f, r1, v_const(nv));
+			return true;
+		}
+		if (a.kind == K_WIN && b.kind == K_CONST)
+			set_reg(f, r1, v_win(a.win, a.c + b.c));
+		else if (!strncmp(m, "and", 3))
+			set_reg(f, r1, v_unk("(%s & %s)", a.e, b.e));
+		else if (!strncmp(m, "bic", 3))
+			set_reg(f, r1, v_unk("(%s & ~%s)", a.e, b.e));
+		else if (!strncmp(m, "orr", 3))
+			set_reg(f, r1, v_unk("(%s | %s)", a.e, b.e));
+		else if (!strncmp(m, "eor", 3))
+			set_reg(f, r1, v_unk("(%s ^ %s)", a.e, b.e));
+		else if (!strncmp(m, "sub", 3))
+			set_reg(f, r1, v_unk("(%s - %s)", a.e, b.e));
+		else
+			set_reg(f, r1, v_unk("(%s + %s)", a.e, b.e));
+		return true;
+	}
+	if (!strcmp(m, "bfi") || !strcmp(m, "bfc")) {
+		long long lsb = 0, width = 0;
+		const char *p;
+
+		p = strchr(op2, '#');
+		if (p)
+			imm_value(p, &lsb);
+		if (!strcmp(m, "bfi")) {
+			p = strchr(op3, '#');
+			if (p)
+				imm_value(p, &width);
+			a = get_reg(f, r1);
+			b = get_reg(f, r2);
+			if (a.kind == K_CONST && b.kind == K_CONST) {
+				long long mask = ((1LL << width) - 1) << lsb;
+
+				set_reg(f, r1, v_const((a.c & ~mask) |
+						       ((b.c << lsb) & mask)));
+			} else {
+				set_reg(f, r1, v_unk("((%s & ~0x%llx) | ((%s & 0x%llx) << %lld))",
+						     a.e, ((1LL << width) - 1) << lsb,
+						     b.e, (1LL << width) - 1, lsb));
+			}
+			return true;
+		}
+		p = strchr(op3, '#');
+		if (p)
+			imm_value(p, &width);
+		a = get_reg(f, r1);
+		if (a.kind == K_CONST)
+			set_reg(f, r1, v_const(a.c & ~(((1LL << width) - 1) << lsb)));
+		else
+			set_reg(f, r1, v_unk("(%s & ~0x%llx)", a.e,
+					     ((1LL << width) - 1) << lsb));
+		return true;
+	}
+	if (!strcmp(m, "lsls") || !strcmp(m, "lsrs") || !strcmp(m, "asrs") ||
+	    !strcmp(m, "uxth") || !strcmp(m, "uxtb") || !strcmp(m, "sxtb") ||
+	    !strcmp(m, "sxth") || !strcmp(m, "ubfx") || !strcmp(m, "clz")) {
+		unsigned int l2 = strcspn(op2, " ,");
+		long long sh = 0;
+		int src;
+
+		/*
+		 * Shifts are Rd = Rd shift Rm, the extends and clz are
+		 * Rd = op(Rm), ubfx is Rd = (Rm >> lsb) & mask.
+		 */
+		if (!strcmp(m, "lsls") || !strcmp(m, "lsrs") ||
+		    !strcmp(m, "asrs"))
+			src = (nops >= 3) ? reg_index(op2, l2) : r1;
+		else
+			src = reg_index(op2, l2);
+		a = get_reg(f, src);
+
+		if (!strcmp(m, "clz")) {
+			set_reg(f, r1, a.kind == K_CONST ? v_const(a.c ? 0 : 32) :
+				v_unk("clz(%s)", a.e));
+			return true;
+		}
+		if (!strcmp(m, "ubfx")) {
+			long long lsb = 0, w = 0;
+
+			if (strchr(op2, '#'))
+				imm_value(strchr(op2, '#'), &lsb);
+			if (strchr(op3, '#'))
+				imm_value(strchr(op3, '#'), &w);
+			if (a.kind == K_CONST)
+				set_reg(f, r1, v_const((a.c >> lsb) & ((1LL << w) - 1)));
+			else
+				set_reg(f, r1, v_unk("((%s >> %lld) & 0x%llx)", a.e, lsb,
+						     (1LL << w) - 1));
+			return true;
+		}
+		if (nops >= 3 && strchr(op3, '#'))
+			imm_value(strchr(op3, '#'), &sh);
+		else if (strchr(op2, '#'))
+			imm_value(strchr(op2, '#'), &sh);
+		else if (!strcmp(m, "lsls") || !strcmp(m, "lsrs") ||
+			 !strcmp(m, "asrs")) {
+			/* shift amount in a register: keep it symbolic */
+			int rs = reg_index(nops >= 3 ? op3 : op2, strcspn(nops >= 3 ? op3 : op2, " ,"));
+			const char *op = "lsls";
+
+			if (!strcmp(m, "lsrs"))
+				op = "lsrs";
+			else if (!strcmp(m, "asrs"))
+				op = "asrs";
+			b = get_reg(f, rs);
+			set_reg(f, r1, v_unk("(%s %s %s)", a.e, op, b.e));
+			return true;
+		}
+		if (a.kind == K_CONST) {
+			long long nv = a.c;
+
+			if (!strcmp(m, "lsls"))
+				nv = a.c << sh;
+			else if (!strcmp(m, "lsrs"))
+				nv = (long long)((unsigned long long)a.c >> sh);
+			else if (!strcmp(m, "asrs"))
+				nv = a.c >> sh;
+			else if (!strcmp(m, "uxth"))
+				nv = a.c & 0xffff;
+			else if (!strcmp(m, "uxtb"))
+				nv = a.c & 0xff;
+			set_reg(f, r1, v_const(nv));
+			return true;
+		}
+		set_reg(f, r1, v_unk("%s(%s, %lld)", m, a.e, sh));
+		return true;
+	}
+	if (!strcmp(m, "mul")) {
+		int s1 = (nops >= 3) ? reg_index(op2, strcspn(op2, " ,")) : r1;
+		int s2 = (nops >= 3) ? reg_index(op3, strcspn(op3, " ,")) :
+			reg_index(op2, strcspn(op2, " ,"));
+
+		a = get_reg(f, s1);
+		b = get_reg(f, s2);
+		set_reg(f, r1, (a.kind == K_CONST && b.kind == K_CONST) ?
+			v_const(a.c * b.c) : v_unk("(%s * %s)", a.e, b.e));
+		return true;
+	}
+	if (!strcmp(m, "udiv") || !strcmp(m, "sdiv")) {
+		int s1 = (nops >= 3) ? reg_index(op2, strcspn(op2, " ,")) : r1;
+		int s2 = (nops >= 3) ? reg_index(op3, strcspn(op3, " ,")) :
+			reg_index(op2, strcspn(op2, " ,"));
+
+		a = get_reg(f, s1);
+		b = get_reg(f, s2);
+		if (a.kind == K_CONST && b.kind == K_CONST && b.c)
+			set_reg(f, r1, v_const(a.c / b.c));
+		else
+			set_reg(f, r1, v_unk("(%s / %s)", a.e, b.e));
+		return true;
+	}
+	if (!strcmp(m, "rsb")) {
+		a = get_reg(f, r1);
+		sscanf(op2, "%31[^,], %31[^,]", op3, op4);
+		r2 = reg_index(op3, strcspn(op3, " ,"));
+		r3 = reg_index(op4, strcspn(op4, " ,"));
+		if (r3 >= 0 && imm_value(op4, &imm)) {
+			b = get_reg(f, r2);
+			set_reg(f, r1, b.kind == K_CONST ? v_const(imm - b.c) :
+				v_unk("(%lld - %s)", imm, b.e));
+			return true;
+		}
+		b = get_reg(f, r2);
+		a = get_reg(f, r3);
+		set_reg(f, r1, (a.kind == K_CONST && b.kind == K_CONST) ?
+			v_const(a.c - b.c) : v_unk("(%s - %s)", a.e, b.e));
+		return true;
+	}
+	if (!strcmp(m, "cmp") || !strcmp(m, "cmp.w") || !strcmp(m, "tst") ||
+	    !strcmp(m, "tst.w")) {
+		unsigned int l2 = strcspn(op2, " ,");
+		long long iv;
+
+		if (imm_value(op2, &iv)) {
+			a = get_reg(f, r1);
+			set_fmt(f->last_cmp, sizeof(f->last_cmp),
+				 "%s %s 0x%llx", a.e,
+				 !strcmp(m, "cmp") || !strcmp(m, "cmp.w") ? "==" : "&",
+				 (unsigned long long)iv);
+		} else {
+			r2 = reg_index(op2, l2);
+			set_fmt(f->last_cmp, sizeof(f->last_cmp), "%s %s %s",
+				 get_reg(f, r1).e,
+				 !strcmp(m, "cmp") || !strcmp(m, "cmp.w") ? "==" : "&",
+				 get_reg(f, r2).e);
+		}
+		return true;
+	}
+	if (!strncmp(m, "it", 2)) {
+		const char *sfx = m + 2;
+		unsigned int i;
+
+		f->it_idx = 0;
+		f->it_left = (int)strlen(sfx);
+		for (i = 0; i < strlen(sfx); i++) {
+			static const char *cond[] = { "eq", "ne", "hs", "lo",
+						      "mi", "pl", "ge", "lt", "gt", "le" };
+			/* suffix letters: t = then, e = else */
+			if (sfx[i] == 't' || sfx[i] == 'e')
+				continue;
+			(void)cond;
+		}
+		set_fmt(f->it_cond, sizeof(f->it_cond), "%s", f->last_cmp);
+		return true;
+	}
+	if (!strcmp(m, "b") || !strcmp(m, "b.w")) {
+		/* forward unconditional branch: fall through is not taken */
+		return true;
+	}
+	if (is_cond_branch(m)) {
+		/* conditional branch: remember the state of the taken path */
+		char *end = NULL;
+
+		target = (uint32_t)strtoul(ops[0] == '#' ? ops + 1 : ops, &end, 16);
+		if (end && end != (ops[0] == '#' ? ops + 1 : ops)) {
+			printf("  branch 0x%x (%s): taken when %s; the target is\n"
+			       "    interpreted with the register state of this point\n",
+			       target, m, f->last_cmp[0] ? f->last_cmp : "?");
+			if (f->ntarget < (int)ARRAY_SIZE(f->target)) {
+				f->target[f->ntarget].addr = target;
+				memcpy(f->target[f->ntarget].r, f->r, sizeof(f->r));
+				f->ntarget++;
+			}
+		}
+		return true;
+	}
+	if (!strcmp(m, "bl") || !strcmp(m, "blx")) {
+		const char *lt = strchr(ops, '<');
+		char name[96] = "";
+		struct val fmt, v1;
+
+		if (lt)
+			set_fmt(name, sizeof(name), "%s", lt + 1);
+		if (strchr(name, '>'))
+			*(char *)strchr(name, '>') = '\0';
+
+		if (strstr(name, "__android_log_print")) {
+			fmt = get_reg(f, 2);
+			v1 = get_reg(f, 3);
+			printf("  log: fmt=%s v1=%s", fmt.e, v1.e);
+			if (f->stack_valid[slot_of(f->sp_key_base)]) {
+				int i;
+
+				printf(" stack={");
+				for (i = 0; i < 8; i++) {
+					int sl = slot_of(f->sp_key_base + i * 4);
+
+					if (sl < 0 || !f->stack_valid[sl])
+						continue;
+					printf("%s%s", i ? ", " : "", f->stack[sl].e);
+				}
+				printf("}");
+			}
+			printf("  @0x%x\n", in->addr);
+		} else if (strstr(name, "usleep")) {
+			printf("  usleep(%s) @0x%x\n", get_reg(f, 0).e, in->addr);
+		} else if (strstr(name, "mmap")) {
+			int sl = slot_of(f->sp_key_base + 4);
+
+			printf("  mmap(len=%s, off=%s) @0x%x\n", get_reg(f, 1).e,
+			       (sl >= 0 && f->stack_valid[sl]) ? f->stack[sl].e : "?",
+			       in->addr);
+		} else if (strstr(name, "ioctl")) {
+			printf("  ioctl(fd=%s, cmd=0x%llx) @0x%x\n",
+			       get_reg(f, 0).e,
+			       get_reg(f, 1).kind == K_CONST ? get_reg(f, 1).c : 0,
+			       in->addr);
+		} else if (name[0]) {
+			printf("  call %s @0x%x\n", name, in->addr);
+		}
+		clobber(f);
+		return true;
+	}
+	if (!strcmp(m, "cbz") || !strcmp(m, "cbnz")) {
+		printf("  %s %s @0x%x\n", m, get_reg(f, r1).e, in->addr);
+		return true;
+	}
+	if (!strcmp(m, "dmb") || !strcmp(m, "nop") || !strcmp(m, "ldrex") ||
+	    !strcmp(m, "strex") || !strcmp(m, "sxtb16") || !strcmp(m, "uxtb16"))
+		return true;
+
+	return true;
+}
+
+static void run_function(const struct elf *e, const struct disasm *d,
+			 const struct symbol *sym, bool scan)
+{
+	struct frame f;
+	unsigned int i;
+	bool started = false;
+
+	memset(&f, 0, sizeof(f));
+	f.elf = e;
+	f.dis = d;
+	f.fname = sym->name;
+	for (i = 0; i < ARRAY_SIZE(f.r); i++)
+		f.r[i] = v_unk("<entry>");
+	f.this_reg = 0;
+	f.r[0] = v_arg(0);
+	set_fmt(f.r[0].e, sizeof(f.r[0].e), "this");
+	f.r[1] = v_arg(1);
+	f.r[2] = v_arg(2);
+	f.r[3] = v_arg(3);
+	{
+		int a;
+
+		for (a = 4; a <= 10; a++) {
+			int slot = slot_of((long long)(a - 4) * 4);
+
+			if (slot < 0)
+				continue;
+			f.stack[slot] = v_arg(a);
+			f.stack_valid[slot] = true;
+		}
+	}
+
+	if (!scan)
+		printf("== %s @0x%x (%u bytes) ==\n", sym->name, sym->addr, sym->size);
+
+	for (i = 0; i < d->n; i++) {
+		const struct insn *in = &d->v[i];
+
+		if (in->addr < sym->addr)
+			continue;
+		if (in->addr >= sym->addr + sym->size)
+			break;
+		started = true;
+
+		if (f.it_left > 0)
+			f.it_left--;
+		{
+			int t;
+
+			for (t = 0; t < f.ntarget; t++) {
+				if (f.target[t].addr != in->addr)
+					continue;
+				memcpy(f.r, f.target[t].r, sizeof(f.r));
+				printf("    [entered branch target 0x%x]\n", in->addr);
+				f.target[t].addr = 0;
+			}
+		}
+		if (!step(&f, in))
+			break;
+	}
+
+	if (scan)
+		return;
+	if (!started)
+		printf("  (no instructions found; is the disassembly complete?)\n");
+	printf("  %u store(s); %u of them in conditionally entered blocks;\n"
+	       "  %u write(s) to the \"this\" register in dead error-handling\n"
+	       "  branches were ignored\n\n",
+	       f.stores, 0, f.dead_writes);
+}
+
+int main(int argc, char **argv)
+{
+	struct elf e;
+	struct disasm d;
+	static const char *funcs[] = {
+		"_ZN12SeninfDrvImp4initEv",
+		"_ZN12SeninfDrvImp15setSeninf1NCSI2Emmmmmmmmmm",
+		"_ZN12SeninfDrvImp15setSeninf2NCSI2Emmmmmmmmmm",
+		"_ZN12SeninfDrvImp15setSeninf3NCSI2Emmmmmmmmmm",
+	};
+	unsigned int i;
+	int ret = 0;
+
+	if (argc != 3) {
+		fprintf(stderr, "usage: %s <libcam.halsensor.so> <disassembly.txt>\n",
+			argv[0]);
+		return 2;
+	}
+
+	build_ptr_map();
+	if (!elf_load(&e, argv[1]))
+		return 1;
+	if (!disasm_load(&d, argv[2]))
+		return 1;
+
+	printf("seninf-dphy-extract: %s (%u instructions parsed)\n\n", argv[1], d.n);
+
+	if (!verify_windows(&e, &d)) {
+		fprintf(stderr, "window proof mismatch: refusing to print values\n");
+		return 1;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(funcs); i++) {
+		const struct symbol *s = find_sym(&e, funcs[i]);
+
+		if (!s) {
+			fprintf(stderr, "symbol %s not found\n", funcs[i]);
+			ret = 1;
+			continue;
+		}
+		run_function(&e, &d, s, false);
+	}
+
+
+	printf("Legend: the left column is the instruction address that issues the\n"
+	       "store (Thumb-2), the middle column the destination, the right column\n"
+	       "the value expression.  \"<unprovable>\" means the tool could not\n"
+	       "derive the operand from the instruction stream; such a value must\n"
+	       "not be used.\n");
+
+	return ret;
+}
