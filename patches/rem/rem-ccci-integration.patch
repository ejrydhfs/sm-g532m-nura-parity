+/* mt6735/ccci_platform.c:101-102 */
+#define MPU_PERM_CLEAR \
+	SET_ACCESS_PERMISSON(MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION, \
+			     MPU_NO_PROTECTION, MPU_NO_PROTECTION)
