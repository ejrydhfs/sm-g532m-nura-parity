+
+config MTK_MD2_SBP_CUSTOM_VALUE
+	string "Configure modem 2 default bind operator ID"
+	depends on MTK_CCCI
+	default ""
+	help
+	  Same as MTK_MD_SBP_CUSTOM_VALUE for modem 2
+	  (Samsung/MTK 3.18 ccci_util/Kconfig:107-113).
