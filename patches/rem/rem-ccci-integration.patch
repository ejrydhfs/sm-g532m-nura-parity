+config MTK_MD_SBP_CUSTOM_VALUE
+	string "Configure modem 1 default bind operator ID"
+	depends on MTK_CCCI
+	default ""
+	help
+	  Default MD SBP (Single Binary Platform) operator/bind value
+	  reported to userspace by CCCI_IOC_GET_MD_SBP_CFG and used for the
+	  handshake-2 runtime data when userspace has not called
+	  CCCI_IOC_SET_MD_SBP_CFG.
