+					      CCCI_HEADER_SIZE +
+					      sizeof(struct ccci_ex_log));
+		if (in_exception)
+			ccci_exception_trigger(md, CCCI_EX_DUMP_MD_EX_REC_OK,
+					       flags);
+		break;
+	case MD_EX:
+		if (!in_exception || ccci_h->reserved != MD_EX_CHK_ID)
