diff --git a/tools/mediatek/aee/Makefile b/tools/mediatek/aee/Makefile
new file mode 100644
index 000000000..fcf5e52d3
--- /dev/null
+++ b/tools/mediatek/aee/Makefile
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# aee-db: host/target client for the MediaTek AED (/dev/aed0) ABI.
+# Build from this directory or from the kernel tree root with
+#   make -C tools/mediatek/aee
+#
+srctree ?= ../../..
+CC ?= gcc
+CFLAGS ?= -O2 -Wall -Wextra -Werror
+CPPFLAGS += -I$(srctree)/include/uapi
+
+all: aee-db
+
+aee-db: aee-db.c $(srctree)/include/uapi/linux/aee.h
+	$(CC) $(CPPFLAGS) $(CFLAGS) -o $@ aee-db.c
+
+check: aee-db
+	./aee-db --selftest
+
+clean:
+	rm -f aee-db
+
+.PHONY: all check clean
diff --git a/tools/mediatek/aee/aee-db.c b/tools/mediatek/aee/aee-db.c
new file mode 100644
index 000000000..9059ad788
--- /dev/null
+++ b/tools/mediatek/aee/aee-db.c
@@ -0,0 +1,788 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * aee-db - userspace client for the MediaTek AED (AEE exception dump) ABI.
+ *
+ * Speaks the AE_Msg request/response protocol on <device> (default
+ * /dev/aed0, the EE device of the ROM) and the dump ioctls that the ABI
+ * header include/uapi/linux/aee.h describes.  The tool is the reference
+ * consumer of the kernel driver in drivers/misc/mediatek/aee/ and is also
+ * usable to inspect a live exception record:
+ *
+ *   aee-db query            pending AE_IND_* indication (AE_Msg header)
+ *   aee-db class|type|process|module|backtrace|detail|coredump
+ *   aee-db ccci --md 1      detail dump, checks that the record is md1's
+ *   aee-db close            AE_IND_LOG_CLOSE (releases the kernel record)
+ *   aee-db regs --pid N     AEEIOCTL_GET_THREAD_REG(64) with fallback
+ *   aee-db bt --pid N       AEEIOCTL_GET_PROCESS_BT
+ *   aee-db --selftest       ABI layout + encoder/decoder KATs, no device
+ *
+ * The AED daemon protocol is request/response on one open file: write one
+ * 24-byte struct AE_Msg, read a 24-byte response header and, when response.len
+ * is non-zero, response.len payload bytes.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <linux/aee.h>
+
+#define DEFAULT_DEVICE	"/dev/aed0"
+#define DEFAULT_TIMEOUT	5000
+#define MAX_PAYLOAD	65536
+
+static const char *progname = "aee-db";
+
+static void errmsg(const char *fmt, ...)
+{
+	va_list ap;
+
+	fprintf(stderr, "%s: ", progname);
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+}
+
+/* ------------------------------------------------------------------ */
+/* AE_Msg names, mirroring libaed.so aee_aed_get_cmd_type/name()      */
+/* ------------------------------------------------------------------ */
+
+static const char *cmd_type_name(uint32_t type)
+{
+	switch (type) {
+	case AE_REQ:
+		return "REQ";
+	case AE_RSP:
+		return "RSP";
+	case AE_IND:
+		return "IND";
+	default:
+		return "UNKNOWN";
+	}
+}
+
+static const char *cmd_id_name(uint32_t id)
+{
+	switch (id) {
+	case AE_REQ_IDX:
+		return "IDX";
+	case AE_REQ_CLASS:
+		return "CLASS";
+	case AE_REQ_TYPE:
+		return "TYPE";
+	case AE_REQ_PROCESS:
+		return "PROCESS";
+	case AE_REQ_MODULE:
+		return "MODULE";
+	case AE_REQ_BACKTRACE:
+		return "BACKTRACE";
+	case AE_REQ_DETAIL:
+		return "DETAIL";
+	case AE_REQ_COREDUMP:
+		return "COREDUMP";
+	case AE_IND_FATAL_RAISED:
+		return "FATAL_RAISED";
+	case AE_IND_EXP_RAISED:
+		return "EXP_RAISED";
+	case AE_IND_WRN_RAISED:
+		return "WRN_RAISED";
+	case AE_IND_REM_RAISED:
+		return "REM_RAISED";
+	case AE_IND_LOG_STATUS:
+		return "LOG_STATUS";
+	case AE_IND_LOG_CLOSE:
+		return "LOG_CLOSE";
+	case AE_REQ_USERSPACEBACKTRACE:
+		return "USERSPACEBACKTRACE";
+	case AE_REQ_USER_REG:
+		return "USER_REG";
+	case AE_REQ_USER_MAPS:
+		return "USER_MAPS";
+	default:
+		return "UNKNOWN";
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* ABI encoder / decoder (used by the wire path and by the KATs)       */
+/* ------------------------------------------------------------------ */
+
+static void msg_encode(unsigned char *buf, const struct AE_Msg *msg)
+{
+	memset(buf, 0, sizeof(struct AE_Msg));
+	memcpy(buf + 0, &msg->cmdType, 4);
+	memcpy(buf + 4, &msg->cmdId, 4);
+	memcpy(buf + 8, &msg->seq, 4);
+	memcpy(buf + 12, &msg->arg, 4);
+	memcpy(buf + 16, &msg->len, 4);
+	memcpy(buf + 20, &msg->dbOption, 4);
+}
+
+static void msg_decode(struct AE_Msg *msg, const unsigned char *buf)
+{
+	memset(msg, 0, sizeof(*msg));
+	memcpy(&msg->cmdType, buf + 0, 4);
+	memcpy(&msg->cmdId, buf + 4, 4);
+	memcpy(&msg->seq, buf + 8, 4);
+	memcpy(&msg->arg, buf + 12, 4);
+	memcpy(&msg->len, buf + 16, 4);
+	memcpy(&msg->dbOption, buf + 20, 4);
+}
+
+static void msg_print(const char *prefix, const struct AE_Msg *msg)
+{
+	printf("%s: cmdType=%s(%u) cmdId=%s(%u) seq/pid=%d arg/cls=0x%08x len/id=%u dbOption=0x%08x\n",
+	       prefix, cmd_type_name(msg->cmdType), msg->cmdType,
+	       cmd_id_name(msg->cmdId), msg->cmdId, msg->pid, msg->arg,
+	       msg->len, msg->dbOption);
+
+	if (msg->len == 0) {
+		if (msg->arg == AE_NOT_AVAILABLE)
+			printf("%s: no log available (AE_NOT_AVAILABLE)\n",
+			       prefix);
+		return;
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Device transport                                                    */
+/* ------------------------------------------------------------------ */
+
+static int dev_write_msg(int fd, const struct AE_Msg *req)
+{
+	unsigned char buf[sizeof(struct AE_Msg)];
+	ssize_t n;
+
+	msg_encode(buf, req);
+	n = write(fd, buf, sizeof(buf));
+	if (n < 0) {
+		errmsg("write: %s", strerror(errno));
+		return -1;
+	}
+	if (n != (ssize_t)sizeof(buf)) {
+		errmsg("short write (%zd)", n);
+		return -1;
+	}
+	return 0;
+}
+
+static int dev_read_msg(int fd, struct AE_Msg *rsp, char **payload, int timeout_ms)
+{
+	unsigned char *buf;
+	struct pollfd pfd = { .fd = fd, .events = POLLIN };
+	ssize_t n;
+	int ret;
+
+	*payload = NULL;
+
+	ret = poll(&pfd, 1, timeout_ms);
+	if (ret < 0) {
+		errmsg("poll: %s", strerror(errno));
+		return -1;
+	}
+	if (ret == 0) {
+		errmsg("timed out after %d ms waiting for a response", timeout_ms);
+		return -1;
+	}
+
+	buf = calloc(1, sizeof(struct AE_Msg) + MAX_PAYLOAD);
+	if (!buf) {
+		errmsg("out of memory");
+		return -1;
+	}
+
+	n = read(fd, buf, sizeof(struct AE_Msg) + MAX_PAYLOAD);
+	if (n < 0) {
+		errmsg("read: %s", strerror(errno));
+		free(buf);
+		return -1;
+	}
+	if (n < (ssize_t)sizeof(struct AE_Msg)) {
+		errmsg("short read (%zd, need %zu)", n, sizeof(struct AE_Msg));
+		free(buf);
+		return -1;
+	}
+
+	msg_decode(rsp, buf);
+	if (rsp->len > MAX_PAYLOAD || (ssize_t)(sizeof(struct AE_Msg) + rsp->len) > n) {
+		errmsg("response payload length %u does not match read %zd",
+		       rsp->len, n);
+		free(buf);
+		return -1;
+	}
+
+	if (rsp->len) {
+		*payload = malloc((size_t)rsp->len + 1);
+		if (!*payload) {
+			errmsg("out of memory");
+			free(buf);
+			return -1;
+		}
+		memcpy(*payload, buf + sizeof(struct AE_Msg), rsp->len);
+		(*payload)[rsp->len] = '\0';
+	}
+
+	free(buf);
+	return 0;
+}
+
+static void print_payload(const char *payload, uint32_t len)
+{
+	uint32_t i;
+
+	if (!payload)
+		return;
+
+	printf("--- payload (%u bytes) ---\n", len);
+	fwrite(payload, 1, len, stdout);
+	if (len && payload[len - 1] != '\n')
+		fputc('\n', stdout);
+	printf("--- end payload ---\n");
+
+	/* a text payload is printed as is; keep the hex view for control bytes */
+	for (i = 0; i < len; i++) {
+		if ((unsigned char)payload[i] != '\0' && payload[i] != '\n' &&
+		    payload[i] != '\t' && (unsigned char)payload[i] < 0x20) {
+			printf("payload contains binary data, use --raw\n");
+			return;
+		}
+	}
+}
+
+static int dev_open(const char *device)
+{
+	int fd = open(device, O_RDWR);
+
+	if (fd < 0)
+		errmsg("cannot open %s: %s", device, strerror(errno));
+	return fd;
+}
+
+/* ------------------------------------------------------------------ */
+/* Commands                                                           */
+/* ------------------------------------------------------------------ */
+
+static int cmd_request(const char *device, uint32_t cmd_id, int timeout_ms,
+		       bool expect_payload)
+{
+	struct AE_Msg req = { 0 };
+	struct AE_Msg rsp;
+	int ret = 0;
+	char *payload;
+	int fd;
+
+	fd = dev_open(device);
+	if (fd < 0)
+		return 1;
+
+	req.cmdType = AE_REQ;
+	req.cmdId = cmd_id;
+	if (dev_write_msg(fd, &req)) {
+		ret = 1;
+		goto out;
+	}
+
+	if (dev_read_msg(fd, &rsp, &payload, timeout_ms)) {
+		ret = 1;
+		goto out;
+	}
+
+	msg_print("response", &rsp);
+	if (expect_payload)
+		print_payload(payload, rsp.len);
+	free(payload);
+
+out:
+	close(fd);
+	return ret;
+}
+
+static int cmd_query(const char *device, int timeout_ms)
+{
+	struct pollfd pfd;
+	int ret;
+	int fd;
+
+	fd = dev_open(device);
+	if (fd < 0)
+		return 1;
+
+	pfd.fd = fd;
+	pfd.events = POLLIN;
+	ret = poll(&pfd, 1, timeout_ms);
+	if (ret < 0)
+		errmsg("poll: %s", strerror(errno));
+	else if (ret == 0)
+		errmsg("no pending exception indication after %d ms", timeout_ms);
+	else
+		printf("pending indication, revents=0x%x\n", pfd.revents);
+
+	close(fd);
+	return ret > 0 ? 0 : 1;
+}
+
+static int cmd_ccci(const char *device, int md, int timeout_ms)
+{
+	struct AE_Msg req = { 0 };
+	struct AE_Msg rsp;
+	char *process = NULL;
+	char *payload = NULL;
+	int ret = 1;
+	int fd;
+
+	fd = dev_open(device);
+	if (fd < 0)
+		return 1;
+
+	/* the detail path keys off the "mdN:" prefix of AE_REQ_PROCESS */
+	req.cmdType = AE_REQ;
+	req.cmdId = AE_REQ_PROCESS;
+	if (dev_write_msg(fd, &req))
+		goto out;
+	if (dev_read_msg(fd, &rsp, &process, timeout_ms))
+		goto out;
+	msg_print("process", &rsp);
+	printf("process: %s\n", process ? process : "");
+
+	if (md > 0) {
+		char prefix[16];
+		int len = snprintf(prefix, sizeof(prefix), "md%d:", md);
+
+		if (!process || strncmp(process, prefix, (size_t)len)) {
+			printf("ccci: record is not md%d, no CCCI window for it\n",
+			       md);
+			ret = 0;
+			goto out;
+		}
+	}
+
+	req.cmdType = AE_REQ;
+	req.cmdId = AE_REQ_DETAIL;
+	if (dev_write_msg(fd, &req))
+		goto out;
+	if (dev_read_msg(fd, &rsp, &payload, timeout_ms))
+		goto out;
+
+	msg_print("detail", &rsp);
+	print_payload(payload, rsp.len);
+
+	if (payload && strstr(payload, "== CCCI LOG =="))
+		printf("ccci: CCCI debug window present\n");
+	else
+		printf("ccci: no CCCI debug window in this record\n");
+
+	{
+		struct AE_Msg ind = { 0 };
+
+		ind.cmdType = AE_IND;
+		ind.cmdId = AE_IND_LOG_CLOSE;
+		if (dev_write_msg(fd, &ind))
+			goto out;
+	}
+	ret = 0;
+
+out:
+	free(process);
+	free(payload);
+	close(fd);
+	return ret;
+}
+
+static int cmd_close(const char *device)
+{
+	struct AE_Msg ind = { 0 };
+	int fd, ret = 0;
+
+	fd = dev_open(device);
+	if (fd < 0)
+		return 1;
+
+	ind.cmdType = AE_IND;
+	ind.cmdId = AE_IND_LOG_CLOSE;
+	if (dev_write_msg(fd, &ind))
+		ret = 1;
+	else
+		printf("sent AE_IND_LOG_CLOSE\n");
+
+	close(fd);
+	return ret;
+}
+
+static int cmd_regs(const char *device, int pid)
+{
+	struct aee_thread_reg64 wide;
+	struct aee_thread_reg narrow;
+	int fd, ret = 0, i;
+
+	if (pid <= 0) {
+		errmsg("regs needs --pid");
+		return 2;
+	}
+
+	fd = dev_open(device);
+	if (fd < 0)
+		return 1;
+
+	memset(&wide, 0, sizeof(wide));
+	wide.tid = pid;
+	if (ioctl(fd, AEEIOCTL_GET_THREAD_REG64, &wide) == 0) {
+		printf("AEEIOCTL_GET_THREAD_REG64: tid %d\n", wide.tid);
+		for (i = 0; i < 34; i++)
+			printf("  x%-2d = 0x%016llx\n", i,
+			       (unsigned long long)wide.regs[i]);
+		printf("  orig_x0 = 0x%016llx syscallno = %llu\n",
+		       (unsigned long long)wide.regs[34],
+		       (unsigned long long)wide.regs[35]);
+		goto out;
+	}
+
+	memset(&narrow, 0, sizeof(narrow));
+	narrow.tid = pid;
+	if (ioctl(fd, AEEIOCTL_GET_THREAD_REG, &narrow) == 0) {
+		static const char *const names[18] = {
+			"r0", "r1", "r2", "r3", "r4", "r5", "r6", "r7", "r8",
+			"r9", "r10", "fp", "ip", "sp", "lr", "pc", "cpsr",
+			"orig_r0",
+		};
+
+		printf("AEEIOCTL_GET_THREAD_REG: tid %d\n", narrow.tid);
+		for (i = 0; i < 18; i++)
+			printf("  %-7s = 0x%08x\n", names[i], narrow.regs[i]);
+		goto out;
+	}
+
+	errmsg("no thread register ABI accepted for pid %d: %s", pid,
+	       strerror(errno));
+	ret = 1;
+out:
+	close(fd);
+	return ret;
+}
+
+static int cmd_bt(const char *device, int pid)
+{
+	struct aee_bt_frame *frames;
+	struct aee_ioctl arg;
+	int fd, ret = 0;
+	uint32_t i;
+
+	if (pid <= 0) {
+		errmsg("bt needs --pid");
+		return 2;
+	}
+
+	fd = dev_open(device);
+	if (fd < 0)
+		return 1;
+
+	frames = calloc(AEE_NR_FRAME, sizeof(*frames));
+	if (!frames) {
+		errmsg("out of memory");
+		close(fd);
+		return 1;
+	}
+
+	memset(&arg, 0, sizeof(arg));
+	arg.pid = (uint32_t)pid;
+	arg.out = (uint64_t)(uintptr_t)frames;
+	arg.size = AEE_NR_FRAME;
+
+	if (ioctl(fd, AEEIOCTL_GET_PROCESS_BT, &arg)) {
+		errmsg("AEEIOCTL_GET_PROCESS_BT: %s", strerror(errno));
+		ret = 1;
+		goto out;
+	}
+
+	printf("AEEIOCTL_GET_PROCESS_BT: pid %u detail 0x%08x frames %u\n",
+	       arg.pid, arg.detail, arg.size);
+	for (i = 0; i < arg.size && i < AEE_NR_FRAME; i++)
+		printf("  [%02u] pc=0x%016llx %s\n", i,
+		       (unsigned long long)frames[i].pc, frames[i].pc_symbol);
+
+out:
+	free(frames);
+	close(fd);
+	return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Selftest: ABI layout, ioctl encoding and codec KATs                */
+/* ------------------------------------------------------------------ */
+
+static int selftest_failures;
+
+#define CHECK(cond) do {						\
+	if (!(cond)) {							\
+		fprintf(stderr, "FAIL %s:%d: %s\n", __func__, __LINE__,	\
+			#cond);						\
+		selftest_failures++;					\
+	}								\
+} while (0)
+
+#define CHECK_EQ(a, b) do {						\
+	unsigned long long __a = (unsigned long long)(a);		\
+	unsigned long long __b = (unsigned long long)(b);		\
+	if (__a != __b) {						\
+		fprintf(stderr, "FAIL %s:%d: %s (0x%llx) != %s (0x%llx)\n", \
+			__func__, __LINE__, #a, __a, #b, __b);		\
+		selftest_failures++;					\
+	}								\
+} while (0)
+
+static void kat_layout(void)
+{
+	CHECK_EQ(sizeof(struct AE_Msg), 24);
+	CHECK_EQ(offsetof(struct AE_Msg, cmdType), 0);
+	CHECK_EQ(offsetof(struct AE_Msg, cmdId), 4);
+	CHECK_EQ(offsetof(struct AE_Msg, seq), 8);
+	CHECK_EQ(offsetof(struct AE_Msg, arg), 12);
+	CHECK_EQ(offsetof(struct AE_Msg, len), 16);
+	CHECK_EQ(offsetof(struct AE_Msg, dbOption), 20);
+
+	CHECK_EQ(sizeof(struct aee_ioctl), 32);
+	CHECK_EQ(offsetof(struct aee_ioctl, pid), 0);
+	CHECK_EQ(offsetof(struct aee_ioctl, detail), 4);
+	CHECK_EQ(offsetof(struct aee_ioctl, size), 8);
+	CHECK_EQ(offsetof(struct aee_ioctl, in), 16);
+	CHECK_EQ(offsetof(struct aee_ioctl, out), 24);
+
+	CHECK_EQ(sizeof(struct aee_thread_reg), 76);
+	CHECK_EQ(sizeof(struct aee_thread_reg64), 296);
+	CHECK_EQ(sizeof(struct aee_bt_frame), 256);
+	CHECK_EQ(offsetof(struct aee_bt_frame, pc_symbol), 36);
+	CHECK_EQ(offsetof(struct aee_bt_frame, lr_symbol), 116);
+}
+
+static void kat_ioctl_numbers(void)
+{
+	CHECK_EQ(AEEIOCTL_GET_PROCESS_BT, _IOW('p', 0x04, struct aee_ioctl));
+	CHECK_EQ(AEEIOCTL_GET_THREAD_REG, _IOW('p', 0x07, struct aee_thread_reg));
+	CHECK_EQ(AEEIOCTL_GET_THREAD_REG64,
+		 _IOW('p', 0x07, struct aee_thread_reg64));
+	CHECK_EQ(AEEIOCTL_CHECK_SUID_DUMPABLE, _IOR('p', 0x08, int));
+	CHECK_EQ(AEEIOCTL_SET_AEE_MODE, _IOR('p', 0x06, int));
+	CHECK_EQ(AEEIOCTL_GET_THREAD_REG, 0x404c7007);
+	CHECK_EQ(AEEIOCTL_GET_THREAD_REG64, 0x41287007);
+	CHECK_EQ(AEEIOCTL_GET_PROCESS_BT, 0x40207004);
+}
+
+static void kat_cmd_ids(void)
+{
+	CHECK_EQ(AE_REQ, 0);
+	CHECK_EQ(AE_RSP, 1);
+	CHECK_EQ(AE_IND, 2);
+	CHECK_EQ(AE_REQ_CLASS, 1);
+	CHECK_EQ(AE_REQ_TYPE, 2);
+	CHECK_EQ(AE_REQ_PROCESS, 3);
+	CHECK_EQ(AE_REQ_MODULE, 4);
+	CHECK_EQ(AE_REQ_BACKTRACE, 5);
+	CHECK_EQ(AE_REQ_DETAIL, 6);
+	CHECK_EQ(AE_IND_FATAL_RAISED, 11);
+	CHECK_EQ(AE_IND_EXP_RAISED, 12);
+	CHECK_EQ(AE_IND_WRN_RAISED, 13);
+	CHECK_EQ(AE_IND_REM_RAISED, 14);
+	CHECK_EQ(AE_IND_LOG_STATUS, 15);
+	CHECK_EQ(AE_IND_LOG_CLOSE, 16);
+	CHECK_EQ(AE_REQ_COREDUMP, 22);
+	CHECK_EQ(AE_REQ_USERSPACEBACKTRACE, 40);
+	CHECK_EQ(AE_REQ_USER_REG, 41);
+	CHECK_EQ(AE_REQ_USER_MAPS, 42);
+	CHECK_EQ(AE_PASS_BY_MEM, 0);
+	CHECK_EQ(AE_PASS_BY_FILE, 1);
+	CHECK_EQ(AE_NOT_AVAILABLE, 0xAEE00000);
+	CHECK_EQ(AE_DEFAULT, 0xAEE00001);
+}
+
+static void kat_msg_codec(void)
+{
+	unsigned char buf[sizeof(struct AE_Msg)];
+	struct AE_Msg in = { 0 };
+	struct AE_Msg out;
+
+	in.cmdType = AE_REQ;
+	in.cmdId = AE_REQ_DETAIL;
+	in.seq = 0x12345678;
+	in.arg = AE_PASS_BY_MEM;
+	in.len = 4096;
+	in.dbOption = 0x80000001;
+
+	msg_encode(buf, &in);
+
+	/* exact wire bytes: little-endian 32-bit fields, ABI order */
+	CHECK_EQ(buf[0], AE_REQ);
+	CHECK_EQ(buf[4], AE_REQ_DETAIL);
+	CHECK_EQ(buf[8], 0x78);
+	CHECK_EQ(buf[9], 0x56);
+	CHECK_EQ(buf[10], 0x34);
+	CHECK_EQ(buf[11], 0x12);
+	CHECK_EQ(buf[20], 0x01);
+	CHECK_EQ(buf[23], 0x80);
+
+	msg_decode(&out, buf);
+	CHECK_EQ(out.cmdType, in.cmdType);
+	CHECK_EQ(out.cmdId, in.cmdId);
+	CHECK_EQ(out.seq, in.seq);
+	CHECK_EQ(out.arg, in.arg);
+	CHECK_EQ(out.len, in.len);
+	CHECK_EQ(out.dbOption, in.dbOption);
+
+	/* an indication as the kernel builds it for a modem exception */
+	memset(&in, 0, sizeof(in));
+	in.cmdType = AE_IND;
+	in.cmdId = AE_IND_EXP_RAISED;
+	in.arg = 6;			/* AE_EE */
+	in.dbOption = 0x1;		/* DB_OPT_DEFAULT|DB_OPT_FTRACE */
+	msg_encode(buf, &in);
+	msg_decode(&out, buf);
+	CHECK_EQ(out.cmdType, AE_IND);
+	CHECK_EQ(out.cmdId, AE_IND_EXP_RAISED);
+	CHECK_EQ(out.arg, 6);
+	CHECK_EQ(out.dbOption, 1);
+}
+
+static void kat_ioctl_struct(void)
+{
+	struct aee_ioctl arg = { 0 };
+	uint64_t out = 0x1122334455667788ULL;
+	uint64_t in = 0x8877665544332211ULL;
+
+	arg.pid = 42;
+	arg.detail = AE_DEFAULT;
+	arg.size = AEE_NR_FRAME;
+	arg.in = in;
+	arg.out = out;
+
+	CHECK_EQ(arg.pid, 42);
+	CHECK_EQ(arg.detail, 0xAEE00001);
+	CHECK_EQ(arg.in, in);
+	CHECK_EQ(arg.out, out);
+}
+
+static int run_selftest(void)
+{
+	selftest_failures = 0;
+
+	kat_layout();
+	kat_ioctl_numbers();
+	kat_cmd_ids();
+	kat_msg_codec();
+	kat_ioctl_struct();
+
+	if (selftest_failures) {
+		fprintf(stderr, "%d selftest check(s) failed\n",
+			selftest_failures);
+		return 3;
+	}
+
+	printf("selftest: %s %s\n", __DATE__, "OK: 5 KAT groups, "
+	       "24-byte AE_Msg, 32-byte aee_ioctl, "
+	       "0x404c7007/0x41287007 thread-reg ioctls");
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* CLI                                                                */
+/* ------------------------------------------------------------------ */
+
+static void usage(void)
+{
+	printf("usage: %s [--device PATH] [--timeout MS] <command>\n"
+	       "\n"
+	       "commands:\n"
+	       "  query                     wait for a pending AE_IND_* release\n"
+	       "  class|type|process|module|backtrace|detail|coredump\n"
+	       "                            send the AE_REQ_* request and print\n"
+	       "                            the response and its payload\n"
+	       "  ccci [--md N]             AE_REQ_DETAIL with the CCCI window\n"
+	       "  close                     send AE_IND_LOG_CLOSE\n"
+	       "  regs --pid N              AEEIOCTL_GET_THREAD_REG(64)\n"
+	       "  bt --pid N                AEEIOCTL_GET_PROCESS_BT\n"
+	       "  --selftest                ABI layout and codec KATs\n",
+	       progname);
+}
+
+int main(int argc, char **argv)
+{
+	const char *device = DEFAULT_DEVICE;
+	int timeout_ms = DEFAULT_TIMEOUT;
+	const char *cmd = NULL;
+	int md = 0;
+	int pid = 0;
+	int i;
+
+	if (argc > 1 && (strcmp(argv[1], "-h") == 0 ||
+			 strcmp(argv[1], "--help") == 0)) {
+		usage();
+		return 0;
+	}
+
+	for (i = 1; i < argc; i++) {
+		const char *a = argv[i];
+
+		if (strcmp(a, "--device") == 0 && i + 1 < argc) {
+			device = argv[++i];
+		} else if (strcmp(a, "--timeout") == 0 && i + 1 < argc) {
+			timeout_ms = atoi(argv[++i]);
+		} else if (strcmp(a, "--md") == 0 && i + 1 < argc) {
+			md = atoi(argv[++i]);
+		} else if (strcmp(a, "--pid") == 0 && i + 1 < argc) {
+			pid = atoi(argv[++i]);
+		} else if (strcmp(a, "--selftest") == 0) {
+			return run_selftest();
+		} else if (a[0] == '-') {
+			errmsg("unknown option %s", a);
+			usage();
+			return 2;
+		} else if (!cmd) {
+			cmd = a;
+		} else {
+			errmsg("unexpected argument %s", a);
+			usage();
+			return 2;
+		}
+	}
+
+	if (!cmd) {
+		usage();
+		return 2;
+	}
+
+	if (!strcmp(cmd, "query"))
+		return cmd_query(device, timeout_ms);
+	if (!strcmp(cmd, "class"))
+		return cmd_request(device, AE_REQ_CLASS, timeout_ms, false);
+	if (!strcmp(cmd, "type"))
+		return cmd_request(device, AE_REQ_TYPE, timeout_ms, false);
+	if (!strcmp(cmd, "process"))
+		return cmd_request(device, AE_REQ_PROCESS, timeout_ms, false);
+	if (!strcmp(cmd, "module"))
+		return cmd_request(device, AE_REQ_MODULE, timeout_ms, false);
+	if (!strcmp(cmd, "backtrace"))
+		return cmd_request(device, AE_REQ_BACKTRACE, timeout_ms, false);
+	if (!strcmp(cmd, "detail"))
+		return cmd_request(device, AE_REQ_DETAIL, timeout_ms, true);
+	if (!strcmp(cmd, "coredump"))
+		return cmd_request(device, AE_REQ_COREDUMP, timeout_ms, false);
+	if (!strcmp(cmd, "ccci"))
+		return cmd_ccci(device, md, timeout_ms);
+	if (!strcmp(cmd, "close"))
+		return cmd_close(device);
+	if (!strcmp(cmd, "regs"))
+		return cmd_regs(device, pid);
+	if (!strcmp(cmd, "bt"))
+		return cmd_bt(device, pid);
+
+	errmsg("unknown command %s", cmd);
+	usage();
+	return 2;
+}
