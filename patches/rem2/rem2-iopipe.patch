+	{ "LSC",
+	  "_ZN13NSIspTuningv311ISP_MGR_LSC5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x67744, 0x0908f244u, 0x67780, 0x17c7f362u, 7, IOPIPE_RM_BFI,
+	  0x677ae, 0xeb76f7d3u, "CTL_EN_P1" },
