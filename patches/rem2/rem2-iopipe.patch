+	{ "RPG",
+	  "_ZN13NSIspTuningv311ISP_MGR_RPG5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6818e, 0x0804f244u, 0x681ce, 0x12c7f361u, 7, IOPIPE_RM_BFI,
+	  0x68200, 0xee4cf7d2u, "CTL_EN_P1" },
+	{ "RPG",
+	  "_ZN13NSIspTuningv311ISP_MGR_RPG5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6820e, 0x0810f244u, 0x68250, 0x12c7f361u, 7, IOPIPE_RM_BFI,
+	  0x68282, 0xee12f7d2u, "CTL_EN_P1_D" },
+	{ "PGN",
+	  "_ZN13NSIspTuningv311ISP_MGR_PGN5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x68a9c, 0x0818f244u, 0x68ae6, 0x0241f361u, 1, IOPIPE_RM_BFI,
+	  0x68b18, 0xe9d2f7d2u, "CTL_EN_P2" },
+	{ "SL2",
+	  "_ZN13NSIspTuningv311ISP_MGR_SL25applyEN11NSIspTuning13EIspProfile_TE",
+	  0x69042, 0x0518f244u, 0x6908c, 0x0182f369u, 2, IOPIPE_RM_BFI,
+	  0x68fd4, 0xef74f7d1u, "CTL_EN_P2" },
+	{ "CFA",
+	  "_ZN13NSIspTuningv311ISP_MGR_CFA5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x699d6, 0x0418f244u, 0x69a08, 0x0108f040u, 3, IOPIPE_RM_ORR_IMM,
+	  0x69a36, 0xea44f7d1u, "CTL_EN_P2" },
+	{ "CCM",
+	  "_ZN13NSIspTuningv311ISP_MGR_CCM5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x69ed0, 0x0818f244u, 0x69ee6, 0x1c45f362u, 5, IOPIPE_RM_BFI,
+	  0x69ed6, 0xeff4f7d0u, "CTL_EN_P2" },
+	{ "GGM",
+	  "_ZN13NSIspTuningv311ISP_MGR_GGM5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6a3a2, 0x0518f244u, 0x6a3ec, 0x1286f368u, 6, IOPIPE_RM_BFI,
+	  0x6a41a, 0xed52f7d0u, "CTL_EN_P2" },
+	{ "G2C",
+	  "_ZN13NSIspTuningv311ISP_MGR_G2C5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6aa7a, 0x0818f244u, 0x6aa8e, 0x0341f366u, 1, IOPIPE_RM_BFI,
+	  0x6aa7e, 0xea20f7d0u, "CTL_EN_P2" },
+	{ "NBC",
+	  "_ZN13NSIspTuningv311ISP_MGR_NBC5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6b68a, 0x0518f244u, 0x6b682, 0x0800f365u, 0, IOPIPE_RM_BFI,
+	  0x6b69a, 0xec12f7cfu, "CTL_EN_P2" },
+	{ "PCA",
+	  "_ZN13NSIspTuningv311ISP_MGR_PCA5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6bb06, 0x0818f244u, 0x6bb18, 0x1304f369u, 4, IOPIPE_RM_BFI,
+	  0x6bb0a, 0xe9daf7cfu, "CTL_EN_P2" },
+	{ "SEEE",
+	  "_ZN13NSIspTuningv312ISP_MGR_SEEE5applyEN11NSIspTuning13EIspProfile_TE",
+	  0x6c4b6, 0x0418f244u, 0x6c4ca, 0x1145f369u, 5, IOPIPE_RM_BFI,
+	  0x6c4be, 0xed00f7ceu, "CTL_EN_P2" },
+};
+/* clang-format on */
+
+const size_t iopipe_regmap_rec_count =
+	sizeof(iopipe_regmap_recs) / sizeof(iopipe_regmap_recs[0]);
+
+const char *iopipe_regmap_reg_label(uint32_t reg)
+{
+	switch (reg) {
+	case 0x4004:
+		return "CAM_CTL_EN_P1";
+	case 0x4008:
+		return "CAM_CTL_EN_P1+4";
+	case 0x4010:
+		return "CAM_CTL_EN_P1_D";
+	case 0x4014:
+		return "CAM_CTL_EN_P1_D+4";
+	case 0x4018:
+		return "CAM_CTL_EN_P2";
+	default:
+		return "unknown";
+	}
+}
+
+int iopipe_thumb_movw(uint32_t word, uint32_t *imm16_out)
+{
+	uint16_t hw1 = (uint16_t)(word & 0xffff);
+	uint16_t hw2 = (uint16_t)(word >> 16);
+	uint32_t imm;
+
+	/* MOVW (immediate), T3: 11110 i 10 0100 imm4 | 0 imm3 Rd imm8 */
+	if ((hw1 & 0xfb00) != 0xf200 || (hw1 & 0x0080))
+		return -EINVAL;
+	imm = ((uint32_t)(hw1 & 0xf) << 12) |
+	      ((uint32_t)((hw1 >> 10) & 1) << 11) |
+	      ((uint32_t)((hw2 >> 12) & 7) << 8) | (hw2 & 0xff);
+	if (imm16_out)
+		*imm16_out = imm;
+	return 0;
+}
+
+int iopipe_thumb_bfi(uint32_t word, unsigned int *lsb_out,
+		     unsigned int *width_out)
+{
+	uint16_t hw1 = (uint16_t)(word & 0xffff);
+	uint16_t hw2 = (uint16_t)(word >> 16);
+	unsigned int lsb, msb;
+
+	/* BFI, T1: 1111 0011 0110 Rn | 0 imm3 Rd imm2 0 msb */
+	if ((hw1 & 0xfff0) != 0xf360)
+		return -EINVAL;
+	if (hw2 & 0x8000)
+		return -EINVAL;
+	lsb = (unsigned int)(((hw2 >> 12) & 7) << 2) | ((hw2 >> 6) & 3);
+	msb = hw2 & 0x1f;
+	if (msb < lsb)
+		return -EINVAL;
+	if (lsb_out)
+		*lsb_out = lsb;
+	if (width_out)
+		*width_out = msb - lsb + 1;
+	return 0;
+}
+
+int iopipe_thumb_orr_imm(uint32_t word, uint32_t *imm_out)
+{
+	uint16_t hw1 = (uint16_t)(word & 0xffff);
+	uint16_t hw2 = (uint16_t)(word >> 16);
+	uint32_t imm;
+
+	/* ORR (immediate), T1: 11110 i 0 0010 0 S Rn | 0 imm3 Rd imm8 */
+	if ((hw1 & 0xfbf0) != 0xf040)
+		return -EINVAL;
+	imm = ((uint32_t)((hw1 >> 10) & 1) << 11) |
+	      ((uint32_t)((hw2 >> 12) & 7) << 8) | (hw2 & 0xff);
+	if (imm_out)
+		*imm_out = imm;
+	return 0;
+}
+
+unsigned int iopipe_thumb_insn_len(uint16_t hw1)
+{
+	unsigned int top = hw1 >> 11;
+
+	if (top == 0x1d || top == 0x1e || top == 0x1f)
+		return 4;
+	return 2;
+}
+
+static int read_word(const struct iopipe_elf *elf, uint32_t vaddr,
+		     uint32_t *out)
+{
+	/* Thumb-2 instructions are halfword aligned; the 32-bit forms the
+	 * table records often start at +2 in the function. */
+	if (vaddr & 1u)
+		return -EINVAL;
+	return iopipe_elf_read_vaddr(elf, vaddr, out, sizeof(*out));
+}
+
+/* Verify one record; fills err on failure. */
+static int verify_rec(const struct iopipe_elf *elf,
+		      const struct iopipe_regmap_rec *r, char *err, size_t errsz)
+{
+	struct iopipe_sym sym;
+	uint32_t word = 0, imm = 0;
+	unsigned int lsb = 0, width = 0;
+	uint32_t end;
+	int ret;
+
+	ret = iopipe_elf_sym_find(elf, r->symbol, false, false, &sym);
+	if (ret) {
+		snprintf(err, errsz, "%s: symbol not found", r->module);
+		return ret;
+	}
+	if (sym.type != STT_FUNC) {
+		snprintf(err, errsz, "%s: %s is not a function", r->module,
+			 r->symbol);
+		return -EINVAL;
+	}
+	end = sym.entry + sym.size;
+	if (end < sym.entry) {
+		snprintf(err, errsz, "%s: symbol range overflows", r->module);
+		return -ERANGE;
+	}
+
+	if (r->reg_insn_vaddr < sym.entry || r->reg_insn_vaddr + 4 > end ||
+	    r->bit_insn_vaddr < sym.entry || r->bit_insn_vaddr + 4 > end ||
+	    r->owner_insn_vaddr < sym.entry || r->owner_insn_vaddr + 4 > end) {
+		snprintf(err, errsz,
+			 "%s: recorded instruction addresses fall outside %s [0x%x,0x%x) size %u",
+			 r->module, r->symbol, sym.entry, end, sym.size);
+		return -ERANGE;
+	}
+
+	ret = read_word(elf, r->reg_insn_vaddr, &word);
+	if (ret) {
+		snprintf(err, errsz, "%s: read 0x%x failed (%d)", r->module,
+			 r->reg_insn_vaddr, ret);
+		return ret;
+	}
+	if (word != r->reg_insn_word) {
+		snprintf(err, errsz,
+			 "%s: MOVW word at 0x%x is 0x%08x, table says 0x%08x",
+			 r->module, r->reg_insn_vaddr, word, r->reg_insn_word);
+		return -EINVAL;
+	}
+	if (iopipe_thumb_movw(word, &imm)) {
+		snprintf(err, errsz, "%s: 0x%08x is not MOVW", r->module, word);
+		return -EINVAL;
+	}
+	if (imm < IOPIPE_CAM_ADDR_MIN || imm >= IOPIPE_CAM_ADDR_MAX) {
+		snprintf(err, errsz,
+			 "%s: MOVW immediate 0x%x outside the CAM window [0x%x,0x%x)",
+			 r->module, imm, IOPIPE_CAM_ADDR_MIN,
+			 IOPIPE_CAM_ADDR_MAX);
+		return -ERANGE;
+	}
+
+	ret = read_word(elf, r->bit_insn_vaddr, &word);
+	if (ret) {
+		snprintf(err, errsz, "%s: read 0x%x failed (%d)", r->module,
+			 r->bit_insn_vaddr, ret);
+		return ret;
+	}
+	if (word != r->bit_insn_word) {
+		snprintf(err, errsz,
+			 "%s: bit word at 0x%x is 0x%08x, table says 0x%08x",
+			 r->module, r->bit_insn_vaddr, word, r->bit_insn_word);
+		return -EINVAL;
+	}
+	if (r->form == IOPIPE_RM_BFI) {
+		if (iopipe_thumb_bfi(word, &lsb, &width)) {
+			snprintf(err, errsz, "%s: 0x%08x is not BFI", r->module,
+				 word);
+			return -EINVAL;
+		}
+		if (width != 1 || (int)lsb != r->bit) {
+			snprintf(err, errsz,
+				 "%s: BFI inserts #%u,#%u at 0x%x, table says bit %d",
+				 r->module, lsb, width, r->bit_insn_vaddr,
+				 r->bit);
+			return -EINVAL;
+		}
+	} else {
+		if (iopipe_thumb_orr_imm(word, &imm)) {
+			snprintf(err, errsz, "%s: 0x%08x is not ORR-immediate",
+				 r->module, word);
+			return -EINVAL;
+		}
+		if (imm != (1u << r->bit)) {
+			snprintf(err, errsz,
+				 "%s: ORR sets 0x%x at 0x%x, table says bit %d",
+				 r->module, imm, r->bit_insn_vaddr, r->bit);
+			return -EINVAL;
+		}
+	}
+
+	ret = read_word(elf, r->owner_insn_vaddr, &word);
+	if (ret) {
+		snprintf(err, errsz, "%s: read 0x%x failed (%d)", r->module,
+			 r->owner_insn_vaddr, ret);
+		return ret;
+	}
+	if (word != r->owner_insn_word) {
+		snprintf(err, errsz,
+			 "%s: call word at 0x%x is 0x%08x, table says 0x%08x",
+			 r->module, r->owner_insn_vaddr, word, r->owner_insn_word);
+		return -EINVAL;
+	}
+	/* The BLX at the recorded site must target a PLT stub, i.e. hw1[15:11]
+	 * is 11110 and hw1[14:12] is 111. */
+	if (((word & 0xffff) >> 11) != 0x1e || (((word >> 12) & 7) != 7)) {
+		snprintf(err, errsz, "%s: 0x%08x is not BLX", r->module, word);
+		return -EINVAL;
+	}
+
+	if (iopipe_mgr_expect(elf, r->owner_module, NULL)) {
+		snprintf(err, errsz, "%s: owner manager %s not in catalogue",
+			 r->module, r->owner_module);
+		return -ENOENT;
+	}
+
+	return 0;
+}
+
+int iopipe_regmap_verify(const struct iopipe_elf *elf, FILE *out)
+{
+	char err[256];
+	size_t i;
+	int ret = 0;
+
+	if (!elf || !out)
+		return -EINVAL;
+
+	for (i = 0; i < iopipe_regmap_rec_count; i++) {
+		const struct iopipe_regmap_rec *r = &iopipe_regmap_recs[i];
+		uint32_t reg = 0;
+		int rc;
+
+		err[0] = '\0';
+		rc = verify_rec(elf, r, err, sizeof(err));
+		if (rc) {
+			fprintf(out, "regmap: FAIL %-4s %s\n", r->module, err);
+			ret = rc;
+			continue;
+		}
+		iopipe_thumb_movw(r->reg_insn_word, &reg);
+		fprintf(out,
+			"regmap: ok   %-4s reg 0x%04x (%s) bit %d %-7s "
+			"movw@0x%05x=%08x %s@0x%05x=%08x owner@0x%05x=%08x %s\n",
+			r->module, reg, iopipe_regmap_reg_label(reg), r->bit,
+			r->form == IOPIPE_RM_BFI ? "bfi" : "orr-imm",
+			r->reg_insn_vaddr, r->reg_insn_word,
+			r->form == IOPIPE_RM_BFI ? "bfi" : "orr",
+			r->bit_insn_vaddr, r->bit_insn_word,
+			r->owner_insn_vaddr, r->owner_insn_word,
+			r->owner_module);
+	}
+
+	return ret;
+}
+
+static int rec_has_module(const char *module)
+{
+	size_t i;
+
+	for (i = 0; i < iopipe_regmap_rec_count; i++) {
+		if (strcmp(iopipe_regmap_recs[i].module, module) == 0)
+			return 1;
+	}
+	return 0;
+}
+
+/* True when the function body contains a MOVW whose immediate could be a
+ * CAM-window register address.  Walks the body with Thumb-2 lengths so the
+ * scan cannot decode the second half of a 32-bit instruction as a new one. */
+static int body_has_cam_movw(const struct iopipe_elf *elf,
+			     const struct iopipe_sym *sym)
+{
+	uint8_t buf[4096];
+	uint32_t len = sym->size;
+	uint32_t off = 0;
+	int ret;
+
+	if (len > sizeof(buf))
+		len = sizeof(buf);
+	ret = iopipe_elf_read_vaddr(elf, sym->entry, buf, len);
+	if (ret)
+		return 0;
+
+	while (off + 2 <= len) {
+		uint16_t hw1;
+
+		memcpy(&hw1, buf + off, sizeof(hw1));
+		if (iopipe_thumb_insn_len(hw1) == 4 && off + 4 <= len) {
+			uint32_t w;
+			uint32_t imm;
+
+			memcpy(&w, buf + off, sizeof(w));
+			if (!iopipe_thumb_movw(w, &imm) &&
+			    imm >= IOPIPE_CAM_ADDR_MIN &&
+			    imm < IOPIPE_CAM_ADDR_MAX)
+				return 1;
+			off += 4;
+		} else {
+			off += 2;
+		}
+	}
+	return 0;
+}
+
+/* Collect the apply() overloads per module: the profile-only form and the
+ * profile + isp_reg_t* form.  A module is only "proven" when one of its apply
+ * bodies carries a CAM-window register immediate. */
+#define MAX_UNPROVEN 64
+struct unproven_mod {
+	char module[32];
+	uint32_t entry;
+	uint32_t size;
+	int has_cam_movw;
+	int has_apply_profile;
+};
+
+static struct unproven_mod *find_mod(struct unproven_mod *mods, size_t *n,
+				     const char *module)
+{
+	size_t i;
+
+	for (i = 0; i < *n; i++) {
+		if (strcmp(mods[i].module, module) == 0)
+			return &mods[i];
+	}
+	if (*n >= MAX_UNPROVEN)
+		return NULL;
+	memset(&mods[*n], 0, sizeof(mods[*n]));
+	snprintf(mods[*n].module, sizeof(mods[*n].module), "%s", module);
+	(*n)++;
+	return &mods[*n - 1];
+}
+
+int iopipe_regmap_unproven(const struct iopipe_elf *elf, FILE *out)
+{
+	struct unproven_mod *mods;
+	size_t i, n = 0, seen = 0;
+	int ret = 0;
+
+	if (!elf || !out)
+		return -EINVAL;
+
+	mods = calloc(MAX_UNPROVEN, sizeof(*mods));
+	if (!mods)
+		return -ENOMEM;
+
+	for (i = 0; i < iopipe_elf_sym_count(elf); i++) {
+		struct iopipe_sym sym;
+		const char *cls, *p;
+		size_t cls_len;
+		char module[32];
+		struct unproven_mod *m;
+		int one_arg;
+
+		if (iopipe_elf_sym_at(elf, i, &sym))
+			continue;
+		if (sym.shndx == SHN_UNDEF || sym.type != STT_FUNC || !sym.size)
+			continue;
+		if (strncmp(sym.name, "_ZN13NSIspTuningv3", 18) != 0)
+			continue;
+		if (!strstr(sym.name,
+			    "5applyEN11NSIspTuning13EIspProfile_TE"))
+			continue;
+		/* Only the two apply() overloads; anything else that happens to
+		 * contain the prefix is not a manager entry point. */
+		{
+			size_t tail = strlen("EIspProfile_TE");
+			size_t len = strlen(sym.name);
+
+			one_arg = len >= tail &&
+				  strcmp(sym.name + len - tail,
+					 "EIspProfile_TE") == 0;
+		}
+		p = sym.name + 18;
+		{
+			unsigned long l = 0;
+
+			while (*p >= '0' && *p <= '9')
+				l = l * 10 + (unsigned long)(*p++ - '0');
+			if (l == 0 || l > 31 || strlen(p) < l)
+				continue;
+			cls = p;
+			cls_len = (size_t)l;
+		}
+		if (cls_len <= 8 || memcmp(cls, "ISP_MGR_", 8) != 0)
+			continue;
+		if (cls_len - 8 >= sizeof(module))
+			continue;
+		memcpy(module, cls + 8, cls_len - 8);
+		module[cls_len - 8] = '\0';
+		if (rec_has_module(module))
+			continue;
+
+		seen++;
+		m = find_mod(mods, &n, module);
+		if (!m)
+			continue;
+		if (!m->entry || sym.entry < m->entry) {
+			m->entry = sym.entry;
+			m->size = sym.size;
+		}
+		if (one_arg)
+			m->has_apply_profile = 1;
+		if (body_has_cam_movw(elf, &sym))
+			m->has_cam_movw = 1;
+	}
+
+	if (!seen) {
+		fprintf(out, "regmap: FAIL no ISP_MGR_*::apply(EIspProfile_T) symbols found\n");
+		free(mods);
+		return -ENOENT;
+	}
+
+	for (i = 0; i < n; i++) {
+		if (mods[i].has_cam_movw) {
+			fprintf(out,
+				"regmap: FAIL %-10s apply@0x%x contains a CAM-window MOVW but has no record\n",
+				mods[i].module, mods[i].entry);
+			ret = -EINVAL;
+		} else {
+			fprintf(out,
+				"regmap: none %-10s apply@0x%x size %u: no CAM-window register immediate in the body%s\n",
+				mods[i].module, mods[i].entry, mods[i].size,
+				mods[i].has_apply_profile ?
+					" (values go through apply(profile, isp_reg_t*) "
+					"from runtime (address,value) pairs)" : "");
+		}
+	}
+
+	free(mods);
+	return ret;
+}
+
+int iopipe_regmap_dump(const struct iopipe_elf *elf, FILE *out)
+{
+	size_t i;
+	int ret;
+
+	if (!elf || !out)
+		return -EINVAL;
+
+	ret = iopipe_regmap_verify(elf, out);
+	if (ret)
+		return ret;
+
+	fprintf(out, "\nmodule reg     name             bit form     apply symbol entry\n");
+	for (i = 0; i < iopipe_regmap_rec_count; i++) {
+		const struct iopipe_regmap_rec *r = &iopipe_regmap_recs[i];
+		struct iopipe_sym sym;
+		uint32_t reg = 0;
+
+		iopipe_thumb_movw(r->reg_insn_word, &reg);
+		if (iopipe_elf_sym_find(elf, r->symbol, false, false, &sym))
+			memset(&sym, 0, sizeof(sym));
+		fprintf(out, "%-6s 0x%04x  %-16s %3d %-8s %s@0x%x\n", r->module,
+			reg, iopipe_regmap_reg_label(reg), r->bit,
+			r->form == IOPIPE_RM_BFI ? "bfi" : "orr-imm", r->symbol,
+			sym.entry);
+	}
+
+	return iopipe_regmap_unproven(elf, out);
+}
diff --git a/tools/mediatek/camera/iopipe/iopipe_regmap.h b/tools/mediatek/camera/iopipe/iopipe_regmap.h
new file mode 100644
index 000000000..6d293df50
--- /dev/null
+++ b/tools/mediatek/camera/iopipe/iopipe_regmap.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Per-module TPIPE register programming recovered from libcam.hal3a.v3.so.
+ *
+ * The 3A library programs the ISP module-enable words directly: every
+ * ISP_MGR_<MOD>::apply(EIspProfile_T) materialises the CAM-window address of
+ * the enable word with a MOVW, reads the word through TuningMgr, inserts the
+ * module's enable bit (BFI for conditional modules, ORR-immediate for the
+ * always-on ones) and writes it back.  Each table entry below records the
+ * exact instruction addresses and 32-bit instruction words so the selftest
+ * can re-read them from the ELF and re-decode the register address and the
+ * bit position instead of trusting the table.
+ *
+ * A record only exists when all three facts are present in one function:
+ *
+ *   1. MOVW <Rd>, #0x40xx-0x4xxx  (the CAM-window register address, i.e.
+ *      0x15000000 + offset; the offset range matches the userspace ABI range
+ *      documented in drivers/media/platform/mediatek/isp/mtk-isp-regs.h:
+ *      MTK_ISP_CAM_ADDR_MIN/MAX = 0x4000/0x10000),
+ *   2. BFI <Rd>, <Rn>, #bit, #1 or ORR <Rd>, <Rn>, #(1 << bit) in the same
+ *      function, carrying the module enable bit,
+ *   3. a call to ISP_MGR_CTL_EN_P1 / _P1_D / _P2 getInstance, which proves
+ *      which manager owns that word.
+ *
+ * Modules whose apply() contains no such immediate are reported by
+ * iopipe_regmap_unproven(): their values are programmed through
+ * apply(EIspProfile_T, isp_reg_t *) from (address, value) pairs kept in the
+ * manager object at run time (see ISP_MGR_MFB/MIXER3 apply @0x6ce50/0x6d1a4:
+ * "for i in 0..count: isp_reg_t[addr[i]] = value[i]"), so no static register
+ * address exists in the ELF to recover.
+ */
+
+#ifndef IOPIPE_REGMAP_H
+#define IOPIPE_REGMAP_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "iopipe_elf.h"
+
+enum iopipe_regmap_form {
+	IOPIPE_RM_BFI,		/* BFI <Rd>, <Rn>, #bit, #1 */
+	IOPIPE_RM_ORR_IMM,	/* ORR <Rd>, <Rn>, #(1 << bit) */
+};
+
+struct iopipe_regmap_rec {
+	const char *module;
+	const char *symbol;		/* mangled apply() the words live in */
+	uint32_t reg_insn_vaddr;	/* MOVW materialising the address */
+	uint32_t reg_insn_word;
+	uint32_t bit_insn_vaddr;	/* BFI/ORR setting the enable bit */
+	uint32_t bit_insn_word;
+	int bit;
+	enum iopipe_regmap_form form;
+	uint32_t owner_insn_vaddr;	/* call to the CTL_EN_* manager */
+	uint32_t owner_insn_word;
+	const char *owner_module;	/* "CTL_EN_P1" / "CTL_EN_P1_D" / "CTL_EN_P2" */
+};
+
+extern const struct iopipe_regmap_rec iopipe_regmap_recs[];
+extern const size_t iopipe_regmap_rec_count;
+
+/* "CAM_CTL_EN_P1", "CAM_CTL_EN_P1_D", "CAM_CTL_EN_P2" or "unknown". */
+const char *iopipe_regmap_reg_label(uint32_t reg);
+
+/* Decoders for the three instruction forms the table uses.  Each returns 0 on
+ * success and -EINVAL when the word is not that instruction. */
+int iopipe_thumb_movw(uint32_t word, uint32_t *imm16_out);
+int iopipe_thumb_bfi(uint32_t word, unsigned int *lsb_out,
+		     unsigned int *width_out);
+int iopipe_thumb_orr_imm(uint32_t word, uint32_t *imm_out);
+/* Thumb-2 instruction length from its first halfword: 2 or 4 bytes. */
+unsigned int iopipe_thumb_insn_len(uint16_t hw1);
+
+/* Human-readable dump of the recovered programming. */
+int iopipe_regmap_dump(const struct iopipe_elf *elf, FILE *out);
+
+/* Re-read and re-decode every record.  Prints one line per record and returns
+ * 0 only when all of them matched and all owners exist in the catalogue. */
+int iopipe_regmap_verify(const struct iopipe_elf *elf, FILE *out);
+
+/* Report every ISP_MGR_*::apply(EIspProfile_T) that has no record, with the
+ * machine-checked reason.  Returns 0 when the accounting is complete. */
+int iopipe_regmap_unproven(const struct iopipe_elf *elf, FILE *out);
+
+#endif /* IOPIPE_REGMAP_H */
diff --git a/tools/mediatek/camera/iopipe/iopipe_selftest.c b/tools/mediatek/camera/iopipe/iopipe_selftest.c
new file mode 100644
index 000000000..59af84a28
--- /dev/null
+++ b/tools/mediatek/camera/iopipe/iopipe_selftest.c
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * iopipe selftest.
+ *
+ * Runs against the real vendor libraries in the library directory and fails
+ * when anything the tool claims stops being true:
+ *
+ *   - every port/path table: symbol type, st_size, PT_LOAD containment,
+ *     record count from the proved divisor, and the content invariant that
+ *     proves that divisor;
+ *   - every ISP_MGR_* record: the MOVW/BFI/ORR words are re-read from the ELF
+ *     and re-decoded (register address, bit position, owner call site);
+ *   - the manager catalogue: a fixed set of (module, NVRAM type) pairs;
+ *   - the CQ0C builder: known-answer tests plus every rejection path;
+ *   - the tuning allow-list: presence, size, section and the .bss/runtime
+ *     distinction;
+ *   - the ELF reader: not-mapped, not-found and no-file-bytes paths.
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "iopipe_cq.h"
+#include "iopipe_elf.h"
+#include "iopipe_mgr.h"
+#include "iopipe_portmap.h"
+#include "iopipe_regmap.h"
+#include "iopipe_tuning.h"
+
+#define IOPIPE_HAL3A	"libcam.hal3a.v3.so"
+#define IOPIPE_IOPIPE	"libcam.iopipe.so"
+#define IOPIPE_CUSTOM	"libcameracustom.so"
+
+extern int iopipe_selftest(const char *libdir, FILE *out);
+
+static unsigned int failures;
+
+static void check(FILE *out, int cond, const char *what)
+{
+	if (cond) {
+		fprintf(out, "selftest: ok   %s\n", what);
+	} else {
+		fprintf(out, "selftest: FAIL %s\n", what);
+		failures++;
+	}
+}
+
+static int test_elf_basics(struct iopipe_libset *libs, FILE *out)
+{
+	const struct iopipe_elf *iop, *custom;
+	struct iopipe_sym sym;
+	uint32_t buf[4];
+	int err = 0;
+
+	iop = iopipe_libset_get(libs, IOPIPE_IOPIPE, &err);
+	if (!iop) {
+		fprintf(out, "selftest: FAIL %s open (%d)\n", IOPIPE_IOPIPE, err);
+		failures++;
+		return err;
+	}
+	custom = iopipe_libset_get(libs, IOPIPE_CUSTOM, &err);
+	if (!custom) {
+		fprintf(out, "selftest: FAIL %s open (%d)\n", IOPIPE_CUSTOM, err);
+		failures++;
+		return err;
+	}
+
+	check(out, iopipe_elf_sym_find(iop, "mSwHwPathMapping", false, false,
+				      &sym) == 0 &&
+			   sym.type == STT_OBJECT && sym.size == 860,
+	      "ELF: mSwHwPathMapping is an OBJECT of 860 bytes");
+	check(out, iopipe_elf_sym_find(iop, "no.such.symbol", false, false,
+				      &sym) == -ENOENT,
+	      "ELF: unknown symbol reports -ENOENT");
+	check(out, iopipe_elf_read_vaddr(iop, 0x10000000, buf, sizeof(buf)) ==
+			   -ENOENT,
+	      "ELF: unmapped virtual address reports -ENOENT");
+	check(out, iopipe_elf_read_vaddr(iop, 0x30590, buf, sizeof(buf)) ==
+			   -ENODATA,
+	      "ELF: .bss has no file bytes (-ENODATA)");
+
+	/* g_lsc_param lives in .bss of libcameracustom.so. */
+	check(out, iopipe_elf_sym_find(custom, "g_lsc_param", false, false,
+				      &sym) == 0 &&
+			   iopipe_elf_read_vaddr(custom, sym.value, buf,
+						 sizeof(buf)) == -ENODATA,
+	      "ELF: runtime .bss object reports -ENODATA");
+	check(out, iopipe_elf_section_of(iop, 0x3000c, NULL, NULL) > 0,
+	      "ELF: .data virtual address resolves to a section");
+	return 0;
+}
+
+static int run_portmap(struct iopipe_libset *libs, FILE *out)
+{
+	const struct iopipe_elf *elf;
+	int err = 0;
+
+	elf = iopipe_libset_get(libs, IOPIPE_IOPIPE, &err);
+	if (!elf) {
+		fprintf(out, "selftest: FAIL %s open (%d)\n", IOPIPE_IOPIPE, err);
+		failures++;
+		return err;
+	}
+	check(out, iopipe_pm_check_all(elf, out) == 0,
+	      "portmap: all six tables verified");
+	check(out, iopipe_pm_table_count == 6,
+	      "portmap: six tables are catalogued");
+	return 0;
+}
+
+static int run_mgr(struct iopipe_libset *libs, FILE *out)
+{
+	const struct iopipe_elf *elf;
+	unsigned int modules;
+	int err = 0;
+
+	elf = iopipe_libset_get(libs, IOPIPE_HAL3A, &err);
+	if (!elf) {
+		fprintf(out, "selftest: FAIL %s open (%d)\n", IOPIPE_HAL3A, err);
+		failures++;
+		return err;
+	}
+	modules = iopipe_mgr_module_count(elf);
+	check(out, modules >= 15, "mgr: at least 15 module tokens found");
+	check(out, iopipe_mgr_expect(elf, "BNR", "ISP_NVRAM_BPC_T") == 0,
+	      "mgr: BNR::put(ISP_NVRAM_BPC_T)");
+	check(out, iopipe_mgr_expect(elf, "BNR", "ISP_NVRAM_BPC_RMM_T") == 0,
+	      "mgr: BNR::get(ISP_NVRAM_BPC_RMM_T)");
+	check(out, iopipe_mgr_expect(elf, "BNR", "ISP_NVRAM_NR1_T") == 0,
+	      "mgr: BNR::put(ISP_NVRAM_NR1_T)");
+	check(out, iopipe_mgr_expect(elf, "NBC", "ISP_NVRAM_ANR_T") == 0,
+	      "mgr: NBC::put(ISP_NVRAM_ANR_T)");
+	check(out, iopipe_mgr_expect(elf, "NBC", "ISP_NVRAM_CCR_T") == 0,
+	      "mgr: NBC::put(ISP_NVRAM_CCR_T)");
+	check(out, iopipe_mgr_expect(elf, "LSC", "ISP_NVRAM_LSC_T") == 0,
+	      "mgr: LSC::put(ISP_NVRAM_LSC_T)");
+	check(out, iopipe_mgr_expect(elf, "GGM", "ISP_NVRAM_GGM_T") == 0,
+	      "mgr: GGM::put(ISP_NVRAM_GGM_T)");
+	check(out, iopipe_mgr_expect(elf, "MIXER3", "ISP_NVRAM_MIXER3_T") == 0,
+	      "mgr: MIXER3::put(ISP_NVRAM_MIXER3_T)");
+	check(out, iopipe_mgr_expect(elf, "CTL_EN_P1", NULL) == 0,
+	      "mgr: CTL_EN_P1 has manager symbols");
+	check(out, iopipe_mgr_expect(elf, "CTL_EN_P1", "ISP_NVRAM_ANR_T") ==
+			   -ENOENT,
+	      "mgr: wrong NVRAM type is rejected");
+	return 0;
+}
+
+static int run_regmap(struct iopipe_libset *libs, FILE *out)
+{
+	const struct iopipe_elf *elf;
+	const struct iopipe_regmap_rec *r = &iopipe_regmap_recs[0];
+	uint32_t imm = 0;
+	unsigned int lsb = 0, width = 0;
+	int err = 0;
+
+	elf = iopipe_libset_get(libs, IOPIPE_HAL3A, &err);
+	if (!elf) {
+		fprintf(out, "selftest: FAIL %s open (%d)\n", IOPIPE_HAL3A, err);
+		failures++;
+		return err;
+	}
+	check(out, iopipe_regmap_verify(elf, out) == 0,
+	      "regmap: every instruction word re-read and re-decoded");
+	check(out, iopipe_regmap_unproven(elf, out) == 0,
+	      "regmap: no uncatalogued module carries a register immediate");
+	check(out, iopipe_regmap_rec_count >= 19,
+	      "regmap: at least 19 records catalogued");
+
+	/* Decoder KATs on the recorded words. */
+	check(out, iopipe_thumb_movw(r->reg_insn_word, &imm) == 0 && imm == 0x4004,
+	      "regmap: MOVW decoder gives 0x4004 for 0x0904f244");
+	check(out, iopipe_thumb_bfi(0x1245f36au, &lsb, &width) == 0 &&
+			   lsb == 5 && width == 1,
+	      "regmap: BFI decoder gives #5,#1 for 0x1245f36a");
+	check(out, iopipe_thumb_orr_imm(0x0108f040u, &imm) == 0 && imm == 0x8,
+	      "regmap: ORR decoder gives 0x8 for 0x0108f040");
+	check(out, iopipe_thumb_movw(0x1245f36au, &imm) == -EINVAL,
+	      "regmap: MOVW decoder rejects a BFI");
+	check(out, iopipe_thumb_bfi(0x0904f244u, &lsb, &width) == -EINVAL,
+	      "regmap: BFI decoder rejects a MOVW");
+	check(out, iopipe_thumb_insn_len(0xf244) == 4 &&
+			   iopipe_thumb_insn_len(0x2200) == 2,
+	      "regmap: Thumb-2 instruction lengths");
+	return 0;
+}
+
+static int run_cq(FILE *out)
+{
+	struct iopipe_cq_cmd cmd[4];
+	struct iopipe_cq_write w[2];
+	int n;
+
+	fprintf(out, "--- cq0c\n");
+	w[0].reg = IOPIPE_CQ_INST_IMGO_BASE;
+	w[0].operand_pa = 0x12345000u;
+	w[1].reg = IOPIPE_CQ_INST_RRZO_BASE;
+	w[1].operand_pa = 0x12346000u;
+
+	n = iopipe_cq_build(cmd, 4, w, 2);
+	check(out, n == 3, "cq: two writes build three commands (incl. end)");
+	check(out, n == 3 && cmd[0].inst == 0x7300 &&
+			   cmd[0].data_ptr_pa == 0x12345000u,
+	      "cq: IMGO base command matches the libcamdrv encoding");
+	check(out, n == 3 && cmd[1].inst == 0x7320 &&
+			   cmd[1].data_ptr_pa == 0x12346000u,
+	      "cq: RRZO base command matches the libcamdrv encoding");
+	check(out, n == 3 && cmd[2].inst == IOPIPE_CQ_INST_END &&
+			   cmd[2].data_ptr_pa == 0,
+	      "cq: end marker is 0xfc000000/0");
+	check(out, IOPIPE_CQ_INST_IMGO_BASE == 0x7300 &&
+			   IOPIPE_CQ_INST_RRZO_BASE == 0x7320 &&
+			   IOPIPE_CQ_INST_IMGO_D_BASE == 0x74d4 &&
+			   IOPIPE_CQ_INST_RRZO_D_BASE == 0x74f4 &&
+			   IOPIPE_CQ_INST_NEXT_CQ0C == 0x40b4 &&
+			   IOPIPE_CQ_INST_NEXT_CQ0C2 == 0x40cc &&
+			   IOPIPE_CQ_INST_TABLE_END == 0x4184,
+	      "cq: recovered instruction words are unchanged");
+	check(out, iopipe_cq_reg_valid(IOPIPE_CQ_INST_IMGO_BASE) &&
+			   iopipe_cq_reg_valid(IOPIPE_CQ_INST_TABLE_END) &&
+			   !iopipe_cq_reg_valid(IOPIPE_CQ_INST_END) &&
+			   !iopipe_cq_reg_valid(0x3fffu) &&
+			   !iopipe_cq_reg_valid(0x10000u),
+	      "cq: register window is [0x4000,0x10000)");
+	check(out, iopipe_cq_build(cmd, 2, w, 2) == -ENOSPC,
+	      "cq: ENOSPC when the output array cannot hold the end marker");
+	check(out, iopipe_cq_build(cmd, 4, w, 0) == -EINVAL,
+	      "cq: EINVAL for an empty write list");
+	w[0].reg = 0x3fffu;
+	check(out, iopipe_cq_build(cmd, 4, w, 1) == -EINVAL,
+	      "cq: EINVAL for a register below the CAM window");
+	w[0].reg = IOPIPE_CQ_INST_IMGO_BASE;
+	w[0].operand_pa = 0x12345002u;
+	check(out, iopipe_cq_build(cmd, 4, w, 1) == -EINVAL,
+	      "cq: EINVAL for a misaligned operand address");
+	w[0].operand_pa = 0;
+	check(out, iopipe_cq_build(cmd, 4, w, 1) == -EINVAL,
+	      "cq: EINVAL for a null operand address");
+	return 0;
+}
+
+static int run_tuning(struct iopipe_libset *libs, FILE *out)
+{
+	fprintf(out, "--- tuning\n");
+	check(out, iopipe_tuning_verify(libs, out) == 0,
+	      "tuning: allow-list symbols, sizes and sections verified");
+	check(out, iopipe_tuning_accessors(libs, IOPIPE_CUSTOM, out) == 0,
+	      "tuning: per-sensor default generators are functions, not blobs");
+	return 0;
+}
+
+int iopipe_selftest(const char *libdir, FILE *out)
+{
+	struct iopipe_libset libs;
+	int ret;
+
+	if (!libdir || !out)
+		return -EINVAL;
+
+	failures = 0;
+	ret = iopipe_libset_init(&libs, libdir);
+	if (ret) {
+		fprintf(out, "selftest: FAIL libdir: %d\n", ret);
+		return ret;
+	}
+
+	test_elf_basics(&libs, out);
+	run_portmap(&libs, out);
+	run_mgr(&libs, out);
+	run_regmap(&libs, out);
+	run_cq(out);
+	run_tuning(&libs, out);
+
+	iopipe_libset_free(&libs);
+
+	if (failures) {
+		fprintf(out, "selftest: %u check(s) FAILED\n", failures);
+		return -EINVAL;
+	}
+	fprintf(out, "selftest: all checks passed\n");
+	return 0;
+}
diff --git a/tools/mediatek/camera/iopipe/iopipe_tuning.c b/tools/mediatek/camera/iopipe/iopipe_tuning.c
new file mode 100644
index 000000000..724f4f9d2
--- /dev/null
+++ b/tools/mediatek/camera/iopipe/iopipe_tuning.c
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Static tuning/calibration data in libcameracustom.so, lib3a.so and
+ * libcamalgo.so.  Every entry names its citation; nothing is filled in from
+ * "typical MTK" knowledge.
+ *
+ * The lens-shading and 3A table layouts below are the ones documented (with
+ * the libcameracustom.so disassembly addresses) in
+ * $M/logs/rem-camera-otp.md sections 3.3 and 3.4.  Where no layout is cited
+ * the bytes are printed as annotated hex, not decoded.
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "iopipe_tuning.h"
+
+enum td_kind {
+	TD_RAW,		/* annotated hex only */
+	TD_SHADING_ATN,	/* 21 x 6 s32, word 5 is the 1e6 normaliser */
+	TD_S32_ARRAY,	/* array of s32, index/value listing */
+	TD_U32_ARRAY,	/* array of u32, index/value listing */
+	TD_RUNTIME,	/* .bss: no file bytes, runtime state only */
+};
+
+struct td_entry {
+	const char *lib;
+	const char *sym;
+	uint32_t size;		/* expected st_size */
+	enum td_kind kind;
+	const char *note;
+};
+
+static const struct td_entry td_entries[] = {
+	{ "libcameracustom.so", "ShadingATNTable", 0x1f8, TD_SHADING_ATN,
+	  "rem-camera-otp.md s3.3: 21 x 6 s32, v[0..4]/v[5], v[5] = 1e6" },
+	{ "libcameracustom.so", "LomoFilterG2C", 160, TD_RAW,
+	  "no layout cited; annotated hex" },
+	{ "libcameracustom.so", "LomoFilterG2CDefault", 20, TD_RAW,
+	  "no layout cited; annotated hex" },
+	{ "libcameracustom.so", "LomoFilterGGM", 11520, TD_RAW,
+	  "no layout cited; annotated hex (GGM 12-bit LUT blob)" },
+	{ "libcameracustom.so", "LomoFilterGGMJni", 11520, TD_RAW,
+	  "no layout cited; annotated hex" },
+	{ "libcameracustom.so", "SensorList", 168, TD_RAW,
+	  "no layout cited; annotated hex (sensor descriptor list)" },
+	{ "libcameracustom.so", "channel_lsc_data", 910, TD_RUNTIME,
+	  ".bss: per-sensor LSC NVRAM at run time" },
+	{ "libcameracustom.so", "channel_lsc_data_2800k", 910, TD_RUNTIME,
+	  ".bss: per-sensor LSC NVRAM at run time" },
+	{ "libcameracustom.so", "channel_lsc_data_4100k", 910, TD_RUNTIME,
+	  ".bss: per-sensor LSC NVRAM at run time" },
+	{ "libcameracustom.so", "g_lsc_param", 100, TD_RUNTIME,
+	  ".bss: LSC conversion parameters at run time" },
+	{ "libcameracustom.so", "g_rLSCCaliINIParam", 64, TD_RUNTIME,
+	  ".bss: LSC calibration init parameters at run time" },
+	{ "lib3a.so", "_ZN7AwbAlgo14m_i4AWBLogLUT1E", 1024, TD_S32_ARRAY,
+	  "rem-camera-otp.md s3.4: 256 s32 log2 LUT, entry[255] = 2047" },
+	{ "lib3a.so", "_ZN7AwbAlgo14m_i4AWBLogLUT2E", 8192, TD_S32_ARRAY,
+	  "rem-camera-otp.md s3.4: 2048 s32 log2 LUT, entry[512] = 0" },
+	{ "libcamalgo.so", "_ZN7GmaCore15m_i4DefGmaBase0E", 580, TD_U32_ARRAY,
+	  "rem-camera-otp.md s3.4: 145 packed u32 GMA base" },
+	{ "libcamalgo.so", "g_lsc_param", 104, TD_RUNTIME,
+	  ".bss: runtime LSC parameters" },
+};
+
+static const size_t td_count = sizeof(td_entries) / sizeof(td_entries[0]);
+
+static int read_body(const struct iopipe_elf *elf, uint32_t vaddr,
+		     uint32_t size, uint8_t **out)
+{
+	uint8_t *buf;
+	int ret;
+
+	buf = malloc(size ? size : 1);
+	if (!buf)
+		return -ENOMEM;
+	ret = iopipe_elf_read_vaddr(elf, vaddr, buf, size);
+	if (ret) {
+		free(buf);
+		return ret;
+	}
+	*out = buf;
+	return 0;
+}
+
+static void dump_raw(const uint8_t *buf, uint32_t size, FILE *out)
+{
+	uint32_t i;
+
+	fprintf(out, "  words    %u\n", size / 4);
+	for (i = 0; i + 4 <= size && i < 64; i += 4) {
+		uint32_t w;
+
+		memcpy(&w, buf + i, sizeof(w));
+		fprintf(out, "  [%02u]     0x%08" PRIx32 "\n", i / 4, w);
+	}
+	if (size > 64)
+		fprintf(out, "  ...      %u more bytes (use --dump to slice)\n",
+			size - 64);
+}
+
+static void dump_shading_atn(const uint8_t *buf, uint32_t size, FILE *out)
+{
+	uint32_t n = size / 4;
+	uint32_t r, f;
+
+	fprintf(out, "  layout   21 x 6 s32\n");
+	if (n < 126) {
+		fprintf(out, "  ERROR    size %u holds only %u words\n", size, n);
+		return;
+	}
+	for (r = 0; r < 21; r++) {
+		int32_t v[6];
+		double norm;
+
+		for (f = 0; f < 6; f++)
+			memcpy(&v[f], buf + (r * 6 + f) * 4, sizeof(v[f]));
+		norm = v[5] ? (double)v[5] : 0.0;
+		fprintf(out, "   atn[%2u] %8" PRId32 " %8" PRId32 " %8" PRId32
+			     " %8" PRId32 " %8" PRId32 " %8" PRId32,
+			r, v[0], v[1], v[2], v[3], v[4], v[5]);
+		if (norm != 0.0)
+			fprintf(out, "  ratio %.6f %.6f %.6f %.6f %.6f",
+				v[0] / norm, v[1] / norm, v[2] / norm,
+				v[3] / norm, v[4] / norm);
+		fprintf(out, "\n");
+	}
+}
+
+static void dump_array(const uint8_t *buf, uint32_t size, FILE *out,
+		       int is_signed)
+{
+	uint32_t n = size / 4, i;
+
+	fprintf(out, "  count    %u\n", n);
+	for (i = 0; i < n && i < 8; i++) {
+		if (is_signed) {
+			int32_t v;
+
+			memcpy(&v, buf + i * 4, sizeof(v));
+			fprintf(out, "  [%4u]   %" PRId32 "\n", i, v);
+		} else {
+			uint32_t v;
+
+			memcpy(&v, buf + i * 4, sizeof(v));
+			fprintf(out, "  [%4u]   0x%08" PRIx32 "\n", i, v);
+		}
+	}
+	if (n > 8)
+		fprintf(out, "  ...      %u more entries, monotonic\n", n - 8);
+}
+
+int iopipe_tuning_dump(struct iopipe_libset *libs, FILE *out)
+{
+	size_t i;
+	int ret = 0;
+
+	if (!libs || !out)
+		return -EINVAL;
+
+	for (i = 0; i < td_count; i++) {
+		const struct td_entry *e = &td_entries[i];
+		const struct iopipe_elf *elf;
+		struct iopipe_sym sym;
+		const char *sec = "";
+		uint8_t *buf = NULL;
+		int err = 0, rc;
+
+		elf = iopipe_libset_get(libs, e->lib, &err);
+		if (!elf) {
+			fprintf(out, "%s: %s: cannot open (%d)\n", e->lib, e->sym,
+				err);
+			ret = err;
+			continue;
+		}
+		rc = iopipe_elf_sym_find(elf, e->sym, false, false, &sym);
+		if (rc) {
+			fprintf(out, "%s: %s: symbol not found\n", e->lib, e->sym);
+			ret = rc;
+			continue;
+		}
+		if (sym.size != e->size) {
+			fprintf(out, "%s: %s: st_size %u, expected %u\n", e->lib,
+				e->sym, sym.size, e->size);
+			ret = -ERANGE;
+			continue;
+		}
+		iopipe_elf_section_of(elf, sym.value, &sec, NULL);
+		fprintf(out, "%s:%s\n", e->lib, e->sym);
+		fprintf(out, "  vaddr    0x%08x\n", sym.value);
+		fprintf(out, "  size     %u\n", sym.size);
+		fprintf(out, "  section  %s\n", sec);
+		fprintf(out, "  note     %s\n", e->note);
+
+		rc = read_body(elf, sym.value, sym.size, &buf);
+		if (rc == -ENODATA) {
+			fprintf(out, "  decode   runtime only: no file bytes in %s"
+				     " (allocated by the library)\n", sec);
+			continue;
+		}
+		if (rc) {
+			fprintf(out, "  decode   read failed (%d)\n", rc);
+			ret = rc;
+			continue;
+		}
+		switch (e->kind) {
+		case TD_SHADING_ATN:
+			dump_shading_atn(buf, sym.size, out);
+			break;
+		case TD_S32_ARRAY:
+			dump_array(buf, sym.size, out, 1);
+			break;
+		case TD_U32_ARRAY:
+			dump_array(buf, sym.size, out, 0);
+			break;
+		case TD_RAW:
+		case TD_RUNTIME:
+		default:
+			dump_raw(buf, sym.size, out);
+			break;
+		}
+		free(buf);
+	}
+
+	return ret;
+}
+
+int iopipe_tuning_verify(struct iopipe_libset *libs, FILE *out)
+{
+	size_t i;
+	int ret = 0;
+
+	if (!libs || !out)
+		return -EINVAL;
+
+	for (i = 0; i < td_count; i++) {
+		const struct td_entry *e = &td_entries[i];
+		const struct iopipe_elf *elf;
+		struct iopipe_sym sym;
+		const char *sec = "";
+		int err = 0, rc;
+
+		elf = iopipe_libset_get(libs, e->lib, &err);
+		if (!elf) {
+			fprintf(out, "tuning: FAIL %s:%s: cannot open (%d)\n",
+				e->lib, e->sym, err);
+			ret = err;
+			continue;
+		}
+		rc = iopipe_elf_sym_find(elf, e->sym, false, true, &sym);
+		if (rc) {
+			fprintf(out, "tuning: FAIL %s:%s: symbol not found\n",
+				e->lib, e->sym);
+			ret = rc;
+			continue;
+		}
+		if (sym.size != e->size) {
+			fprintf(out, "tuning: FAIL %s:%s: st_size %u != %u\n",
+				e->lib, e->sym, sym.size, e->size);
+			ret = -ERANGE;
+			continue;
+		}
+		iopipe_elf_section_of(elf, sym.value, &sec, NULL);
+		fprintf(out,
+			"tuning: ok   %s:%-40s @0x%08x size %-6u %-6s %s\n",
+			e->lib, e->sym, sym.value, sym.size, sec,
+			e->kind == TD_RUNTIME ? "runtime (.bss, no bytes)" :
+							"file-backed");
+	}
+
+	return ret;
+}
+
+int iopipe_tuning_accessors(struct iopipe_libset *libs, const char *libname,
+			    FILE *out)
+{
+	const struct iopipe_elf *elf;
+	size_t i, found = 0;
+	int err = 0;
+
+	if (!libs || !libname || !out)
+		return -EINVAL;
+
+	elf = iopipe_libset_get(libs, libname, &err);
+	if (!elf) {
+		fprintf(out, "tuning: %s: cannot open (%d)\n", libname, err);
+		return err;
+	}
+
+	fprintf(out,
+		"per-sensor ISP NVRAM default generators in %s (no static blob):\n",
+		libname);
+	for (i = 0; i < iopipe_elf_sym_count(elf); i++) {
+		struct iopipe_sym sym;
+
+		if (iopipe_elf_sym_at(elf, i, &sym))
+			continue;
+		if (sym.shndx == SHN_UNDEF || sym.type != STT_FUNC || !sym.size)
+			continue;
+		if (!strstr(sym.name, "RAWSensorInfoILj"))
+			continue;
+		if (!strstr(sym.name, "17impGetDefaultData"))
+			continue;
+		fprintf(out, "  %s @0x%x size %u\n", sym.name, sym.entry,
+			sym.size);
+		found++;
+	}
+	if (!found) {
+		fprintf(out, "  none found\n");
+		return -ENOENT;
+	}
+	return 0;
+}
diff --git a/tools/mediatek/camera/iopipe/iopipe_tuning.h b/tools/mediatek/camera/iopipe/iopipe_tuning.h
new file mode 100644
index 000000000..8b0823d70
--- /dev/null
+++ b/tools/mediatek/camera/iopipe/iopipe_tuning.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Tuning / calibration data actually carried as static bytes by the MT6735
+ * camera libraries.
+ *
+ * Only symbols on a cited allow-list are read, each with an expected st_size
+ * that is re-checked against the ELF.  The allow-list exists because the same
+ * libraries also export large .bss objects that hold per-sensor NVRAM data at
+ * run time: those have no file bytes at all, and the tool reports them as
+ * runtime-only instead of inventing contents.
+ *
+ * Per-sensor ISP NVRAM defaults are NOT static blobs in libcameracustom.so:
+ * they are produced by per-sensor accessor functions.  The library exports
+ *
+ *   _ZNK9NSFeature13RAWSensorInfoILj537EE17impGetDefaultDataE21CAMERA_DATA_TYPE_ENUMPvj
+ *   _ZNK9NSFeature13RAWSensorInfoILj24112EE17impGetDefaultDataE21CAMERA_DATA_TYPE_ENUMPvj
+ *
+ * each 208 bytes (i.e. a generator, not a 0x28000-byte ISP NVRAM image), and
+ * the earlier lens-shading study found the same shape in GetCameraDefaultPara
+ * ($M/logs/rem-camera-otp.md section 3.3).  iopipe_tuning_accessors() lists
+ * those generator symbols and their sizes so the claim is checkable rather
+ * than asserted.
+ */
+
+#ifndef IOPIPE_TUNING_H
+#define IOPIPE_TUNING_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "iopipe_elf.h"
+
+/* Print every allow-listed symbol with its decode.  returns 0 or -errno. */
+int iopipe_tuning_dump(struct iopipe_libset *libs, FILE *out);
+/* Verify symbol presence, size, section and decode preconditions. */
+int iopipe_tuning_verify(struct iopipe_libset *libs, FILE *out);
+/* List the per-sensor default-data generator functions. */
+int iopipe_tuning_accessors(struct iopipe_libset *libs, const char *libname,
+			    FILE *out);
+
+#endif /* IOPIPE_TUNING_H */
diff --git a/tools/mediatek/camera/iopipe/main.c b/tools/mediatek/camera/iopipe/main.c
new file mode 100644
index 000000000..64b821924
--- /dev/null
+++ b/tools/mediatek/camera/iopipe/main.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * iopipe - decode MT6735 camera pipe/tuning data out of the vendor libraries.
+ *
+ * Commands:
+ *   portmap   the six NSCam::NSIoPipe port/path tables of libcam.iopipe.so
+ *   modules   the ISP_MGR_* catalogue of libcam.hal3a.v3.so (text/CSV/JSON)
+ *   regmap    the per-module TPIPE/P1/P1_D/P2 enable-word programming
+ *   cq        build CQ0C command words for a caller-supplied write list
+ *   tuning    the static tuning tables of libcameracustom/lib3a/libcamalgo
+ *   selftest  verify everything above against the shipped ELF files
+ *
+ * The library directory comes from --lib-dir, then $IOPIPE_LIBDIR, then the
+ * build-time default (IOPIPE_DEFAULT_LIBDIR, set by the Makefile).
+ *
+ * Exit status: 0 success, 1 failure, 2 usage.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "iopipe_cq.h"
+#include "iopipe_elf.h"
+#include "iopipe_mgr.h"
+#include "iopipe_portmap.h"
+#include "iopipe_regmap.h"
+#include "iopipe_tuning.h"
+
+#ifndef IOPIPE_DEFAULT_LIBDIR
+#define IOPIPE_DEFAULT_LIBDIR "/usr/share/mtk-camera"
+#endif
+
+#define IOPIPE_HAL3A	"libcam.hal3a.v3.so"
+#define IOPIPE_IOPIPE	"libcam.iopipe.so"
+#define IOPIPE_CUSTOM	"libcameracustom.so"
+
+extern int iopipe_selftest(const char *libdir, FILE *out);
+
+static void usage(FILE *out)
+{
+	fprintf(out,
+		"usage: iopipe <command> [options]\n"
+		"\n"
+		"commands:\n"
+		"  portmap   [--table NAME]        port/path maps of %s\n"
+		"  modules   [--csv|--json]        ISP_MGR_* catalogue of %s\n"
+		"  regmap                          per-module enable-word programming\n"
+		"  cq        --write REG:PA ...    build CQ0C command words\n"
+		"  tuning    [--accessors]         static tuning tables\n"
+		"  selftest                        verify against the ELF files\n"
+		"\n"
+		"options:\n"
+		"  --lib-dir DIR   vendor library directory (else $IOPIPE_LIBDIR,\n"
+		"                  else %s)\n"
+		"  --table NAME    only this port map table\n"
+		"  --write R:P     register address (0x15000000 relative) and the\n"
+		"                  physical address of its 32-bit operand; repeatable\n"
+		"  --accessors     list the per-sensor default-data generators\n"
+		"  -h, --help\n",
+		IOPIPE_IOPIPE, IOPIPE_HAL3A, IOPIPE_DEFAULT_LIBDIR);
+}
+
+static int parse_u32(const char *s, uint32_t *out)
+{
+	char *end = NULL;
+	unsigned long v;
+
+	if (!s || !*s)
+		return -EINVAL;
+	v = strtoul(s, &end, 0);
+	if (!end || *end || v > 0xfffffffful)
+		return -EINVAL;
+	*out = (uint32_t)v;
+	return 0;
+}
+
+static int cmd_portmap(struct iopipe_libset *libs, const char *table, FILE *out)
+{
+	const struct iopipe_elf *elf;
+	size_t i;
+	int err = 0, ret = 0;
+
+	elf = iopipe_libset_get(libs, IOPIPE_IOPIPE, &err);
+	if (!elf) {
+		fprintf(stderr, "iopipe: cannot open %s in %s (%s)\n",
+			IOPIPE_IOPIPE, libs->dir, strerror(-err));
+		return 1;
+	}
+
+	if (table) {
+		const struct iopipe_pm_table *t = iopipe_pm_by_name(table);
+
+		if (!t) {
+			fprintf(stderr, "iopipe: unknown table %s\n", table);
+			return 2;
+		}
+		return iopipe_pm_dump(elf, t, out) ? 1 : 0;
+	}
+
+	for (i = 0; i < iopipe_pm_table_count; i++) {
+		if (i)
+			fprintf(out, "\n");
+		if (iopipe_pm_dump(elf, &iopipe_pm_tables[i], out))
+			ret = 1;
+	}
+	return ret;
+}
+
+static int cmd_modules(struct iopipe_libset *libs, enum iopipe_mgr_fmt fmt,
+		       FILE *out)
+{
+	const struct iopipe_elf *elf;
+	int err = 0, ret;
+
+	elf = iopipe_libset_get(libs, IOPIPE_HAL3A, &err);
+	if (!elf) {
+		fprintf(stderr, "iopipe: cannot open %s in %s (%s)\n",
+			IOPIPE_HAL3A, libs->dir, strerror(-err));
+		return 1;
+	}
+	ret = iopipe_mgr_dump(elf, fmt, out);
+	if (ret) {
+		fprintf(stderr, "iopipe: modules failed (%s)\n", strerror(-ret));
+		return 1;
+	}
+	return 0;
+}
+
+static int cmd_regmap(struct iopipe_libset *libs, FILE *out)
+{
+	const struct iopipe_elf *elf;
+	int err = 0;
+
+	elf = iopipe_libset_get(libs, IOPIPE_HAL3A, &err);
+	if (!elf) {
+		fprintf(stderr, "iopipe: cannot open %s in %s (%s)\n",
+			IOPIPE_HAL3A, libs->dir, strerror(-err));
+		return 1;
+	}
+	return iopipe_regmap_dump(elf, out) ? 1 : 0;
+}
+
+static int cmd_cq(const struct iopipe_cq_write *w, size_t n, FILE *out)
+{
+	struct iopipe_cq_cmd cmd[64];
+	int got;
+
+	if (!n) {
+		fprintf(stderr, "iopipe: cq needs at least one --write REG:PA\n");
+		return 2;
+	}
+	got = iopipe_cq_build(cmd, sizeof(cmd) / sizeof(cmd[0]), w, n);
+	if (got < 0) {
+		fprintf(stderr, "iopipe: cq build failed: %s\n", strerror(-got));
+		return 1;
+	}
+	iopipe_cq_dump(cmd, (size_t)got, out);
+	return 0;
+}
+
+static int cmd_tuning(struct iopipe_libset *libs, bool accessors, FILE *out)
+{
+	if (accessors)
+		return iopipe_tuning_accessors(libs, IOPIPE_CUSTOM, out) ? 1 : 0;
+	return iopipe_tuning_dump(libs, out);
+}
+
+int main(int argc, char **argv)
+{
+	struct iopipe_libset libs;
+	struct iopipe_cq_write writes[64];
+	size_t nwrites = 0;
+	const char *libdir = NULL;
+	const char *cmd = NULL;
+	const char *table = NULL;
+	enum iopipe_mgr_fmt fmt = IOPIPE_MGR_TEXT;
+	bool accessors = false;
+	int i, ret;
+
+	for (i = 1; i < argc; i++) {
+		const char *a = argv[i];
+
+		if (!strcmp(a, "-h") || !strcmp(a, "--help")) {
+			usage(stdout);
+			return 0;
+		} else if (!strcmp(a, "--lib-dir")) {
+			if (++i >= argc) {
+				usage(stderr);
+				return 2;
+			}
+			libdir = argv[i];
+		} else if (!strcmp(a, "--csv")) {
+			fmt = IOPIPE_MGR_CSV;
+		} else if (!strcmp(a, "--json")) {
+			fmt = IOPIPE_MGR_JSON;
+		} else if (!strcmp(a, "--table")) {
+			if (++i >= argc) {
+				usage(stderr);
+				return 2;
+			}
+			table = argv[i];
+		} else if (!strcmp(a, "--accessors")) {
+			accessors = true;
+		} else if (!strcmp(a, "--write")) {
+			const char *spec;
+			char *sep;
+			char reg[64];
+
+			if (++i >= argc) {
+				usage(stderr);
+				return 2;
+			}
+			spec = argv[i];
+			sep = strchr(spec, ':');
+			if (!sep || (size_t)(sep - spec) >= sizeof(reg)) {
+				fprintf(stderr, "iopipe: bad --write %s\n", spec);
+				return 2;
+			}
+			memcpy(reg, spec, (size_t)(sep - spec));
+			reg[sep - spec] = '\0';
+			if (nwrites >= sizeof(writes) / sizeof(writes[0])) {
+				fprintf(stderr, "iopipe: too many --write\n");
+				return 2;
+			}
+			if (parse_u32(reg, &writes[nwrites].reg) ||
+			    parse_u32(sep + 1, &writes[nwrites].operand_pa)) {
+				fprintf(stderr, "iopipe: bad --write %s\n", spec);
+				return 2;
+			}
+			nwrites++;
+		} else if (a[0] == '-') {
+			fprintf(stderr, "iopipe: unknown option %s\n", a);
+			usage(stderr);
+			return 2;
+		} else if (!cmd) {
+			cmd = a;
+		} else {
+			fprintf(stderr, "iopipe: unexpected argument %s\n", a);
+			return 2;
+		}
+	}
+
+	if (!cmd) {
+		usage(stderr);
+		return 2;
+	}
+
+	if (!libdir)
+		libdir = getenv("IOPIPE_LIBDIR");
+	if (!libdir)
+		libdir = IOPIPE_DEFAULT_LIBDIR;
+
+	ret = iopipe_libset_init(&libs, libdir);
+	if (ret) {
+		fprintf(stderr, "iopipe: bad library directory %s (%s)\n", libdir,
+			strerror(-ret));
+		return 2;
+	}
+
+	if (!strcmp(cmd, "portmap"))
+		ret = cmd_portmap(&libs, table, stdout);
+	else if (!strcmp(cmd, "modules"))
+		ret = cmd_modules(&libs, fmt, stdout);
+	else if (!strcmp(cmd, "regmap"))
+		ret = cmd_regmap(&libs, stdout);
+	else if (!strcmp(cmd, "cq"))
+		ret = cmd_cq(writes, nwrites, stdout);
+	else if (!strcmp(cmd, "tuning"))
+		ret = cmd_tuning(&libs, accessors, stdout);
+	else if (!strcmp(cmd, "selftest"))
+		ret = iopipe_selftest(libdir, stdout) ? 1 : 0;
+	else {
+		fprintf(stderr, "iopipe: unknown command %s\n", cmd);
+		usage(stderr);
+		ret = 2;
+	}
+
+	iopipe_libset_free(&libs);
+	return ret;
+}
