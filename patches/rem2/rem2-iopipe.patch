+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Per-module TPIPE/P1/P2 enable-word programming recovered from
+ * libcam.hal3a.v3.so.  Every address/word pair below was produced by
+ * disassembling the library (llvm-objdump -d --triple=thumbv7a-none-eabi) and
+ * is re-read from the shipped ELF by iopipe_regmap_verify().
+ *
+ * Symbol values in .dynsym carry the Thumb bit; the function therefore starts
+ * at st_value & ~1 (e.g. ISP_MGR_BNR::apply is 0x66d4d -> entry 0x66d4c).
+ * libcam.hal3a.v3.so maps vaddr 0x2000 -> file offset 0, so the tool's
+ * PT_LOAD walk finds every word below.
+ *
+ * Nothing here is a guess: the register address is decoded from the MOVW
+ * immediate, the bit position from the BFI/ORR immediate, and the owning
+ * enable manager from the getInstance call site recorded per record.
+ */
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "iopipe_mgr.h"
+#include "iopipe_regmap.h"
+
+#define IOPIPE_CAM_ADDR_MIN 0x4000u
+#define IOPIPE_CAM_ADDR_MAX 0x10000u
+
+/* clang-format off */
