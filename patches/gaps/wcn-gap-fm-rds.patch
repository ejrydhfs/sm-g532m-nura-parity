+static void test_transparent_data(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+
+	rb_init(&rb);
+	rb_add(&rb, 0x1234, group_b(5, false, 0, false, 3), 0x4142, 0x4344);
+	rb_add(&rb, 0x1234, group_b(5, true, 0, false, 7), 0x1234, 0x4142);
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].tdc_valid && res[0].tdc_address == 3, "5A address");
+	CHECK(res[0].tdc_len == 4 && res[0].tdc_data[0] == 0x41 &&
+	      res[0].tdc_data[1] == 0x42 && res[0].tdc_data[2] == 0x43 &&
+	      res[0].tdc_data[3] == 0x44, "5A data");
+	CHECK(res[1].tdc_address == 7 && res[1].tdc_len == 2 &&
+	      res[1].tdc_data[0] == 0x41 && res[1].tdc_data[1] == 0x42,
+	      "5B data");
+}
