+static void test_group0_version_b(void)
+{
+	static const char *segments[] = { "AB", "CD", "EF", "GH" };
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	unsigned i;
+
+	rb_init(&rb);
+	for (i = 0; i < 4; i++)
+		rb_add(&rb, 0x4321,
+		       group_b(0, true, 3, false, g0_low5(false, false, true, i)),
+		       0x4321,	/* block C repeats the PI in 0B */
+		       (uint16_t)((uint8_t)segments[i][0] << 8 |
+				  (uint8_t)segments[i][1]));
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].version_b, "0B version flag");
+	CHECK(!res[0].af_group_valid, "0B carries no AF");
+	CHECK(res[3].ps_valid && strcmp(res[3].ps, "ABCDEFGH") == 0,
+	      "0B PS text");
+}
