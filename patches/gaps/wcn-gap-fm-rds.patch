+static void test_paging(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	uint32_t bits = (1u << 1) | (1u << 17);
+
+	rb_init(&rb);
+	/* STY 0: 25 notification bits, block C bits 8..0 + block D. */
+	rb_add(&rb, 0x1234, group_b(13, false, 0, false, 0),
+	       (uint16_t)(bits >> 16), (uint16_t)(bits & 0xffff));
+	/* STY 1: notification bits 49..25, same bit layout. */
+	rb_add(&rb, 0x1234, group_b(13, false, 0, false, 1),
+	       (uint16_t)(bits >> 16), (uint16_t)(bits & 0xffff));
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].paging_valid && res[0].sty == 0, "13A STY 0");
+	CHECK(res[0].paging_bits_valid && res[0].paging_bits == bits &&
+	      res[0].paging_first_bit == 0, "13A notification bits 0..24");
+	CHECK(res[1].sty == 1 && res[1].paging_first_bit == 25,
+	      "13A STY 1 notification bits 25..49");
+}
