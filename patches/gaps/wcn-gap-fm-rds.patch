+static void test_eon(void)
+{
+	static const char *segments[] = { "EO", "NF", "M ", "  " };
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	unsigned i;
+
+	rb_init(&rb);
+	for (i = 0; i < 4; i++)
+		rb_add(&rb, 0x1234, group_b(14, false, 2, true, 0x10 | i),
+		       (uint16_t)((uint8_t)segments[i][0] << 8 |
+				  (uint8_t)segments[i][1]),
+		       0x5678);
+	/* Variant 4: AF(ON) codes 20 and 148. */
+	rb_add(&rb, 0x1234, group_b(14, false, 2, true, 0x14),
+	       (20 << 8) | 148, 0x5678);
+	/* Variant 13: PTY(ON) 5, TA(ON) 1. */
+	rb_add(&rb, 0x1234, group_b(14, false, 2, true, 0x1d),
+	       (5 << 11) | 1, 0x5678);
+	/* 14B: TA(ON) in block B bit 3. */
+	rb_add(&rb, 0x1234, group_b(14, true, 2, true, 0x18), 0x1234, 0x5678);
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].eon_valid && res[0].eon.have_pi &&
+	      res[0].eon.pi_on == 0x5678, "14A EON PI(ON)");
+	CHECK(res[0].eon.have_tp && res[0].eon.tp_on, "14A EON TP(ON)");
+	CHECK(res[3].eon.ps_complete && strcmp(res[3].eon.ps, "EONFM") == 0,
+	      "14A EON PS");
+	CHECK(res[4].eon.have_af && res[4].eon.af_code[0] == 20 &&
+	      res[4].eon.af_code[1] == 148, "14A EON AF");
+	CHECK(res[5].eon.have_pty && res[5].eon.pty == 5 &&
+	      res[5].eon.have_ta && res[5].eon.ta, "14A EON PTY/TA");
+	CHECK(res[6].eon.have_ta && res[6].eon.ta, "14B EON TA(ON)");
+}
