+static void test_clock_time(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	unsigned mjd = mjd_from_ymd(2026, 10, 24);
+	unsigned hour = 19, minute = 57, half = 4;
+	uint16_t block_b, block_c, block_d;
+
+	block_b = group_b(4, false, 0, false, 0) |
+		  (uint16_t)((mjd >> 15) & 0x3);
+	block_c = (uint16_t)(((mjd & 0x7fff) << 1) | (hour >> 4));
+	block_d = (uint16_t)(((hour & 0x0f) << 12) | (minute << 6) |
+			     (half & 0x1f));
+
+	rb_init(&rb);
+	rb_add(&rb, 0x1234, block_b, block_c, block_d);
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].ct_valid, "4A CT present");
+	CHECK(res[0].ct.year == 2026 && res[0].ct.month == 10 &&
+	      res[0].ct.day == 24, "4A CT date");
+	CHECK(res[0].ct.hour == 19 && res[0].ct.minute == 57, "4A CT time");
+	CHECK(res[0].ct.offset_minutes == 120, "4A CT +02:00 offset");
+}
