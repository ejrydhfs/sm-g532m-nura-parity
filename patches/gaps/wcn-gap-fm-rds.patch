+static void test_fast_switching(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	uint16_t b = (uint16_t)((15 << 12) | (1 << 11) | (1 << 10) |
+				(5 << 5) | (1 << 4) | (0 << 3) | (1 << 2) | 2);
+	uint16_t d = (uint16_t)((15 << 12) | (1 << 11) | (0 << 10) |
+				(3 << 5) | (0 << 4) | (1 << 3) | (0 << 2) | 3);
+
+	rb_init(&rb);
+	rb_add(&rb, 0x1234, b, 0x1234, d);
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].version_b, "15B version flag");
+	CHECK(res[0].fast_b.valid && res[0].fast_b.ta &&
+	      !res[0].fast_b.ms && res[0].fast_b.di &&
+	      res[0].fast_b.di_segment == 2, "15B block B flags");
+	CHECK(res[0].fast_b.tp && res[0].fast_b.pty == 5,
+	      "15B block B TP/PTY");
+	CHECK(res[0].fast_d.valid && !res[0].fast_d.ta &&
+	      res[0].fast_d.ms && !res[0].fast_d.di &&
+	      res[0].fast_d.di_segment == 3, "15B block D flags");
+}
+
+static void test_invalid_and_padding(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	size_t usable;
+
+	rb_init(&rb);
+	/* Block B not marked good: no group type may be derived. */
+	rb_add_crc(&rb, 0x1234, 0xffff, 0x1111, 0x2222, 0, RDS_BLOCK_A_OK |
+						       RDS_BLOCK_C_OK |
+						       RDS_BLOCK_D_OK);
+	/* One valid group followed by zero-filled unused slots. */
+	rb_add(&rb, 0x1234, group_b(0, false, 1, false,
+				    g0_low5(false, false, false, 0)),
+	       0, ('A' << 8) | 'B');
+
+	rds_decoder_init(&dec);
+	usable = rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].present && !res[0].b_valid, "bad block B detected");
+	CHECK(res[1].present && res[1].b_valid, "valid group after bad one");
+	CHECK(!res[2].present, "zero-filled slot is not a group");
+	CHECK(usable == 1, "usable group count");
+}
+
+static void test_text_helpers(void)
+{
+	char buf[16];
+
+	rds_text_to_string("Hi\x01\x0drest", 8, buf, sizeof(buf));
+	CHECK(strcmp(buf, "Hi.") == 0, "text sanitising stops at CR");
+	rds_text_to_string("AB   ", 5, buf, sizeof(buf));
+	CHECK(strcmp(buf, "AB") == 0, "trailing spaces trimmed");
+	CHECK(rds_printable('A') == 'A' && rds_printable(0x01) == '.',
+	      "printable mapping");
+}
+
+int rds_selftest(void)
+{
+	failures = 0;
+
+	test_group0_ps_af();
+	test_group0_version_b();
+	test_radiotext_2a();
+	test_radiotext_2b();
+	test_radiotext_cbc();
+	test_group1();
+	test_group3a();
+	test_clock_time();
+	test_transparent_data();
+	test_paging();
+	test_eon();
+	test_fast_switching();
+	test_invalid_and_padding();
+	test_text_helpers();
+
+	if (failures) {
+		fprintf(stderr, "selftest: %d check(s) failed\n", failures);
+		return 1;
+	}
+
+	printf("selftest: all checks passed\n");
+	return 0;
+}
