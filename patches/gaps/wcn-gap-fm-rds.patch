+static void test_radiotext_cbc(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+
+	rb_init(&rb);
+	rb_add_crc(&rb, 0x1234,
+		   group_b(2, false, 4, false, g2_low5(false, 0)),
