+static void test_radiotext_2a(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+
+	rb_init(&rb);
+	rb_add(&rb, 0x1234, group_b(2, false, 4, false, g2_low5(false, 0)),
+	       ('H' << 8) | 'e', ('l' << 8) | 'l');
+	rb_add(&rb, 0x1234, group_b(2, false, 4, false, g2_low5(false, 1)),
+	       ('o' << 8) | ' ', ('R' << 8) | 'D');
+	rb_add(&rb, 0x1234, group_b(2, false, 4, false, g2_low5(false, 2)),
+	       ('S' << 8) | 0x0d, (' ' << 8) | ' ');
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(!res[0].rt_valid, "2A RT not complete at first segment");
+	CHECK(res[2].rt_valid, "2A RT complete");
+	CHECK(strcmp(res[2].rt, "Hello RDS") == 0, "2A RT text");
+	CHECK(res[2].rt_ab == 0, "2A RT A/B flag");
+
+	/* A/B flag change starts a new message. */
+	rb_init(&rb);
+	rb_add(&rb, 0x1234, group_b(2, false, 4, false, g2_low5(true, 0)),
+	       ('N' << 8) | 'e', ('w' << 8) | ' ');
+	rb_add(&rb, 0x1234, group_b(2, false, 4, false, g2_low5(true, 1)),
+	       ('T' << 8) | 'e', ('x' << 8) | 't');
+	rb_add(&rb, 0x1234, group_b(2, false, 4, false, g2_low5(true, 2)),
+	       (0x0d << 8) | ' ', (' ' << 8) | ' ');
+
+	rds_decode_record(&dec, rb.data, res);
+	CHECK(res[2].rt_valid, "2A new RT complete");
+	CHECK(strcmp(res[2].rt, "New Text") == 0, "2A new RT text");
+}
