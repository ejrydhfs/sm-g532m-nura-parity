+	       0x2222, ('A' << 8) | 'B');
+	rb_add(&rb, 0x2222, group_b(2, true, 7, true, g2_low5(false, 1)),
+	       0x2222, (0x0d << 8) | ' ');
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].version_b, "2B version flag");
