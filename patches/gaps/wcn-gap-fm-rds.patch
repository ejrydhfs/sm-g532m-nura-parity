+static void test_group1(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+	uint16_t pin = (24 << 11) | (19 << 6) | 57;
+
+	rb_init(&rb);
+	/* 1A variant 0: ECC 0xE1 in block C, PIN in block D. */
+	rb_add(&rb, 0x1234, group_b(1, false, 9, true, 0), 0x00e1, pin);
+	/* 1A variant 3: language code 0x07. */
+	rb_add(&rb, 0x1234, group_b(1, false, 9, true, 0), 0x3007, pin);
+	/* 1B: block C' is the PI, block D still carries the PIN. */
+	rb_add(&rb, 0x1234, group_b(1, true, 9, true, 0), 0x1234, pin);
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].ecc_valid && res[0].ecc == 0xe1, "1A ECC");
+	CHECK(res[0].slc_variant == 0, "1A SLC variant 0");
+	CHECK(res[0].pin_valid && res[0].pin_day == 24 &&
+	      res[0].pin_hour == 19 && res[0].pin_minute == 57,
+	      "1A programme item number");
+	CHECK(res[1].language_valid && res[1].language == 7, "1A language");
+	CHECK(res[2].pin_valid && !res[2].slc_valid, "1B PIN without SLC");
+}
