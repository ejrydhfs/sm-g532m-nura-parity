+static void test_group3a(void)
+{
+	struct rds_group_result res[RDS_GROUPS_PER_RECORD];
+	struct rds_decoder dec;
+	struct record_builder rb;
+
+	rb_init(&rb);
+	/* ODA group code 16 = 8A, message 0x1234, AID 0x4BD7 (RT+). */
+	rb_add(&rb, 0x1234, group_b(3, false, 10, false, 16), 0x1234, 0x4bd7);
+
+	rds_decoder_init(&dec);
+	rds_decode_record(&dec, rb.data, res);
+
+	CHECK(res[0].oda_valid, "3A ODA present");
+	CHECK(res[0].oda_group == 8 && !res[0].oda_group_b, "3A ODA group 8A");
+	CHECK(res[0].oda_message == 0x1234, "3A ODA message");
+	CHECK(res[0].aid == 0x4bd7, "3A AID");
+}
