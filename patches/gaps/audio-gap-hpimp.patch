+/*
+ * Port from Samsung/MTK downstream mt_soc_codec_63xx.c:880-989
+ * OpenHeadPhoneImpedanceSetting().  The whole body sits inside "#if 0" in
+ * the vendor source and the function therefore only returns true; the
+ * sequence below is the intended (dead) implementation, which is what the
+ * header comment "AUXADC large scale" and the callers in
+ * mt_soc_pcm_hp_impedance.c:338-420, 579-606 assume.
+ *
+ * The vendor early-returns when a downlink stream is active
+ * (vendor:884-886 GetDLStatus()).  This driver has no cross-component
+ * stream query, so userspace must only use the control while playback is
+ * stopped (documented in the report).
+ */
+static int mt6331_open_hp_impedance_setting(struct mt6331_priv *priv,
+					    bool enable)
+{
+	int ret;
+
+	if (enable) {
+		ret = mt6331_dl_power_up(priv);
+		if (ret)
+			return ret;
+
+		/* vendor:889-891: AUXADC large scale, mic bias 1 on */
+		mt6331_ana_write(priv, MT6328_AUXADC_CON2,
+				 MT6328_AUXADC_AVG_LARGE,
+				 MT6328_AUXADC_AVG_LARGE);
+		mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0x0010,
+				 0x0010);
+
+		/* vendor:910-921: NCP soft start + 604 kHz NCP clock */
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON4, 0x0003,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON1, 0x0001,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON2, 0x002b,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON0, 0x0001,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON3, 0x0000,
+				 0xffff);
+
+		/* vendor:926-935: cap-less HC/LC LDO (1.5V) */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0841,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x28c1,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac1,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		/* vendor:938: NV regulator (-1.5V) */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x8000,
+				 RG_NVREG_EN_VAUDP15);
+		/* vendor:940: AUD_ZCD off */
+		mt6331_ana_write(priv, MT6328_ZCD_CON0, 0x0000, 0xffff);
+
+		/* vendor:944-958: HP/voice protection off, HP output not
+		 * shorted to VCM, headphone speaker detection on, IbiasDistrib
+		 * on, AUD_CLK on, left DAC on, HPDET mux on.
