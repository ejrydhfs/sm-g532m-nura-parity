+/*
+ * Port from Samsung/MTK downstream pmic_auxadc.c:173-455
+ * PMIC_IMM_GetOneChannelValue(): one-shot conversion of one channel.
+ *
+ * The downstream function turns on the AUXADC clock, the input buffer and
+ * the AP-mode 26 MHz clock, requests the channel through RQST0_SET and polls
+ * the ready bit of that channel's output register.  For channel 9 it returns
+ * the raw 12 bit code (pmic_auxadc.c:434-436); every other channel is scaled
+ * to millivolts there.  This helper always returns the raw code, which is
+ * what the HP impedance path consumes.
+ *
+ * The baseline accdet driver (drivers/misc/mediatek/accdet/accdet.c:137-166)
+ * uses the same PMIC AUXADC block for channel 5 through the same RQST0_SET /
+ * ready-bit scheme; only the channel and the auto-sample setup differ.
+ */
+static int mt6331_auxadc_read(struct mt6331_priv *priv, unsigned int channel,
+			      unsigned int *code)
+{
+	unsigned int val;
+	int ret;
+
+	/* pmic_auxadc.c:207: the PMIC has 16 channels */
+	if (channel > 15)
+		return -EINVAL;
+
+	/* pmic_auxadc.c:212-214 */
+	ret = regmap_update_bits(priv->regmap, MT6328_AUXADC_CON0,
+				 MT6328_AUXADC_CK_AON,
+				 MT6328_AUXADC_CK_AON);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(priv->regmap, MT6328_AUXADC_CON12,
+				 MT6328_AUXADC_VBUF_EN,
+				 MT6328_AUXADC_VBUF_EN);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(priv->regmap, MT6328_TOP_CLKSQ,
+				 RG_CLKSQ_EN_AUX_AP_MODE,
+				 RG_CLKSQ_EN_AUX_AP_MODE);
+	if (ret)
+		return ret;
+
+	/* pmic_auxadc.c:222: request one conversion */
+	ret = regmap_write(priv->regmap, MT6328_AUXADC_RQST0_SET,
+			   BIT(channel));
+	if (ret)
+		return ret;
+
+	/* pmic_auxadc.c:337-347: bit 15 of the channel output is the ready
+	 * flag, bits 11:0 the code.  The downstream loop is bounded by a retry
+	 * counter; a poll timeout is equivalent.
+	 */
+	ret = regmap_read_poll_timeout(priv->regmap,
+				       MT6328_AUXADC_ADC_BASE + 2 * channel,
+				       val, val & MT6328_AUXADC_RDY,
+				       MT6331_AUXADC_POLL_US,
+				       MT6331_AUXADC_TIMEOUT_US);
+	if (ret)
+		return ret;
+
+	*code = val & MT6328_AUXADC_DATA_MASK;
+	return 0;
+}
