+/* ------------------------------------------------------------------ */
+/* HP impedance measurement (vendor:610-700, 748-820, 880-989, 1059-1066)      */
+/* ------------------------------------------------------------------ */
+/*
+ * Port from Samsung/MTK downstream mt_soc_codec_63xx.c:748-878
+ * OpenAnalogTrimHardware(): power the DAC/analog block up, bring up the NCP,
+ * the cap-less LDOs and the HP/HS bias, then enable both audio DACs with the
+ * HP gain at 0 dB.
+ */
+static int mt6331_open_analog_trim_hw(struct mt6331_priv *priv, bool enable)
+{
+	int ret;
+
+	if (enable) {
+		/* vendor:752 TurnOnDacPower() */
+		ret = mt6331_dl_power_up(priv);
+		if (ret)
+			return ret;
+
+		/* vendor:755-763: 604 kHz NCP clock and soft start */
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON1, 0x0001,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON2, 0x002b,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON0, 0x0001,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON4, 0x0000,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDNCP_CLKDIV_CON3, 0x0000,
+				 0xffff);
+		/* vendor:765-776: LDOs + NV regulator, then disable the HP /
+		 * voice protection and the ZCD block.
+		 */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0a41,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac1,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x8000,
+				 RG_NVREG_EN_VAUDP15);
+		mt6331_ana_write(priv, MT6328_ZCD_CON0, 0x0400, 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe080,
+				 0xffff);
+		/* vendor:776 IBIST */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac0,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		/* vendor:780-781: HP & HS drivers bias circuit + trim buffer */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON4, 0x1f01,
+				 0xffff);
+		/* vendor:783 */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON5, 0x5490,
+				 0xffff);
+		udelay(50);
+		/* vendor:786-796: 0 dB HP gain, voice muted, drivers on */
+		mt6331_ana_write(priv, MT6328_ZCD_CON2, 0x0408, 0xffff);
+		mt6331_ana_write(priv, MT6328_ZCD_CON3, 0x001f, 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x0480,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x1480,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe090,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x14a0,
+				 0xffff);
+		udelay(50);
+		/* vendor:798-803: AUD_CLK and both audio DACs */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac2,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0x0009,
+				 0x0009);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0x0006,
+				 0x0006);
+	} else {
+		/* vendor:807-818 */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON4, 0x0000,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0x0000,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x2ac0,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x0000,
+				 RG_NVREG_EN_VAUDP15);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0001,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_dl_power_down(priv);
+	}
+
+	return 0;
+}
