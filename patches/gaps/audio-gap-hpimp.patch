+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe080,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x0000,
+				 0x0400);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x0000,
+				 0x0080);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON3, 0x0080,
+				 0x0080);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0000,
+				 0x0001);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0002,
+				 0x0002);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe089,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON3, 0x0900,
+				 0x0f00);
+	} else {
+		/* vendor:961-984 */
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON3, 0x0000,
+				 0x0f00);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe080,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0000,
+				 0x0002);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0001,
+				 0x0001);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON3, 0x0000,
+				 0x0080);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON7, 0x0000,
+				 RG_NVREG_EN_VAUDP15);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON6, 0x0001,
+				 RG_AUDDEC_ANA_CON6_SPK_MASK);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON1, 0x0080,
+				 0x0080);
+		mt6331_ana_write(priv, MT6328_AUDDEC_ANA_CON0, 0xe000,
+				 0xffff);
+		mt6331_ana_write(priv, MT6328_AUDENC_ANA_CON9, 0x0000,
