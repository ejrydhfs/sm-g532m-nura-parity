+/* ------------------------------------------------------------------ */
+/* PMIC efuse HP offset trim (vendor:484-566)                         */
+/* ------------------------------------------------------------------ */
+/*
+ * Read the three PMIC efuse rows that hold the headphone DC offset trim
+ * and decode them exactly like Auddrv_Read_Efuse_HPOffset() (vendor:484-566),
+ * which InitAfeControl() calls once on the first audio open
+ * (mt_soc_afe_control.c:457-470).
+ *
+ * EFUSE_HP_TRIM is not defined in the downstream build
+ * (mt_soc_pcm_common.h:106 keeps it commented out, no Makefile defines it),
+ * so SetDcCompenSation() takes the software ramp branch (vendor:1202-1204)
+ * and these fields are only ever logged.  This driver keeps that parity:
+ * the values are decoded and stored, never written to AUDDEC_ANA_CON2.
+ */
+static int mt6331_efuse_hp_offset_read(struct mt6331_priv *priv)
+{
+	unsigned int efuse[MT6331_OTP_HP_ROWS] = { };
+	unsigned int val;
+	int i, ret;
+
+	if (priv->hp_trim.valid)
+		return 0;
+
+	/* 1. enable the efuse controller clock (vendor:496-497) */
+	ret = regmap_write(priv->regmap, MT6328_TOP_CKHWEN_CON0_CLR,
+			   MT6331_OTP_CK_HWEN);
+	if (!ret)
+		ret = regmap_write(priv->regmap, MT6328_TOP_CKPDN_CON3_CLR,
+				   MT6331_OTP_CK_PDN);
+	/* 2. enable the OTP engine (vendor:500) */
+	if (!ret)
+		ret = regmap_update_bits(priv->regmap, MT6328_OTP_CON11,
+					 MT6331_OTP_ENGINE_EN,
+					 MT6331_OTP_ENGINE_EN);
+	if (ret)
+		goto out_gate;
+
+	for (i = 0; i < MT6331_OTP_HP_ROWS; i++) {
+		/* 3. select the row (vendor:514-515) */
+		ret = regmap_update_bits(priv->regmap, MT6328_OTP_CON0,
+					 MT6331_OTP_ROW_MASK,
+					 (MT6331_OTP_HP_ROW_START + i) <<
+					 MT6331_OTP_ROW_SHIFT);
+		if (ret)
+			break;
+
+		/* 4. toggle the read trigger (vendor:517-525) */
+		ret = regmap_read(priv->regmap, MT6328_OTP_CON8, &val);
+		if (ret)
+			break;
+		val = (val & MT6331_OTP_READ_TRIGGER) ? 0 :
+						       MT6331_OTP_READ_TRIGGER;
+		ret = regmap_update_bits(priv->regmap, MT6328_OTP_CON8,
+					 MT6331_OTP_READ_TRIGGER, val);
+		if (ret)
+			break;
+
+		/* 5. wait for the engine (vendor:526-531).  The downstream
+		 * loop is unbounded; bound it so a wedged PMIC cannot hang
+		 * the caller.
+		 */
+		ret = regmap_read_poll_timeout(priv->regmap, MT6328_OTP_CON13,
+					       val, !(val & MT6331_OTP_READY),
+					       MT6331_OTP_POLL_US,
+					       MT6331_OTP_TIMEOUT_US);
+		if (ret)
+			break;
+
+		/* The word is only valid at least 1 ms after the ready bit
+		 * drops (vendor:533).
+		 */
+		usleep_range(1000, 1100);
+
+		/* 6. read the word (vendor:535) */
+		ret = regmap_read(priv->regmap, MT6328_OTP_CON12, &efuse[i]);
+		if (ret)
+			break;
+	}
+
+out_gate:
+	/* 7. disable the controller clock (vendor:541-543) */
+	regmap_write(priv->regmap, MT6328_TOP_CKPDN_CON3_SET,
+		     MT6331_OTP_CK_PDN);
+	regmap_write(priv->regmap, MT6328_TOP_CKHWEN_CON0_SET,
+		     MT6331_OTP_CK_HWEN);
+
+	if (ret) {
+		dev_err(priv->dev, "PMIC efuse HP offset read failed: %d\n",
+			ret);
+		return ret;
+	}
+
+	/* Decode, vendor:545-552.  efuse[1] bit 0 is the fourth HPR trim
+	 * bit; the two fields do not overlap, so "|" equals the vendor "+".
+	 */
+	priv->hp_trim.hpl = (efuse[0] >> 9) & 0xf;
+	priv->hp_trim.hpr = ((efuse[0] >> 13) & 0x7) |
+			    ((efuse[1] & 0x1) << 3);
+	priv->hp_trim.hpl_fine = (efuse[1] >> 2) & 0x3;
+	priv->hp_trim.hpr_fine = (efuse[1] >> 4) & 0x3;
+	priv->hp_trim.hpl_spkhp = (efuse[1] >> 6) & 0xf;
+	priv->hp_trim.hpr_spkhp = (efuse[1] >> 10) & 0xf;
+	priv->hp_trim.hpl_fine_spkhp = (efuse[1] >> 14) & 0x3;
+	priv->hp_trim.hpr_fine_spkhp = efuse[2] & 0x3;
+	priv->hp_trim.valid = true;
+
+	/* vendor:553-565 logs every field */
+	dev_info(priv->dev,
+		 "HP offset trim: HPL=%u HPR=%u HPL fine=%u HPR fine=%u\n",
+		 priv->hp_trim.hpl, priv->hp_trim.hpr,
+		 priv->hp_trim.hpl_fine, priv->hp_trim.hpr_fine);
+	dev_info(priv->dev,
+		 "SPKHP offset trim: HPL=%u HPR=%u HPL fine=%u HPR fine=%u\n",
+		 priv->hp_trim.hpl_spkhp, priv->hp_trim.hpr_spkhp,
+		 priv->hp_trim.hpl_fine_spkhp, priv->hp_trim.hpr_fine_spkhp);
+
+	return 0;
+}
