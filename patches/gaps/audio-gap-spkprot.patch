+/* ------------------------------------------------------------------ */
+/* DAC DC-offset compensation (software trim path, EFUSE_HP_TRIM off)  */
+/* ------------------------------------------------------------------ */
+/*
+ * The vendor selects between the efuse trim and the DAC DC-compensation
+ * block with EFUSE_HP_TRIM; it is not defined for MT6735/MT6328, so
+ * SetDcCompenSation()/SetDcCompenSation_SPKHP() always take the
+ * #ifndef EFUSE_HP_TRIM branch (vendor:1200-1223).
+ */
+
+/* vendor:1085-1123 SetHplOffset */
+static void mt6331_set_hpl_offset(struct mt6331_priv *priv,
+				  int offset_trimming, bool enable_ramp)
+{
+	unsigned int reg, offset;
+
+	reg = (u16)((offset_trimming * 10589 + 2048) / 4096);
+
+	if (enable_ramp) {
+		/* The left channel needs to ramp because the speaker uses it. */
+		if (!(reg & 0x8000)) {
+			offset = 0;
+			while (reg - offset > MT6331_DC_OFFSET_RAMP_STEP_HPL) {
+				mt6331_ana_write(priv,
+						 MT6328_AFE_DL_DC_COMP_CFG0,
+						 offset +
+						 MT6331_DC_OFFSET_RAMP_STEP_HPL,
+						 0xffff);
+				offset += MT6331_DC_OFFSET_RAMP_STEP_HPL;
+				usleep_range(100, 200);
+			}
+		} else {
+			offset = 0xffff;
+			while (offset - reg > MT6331_DC_OFFSET_RAMP_STEP_HPL) {
+				mt6331_ana_write(priv,
+						 MT6328_AFE_DL_DC_COMP_CFG0,
+						 offset -
+						 MT6331_DC_OFFSET_RAMP_STEP_HPL,
+						 0xffff);
+				offset -= MT6331_DC_OFFSET_RAMP_STEP_HPL;
+				usleep_range(100, 200);
+			}
+		}
+	}
+
+	mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG0, reg, 0xffff);
+}
+
+/* vendor:1071-1083 SetHprOffset */
+static void mt6331_set_hpr_offset(struct mt6331_priv *priv,
+				  int offset_trimming)
+{
+	unsigned int reg = (u16)((offset_trimming * 10589 + 2048) / 4096);
+
+	mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG1, reg, 0xffff);
+}
+
+/* vendor:1125-1131 EnableDcCompensation */
+static void mt6331_dc_compensation_enable(struct mt6331_priv *priv, bool on)
+{
+	mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG2,
+			 on ? RG_DC_COMP_EN : 0, RG_DC_COMP_EN);
+}
+
+/* vendor:1166-1180 SetHprOffsetTrim / SetHpLOffsetTrim and
+ * vendor:1200-1207 SetDcCompenSation.
+ */
+static void mt6331_dc_compensation_apply(struct mt6331_priv *priv)
+{
+	int hpr = (int)priv->hpr_trim_offset - MT6331_DC_OFFSET_TRIM_DEFAULT;
+	int hpl = (int)priv->hpl_trim_offset - MT6331_DC_OFFSET_TRIM_DEFAULT;
+
+	mt6331_set_hpr_offset(priv, hpr);
+	mt6331_set_hpl_offset(priv, hpl, false);
+	mt6331_dc_compensation_enable(priv, true);
+}
+
+/* vendor:1133-1163 RestoreDcOffsetToZero */
+static void mt6331_dc_offset_restore_zero(struct mt6331_priv *priv)
+{
+	unsigned int lch = 0, rch = 0, offset;
+
+	/* The vendor only logs the right channel value, the ramp is done on
+	 * the left one.  A read error leaves both at zero, which the writes
+	 * below would produce anyway.
+	 */
+	regmap_read(priv->regmap, MT6328_AFE_DL_DC_COMP_CFG0, &lch);
+	regmap_read(priv->regmap, MT6328_AFE_DL_DC_COMP_CFG1, &rch);
+	dev_dbg(priv->dev, "restore DC offset L=0x%04x R=0x%04x\n",
+		lch, rch);
+
+	offset = lch;
+	if (!(offset & 0x8000)) {
+		while (offset > MT6331_DC_OFFSET_RAMP_STEP) {
+			mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG0,
+					 offset - MT6331_DC_OFFSET_RAMP_STEP,
+					 0xffff);
+			offset -= MT6331_DC_OFFSET_RAMP_STEP;
+			usleep_range(100, 200);
+		}
+	} else {
+		while (offset < 0xffff - MT6331_DC_OFFSET_RAMP_STEP) {
+			mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG0,
+					 offset + MT6331_DC_OFFSET_RAMP_STEP,
+					 0xffff);
+			offset += MT6331_DC_OFFSET_RAMP_STEP;
+			usleep_range(100, 200);
+		}
+	}
+
+	mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG0, 0x0000, 0xffff);
+	mt6331_ana_write(priv, MT6328_AFE_DL_DC_COMP_CFG1, 0x0000, 0xffff);
+}
