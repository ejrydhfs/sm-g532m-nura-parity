+/* vendor:2703-2711, 2728-2733 Audio_Speaker_Pga_Gain_{Get,Set}: the vendor
+ * keeps the gain in software (Speaker_pga_gain, vendor:150) because every
+ * speaker open sequence rewrites SPK_ANA_CON0 with its own trim level.
+ */
+static int mt6331_spk_pga_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct mt6331_priv *priv =
+		snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+
+	ucontrol->value.integer.value[0] = priv->speaker_pga_gain;
+
+	return 0;
+}
+
+static int mt6331_spk_pga_set(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct mt6331_priv *priv =
+		snd_soc_component_get_drvdata(snd_kcontrol_chip(kcontrol));
+	unsigned int gain = ucontrol->value.integer.value[0];
+
+	if (gain >= ARRAY_SIZE(mt6331_spk_pga_texts))
+		return -EINVAL;
+
+	mutex_lock(&priv->ana_lock);
+	priv->speaker_pga_gain = gain;
+	/* vendor:2709 writes the new level immediately, without ramping */
+	mt6331_ana_write(priv, MT6328_SPK_ANA_CON0,
+			 gain << RG_SPKPGA_GAIN_SHIFT,
+			 RG_SPKPGA_GAIN_MASK << RG_SPKPGA_GAIN_SHIFT);
+	mutex_unlock(&priv->ana_lock);
+
+	return 0;
+}
