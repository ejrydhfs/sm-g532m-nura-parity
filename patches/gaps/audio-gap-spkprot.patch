 /* ------------------------------------------------------------------ */
 /* Platform driver                                                    */
 /* ------------------------------------------------------------------ */
+/*
+ * Speaker over-current interrupt (upmu_hw.h:2747-2752).  INT_STATUS2 is
+ * write-1-to-clear and mt6397_irq_handle_reg() (drivers/mfd/mt6397-irq.c:
+ * 85-102) runs the nested handler while the status is still set, then
+ * writes the status back.  Only our own source is cleared here so that the
+ * other pending sources keep their status for the PMIC irq thread.
+ */
+static irqreturn_t mt6331_spkl_irq(int irq, void *data)
+{
+	struct mt6331_spkl_irq *spkl = data;
+	struct mt6331_priv *priv = spkl->priv;
+	unsigned int status;
+	int ret;
+
+	ret = regmap_read(priv->regmap, MT6328_INT_STATUS2, &status);
+	if (ret)
+		return IRQ_NONE;
+
+	if (status & spkl->mask) {
+		WRITE_ONCE(*spkl->latched, true);
+		dev_warn(priv->dev,
+			 "speaker over-current on %s (INT_STATUS2=0x%04x)\n",
+			 spkl->name, status);
+		/* Write-1-to-clear only the source of this interrupt. */
+		regmap_write(priv->regmap, MT6328_INT_STATUS2, spkl->mask);
+	} else {
+		dev_dbg(priv->dev, "%s: no status bit (INT_STATUS2=0x%04x)\n",
+			spkl->name, status);
+	}
+
+	return IRQ_HANDLED;
+}
+
+/* Optional SPKL interrupts: boards or PMIC revisions without them must
+ * still probe, over-current is then only visible through the
+ * "Audio_Speaker_OC_Falg" control, like the vendor polling path.
+ */
+static int mt6331_request_spkl_irq(struct mt6331_priv *priv,
+				   struct mt6331_spkl_irq *spkl,
+				   const char *name, unsigned int mask,
+				   bool *latched)
+{
+	struct platform_device *pdev = to_platform_device(priv->dev);
+	int irq, ret;
+
+	spkl->priv = priv;
+	spkl->name = name;
+	spkl->mask = mask;
+	spkl->latched = latched;
+
+	irq = platform_get_irq_byname_optional(pdev, name);
+	if (irq < 0) {
+		if (irq == -EPROBE_DEFER)
+			return irq;
+		dev_warn(&pdev->dev, "%s interrupt unavailable: %d\n",
+			 name, irq);
+		return 0;
+	}
+
+	ret = devm_request_threaded_irq(&pdev->dev, irq, NULL,
+					mt6331_spkl_irq, IRQF_ONESHOT,
+					name, spkl);
+	if (ret) {
+		dev_warn(&pdev->dev, "cannot request %s interrupt: %d\n",
+			 name, ret);
+		return 0;
+	}
+
+	return 0;
+}
