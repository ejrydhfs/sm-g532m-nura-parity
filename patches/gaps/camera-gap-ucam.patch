diff --git a/tools/mediatek/camera/Makefile b/tools/mediatek/camera/Makefile
new file mode 100644
index 000000000..a27bcfe02
--- /dev/null
+++ b/tools/mediatek/camera/Makefile
@@ -0,0 +1,138 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# libcamdrv, the camdrv command line tool and the camservice front end.
+#
+# Port from Samsung/MTK downstream GPL kernel
+# drivers/misc/mediatek/cameraisp/src/mt6735/ and from the ROM userspace
+# libcamdrv.so interface.
+#
+# This is a host build with the system compiler.  The only kernel header it
+# consumes is include/uapi/linux/mtk_isp.h; no kernel internal header and no
+# proprietary blob takes part in the build.
+#
+#   make            static + shared library, the CLI and the service
+#   make compat32   32-bit ABI check (-m32, skipped if unavailable)
+#   make check      no-device behaviour of both programs plus compat32
+#   make clean
+#
+# Everything generated lives under build/: objects in build/obj/ and
+# build/obj/32/, binaries and libraries in build/bin/.  Keeping the
+# executable directory separate from the object tree means no target name can
+# collide with a directory left behind by an older layout.
+
+ROOT := $(abspath $(CURDIR)/../../..)
+
+CC ?= gcc
+AR ?= ar
+CFLAGS ?= -O2
+CPPFLAGS += -I$(ROOT)/include/uapi -I$(CURDIR)/libcamdrv -D__EXPORTED_HEADERS__
+CFLAGS += -Wall -Wextra -std=gnu11 -fPIC
+LDFLAGS ?=
+LDLIBS ?=
+
+BUILD := build
+OBJ := $(BUILD)/obj
+BIN := $(BUILD)/bin
+
+LIB_SRCS := libcamdrv/camdrv.c libcamdrv/camdrv_cq.c
+LIB_OBJS := $(LIB_SRCS:%.c=$(OBJ)/%.o)
+LIB32_OBJS := $(LIB_SRCS:%.c=$(OBJ)/32/%.o)
+CLI_OBJS := $(OBJ)/camdrv/main.o
+SVC_OBJS := $(OBJ)/camdrv/camservice.o
+
+# The uapi fixes every pointer field to __u64 so that the ioctl size field
+# (and therefore the ioctl number) does not depend on the userspace pointer
+# width.  That only holds on ABIs that align __u64 to 8 bytes: arm, arm64 and
+# x86-64 all do, i386 does not.  -malign-double restores the ARM EABI
+# alignment on i386 so the 32-bit build reproduces the real numbers; without
+# it the check would compare a different ABI and is skipped.
+COMPAT32_FLAGS := $(shell $(CC) -m32 -malign-double -x c -c /dev/null -o /dev/null >/dev/null 2>&1 && echo "-m32 -malign-double")
+
+.PHONY: all static shared cli service compat32 check nodev-check clean
+
+all: static shared cli service
+
+static: $(BIN)/libcamdrv.a
+shared: $(BIN)/libcamdrv.so
+cli: $(BIN)/camdrv
+service: $(BIN)/camservice
+
+$(OBJ)/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
+
+$(OBJ)/32/%.o: %.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(COMPAT32_FLAGS) -c $< -o $@
+
+$(BIN)/libcamdrv.a: $(LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(AR) rcs $@ $(LIB_OBJS)
+
+$(BIN)/libcamdrv.so: $(LIB_OBJS)
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -shared -Wl,-soname,libcamdrv.so -o $@ $(LIB_OBJS) \
+		$(LDFLAGS) $(LDLIBS)
+
+$(BIN)/camdrv: $(CLI_OBJS) $(BIN)/libcamdrv.a
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -o $@ $(CLI_OBJS) $(BIN)/libcamdrv.a $(LDFLAGS) $(LDLIBS)
+
+$(BIN)/camservice: $(SVC_OBJS) $(BIN)/libcamdrv.a
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) -o $@ $(SVC_OBJS) $(BIN)/libcamdrv.a $(LDFLAGS) $(LDLIBS)
+
+$(BIN)/libcamdrv32.a: $(LIB32_OBJS)
+	@mkdir -p $(dir $@)
+	$(AR) rcs $@ $(LIB32_OBJS)
+
+$(BIN)/abi32: tests/abi32.c $(BIN)/libcamdrv32.a
+	@mkdir -p $(dir $@)
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(COMPAT32_FLAGS) -o $@ tests/abi32.c \
+		$(BIN)/libcamdrv32.a $(LDFLAGS) $(LDLIBS)
+
+ifneq ($(COMPAT32_FLAGS),)
+compat32: $(BIN)/abi32
+	@echo "compat32: built $< (32-bit ABI layout checked)"
+else
+compat32:
+	@echo "compat32: no 32-bit toolchain ($(CC) -m32 -malign-double), check skipped"
+endif
+
+# Acceptance behaviour without a device: both programs must fail and both
+# must name ENODEV, never print a fabricated success.
+nodev-check: cli service
+	@$(BIN)/camdrv --help >/dev/null
+	@$(BIN)/camservice --help >/dev/null
+	@if $(BIN)/camdrv info >$(BUILD)/nodev.out 2>$(BUILD)/nodev.err; then \
+		echo "nodev-check: unexpected success, is a camera ISP device present?"; \
+		exit 1; \
+	fi
+	@if grep -q ENODEV $(BUILD)/nodev.err; then \
+		echo "nodev-check: camdrv reports the missing device as ENODEV"; \
+	else \
+		echo "nodev-check: camdrv device error not reported as ENODEV"; \
+		cat $(BUILD)/nodev.err; \
+		exit 1; \
+	fi
+	@if $(BIN)/camservice --frames 1 >$(BUILD)/nodev-svc.out 2>$(BUILD)/nodev-svc.err; then \
+		echo "nodev-check: camservice succeeded without a device"; \
+		exit 1; \
+	fi
+	@if grep -q ENODEV $(BUILD)/nodev-svc.err; then \
+		echo "nodev-check: camservice reports the missing device as ENODEV"; \
+	else \
+		echo "nodev-check: camservice device error not reported as ENODEV"; \
+		cat $(BUILD)/nodev-svc.err; \
+		exit 1; \
+	fi
+
+ifeq ($(COMPAT32_FLAGS),)
+check: nodev-check compat32
+else
+check: nodev-check compat32
+	@$(BIN)/abi32 >/dev/null
+endif
+
+clean:
+	rm -rf $(BUILD)
diff --git a/tools/mediatek/camera/camdrv/camservice.c b/tools/mediatek/camera/camdrv/camservice.c
new file mode 100644
index 000000000..89fad7d69
--- /dev/null
+++ b/tools/mediatek/camera/camdrv/camservice.c
@@ -0,0 +1,338 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * camservice - userspace camera ISP service front end.
+ *
+ * Port from Samsung/MTK downstream GPL kernel
+ * drivers/misc/mediatek/cameraisp/src/mt6735/camera_isp_D1.c
+ * and from the ROM userspace libcamdrv.so IspDrvImp::* API.
+ *
+ * This is the process that owns /dev/camera-isp for the lifetime of a camera
+ * session, the way the ROM camera service does through libcamdrv.so:
+ *
+ *   - it is the single opener of the device node,
+ *   - it is the single mapper of the ISP register windows (mmap(2), the page
+ *     offset is the physical base, exactly what the uapi defines),
+ *   - it registers the interrupt user key and blocks in ISP_WAIT_IRQ, waking
+ *     a frame consumer per pass-1 interrupt.
+ *
+ * It does not program the ISP pipeline.  The pipeline is written through the
+ * CQ0C ring and the tuning tables, whose instruction encodings exist only in
+ * the closed camera HAL and are not part of this port; libcamdrv refuses to
+ * invent those words (see camdrv_cq_ring_init()).  Everything this program
+ * does is a real ioctl or mmap(2) on /dev/camera-isp: when the device, the
+ * interrupt or the timeout is missing it prints the errno and exits non-zero,
+ * and it never reports a frame it did not receive.
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "camdrv.h"
+
+#define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
+
+static const char *const prog = "camservice";
+static volatile sig_atomic_t stop;
+
+static void on_signal(int sig)
+{
+	(void)sig;
+	stop = 1;
+}
+
+static void usage(FILE *out)
+{
+	int i;
+
+	fprintf(out,
+"usage: %s [options]\n"
+"\n"
+"Opens %s, maps the requested ISP register windows, registers an\n"
+"interrupt user key and then waits for pass-1 interrupts until the requested\n"
+"number of frames arrived or a signal is received.\n"
+"\n"
+"options:\n"
+"  --frames <n>      stop after n interrupts (0 = until signalled, default 0)\n"
+"  --type <n|name>   IRQ type to wait for (default 0 = p1)\n"
+"  --status <hex>    status bits to wait for (default 0x%08x)\n"
+"  --timeout <ms>    per-wait timeout (default 1000)\n"
+"  --key <n>         IRQ user key (default: the key registered at start)\n"
+"  --user <n>        use the v1 IRQ flow with this user number (> 0)\n"
+"  --map <window>    map a register window; repeatable, or 'all'\n"
+"  --no-irq-key      do not register an interrupt user key\n"
+"  --quiet           only report errors\n"
+"  --help            this text\n"
+"\n"
+"windows:",
+		prog, CAMDRV_DEV_NODE, ISP_IRQ_P1_STATUS_SOF1_INT_ST);
+	for (i = 0; i < CAMDRV_WIN_COUNT; i++)
+		fprintf(out, " %s(0x%08x+0x%x)", camdrv_windows[i].name,
+			camdrv_windows[i].base, camdrv_windows[i].size);
+	fprintf(out, "\n\nexit status: 0 when the requested frames arrived or a "
+		"signal stopped the loop,\n             1 on a driver error, "
+		"2 on a usage error\n");
+}
+
+static void usage_error(const char *msg)
+{
+	fprintf(stderr, "%s: %s\n", prog, msg);
+	fprintf(stderr, "%s: try '%s --help'\n", prog, prog);
+	exit(2);
+}
+
+static int fail(int err, const char *what)
+{
+	fprintf(stderr, "%s: %s: %s: %s\n", prog, what, camdrv_errname(err),
+		strerror(-err));
+	return 1;
+}
+
+static bool parse_num(const char *s, uint64_t *out)
+{
+	char *end;
+	unsigned long long v;
+
+	if (!s || !*s)
+		return false;
+	errno = 0;
+	v = strtoull(s, &end, 0);
+	if (errno || *end)
+		return false;
+	*out = v;
+	return true;
+}
+
+static uint64_t need_num(const char *s, const char *what)
+{
+	uint64_t v;
+
+	if (!parse_num(s, &v))
+		usage_error(what);
+	return v;
+}
+
+static int irq_type_by_name(const char *s)
+{
+	static const char *const names[] = {
+		[ISP_IRQ_TYPE_INT_P1_ST]	= "p1",
+		[ISP_IRQ_TYPE_INT_P1_ST2]	= "p1-dma",
+		[ISP_IRQ_TYPE_INT_P1_ST_D]	= "p1-d",
+		[ISP_IRQ_TYPE_INT_P1_ST2_D]	= "p1-dma-d",
+		[ISP_IRQ_TYPE_INT_P2_ST]	= "p2",
+		[ISP_IRQ_TYPE_INT_STATUSX]	= "statusx",
+		[ISP_IRQ_TYPE_INT_STATUS2X]	= "status2x",
+		[ISP_IRQ_TYPE_INT_STATUS3X]	= "status3x",
+		[ISP_IRQ_TYPE_INT_SENINF1]	= "seninf1",
+		[ISP_IRQ_TYPE_INT_SENINF2]	= "seninf2",
+		[ISP_IRQ_TYPE_INT_SENINF3]	= "seninf3",
+		[ISP_IRQ_TYPE_INT_SENINF4]	= "seninf4",
+		[ISP_IRQ_TYPE_INT_CAMSV]	= "camsv",
+		[ISP_IRQ_TYPE_INT_CAMSV2]	= "camsv2",
+	};
+	uint64_t v;
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (names[i] && !strcmp(s, names[i]))
+			return (int)i;
+	if (parse_num(s, &v) && v < ISP_IRQ_TYPE_AMOUNT)
+		return (int)v;
+	return -1;
+}
+
+int main(int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "frames",	required_argument,	NULL, 'f' },
+		{ "type",	required_argument,	NULL, 't' },
+		{ "status",	required_argument,	NULL, 's' },
+		{ "timeout",	required_argument,	NULL, 'o' },
+		{ "key",	required_argument,	NULL, 'k' },
+		{ "user",	required_argument,	NULL, 'u' },
+		{ "map",	required_argument,	NULL, 'm' },
+		{ "no-irq-key",	no_argument,		NULL, 'n' },
+		{ "quiet",	no_argument,		NULL, 'q' },
+		{ "help",	no_argument,		NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	struct sigaction sa = { .sa_handler = on_signal };
+	uint64_t frames = 0;
+	uint32_t type = ISP_IRQ_TYPE_INT_P1_ST;
+	uint32_t status = ISP_IRQ_P1_STATUS_SOF1_INT_ST;
+	uint32_t timeout = 1000;
+	bool map_all = false, quiet = false, no_key = false;
+	unsigned int map_mask = 0;
+	long user = -1, key = -1;
+	struct camdrv *d;
+	uint64_t frame;
+	int c, ret, rc = 0;
+
+	optind = 1;
+	while ((c = getopt_long(argc, argv, "h", opts, NULL)) != -1) {
+		uint64_t v;
+
+		switch (c) {
+		case 'f':
+			frames = need_num(optarg, "bad --frames");
+			break;
+		case 't':
+			if (irq_type_by_name(optarg) < 0)
+				usage_error("bad --type");
+			type = (uint32_t)irq_type_by_name(optarg);
+			break;
+		case 's':
+			status = (uint32_t)need_num(optarg, "bad --status");
+			if (!status)
+				usage_error("--status needs at least one bit");
+			break;
+		case 'o':
+			v = need_num(optarg, "bad --timeout");
+			if (!v || v > UINT32_MAX)
+				usage_error("bad --timeout");
+			timeout = (uint32_t)v;
+			break;
+		case 'k':
+			v = need_num(optarg, "bad --key");
+			if (v < 1 || v > INT32_MAX)
+				usage_error("--key must be 1..INT32_MAX");
+			key = (long)v;
+			break;
+		case 'u':
+			v = need_num(optarg, "bad --user");
+			if (v < 1 || v >= ISP_IRQ_USER_MAX)
+				usage_error("--user must be 1..ISP_IRQ_USER_MAX-1");
+			user = (long)v;
+			break;
+		case 'm': {
+			int id;
+
+			if (!strcmp(optarg, "all")) {
+				map_all = true;
+				break;
+			}
+			id = camdrv_window_id_by_name(optarg);
+			if (id < 0)
+				usage_error("unknown window name");
+			map_mask |= 1u << id;
+			break;
+		}
+		case 'n':
+			no_key = true;
+			break;
+		case 'q':
+			quiet = true;
+			break;
+		case 'h':
+			usage(stdout);
+			return 0;
+		default:
+			usage_error("unknown option");
+		}
+	}
+	if (optind != argc)
+		usage_error("unexpected argument");
+	if (key >= 0 && user > 0)
+		usage_error("--key and --user are mutually exclusive");
+
+	if (!quiet) {
+		printf("%s: opening %s\n", prog, CAMDRV_DEV_NODE);
+		fflush(stdout);
+	}
+
+	d = camdrv_create();
+	if (!d) {
+		fprintf(stderr, "%s: out of memory\n", prog);
+		return 1;
+	}
+
+	/* Registering a key is what the downstream service does in
+	 * IspDrvImp::init().  --no-irq-key skips it, which is what a client
+	 * of the v1 --user flow or a kernel without
+	 * ISP_REGISTER_IRQ_USER_KEY needs. */
+	ret = camdrv_init(d, no_key ? NULL : "camservice");
+	if (ret) {
+		rc = fail(ret, "open");
+		goto out_destroy;
+	}
+
+	if (map_all)
+		map_mask = (1u << CAMDRV_WIN_COUNT) - 1;
+	for (c = 0; c < CAMDRV_WIN_COUNT; c++) {
+		if (!(map_mask & (1u << c)))
+			continue;
+		ret = camdrv_mmap(d, (enum camdrv_window_id)c);
+		if (ret) {
+			rc = fail(ret, camdrv_windows[c].name);
+			goto out_uninit;
+		}
+		if (!quiet)
+			printf("%s: mapped %s at 0x%08x (%u bytes)\n", prog,
+			       camdrv_windows[c].name, camdrv_windows[c].base,
+			       camdrv_windows[c].size);
+	}
+
+	if (key < 0)
+		key = camdrv_user_key(d);
+	if (user <= 0 && key <= 0) {
+		fprintf(stderr, "%s: no IRQ user key registered; pass --key <n> "
+			"or --user <n>\n", prog);
+		rc = 2;
+		goto out_uninit;
+	}
+
+	sigaction(SIGINT, &sa, NULL);
+	sigaction(SIGTERM, &sa, NULL);
+
+	frame = 0;
+	while (!stop && (!frames || frame < frames)) {
+		ISP_WAIT_IRQ_STRUCT irq;
+
+		if (user > 0)
+			camdrv_irq_fill_v1(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+					   (ISP_IRQ_USER_ENUM)user, timeout);
+		else
+			camdrv_irq_fill_v3(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+					   (int)key, timeout);
+
+		ret = camdrv_wait_irq(d, &irq);
+		if (ret) {
+			rc = fail(ret, "wait-irq");
+			goto out_uninit;
+		}
+
+		frame++;
+		if (!quiet) {
+			unsigned int u = (unsigned int)(type < ISP_IRQ_TYPE_AMOUNT ?
+							type : 0);
+
+			printf("%s: frame %llu irq type=%u status=0x%08x "
+			       "tstamp=%u sig=%u.%06u\n",
+			       prog, (unsigned long long)frame, u,
+			       irq.UserInfo.Status ? irq.UserInfo.Status :
+			       irq.Status, irq.irq_TStamp,
+			       irq.TimeInfo.tLastSig_sec,
+			       irq.TimeInfo.tLastSig_usec);
+			fflush(stdout);
+		}
+	}
+
+	if (stop && !quiet)
+		printf("%s: stopped by signal after %llu frames\n", prog,
+		       (unsigned long long)frame);
+	else if (!quiet)
+		printf("%s: done, %llu frames\n", prog,
+		       (unsigned long long)frame);
+
+out_uninit:
+	camdrv_uninit(d);
+out_destroy:
+	camdrv_destroy(d);
+	return rc;
+}
diff --git a/tools/mediatek/camera/camdrv/main.c b/tools/mediatek/camera/camdrv/main.c
