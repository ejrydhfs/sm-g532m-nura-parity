+++ b/tools/mediatek/camera/camdrv/main.c
@@ -0,0 +1,947 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * camdrv - command line front end for libcamdrv.
+ *
+ * Port from Samsung/MTK downstream GPL kernel
+ * drivers/misc/mediatek/cameraisp/src/mt6735/camera_isp_D1.c
+ * and from the ROM userspace libcamdrv.so IspDrvImp::* API.
+ *
+ * Every subcommand issues a real ioctl on /dev/camera-isp.  Nothing is
+ * simulated: a missing device, an unsupported control or a timeout is
+ * reported on stderr and turned into a non-zero exit status.
+ */
+
+#include <errno.h>
+#include <getopt.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "camdrv.h"
+
+#define ARRAY_SIZE(a)	(sizeof(a) / sizeof((a)[0]))
+
+static const char *const prog = "camdrv";
+static const char *const default_user = "camdrv";
+
+struct dma_name {
+	const char *name;
+	_isp_dma_enum_ id;
+};
+
+static const struct dma_name dma_names[] = {
+	{ "imgi",		_imgi_ },
+	{ "vipi",		_vipi_ },
+	{ "vip2i",		_vip2i_ },
+	{ "vip3i",		_vip3i_ },
+	{ "imgo",		_imgo_ },
+	{ "ufdi",		_ufdi_ },
+	{ "lcei",		_lcei_ },
+	{ "ufeo",		_ufeo_ },
+	{ "rrzo",		_rrzo_ },
+	{ "imgo-d",		_imgo_d_ },
+	{ "rrzo-d",		_rrzo_d_ },
+	{ "img2o",		_img2o_ },
+	{ "img3o",		_img3o_ },
+	{ "img3bo",		_img3bo_ },
+	{ "img3co",		_img3co_ },
+	{ "camsv-imgo",		_camsv_imgo_ },
+	{ "camsv2-imgo",	_camsv2_imgo_ },
+	{ "mfbo",		_mfbo_ },
+	{ "feo",		_feo_ },
+	{ "wrot",		_wrot_ },
+	{ "wdma",		_wdma_ },
+	{ "jpeg",		_jpeg_ },
+};
+
+static const char *const irq_type_names[] = {
+	[ISP_IRQ_TYPE_INT_P1_ST]	= "p1",
+	[ISP_IRQ_TYPE_INT_P1_ST2]	= "p1-dma",
+	[ISP_IRQ_TYPE_INT_P1_ST_D]	= "p1-d",
+	[ISP_IRQ_TYPE_INT_P1_ST2_D]	= "p1-dma-d",
+	[ISP_IRQ_TYPE_INT_P2_ST]	= "p2",
+	[ISP_IRQ_TYPE_INT_STATUSX]	= "statusx",
+	[ISP_IRQ_TYPE_INT_STATUS2X]	= "status2x",
+	[ISP_IRQ_TYPE_INT_STATUS3X]	= "status3x",
+	[ISP_IRQ_TYPE_INT_SENINF1]	= "seninf1",
+	[ISP_IRQ_TYPE_INT_SENINF2]	= "seninf2",
+	[ISP_IRQ_TYPE_INT_SENINF3]	= "seninf3",
+	[ISP_IRQ_TYPE_INT_SENINF4]	= "seninf4",
+	[ISP_IRQ_TYPE_INT_CAMSV]	= "camsv",
+	[ISP_IRQ_TYPE_INT_CAMSV2]	= "camsv2",
+};
+
+static const char *const ref_ctrl_names[] = {
+	[ISP_REF_CNT_GET]				= "get",
+	[ISP_REF_CNT_INC]				= "inc",
+	[ISP_REF_CNT_DEC]				= "dec",
+	[ISP_REF_CNT_DEC_AND_RESET_P1_P2_IF_LAST_ONE]	= "dec-reset-p1p2",
+	[ISP_REF_CNT_DEC_AND_RESET_P1_IF_LAST_ONE]	= "dec-reset-p1",
+	[ISP_REF_CNT_DEC_AND_RESET_P2_IF_LAST_ONE]	= "dec-reset-p2",
+};
+
+static const char *const ref_id_names[] = {
+	"imem", "isp-func", "global-pipe", "p1-pipe", "p2-pipe",
+};
