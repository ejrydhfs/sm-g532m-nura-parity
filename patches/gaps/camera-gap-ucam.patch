+static _isp_dma_enum_ parse_dma_only(int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "dma",	required_argument,	NULL, 'd' },
+		{ "help",	no_argument,		NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	_isp_dma_enum_ dma = _imgo_;
+	int c;
+
+	optind = 1;
+	while ((c = getopt_long(argc, argv, "h", opts, NULL)) != -1) {
+		switch (c) {
+		case 'd':
+			if (dma_by_name(optarg) < 0)
+				usage_error("unknown --dma channel");
+			dma = (_isp_dma_enum_)dma_by_name(optarg);
+			break;
+		case 'h':
+			usage(stdout);
+			exit(0);
+		default:
+			usage_error("unknown option");
+		}
+	}
+	if (optind != argc)
+		usage_error("unexpected argument");
+	return dma;
+}
