+static void usage(FILE *out)
+{
+	int i;
+
+	fprintf(out,
+"usage: %s <command> [options]\n"
+"\n"
+"commands:\n"
+"  info                       device node, register scenario, burst queue,\n"
+"                             SOF and drop-frame counters, error counters\n"
+"  dump-regs                  request a full ISP register dump (kernel log)\n"
+"  dump-isr-log [--tg n]      request an interrupt log dump for one TG\n"
+"  read-reg <addr> [count]    read one register or a block of registers\n"
+"  write-reg <addr> <value>   write one register\n"
+"  wait-irq [options]         wait for an ISP interrupt\n"
+"  rtbuf-enqueue [options]    enqueue a pass-1 real time buffer\n"
+"  rtbuf-dequeue [options]    dequeue a filled pass-1 real time buffer\n"
+"  rtbuf-status [options]     ring size, ready flag and current FBC dump\n"
+"  mmap-dump [options]        hex dump a mapped ISP register window\n"
+"  get-sof [options]          query the software SOF counter\n"
+"  get-errors                 dump interrupt and DMA error counters\n"
+"  ref-cnt [options]          get/inc/dec a driver reference counter\n"
+"  hold <0|1>                 hold register writes until the next trigger\n"
+"\n"
+"device node: %s (fixed by the uapi)\n", prog, CAMDRV_DEV_NODE);
+
+	fprintf(out, "\nwait-irq options:\n"
+"  --type <n|name>            IRQ type (default 0 = p1)\n"
+"  --status <hex>             status bits to wait for (default 0x%08x)\n"
+"  --timeout <ms>             timeout in milliseconds (default 1000)\n"
+"  --clear <n>                ISP_IRQ_CLEAR_ENUM (default 0 = none)\n"
+"  --user <n>                 use the v1 flow with this user number (> 0)\n"
+"  --key <n>                  use the v3 flow with this IRQ user key\n"
+"                             (default: the key registered at init)\n"
+"  --mark                     mark an IRQ request instead of waiting\n"
+"  --flush                    flush pending IRQ requests\n"
+"  --mark-time                query the mark-to-query time only\n",
+		ISP_IRQ_P1_STATUS_SOF1_INT_ST);
+
+	fprintf(out, "\nrtbuf options:\n"
+"  --dma <name>               DMA channel (default imgo)\n"
+"  --pa <hex>                 buffer physical address (required)\n"
+"  --va <num>                 buffer virtual address recorded in the ring\n"
+"  --size <num>               buffer size\n"
+"  --index <num>              buffer index used for replacement\n"
+"  --memid <num>              memory id\n"
+"  --immediate                use ENQUE_IMD instead of ENQUE\n");
+
+	fprintf(out, "\nwindows:");
+	for (i = 0; i < CAMDRV_WIN_COUNT; i++)
+		fprintf(out, " %s(0x%08x+0x%x)", camdrv_windows[i].name,
+			camdrv_windows[i].base, camdrv_windows[i].size);
+	fprintf(out, "\n\nmmap-dump options:\n"
+"  --window <name>            window to map (default isp)\n"
+"  --offset <num>             byte offset inside the window\n"
+"  --length <num>             bytes to dump (default 64, max window size)\n"
+"\nref-cnt options:\n"
+"  --ctrl <name|n>            get/inc/dec/dec-reset-* (default get)\n"
+"  --id <name|n>              imem/isp-func/global-pipe/p1-pipe/p2-pipe\n"
+"\n"
+"exit status: 0 on success, 1 on a driver error, 2 on a usage error\n");
+}
+
+static void usage_error(const char *msg)
+{
+	fprintf(stderr, "%s: %s\n", prog, msg);
+	fprintf(stderr, "%s: try '%s --help'\n", prog, prog);
+	exit(2);
+}
+
+static int fail(int err, const char *what)
+{
+	fprintf(stderr, "%s: %s: %s: %s\n", prog, what, camdrv_errname(err),
+		strerror(-err));
+	return 1;
+}
+
+static bool parse_num(const char *s, uint64_t *out)
+{
+	char *end;
+	unsigned long long v;
+
+	if (!s || !*s)
+		return false;
+	errno = 0;
+	v = strtoull(s, &end, 0);
+	if (errno || *end)
+		return false;
+	*out = v;
+	return true;
+}
+
+static uint64_t need_num(const char *s, const char *what)
+{
+	uint64_t v;
+
+	if (!parse_num(s, &v))
+		usage_error(what);
+	return v;
+}
+
+static int dma_by_name(const char *name)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(dma_names); i++)
+		if (!strcmp(name, dma_names[i].name))
+			return dma_names[i].id;
+	return -1;
+}
+
+static const char *dma_name(int id)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(dma_names); i++)
+		if ((int)dma_names[i].id == id)
+			return dma_names[i].name;
+	return "?";
+}
+
+static int irq_type_by_name(const char *s)
+{
+	size_t i;
+	uint64_t v;
+
+	for (i = 0; i < ARRAY_SIZE(irq_type_names); i++)
+		if (irq_type_names[i] && !strcmp(s, irq_type_names[i]))
+			return (int)i;
+	if (parse_num(s, &v) && v < ISP_IRQ_TYPE_AMOUNT)
+		return (int)v;
+	return -1;
+}
+
+static int ref_ctrl_by_name(const char *s)
+{
+	size_t i;
+	uint64_t v;
+
+	for (i = 0; i < ARRAY_SIZE(ref_ctrl_names); i++)
+		if (ref_ctrl_names[i] && !strcmp(s, ref_ctrl_names[i]))
+			return (int)i;
+	if (parse_num(s, &v) && v < ISP_REF_CNT_MAX)
+		return (int)v;
+	return -1;
+}
+
+static int ref_id_by_name(const char *s)
+{
+	size_t i;
+	uint64_t v;
+
+	for (i = 0; i < ARRAY_SIZE(ref_id_names); i++)
+		if (!strcmp(s, ref_id_names[i]))
+			return (int)i;
+	if (parse_num(s, &v) && v < ISP_REF_CNT_ID_MAX)
+		return (int)v;
+	return -1;
+}
+
+static int dump_errors(struct camdrv *d)
+{
+	uint32_t ints[ISP_INT_ERR_COUNT];
+	uint32_t dma[ISP_DMA_ERR_COUNT];
+	int ret, i;
+
+	ret = camdrv_get_int_err(d, ints, ARRAY_SIZE(ints));
+	if (ret)
+		return fail(ret, "get-int-err");
+	printf("int errors: p1=%u p1-d=%u camsv=%u camsv2=%u\n",
+	       ints[0], ints[1], ints[2], ints[3]);
+
+	ret = camdrv_get_dma_err(d, dma, ARRAY_SIZE(dma));
+	if (ret)
+		return fail(ret, "get-dma-err");
+	printf("dma errors (%d counters):", ISP_DMA_ERR_COUNT);
+	for (i = 0; i < ISP_DMA_ERR_COUNT; i++)
+		printf(" %u", dma[i]);
+	printf("\n");
+	return 0;
+}
+
+static int dump_sof_all(struct camdrv *d)
+{
+	int tg, rc = 0;
+
+	for (tg = 0; tg < 4; tg++) {
+		uint32_t sof = 0, drop = 0;
+		int ret;
+
+		ret = camdrv_get_cur_sof(d, tg, &sof);
+		if (ret)
+			return fail(ret, "get-sof");
+		ret = camdrv_get_drop_frame(d, tg, &drop);
+		if (ret)
+			return fail(ret, "get-drop-frame");
+		printf("tg%d: sof=%u pass1done=%u\n", tg, sof, drop);
+	}
+	return rc;
+}
+
+static int cmd_info(struct camdrv *d, int argc, char **argv)
+{
+	uint32_t scen = 0;
+	int32_t burst = 0;
+	int ret, rc = 0;
+
+	(void)argv;
+	if (argc > 1)
+		usage_error("info takes no arguments");
+
+	printf("node:  %s\n", CAMDRV_DEV_NODE);
+	ret = camdrv_query_regscen(d, &scen);
+	if (ret) {
+		printf("regscen: %s\n", camdrv_errname(ret));
+		rc = 1;
+	} else {
+		printf("regscen: 0x%08x\n", scen);
+	}
+	ret = camdrv_query_burstqnum(d, &burst);
+	if (ret) {
+		printf("burstqnum: %s\n", camdrv_errname(ret));
+		rc = 1;
+	} else {
+		printf("burstqnum: %d\n", burst);
+	}
+	ret = dump_sof_all(d);
+	if (ret)
+		return ret;
+	ret = dump_errors(d);
+	if (ret)
+		return ret;
+	return rc;
+}
+
+static int cmd_read_reg(struct camdrv *d, int argc, char **argv)
+{
+	uint32_t addr, count, i;
+	ISP_REG_STRUCT *regs;
+	int ret;
+
+	if (argc < 2)
+		usage_error("read-reg needs an address");
+	addr = (uint32_t)need_num(argv[1], "bad address");
+	count = argc > 2 ? (uint32_t)need_num(argv[2], "bad count") : 1;
+	if (!count || count > 4096)
+		usage_error("count out of range");
+
+	regs = calloc(count, sizeof(*regs));
+	if (!regs)
+		return fail(-ENOMEM, "read-reg");
+	for (i = 0; i < count; i++)
+		regs[i].Addr = addr + i * 4;
+
+	ret = camdrv_read_regs(d, regs, count);
+	if (ret) {
+		free(regs);
+		return fail(ret, "read-reg");
+	}
+	for (i = 0; i < count; i++)
+		printf("0x%08x = 0x%08x\n", regs[i].Addr, regs[i].Val);
+	free(regs);
+	return 0;
+}
+
+static int cmd_write_reg(struct camdrv *d, int argc, char **argv)
+{
+	uint32_t addr, value;
+	int ret;
+
+	if (argc < 3)
+		usage_error("write-reg needs an address and a value");
+	addr = (uint32_t)need_num(argv[1], "bad address");
+	value = (uint32_t)need_num(argv[2], "bad value");
+	ret = camdrv_write_reg(d, addr, value);
+	if (ret)
+		return fail(ret, "write-reg");
+	printf("wrote 0x%08x = 0x%08x\n", addr, value);
+	return 0;
+}
+
+static int cmd_dump_regs(struct camdrv *d, int argc, char **argv)
+{
+	int ret;
+
+	(void)argv;
+	if (argc > 1)
+		usage_error("dump-regs takes no arguments");
+	ret = camdrv_dump_reg(d);
+	if (ret)
+		return fail(ret, "dump-regs");
+	printf("register dump requested (output goes to the kernel log)\n");
+	return 0;
+}
+
+static int cmd_dump_isr_log(struct camdrv *d, int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "tg",		required_argument,	NULL, 't' },
+		{ "help",	no_argument,		NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	unsigned int tg = 0;
+	int c, ret;
+
+	optind = 1;
+	while ((c = getopt_long(argc, argv, "h", opts, NULL)) != -1) {
+		uint64_t v;
+
+		switch (c) {
+		case 't':
+			v = need_num(optarg, "bad --tg");
+			if (v > 3)
+				usage_error("--tg must be 0..3");
+			tg = (unsigned int)v;
+			break;
+		case 'h':
+			usage(stdout);
+			exit(0);
+		default:
+			usage_error("unknown dump-isr-log option");
+		}
+	}
+	if (optind != argc)
+		usage_error("unexpected dump-isr-log argument");
+
+	ret = camdrv_dump_isr_log(d, tg);
+	if (ret)
+		return fail(ret, "dump-isr-log");
+	printf("interrupt log dump of tg%u requested (output goes to the kernel "
+	       "log)\n", tg);
+	return 0;
+}
+
+static int cmd_wait_irq(struct camdrv *d, int argc, char **argv)
+{
+	static const struct option opts[] = {
+		{ "type",	required_argument,	NULL, 't' },
+		{ "status",	required_argument,	NULL, 's' },
+		{ "timeout",	required_argument,	NULL, 'o' },
+		{ "clear",	required_argument,	NULL, 'c' },
+		{ "user",	required_argument,	NULL, 'u' },
+		{ "key",	required_argument,	NULL, 'k' },
+		{ "mark",	no_argument,		NULL, 'm' },
+		{ "flush",	no_argument,		NULL, 'f' },
+		{ "mark-time",	no_argument,		NULL, 'q' },
+		{ "help",	no_argument,		NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	ISP_WAIT_IRQ_STRUCT irq;
+	uint32_t type = ISP_IRQ_TYPE_INT_P1_ST;
+	uint32_t status = ISP_IRQ_P1_STATUS_SOF1_INT_ST;
+	uint32_t timeout = 1000;
+	uint32_t clear = ISP_IRQ_CLEAR_NONE;
+	long user = -1;
+	long key = -1;
+	int action = 0;
+	int c, ret;
+
+	optind = 1;
+	while ((c = getopt_long(argc, argv, "h", opts, NULL)) != -1) {
+		uint64_t v;
+
+		switch (c) {
+		case 't':
+			if (irq_type_by_name(optarg) < 0)
+				usage_error("bad --type");
+			type = (uint32_t)irq_type_by_name(optarg);
+			break;
+		case 's':
+			status = (uint32_t)need_num(optarg, "bad --status");
+			break;
+		case 'o':
+			timeout = (uint32_t)need_num(optarg, "bad --timeout");
+			break;
+		case 'c':
+			v = need_num(optarg, "bad --clear");
+			if (v > ISP_IRQ_CLEAR_ALL)
+				usage_error("bad --clear");
+			clear = (uint32_t)v;
+			break;
+		case 'u':
+			user = (long)need_num(optarg, "bad --user");
+			break;
+		case 'k':
+			key = (long)need_num(optarg, "bad --key");
+			break;
+		case 'm':
+		case 'f':
+		case 'q':
+			action = c;
+			break;
+		case 'h':
+			usage(stdout);
+			exit(0);
+		default:
+			usage_error("unknown wait-irq option");
+		}
+	}
+	if (optind != argc)
+		usage_error("unexpected wait-irq argument");
+
+	if (key >= 0)
+		camdrv_irq_fill_v3(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+				   (int)key, timeout);
+	else if (user > 0)
+		camdrv_irq_fill_v1(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+				   (ISP_IRQ_USER_ENUM)user, timeout);
+	else if (camdrv_user_key(d) > 0)
+		/* Default to the key camdrv_init() registered for us; the
+		 * kernel rejects key 0 for mark/flush and uses only the ISPDRV
+		 * slot for it. */
+		camdrv_irq_fill_v3(&irq, (ISP_IRQ_TYPE_ENUM)type, status,
+				   camdrv_user_key(d), timeout);
+	else {
+		fprintf(stderr, "%s: no IRQ user key registered; "
+			"pass --key <n> or --user <n>\n", prog);
+		return 2;
+	}
+	irq.Clear = (ISP_IRQ_CLEAR_ENUM)clear;
+
+	switch (action) {
+	case 'm':
+		ret = camdrv_mark_irq(d, &irq);
+		break;
+	case 'f':
+		ret = camdrv_flush_irq(d, &irq);
+		break;
+	case 'q':
+		ret = camdrv_get_mark2query_time(d, &irq);
+		break;
+	default:
+		ret = camdrv_wait_irq(d, &irq);
+		break;
+	}
+	if (ret)
+		return fail(ret, action == 0 ? "wait-irq" :
+			    action == 'm' ? "mark-irq" :
+			    action == 'f' ? "flush-irq" : "get-mark2query");
+
+	printf("irq: type=%s status=0x%08x tstamp=%u\n",
+	       irq_type_names[type] ? irq_type_names[type] : "?", status,
+	       irq.irq_TStamp);
+	printf("time: last-signal=%u.%06u mark2wait=%u.%06u last2get=%u.%06u passed=%d\n",
+	       irq.TimeInfo.tLastSig_sec, irq.TimeInfo.tLastSig_usec,
+	       irq.TimeInfo.tMark2WaitSig_sec, irq.TimeInfo.tMark2WaitSig_usec,
+	       irq.TimeInfo.tLastSig2GetSig_sec, irq.TimeInfo.tLastSig2GetSig_usec,
+	       irq.TimeInfo.passedbySigcnt);
+	printf("eis: sof2p1done=%u.%06u\n", irq.EisMeta.tLastSOF2P1done_sec,
+	       irq.EisMeta.tLastSOF2P1done_usec);
+	return 0;
+}
+
+static void parse_rtbuf_opts(int argc, char **argv, _isp_dma_enum_ *dma,
+			     ISP_RT_BUF_INFO_STRUCT *buf, bool *immediate)
+{
+	static const struct option opts[] = {
+		{ "dma",	required_argument,	NULL, 'd' },
+		{ "pa",		required_argument,	NULL, 'p' },
+		{ "va",		required_argument,	NULL, 'v' },
+		{ "size",	required_argument,	NULL, 's' },
+		{ "index",	required_argument,	NULL, 'i' },
+		{ "memid",	required_argument,	NULL, 'm' },
+		{ "immediate",	no_argument,		NULL, 'I' },
+		{ "help",	no_argument,		NULL, 'h' },
+		{ NULL, 0, NULL, 0 },
+	};
+	int c;
+
+	memset(buf, 0, sizeof(*buf));
+	*dma = _imgo_;
+	*immediate = false;
+	buf->bufIdx = -1;
+
+	optind = 1;
+	while ((c = getopt_long(argc, argv, "h", opts, NULL)) != -1) {
+		uint64_t v;
+
+		switch (c) {
+		case 'd':
+			if (dma_by_name(optarg) < 0)
+				usage_error("unknown --dma channel");
+			*dma = (_isp_dma_enum_)dma_by_name(optarg);
+			break;
+		case 'p':
+			buf->base_pAddr = (uint32_t)need_num(optarg, "bad --pa");
+			break;
+		case 'v':
+			buf->base_vAddr = (int64_t)need_num(optarg, "bad --va");
+			break;
+		case 's':
+			buf->size = (uint32_t)need_num(optarg, "bad --size");
+			break;
+		case 'i':
+			v = need_num(optarg, "bad --index");
+			if (v > INT32_MAX)
+				usage_error("--index out of range");
+			buf->bufIdx = (int32_t)v;
+			break;
+		case 'm':
+			buf->memID = (uint32_t)need_num(optarg, "bad --memid");
+			break;
+		case 'I':
+			*immediate = true;
+			break;
+		case 'h':
+			usage(stdout);
+			exit(0);
+		default:
+			usage_error("unknown rtbuf option");
+		}
+	}
+	if (optind != argc)
+		usage_error("unexpected rtbuf argument");
+	if (!buf->base_pAddr)
+		usage_error("--pa is required");
+}
+
+static int cmd_rtbuf_enqueue(struct camdrv *d, int argc, char **argv)
+{
+	ISP_RT_BUF_INFO_STRUCT buf;
+	_isp_dma_enum_ dma;
+	bool immediate;
+	int ret;
+
+	parse_rtbuf_opts(argc, argv, &dma, &buf, &immediate);
+	if (immediate)
+		ret = camdrv_rtbuf_enqueue_immediate(d, dma, &buf);
+	else
+		ret = camdrv_rtbuf_enqueue(d, dma, &buf);
+	if (ret)
+		return fail(ret, "rtbuf-enqueue");
+	printf("enqueued dma=%s pa=0x%08x size=%u idx=%d%s\n", dma_name(dma),
+	       buf.base_pAddr, buf.size, buf.bufIdx,
+	       immediate ? " (immediate)" : "");
+	return 0;
+}
