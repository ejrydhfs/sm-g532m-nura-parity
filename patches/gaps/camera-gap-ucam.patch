+static int cmd_rtbuf_dequeue(struct camdrv *d, int argc, char **argv)
+{
+	ISP_DEQUE_BUF_INFO_STRUCT deque;
+	_isp_dma_enum_ dma;
+	unsigned int i;
+	int ret;
+
+	dma = parse_dma_only(argc, argv);
+	ret = camdrv_rtbuf_dequeue(d, dma, &deque);
+	if (ret)
+		return fail(ret, "rtbuf-dequeue");
+
+	printf("dequeued dma=%s count=%u sof=%u img=%u\n", dma_name(dma),
+	       deque.count, deque.sof_cnt, deque.img_cnt);
+	for (i = 0; i < deque.count && i < ISP_P1_DEQUE_CNT; i++) {
+		const ISP_RT_BUF_INFO_STRUCT *b = &deque.data[i];
+
+		printf("  [%u] pa=0x%08x va=0x%016" PRIx64 " size=%u memID=%u idx=%d\n",
+		       i, b->base_pAddr, (uint64_t)b->base_vAddr, b->size,
+		       b->memID, b->bufIdx);
+		printf("      ts=%u.%06u filled=%u raw=%u dequeued=%u frm=%u\n",
+		       b->timeStampS, b->timeStampUs, b->bFilled,
+		       b->bProcessRaw, b->bDequeued, b->image.frm_cnt);
+	}
+	return 0;
+}
