+/*
+ * mt6735/mt6737t. Downstream applies these on every "normal" SMI profile
+ * setting, and at boot after saving the L1 arbitration defaults
+ * (smi_common.c:1249-1255 -> smi_configuration.c:123-133). The exact table is
+ * present in the ROM image (.rodata, file offset 0xe808b0):
+ *	0x100 (L1LEN)	= 0x1b
+ *	0x234 (M4U_TH)	= 0xf7e19085
+ *	0x230 (FIFO_TH1)= 0x00000e9f
+ * The SMI common lives in the DIS power domain, so its registers lose these
+ * values whenever DIS powers down; mtk_smi_common_gen2 does not restore them.
+ * Downstream also configures the per-LARB L1 arbitration registers
+ * 0x104-0x114 (0x104 restored from the boot value, 0x108/0x10c = 0x1000); the
+ * field layout is undocumented and the downstream loop indexes past the
+ * 3-entry smi_common_l1arb_offset array (SMI_LARB_NR is 4), so those are left
+ * at their hardware values.
+ */
+static const struct mtk_smi_reg_pair mtk_smi_common_mt6735_init[SMI_COMMON_INIT_REGS_NR] = {
+	{SMI_L1LEN, 0x1b},
+	{SMI_M4U_TH, 0xf7e19085},
+	{SMI_READ_FIFO_TH, 0x0e9f},
+};
+
 static const struct mtk_smi_common_plat mtk_smi_common_gen1 = {
 	.type     = MTK_SMI_GEN1,
 };
@@ -764,6 +800,11 @@ static const struct mtk_smi_common_plat mtk_smi_common_gen2 = {
 	.type	  = MTK_SMI_GEN2,
 };
 
+static const struct mtk_smi_common_plat mtk_smi_common_mt6735 = {
+	.type	  = MTK_SMI_GEN2,
+	.init	  = mtk_smi_common_mt6735_init,
+};
+
 static const struct mtk_smi_common_plat mtk_smi_common_mt6779 = {
 	.type	  = MTK_SMI_GEN2,
 	.has_gals = true,
