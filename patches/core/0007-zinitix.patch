+static bool zinitix_fw_needs_update(struct bt541_ts_data *bt541, const u8 *fw)
+{
+	u16 version = fw[ZINITIX_FW_VERSION_OFF] |
+		      (fw[ZINITIX_FW_VERSION_OFF + 1] << 8);
+	u16 minor = fw[ZINITIX_FW_MINOR_VERSION_OFF] |
+		    (fw[ZINITIX_FW_MINOR_VERSION_OFF + 1] << 8);
+	u16 regdata = fw[ZINITIX_FW_REGDATA_VERSION_OFF] |
+		      (fw[ZINITIX_FW_REGDATA_VERSION_OFF + 1] << 8);
+
+	dev_info(&bt541->client->dev,
+		 "Current firmware %04x.%04x regdata %04x, image %04x.%04x regdata %04x\n",
+		 bt541->firmware_version, bt541->fw_minor_version,
+		 bt541->regdata_version, version, minor, regdata);
+
+	if (bt541->firmware_version > 0xff)
+		return true;
+	if (bt541->firmware_version < version)
+		return true;
+	if (bt541->firmware_version > version)
+		return false;
+	if (bt541->fw_minor_version < minor)
+		return true;
+	if (bt541->fw_minor_version > minor)
+		return false;
+
+	return bt541->regdata_version < regdata;
+}
