+/*
+ * Try to load and install the BT541 firmware.  Returns 1 if a new image was
+ * written, 0 if no update was necessary or possible, negative on failure.
+ *
+ * The firmware blob itself is not part of the kernel tree; the ROM builds
+ * it in through CONFIG_EXTRA_FIRMWARE with the same file name.
+ */
+static int zinitix_update_firmware(struct bt541_ts_data *bt541, bool force)
+{
+	const struct firmware *fw;
+	bool need_update;
+	int error;
+	int retry;
+
+	if (!bt541->is_bt541)
+		return 0;
+
+	/* Try once per boot unless a broken image forces a rewrite. */
+	if (bt541->firmware_checked && !force)
+		return 0;
+	bt541->firmware_checked = true;
+
+	error = request_firmware(&fw, ZINITIX_BT541_FW_NAME,
+				 &bt541->client->dev);
+	if (error) {
+		dev_info(&bt541->client->dev,
+			 "Firmware %s not available (%d), keeping on-chip image\n",
+			 ZINITIX_BT541_FW_NAME, error);
+		return 0;
+	}
+
+	if (fw->size < ZINITIX_FW_HDR_SIZE) {
+		dev_err(&bt541->client->dev,
+			"Firmware image too small (%zu bytes)\n", fw->size);
+		error = -EINVAL;
+		goto out;
+	}
+
+	need_update = force || zinitix_fw_needs_update(bt541, fw->data);
+	if (!need_update) {
+		dev_info(&bt541->client->dev,
+			 "On-chip firmware is up to date\n");
+		error = 0;
+		goto out;
+	}
+
+	for (retry = 0; retry < 3; retry++) {
+		error = zinitix_flash_firmware(bt541, fw->data, fw->size);
+		if (!error)
+			break;
+		dev_warn(&bt541->client->dev,
+			 "Firmware update failed, retry %d\n", retry + 1);
+	}
+
+	if (!error)
+		error = 1;
+
+out:
+	release_firmware(fw);
+
+	return error;
+}
