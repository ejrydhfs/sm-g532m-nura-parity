+/*
+ * The MT6735 controller can wedge its VBUS state machine on a short VBUS
+ * drop; force the PHY through session-end and let it resample, as the
+ * vendor glue does (usb20_host.c:284-302).  Runs from a workqueue because
+ * phy_set_mode_ext() takes the PHY mutex.
+ */
+static void mtk_musb_vbus_work(struct work_struct *work)
+{
+	struct mtk_glue *glue = container_of(work, struct mtk_glue, vbus_work);
+	struct musb *musb = glue->musb;
+	u8 devctl;
+
+	if (!musb || glue->role != USB_ROLE_HOST)
+		return;
+
+	devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
+	musb_writeb(musb->mregs, MUSB_DEVCTL,
+		    devctl & ~MUSB_DEVCTL_SESSION);
+
+	phy_set_mode_ext(glue->phy, PHY_MODE_USB_HOST,
+			 MTK_PHY_SUBMODE_SESSION_RESTART);
+
+	devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
+	musb_writeb(musb->mregs, MUSB_DEVCTL, devctl | MUSB_DEVCTL_SESSION);
+}
