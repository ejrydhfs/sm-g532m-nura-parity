+/*
+ * Charger-detection wiring from the vendor power sequences: DP 100k mode
+ * on with the DP/DM 100k pulls off (usb_phy_poweron(), usb20_phy.c:387-390)
+ * and PUPD_BIST_EN cleared so the PMIC can run charger type detection on
+ * DP/DM (usb_phy_recover(), usb20_phy.c:592).
+ */
+static void mtk_u2_phy_charger_setup(struct mtk_phy_instance *instance)
+{
+	struct u2phy_banks *u2_banks = &instance->u2_banks;
+	void __iomem *com = u2_banks->com;
+
+	/* DP 100k mode on, DP/DM 100k pulls off for charger detection */
+	mtk_phy_clear_bits(com + U3P_U2PHYACR4,
+			   P2C_USB20_DP_100K_EN | P2C_RG_USB20_DM_100K_EN);
+	mtk_phy_set_bits(com + U3P_U2PHYACR4, P2C_RG_USB20_DP_100K_MODE);
+
+	/* Let the PMIC run charger type detection on DP/DM */
+	mtk_phy_clear_bits(com + U3P_USBPHYACR7, PA7_RG_PUPD_BIST_EN);
+}
