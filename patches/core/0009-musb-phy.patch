+static irqreturn_t mtk_id_irq(int irq, void *data)
+{
+	struct mtk_glue *glue = data;
+
+	mod_delayed_work(system_wq, &glue->id_work,
+			 msecs_to_jiffies(MTK_ID_DEBOUNCE_MS));
+
+	return IRQ_HANDLED;
+}
