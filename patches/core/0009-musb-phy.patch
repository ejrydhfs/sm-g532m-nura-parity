+/*
+ * MT6735 parity helpers.  The MT6735 USB2 PHY has no VBUS/ID sensing path
+ * the MUSB controller can rely on ("no VBUS sensing IP"), so the vendor
+ * glue forces the U2PHYDTM1 bus state and re-samples it after a VBUS
+ * error.  Values and sequences are ported from the vendor driver and
+ * verified against the ROM build (musb_session_restart @ 0xc03b58bc):
+ *   usb20_phy.c:402-404    (device force, also 628-630)
+ *   usb20_host.c:284-298   (session restart)
+ *   usb20_host.c:480-493   (host entry idle + host force)
+ *   usb20_host.c:511-513   (device entry idle)
+ */
+static void mtk_u2_phy_force_bus(struct mtk_phy_instance *instance, u32 val)
+{
+	struct u2phy_banks *u2_banks = &instance->u2_banks;
+	void __iomem *com = u2_banks->com;
+
+	mtk_phy_update_bits(com + U3P_U2PHYDTM1, MTK_U2PHYDTM1_BUS_STATE, val);
+	mtk_phy_set_bits(com + U3P_U2PHYDTM1, MTK_U2PHYDTM1_FORCE_ALL);
+}
+
+/*
+ * musb_session_restart() (usb20_host.c:284-298): hold the four bus signals
+ * at session end for 5 ms so the controller's OTG state machine leaves its
+ * VBUS wait state, then release the forces so the PHY re-samples VBUS.
+ * The ROM build does exactly:
+ *   SET8(0x6d, 0x3c); SET8(0x6c, 0x10); CLR8(0x6c, 0x2c);
+ *   mdelay(5);
+ *   CLR8(0x6d, 0x3c); CLR8(0x6c, 0x3c)
+ * The surrounding MUSB_DEVCTL session-bit dance lives in the glue, which
+ * cannot reach the register from here (usb20_host.c:287-288, 297-298).
+ */
+static void mtk_u2_phy_session_restart(struct mtk_phy_instance *instance)
+{
+	struct u2phy_banks *u2_banks = &instance->u2_banks;
+	void __iomem *com = u2_banks->com;
+
+	mtk_phy_set_bits(com + U3P_U2PHYDTM1, MTK_U2PHYDTM1_FORCE_BUS);
+	mtk_phy_update_bits(com + U3P_U2PHYDTM1, MTK_U2PHYDTM1_BUS_SIGNALS,
+			    P2C_RG_SESSEND);
+	mdelay(5);
+	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, MTK_U2PHYDTM1_FORCE_BUS);
+	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, MTK_U2PHYDTM1_BUS_SIGNALS);
+}
+
+/*
+ * MT6735 HS eye tuning: VRT_SEL/TERM_SEL/SQ_TH are 2/2/1 in host mode
+ * (usb_phy_set_host_mode(), usb20_phy.c:658-668) and 7/7/1 in device mode
+ * (usb_phy_recover(), usb20_phy.c:646-652; ROM usb_phy_set_host_mode @
+ * 0xc03b5260).  The device values can be overridden from the device tree.
+ */
+static void mtk_u2_phy_eye_tuning(struct mtk_phy_instance *instance, bool host)
+{
+	struct u2phy_banks *u2_banks = &instance->u2_banks;
+	void __iomem *com = u2_banks->com;
+	u32 vrt, term;
+
+	if (host) {
+		vrt = MTK_U2_HS_VRT_HOST;
+		term = MTK_U2_HS_TERM_HOST;
+	} else {
+		vrt = instance->eye_vrt ? instance->eye_vrt : MTK_U2_HS_VRT_DEVICE;
+		term = instance->eye_term ? instance->eye_term : MTK_U2_HS_TERM_DEVICE;
+	}
+
+	mtk_phy_update_field(com + U3P_USBPHYACR1, PA1_RG_VRT_SEL, vrt);
+	mtk_phy_update_field(com + U3P_USBPHYACR1, PA1_RG_TERM_SEL, term);
+	mtk_phy_update_field(com + U3P_USBPHYACR6, PA6_RG_U2_SQTH, MTK_U2_HS_SQTH);
+}
