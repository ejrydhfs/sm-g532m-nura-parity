+/*
+ * Micro-B OTG ID pin.  The vendor driver reads the IDDIG pad as a GPIO
+ * with an EINT (ID_PIN_USE_EX_EINT, usb20_host.c:439-566) and debounces
+ * the resulting role change by 400ms, because the controller itself does
+ * not report ID changes reliably.
+ */
+static void mtk_id_work(struct work_struct *work)
+{
+	struct mtk_glue *glue = container_of(work, struct mtk_glue, id_work.work);
+	bool host;
+
+	if (!glue->musb || !glue->role_sw)
+		return;
+
+	host = gpiod_get_value_cansleep(glue->id_gpio);
+	usb_role_switch_set_role(glue->role_sw,
+				 host ? USB_ROLE_HOST : USB_ROLE_DEVICE);
+}
