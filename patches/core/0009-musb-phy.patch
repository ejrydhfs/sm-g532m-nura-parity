+/*
+ * Host VBUS is supplied by the PMIC/charger boost on this board; model it
+ * as an optional regulator so MUSB's set_vbus() hook can drive it.
+ */
+static void mtk_musb_vbus_set(struct mtk_glue *glue, int on)
+{
+	int ret;
+
+	if (!glue->vbus)
+		return;
+
+	if (on && !glue->vbus_on) {
+		ret = regulator_enable(glue->vbus);
+		if (ret) {
+			dev_err(glue->dev, "failed to enable VBUS: %d\n", ret);
+			return;
+		}
+		glue->vbus_on = true;
+	} else if (!on && glue->vbus_on) {
+		regulator_disable(glue->vbus);
+		glue->vbus_on = false;
+	}
+}
