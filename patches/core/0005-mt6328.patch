+ * Voltage-table selector workarounds ported from the Samsung/MTK downstream
+ * PMIC driver (mtk_regulator_set_voltage_sel() in
+ * drivers/misc/mediatek/power/mt6735/pmic.c):
+ *  - VCAMD: selector 3 (1.2 V) remaps the RG_VCAMD_CAL trim through
+ *    mt6328_vcamd_cal_map[], any other selector restores the factory trim.
+ *  - VRF18_1: SLDO_ANA_CON8 bit 2 must be cleared for the 1.825 V selector
+ *    (selector 4) and set for all others.
+ */
+static int mt6328_ldo_table_set_voltage_sel(struct regulator_dev *rdev,
+					    unsigned int sel)
+{
+	struct mt6328_regulator_info *info = rdev_get_drvdata(rdev);
+	int ret;
+
+	ret = regulator_set_voltage_sel_regmap(rdev, sel);
+	if (ret)
