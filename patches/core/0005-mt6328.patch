+static int mt6328_read_vmc_efuse(struct regmap *regmap, u32 *dout)
+{
+	unsigned int val = 0;
+	int i, ret;
+
+	/* Ported from the downstream PMIC driver's pmic_read_VMC_efuse(). */
+	ret = regmap_update_bits(regmap, MT6328_TOP_CKHWEN_CON0,
+				 MT6328_CKHWEN_CON0_EFUSE_CK_PDN_HWEN, 0);
+	if (ret)
+		goto out;
+	ret = regmap_update_bits(regmap, MT6328_TOP_CKPDN_CON3,
+				 MT6328_CKPDN_CON3_EFUSE_CK_PDN, 0);
+	if (ret)
+		goto out;
+	ret = regmap_update_bits(regmap, MT6328_OTP_CON11,
+				 MT6328_OTP_CON11_RD_SW,
+				 MT6328_OTP_CON11_RD_SW);
+	if (ret)
+		goto out;
+	ret = regmap_update_bits(regmap, MT6328_OTP_CON0,
+				 MT6328_OTP_CON0_PA_MASK,
+				 MT6328_OTP_VMC_ADDR);
+	if (ret)
+		goto out;
+
+	udelay(100);
+
+	ret = regmap_read(regmap, MT6328_OTP_CON8, &val);
+	if (ret)
+		goto out;
+	ret = regmap_update_bits(regmap, MT6328_OTP_CON8,
+				 MT6328_OTP_CON8_RD_TRIG,
+				 val & MT6328_OTP_CON8_RD_TRIG ? 0 :
+				 MT6328_OTP_CON8_RD_TRIG);
+	if (ret)
+		goto out;
+
+	udelay(300);
+
+	for (i = 0; i < 1000; i++) {
+		ret = regmap_read(regmap, MT6328_OTP_CON13, &val);
+		if (ret)
+			goto out;
+		if (!(val & MT6328_OTP_CON13_RD_BUSY))
+			break;
+		udelay(10);
+	}
+	if (val & MT6328_OTP_CON13_RD_BUSY) {
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	udelay(1000);
+
+	ret = regmap_read(regmap, MT6328_OTP_CON12, dout);
+	if (ret)
+		goto out;
+	*dout &= MT6328_OTP_CON12_DOUT_SW_MASK;
+
+out:
+	/* Re-enable the efuse clock on all paths, as the downstream code does. */
+	regmap_update_bits(regmap, MT6328_TOP_CKHWEN_CON0,
+			   MT6328_CKHWEN_CON0_EFUSE_CK_PDN_HWEN,
+			   MT6328_CKHWEN_CON0_EFUSE_CK_PDN_HWEN);
+	regmap_update_bits(regmap, MT6328_TOP_CKPDN_CON3,
+			   MT6328_CKPDN_CON3_EFUSE_CK_PDN,
+			   MT6328_CKPDN_CON3_EFUSE_CK_PDN);
+
+	return ret;
+}
