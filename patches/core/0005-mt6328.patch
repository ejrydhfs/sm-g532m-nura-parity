+		return regmap_update_bits(rdev->regmap, MT6328_SLDO_ANA_CON2,
+					  MT6328_VCAMD_CAL_MASK,
+					  (sel == 3 ?
+					   mt6328_vcamd_cal_map[mt6328_vcamd_cal] :
+					   mt6328_vcamd_cal) << 8);
+	case MT6328_ID_VRF18_1:
+		return regmap_update_bits(rdev->regmap, MT6328_SLDO_ANA_CON8,
+					  BIT(2), sel == 4 ? 0 : BIT(2));
+	default:
+		return 0;
+	}
