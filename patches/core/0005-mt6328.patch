+/*
+ * Unlock the RTC write-protect register. The downstream driver does this once
+ * at late init (mtk_rtc_common.c, rtc_late_init()) and leaves it unlocked.
+ */
+static int mtk_rtc_unlock_writeif(struct mt6397_rtc *rtc)
+{
+	int ret;
+
+	ret = regmap_write(rtc->regmap, rtc->addr_base + rtc->data->prot,
+			   rtc->data->prot_unlock1);
+	if (ret)
+		return ret;
+
+	ret = mtk_rtc_write_trigger(rtc);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(rtc->regmap, rtc->addr_base + rtc->data->prot,
+			   rtc->data->prot_unlock2);
+	if (ret)
+		return ret;
+
+	return mtk_rtc_write_trigger(rtc);
+}
