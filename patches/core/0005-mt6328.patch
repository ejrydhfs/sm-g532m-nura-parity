+static int mtk_rtc_clear_alarm(struct mt6397_rtc *rtc)
+{
+	u32 irqsta;
+	int ret;
+
+	ret = regmap_update_bits(rtc->regmap, rtc->addr_base + RTC_IRQ_EN,
+				 RTC_IRQ_EN_AL, 0);
+	if (ret)
+		return ret;
