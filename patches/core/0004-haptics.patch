+/*
+ * Maximum run time reached: stop the motor and hold it off until all
+ * effects have finished.  The SM-G532M ROM driver (Samsung sec_vib,
+ * drivers/motor/sec_vib.c) clamps every timed_output enable request to its
+ * DT "sec_vib,max_timeout" (10000 ms in the shipped ROM DTB).  Force
+ * feedback does not pass the effect duration down to the driver (the
+ * ff-memless core only reports the combined magnitude), so the same limit
+ * is applied to the continuous regulator-on time instead.
+ */
+static enum hrtimer_restart regulator_haptic_stop_timer(struct hrtimer *timer)
+{
+	struct regulator_haptic *haptic = container_of(timer,
+					struct regulator_haptic, stop_timer);
+
+	haptic->capped = true;
+	schedule_work(&haptic->work);
+
+	return HRTIMER_NORESTART;
+}
+
 static void regulator_haptic_work(struct work_struct *work)
 {
 	struct regulator_haptic *haptic = container_of(work,
 					struct regulator_haptic, work);
+	unsigned int magnitude;
+	bool was_active;
 
 	guard(mutex)(&haptic->mutex);
 
-	if (!haptic->suspended)
-		regulator_haptic_set_voltage(haptic, haptic->magnitude);
+	magnitude = haptic->magnitude;
+	if (!magnitude) {
+		/* Quiet again: the run time limit is re-armed on next start. */
+		hrtimer_cancel(&haptic->stop_timer);
+		haptic->capped = false;
+	} else if (haptic->capped) {
+		magnitude = 0;
+	}
+
+	if (haptic->suspended)
+		return;
+
+	was_active = haptic->active;
+	regulator_haptic_set_voltage(haptic, magnitude);
+
+	if (magnitude && !was_active && haptic->max_timeout)
+		hrtimer_start(&haptic->stop_timer,
+			      ms_to_ktime(haptic->max_timeout),
+			      HRTIMER_MODE_REL);
 }
 
