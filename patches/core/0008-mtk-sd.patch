+/*
+ * Port from Samsung/MTK downstream sd.c devicetree parsing: an ETT table is
+ * a list of (register offset, field mask, value) cells.  "ett-hsX-cells" is
+ * the number of entries; "ett-hsX-customer" takes precedence over the
+ * "ett-hsX-default" table, matching downstream.
+ */
+static void msdc_of_parse_ett(struct device *dev, struct device_node *np,
+			      const char *count_name, const char *customer_name,
+			      const char *default_name,
+			      struct msdc_ett_setting *table,
+			      unsigned int *count)
+{
+	u32 cells[MSDC_MAX_ETT_SETTINGS * 3];
+	u32 n;
+	unsigned int i;
+
+	if (of_property_read_u32(np, count_name, &n) || !n)
+		return;
+
+	if (n > MSDC_MAX_ETT_SETTINGS) {
+		dev_warn(dev, "%s: %u entries, using first %d\n", count_name, n,
+			 MSDC_MAX_ETT_SETTINGS);
+		n = MSDC_MAX_ETT_SETTINGS;
+	}
+
+	if (of_property_read_u32_array(np, customer_name, cells, n * 3) &&
+	    of_property_read_u32_array(np, default_name, cells, n * 3))
+		return;
+
+	for (i = 0; i < n; i++) {
+		table[i].reg = cells[i * 3];
+		table[i].mask = cells[i * 3 + 1];
+		table[i].val = cells[i * 3 + 2];
+	}
+	*count = n;
+}
+
 static void msdc_of_property_parse(struct platform_device *pdev,
 				   struct msdc_host *host)
 {
 	struct mmc_host *mmc = mmc_from_priv(host);
+	u32 val;
 
 	of_property_read_u32(pdev->dev.of_node, "mediatek,latch-ck",
 			     &host->latch_ck);
@@ -2915,6 +3101,35 @@ static void msdc_of_property_parse(struct platform_device *pdev,
 		host->cqhci = true;
 	else
 		host->cqhci = false;
+
+	/*
+	 * Port from Samsung/MTK downstream sd.c register_setting node:
+	 * cmd_edge/rdata_edge/wdata_edge.  mtk-sd historically only ever
+	 * used the rising edge; the mt6735/6737 boards sample on the falling
+	 * edge for all non-tuned modes.
+	 */
+	if (!of_property_read_u32(pdev->dev.of_node, "mediatek,cmd-edge",
+				  &val)) {
+		host->cmd_edge = val & 1;
+		host->edge_valid |= MSDC_EDGE_CMD;
+	}
+	if (!of_property_read_u32(pdev->dev.of_node, "mediatek,rdata-edge",
+				  &val)) {
+		host->rdata_edge = val & 1;
+		host->edge_valid |= MSDC_EDGE_RDATA;
+	}
+	if (!of_property_read_u32(pdev->dev.of_node, "mediatek,wdata-edge",
+				  &val)) {
+		host->wdata_edge = val & 1;
+		host->edge_valid |= MSDC_EDGE_WDATA;
+	}
+
+	msdc_of_parse_ett(&pdev->dev, pdev->dev.of_node, "ett-hs200-cells",
+			  "ett-hs200-customer", "ett-hs200-default",
+			  host->ett_hs200, &host->ett_hs200_count);
+	msdc_of_parse_ett(&pdev->dev, pdev->dev.of_node, "ett-hs400-cells",
+			  "ett-hs400-customer", "ett-hs400-default",
+			  host->ett_hs400, &host->ett_hs400_count);
 }
 
