+/*
+ * Port from Samsung/MTK downstream sd.c:msdc_apply_ett_settings().
+ * The ETT table is the board's HS200/HS400 register setup from devicetree
+ * (downstream "ett-hs200-default"/"ett-hs400-default" properties).  It
+ * carries the CMD/DAT sampling delays and turnaround settings that are not
+ * otherwise discoverable by tuning.
+ */
+static void msdc_apply_ett_settings(struct msdc_host *host, bool hs400)
+{
+	unsigned int i;
+
+	if (hs400) {
+		/* Downstream clears the HS200 values before applying HS400 */
+		for (i = 0; i < host->ett_hs200_count; i++)
+			sdr_set_field(host->base + host->ett_hs200[i].reg,
+				      host->ett_hs200[i].mask, 0);
+		for (i = 0; i < host->ett_hs400_count; i++)
+			sdr_set_field(host->base + host->ett_hs400[i].reg,
+				      host->ett_hs400[i].mask,
+				      host->ett_hs400[i].val);
+	} else {
+		for (i = 0; i < host->ett_hs200_count; i++)
+			sdr_set_field(host->base + host->ett_hs200[i].reg,
+				      host->ett_hs200[i].mask,
+				      host->ett_hs200[i].val);
+	}
+}
+
+/*
+ * Port from Samsung/MTK downstream sd.c:msdc_set_smpl().  The board may
+ * require CMD response and DAT sampling on the falling clock edge instead of
+ * the controller default rising edge.
+ */
+static void msdc_set_sample_edges(struct msdc_host *host)
+{
+	if (host->edge_valid & MSDC_EDGE_CMD)
+		sdr_set_field(host->base + MSDC_IOCON, MSDC_IOCON_RSPL,
+			      host->cmd_edge);
+	if (host->edge_valid & MSDC_EDGE_RDATA)
+		sdr_set_field(host->base + MSDC_IOCON, MSDC_IOCON_DSPL,
+			      host->rdata_edge);
+	if (host->edge_valid & MSDC_EDGE_WDATA)
+		sdr_set_field(host->base + MSDC_IOCON, MSDC_IOCON_W_DSPL,
+			      host->wdata_edge);
+}
