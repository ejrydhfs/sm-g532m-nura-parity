+/*
+ * Port from Samsung/MTK downstream sd.c:msdc_sd_clock_run(): after an SD
+ * card is powered the card must see the identification clock, a short clock
+ * stop and a clean restart.  Downstream does this from msdc_ops_set_ios()
+ * on MMC_POWER_ON for the SD host.
+ */
+static void msdc_sd_clock_run(struct msdc_host *host)
+{
+	msdc_set_mclk(host, MMC_TIMING_LEGACY, 400000);
+	sdr_set_bits(host->base + MSDC_CFG, MSDC_CFG_CKPDN);
+	mdelay(1);
+	sdr_clr_bits(host->base + MSDC_CFG, MSDC_CFG_CKPDN);
+}
