+/*
+ * MT6735/MT6735M/MT6753 (incl. the MT6737T variant used on SM-G532M):
+ * register layout matches mt_i2c_regs_v1 and WRRD lengths are programmed
+ * through TRANSFER_LEN/TRANSFER_LEN_AUX.  The APDMA engine is 32-bit only
+ * and has no 4G-mode registers at offset 0x54/0x58 (see the DMA_REGS_OFFSET
+ * list in downstream drivers/misc/mediatek/i2c/mt6735/mt_i2c.h), so
+ * max_dma_support must stay 32.  Transactions are started with
+ * I2C_TRANSAC_START alone and a STOP terminates every message unless the
+ * write-then-read (WRRD) mode combines a message pair with a repeated
+ * start.
+ * Port from Samsung/MTK downstream drivers/misc/mediatek/i2c/mt6735/i2c.c
+ * (mt_i2c_of_match/mt_i2c_do_transfer) and
+ * drivers/i2c/busses/i2c-mtk.c (mt_i2c_should_combine).
+ */
+static const struct mtk_i2c_compatible mt6735_compat = {
+	.regs = mt_i2c_regs_v1,
+	.pmic_i2c = 0,
+	.dcm = 1,
+	.auto_restart = 0,
+	.aux_len_reg = 1,
+	.timing_adjust = 0,
+	.dma_sync = 0,
+	.ltiming_adjust = 0,
+	.apdma_sync = 0,
+	.max_dma_support = 32,
+};
+
